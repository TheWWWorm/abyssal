# No game content or local output belongs in this repository.
*.abyss
*.partial
*.pck
*.wasm
*.apk
*.aab
*.keystore
*.jar
*.class
*.zip
*.png
*.bmp
*.jpg
*.jpeg
*.webp
*.glb
*.gltf
*.blend
*.wav
*.ogg
*.mid
*.amr
*.mbac
*.mtra
# Reviewed UI assets and provenance-checked weapon recordings may be committed.
!game/ui/**
!game/audio/weapons/*.wav
!browser/favicon.png
!browser/apple-touch-icon.png
!browser/icon-192.png
!browser/icon-512.png
# Screenshots for the README, rendered by the engine.
!docs/screenshots/*.jpg
**/.godot/
**/__pycache__/
content/
reference/
captures/
build/
.local/
# The exported Web build is committed for static hosting.
!public/**
# The per-file source review is kept with the working tree, never published.
provenance/source-provenance.json
public/provenance/source-provenance.json
