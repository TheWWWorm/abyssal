+bool LightStorage::cubemap_face_needs_update(int p_size, RID p_light, int p_face, uint64_t p_signature) {
+	ShadowCubemap *cube = _get_shadow_cubemap(p_size, p_light);
+	bool changed = !p_signature || cube->face_signature[p_face] != p_signature;
+	cube->face_signature[p_face] = p_signature;
+	if (p_face == 0) {
+		cube->faces_changed = false;
+	}
+	cube->faces_changed |= changed;
+	return changed;
+}
+
+bool LightStorage::cubemap_needs_copy(RID p_light, RID p_target, const Rect2 &p_region) {
+	ShadowCubemap *cube = shadow_cubemaps.getptr(p_light.get_id());
+	if (!cube) {
+		return true;
+	}
+	bool update = cube->faces_changed || cube->copy_target != p_target || cube->copy_region != p_region;
+	cube->copy_target = p_target;
+	cube->copy_region = p_region;
+	return update;
+}
