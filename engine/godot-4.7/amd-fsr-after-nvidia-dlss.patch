@@ -0,0 +1,89 @@
+// Experimental AMD FidelityFX integration for Godot 4.7. SPDX-License-Identifier: MIT
+#pragma once
+
+#include "core/object/class_db.h"
+#include "core/object/object.h"
+#include "core/os/mutex.h"
+#include "core/templates/safe_refcount.h"
+
+#ifdef FSR_SDK_ENABLED
+#include "drivers/d3d12/godot_d3dx12.h"
+#include "thirdparty/amd-fsr-sdk/api/include/dx12/ffx_api_dx12.h"
+#include "thirdparty/amd-fsr-sdk/upscalers/include/ffx_upscale.h"
+#include "thirdparty/amd-fsr-sdk/framegeneration/include/ffx_framegeneration.h"
+#include "thirdparty/amd-fsr-sdk/framegeneration/include/dx12/ffx_api_framegeneration_dx12.h"
+#endif
+
+class FidelityFX : public Object {
+	GDCLASS(FidelityFX, Object);
+	static FidelityFX *singleton;
+	static void _bind_methods();
+	mutable Mutex status_mutex;
+	SafeNumeric<uint32_t> sr_version{ 3 };
+	SafeNumeric<uint32_t> fg_version{ 0 };
+
+public:
+	FidelityFX();
+	static FidelityFX *get_singleton() { return singleton; }
+	static void register_singleton();
+	Dictionary get_status() const;
+	void set_upscaler_version(int p_version);
+	void set_frame_generation_version(int p_version);
+	bool sr_available() const;
+	int get_upscaler_version() const { return sr_version.get(); }
+
+#ifdef FSR_SDK_ENABLED
+	PfnFfxCreateContext create = nullptr;
+	PfnFfxDestroyContext destroy = nullptr;
+	PfnFfxQuery query = nullptr;
+	PfnFfxDispatch dispatch = nullptr;
+	PfnFfxConfigure configure = nullptr;
+	ID3D12Device *device = nullptr; // Borrowed from RenderingDevice.
+	uint64_t sr_ids[2]{};
+	uint64_t fg_ids[2]{};
+	bool sr_supported[2]{};
+	bool fg_supported[2]{};
+	SafeNumeric<uint64_t> sr_evaluations{ 0 };
+	SafeNumeric<uint64_t> fg_dispatches{ 0 };
+	SafeNumeric<uint64_t> generated_frames{ 0 };
+	SafeNumeric<uint64_t> game_presents{ 0 };
+	SafeNumeric<uint64_t> presented_frames{ 0 };
+	SafeNumeric<uint32_t> present_count_available{ 0 };
+	UINT last_present_count = 0;
+	SafeNumeric<uint32_t> sr_failed{ 0 };
+	SafeNumeric<uint32_t> fg_failed{ 0 };
+	SafeNumeric<uint32_t> last_error{ 0 };
+	SafeNumeric<uint32_t> fg_active{ 0 };
+	Mutex fg_mutex;
+	ffxContext fg_context = nullptr;
+	ffxContext swap_context = nullptr;
+	IDXGISwapChain4 *swap_chain = nullptr; // Borrowed; swap context owns another reference.
+	DXGI_SWAP_CHAIN_DESC1 swap_desc{};
+	uint64_t frame_id = 0;
+	bool prepared = false;
+	int active_fg_version = 0;
+	String sr_provider;
