diff --git a/servers/rendering/renderer_rd/effects/fsr_sdk.cpp b/servers/rendering/renderer_rd/effects/fsr_sdk.cpp
new file mode 100644
--- /dev/null
+++ b/servers/rendering/renderer_rd/effects/fsr_sdk.cpp
@@ -0,0 +1,231 @@
+// Experimental AMD FidelityFX integration for Godot 4.7. SPDX-License-Identifier: MIT
+#include "fsr_sdk.h"
+#include "drivers/fsr_sdk/fsr_sdk.h"
+#include "../uniform_set_cache_rd.h"
+
+using namespace RendererRD;
+#ifdef FSR_SDK_ENABLED
+namespace RendererRD {
+class FSRSDKContext : public DLSSContext {
+public:
+	ffxContext sr = nullptr;
+	ffxCreateContextDescUpscale desc{};
+	ffxCreateBackendDX12Desc backend{};
+	ffxCreateContextDescUpscaleVersion api_version{};
+	ffxOverrideVersion version_override{};
+	int version = 3;
+	Size2i target_size;
+	RID reactive;
+	RID hudless;
+	bool first = true;
+	bool evaluated = false;
+	~FSRSDKContext() {
+		auto *api = FidelityFX::get_singleton();
+		RD::get_singleton()->_flush_and_stall_for_all_frames();
+		api->release_frame_generation();
+		if (sr) { api->destroy(&sr, nullptr); }
+		if (reactive.is_valid()) { RD::get_singleton()->free_rid(reactive); }
+		if (hudless.is_valid()) { RD::get_singleton()->free_rid(hudless); }
+	}
+};
+}
+
+// Enter the legacy barrier domain from the render graph's COMMON layout and
+// return each resource to that layout before Godot uses it again. The SDK
+// restores each resource to the state supplied in its FfxApiResource.
+class FSRResourceScope {
+	ID3D12GraphicsCommandList *commands;
+	D3D12_RESOURCE_BARRIER barriers[8]{};
+	uint32_t count = 0;
+public:
+	explicit FSRResourceScope(void *p_commands) : commands((ID3D12GraphicsCommandList *)p_commands) {}
+	FfxApiResource add(RID p_texture, uint32_t p_usage = 0) {
+		auto *native = (ID3D12Resource *)RD::get_singleton()->get_driver_resource(RD::DRIVER_RESOURCE_TEXTURE, p_texture);
+		auto &barrier = barriers[count++];
+		barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+		barrier.Transition.pResource = native;
+		barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+		barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COMMON;
+		barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+		return ffxApiGetResourceDX12(native, FFX_API_RESOURCE_STATE_COMPUTE_READ, p_usage);
+	}
+	void begin() { commands->ResourceBarrier(count, barriers); }
+	~FSRResourceScope() {
+		for (uint32_t i = 0; i < count; i++) {
+			barriers[i].Transition.StateBefore = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+			barriers[i].Transition.StateAfter = D3D12_RESOURCE_STATE_COMMON;
+		}
+		commands->ResourceBarrier(count, barriers);
+	}
+};
+
+FSRSDKEffect::FSRSDKEffect() {
+	Vector<String> modes;
+	modes.push_back("\n");
+	shader.initialize(modes, "");
+	shader_version = shader.version_create();
+	pipeline = RD::get_singleton()->compute_pipeline_create(shader.version_get_shader(shader_version, 0));
+}
+FSRSDKEffect::~FSRSDKEffect() { shader.version_free(shader_version); }
+bool FSRSDKEffect::is_version_current(DLSSContext *p_context) const {
+	return p_context && static_cast<FSRSDKContext *>(p_context)->version == FidelityFX::get_singleton()->get_upscaler_version();
+}
+DLSSContext *FSRSDKEffect::create_context(Size2i p_internal, Size2i p_target) {
+	auto *api = FidelityFX::get_singleton();
+	if (!api->sr_available()) { return nullptr; }
+	auto *ctx = memnew(FSRSDKContext);
+	ctx->version = api->get_upscaler_version();
+	ctx->target_size = p_target;
+	ctx->backend.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_DX12, &ctx->api_version.header };
+	ctx->backend.device = api->device;
+	ctx->api_version.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE_VERSION, &ctx->version_override.header };
+	ctx->api_version.version = FFX_UPSCALER_VERSION;
+	ctx->version_override.header.type = FFX_API_DESC_TYPE_OVERRIDE_VERSION;
+	ctx->version_override.versionId = api->sr_ids[ctx->version - 3];
+	ctx->desc.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE, &ctx->backend.header };
+	ctx->desc.flags = FFX_UPSCALE_ENABLE_HIGH_DYNAMIC_RANGE | FFX_UPSCALE_ENABLE_DEPTH_INVERTED | FFX_UPSCALE_ENABLE_AUTO_EXPOSURE;
+	ctx->desc.maxRenderSize = { (uint32_t)p_internal.x, (uint32_t)p_internal.y };
+	ctx->desc.maxUpscaleSize = { (uint32_t)p_target.x, (uint32_t)p_target.y };
+	if (!api->check(api->create(&ctx->sr, &ctx->desc.header, nullptr))) { memdelete(ctx); return nullptr; }
+	api->record_provider(&ctx->sr, false);
+	RD::TextureFormat format;
+	format.format = RD::DATA_FORMAT_R8_UNORM;
+	format.width = p_internal.x;
+	format.height = p_internal.y;
+	format.usage_bits = RD::TEXTURE_USAGE_STORAGE_BIT | RD::TEXTURE_USAGE_SAMPLING_BIT;
+	ctx->reactive = RD::get_singleton()->texture_create(format, RD::TextureView());
+	return ctx;
+}
+
+void FSRSDKEffect::upscale(const DLSSContext::Parameters &p_params) {
+	auto *ctx = static_cast<FSRSDKContext *>(p_params.context);
+	if (!ctx || !FidelityFX::get_singleton()->sr_available()) { return; }
+	ctx->last_parameters = p_params;
+	ctx->evaluated = false;
+	RD *rd = RD::get_singleton();
+	auto *cache = UniformSetCacheRD::get_singleton();
+	RID shader_rid = shader.version_get_shader(shader_version, 0);
+	RD::ComputeListID list = rd->compute_list_begin();
+	rd->compute_list_bind_compute_pipeline(list, pipeline);
+	RD::Uniform uniforms[] = {
+		RD::Uniform(RD::UNIFORM_TYPE_IMAGE, 0, p_params.velocity),
+		RD::Uniform(RD::UNIFORM_TYPE_TEXTURE, 0, p_params.depth),
+		RD::Uniform(RD::UNIFORM_TYPE_TEXTURE, 0, p_params.color),
+		RD::Uniform(RD::UNIFORM_TYPE_IMAGE, 0, ctx->reactive),
+	};
+	for (int i = 0; i < 4; i++) {
+		rd->compute_list_bind_uniform_set(list, cache->get_cache(shader_rid, i, uniforms[i]), i);
+	}
+	float constants[20]{};
+	constants[0] = p_params.internal_size.x;
+	constants[1] = p_params.internal_size.y;
+	memcpy(constants + 4, &p_params.reprojection.columns[0].x, sizeof(float) * 16);
+	rd->compute_list_set_push_constant(list, constants, sizeof(constants));
+	rd->compute_list_dispatch_threads(list, p_params.internal_size.x, p_params.internal_size.y, 1);
+	rd->compute_list_end();
+	RID textures[] = { p_params.color, p_params.depth, p_params.velocity, p_params.output, ctx->reactive };
+	RD::CallbackResource resources[5];
+	for (int i = 0; i < 5; i++) { resources[i].rid = textures[i]; resources[i].usage = RD::CALLBACK_RESOURCE_USAGE_GENERAL; }
+	rd->driver_callback_add(upscale_callback, ctx, VectorView<RD::CallbackResource>(resources, 5));
+}
+void FSRSDKEffect::upscale_callback(RenderingDeviceDriver *p_driver, RDD::CommandBufferID p_commands, void *p_userdata) {
+	auto *ctx = static_cast<FSRSDKContext *>(p_userdata);
+	auto *api = FidelityFX::get_singleton();
+	const auto &p = ctx->last_parameters;
+	ffxDispatchDescUpscale d{};
+	d.header.type = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+	d.commandList = p_driver->command_buffer_get_native_handle(p_commands);
+	FSRResourceScope resources(d.commandList);
+	d.color = resources.add(p.color);
+	d.depth = resources.add(p.depth, FFX_API_RESOURCE_USAGE_DEPTHTARGET);
+	d.motionVectors = resources.add(p.velocity);
+	d.output = resources.add(p.output);
+	d.reactive = resources.add(ctx->reactive);
+	d.jitterOffset = { (float)p.jitter.x, (float)p.jitter.y };
+	d.motionVectorScale = { (float)p.internal_size.x, (float)p.internal_size.y };
+	d.renderSize = { (uint32_t)p.internal_size.x, (uint32_t)p.internal_size.y };
+	d.upscaleSize = { (uint32_t)ctx->target_size.x, (uint32_t)ctx->target_size.y };
+	d.frameTimeDelta = MAX(p.delta_time * 1000.0f, 0.1f);
+	d.preExposure = 1.0f;
+	d.reset = ctx->first || p.reset_accumulation;
+	d.cameraNear = p.z_near;
+	d.cameraFar = p.z_far;
+	d.cameraFovAngleVertical = Math::deg_to_rad(p.fovy);
+	d.viewSpaceToMetersFactor = 1.0f;
+	d.enableSharpening = true;
+	d.sharpness = p.sharpness;
+	resources.begin();
+	if (api->check(api->dispatch(&ctx->sr, &d.header))) {
+		ctx->evaluated = true;
+		api->sr_evaluations.increment();
+		ctx->first = false;
+	}
+}
+void FSRSDKEffect::prepare_frame_generation(DLSSContext *p_context, RID p_color) {
+	auto *ctx = static_cast<FSRSDKContext *>(p_context);
+	if (!ctx || !ctx->last_parameters.dlss_g) { return; }
+	RD *rd = RD::get_singleton();
+	RD::TextureFormat format = rd->texture_get_format(p_color);
+	if (!ctx->hudless.is_valid()) {
+		format.usage_bits = RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_CAN_COPY_TO_BIT;
+		ctx->hudless = rd->texture_create(format, RD::TextureView());
+	}
+	rd->texture_copy(p_color, ctx->hudless, Vector3(), Vector3(), Vector3(format.width, format.height, 1), 0, 0, 0, 0);
+	RID textures[] = { ctx->hudless, ctx->last_parameters.depth, ctx->last_parameters.velocity };
+	RD::CallbackResource resources[3];
+	for (int i = 0; i < 3; i++) { resources[i].rid = textures[i]; resources[i].usage = RD::CALLBACK_RESOURCE_USAGE_GENERAL; }
+	rd->driver_callback_add(frame_generation_callback, ctx, VectorView<RD::CallbackResource>(resources, 3));
+}
+void FSRSDKEffect::frame_generation_callback(RenderingDeviceDriver *p_driver, RDD::CommandBufferID p_commands, void *p_userdata) {
+	auto *ctx = static_cast<FSRSDKContext *>(p_userdata);
+	auto *api = FidelityFX::get_singleton();
+	if (!ctx->evaluated) { return; }
+	MutexLock lock(api->fg_mutex);
+	RD *rd = RD::get_singleton();
+	auto *hudless = (ID3D12Resource *)rd->get_driver_resource(RD::DRIVER_RESOURCE_TEXTURE, ctx->hudless);
+	FfxApiResource hudless_resource = ffxApiGetResourceDX12(hudless, FFX_API_RESOURCE_STATE_COMMON);
+	if (!api->ensure_frame_generation(ctx->target_size.x, ctx->target_size.y, hudless_resource.description.format)) { return; }
+	const auto &p = ctx->last_parameters;
+	// Required order: Configure -> PrepareV2 -> dispatch from proxy Present.
+	api->fg_config.frameGenerationEnabled = true;
+	api->fg_config.frameID = api->frame_id;
+	api->fg_config.HUDLessColor = hudless_resource;
+	if (!api->check(api->configure(&api->fg_context, &api->fg_config.header), true)) { return; }
+	ffxDispatchDescFrameGenerationPrepareV2 d{};
+	d.header.type = FFX_API_DISPATCH_DESC_TYPE_FRAMEGENERATION_PREPARE_V2;
+	d.commandList = p_driver->command_buffer_get_native_handle(p_commands);
+	FSRResourceScope resources(d.commandList);
+	d.depth = resources.add(p.depth, FFX_API_RESOURCE_USAGE_DEPTHTARGET);
+	d.motionVectors = resources.add(p.velocity);
+	d.frameID = api->frame_id;
+	d.flags = api->fg_config.flags;
+	d.jitterOffset = { (float)p.jitter.x, (float)p.jitter.y };
+	d.motionVectorScale = { (float)p.internal_size.x, (float)p.internal_size.y };
+	d.renderSize = { (uint32_t)p.internal_size.x, (uint32_t)p.internal_size.y };
+	d.frameTimeDelta = MAX(p.delta_time * 1000.0f, 0.1f);
+	d.reset = p.reset_accumulation || !api->fg_active.get();
+	d.cameraNear = p.z_near;
+	d.cameraFar = p.z_far;
+	d.cameraFovAngleVertical = Math::deg_to_rad(p.fovy);
+	d.viewSpaceToMetersFactor = 1.0f;
+	Vector3 pos = p.cam_transform.origin;
+	Vector3 up = p.cam_transform.basis.get_column(1);
+	Vector3 right = p.cam_transform.basis.get_column(0);
+	Vector3 forward = -p.cam_transform.basis.get_column(2);
+	for (int i = 0; i < 3; i++) {
+		d.cameraPosition[i] = pos[i]; d.cameraUp[i] = up[i]; d.cameraRight[i] = right[i]; d.cameraForward[i] = forward[i];
+	}
+	resources.begin();
+	if (api->check(api->dispatch(&api->fg_context, &d.header), true)) {
+		api->prepared = true;
+		api->fg_active.set(1);
+	}
+}
+#else
+FSRSDKEffect::FSRSDKEffect() {}
+FSRSDKEffect::~FSRSDKEffect() {}
+DLSSContext *FSRSDKEffect::create_context(Size2i, Size2i) { return nullptr; }
+bool FSRSDKEffect::is_version_current(DLSSContext *) const { return false; }
+void FSRSDKEffect::upscale(const DLSSContext::Parameters &) {}
+void FSRSDKEffect::prepare_frame_generation(DLSSContext *, RID) {}
+#endif
