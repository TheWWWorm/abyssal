diff --git a/drivers/fsr_sdk/fsr_sdk.cpp b/drivers/fsr_sdk/fsr_sdk.cpp
new file mode 100644
--- /dev/null
+++ b/drivers/fsr_sdk/fsr_sdk.cpp
@@ -0,0 +1,251 @@
+// Experimental AMD FidelityFX integration for Godot 4.7. SPDX-License-Identifier: MIT
+#include "fsr_sdk.h"
+#include "core/config/engine.h"
+#include "core/config/project_settings.h"
+#include "core/os/os.h"
+#ifdef FSR_SDK_ENABLED
+#include "core/io/file_access.h"
+#endif
+
+FidelityFX *FidelityFX::singleton = nullptr;
+FidelityFX::FidelityFX() { singleton = this; }
+void FidelityFX::register_singleton() {
+	GDREGISTER_CLASS(FidelityFX);
+	Engine::get_singleton()->add_singleton(Engine::Singleton("FidelityFX", singleton));
+}
+void FidelityFX::_bind_methods() {
+	ClassDB::bind_method(D_METHOD("get_status"), &FidelityFX::get_status);
+	ClassDB::bind_method(D_METHOD("set_upscaler_version", "version"), &FidelityFX::set_upscaler_version);
+	ClassDB::bind_method(D_METHOD("set_frame_generation_version", "version"), &FidelityFX::set_frame_generation_version);
+}
+void FidelityFX::set_upscaler_version(int p_version) {
+	if (p_version == 3 || p_version == 4) { sr_version.set(p_version); }
+}
+void FidelityFX::set_frame_generation_version(int p_version) {
+	fg_version.set(p_version == 3 || p_version == 4 ? p_version : 0);
+}
+bool FidelityFX::sr_available() const {
+#ifdef FSR_SDK_ENABLED
+	return device && sr_supported[sr_version.get() - 3] && !sr_failed.get();
+#else
+	return false;
+#endif
+}
+Dictionary FidelityFX::get_status() const {
+	MutexLock lock(status_mutex);
+	Dictionary d;
+	d["compiled"] = false;
+	d["initialized"] = false;
+	d["sr3_supported"] = false;
+	d["sr4_supported"] = false;
+	d["fg3_supported"] = false;
+	d["fg4_supported"] = false;
+#ifdef FSR_SDK_ENABLED
+	d["compiled"] = true;
+	d["initialized"] = device != nullptr;
+	d["sr3_supported"] = sr_supported[0] && !sr_failed.get();
+	d["sr4_supported"] = sr_supported[1] && !sr_failed.get();
+	d["fg3_supported"] = fg_supported[0] && swap_chain && !fg_failed.get();
+	d["fg4_supported"] = fg_supported[1] && swap_chain && !fg_failed.get();
+	d["upscaler_provider"] = sr_provider;
+	d["frame_generation_provider"] = fg_provider;
+	d["upscale_evaluations"] = (int64_t)sr_evaluations.get();
+	d["frame_generation_dispatches"] = (int64_t)fg_dispatches.get();
+	d["generated_frames"] = (int64_t)generated_frames.get();
+	d["game_presents"] = (int64_t)game_presents.get();
+	d["presented_frames"] = (int64_t)presented_frames.get();
+	d["present_count_available"] = present_count_available.get() != 0;
+	d["frame_generation_active"] = fg_active.get() != 0;
+	d["last_error"] = last_error.get();
+#endif
+	return d;
+}
+
+#ifdef FSR_SDK_ENABLED
+void FidelityFX::initialize_device(ID3D12Device *p_device) {
+	// One vendor runtime per session: the game's renderer choice (or a launch
+	// flag) asks for AMD's or NVIDIA's, which share the swap chain.
+	const List<String> args = OS::get_singleton()->get_cmdline_user_args();
+	const bool fsr = args.find("--experimental-fsr") || bool(ProjectSettings::get_singleton()->get_setting("rendering/fsr_sdk/enabled", false));
+	const bool rtx = args.find("--experimental-rtx") || bool(ProjectSettings::get_singleton()->get_setting("rendering/streamline/enabled", false));
+	if (!fsr || rtx ||
+			OS::get_singleton()->get_current_rendering_method() != "forward_plus" ||
+			Engine::get_singleton()->is_editor_hint()) { return; }
+	// Only signed SDK binaries beside the executable, never the working directory.
+	HMODULE modules[3]{};
+	const char *names[] = { "amd_fidelityfx_upscaler_dx12.dll", "amd_fidelityfx_framegeneration_dx12.dll", "amd_fidelityfx_loader_dx12.dll" };
+	const char *hashes[] = { "d0dcccc74a43c44ba435b7a369b456e0970d8a4464e4bd683119b374f2c9fb46", "02297beedd285e822d3a64f314cf00faf378dcec0edc47ff0c4dd71b3a8c2f18", "e2d85aa05a9bd9ed8b38935fdf5199372cca6f74c12015143bb6f945ee1608aa" };
+	for (int i = 0; i < 3; i++) {
+		String path = OS::get_singleton()->get_executable_path().get_base_dir().path_join(names[i]);
+		Char16String wide = path.utf16();
+		if (FileAccess::get_sha256(path) != hashes[i]) {
+			WARN_PRINT("AMD FSR runtime is missing or does not match the pinned production SDK.");
+			return;
+		}
+		modules[i] = LoadLibraryExW((const wchar_t *)wide.get_data(), nullptr, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+		if (!modules[i]) { return; }
+	}
+	// Keep the modules resident until process exit; effect callbacks outlive frames.
+	create = (PfnFfxCreateContext)(void *)GetProcAddress(modules[2], "ffxCreateContext");
+	destroy = (PfnFfxDestroyContext)(void *)GetProcAddress(modules[2], "ffxDestroyContext");
+	query = (PfnFfxQuery)(void *)GetProcAddress(modules[2], "ffxQuery");
+	dispatch = (PfnFfxDispatch)(void *)GetProcAddress(modules[2], "ffxDispatch");
+	configure = (PfnFfxConfigure)(void *)GetProcAddress(modules[2], "ffxConfigure");
+	if (!create || !destroy || !query || !dispatch || !configure) { return; }
+	device = p_device;
+	for (int effect = 0; effect < 2; effect++) {
+		uint64_t count = 32, ids[32]{};
+		const char *names_available[32]{};
+		ffxQueryDescGetVersions q{};
+		q.header.type = FFX_API_QUERY_DESC_TYPE_GET_VERSIONS;
+		q.createDescType = effect == 0 ? FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE : FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION;
+		q.device = device;
+		q.outputCount = &count;
+		q.versionIds = ids;
+		q.versionNames = names_available;
+		if (query(nullptr, &q.header) != FFX_API_RETURN_OK) { continue; }
+		for (uint64_t i = 0; i < MIN(count, uint64_t(32)); i++) {
+			String name = String::utf8(names_available[i]);
+			print_line("FidelityFX provider: " + name);
+			int index = name.contains("3.1.") ? 0 : (name.contains("4.") ? 1 : -1);
+			if (index < 0) { continue; }
+			// Version IDs are opaque. Only reuse IDs actually returned for this device.
+			(effect == 0 ? sr_ids : fg_ids)[index] = ids[i];
+			(effect == 0 ? sr_supported : fg_supported)[index] = true;
+		}
+	}
+	debug_frames = OS::get_singleton()->get_cmdline_user_args().find("--fsr-debug-frames");
+}
+
+bool FidelityFX::check(ffxReturnCode_t p_code, bool p_fg) {
+	if (p_code == FFX_API_RETURN_OK) { return true; }
+	last_error.set(p_code);
+	(p_fg ? fg_failed : sr_failed).set(1);
+	WARN_PRINT(vformat("FidelityFX %s disabled after SDK error %d.", p_fg ? "frame generation" : "upscaling", p_code));
+	return false;
+}
+void FidelityFX::record_provider(ffxContext *p_context, bool p_fg) {
+	ffxQueryGetProviderVersion q{};
+	q.header.type = FFX_API_QUERY_DESC_TYPE_GET_PROVIDER_VERSION;
+	if (query(p_context, &q.header) == FFX_API_RETURN_OK && q.versionName) {
+		MutexLock lock(status_mutex);
+		(p_fg ? fg_provider : sr_provider) = String::utf8(q.versionName);
+	}
+}
+bool FidelityFX::create_swap_chain(IDXGIFactory *p_factory, ID3D12CommandQueue *p_queue, HWND p_hwnd, DXGI_SWAP_CHAIN_DESC1 *p_desc, IDXGISwapChain4 **r_swap) {
+	if (!device || swap_chain || (!fg_supported[0] && !fg_supported[1]) || p_desc->Format != DXGI_FORMAT_R8G8B8A8_UNORM) { return false; }
+	swap_desc = *p_desc;
+	swap_api_version.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATIONSWAPCHAIN_VERSION_DX12;
+	swap_api_version.version = FFX_FRAMEGENERATION_SWAPCHAIN_DX12_VERSION;
+	swap_create.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATIONSWAPCHAIN_FOR_HWND_DX12, &swap_api_version.header };
+	swap_create.swapchain = &swap_chain;
+	swap_create.hwnd = p_hwnd;
+	swap_create.desc = &swap_desc;
+	swap_create.dxgiFactory = p_factory;
+	swap_create.gameQueue = p_queue;
+	if (!check(create(&swap_context, &swap_create.header, nullptr), true)) { swap_chain = nullptr; return false; }
+	last_present_count = 0;
+	*r_swap = swap_chain;
+	return true;
+}
+void FidelityFX::disable_frame_generation() {
+	if (fg_context && fg_config.frameGenerationEnabled) {
+		fg_config.frameGenerationEnabled = false;
+		check(configure(&fg_context, &fg_config.header), true);
+	}
+	fg_active.set(0);
+	prepared = false;
+}
+void FidelityFX::wait_for_presents() {
+	if (!swap_context) { return; }
+	ffxDispatchDescFrameGenerationSwapChainWaitForPresentsDX12 wait{};
+	wait.header.type = FFX_API_DISPATCH_DESC_TYPE_FRAMEGENERATIONSWAPCHAIN_WAIT_FOR_PRESENTS_DX12;
+	check(dispatch(&swap_context, &wait.header), true);
+}
+void FidelityFX::release_frame_generation() {
+	MutexLock lock(fg_mutex);
+	disable_frame_generation();
+	wait_for_presents();
+	if (fg_context) {
+		destroy(&fg_context, nullptr);
+		fg_context = nullptr;
+	}
+	active_fg_version = 0;
+}
+void FidelityFX::release_swap_chain(IDXGISwapChain3 *p_swap) {
+	if (p_swap != swap_chain) { return; }
+	release_frame_generation();
+	MutexLock lock(fg_mutex);
+	if (swap_context) { destroy(&swap_context, nullptr); swap_context = nullptr; }
+	swap_chain = nullptr; // Driver releases its final COM reference immediately afterwards.
+}
+HRESULT FidelityFX::present(IDXGISwapChain3 *p_swap, UINT p_interval, UINT p_flags) {
+	if (p_swap != swap_chain) { return p_swap->Present(p_interval, p_flags); }
+	MutexLock lock(fg_mutex);
+	if (!prepared || !fg_version.get() || fg_failed.get()) { disable_frame_generation(); }
+	HRESULT result = p_swap->Present(p_interval, p_flags);
+	if (SUCCEEDED(result)) { game_presents.increment(); }
+	// AMD forwards this query to the real swapchain, so it includes generated
+	// presents. It is not the game-loop FPS or the number of dispatch calls.
+	UINT count = 0;
+	if (SUCCEEDED(p_swap->GetLastPresentCount(&count))) {
+		present_count_available.set(1);
+		presented_frames.add(UINT(count - last_present_count));
+		last_present_count = count;
+	}
+	prepared = false;
+	frame_id++;
+	return result;
+}
+bool FidelityFX::ensure_frame_generation(uint32_t p_width, uint32_t p_height, uint32_t p_hudless_format) {
+	int version = fg_version.get();
+	if (!swap_chain || fg_failed.get() || version < 3 || version > 4 || !fg_supported[version - 3]) { return false; }
+	DXGI_SWAP_CHAIN_DESC1 actual{};
+	swap_chain->GetDesc1(&actual);
+	if (actual.Width != p_width || actual.Height != p_height || actual.Format != DXGI_FORMAT_R8G8B8A8_UNORM) { return false; }
+	if (fg_context && (active_fg_version != version || fg_desc.displaySize.width != p_width || fg_desc.displaySize.height != p_height)) {
+		disable_frame_generation();
+		wait_for_presents();
+		destroy(&fg_context, nullptr);
+		fg_context = nullptr;
+	}
+	if (fg_context) { return true; }
+	fg_backend.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_DX12, &fg_api_version.header };
+	fg_backend.device = device;
+	fg_api_version.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION_VERSION, &fg_hudless.header };
+	fg_api_version.version = FFX_FRAMEGENERATION_VERSION;
+	fg_hudless.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION_HUDLESS, &fg_override.header };
+	fg_hudless.hudlessBackBufferFormat = p_hudless_format;
+	fg_override.header = { FFX_API_DESC_TYPE_OVERRIDE_VERSION, nullptr };
+	fg_override.versionId = fg_ids[version - 3];
+	fg_desc = {};
+	fg_desc.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION, &fg_backend.header };
+	fg_desc.flags = FFX_FRAMEGENERATION_ENABLE_DEPTH_INVERTED;
+	fg_desc.displaySize = { p_width, p_height };
+	fg_desc.maxRenderSize = { p_width, p_height };
+	fg_desc.backBufferFormat = ffxApiGetSurfaceFormatDX12(actual.Format);
+	if (!check(create(&fg_context, &fg_desc.header, nullptr), true)) { return false; }
+	active_fg_version = version;
+	record_provider(&fg_context, true);
+	fg_config = {};
+	fg_config.header.type = FFX_API_CONFIGURE_DESC_TYPE_FRAMEGENERATION;
+	fg_config.swapChain = swap_chain;
+	fg_config.frameGenerationCallback = generate;
+	fg_config.frameGenerationCallbackUserContext = this;
+	// Non-async interpolation keeps the single HUD-less texture on the game queue.
+	fg_config.allowAsyncWorkloads = false;
+	fg_config.generationRect = { 0, 0, (int32_t)p_width, (int32_t)p_height };
+	if (debug_frames) { fg_config.flags = FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_TEAR_LINES | FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_RESET_INDICATORS; }
+	return true;
+}
+ffxReturnCode_t FidelityFX::generate(ffxDispatchDescFrameGeneration *p_desc, void *p_user) {
+	auto *self = static_cast<FidelityFX *>(p_user);
+	// Present holds fg_mutex. The SDK invokes this callback on that same thread.
+	ffxReturnCode_t code = self->dispatch(&self->fg_context, &p_desc->header);
+	if (self->check(code, true)) {
+		self->fg_dispatches.increment();
+		self->generated_frames.add(p_desc->numGeneratedFrames);
+	}
+	return code;
+}
+#endif
