diff --git a/servers/rendering/renderer_rd/shaders/effects/fsr_sdk_prepare.glsl b/servers/rendering/renderer_rd/shaders/effects/fsr_sdk_prepare.glsl
new file mode 100644
--- /dev/null
+++ b/servers/rendering/renderer_rd/shaders/effects/fsr_sdk_prepare.glsl
@@ -0,0 +1,28 @@
+#[compute]
+#version 450
+#VERSION_DEFINES
+#extension GL_EXT_samplerless_texture_functions : require
+#include "motion_vector_inc.glsl"
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(rg16f, set = 0, binding = 0) uniform restrict image2D velocity_buffer;
+layout(set = 1, binding = 0) uniform texture2D depth_buffer;
+layout(set = 2, binding = 0) uniform texture2D color_buffer;
+layout(r8, set = 3, binding = 0) uniform restrict writeonly image2D reactive_buffer;
+layout(push_constant, std430) uniform Params {
+	vec4 resolution;
+	mat4 reprojection;
+} params;
+void main() {
+	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+	if (any(greaterThanEqual(pixel, ivec2(params.resolution.xy)))) { return; }
+	vec2 velocity = imageLoad(velocity_buffer, pixel).rg;
+	if (all(lessThanEqual(velocity, vec2(-1.0)))) {
+		float depth = texelFetch(depth_buffer, pixel, 0).r;
+		vec2 uv = (vec2(pixel) + 0.5) / params.resolution.xy;
+		velocity = derive_motion_vector(uv, depth, params.reprojection);
+	}
+	imageStore(velocity_buffer, pixel, vec4(velocity, 0.0, 0.0));
+	// Godot stores its reactive mask in scene color alpha. Native SDK views
+	// cannot retain Godot's alpha-to-red swizzle, so materialize an R8 texture.
+	imageStore(reactive_buffer, pixel, vec4(texelFetch(color_buffer, pixel, 0).a));
+}
