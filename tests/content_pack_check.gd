extends SceneTree
var failures:=0
func expect(ok: bool, message: String) -> void:
 if not ok:failures+=1;push_error(message)
func _initialize() -> void:call_deferred("run")
func run() -> void:
 var loader=preload("res://native/platform/content_pack.gd").new()
 var args:=OS.get_cmdline_user_args()
 var bytes:=FileAccess.get_file_as_bytes(args[0])
 var sizes: Dictionary=loader.preflight(bytes)
 expect(sizes.has("native-data.json"),"Generated pack passes bounded ZIP preflight")
 expect(loader.preflight(bytes.slice(0,bytes.size()-1)).is_empty(),"Truncated ZIP is rejected")
 for name in ["../escape","data/../../escape","/tmp/escape","data\\escape","data/foo.gd","data//foo","data/C:foo"]:expect(not loader.safe_name(name),"Reject unsafe entry "+name)
 var ticks:=[]
 loader.progress.connect(func(_done,_total):ticks.append(Engine.get_process_frames()))
 var path: String=await loader.install(args[0],"user://pack-check",self)
 expect(not path.is_empty(),"Private pack installs: "+loader.failure)
 expect(ticks.size()>1 and ticks[-1]>ticks[0],"Installation yields frames between batches")
 var content=preload("res://native/content.gd").new()
 expect(await loader.install(args[0],"user://pack-check")==path,"Reinstalling a valid pack reuses its content directory")
 expect(await loader.verify(path,self),"Installed cache verifies after reopening")
 var broken_inventory:=FileAccess.open(path.path_join("pack.json"),FileAccess.WRITE)
 broken_inventory.store_string("{}");broken_inventory.close()
 expect(not await loader.verify(path,self),"A damaged inventory is rejected")
 expect(await loader.install(args[0],"user://pack-check",self)==path,"Reimport repairs a damaged inventory without duplicating valid resources")
 expect(await loader.verify(path,self),"The repaired inventory survives reopening")
 var payload_path:=path.path_join("bindings.json")
 var intact:=FileAccess.get_file_as_bytes(payload_path)
 var damaged:=FileAccess.open(payload_path,FileAccess.WRITE);damaged.store_string("{}");damaged.close()
 expect(not await loader.verify(path,self),"A damaged restored payload is rejected before rendering")
 damaged=FileAccess.open(payload_path,FileAccess.WRITE);damaged.store_buffer(intact);damaged.close()
 var incomplete:="user://pack-check/incoming-interrupted"
 DirAccess.make_dir_recursive_absolute(incomplete)
 var partial:=FileAccess.open(incomplete.path_join("native-data.json"),FileAccess.WRITE);partial.store_string("{");partial.close()
 loader.discard_incomplete("user://pack-check")
 expect(not DirAccess.dir_exists_absolute(incomplete),"Interrupted staging is removed on restart")
 expect(await loader.verify(path,self),"Recovery preserves the completed import")
 expect(content.load_cache(path),"Installed pack loads into engine")
 var inventory_path:=path.path_join("pack.json")
 var inventory:=FileAccess.get_file_as_bytes(inventory_path)
 DirAccess.remove_absolute(inventory_path)
 expect(await loader.verify(path,self),"An intact legacy cache opens without an inventory")
 var missing_path:=path.path_join(str(content.registry[0].model)+".json")
 var missing:=FileAccess.get_file_as_bytes(missing_path);DirAccess.remove_absolute(missing_path)
 expect(not await loader.verify(path,self),"An interrupted legacy cache is rejected when a model is missing")
 for restore in [[inventory_path,inventory],[missing_path,missing]]:
  var output:=FileAccess.open(restore[0],FileAccess.WRITE);output.store_buffer(restore[1]);output.close()
 var previous: String=content.root
 expect(not content.load_cache("user://missing-content") and content.root==previous,"Failed content load preserves active cache")
 # Corrupt one payload without changing the signed-by-hash manifest.
 var reader:=ZIPReader.new();reader.open(args[0]);var writer:=ZIPPacker.new();writer.open("user://bad.abyss")
 for name in reader.get_files():
  writer.start_file(name)
  var data:=reader.read_file(name)
  if name=="native-data.json":data[0]=0
  writer.write_file(data);writer.close_file()
 reader.close();writer.close()
 expect((await loader.install("user://bad.abyss","user://pack-check",self)).is_empty(),"Checksum mismatch never activates")
 expect(content.load_cache(previous),"Bad import leaves existing content usable")
 loader.remove_tree("user://pack-check");DirAccess.remove_absolute("user://bad.abyss")
 print("CONTENT_PACK ",failures," failures");quit(1 if failures else 0)
