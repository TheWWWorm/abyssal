; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/icon="res://ui/abyssal-icon.png"
config/windows_native_icon="res://ui/abyssal-icon.ico"
config/macos_native_icon="res://ui/abyssal-icon.icns"
config/name="Abyssal"
boot_splash/show_image=true
boot_splash/image="res://ui/abyssal-splash.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.012, 0.035, 0.055, 1)
config/use_custom_user_dir=true
config/custom_user_dir_name="abyssal-engine"
; The renderer chosen in Settings, read at start (renderer_choice.gd).
config/project_settings_override.windows="user://renderer.cfg"
config/project_settings_override.linuxbsd="user://renderer.cfg"
config/project_settings_override.android="user://renderer.cfg"
run/main_scene="res://scenes/native_main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

DiscordActivity="*res://native/platform/discord_presence.gd"
RendererChoice="*res://native/platform/renderer_choice.gd"

[discord]

application_id="1561821965210222642"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/min_width=800
window/size/min_height=600
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=6

[editor]

; Godot 4.7 can crash while concurrently reimporting changed PCM samples.
import/use_multiple_threads=false

[input]

; Keep keyboard activation alongside gamepad south/east buttons on every device.
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194309), Object(InputEventKey,"keycode":4194310), Object(InputEventKey,"keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}

[input_devices]

pointing/emulate_mouse_from_touch=true
; Godot 4.3 and later leave the phone's sensors off unless asked; tilt steering reads them.
sensors/enable_accelerometer=true
sensors/enable_gravity=true

[rendering]

; Solid station shaders benefit from OpenGL's depth prepass on Adreno too.
driver/depth_prepass/disable_for_vendors="PowerVR,Mali,Apple"
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
; A desktop without a usable Vulkan device starts on OpenGL
; instead of failing; the enhanced options that need Forward+ then stay off.
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=false
; The deep water is a few smooth, dark gradients; without a little dither
; they step into visible contours on phone screens.
anti_aliasing/quality/use_debanding=true
lights_and_shadows/positional_shadow/atlas_size=8192
; Long underwater sightlines need more depth precision, including on WebGL.
lights_and_shadows/positional_shadow/atlas_16_bits=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
; Three times the default froxel grid keeps the headlight shafts smooth at
; native resolution; the next step up (256x128) costs another millisecond a
; frame near a lit station and is not distinguishable from this one.
environment/volumetric_fog/volume_size=192
environment/volumetric_fog/volume_depth=96
environment/defaults/default_clear_color=Color(0.012, 0.035, 0.055, 1)

[shader_globals]

ocean_light_gain={
"type": "float",
"value": 1.0
}

ocean_upper_color={
"type": "vec3",
"value": Vector3(0.018, 0.08, 0.16)
}

ocean_haze_gain={
"type": "float",
"value": 1.0
}

ocean_water_tint={
"type": "vec3",
"value": Vector3(1, 1, 1)
}

ocean_sun_gain={
"type": "float",
"value": 1.0
}
ocean_sun_color={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
ocean_shaft_gain={
"type": "float",
"value": 0.0
}
ocean_region_strength={
"type": "float",
"value": 0.6
}
ocean_model_light={
"type": "vec2",
"value": Vector2(1, 1)
}
ocean_veil_phase={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
ocean_veil_fine_phase={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
ocean_bank_phase={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
ocean_column_phase={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
ocean_column_fine_phase={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
ocean_station_warmth={
"type": "float",
"value": 1.0
}
ocean_classic_sky={
"type": "float",
"value": 0.0
}
ocean_suspension_phase={
"type": "vec3",
"value": Vector3(0, 0, 0)
}

ocean_radiance_map={
"type": "sampler2D",
"value": ""
}

ocean_visual_time={
"type": "float",
"value": 0.0
}
