const BLOCKS := {
	"chapter/1": [
		[1, "Streszczenie", "Kampania zaczyna się na morzu. Pilot, nowy przybysz na oceanicznej planecie zatrudniony jako rybak kolonii, wypływa małą łodzią podwodną. Towarzyszy mu [[character/1]], gadatliwy komputer pokładowy. Ten rozdział uczy połowu harpunem: należy wycelować w stworzenie, wystrzelić harpun, a potem trzymać cel w polu widzenia, gdy się szarpie, aż opadnie z sił i da się go wciągnąć. Zob. [[guide/fishing]].", false],
		[2, "Zakończenie", "Gdy pierwsze stworzenie trafia na pokład, M.A.I. przedstawia autopilota, który potrafi doprowadzić statek do wybranego celu, i kieruje pilota na stację [[station/0]], by sprzedał połów. Zob. [[guide/navigation]].", false],
	],
	"chapter/10": [
		[10, "Streszczenie", "Na stacji [[station/2]] start kapsuł już trwa, a Akwarianie atakują. Przez radio odzywa się [[character/9]] z dosadnym ostrzeżeniem: utrata więcej niż pięciu kapsuł jest niedopuszczalna. Pilot musi odeprzeć napastników i ochronić kapsuły.", false],
		[11, "Zakończenie", "Atak zostaje odparty, ale pilot zastanawia się, dlaczego Akwarianie w ogóle biorą na cel kapsuły. Według komputera, którym jest [[character/1]], mogą być znacznie inteligentniejsi, niż sądzą koloniści. Pilot płynie na stację złożyć raport, coraz mniej pewny, czy to praca dla niego.", false],
	],
	"chapter/11": [
		[11, "Streszczenie", "Po obronie kapsuł pilot dokuje na stacji [[station/2]], by zameldować się u zleceniodawcy. Jest nim [[character/9]].", false],
		[12, "Zakończenie", "Jack obwinia pilota o uszkodzone kapsuły, odwołuje nagrodę i odchodzi z uwagą, że jemu pisane są większe rzeczy. Wtedy [[character/1]] stawia ważniejsze pytanie: pilot ciężko pracuje dla kolonii, zarabia niewiele i nie ma nic do powiedzenia w sprawie połowu. Pilot chce tylko zarobić na bilet z planety. M.A.I. zdradza, że przechwycił komunikację radiową ruchu oporu działającego na stacji [[station/3]], i zaznacza tę stację na mapie. Od tej chwili stacje ruchu oporu są oznaczone na zielono.", false],
	],
	"chapter/12": [
		[12, "Streszczenie", "Pilot płynie na stację [[station/3]], by odnaleźć ruch oporu. Próba cichego podejścia od razu się nie udaje: strażnicy stacji zatrzymują statek i grożą otwarciem ognia. Pilot podaje swoje imię, mówi, że wyruszył ze stacji [[station/0]], i prosi o przyjęcie do ruchu. Po pełnej napięcia ciszy statek dostaje zgodę na dokowanie.", false],
		[13, "Zakończenie", "W środku nowego przybysza przesłuchuje [[character/4]]. Pilot nie wie prawie nic poza tym, że ruch popiera wolny handel, co zgadza się z wyjaśnieniem Pierre'a, że ich szyfr radiowy dopiero co włączono. Ruchowi brakuje rąk do pracy, więc Pierre przyjmuje pilota na próbę. Ruch zamierza pozyskać przywódców stacji kolonistów i położyć kres wyzyskowi planety. Pierwsze zadanie to zabrać sympatyków ze stacji [[station/4]] i przewieźć ich na stację [[station/5]].", false],
	],
	"chapter/13": [
		[13, "Streszczenie", "Pilot dociera na stację [[station/4]] po łącznika ruchu, wciąż nie mając jasnego pojęcia, czym jest ruch oporu ani na czym polega zadanie. [[character/1]] zauważa, że to i tak ciekawsze niż wykonywanie poleceń, które wydaje [[character/9]], a pilot się z tym zgadza.", false],
		[14, "Zakończenie", "Łącznikiem okazuje się [[character/5]], ciepła, bystra i wyraźnie zadowolona z poznania pilota. Plany ruchu zachowuje dla siebie, bo tajemnica pozwoliła mu dotąd przetrwać, i przesyła współrzędne podróży. [[character/1]] obserwuje tę dwójkę z nieukrywaną irytacją, co pilot żartobliwie bierze za zazdrość.", false],
	],
	"chapter/14": [
		[14, "Streszczenie", "Na pokładzie jest teraz [[character/5]], a pilot musi jak najszybciej i najbezpieczniej przewieźć ją na stację [[station/5]].", false],
		[15, "Zakończenie", "Na stacji [[station/5]] Leah się ukrywa, by załatwić pewne sprawy. Przedtem wyjaśnia, jak działają rebelianci: biorą tylko to, co morze może oddać, przerabiają połów na towary i uważają, by nie przełowić łowisk. Prosi pilota, by spróbował sam i wyprodukował pięć ton towarów w fabryce stacji ruchu oporu. Proponuje stację [[station/90]], gdzie można łowić kałamarnice i kupić towar [[goods/35]], by wytworzyć produkt [[goods/22]].", false],
	],
	"chapter/15": [
		[15, "Streszczenie", "Rozdział o produkcji. Pilot musi wyprodukować pięć ton towarów w fabryce stacji rebeliantów, łącząc połów i kupione składniki w produkty warte więcej niż surowiec. Zob. [[guide/trading]].", false],
		[16, "Zakończenie", "Odzywa się [[character/5]]. Skoro pilot ma już drugi sposób zarabiania, czeka go nowe zadanie: odwiedzić jak najwięcej nieznanych stacji. Ruch wykorzystuje świeże raporty z każdej stacji, by znaleźć słabe punkty i przeciągnąć mieszkańców na swoją stronę. Gdy pilot pyta, czy to rewolucja, Leah nie chce powiedzieć nic więcej i radzi tymczasem zarabiać na ulepszenia statku.", false],
	],
	"chapter/16": [
		[16, "Streszczenie", "Pilot musi odkryć pięć stacji, których wcześniej nie odwiedził. Eksploracja poszerza sieć handlową i dostarcza ruchowi informacji. Niektóre stacje mogą leżeć poza obecnym zasięgiem głębokości statku. Zob. [[guide/depth]].", false],
		[17, "Zakończenie", "Długą wiadomość przysyła [[character/4]], a [[character/1]] streszcza ją do jednego punktu: pilot ma wrócić na stację [[station/3]] na odprawę.", false],
	],
	"chapter/17": [
		[17, "Streszczenie", "Na prośbę, z którą zwraca się [[character/4]], pilot wraca na stację [[station/3]] i dostaje zgodę na dokowanie.", false],
		[18, "Zakończenie", "Pierre informuje, że dzięki dyplomacji strefa rebeliantów się powiększyła, więc pilot może teraz handlować na znacznie większej liczbie stacji. W wiadomościach już mówi się o rewolucji, a wielu decydentów przyłączyło się bez rozlewu krwi, choć Pierre wątpi, by tak zostało. Przywódca ruchu kieruje dalszymi działaniami z jednej z nowo pozyskanych stacji i nawiąże kontakt. Pierre zaznacza możliwe stacje i ostrzega, że dotarcie do niektórych może wymagać lepszego pancerza lub osłon.", false],
	],
	"chapter/18": [
		[18, "Streszczenie", "Pilot musi odnaleźć przywódcę ruchu wśród nowo pozyskanych stacji, zdając się głównie na szczęście. Trop prowadzi na stację [[station/6]].", false],
		[19, "Zakończenie", "Na stacji [[station/6]] na pilota czeka [[character/2]], która kieruje ruchem i odtąd będzie wydawać rozkazy. Pilot spodziewał się mężczyzny, ale ona zbywa to machnięciem ręki. Jej pierwsze zlecenie to eskorta: ławica [[species/10|ośmiornic]] musi dotrzeć na bezpieczne wody, zanim koloniści ją wyłapią lub wybiją, a walka jest prawdopodobna. [[character/1]] narzeka, że nikt nie wspomniał o zapłacie.", false],
	],
	"chapter/19": [
		[19, "Streszczenie", "W pobliżu stacji [[station/7]] pilot musi chronić ławicę stworzeń ([[species/10]]) przed statkami kolonistów, uważając, by nie trafić zwierząt. Obok ławicy płyną Akwarianie, a [[character/1]] zastanawia się, czy opiekują się oni morskimi stworzeniami.", false],
		[20, "Zakończenie", "Statki kolonistów zbliżają się do zwierząt, a pilot musi je przechwycić, zanim podpłyną za blisko. Ławica przeżywa. [[character/2]] wypłaca skromną nagrodę i prosi pilota o natychmiastowy powrót po nowe zadanie. M.A.I. narzeka, że złowienie i sprzedanie zwierząt byłoby bardziej opłacalne.", false],
	],
	"chapter/2": [
		[2, "Streszczenie", "Z rybami w ładowni pilot płynie na stację [[station/0]], stację kolonistów, która skupuje dzienny połów. Rozdział to prosta podróż i pierwsza okazja, by zadokować i rozejrzeć się po stacji.", false],
		[3, "Zakończenie", "Na stacji [[station/0]] skupem połowu zajmuje się [[character/9]]. Płaci swoją zwykłą stałą cenę, kpi z wielkości ładowni pilota i podsuwa, że ktoś z prawdziwym działem zarobiłby więcej na polowaniu na piratów. Gdy odchodzi, M.A.I. przyznaje, że to nieprzyjemny typ, ale podchwytuje wskazówkę: w hangarze akurat jest w ofercie [[equipment/0]]. M.A.I. wyjaśnia też, że na każdym ekranie stacji dostępna jest pomoc.", false],
	],
	"chapter/20": [
		[20, "Streszczenie", "Pilot wraca na stację [[station/6]], gdzie czeka na jego raport [[character/2]].", false],
		[21, "Zakończenie", "Pilot w końcu pyta Ayumi, o co walczy ruch. Ayumi opisuje grupę zjednoczoną przeciw niszczeniu planety: szybka kolonizacja wyczerpuje jej zasoby szybciej, niż przyroda zdoła je odtworzyć, tak jak już stało się na innych światach, a celem jest przekonanie wpływowych ludzi do oporu. Tymczasem konflikt wykorzystują [[faction/pirates]]. Ayumi postanawia uderzyć pierwsza i wysyła pilota przeciw formacji piratów. U jego boku płynie [[character/3]], jeden z jej najlepszych pilotów.", false],
	],
	"chapter/21": [
		[21, "Streszczenie", "W pobliżu stacji [[station/8]] pilot dołącza do towarzysza, by rozbić bandę piratów. Towarzyszem tym jest [[character/3]]. Raymond od pierwszej chwili jest niecierpliwy i protekcjonalny, każe nowicjuszowi trzymać się z tyłu i uczyć.", false],
		[22, "Zakończenie", "Banda zostaje rozbita. Raymond niechętnie chwali pilota, a [[character/2]] wypłaca obu taką samą nagrodę i prosi pilota o spotkanie na stacji [[station/9]]. Raymond jest wściekły, że pieniądze podzielono po równo, i lekceważy wkład pilota, a pilot odpływa, zanim humor Raymonda jeszcze się pogorszy.", false],
	],
	"chapter/22": [
		[22, "Streszczenie", "Pilot płynie na stację [[station/9]], gdzie właśnie zakończyła rozmowy [[character/2]]. Kilka stacji, w tym [[station/9]], stoi teraz po stronie ruchu.", false],
		[23, "Zakończenie", "Przed wypłynięciem Ayumi chce zabezpieczyć szlak zaopatrzenia na stację [[station/37]]. Tuż przed stacją pole minowe, które ma przeciąć szlak, rozstawił [[character/9]]. Ayumi go zna: niegdyś mało znaczący, szybko awansował dzięki przydatnym znajomościom. Ostrzega, że w okolicy prawdopodobnie krążą piraci, a miny można zniszczyć dopiero po ich uaktywnieniu.", false],
	],
	"chapter/23": [
		[23, "Streszczenie", "Przed stacją [[station/9]] pilot musi oczyścić pole minowe blokujące szlak na stację [[station/37]]. Ayumi zaznacza miny na mapie. Do każdej miny trzeba podpłynąć, by uruchomić jej czujnik ruchu, i dopiero wtedy można ją zestrzelić. W pobliżu czają się piraci, czekając na łatwą zdobycz, więc pilot musi się też nimi zająć. Zob. [[contract/10]].", false],
		[24, "Zakończenie", "Pole minowe jest oczyszczone, a szlak na stację [[station/37]] znów bezpieczny. [[character/2]] cieszy się, że jej zaufanie było uzasadnione, i płaci pilotowi za pracę.", false],
	],
	"chapter/24": [
		[24, "Streszczenie", "Po oczyszczeniu pola minowego pilot wraca na stację [[station/9]]. Szlak zaopatrzenia na stację [[station/37]] jest znów otwarty, więc duża grupa stacji w całym oceanie handluje teraz z ruchem, a strefa rebeliantów na mapie znacznie się powiększa.", false],
		[25, "Zakończenie", "Na stacji [[station/9]] pilota znów wita [[character/5]], a rozmowa jest serdeczna, choć niezręczna. Przerywa ją [[character/2]] z kolejnym zadaniem: dalsze negocjacje na stacji [[station/10]] mogą przeciągnąć na stronę ruchu następne stacje. Pilot i Leah mają eskortować tam Ayumi i jej asa, którym jest [[character/3]]. Pilot nie ma ochoty ruszać w drogę z Raymondem, ale Ayumi ręczy za jego umiejętności i nie spodziewa się niczego gorszego niż piraci.", false],
	],
	"chapter/25": [
		[25, "Streszczenie", "Eskorta dociera na stację [[station/10]] i od razu widać, że coś jest nie tak. Z siłami kolonistów czeka tam [[character/9]] i wydaje rozkaz ataku. Ayumi nie rozumie, skąd wiedzieli o jej przybyciu. Pilot musi powstrzymać napastników i utrzymać przy życiu przywódczynię ruchu. Jest nią [[character/2]].", false],
		[26, "Zakończenie", "W trakcie walki [[character/3]] twierdzi, że zawiodła jego broń, i ucieka. Reszta przeżywa. [[character/5]] oskarża go o zdradę, a Ayumi wciąż mu ufa i podejrzewa sabotaż. Zanim nadciągną kolejni koloniści, grupa się rozdziela: Ayumi się ukrywa, Leah prowadzi sprawy na stacji [[station/9]], a pilot ma się stać znacznie sprawniejszym wojownikiem przed ich następnym spotkaniem.", false],
	],
	"chapter/26": [
		[26, "Streszczenie", "Ukrywa się [[character/2]], a [[character/3]] zniknął, więc pilot musi zniszczyć jeszcze dziesięć wrogich statków, by dowieść gotowości do trudniejszych bitew. Piraci są wygodnymi celami, a więcej okazji dają kontrakty bojowe z tablic. To dobry moment na ulepszenie broni i pancerza. Zob. [[guide/combat]].", false],
		[27, "Zakończenie", "Niespodziewanie dzwoni [[character/3]], pyta o Ayumi i Leah i twierdzi, że ma pilne informacje. Proponuje spotkanie w pobliżu stacji [[station/11]]. [[character/1]] jest pewien, że to pułapka. Pilot się zgadza i mimo to wyrusza.", false],
	],
	"chapter/27": [
		[27, "Streszczenie", "W pobliżu stacji [[station/11]] pilot podąża za punktami nawigacyjnymi na spotkanie, na którym czeka [[character/3]], w pełni spodziewając się pułapki. Cel misji, przejęcie unieruchomionego statku, sugeruje, że spotkanie nie skończy się na rozmowie.", false],
		[28, "Zakończenie", "W niewoli Raymonda jest [[character/2]], a on sam żąda kapitulacji. Gdy [[character/1]] skanuje jego statek, pilot zajmuje Raymonda rozmową. Raymond przyznaje, że zmienił stronę dla pieniędzy: [[character/9]] wyznaczył nagrodę za głowę Ayumi i pilota. Skan pokazuje jednoosobowy statek, więc Ayumi musi być w opancerzonej ładowni. Pilot niszczy statek Raymonda i wyławia kontener, zanim ten zatonie, po czym kieruje się na stację [[station/12]].", false],
	],
	"chapter/28": [
		[28, "Streszczenie", "Pilot przewozi odzyskany kontener w bezpieczne miejsce, na stację [[station/12]], najbliższą przyjazną stację, z nadzieją, że [[character/1]] dobrze zgaduje, co jest w środku.", false],
		[29, "Zakończenie", "Z kontenera wychodzi [[character/2]], wstrząśnięta, ale cała, i dziękuje pilotowi za uratowanie życia. Nie ma czasu na odpoczynek. Przed porwaniem organizowała transport zespołu wybitnych naukowców na stację [[station/14]], a Raymond mógł już przekazać szczegóły. Pilot musi bezpiecznie przeprowadzić konwój przez strefę przygraniczną.", false],
	],
	"chapter/29": [
		[29, "Streszczenie", "W pobliżu stacji [[station/13]] pilot zastaje konwój naukowców pod silnym ostrzałem i zdąża w ostatniej chwili. Przyjazne statki wzywają wsparcia, bo ich obrona słabnie. Pilot musi przegonić napastników i przeprowadzić konwój przez strefę przygraniczną. Każdy utracony statek zagraża tajnemu projektowi ruchu.", false],
		[30, "Zakończenie", "Konwój przedostaje się na drugą stronę, a jego załoga dziękuje za ratunek. [[character/2]] przyznaje, że było blisko. Następnie [[character/2]] płaci pilotowi i prosi o spotkanie na stacji [[station/14]], gdzie wyjaśni, co dalej.", false],
	],
	"chapter/3": [
		[3, "Streszczenie", "Krótki rozdział szkoleniowy o wyposażaniu statku. Pilot odwiedza hangar na stacji [[station/0]], aby kupić i zamontować pierwszą prawdziwą broń statku: [[equipment/0]]. Rozdział pokazuje, jak kupuje się wyposażenie i montuje je w wolnym gnieździe. Zob. [[guide/fitting]].", false],
		[4, "Zakończenie", "Gdy działo jest już zamontowane, M.A.I. przypomina pilotowi, by nie strzelał do nieszkodliwych morskich stworzeń, i od razu proponuje próbę sił z piratami.", false],
	],
	"chapter/30": [
		[30, "Streszczenie", "Pilot płynie na stację [[station/14]], dokąd dotarł konwój naukowców.", false],
		[31, "Zakończenie", "Czekają tam [[character/5]], [[character/4]] i [[character/2]]. Ayumi przedstawia plan: koloniści wciąż przewyższają rebeliantów liczebnie, więc profesor Abel i jego zespół zbudują broń, która wyrówna szanse, w trzech krokach. Pierwszy to źródło energii, generator Biotek. Prototyp Abla ukradli koloniści, którzy próbują go sami dokończyć. Leah dodaje, że generator płynie ze zwykłym konwojem kolonistów w pobliżu stacji [[station/2]]. Nikt nie wie, który statek go wiezie, więc pilot i Pierre muszą zatrzymać cały konwój i odzyskać każdy kontener.", false],
	],
	"chapter/31": [
		[31, "Streszczenie", "W pobliżu stacji [[station/2]] trzy statki przechwytują konwój kolonistów ze skradzionym generatorem Biotek. Dowodzą nimi pilot, [[character/5]] i [[character/4]]. Nikt nie wie, na którym statku jest generator, więc trzeba zatrzymać każdą jednostkę konwoju. Załogi konwoju protestują, że wiozą tylko żywność i leki, a [[character/4]] odpowiada czarnym żartem. Pilot musi unieruchomić statki i wyłowić harpunem każdy kontener, zanim ładunek zatonie.", false],
		[32, "Zakończenie", "Wszystkie kontenery zostają odzyskane, w tym generator, a zespół wraca na stację [[station/14]], by przekazać łup profesorowi Ablowi.", false],
	],
	"chapter/32": [
		[32, "Streszczenie", "Pilot wraca na stację [[station/14]] z odzyskanym ładunkiem.", false],
		[33, "Zakończenie", "Profesor Abel zabiera łup do laboratorium. [[character/2]] wydaje polecenia: na patrol wokół stacji [[station/14]] rusza [[character/5]], do hangaru idzie [[character/4]], a pilot otrzymuje drugi krok. Generator potrzebuje broni godnej swojej mocy. Ma nią być działo [[equipment/42]], stacyjne działo obronne tak energochłonne, że nigdy nie zamontowano go na statku. Najbliższa fabryka, stacja [[station/188]], jest w rękach kolonistów, więc pilot powinien spróbować na stacji [[station/15]]. Działo nie jest na sprzedaż, dlatego Ayumi przekazuje dużą sumę na łapówki.", false],
	],
	"chapter/33": [
		[33, "Streszczenie", "Zaczyna się drugi krok planu, który ułożyła [[character/2]]. Pilot wyrusza na stację [[station/15]], stację rebeliantów, by zdobyć działo [[equipment/42]]. Działo to zwykle produkuje stacja kolonistów [[station/188]] i nigdzie nie jest sprzedawane jawnie. Pilot ma od Ayumi pokaźny fundusz na łapówki, ale żadnego konkretnego planu, i liczy, że okazja nadarzy się na miejscu.", false],
		[34, "Zakończenie", "Pilot przybywa na stację [[station/15]]. Bez kontaktów i bez planu pozostaje mu tylko rozejrzeć się po stacji i zobaczyć, co się wydarzy.", false],
	],
	"chapter/34": [
		[34, "Streszczenie", "Na stacji [[station/15]] trop zaczyna się od asortymentu miejscowego handlarza. Celem jest zdobycie ładunku towaru [[goods/37]], który na tej stacji jest nielegalny, co przyciąga uwagę właściwych osób.", false],
		[35, "Zakończenie", "Do pilota podchodzi handlarz z czarnego rynku, [[character/8]], i oferuje, że załatwi niemal wszystko. Gdy pilot prosi o działo [[equipment/42]], handlarz jest zdumiony, ale zgadza się spróbować w zamian za przysługę. Pilot ma wyeliminować łowcę nagród, który krąży w pobliżu stacji. Łowcą jest [[character/11]], opłacany przez służby bezpieczeństwa, by pozbyć się Fenki.", false],
	],
	"chapter/35": [
		[35, "Streszczenie", "W pobliżu stacji [[station/15]] pilot tropi łowcę nagród. To [[character/11]], którego chce się pozbyć [[character/8]]. Raoul nie jest sam: przyprowadził eskortę i próbuje zbyć pilota jako zwykłego rybaka. Pilot musi zniszczyć poszukiwany statek. Zob. [[contract/0]].", false],
		[36, "Zakończenie", "Statek Raoula zostaje zniszczony po jego ostatniej próbie wykręcenia się słowami, a eskorta zostaje przegoniona lub zatopiona. Pilot wraca sprawdzić, czy [[character/8]] dotrzyma słowa.", false],
	],
	"chapter/36": [
		[36, "Streszczenie", "Pilot dokuje na stacji [[station/15]], by odebrać to, co obiecał [[character/8]], niepewny, czy handlarzowi z czarnego rynku można zaufać.", false],
		[37, "Zakończenie", "Fenko zdobył działo [[equipment/42]] i je sprzeda, po cenie wywindowanej przez łapówki, które sam zapłacił. Gdy pilot pyta o pochodzenie działa, Fenko wskazuje sprzedawcę. Był nim [[character/9]]. [[character/1]] delektuje się ironią sytuacji, w której chciwość Jacka zbroi jego własnych wrogów. Pilot postanawia kupić działo i odpłynąć, zanim coś się zmieni.", false],
	],
	"chapter/37": [
		[37, "Streszczenie", "Na stacji [[station/15]] [[character/8]] wystawia teraz na sprzedaż działo [[goods/38|Eclipse]]. Pilot musi kupić je na ekranie handlu i załadować na pokład. Cena jest wysoka, ale fundusz łapówkowy od Ayumi był przeznaczony właśnie na to, a w ładowni musi być miejsce na duże działo. Zob. [[guide/trading]].", false],
		[38, "Zakończenie", "Działo jest w ładowni, w co [[character/1]] ledwie może uwierzyć. Drugi krok został wykonany. Pilot wraca na stację [[station/14]], by sprawdzić postępy prac nad prototypem generatora.", false],
	],
	"chapter/38": [
		[38, "Streszczenie", "Pilot wraca na stację [[station/14]] z działem [[equipment/42]] w ładowni, ciekaw, jak daleko z prototypem zaszedł profesor Abel.", false],
		[39, "Zakończenie", "[[character/2]] woli nie wiedzieć, jak zdobyto działo. Prototyp jest prawie gotowy, ale jednej części nie da się wykonać na stacji [[station/14]]. Tą częścią jest [[goods/36]], urządzenie, które powiela DNA cząstek glonów, by zapoczątkować reakcję energetyczną generatora. Tylko stacja [[station/16]] ma sprzęt do jego produkcji, więc trzeci krok prowadzi pilota właśnie tam. [[character/1]] zauważa, że pilot najwyraźniej sam prowadzi całą rebelię.", false],
	],
	"chapter/39": [
		[39, "Streszczenie", "Zaczyna się trzeci krok. Pilot płynie na stację [[station/16]], jedyną stację ze sprzętem do produkcji urządzenia potrzebnego generatorowi Biotek. Tym urządzeniem jest [[goods/36]]. Stacja [[station/16]] leży głębiej niż większość stacji, więc statek może potrzebować mocniejszego pancerza, zanim bezpiecznie do niej dotrze. Zob. [[guide/depth]].", false],
		[40, "Zakończenie", "Pilot dokuje na stacji [[station/16]] i zaczyna ustalać, czego wymaga inkubator, spodziewając się, że zadanie będzie wszystkim, tylko nie prostą sprawą.", false],
	],
	"chapter/4": [
		[4, "Streszczenie", "Rozdział szkoleniowy o opuszczaniu stacji. Pilot wypływa ze stacji [[station/0]] na poszukiwanie piratów, ale w okolicy panuje spokój, więc M.A.I. proponuje popłynąć do innej stacji.", false],
		[5, "Zakończenie", "M.A.I. objaśnia S.T.R.E.A.M., sieć prądów służącą do dalekich podróży: statek zawsze opuszcza sektor przez wyjście S.T.R.E.A.M. i dociera do następnego przez wejście S.T.R.E.A.M., a podróż może przejąć autopilot. Zob. [[guide/navigation]].", false],
	],
	"chapter/40": [
		[40, "Streszczenie", "Na stacji [[station/16]] pilot musi wyprodukować w fabryce stacji jeden produkt: [[goods/36]]. Inkubator to zaawansowany produkt, a jego receptura wymaga kilku składników, które trzeba najpierw złowić, kupić lub wytworzyć gdzie indziej. [[character/1]] spodziewa się komplikacji, podobnie jak pilot. Zob. [[guide/trading]].", false],
		[41, "Zakończenie", "Inkubator jest gotowy. M.A.I. przyznaje, że wątpił, czy pilotowi się uda. Wciąż niepewny, czy to wszystko jest słuszne, pilot wyznacza kurs na stację [[station/14]].", false],
	],
	"chapter/41": [
		[41, "Streszczenie", "Pilot musi bezpiecznie dostarczyć na stację [[station/14]] urządzenie, na które czeka profesor Abel, by dokończyć prototyp generatora. To [[goods/36]], ostatni brakujący element trzykrokowego planu, który ułożyła [[character/2]].", false],
		[42, "Zakończenie", "Inkubator odbiera [[character/5]]. Profesor Abel ma wszystko gotowe, a działo [[equipment/42]] wkrótce powinno być dostępne w hangarze. Ayumi chce od razu przetestować działo na piratach, a Leah przekazuje współrzędne z ostrzeżeniem, że generator to tylko prototyp. [[character/1]], rzekomo wyłączony, daje do zrozumienia, że słyszał każde słowo.", false],
	],
	"chapter/42": [
		[42, "Streszczenie", "Z działem [[equipment/42]] zamontowanym w hangarze stacji [[station/14]] pilot rusza do kryjówki piratów w pobliżu stacji [[station/17]], by wypróbować je w walce. Generator to dopiero prototyp, więc test sprawdza też, czy wytrzyma obciążenie. Gdy piraci widzą, z czym mają do czynienia, wzywają posiłki, a w trakcie walki nadciągają kolejne statki.", false],
		[43, "Zakończenie", "Pod koniec walki [[character/1]] odbiera wezwanie pomocy ze stacji [[station/14]], nadane otwarcie na nieszyfrowanym kanale. Pilot natychmiast zawraca.", false],
	],
	"chapter/43": [
		[43, "Streszczenie", "Siły kolonistów przypuściły niespodziewany atak na stację [[station/14]]. Wiele doków jest uszkodzonych, a rebelianci nie mogą wypuścić dość statków. Szturmem dowodzi [[character/9]] i drwi z pilota, dopóki nie usłyszy, że działo [[equipment/42]] jest gotowe do strzału. Pilot musi bronić stacji i jej przyjaznych statków.", false],
		[44, "Zakończenie", "W środku bitwy przybywają Akwarianie i zwracają się przeciw kolonistom, walcząc po stronie rebeliantów. Jack dezerteruje, gdy atak się załamuje. [[character/2]] nazywa ten ratunek cudem i prosi pilota, by zadokował, wspominając o wyjątkowym gościu.", false],
	],
	"chapter/44": [
		[44, "Streszczenie", "Po bitwie pilot dokuje na stacji [[station/14]].", false],
		[45, "Zakończenie", "Wyjątkowym gościem jest delegat Akwarian. Akwarianie pomogą zakończyć rządy kolonistów, by wszyscy mogli żyć w harmonii z morzem. [[character/2]] planuje dwie wielkie ofensywy, by zdobyć pozostałe stacje. Stacja [[station/188]] jest już w rękach rebeliantów, więc jak najwięcej statków otrzymuje działa [[equipment/42]]. Pilot poprowadzi atak na stację [[station/18]] ze świeżymi oddziałami i wsparciem Akwarian, a szturmem na stację [[station/109]] pokieruje [[character/5]].", false],
	],
	"chapter/45": [
		[45, "Streszczenie", "Na stacji [[station/18]] na pilota czeka [[character/12]], dowódca eskadry Atmos, której statki oczekują na rozkaz do ataku. Z głębin wynurzają się Akwarianie, by się przyłączyć. Przed zdobyciem stacji trzeba zniszczyć każdy statek kolonistów, łącznie z frachtowcami. W tym samym czasie [[character/5]] prowadzi równoległy szturm na stację [[station/109]].", false],
		[46, "Zakończenie", "Obrońcy z kolonii i ich frachtowce zostają rozbici, a połączone siły rebeliantów i Akwarian panują nad wodami wokół stacji. Pilot wysyła połowę eskadry Colina na patrol wokół stacji, a z resztą wpływa do doku.", false],
	],
	"chapter/46": [
		[46, "Streszczenie", "Pilot dokuje na stacji [[station/18]] z częścią eskadry, którą dowodzi [[character/12]], by zabezpieczyć zdobytą stację, a reszta patroluje na zewnątrz.", false],
		[47, "Zakończenie", "[[character/5]] melduje, że jej atak na stację [[station/109]] także się powiódł, a stacje południowe są teraz pod kontrolą rebeliantów. Ayumi przydzieliła pilotowi zadanie, które może być ostatnie: stację [[station/0]], ostatni wielki bastion kolonistów, gdzie zaczęła się historia pilota. Stacja jest silnie ufortyfikowana, a [[character/2]] już jest w drodze. Leah podąża za nią, ale piraci blokują jej trasę.", false],
	],
	"chapter/47": [
		[47, "Streszczenie", "Na stacji [[station/0]] pilot dołącza do ostatniej bitwy. Walczą w niej także [[character/2]] i [[character/5]]. Przed zdobyciem stacji trzeba zniszczyć każdy statek obrońców. Wśród obrońców jest [[character/9]]. Pilot przypomina, jak skończył [[character/3]], a wtedy Jack próbuje wytrącić go z równowagi niedorzeczną opowieścią, że jest ojcem pilota, a Raymond był jego bratem. Pilot od razu rozpoznaje kłamstwo.", false],
		[48, "Zakończenie", "Flota kolonistów pada, aż zostaje tylko Jack. Okazuje się szybki i groźny, ale pilot w końcu unieruchamia jego statek. Jack ucieka w górę w kapsule ratunkowej, która zdaje się zabierać ze sobą całą stację, i na odchodne gardzi planetą. Bitwa jest skończona.", false],
	],
	"chapter/48": [
		[48, "Streszczenie", "Wojna jest wygrana. Flota kolonistów została pokonana, [[character/9]] uciekł z planety, a stacja [[station/0]] i ostatnie bastiony przyłączają się do rebeliantów. Wszystkie stacje stoją teraz po stronie ruchu.", false],
		[48, "", "Zwycięzcy podsumowują. [[character/2]] dziękuje pilotowi i jego towarzyszce, którą jest [[character/5]], i przyznaje, że rany planety będą się goić długo, ale wierzy, że i temu podołają. Leah zaprasza pilota, by uczcić zwycięstwo przy daniu [[goods/21]], a pilot przyjmuje zaproszenie. [[character/1]], któremu pilot obiecuje rozszerzenie pamięci po powrocie na stały ląd, zapewnia, że wcale go nie potrzebuje, i do końca dokucza parze.", false],
		[48, "", "Kampania jest ukończona. Pilot może dalej odkrywać ocean, handlować i przyjmować kontrakty w świecie, który zawarł pokój z rebeliantami.", false],
	],
	"chapter/5": [
		[5, "Streszczenie", "Pierwsza walka pilota toczy się w pobliżu stacji [[station/1]]. M.A.I. wyjaśnia, jak przełączać się między bronią a harpunem, jak pomaga autoogień i jak czytać radar: czerwone znaczniki to wrogowie, zielone to sojusznicy, a żółte to punkty nawigacyjne. Wkrótce na ekranie pojawia się samotny [[faction/pirates|pirat]]. Zob. [[guide/combat]].", false],
		[6, "Zakończenie", "Pirat zostaje zniszczony. M.A.I. zwraca uwagę, że wraki zostawiają skrzynie z ładunkiem, które można wyłowić harpunem, zanim opadną poza zasięg, po czym wyznacza kurs z powrotem na stację [[station/0]].", false],
	],
	"chapter/6": [
		[6, "Streszczenie", "Po pierwszej udanej walce pilot wraca na stację [[station/0]] z działającą bronią i być może z odzyskanym ładunkiem na sprzedaż. To krótki powrót przez sieć prądów.", false],
		[7, "Zakończenie", "Nową broń dostrzega [[character/9]] i proponuje coś, co sam nazywa prawdziwą robotą. [[species/0|Łodziki]] tłoczą się na trasach konwojów wokół stacji [[station/1]], a ochrona stacji chce się ich pozbyć. Pilot zauważa, że zwierzęta po prostu żywią się porostami na kadłubach stacji, a ładownia jest za mała, by zabrać je wszystkie. Jack zbywa oba zastrzeżenia: zwierzęta mają zniknąć, obojętnie jak.", false],
	],
	"chapter/7": [
		[7, "Streszczenie", "W pobliżu stacji [[station/1]] pilot musi usunąć [[species/0|łodziki]]. Liczy się zarówno zabicie, jak i złowienie. Zadanie nie podoba się ani pilotowi, ani komputerowi, którym jest [[character/1]], bo zwierzęta są rzadkie i nieszkodliwe, ale obaj zgadzają się je wykonać.", false],
		[8, "Zakończenie", "Zadanie wstrząsa pilotem. Przybył na planetę łowić ryby, a nie zabijać zwierzęta dla wygody kolonii. M.A.I. ma nadzieję, że zapłata choć trochę to wynagrodzi, i proponuje zadokować na stacji [[station/1]], by ją odebrać.", false],
	],
	"chapter/8": [
		[8, "Streszczenie", "Pilot dokuje na stacji [[station/1]], by zdać raport z polowania na łodziki.", false],
		[9, "Zakończenie", "Urzędnik kolonii przyjmuje pilota ze źle skrywaną pogardą, traktuje zadanie jak tępienie szkodników i przyznaje, że pewnie nie miało ono sensu, bo zwierzęta i tak wracają. Oferowana zapłata jest niska i nie podlega negocjacjom. Zanim urzędnik zleci kolejne prace, chce dowodu umiejętności: trzech wykonanych zleceń z tablic na stacjach. [[character/1]] wyjaśnia, jak znajdować kontrakty, ostrzega, że niektóre miejsca zleceń leżą poza zasięgiem głębokości statku, i pokazuje, jak planować trasy na mapie stacji.", false],
	],
	"chapter/9": [
		[9, "Streszczenie", "Rozdział o pracy na zlecenie. Pilot musi wykonać trzy kontrakty z tablicy dowolnej stacji. Kontrakty obejmują m.in. eskorty, odzysk ładunku i zamówienia na połów, a warto sprawdzić kilka stacji. Zob. [[guide/contracts]].", false],
		[10, "Zakończenie", "Zadowolony urzędnik proponuje zadanie specjalne. Tajemnicze istoty, które koloniści nazywają Akwarianami, pół ludzie, pół ryby, atakują kapsuły transportowe wynoszące towary kolonii na orbitę, skąd są odbierane. Uszkodzone lub zaginione kapsuły psują opinię stacji w oczach władz handlowych. Następny start odbędzie się na stacji [[station/2]], a operacją pokieruje [[character/9]]. Pilot ma odpędzić Akwarian i zameldować się u niego.", false],
	],
	"character/0": [
		[1, "", "Pilot to postać gracza: nowy przybysz na skolonizowanym oceanicznym świecie, który pływa małą łodzią podwodną i zarabia na życie jako rybak. Imię pilota wybiera gracz, a krótkie streszczenia rozdziałów w dzienniku są pisane jako jego własne notatki. Pilot nigdy nie jest na morzu sam, bo komputer pokładowy, którym jest [[character/1]], komentuje niemal każdy jego ruch. Historia zaczyna się na stacji [[station/0]], gdzie pilot sprzedaje połów kolonii.", false],
		[1, "Przeszłość", "O życiu pilota przed kampanią wiadomo niewiele. Pilot przybył na planetę łowić ryby i żałuje przeprowadzki już od pierwszej misji, narzekając, że musi słuchać poleceń komputera pokładowego. Całą resztę trzeba poskładać z tego, co mówi i robi.", false],
		[7, "", "Pilot dobrze zna morze i jego stworzenia. Gdy kolonia skarży się na [[species/0|łodziki]] tłoczące się na trasach konwojów, pilot zauważa, że zwierzęta żywią się glonami i innymi porostami pokrywającymi kadłuby stacji, więc ich obecność trudno uznać za zaskakującą.", false],
		[12, "", "Początkowo cele pilota są skromne. Chce zarobić na bilet z planety, a stałe ceny płacone za połów sprawiają, że ten cel pozostaje poza zasięgiem. Gdy później prosi o przyjęcie do ruchu oporu, jako swój dom podaje stację [[station/0]].", false],
		[1, "Rybak na usługach kolonii", "Historia zaczyna się od tego, że pilot napełnia ładownię i obiera kurs na stację [[station/0]] ([[chapter/1]], [[chapter/2]]).", false],
		[3, "", "Tam [[character/9]] płaci za połów stałą stawkę, kpi z małej ładowni i podsuwa pilotowi, by spróbował raczej polowania na [[faction/pirates|piratów]].", false],
		[6, "", "Pilot montuje działo [[equipment/0]] i zestrzeliwuje pierwszego pirata w pobliżu stacji [[station/1]] ([[chapter/3]]–[[chapter/5]]).", false],
		[7, "", "Następnie [[character/9]] zleca mniej przyjemną pracę: usunięcie [[species/0|łodzików]] z tras wokół stacji [[station/1]] ([[chapter/7]]).", false],
		[8, "", "Odstrzał przyprawia pilota o mdłości. Przybył tu łowić ryby, a nie wybijać nieszkodliwe zwierzęta.", false],
		[10, "", "Urzędnik kolonii na stacji [[station/1]] płaci niewiele, żąda trzech kontraktów jako dowodu rzetelności ([[chapter/9]]), a potem wysyła pilota na stację [[station/2]], by bronił kapsuł transportowych przed [[world/aquarians|Akwarianami]] ([[chapter/10]]).", false],
		[12, "", "Pilot wygrywa walkę, ale zaczyna się zastanawiać, dlaczego [[world/aquarians|Akwarianie]] w ogóle atakują. Gdy [[character/9]] obwinia pilota o uszkodzone kapsuły i wstrzymuje nagrodę, [[character/1]] zdradza, że podsłuchał ruch oporu na stacji [[station/3]], a pilot postanawia go odnaleźć ([[chapter/12]]).", false],
		[12, "Przystąpienie do ruchu oporu", "Na stacji [[station/3]] strażnicy rebeliantów grożą otwarciem ognia, a pilot musi wyjąkać swoje imię i chęć przyłączenia się, zanim dostanie zgodę na dokowanie.", false],
		[13, "", "[[character/4]] przyjmuje pilota na próbę, głównie dlatego, że ruch potrzebuje każdej pary rąk, i wysyła go po łącznika na stację [[station/4]] ([[chapter/13]]).", false],
		[14, "", "Łącznikiem okazuje się [[character/5]], a pilot jest wyraźnie oczarowany, przewożąc ją na stację [[station/5]] ([[chapter/14]]).", false],
		[16, "", "[[character/5]] pokazuje pilotowi, jak rebelianci żyją z morza ([[chapter/15]]), a potem prosi go o rozpoznanie nowych stacji dla ruchu ([[chapter/16]]). Pilot po raz pierwszy słyszy wtedy słowo rewolucja.", false],
		[18, "", "Po powrocie na stację [[station/3]] [[character/4]] informuje o dyplomatycznych sukcesach ruchu i wysyła pilota na poszukiwanie przywódcy, niemal bez żadnych wskazówek ([[chapter/18]]).", false],
		[19, "Na rozkazach przywódczyni", "Przywódczynią jest [[character/2]], która spotyka pilota na stacji [[station/6]]; pilot spodziewał się mężczyzny. Jej pierwszy rozkaz to ochrona ławicy [[species/10|barwnych kałamarnic]] przed myśliwymi kolonistów ([[chapter/19]]).", false],
		[21, "", "Gdy wreszcie wyjaśnia cele ruchu, pilot angażuje się w sprawę. Wysyła go razem ze swoim asem, którym jest [[character/3]], przeciw bandzie piratów ([[chapter/21]]).", false],
		[23, "", "[[character/3]] traktuje pilota jak zawalidrogę. Na stacji [[station/9]] pilot dowiaduje się, że [[character/9]] jest teraz wrogiem ruchu, i z zapałem oczyszcza pole minowe, które urzędnik założył na szlaku zaopatrzenia rebeliantów ([[chapter/23]]).", false],
		[25, "", "Po ponownym spotkaniu z [[character/5]] pilot dostaje zadanie eskortowania przywódczyni, którą jest [[character/2]], oraz asa, którym jest [[character/3]], na rozmowy na stacji [[station/10]] ([[chapter/25]]).", false],
		[26, "", "Czekają tam siły, którymi dowodzi [[character/9]]. [[character/3]] ucieka, twierdząc, że jego broń zawiodła, a pilot i [[character/5]] sami chronią przywódczynię, którą jest [[character/2]]. Potem [[character/2]] się ukrywa i każe pilotowi stać się znacznie lepszym wojownikiem ([[chapter/26]]).", false],
		[27, "Zdrada i ratunek", "Później [[character/3]] dzwoni z propozycją przekazania pilnych informacji. Pilot podejrzewa pułapkę, ale zgadza się na spotkanie w pobliżu stacji [[station/11]] ([[chapter/27]]).", false],
		[28, "", "To pułapka: [[character/3]] trzyma w niewoli przywódczynię, którą jest [[character/2]], i żąda kapitulacji. Zgodnie z planem, który obmyśla [[character/1]], pilot zajmuje zdrajcę rozmową, podczas gdy komputer skanuje jego statek, i mówi mu, że w tej walce chodzi o przekonania, a nie o pieniądze. Następnie pilot niszczy jego statek i wyławia opancerzoną ładownię, w której znajduje się żywa [[character/2]], zanim opadnie zbyt głęboko ([[chapter/28]]).", false],
		[31, "Plan w trzech krokach", "Po ochronie konwoju naukowców ([[chapter/29]]) pilot poznaje plan, który ma [[character/2]]: zbudowanie broni wspólnie z [[world/abel|profesorem Ablem]]. Razem z [[character/4|Pierre'em]] i [[character/5]] pilot przejmuje [[world/biotek|generator Biotek]] z konwoju kolonistów ([[chapter/31]]).", false],
		[33, "", "Następnie pilot musi zdobyć działo [[equipment/42]], które nie jest na sprzedaż, mając do dyspozycji jedynie fundusz na łapówki. Pilot zauważa, jak niewiele przemyślenia kryje się za tym zadaniem, ale z radością je przyjmuje ([[chapter/33]]).", false],
		[37, "", "Na stacji [[station/15]] handlarz z czarnego rynku, którym jest [[character/8]], zgadza się zdobyć takie działo, jeśli pilot zabije łowcę nagród, którym jest [[character/11]] ([[chapter/35]]). Pilot to robi i kupuje działo, które [[character/8]] zdobył od [[character/9|Jacka]] ([[chapter/37]]).", false],
		[39, "", "[[character/2]] wolałaby nie wiedzieć, skąd wzięło się działo, a pilot mówi jedynie, że nie zginęli niewinni ludzie. Gdy pilot żartuje, że plan mógłby posłużyć do zawładnięcia planetą, przywódczyni stanowczo odrzuca ten pomysł ([[chapter/39]]).", false],
		[42, "", "Następnie pilot wytwarza [[goods/36|inkubator PCR]] na stacji [[station/16]] i dostarcza go na stację [[station/14]], kończąc budowę broni ([[chapter/41]]).", false],
		[43, "Droga do zwycięstwa", "Podczas testowania gotowej broni na piratach w pobliżu stacji [[station/17]] pilot odbiera wezwanie pomocy ze stacji [[station/14]] i po powrocie zastaje niespodziewany atak, którym dowodzi [[character/9]] ([[chapter/43]]).", false],
		[44, "", "Z pomocą [[world/aquarians|Akwarian]] atak zostaje odparty, a [[character/9]] ucieka.", false],
		[46, "", "[[character/2]] powierza pilotowi dowództwo szturmu na stację [[station/18]] ([[chapter/45]]). Pilot martwi się przede wszystkim o [[character/5]], która prowadzi drugi atak, ale zdobywa stację z eskadrą, którą dowodzi [[character/12]], i ze wsparciem [[world/aquarians|Akwarian]].", false],
		[47, "", "Ostateczna bitwa rozgrywa się na stacji [[station/0]], tam gdzie zaczęła się cała historia ([[chapter/47]]). [[character/9]] próbuje wytrącić pilota z równowagi, twierdząc, że jest jego ojcem, a [[character/3]] był jego bratem, ale pilot od razu odrzuca to kłamstwo.", false],
		[48, "", "[[character/9]] zostaje przepędzony, a ostatni bastion kolonii upada. Pilot przypisuje zasługę przyjaciołom, którzy walczyli u jego boku, i przyjmuje zaproszenie na świętowanie, jakie składa mu [[character/5]].", false],
		[1, "Osobowość", "Pilot jest praktyczny i cięty w języku, bardziej skłonny do odpyskiwania niż do posłuszeństwa. Jego przekomarzania z [[character/1]] przewijają się przez całą kampanię.", false],
		[8, "", "Pod żartami kryje się sumienie. Pilot nie lubi zabijać zwierząt dla zysku i po odstrzale łodzików czuje się podle.", false],
		[14, "", "W obecności [[character/5]] pilot traci język w gębie i staje się niezgrabny, co zauważa zarówno ona, jak i [[character/1]].", false],
		[28, "", "Motywacje pilota zmieniają się w trakcie kampanii. W chwili konfrontacji, w której staje naprzeciw niego [[character/3]], pilot przekonuje, że w tej walce chodzi o ideały, a zdrajcę zaślepiła chciwość.", false],
		[1, "Relacje", "[[character/1]] to najbliższy towarzysz pilota. Obaj nieustannie się sprzeczają, ale pilot polega na jego radach, a później także na jego sprycie.", false],
		[3, "", "[[character/9]] jest pierwszym pracodawcą pilota, a z czasem staje się jego stałym rywalem.", false],
		[14, "", "Pilota ciągnie do [[character/5]] od pierwszego spotkania, a uczucie wydaje się odwzajemnione.", false],
		[19, "", "[[character/2]] z czasem powierza pilotowi najbardziej delikatne zadania ruchu. Traktuje go ciepło, z przekornym, niemal rodzicielskim autorytetem.", false],
		[1, "Jako postać gracza", "W grze pilot jest taki, jakim uczyni go gracz. Między celami rozdziałów pilot może swobodnie łowić, handlować, przyjmować kontrakty, walczyć i przebudowywać statek; fabuła posuwa się naprzód dopiero po osiągnięciu celu rozdziału. Podstawy omawia strona [[guide/basics]].", false],
	],
	"character/1": [
		[1, "", "[[character/1]] to komputer pokładowy łodzi podwodnej pilota i jego towarzysz przez całą kampanię. Steruje systemami statku, wyjaśnia, jak łowić, podróżować i walczyć, i nieustannie zasypuje pilota radami i komentarzami. Ma suche poczucie humoru, często kosztem pilota, ale okazuje się kimś znacznie więcej niż gadającą instrukcją obsługi.", false],
		[1, "Jako towarzysz", "W praktyce [[character/1]] jest przewodnikiem po grze. To on przedstawia każdą nową mechanikę: połów harpunem, autopilota, a na stacjach ekrany pomocy. Podczas misji odzywa się przez radio, wskazuje cele i ostrzega przed zagrożeniami.", false],
		[5, "", "Wyjaśnia też dalekie podróże przez [[world/stream|sieć S.T.R.E.A.M.]] i czytanie radaru, na którym wrogowie i sojusznicy są widoczni jako kolorowe punkty, a punkty nawigacyjne wyznaczają trasę. Po walce przypomina pilotowi, by wyłowił ładunek, który zostawiają pokonane statki.", false],
		[12, "", "Jego rola wykracza poza instruktaż. Przeszukuje kanały radiowe, zaznacza stacje na mapie i przekazuje wiadomości.", false],
		[28, "", "Potrafi też z bliska skanować inne statki, a ta umiejętność okazuje się rozstrzygająca w konfrontacji, w której pilot staje naprzeciw [[character/3|Raymonda]].", false],
		[1, "Rola w fabule", "Kampania zaczyna się od tego, że [[character/1]] przypomina pilotowi, że jego zadaniem jest łowić ryby, a nie narzekać.", false],
		[3, "", "Nie kryje swojej niskiej opinii o [[character/9|Jacku]] i namawia pilota do kupna działa [[equipment/0]], które jest w ofercie.", false],
		[4, "", "Gdy broń jest już zamontowana, nalega na sprawdzenie jej na piratach i prowadzi ich poszukiwania.", false],
		[7, "", "Odstrzał [[species/0|łodzików]] mu się nie podoba i pyta, dlaczego zwierzęta w ogóle mają ginąć, skoro jest ich tak niewiele.", false],
		[8, "", "Po polowaniu zauważa, jak bardzo pilot jest wstrząśnięty, a jego pierwsza myśl, jak zwykle, dotyczy tego, czy praca przynajmniej się opłaci.", false],
		[11, "", "Gdy [[world/aquarians|Akwarianie]] atakują kapsuły na stacji [[station/2]], jako pierwszy sugeruje, że te istoty mogą być znacznie bystrzejsze, niż sądzą koloniści.", false],
		[12, "Punkt zwrotny", "To [[character/1]] uruchamia główny wątek fabuły. Gdy [[character/9]] po raz kolejny oszukuje pilota, komputer przekonuje, że pilot ciężko pracuje za marną zapłatę i nie ma nic do powiedzenia w sprawie połowu. Zdradza, że podsłuchał sygnały ruchu oporu tworzącego się na stacji [[station/3]], zaznacza stację na mapie i pozostawia decyzję pilotowi ([[chapter/12]]).", false],
		[12, "", "Po przybyciu proponuje ciche podejście, ale porzuca ten pomysł, gdy strażnicy rebeliantów od razu zatrzymują statek.", false],
		[14, "Wśród rebeliantów", "Od razu nie znosi ciepła, jakie łączy pilota i [[character/5]]. Gdy pilot żartuje z jego zazdrości, odpowiada sarkastycznym echem ulubionego powiedzonka, jakiego używa [[character/5]]. Jego uszczypliwe uwagi o tej parze ciągną się aż do końca kampanii.", false],
		[17, "", "Przekazuje wiadomości ruchu, a jeden z długich listów, które pisze [[character/4]], streszcza w jednym zdaniu.", false],
		[18, "", "Wątpi w dobrą organizację rebeliantów, gdy pilot zostaje wysłany na poszukiwanie ich przywódcy niemal bez wskazówek.", false],
		[19, "", "Przy [[character/2]] pokazuje swoją przyziemną, wyrachowaną stronę, pytając, dlaczego pilot pracuje, nie ustaliwszy zapłaty. Gdy pilot broni przywódczyni, którą jest [[character/2]], komputer zauważa kąśliwie, że on przynajmniej nigdy nie musi jeść.", false],
		[22, "", "Podziwia umiejętności, jakie ma [[character/3]], ale radzi pilotowi trzymać się z dala od jego temperamentu.", false],
		[27, "Zakładniczka", "Gdy [[character/3]] dzwoni z propozycją spotkania, [[character/1]] stwierdza, że to pułapka.", false],
		[28, "", "Podczas spotkania pokazuje, ile naprawdę jest wart. Prosi pilota, by zajął [[character/3|Raymonda]] rozmową, wiedząc, że człowiek, który czuje się bezpiecznie, zacznie się chwalić swoimi motywami. W tym czasie skanuje jego statek, ustala, że jest jednoosobowy, i wnioskuje, że [[character/2]] musi być w jego opancerzonej ładowni. Dzięki temu pilot może zniszczyć statek i mimo to uratować przywódczynię, którą jest [[character/2]] ([[chapter/27]]).", false],
		[33, "Wojna", "Przez całe misje związane z [[world/biotek|generatorem Biotek]] i działem [[world/eclipse|Eclipse]] nie przestaje narzekać na marną płacę.", false],
		[37, "", "Rozkoszuje się ironią losu, gdy okazuje się, że działo pochodzi od [[character/9|Jacka]], którego chciwość uzbroiła jego własnych wrogów.", false],
		[39, "", "Narzeka, że pilot zdaje się prowadzić rebelię w pojedynkę.", false],
		[41, "", "Później obraca odpowiedź, jaką pilot dał na tę skargę, przeciwko samemu pilotowi.", false],
		[42, "", "Gdy [[character/5]] serdecznie wita pilota na stacji [[station/14]], komputer oznajmia, że się wyłącza, choć okazuje się, że przeszedł tylko w tryb czuwania.", false],
		[43, "", "Podczas próby działa w terenie odbiera otwarte, nieszyfrowane wezwanie pomocy ze stacji [[station/14]] i od razu rozpoznaje, że stało się coś bardzo złego.", false],
		[44, "", "W bitwie, która następuje, jako pierwszy melduje, że przybyli [[world/aquarians|Akwarianie]], by walczyć po stronie rebeliantów.", false],
		[48, "", "Pod koniec wojny pilot obiecuje mu rozbudowę pamięci, co komputer uznaje za lekko obraźliwe. Jego ostatnie słowo w kampanii to kolejny suchy komentarz na temat pilota i [[character/5]].", false],
		[1, "Osobowość", "[[character/1]] jest bystry, bezpośredni i nie ma cierpliwości do nadętych ludzi. Lubi wytykać złe interesy i rzadko przepuszcza okazję do docinków.", false],
		[8, "", "Troszczy się też bardziej, niż przyznaje. Nie lubi niepotrzebnego zabijania i pilnuje samopoczucia pilota.", false],
		[28, "", "Jego spokojne myślenie pod presją ratuje sytuację, gdy pilot nie wie, co robić.", false],
		[1, "Relacje", "On i pilot nieustannie się kłócą, ale ufają sobie bez zastrzeżeń.", false],
		[3, "", "Od pierwszego wejrzenia nie znosi [[character/9|Jacka]].", false],
		[14, "", "Jego zazdrość o [[character/5]] to powracający żart.", false],
		[19, "", "Szanuje [[character/2]], ale narzeka, jak mało płaci.", false],
		[22, "", "Szybko wyrabia sobie zdanie o [[character/3|Raymondzie]] i okazuje się, że ma rację.", false],
	],
	"character/10": [
		[5, "", "[[character/10]] to nazwa używana dla wyjętych spod prawa pilotów frakcji [[faction/pirates]], którzy odzywają się podczas misji. Polują na statki w całym oceanie i są pierwszymi celami pilota, gdy tylko jego statek zostaje uzbrojony.", false],
		[6, "Kto mówi", "Pirat to pierwszy wróg, z którym mierzy się pilot, w pobliżu stacji [[station/1]]; ginie z okrzykiem wściekłości ([[chapter/5]]).", false],
		[21, "", "W miarę narastania konfliktu między kolonistami a rebeliantami piraci wykorzystują chaos, by polować na łatwe ofiary, a [[character/2]] postanawia, że rebelianci muszą odpowiedzieć uderzeniem ([[chapter/21]]).", false],
		[43, "", "W pobliżu stacji [[station/17]] banda piratów staje się pierwszym celem działa [[world/eclipse|Eclipse]]. Jeden z nich wpada w panikę na widok siły ognia pilota i wzywa pomocy, ściągając do walki kolejnych piratów ([[chapter/42]]). Walkę z nimi omawia strona [[guide/combat]].", false],
	],
	"character/11": [
		[35, "", "[[character/11]] to łowca nagród wynajęty przez administrację bezpieczeństwa stacji [[station/15]], by pozbyć się handlarza z czarnego rynku, którym jest [[character/8]]. [[character/8]] żąda jego śmierci jako ceny za działo [[world/eclipse|Eclipse]].", false],
		[35, "Przeszłość", "Według tego, co mówi [[character/8]], [[character/11]] patroluje wody w pobliżu stacji [[station/15]]. Jest kimś w rodzaju stróża prawa, pracującym dla władz stacji, a jego celem jest przestępca. To sprawia, że zadanie pilota budzi moralny niepokój: aby zdobyć broń potrzebną rebeliantom, pilot musi zabić człowieka na zlecenie handlarza nielegalnymi towarami.", false],
		[36, "Rola w fabule", "Gdy pilot go odnajduje, [[character/11]] nie jest sam; płynie z kilkoma eskortującymi statkami. Każe pilotowi zejść mu z drogi, nazywając go rybakiem i podkreślając, że ma robotę do wykonania. Gdy walka obraca się przeciw niemu, pyta, czy jednak nie dałoby się załatwić sprawy pokojowo. Jego statek zostaje zniszczony ([[chapter/35]]).", false],
		[37, "", "Jego śmierć zapewnia pilotowi pomoc, jakiej udziela [[character/8]], a handlarz wkrótce wystawia działo na sprzedaż.", false],
		[39, "", "Później pilot mówi przywódczyni, którą jest [[character/2]], jedynie tyle, że przy zdobywaniu działa nie zginęli niewinni ludzie.", false],
		[36, "Osobowość", "[[character/11]] jest pewny siebie i lekceważący, dopóki nie zaczyna przegrywać, a wtedy szybko szuka wyjścia. Widzi w pilocie drobną przeszkodę, zwykłego rybaka, który przypadkiem wszedł mu w drogę, i poważnie go nie docenia.", false],
	],
	"character/12": [
		[45, "", "[[character/12]] to dowódca eskadry Atmos, oddziału [[faction/rebels|rebeliantów]], który dołącza do szturmu pilota na stację [[station/18]] podczas ostatnich ofensyw.", false],
		[45, "Rola w fabule", "[[character/2]] obiecuje zebrać dla pilota oddziały, podczas gdy pilot płynie na stację [[station/18]]. Jednym z nich jest eskadra, którą dowodzi [[character/12]]. Gdy pilot przybywa, dowódca melduje, że jego statki są na pozycjach i czekają na rozkaz ataku. W tym samym czasie z głębin przybywa grupa [[world/aquarians|Akwarian]], a bitwa zaczyna się na komendę pilota ([[chapter/45]]).", false],
		[46, "", "Razem niszczą wszystkie statki kolonistów, nie oszczędzając nawet frachtowców.", false],
		[46, "", "Po bitwie pilot rozkazuje, by [[character/12]] wysłał połowę swoich statków na patrol wokół stacji, a reszta zadokowała razem z pilotem, by przejąć kontrolę. Dowódca potwierdza bez sprzeciwu.", false],
		[47, "", "To pierwsza bitwa, w której statki rebeliantów i [[world/aquarians|Akwarianie]] walczą ramię w ramię pod dowództwem pilota, a jej sukces otwiera drogę do ostatecznego szturmu na kolonię.", false],
		[45, "Osobowość", "[[character/12]] mówi krótko i szybko wykonuje rozkazy. Jest pierwszym oficerem rebeliantów służącym pod dowództwem pilota, co pokazuje, jak wysoko pilot zaszedł od czasów łowienia ryb dla kolonii. Jego zwięzły, rzeczowy styl w eterze kontrastuje z przekomarzaniem się innych towarzyszy pilota.", false],
	],
	"character/2": [
		[18, "", "[[character/2]] to członkini [[faction/rebels|ruchu oporu]], którą pilot poznaje na stacji [[station/6]].", false],
		[19, "", "Jest przywódczynią ruchu, starszą kobietą, która od pierwszego spotkania kieruje misjami pilota. Spokojna, serdeczna i zdeterminowana, prowadzi walkę ruchu z kolonialnymi rządami.", false],
		[21, "Przeszłość", "Ruch, którym kieruje [[character/2]], uważa się za związek ludzi sprzeciwiających się niszczeniu planety. Jej zdaniem tempo kolonizacji i bezwzględna eksploatacja morza nie dają roślinom i zwierzętom czasu na odrodzenie, a inne światy zostały już w ten sam sposób wyjałowione. Jej strategią jest raczej przeciąganie na swoją stronę ludzi kierujących stacjami niż walka.", false],
		[23, "", "Zna [[character/9|Jacka]] z przeszłości. Gdy go poznała, był nikim, i uważa, że swój awans zawdzięcza odpowiednim znajomościom, a nie jakiemukolwiek talentowi.", false],
		[31, "", "Ma sieć informatorów na stacjach i władzę pozwalającą przemieszczać naukowców, pieniądze i statki po całej strefie rebeliantów.", false],
		[19, "Rola w fabule", "Pierwszy rozkaz, jaki wydaje [[character/2]], to misja eskortowa: pilot musi chronić ławicę [[species/10|barwnych kałamarnic]] przed myśliwymi kolonistów ([[chapter/19]]). Nie wspomina o zapłacie i niewiele mówi o planach ruchu, najwyraźniej sprawdzając, czy nowicjuszowi można zaufać. Pilot przyznaje, że spodziewał się mężczyzny, a ona puszcza to mimo uszu.", false],
		[20, "", "Nagradza zadanie skromnie i od razu wzywa pilota do kolejnej pracy.", false],
		[21, "", "Gdy pilot domaga się odpowiedzi, wyjaśnia cele ruchu. Postanawia też, że piraci, którzy wykorzystują konflikt, muszą dostać nauczkę, i wysyła pilota wraz ze swoim najlepszym wojownikiem, którym jest [[character/3]], przeciw bandzie w pobliżu stacji [[station/8]] ([[chapter/21]]).", false],
		[22, "", "Dzieli nagrodę po równo między obu pilotów, ku irytacji, jaką okazuje [[character/3]], i wyrusza na rozmowy na stacji [[station/9]].", false],
		[23, "", "Tam wysyła pilota, by oczyścił pole minowe, które [[character/9]] założył na szlaku zaopatrzenia do stacji [[station/37]], i ostrzega przed piratami oraz minami, które można zniszczyć dopiero po ich uruchomieniu ([[chapter/23]]).", false],
		[25, "Zasadzka", "Kolejnym celem, jaki stawia sobie [[character/2]], jest stacja [[station/10]], gdzie dalsze negocjacje mają przyciągnąć do rebeliantów kolejne stacje. Na eskortę zabiera [[character/3|Raymonda]], [[character/5]] i pilota, a wątpliwości pilota co do [[character/3|Raymonda]] zbywa, nazywając go upartym, ale świetnym pilotem ([[chapter/25]]).", false],
		[25, "", "Na miejscu zastają czekającego ze swoimi siłami urzędnika, którym jest [[character/9]]. [[character/2]] jest wstrząśnięta, że ich plany znano z góry.", false],
		[26, "", "[[character/3]] ucieka z walki i tylko pilot oraz [[character/5]] stoją między przywódczynią, którą jest [[character/2]], a kolonistami. Potem zastanawia się na głos nad sabotażem, ale nie chce uwierzyć w oskarżenie, jakie wysuwa [[character/5]]: że [[character/3]] jest zdrajcą. Ukrywa się, zostawia [[character/5]] jako dowodzącą na stacji [[station/9]] i ostrzega pilota, że sama dyplomacja może nie wygrać wojny ([[chapter/26]]).", false],
		[28, "Niewola", "Jej wiara w [[character/3|Raymonda]] okazuje się nietrafiona. Zdrajca porywa ją i oferuje jako zdobycz urzędnikowi, którym jest [[character/9]]. Podczas konfrontacji w pobliżu stacji [[station/11]] namawia pilota, by nie zważał na jej bezpieczeństwo. Pilot ratuje ją z ładowni rozbitego statku, którym pływał [[character/3]], a ona dociera na stację [[station/12]] wstrząśnięta, ale cała ([[chapter/28]]).", false],
		[29, "", "Nawet wtedy myśli najpierw o ruchu. Przed porwaniem zorganizowała przewiezienie grupy naukowców na stację [[station/14]] i od razu wysyła pilota, by chronił ich konwój, bo obawia się, że [[character/3]] zdradził również go ([[chapter/29]]).", false],
		[31, "Plan w trzech krokach", "Na stacji [[station/14]] [[character/2]] zdradza swój plan. Rebelianci stają w obliczu coraz częstszych starć z flotą kolonialną, która wciąż ma nad nimi przewagę liczebną, więc sprowadziła [[world/abel|profesora Abla]] i jego zespół, by zbudowali broń. Prace obejmują trzy kroki, a pierwszym jest źródło energii, [[world/biotek|generator Biotek]], który koloniści ukradli profesorowi. Przywódczyni wyrusza na spotkanie z nim, a [[character/5]] organizuje rajd ([[chapter/31]]).", false],
		[33, "", "Na drugi krok potrzebuje działa [[world/eclipse|Eclipse]], używanego zwykle do obrony stacji. Najbliższy producent, stacja [[station/188]], jest w rękach kolonistów, a broń nie jest na sprzedaż, więc przekazuje pilotowi pokaźny fundusz na łapówki i przyznaje, że jej plan dalej nie sięga ([[chapter/33]]).", false],
		[39, "", "Gdy działo trafia na stację, woli nie wiedzieć, jak je zdobyto, i ma nadzieję, że nie przelano krwi. Dotyka ją żart pilota, że plan mógłby posłużyć do zawładnięcia planetą. Przy ostatnim kroku przekazuje wyjaśnienia profesora na temat inkubatora, szczerze przyznając, że ich nie rozumie, i wysyła pilota na stację [[station/16]] ([[chapter/39]]).", false],
		[43, "Ostatnie ofensywy", "Gdy koloniści przeprowadzają niespodziewany atak na stację [[station/14]], [[character/2]] początkowo wierzy, że wszystko stracone ([[chapter/43]]).", false],
		[44, "", "Przeżywa i przypisuje ocalenie stacji pilotowi oraz [[world/aquarians|Akwarianom]].", false],
		[45, "", "Wita [[world/aquarians|akwariańskiego]] wysłannika, który przynosi wieść, że jego lud pomoże w walce z kolonią. Gdy stacja [[station/188]] jest już w rękach rebeliantów, planuje uzbroić w działo [[equipment/42]] jak najwięcej statków i rozpoczyna jednocześnie dwie ofensywy: pilot ma zdobyć stację [[station/18]], a [[character/5]] atakuje stację [[station/109]] ([[chapter/45]]). Żartuje z pilota, że martwi się o [[character/5]].", false],
		[47, "", "W ostatnim szturmie na stację [[station/0]] sama rusza do boju ([[chapter/47]]).", false],
		[48, "", "Po zwycięstwie dziękuje pilotowi i [[character/5]] i przyznaje, że planeta będzie potrzebowała dużo czasu, by się zagoić.", false],
		[19, "Osobowość", "[[character/2]] jest serdeczna i spokojna, a do swoich młodszych agentów zwraca się jak do własnych dzieci. Wymaga bardzo wiele, a płaci mało.", false],
		[26, "", "Jest lojalna wobec swoich ludzi aż do przesady. Broni [[character/3|Raymonda]] długo po tym, jak inni nabrali podejrzeń.", false],
		[28, "", "[[character/3]] nazywa ją marzycielką, za starą na tę rolę, ale dalszy ciąg historii nie potwierdza tej oceny.", false],
		[33, "", "Jej plany bywają raczej śmiałe niż szczegółowe i opierają się na zdolności agentów do improwizacji. Woli dyplomację i ma nadzieję uniknąć rozlewu krwi, ale godzi się z tym, że ruch musi walczyć.", false],
		[19, "Relacje", "Z czasem ufa pilotowi bardziej niż niemal komukolwiek, a pilot odwzajemnia to zaufanie.", false],
		[21, "", "Ceni [[character/3|Raymonda]] jako swojego najlepszego pilota.", false],
		[23, "", "Dla [[character/9|Jacka]] ma wyłącznie pogardę.", false],
		[25, "", "Traktuje [[character/5]] jak zaufaną zastępczynię i powierza jej dowodzenie pod swoją nieobecność.", false],
		[31, "", "[[character/4]] pracuje pod jej kierunkiem jako ekspert techniczny, a [[world/abel|profesor Abel]] buduje dla niej broń.", false],
	],
	"character/3": [
		[21, "", "[[character/3]] to jeden z najlepszych pilotów, jakich ma [[character/2]], utalentowany i arogancki wojownik, którego przywódczyni łączy w parę z pilotem na potrzeby rajdu na bandę piratów w pobliżu stacji [[station/8]].", false],
		[21, "Osobowość", "[[character/3]] jest niecierpliwy i chełpliwy. Beszta pilota za spóźnienie, twierdzi, że sam poradziłby sobie z zadaniem, i każe mu trzymać się z tyłu i uczyć się. Na [[character/1]] wrażenie robi jego reputacja, choć nie maniery.", false],
		[22, "", "Nie szanuje nowicjuszy i drwi z pilota, nazywając go synem rybaka.", false],
		[28, "", "W głębi duszy jest najemnikiem. Lojalność mierzy pieniędzmi i nie ma cierpliwości do ideałów, którymi kieruje się ruch.", false],
		[21, "Rola w fabule", "[[character/2]] przedstawia go jako jednego ze swoich najlepszych pilotów i wysyła pilota, by wyruszył z nim przeciw piratom ([[chapter/21]]). [[character/3]] już czeka na miejscu, zirytowany opóźnieniem.", false],
		[22, "", "[[character/3]] to zdolny pilot, a po bitwie prawi pilotowi niechętny komplement opakowany w obelgę. Gdy [[character/2]] dzieli nagrodę po równo, wpada we wściekłość, upiera się, że pilot niewiele wniósł, i narzeka, że przywódczyni marnuje pieniądze na początkujących.", false],
		[25, "", "[[character/2]] wybiera go do swojej eskorty na stację [[station/10]]. Pilot nie jest zadowolony, ale przywódczyni ręczy za niego jako za upartego, lecz zdolnego pilota ([[chapter/25]]).", false],
		[26, "Zasadzka", "Gdy siły, którymi dowodzi [[character/9]], urządzają zasadzkę na stacji [[station/10]], [[character/3]] nie oddaje ani jednego strzału. Twierdzi, że jego broń zawiodła, przeprasza i ucieka. [[character/5]] jest przekonana, że ich zdradził, a [[character/2]] zastanawia się nad sabotażem, ale wciąż go broni.", false],
		[27, "Zdrada", "Jakiś czas później dzwoni do pilota, z niepokojem pyta o [[character/2]] i [[character/5]] i twierdzi, że ma ważne wieści. Prosi o spotkanie w pobliżu stacji [[station/11]]. [[character/1]] jest pewien, że to pułapka ([[chapter/27]]).", false],
		[28, "", "I tak jest. [[character/3]] pojmał przywódczynię, którą jest [[character/2]], i grozi, że ją zabije, jeśli pilot się nie podda. Swobodnie wyjaśnia swoje powody: uważa, że [[character/2]] to marzycielka, za stara, by przewodzić, a [[character/9]] wyznaczył wysoką nagrodę za nią i za pilota. Przyznaje, że nie wie, dlaczego [[character/9]] boi się pilota, i nic go to nie obchodzi. [[character/2]] płaciła marnie, mówi, więc zmienił pracodawcę, a o ideałach pilota nie chce słyszeć.", false],
		[28, "", "Gdy on mówi, [[character/1]] skanuje jego jednoosobowy statek i ustala, gdzie musi być [[character/2]]. Wtedy pilot atakuje. [[character/3]] do końca jest szybki i pewny siebie, ale jego statek zostaje zniszczony. Pilot wyławia jego opancerzoną ładownię, w której żywa znajduje się [[character/2]], a [[character/3]] idzie na dno razem ze swoim statkiem w pobliżu stacji [[station/11]].", false],
		[28, "", "Z perspektywy czasu awaria jego broni na stacji [[station/10]] wygląda na zainscenizowaną. Nic w fabule nie wskazuje, by jego przeprosiny były szczere.", false],
		[29, "", "Jego zdrada rzuca długi cień. [[character/2]] obawia się, że przed śmiercią przekazał informacje o jej konwoju z naukowcami ([[chapter/29]]).", false],
		[47, "", "W ostatecznej bitwie [[character/9]] posługuje się groźbą, w której pilot rozpoznaje ostatnie słowa, jakie wypowiedział [[character/3]]. Gdy dowiaduje się, że to pilot go zabił, [[character/9]] twierdzi, że [[character/3]] był bratem pilota. Kłamstwo od razu zawodzi.", false],
		[21, "Relacje", "[[character/2]] ufa mu bezgranicznie i ceni jego umiejętności wyżej niż umiejętności innych swoich pilotów.", false],
		[22, "", "Od początku traktuje pilota z pogardą.", false],
		[26, "", "[[character/5]] mu nie ufa i jako pierwsza nazywa go zdrajcą.", false],
		[28, "", "W końcu sprzedaje się człowiekowi, z którym walczą jego towarzysze. Jest nim [[character/9]].", false],
	],
	"character/4": [
		[12, "", "[[character/4]] to członek [[faction/rebels|ruchu oporu]] stacjonujący na stacji [[station/3]].", false],
		[13, "", "Jest pierwszym rebeliantem, którego pilot spotyka twarzą w twarz. Sprawdza nowych rekrutów i przydziela im pierwsze zadania.", false],
		[13, "Sprawdzian pilota", "Gdy pilot przybywa na stację [[station/3]], [[character/4]] zaczyna od serii zawiłych pytań o to, co nowicjusz wie i skąd. Pilot przyznaje, że nie wie nic poza pogłoską o ruchu oporu, który opowiada się za wolnym handlem. [[character/4]] jest sceptyczny, ale zauważa, że ruch zaczął szyfrować łączność radiową dopiero dwa dni wcześniej, co czyni tę historię wiarygodną ([[chapter/12]]).", false],
		[13, "", "Mając mało czasu i ludzi, [[character/4]] przyjmuje pilota na próbę. Wyjaśnia, że rebelianci planują przeniknąć na stacje kolonistów i pozyskać ich przywódców, bo wyzysk planety musi się skończyć. Obcemu nie chce zdradzić nic więcej i daje pilotowi pierwsze zadanie: przewiezienie sympatyków ze stacji [[station/4]] na stację [[station/5]] ([[chapter/13]]).", false],
		[17, "Szerzenie rewolucji", "Później [[character/4]] wzywa pilota z powrotem na stację [[station/3]] wiadomością tak długą, że [[character/1]] odczytuje na głos tylko jej sedno ([[chapter/17]]).", false],
		[18, "", "Osobiście informuje, że dyplomacja przyciągnęła do rebeliantów wiele stacji, więc pilot może teraz handlować na większym obszarze. Prasa już mówi o rewolucji, a [[character/4]] zgadza się z tym określeniem. Jak dotąd nie przelano krwi, choć spodziewa się, że to się zmieni. Mówi pilotowi, że przywódca ruchu przebywa na jednej z nowo pozyskanych stacji i nawiąże kontakt, a także ostrzega, że do niektórych stacji można dotrzeć tylko z lepszym pancerzem lub osłonami; zob. [[guide/depth]] ([[chapter/18]]).", false],
		[31, "Rajd na konwój", "[[character/4]] jest na stacji [[station/14]], gdy pilot przybywa tam po eskortowaniu naukowców. Przygotował mowę z podziękowaniami, ale nie udaje mu się jej wygłosić, a później znów zostaje przerwany w pół zdania, gdy pilot spieszy do statków. Walczy razem z pilotem i [[character/5]] przeciw konwojowi kolonistów, który wiezie [[world/biotek|generator Biotek]] ([[chapter/31]]).", false],
		[32, "", "Gdy załogi konwoju błagają, że wiozą tylko żywność i leki, [[character/4]] odpowiada przez radio, że właśnie tego potrzebują rebelianci. [[character/5]] zauważa, że potrafi być niezłym żartownisiem.", false],
		[33, "", "Potem [[character/2]] powierza mu hangar, w którym jest mnóstwo pracy. Wskazuje go też jako osobę, którą należy pytać o techniczną stronę montażu działa [[world/eclipse|Eclipse]] na statku ([[chapter/33]]).", false],
		[13, "Osobowość", "[[character/4]] jest ostrożny, formalny i skryty. Najpierw wydaje rozkazy, potem wyjaśnia, a plany ruchu zdradza tylko tym, którzy na to zasłużyli.", false],
		[18, "", "Jest też rozwlekły, z czego [[character/1]] kpi za każdym razem, gdy ten zabiera głos.", false],
		[32, "", "Za sztywnym sposobem bycia kryje się suche poczucie humoru i realistyczne spojrzenie na nadchodzącą wojnę.", false],
		[13, "Relacje", "[[character/4]] jest pierwszym kontaktem pilota w ruchu. Jego zaufanie rośnie, w miarę jak pilot okazuje się rzetelny.", false],
		[19, "", "Pracuje pod kierunkiem przywódczyni, którą jest [[character/2]], i przekazuje jej rozkazy.", false],
		[32, "", "Walczy u boku [[character/5]], która żartuje z jego dowcipów.", false],
	],
	"character/5": [
		[13, "", "[[character/5]] to członkini [[faction/rebels|ruchu oporu]], po którą pilot zostaje wysłany na stację [[station/4]].", false],
		[14, "", "Pogodna, serdeczna i skora do uśmiechu, staje się jedną z najbliższych sojuszniczek pilota. Pilot jest nią oczarowany od pierwszej chwili, ku trwałej irytacji, jaką okazuje [[character/1]].", false],
		[14, "Pierwsze spotkanie", "[[character/5]] serdecznie wita pilota na stacji [[station/4]] i spieszy się do wypłynięcia. Gdy pilot pyta o ruch, wyjaśnia, że rekrutów trzyma się w niewiedzy dla ich własnego bezpieczeństwa i bezpieczeństwa ruchu. Przesyła cel podróży do komputera pokładowego i podkreśla, że podróż musi być szybka ([[chapter/13]]).", false],
		[15, "", "Na stacji [[station/5]] ukrywa się, by załatwić pewne sprawy. Przed odejściem wyjaśnia, czym rebelianci różnią się od kolonistów: żyją z tego, co daje morze, zamiast je ogałacać, przerabiają połów na towary i uważają, by nie przełowić łowisk. Prosi pilota, by spróbował takiego życia i wyprodukował pięć ton towarów, i proponuje stację [[station/90]], gdzie z kałamarnic i towaru [[goods/35]] można wytworzyć produkt [[goods/22]] ([[chapter/14]]).", false],
		[16, "", "Gdy towary są gotowe, dzwoni ponownie z nowym zadaniem. Ruch potrzebuje świeżych informacji z każdej stacji, by znaleźć słabe punkty kolonii, bo, jak to ujmuje, sama broń nie przyniesie zwycięstwa. Zapytana, czy rebelianci planują rewolucję, odmawia dalszych wyjaśnień ([[chapter/15]]).", false],
		[25, "Ponowne spotkanie i zasadzka", "Pilot ponownie spotyka [[character/5]] na stacji [[station/9]], gdzie oboje wymieniają niezręczne komplementy. [[character/2]] przerywa to spotkanie i przydziela im eskortowanie jej samej i [[character/3|Raymonda]] na stację [[station/10]] ([[chapter/24]]).", false],
		[25, "", "[[character/5]] jako pierwsza wyczuwa, że po przybyciu coś jest nie tak.", false],
		[26, "", "Podczas zasadzki widzi, że [[character/3]] nie walczy, i woła za nim, gdy ucieka. Potem otwarcie oskarża go o zdradę i prosi pilota o wsparcie. [[character/2]] zostawia ją jako dowodzącą na stacji [[station/9]] na czas swojej nieobecności ([[chapter/25]]).", false],
		[31, "Plan w trzech krokach", "Na stacji [[station/14]] [[character/5]] zna już historię uratowania przywódczyni, którą jest [[character/2]]. Zapoznaje pilota z pierwszym krokiem planu: informator donosi, że [[world/biotek|generator Biotek]] jest przewożony do Maarth, ukryty wśród zwykłych ładunków. Ponieważ nikt nie wie, który statek go wiezie, nakazuje uderzenie na cały konwój w pobliżu stacji [[station/2]] ([[chapter/30]]).", false],
		[32, "", "Dowodzi przechwyceniem i dopilnowuje, by odzyskano każdy kontener ([[chapter/31]]).", false],
		[33, "", "Następnie [[character/2]] powierza jej patrolowanie okolic stacji [[station/14]] na wypadek niespodziewanych ataków.", false],
		[42, "", "Gdy pilot wraca z produktem [[goods/36]], [[character/5]] nie posiada się z radości. Informuje, że [[world/abel|profesor Abel]] ma wszystko gotowe, przekazuje rozkaz, który wydała [[character/2]]: wypróbować działo na piratach. Przypomina też pilotowi, że generator jest tylko prototypem ([[chapter/41]]).", false],
		[45, "Ofensywy", "W ostatnich ofensywach [[character/5]] dowodzi szturmem na stację [[station/109]], podczas gdy pilot atakuje stację [[station/18]]. [[character/2]] zapewnia pilota, że jego towarzyszka jest wprawnym pilotem i wie, co robi ([[chapter/44]]).", false],
		[47, "", "Jej atak kończy się sukcesem. Dzwoni do pilota z tą wiadomością i z rozkazami, jakie wydała [[character/2]], na ostatnią bitwę o stację [[station/0]], po czym sama rusza w drogę, przebijając się po drodze przez piratów ([[chapter/46]]).", false],
		[48, "", "Na stacji [[station/0]] walczy u boku pilota i przywódczyni, którą jest [[character/2]]. Po zwycięstwie zaprasza pilota na świętowanie przy [[goods/21]], a pilot przyjmuje zaproszenie ([[chapter/47]]).", false],
		[14, "Osobowość", "[[character/5]] jest przyjazna i pogodna, a przy każdej okazji używa jednego krótkiego, aprobującego powiedzonka. Jest też dyskretna i zaangażowana, z jasnym obrazem tego, o co walczy ruch.", false],
		[15, "", "Wierzy w życie z morza bez szkody dla niego i potrafi prosto wytłumaczyć tę ideę.", false],
		[26, "", "Szybko ocenia ludzi, a w przypadku, jakim jest [[character/3]], jej ocena okazuje się trafna.", false],
		[14, "Relacje", "Pilota ciągnie do niej od samego początku, a w trakcie kampanii uczucie staje się wyraźnie odwzajemnione. [[character/1]] nie przestaje na to narzekać.", false],
		[25, "", "[[character/2]] powierza jej dowodzenie i traktuje ją oraz pilota z czułym rozbawieniem.", false],
		[26, "", "Nigdy nie ufa [[character/3|Raymondowi]].", false],
		[32, "", "Ściśle współpracuje z [[character/4|Pierre'em]] i bawi ją jego humor.", false],
	],
	"character/6": [
		[8, "", "[[character/6]] to nazwa używana dla wielu pomniejszych rozmówców po stronie frakcji [[faction/colonists]]: urzędników, administratorów i załóg transportowych kolonialnej [[world/colony|administracji]]. Żaden z nich nie ma imienia; razem pokazują, jak kolonia traktuje obcych, którzy dla niej pracują.", false],
		[9, "Kto mówi", "Pierwszym jest urzędnik na stacji [[station/1]], który przyjmuje pilota po odstrzale [[species/0|łodzików]] ([[chapter/8]]). Urzędnik woli eleganckie słowa na brudną robotę, płaci niewielką stałą kwotę i odmawia targowania się. Pilot musi wykonać trzy kontrakty, zanim dostanie jakąkolwiek lepszą pracę.", false],
		[10, "", "Ten sam głos zleca następnie obronę kapsuł na stacji [[station/2]]. Kolonia wystrzeliwuje swój eksport na orbitę w kapsułach, a [[world/aquarians|Akwarianie]] wciąż je atakują, co niepokoi władze handlowe ([[chapter/9]]).", false],
		[32, "", "Znacznie później załogi konwoju kolonistów w pobliżu stacji [[station/2]] błagają rebeliantów o wstrzymanie ognia, mówiąc, że wiozą tylko żywność i leki ([[chapter/31]]).", false],
	],
	"character/7": [
		[12, "", "[[character/7]] to nazwa używana dla bezimiennych członków frakcji [[faction/rebels]], którzy rozmawiają z pilotem: kontrolerów ruchu na stacjach, strażników i załóg konwojów. Ich głosy wyznaczają pierwszy kontakt pilota z ruchem i jego codziennością.", false],
		[12, "Kto mówi", "Pierwszym rebeliantem, którego słyszy pilot, jest strażnik na stacji [[station/3]], który ostrzega, że statek wpłynął na wody neutralne, i grozi otwarciem ognia, jeśli ten się nie zidentyfikuje. Po długiej ciszy pilot dostaje zgodę na dokowanie ([[chapter/12]]).", false],
		[17, "", "Gdy pilot wraca jako przyjęty członek ruchu, stacja wita go po imieniu i przydziela mu stanowisko dokowania ([[chapter/17]]).", false],
		[29, "", "Później załoga konwoju naukowców w pobliżu stacji [[station/13]] rozpaczliwie wzywa pomocy ([[chapter/29]]).", false],
		[30, "", "Potem dziękują pilotowi, mówiąc, że sami by nie przeżyli.", false],
	],
	"character/8": [
		[34, "", "[[character/8]] to handlarz, którego pilot spotyka na stacji [[station/15]], szukając sposobu na zdobycie działa [[world/eclipse|Eclipse]].", false],
		[35, "", "Jest handlarzem z czarnego rynku, który zawsze mówi o sobie w trzeciej osobie i twierdzi, że klientowi z pieniędzmi załatwi niemal wszystko.", false],
		[35, "Przeszłość", "[[character/8]] prowadzi interesy na stacji [[station/15]], gdzie handel narkotykami jest zakazany. Jego działalność uczyniła z niego cel: administracja bezpieczeństwa stacji wynajęła łowcę nagród, którym jest [[character/11]], by się go pozbyć. Ma kontakty w wielu miejscach i jest gotów dawać łapówki, by zdobyć to, czego chce klient.", false],
		[35, "Interes z działem", "Gdy pilot przegląda miejscowy rynek, najwyraźniej kupując towar [[goods/37]], [[character/8]] bierze go na stronę i ostrzega, że taki handel jest tu nielegalny. Gdy oferuje swoje usługi, a pilot prosi o działo [[equipment/42]], jest zdumiony i pyta, czy pilot zamierza rozpętać wojnę. Pilot twierdzi, że to na własny użytek. [[character/8]] zgadza się poszukać działa pod jednym warunkiem: pilot musi odnaleźć i zabić łowcę nagród, którym jest [[character/11]], patrolującego okolice stacji ([[chapter/34]]).", false],
		[37, "", "Po śmierci łowcy, którym był [[character/11]], [[character/8]] gratuluje pilotowi i dotrzymuje słowa. Dzięki swoim kontaktom i mnóstwu łapówek znalazł działo [[equipment/42]], które oferuje po wygórowanej cenie, wciąż nazywając ją okazją. Zdradza, że sprzedawcą był człowiek o nazwisku Dawn, a nazwiska nic go nie obchodzą, dopóki towar jest dobry ([[chapter/36]]).", false],
		[37, "", "Sprzedawcą jest [[character/9]]. [[character/1]] zwraca uwagę na ironię: chciwość, którą wykazuje [[character/9]], oddała najważniejszą broń rebeliantów w ręce jego wrogów. Pilot kupuje działo i wraca z nim na stację [[station/14]] ([[chapter/37]]).", false],
		[35, "Osobowość", "[[character/8]] jest przebiegły, ostrożny i pozbawiony skrupułów. Handluje nielegalnymi towarami i żąda czyjejś śmierci tak swobodnie jak zapłaty. Obawia się podsłuchu, więc bierze pilota na stronę i ucisza go, zanim zacznie się rozmowa o interesach. Nawet przy płacącym kliencie waży ryzyko: początkowo nie jest pewien, czy w ogóle powinien sprzedawać taką broń obcemu.", false],
		[37, "", "Na swój sposób jest jednak rzetelny: dotrzymuje umowy, gdy cena zostanie zapłacona, i zdobywa dla pilota dokładnie to, o co ten prosił. Zwyczaj mówienia o sobie po imieniu i duma ze znajomości z właściwymi ludźmi we właściwych miejscach czynią go jedną z barwniejszych postaci kampanii.", false],
		[35, "Relacje", "[[character/11]] jest jego łowcą, a za sprawą pilota także jego ofiarą.", false],
		[37, "", "Robi interesy zarówno z [[character/9|Jackiem]], jak i z pilotem, nie dbając o to, po której stronie którykolwiek z nich stoi.", false],
	],
	"character/9": [
		[2, "", "[[character/9]], noszący nazwisko Dawn, to urzędnik kolonii na stacji [[station/0]], gdzie pilot sprzedaje dzienny połów.", false],
		[3, "", "Arogancki i ambitny, traktuje ludzi pracujących dla kolonii z otwartą pogardą. Jest pierwszym pracodawcą pilota, a z czasem staje się jego stałym rywalem.", false],
		[12, "Przeszłość", "[[character/9]] uważa, że jest stworzony do rzeczy znacznie większych niż jego posada na stacjach.", false],
		[23, "", "[[character/2]] znała go, gdy był mało znaczącą postacią. Jej zdaniem wspiął się w górę dzięki dobrym znajomościom, a nie zasługom, a w czasie rebelii ma już prawdziwą władzę w siłach [[faction/colonists|kolonistów]].", false],
		[3, "Pierwsze spotkania", "[[character/9]] kupuje pierwszy połów pilota po stałej cenie i kpi z małej ładowni. Dodaje, że pilot lepiej by zrobił, polując na [[faction/pirates|piratów]], choć wątpi, by i z tym sobie poradził ([[chapter/2]]).", false],
		[7, "", "Gdy pilot wraca uzbrojony, przypisuje sobie zasługę i proponuje pracę: oczyszczenie tras wokół stacji [[station/1]] z [[species/0|łodzików]]. Zbywa zastrzeżenia pilota i nie obchodzi go, w jaki sposób stworzenia zostaną usunięte ([[chapter/6]]).", false],
		[10, "", "Kieruje startem kapsuł na stacji [[station/2]] i ostrzega pilota, że utrata więcej niż pięciu kapsuł będzie go kosztować posadę ([[chapter/10]]).", false],
		[12, "", "Potem obwinia pilota o uszkodzone kapsuły i wstrzymuje nagrodę. Jego pogarda to ostatnia kropla, która pcha pilota do ruchu oporu ([[chapter/11]]).", false],
		[23, "Przeciw rebelii", "[[character/9]] zwraca się przeciw rebeliantom, w miarę jak ich ruch rośnie. Każe założyć pole minowe na ich szlaku zaopatrzenia między stacjami [[station/9]] i [[station/37]] ([[chapter/22]]).", false],
		[25, "", "Czeka ze swoimi siłami, gdy [[character/2]] przybywa na rozmowy na stację [[station/10]], i od razu rozkazuje atak ([[chapter/25]]).", false],
		[28, "", "To on finansuje zdradę, której dopuszcza się [[character/3]]. Wyznaczył wysoką nagrodę za przywódczynię, którą jest [[character/2]], i za pilota, najwyraźniej widząc w pilocie zagrożenie ([[chapter/27]]).", false],
		[37, "", "Gubi go własna chciwość. Sprzedaje działo [[world/eclipse|Eclipse]] handlarzowi z czarnego rynku, którym jest [[character/8]], a ten odsprzedaje je pilotowi ([[chapter/36]]).", false],
		[43, "Klęska", "[[character/9]] dowodzi niespodziewanym atakiem kolonistów na stację [[station/14]]. Drwi z pilota, że łowi ryby dla rebeliantów, i osłupiewa, gdy dowiaduje się, że pilot ma działo [[equipment/42]] ([[chapter/43]]).", false],
		[44, "", "Gdy do walki z jego statkami przyłączają się [[world/aquarians|Akwarianie]], porzuca atak i ucieka.", false],
		[47, "", "[[character/9]] broni się po raz ostatni na stacji [[station/0]], ostatnim bastionie kolonii. Słysząc, że pilot zabił [[character/3|Raymonda]], twierdzi, że [[character/3]] był bratem pilota, a on sam jest jego ojcem. Pilot od razu demaskuje kłamstwo, a [[character/9]] przyznaje, że niewiele brakowało, by podstęp się udał ([[chapter/47]]).", false],
		[48, "", "W bitwie, która następuje, [[character/9]] zostaje ostatnim kolonistą na placu boju. Ucieka w kapsule ratunkowej, najwyraźniej zabierając ze sobą całą stację, i opuszcza ocean, rzucając na pożegnanie drwinę pod adresem ryb i tych, którzy zostają.", false],
		[3, "Osobowość", "[[character/9]] jest grubiański, zarozumiały i lekceważący wobec każdego, kogo uważa za niższego od siebie.", false],
		[12, "", "Zrzuca winę na innych i przypisuje sobie zasługi, gdy coś się udaje.", false],
		[37, "", "Jego chciwość przeważa nad lojalnością wobec własnej strony.", false],
		[47, "", "To manipulator, który zamiast odwagi posługuje się kłamstwami i łapówkami, a gdy bitwa obraca się przeciw niemu, za każdym razem ucieka.", false],
		[3, "Relacje", "Jego pogarda dla pilota zaczyna się przy pierwszym spotkaniu i w trakcie kampanii przeradza się w otwartą wrogość.", false],
		[23, "", "[[character/2]] od dawna nim gardzi.", false],
		[28, "", "Nagrodą kupuje sobie lojalność, jaką okazuje mu [[character/3]].", false],
		[37, "", "Robi interesy z [[character/8]], nie wiedząc, gdzie trafi towar.", false],
	],
	"chart": [
		[1, "", "Mapa pokazuje wszystkie dwieście stacji jako punkty w ich położeniach na mapie oceanu. Niebieskie punkty należą do frakcji [[faction/colonists]], a pomarańczowe do frakcji [[faction/rebels]], według stanu w osiągniętym przez ciebie rozdziale. Każda stacja jest na początku niebieska; stacje zmieniają kolor na pomarańczowy wraz z postępami fabuły i nigdy nie wracają do niebieskiego.", false],
		[1, "", "Na stronie stacji lub rozdziału dana stacja jest narysowana większym punktem i podpisana, a stacje przechodzące do rebeliantów w tym rozdziale mają obwódkę. Pod mapą znajduje się lista wszystkich stacji z odnośnikami do ich stron. Odległości między stacjami mierzy się w jednostkach mapy; zob. [[guide/navigation]].", false],
	],
	"contract/0": [
		[1, "", "Wytrop pojedynczy poszukiwany statek czekający od 400 do 1200 m od stacji i zniszcz go. Cel jest znacznie wytrzymalszy niż zwykły pirat, a jego siła rośnie wraz z rangą pilota. Broń dalekiego zasięgu i torpeda pomagają go osłabić, zanim podpłynie bliżej. Nagroda jest wypłacana po powrocie na stację.", false],
	],
	"contract/1": [
		[1, "", "Banda licząca od trzech do sześciu statków czeka wzdłuż krętej trasy. Celem jest ostatni z nich, w końcowym punkcie nawigacyjnym. Nie wystarczy go zniszczyć: trzeba go unieruchomić, a potem przyciągnąć harpunem, zanim ucieknie. Najpierw rozpraw się z eskortą, by nic nie przerwało holowania.", false],
	],
	"contract/10": [
		[1, "", "Zniszcz wszystkie miny na polu liczącym od 15 do 25 min, od dwustu do sześciuset metrów od stacji, strzeżonym przez jeden statek. Miny można trafić tylko z bliska, więc podpływaj do każdej ostrożnie. Mocne osłony i pancerz pomagają przyjąć eksplozje.", false],
	],
	"contract/11": [
		[1, "", "Kapsuły zaopatrzeniowe są atakowane. Zniszcz napastników, zanim liczba ocalałych kapsuł spadnie poniżej minimum określonego w kontrakcie. Pilnuj licznika kapsuł i w pierwszej kolejności atakuj napastników, którzy się do nich zbliżają. Te zlecenia płacą około 30% więcej niż podstawowy kontrakt.", false],
		[10, "", "Napastnikami są Akwarianie, na wpół ludzcy mieszkańcy morza, którzy atakują kapsuły transportowe kolonistów.", false],
	],
	"contract/12": [
		[1, "", "Zniszcz określoną liczbę kapsuł zaopatrzeniowych strzeżonych przez uzbrojone statki, przy wsparciu sił sojuszniczych. W praktyce żadna stacja nie wystawia tego zlecenia na tablicy, więc nie można go przyjąć. Pojawia się w encyklopedii tylko dlatego, że zdefiniowano go razem z innymi rodzajami kontraktów.", false],
	],
	"contract/13": [
		[1, "", "Wyprodukuj określoną ilość produktu i dostarcz ją na stację, która wystawiła zlecenie. Wynagrodzenie zależy od wartości produktu i zamówionej ilości. Nagroda bywa bardzo hojna, a wymagana jest tylko połowa zwykłej kaucji. Przed przyjęciem sprawdź recepturę i zbierz składniki. Te zlecenia pojawiają się tylko na stacjach spoza pierwszych dwudziestu na mapie.", false],
		[12, "", "To zlecenie wystawiają tylko stacje rebeliantów.", false],
	],
	"contract/14": [
		[1, "", "Dostarcz dokładnie określoną ilość wskazanego stworzenia lub glonu na stację, która wystawiła zlecenie. Ilość wynosi od 3 do 24 jednostek, a kaucja to połowa zwykłej. Pospolite gatunki są zamawiane częściej niż rzadkie. Radar połowowy i duża ładownia sprawiają, że te zlecenia są łatwe. Pojawiają się tylko na stacjach spoza pierwszych dwudziestu.", false],
		[12, "", "To zlecenie wystawiają tylko stacje rebeliantów.", false],
	],
	"contract/2": [
		[1, "", "Statek porywacza przetrzymuje zakładnika. Podobnie jak w zleceniu odzyskania, cel płynie z bandą wzdłuż krętej trasy i trzeba go unieruchomić, a potem przyciągnąć harpunem. Zlecenie kończy się porażką, jeśli cel ucieknie. Zamontuj harpun o dobrym zasięgu i zniszcz eskortę, zanim zajmiesz się porywaczem.", false],
	],
	"contract/3": [
		[1, "", "Wytrop wszystkich piratów z bandy liczącej od trzech do sześciu statków, rozproszonych po punktach nawigacyjnych krętej trasy. Zlecenie jest wykonane, gdy nie zostanie żaden. To prosty kontrakt dla uzbrojonego statku, a liczebność bandy rośnie z trudnością zlecenia.", false],
	],
	"contract/4": [
		[1, "", "Pięć frachtowców płynie wyznaczonym kursem, a po drodze czyhają napastnicy. Zlecenie kończy się sukcesem, gdy wszyscy napastnicy zostaną zniszczeni. Kończy się porażką, jeśli przepadną wszystkie frachtowce. Eskorty płacą około 30% więcej niż zwykłe polowanie na piratów. Trzymaj się blisko konwoju i atakuj napastników, zanim do niego dotrą.", false],
	],
	"contract/5": [
		[1, "", "Zaatakuj konwój dwóch lub trzech frachtowców w punkcie nawigacyjnym i zniszcz je mimo uzbrojonej eskorty. Zniszczyć trzeba tylko frachtowce, więc skupienie na nich ognia może szybko zakończyć zlecenie. Torpeda lub działo dalekiego zasięgu pomagają je wyeliminować, zanim eskorta się zbliży.", false],
	],
	"contract/6": [
		[1, "", "Ławica licząca od 15 do 24 stworzeń płynie wyznaczonym kursem, a po drodze atakują ją myśliwi. Zniszcz myśliwych, zanim straty przekroczą uzgodniony limit. Nigdy nie strzelaj w pobliżu ławicy: zabłąkany strzał liczy się jako strata. Te zlecenia płacą około 30% więcej niż podstawowy kontrakt.", false],
		[12, "", "To zlecenie wystawiają tylko stacje rebeliantów, a po ukończeniu fabuły przestają to robić.", false],
	],
	"contract/7": [
		[1, "", "Zabij określoną liczbę osobników jednego gatunku spośród miejscowych zwierząt, podczas gdy wrogie statki próbują przeszkodzić. Zdobycze złowione harpunem się nie liczą; stworzenia muszą zostać zabite. Radar połowowy pomaga szybko znaleźć właściwy gatunek. Te zlecenia płacą około 20% więcej niż podstawowy kontrakt.", false],
	],
	"contract/8": [
		[1, "", "Przewieź pasażera na inną stację. Niektórzy pasażerowie wyznaczają maksymalną liczbę skoków S.T.R.E.A.M., a im mniej ich dozwolono, tym wyższe wynagrodzenie. Kontrakt wygasa po przekroczeniu tego limitu. Pomaga dobry silnik, bo większy zasięg oznacza mniej skoków.", false],
	],
	"contract/9": [
		[1, "", "Oczyść pole szczątków liczące od 15 do 30 elementów, od dwustu do sześciuset metrów od stacji, w ciągu około dwóch i pół minuty. Mogą tam być lekkie wrogie statki. Wynagrodzenie jest o około 30% niższe niż za inne kontrakty, ale zlecenie jest szybkie. Dopalacz i szybkostrzelne działa oszczędzają cenne sekundy.", false],
	],
	"equipment/0": [
		[1, "", "Podstawowe działo: 3 punkty obrażeń na strzał co 0,56 s, przy zasięgu 228 m. To bardzo słaby cios, ale za około 5700 cr to najtańsza broń i jedna z najczęściej spotykanych w sklepach. Można zamontować kilka sztuk, a wszystkie działa strzelają razem, więc dwa lub trzy takie działa tworzą użyteczną wczesną baterię, dopóki nie stać cię na coś cięższego.", false],
		[3, "", "W [[chapter/3|rozdziale 3]] pilot musi zamontować to działo przed opuszczeniem stacji [[station/0]].", false],
	],
	"equipment/1": [
		[1, "", "Średni model działa szynowego podwaja obrażenia względem modelu [[equipment/0]] do 6 na strzał i strzela nieco szybciej, co 0,48 s, na odległość 260 m. Za mniej więcej dwukrotną cenę ponad dwukrotnie zwiększa ciągłe obrażenia. To rozsądne drugie działo we wczesnych rozdziałach, zanim w sklepach pojawią się działa fuzyjne.", false],
	],
	"equipment/10": [
		[1, "", "Ta wyrzutnia masy zadaje 20 obrażeń co 0,40 s przy zasięgu 280 m, co daje najwyższe ciągłe obrażenia spośród dział w zwykłej sprzedaży. Sięga też dalej niż każde działo fuzyjne. Trzeba za nią zapłacić od 42 000 do 51 000 cr. Dla bojowego kadłuba z wolnymi gniazdami to jedno z najlepszych dział.", false],
	],
	"equipment/11": [
		[1, "", "Najcięższa wyrzutnia masy zadaje 25 obrażeń na strzał na 375 m, co jest największym zasięgiem spośród dział szybkostrzelnych. Przy odstępie 0,51 s jej ciągłe obrażenia są mniej więcej równe modelowi [[equipment/10]]. Dodaje przede wszystkim zasięg. To najrzadsze i najdroższe działo w sklepach, za 54 000 do 60 000 cr.", false],
	],
	"equipment/12": [
		[1, "", "Podstawowa torpeda samonaprowadzająca zadaje 20 obrażeń i sama kieruje się na cel, na odległość do 215 m. Przeładowuje się tylko co 4,3 s. Można zamontować tylko jedną wyrzutnię torped dowolnego typu. Przydaje się przeciw zwrotnym celom, które trudno utrzymać na celowniku, ale ma krótki zasięg.", false],
	],
	"equipment/13": [
		[1, "", "Średnia torpeda zadaje 30 obrażeń, przeładowuje się w 4,0 s i sięga 360 m, przewyższając model [[equipment/12]] pod każdym względem. Można zamontować tylko jedną wyrzutnię torped, więc zastępuje ona tańszy model, a nie go uzupełnia. Za 37 000 do 39 000 cr to dobra uniwersalna broń do dobijania celów.", false],
	],
	"equipment/14": [
		[1, "", "Najlepsza torpeda niesie głowicę o sile 50 obrażeń na odległość do 816 m, co jest najcięższym pojedynczym trafieniem spośród broni w sprzedaży. Przeładowanie trwa 6,8 s. Jako jedyna torpeda statku dobrze współgra z szybkimi działami: trafienie z dużej odległości na początku walki, a potem działa kończą robotę. Jest rzadka i kosztuje 62 500 cr lub więcej.", false],
	],
	"equipment/15": [
		[1, "", "Startowy harpun sięga 240 m i wybacza niecelne strzały dzięki tolerancji chwytu 24 m, najszerszej z trzech. Nie spowalnia zahaczonej zdobyczy, więc szybkie stworzenia mocno ciągną i długo się męczą. Wystarcza do glonów i powolnych zwierząt, a jego wymiana jest tania.", false],
	],
	"equipment/16": [
		[1, "", "Ten harpun sięga 400 m i spowalnia zahaczone stworzenie o 40%, dzięki czemu szybkie zdobycze, takie jak [[species/7]], znacznie łatwiej utrzymać w polu widzenia. Tolerancja chwytu spada do 18 m, więc celność ma większe znaczenie. Dla pilota, który regularnie łowi, to najważniejsze ulepszenie po większej ładowni.", false],
	],
	"equipment/17": [
		[1, "", "Najlepszy harpun sięga 560 m i spowalnia zahaczoną zdobycz o 70%, więc nawet szybkie stworzenia obezwładnia się bez długiego pościgu. Jego tolerancja chwytu, 14 m, jest najwęższa, więc nagradza staranne celowanie. Jest rzadki i drogi, od 69 000 do 83 000 cr, a można zamontować tylko jeden harpun.", false],
	],
	"equipment/18": [
		[1, "", "Podstawowa osłona pochłania 100 punktów obrażeń, zanim ucierpi pancerz. Wyznacza też płytką granicę statku na 20 000 m. Nigdy nie ładuje się w terenie; przywraca się ją tylko wtedy, gdy statek opuszcza stację. Wystarcza do pierwszych walk, ale większość pilotów wymienia ją jak najszybciej.", false],
	],
	"equipment/19": [
		[1, "", "Ta osłona pochłania 175 punktów, o trzy czwarte więcej niż model [[equipment/18]], i pozwala wznieść się na 18 400 m. Podobnie jak model podstawowy nie ładuje się w terenie. Za 15 750 do 18 000 cr to najtańsze sensowne ulepszenie osłony, które otwiera dostęp do kilku płycej położonych stacji.", false],
	],
	"equipment/2": [
		[1, "", "Najcięższe działo szynowe zadaje 9 obrażeń na strzał przy zasięgu 322 m, ale cykl ma nieco wolniejszy niż model [[equipment/1]], 0,62 s. Ciągłe obrażenia rosną więc tylko nieznacznie. Za 16 000 do 20 000 cr to dobra wartość pod względem zasięgu, ale model [[equipment/6]] zadaje wyraźnie więcej obrażeń za niewiele większe pieniądze.", false],
	],
	"equipment/20": [
		[1, "", "Ta osłona pochłania 220 punktów i jako pierwsza ładuje się w terenie, odzyskując punkt co 1,15 s, dopóki statek pozostaje w swoim pasie głębokości. Podnosi płytką granicę do 16 800 m. Za ponad 56 000 cr kosztuje znacznie więcej niż model [[equipment/19]], ale ładowanie czyni długie walki dużo bezpieczniejszymi.", false],
	],
	"equipment/21": [
		[1, "", "Najlepsza osłona pochłania 310 punktów i odzyskuje punkt co 0,65 s, prawie dwa razy szybciej niż model [[equipment/20]]. Jej płytka granica, 15 000 m, sięga wyżej niż w każdej innej osłonie, co otwiera dostęp do najpłycej położonych stacji. Jest rzadka i kosztuje 93 750 cr lub więcej; to inwestycja na późną fazę kampanii.", false],
	],
	"equipment/22": [
		[1, "", "Podstawowy pancerz dodaje 100 punktów ochrony, zużywanych po wyczerpaniu osłony, a przed trafieniem w kadłub. Wyznacza też głęboką granicę na 25 000 m. Pancerz nie regeneruje się w terenie. Ta płyta jest tania i na początek wystarcza, ale wiele głębiej położonych stacji leży poza jej zasięgiem.", false],
	],
	"equipment/23": [
		[1, "", "Ten pancerz dodaje 155 punktów i obniża głęboką granicę do 26 800 m. Kosztuje mniej więcej tyle co [[equipment/19]], jego odpowiednik wśród osłon, a razem oba elementy poszerzają pas głębokości statku w obu kierunkach. To dobre wczesne ulepszenie dla pilota, który chce dotrzeć do głębiej położonych stacji.", false],
	],
	"equipment/24": [
		[1, "", "Ten pancerz dodaje 195 punktów i pozwala zanurzać się do 28 400 m. Jest wyraźnie droższy niż model [[equipment/23]], od 56 000 do 72 000 cr, przy mniejszym zysku ochrony. Dodatkowa głębokość jest często mocniejszym powodem zakupu, bo udostępnia wiele głębokich stacji.", false],
	],
	"equipment/25": [
		[1, "", "Najlepszy pancerz dodaje 270 punktów i pozwala zanurzać się do 30 000 m, najgłębszej dostępnej granicy. Jest rzadki i kosztuje 93 750 cr lub więcej. W połączeniu z osłoną [[equipment/21]] pozwala statkowi działać niemal w całym zakresie głębokości stacji.", false],
	],
	"equipment/26": [
		[1, "", "Najmniejszy moduł ładowni dodaje 30% bazowej pojemności kadłuba. Można zamontować kilka modułów, a ich premie się sumują. Ponieważ premia jest częścią pojemności bazowej, na statku [[ship/0]] daje 7 t, a na statku [[ship/6]] aż 54 t. To najtańszy sposób na powiększenie ładowni dużego kadłuba.", false],
	],
	"equipment/27": [
		[1, "", "Ten moduł dodaje 50% bazowej pojemności kadłuba i można go łączyć z innymi. W przeliczeniu na kredyt jest nieco mniej wydajny niż model [[equipment/26]], ale oszczędza gniazda, co ma większe znaczenie na kadłubach z niewielkim zapasem miejsc. Na statku [[ship/4]] jeden moduł dodaje 35 t, co uzasadnia zajęcie gniazda podczas wyprawy handlowej.", false],
	],
	"equipment/28": [
		[1, "", "Największy moduł dodaje 80% pojemności bazowej, najwięcej na gniazdo spośród modułów ładowni. Na statku [[ship/6]] dodaje 144 t. Można zamontować kilka. Jest rzadki i kosztuje 45 000 cr lub więcej, więc opłaca się głównie na kadłubie z dużą ładownią przeznaczonym do handlu.", false],
	],
	"equipment/29": [
		[1, "", "Podstawowy silnik zwiększa zasięg S.T.R.E.A.M. statku na mapie o 30%, więc w jednym skoku można dotrzeć do większej liczby stacji. Można zamontować tylko jeden silnik. Jest tani i przydatny od samego początku, bo mniej skoków oznacza szybsze wyprawy handlowe i przewozy pasażerów.", false],
	],
	"equipment/3": [
		[1, "", "Pierwsze działo magnetyczne to broń promieniowa stworzona z myślą o zasięgu. Sięga 875 m, prawie cztery razy dalej niż działa szynowe, i zadaje 15 obrażeń, ale między strzałami potrzebuje 2,5 s. Jego ciągłe obrażenia są mniej więcej takie same jak w modelu [[equipment/0]]. Warto je zamontować, by otwierać ogień do nadpływających statków, zanim zdążą odpowiedzieć.", false],
	],
	"equipment/30": [
		[1, "", "Ten silnik zwiększa zasięg S.T.R.E.A.M. o 60%, dwa razy więcej niż model [[equipment/29]], za mniej więcej trzykrotną cenę. Pasuje handlarzowi, który regularnie wozi towary między odległymi rynkami, bo ceny rosną wraz z odległością, jaką pokonuje ładunek. Jest też na tyle powszechny, że można go znaleźć w sklepach w środkowej fazie kampanii.", false],
	],
	"equipment/31": [
		[1, "", "Najlepszy silnik zwiększa zasięg S.T.R.E.A.M. o 130%, czyli ponad dwukrotnie. Jest rzadki i kosztuje 90 000 cr lub więcej. Warto go zamontować, gdy przy długich szlakach handlowych lub odległych celach kontraktów liczy się każdy zaoszczędzony skok.", false],
	],
	"equipment/32": [
		[1, "", "Ten moduł manewrowy dodaje 0,15 do sterowności kadłuba. Zysk jest stały, więc najbardziej liczy się na powolnych kadłubach: na statku [[ship/6]] podnosi sterowność z 0,67 do 0,82. Można zamontować tylko jeden moduł sterowania. To tani sposób na ociężały frachtowiec.", false],
	],
	"equipment/33": [
		[1, "", "Ten moduł manewrowy dodaje 0,26 do sterowności, prawie dwa razy więcej niż model [[equipment/32]], za mniej więcej trzykrotną cenę. Pasuje pilotowi, który często walczy kadłubem średniej wielkości i musi wchodzić w zakręty ciaśniej niż atakujący piraci. Na statku [[ship/4]] podnosi sterowność z 0,91 do 1,17, blisko wartości, którą ma [[ship/7]].", false],
	],
	"equipment/34": [
		[1, "", "Najlepszy moduł manewrowy dodaje 0,56 do sterowności. To wystarczy, by [[ship/6]] skręcał lepiej niż [[ship/0]] albo by [[ship/5]] zyskał niedościgłą zwrotność. Jest rzadki i kosztuje 87 000 cr lub więcej; to luksus dla zaprawionych w boju pilotów. Na kadłubie, który już dobrze się prowadzi, lepiej wydać pieniądze na tańsze moduły.", false],
	],
	"equipment/35": [
		[1, "", "Podstawowy radar nanosi statki i inne kontakty na ekran radaru i zaznacza je na krawędzi widoku, dzięki czemu pilot może znaleźć cele. Bez radaru ekran pokazuje tylko nawigację. Nie podaje nazw wrogich statków ani nie pokazuje stworzeń, ale jest tani i niezbędny.", false],
	],
	"equipment/36": [
		[1, "", "Ten radar bojowy dodaje identyfikację: wrogi statek na celowniku jest opisywany typem kadłuba i przewożonym ładunkiem. Nie pokazuje stworzeń, więc jest narzędziem wojownika. Za 18 500 do 23 000 cr kosztuje mniej więcej tyle co [[equipment/37]], więc wybór zależy od tego, czy pilot głównie walczy, czy łowi.", false],
	],
	"equipment/37": [
		[1, "", "Ten radar połowowy pokazuje na ekranie radaru stworzenia obok statków, co znacznie ułatwia znajdowanie cennych zdobyczy. Nie opisuje wrogich statków tak jak [[equipment/36]]. Dla pilota nastawionego na połów to najprzydatniejszy radar, jeśli nie liczyć modelu [[equipment/38]].", false],
	],
	"equipment/38": [
		[1, "", "Najlepszy radar łączy obie specjalizacje: opisuje wrogie statki i pokazuje stworzenia na ekranie radaru. Kosztuje mniej więcej dwa razy tyle co każdy z radarów specjalistycznych i rzadko trafia do sklepów. Można zamontować tylko jeden radar, więc ten model oszczędza wyboru między połowem a walką.", false],
	],
	"equipment/39": [
		[1, "", "Podstawowy dopalacz podwaja prędkość statku na 3 s, a potem potrzebuje 20 s na naładowanie. Można zamontować tylko jeden dopalacz. Przydaje się do zbliżenia się do celu, ucieczki przed niebezpieczeństwem lub szybszego dotarcia do bramy S.T.R.E.A.M., a przy tym jest powszechny i tani.", false],
	],
	"equipment/4": [
		[1, "", "To działo magnetyczne podnosi obrażenia na strzał do 22, ale wydłuża odstęp do 3,4 s, więc jego ciągła siła ognia jest niewiele wyższa niż w modelu [[equipment/3]]. Zasięg jest prawie niezmieniony, 884 m. To przyzwoity wybór, gdy tańszego modelu nie ma w sprzedaży, ale ulepszenie jest mniejsze, niż sugeruje różnica w cenie.", false],
	],
	"equipment/40": [
		[1, "", "Ten dopalacz zwiększa prędkość 2,5-krotnie na około 4 s i ładuje się w około 16 s. Każdy parametr jest lepszy niż w modelu [[equipment/39]], przy mniej więcej dwukrotnej cenie. To dobry wybór na środkową fazę kampanii dla pilotów bojowych, który skraca też dojście do bramy S.T.R.E.A.M. na długich trasach.", false],
	],
	"equipment/41": [
		[1, "", "Najlepszy dopalacz potraja prędkość na około 5 s i ładuje się w 14,5 s, więc jest gotowy częściej i działa dłużej niż każdy inny. Jest rzadki, ale za około 42 000 cr kosztuje mniej niż większość sprzętu najwyższej klasy.", false],
	],
	"equipment/42": [
		[1, "", "Ciężkie działo stacyjne, które nigdy nie trafia na zwykłe półki i nie ma ceny katalogowej. Zadaje 40 obrażeń na strzał co 0,93 s przy zasięgu 240 m, co daje mu ciągłe obrażenia zbliżone do najlepszych wyrzutni masy, a każde trafienie jest tak silne jak trafienie torpedy średniej klasy.", false],
		[33, "", "Od [[chapter/33|rozdziału 33]] kampania toczy się wokół poszukiwań takiego działa.", false],
		[42, "", "W [[chapter/42|rozdziale 42]] pilot musi zamontować je przed wypłynięciem i wypróbować na piratach.", false],
	],
	"equipment/43": [
		[1, "", "Ten droid naprawczy przywraca jeden punkt kadłuba co 0,6 s, około 100 punktów na minutę, dopóki kadłub jest uszkodzony. Nie naprawia osłony ani pancerza. Przydaje się podczas długich misji i na statkach o słabym kadłubie, które nie mogą sobie pozwolić na przypadkowe trafienie. Można zamontować tylko jeden, a zajmuje gniazdo, w którym mogłoby się znaleźć działo.", false],
	],
	"equipment/5": [
		[1, "", "Najlepsze działo magnetyczne to broń snajperska. Każdy promień zadaje 35 obrażeń na odległość do 1380 m, największą spośród wszystkich broni, ale strzał jest gotowy tylko co 5,6 s. To jeden z najrzadszych elementów w sklepach. Zamontowane obok dział krótkiego zasięgu osłabia cele na długo, zanim reszta baterii zdoła do nich dosięgnąć.", false],
	],
	"equipment/6": [
		[1, "", "Pierwsze działo fuzyjne to broń do walki z bliska: 10 obrażeń co 0,51 s, ale tylko na 160 m, najkrótszy zasięg spośród wszystkich dział. Tempo zadawania obrażeń ma znacznie wyższe niż każde działo szynowe. Pasuje do zwrotnych kadłubów, które potrafią szybko się zbliżyć, i w walce na bliski dystans czyni działa szynowe przestarzałymi.", false],
	],
	"equipment/7": [
		[1, "", "To ulepszenie zadaje 14 obrażeń co 0,37 s, przy najszybszym tempie ognia spośród wszystkich dział, i wydłuża zasięg do 216 m. Jego ciągłe obrażenia są prawie dwa razy wyższe niż w modelu [[equipment/6]], a kosztuje tylko kilka tysięcy kredytów więcej. W przeliczeniu na wydany kredyt to jedno z najmocniejszych dział w grze.", false],
	],
	"equipment/8": [
		[1, "", "Najcięższe działo fuzyjne zadaje 18 obrażeń co 0,40 s na 220 m. To solidna poprawa względem modelu [[equipment/7]], choć różnica jest mniejsza niż między dwoma pierwszymi modelami. W sklepach jest rzadkie. Gdy się trafi, to świetny zakup do każdej baterii bliskiego zasięgu.", false],
	],
	"equipment/9": [
		[1, "", "Pierwsza wyrzutnia masy uderza mocno, 16 obrażeń na strzał, ale strzela tylko co 0,6 s i sięga 195 m. Za 38 000 cr lub więcej zadaje mniej obrażeń na sekundę niż tańszy model [[equipment/7]]. To głównie etap przejściowy do późniejszych wyrzutni masy.", false],
	],
	"faction/colonists": [
		[1, "", "Koloniści to osadnicy i administratorzy, którzy na początku historii rządzą oceaniczną planetą. Kontrolują wszystkie jej dwieście stacji, ustalają ceny połowu i decydują, kto dostaje pracę. Ich kolonia jest zbudowana po to, by wydobywać zasoby morza i wywozić je z planety. O kolonii jako miejscu opowiada strona [[world/colony]].", false],
		[1, "Historia", "Koloniści przybyli na planetę z innych miejsc i zbudowali jej stacje głęboko pod powierzchnią morza. Gdy pilot przybywa, kolonia jest już od dawna dobrze ugruntowana, z urzędnikami na każdej stacji, statkami patrolowymi przy każdej bramie i stałym strumieniem eksportu.", false],
		[21, "", "Według rebeliantów kolonizacja przebiegała szybko i bez oglądania się na konsekwencje. Ostrzegają, że ocean traci życie szybciej, niż zdoła się odrodzić, i że inne planety zostały już w ten sam sposób wyjałowione.", false],
		[1, "Organizacja", "Każdą stacją zarządzają urzędnicy kolonii, którzy prowadzą handel, rozdzielają kontrakty i dowodzą lokalnymi patrolami. Nad nimi stoją władze handlowe, które nadzorują eksport i obarczają stacje odpowiedzialnością za wszelkie straty. Ochrona stacji i piloci kolonii radzą sobie z piratami i innymi zagrożeniami, często zatrudniając wolnych strzelców.", false],
		[10, "", "Towary opuszczają planetę w kapsułach transportowych, wystrzeliwanych ze stacji na orbitę i tam odbieranych przez statki towarowe.", false],
		[1, "Cele i metody", "Celem kolonii jest zysk dla jej mocodawców. Skupuje połów i towary po stałych niskich cenach i nie pozwala swoim stacjom swobodnie handlować. Zwierzęta, które wchodzą w drogę, są wybijane, a każdy, kto zagraża przesyłkom, zostaje przepędzony.", false],
		[23, "", "W obliczu rebelii koloniści przechodzą od administrowania do użycia siły. Minują szlaki zaopatrzenia, urządzają zasadzki i atakują stacje rebeliantów.", false],
		[28, "", "Są też gotowi kupować lojalność. Nagroda wystarcza, by zwrócić pilota rebeliantów przeciw jego własnej przywódczyni.", false],
		[2, "Znani członkowie", "[[character/9]] to kolonista, którego pilot zna najlepiej: arogancki urzędnik na stacji [[station/0]], który patrzy na pilota z góry i skupuje połów po stałych cenach.", false],
		[9, "", "Pomniejsi urzędnicy występują jako bezimienni [[character/6|koloniści]], na przykład urzędnik na stacji [[station/1]], który marnie płaci za odstrzał łodzików, a potem kieruje pilota do pracy z tablicy kontraktów.", false],
		[23, "", "W trakcie historii Jack dochodzi do znacznej władzy, najwyraźniej dzięki dobrym znajomościom, i staje się najbardziej zawziętym wrogiem rebeliantów.", false],
		[28, "", "[[character/3]], pilot rebeliantów, potajemnie bierze pieniądze od kolonii i zdradza swoich towarzyszy.", false],
		[3, "Rola w fabule", "Na początku koloniści są po prostu pracodawcami pilota. Jack skupuje połów i podsuwa pilotowi pomysł, by kupił działo i polował na piratów.", false],
		[7, "", "Następnie zleca odstrzał [[species/0|łodzików]] na stacji [[station/1]], niewiele dbając o to, czy zostaną złowione, czy zabite.", false],
		[10, "", "Po kilku kontraktach kolonia powierza pilotowi obronę startu kapsuł na stacji [[station/2]] przed Akwarianami.", false],
		[12, "", "Jack obwinia pilota o kapsuły uszkodzone w tej walce i odmawia jakiejkolwiek zapłaty. Zmęczony tym, jak traktuje go kolonia, pilot wyrusza na poszukiwanie ruchu oporu.", false],
		[18, "", "Gdy rebelianci zdobywają kolejne stacje perswazją, kolonia traci teren bez jednego wystrzału.", false],
		[23, "", "Jack minuje szlak zaopatrzenia rebeliantów między stacjami [[station/9]] i [[station/37]].", false],
		[25, "", "Potem urządza zasadzkę na przywódczynię rebeliantów, którą jest [[character/2]], w drodze na negocjacje na stacji [[station/10]].", false],
		[28, "", "Nagroda wyznaczona przez Jacka zwraca Raymonda przeciw rebeliantom. Raymond porywa Ayumi, a pilot ją ratuje.", false],
		[31, "", "Koloniści ukradli prototyp, który zbudował [[world/abel|profesor Abel]], czyli [[world/biotek|generator Biotek]]. Rebelianci przechwytują wiozący go konwój w pobliżu stacji Cho.", false],
		[37, "", "Jack sprzedaje działo stacyjne [[world/eclipse|Eclipse]] na czarnym rynku, nie podejrzewając, że zostanie użyte przeciw niemu.", false],
		[44, "", "Koloniści przeprowadzają niespodziewany atak na stację [[station/14]], serce rebelii, ale zostają rozgromieni, gdy rebeliantom przychodzą z pomocą Akwarianie. Jack ucieka z pola bitwy.", false],
		[46, "", "Pierwsza ofensywa rebeliantów odbiera kolonistom stację [[station/18]].", false],
		[47, "", "Druga zdobywa stację [[station/109]], a panowanie kolonistów na południu się załamuje.", false],
		[48, "", "Stacja [[station/0]], ostatni bastion kolonii, upada w ostatecznej bitwie. Jack ucieka w kapsule ratunkowej, a rządy kolonii nad oceanem dobiegają końca.", false],
		[1, "W grze", "Stacje kolonistów są na [[chart|mapie stacji]] niebieskie. Nie mają rynku ani fabryki: przy dokowaniu zabierają całą zawartość ładowni po cenie minimalnej. Dlatego nie warto przypływać do nich z cennym ładunkiem. Ich sklepy i stocznie są otwarte, ale stocznie sprzedają tylko standardowe kadłuby. Zob. [[guide/allegiance]].", false],
		[1, "", "Na ich tablicach kontraktów pojawiają się kontrakty typu [[contract/0]], [[contract/1]], [[contract/2]], [[contract/3]], [[contract/4]], [[contract/5]], [[contract/7]], [[contract/8]], [[contract/9]], [[contract/10]] i [[contract/11]], ale nigdy dostawy ani ochrona ryb. W pracy przy konwojach dla kolonistów przeciwnikami są statki rebeliantów.", false],
		[1, "", "Z drugiej strony stacja kolonistów płaci za piratów dwa razy więcej niż stacja rebeliantów: liczba zniszczonych podczas rejsu, podniesiona do kwadratu, razy 100 kredytów. Statki patrolowe wokół stacji kolonistów walczą po stronie kolonii i pomagają w walce z piratami.", false],
		[12, "", "Stacje odchodzą od kolonii w miarę postępów fabuły, nigdy wskutek działań w swobodnej grze, i żadna nigdy nie wraca. Gdy pilot staje po stronie rebeliantów, statki kolonistów stają się głównym wrogiem w misjach fabularnych.", false],
	],
	"faction/pirates": [
		[1, "", "Piraci to banici, którzy napadają na statki w całym oceanie. Nie służą ani kolonii, ani rebeliantom, atakując samotne statki, konwoje i każdego, kto wygląda na łatwą ofiarę. Od pierwszego uzbrojonego wypadu aż do końca fabuły i dalej są najczęstszymi przeciwnikami pilota.", false],
		[1, "Historia", "Gdy pilot przybywa, piractwo jest już codziennością. Stacje płacą nagrody każdemu, kto zniszczy piracki statek, a polowanie na piratów to popularne zajęcie wśród uzbrojonych pilotów.", false],
		[21, "", "Konflikt między kolonistami a rebeliantami to dla piratów prawdziwy dar. Gdy obie strony są zajęte czymś innym, piraci znajdują więcej łatwiejszych ofiar, a przywództwo rebeliantów uznaje, że nie może ich dłużej ignorować.", false],
		[1, "Organizacja", "Piraci działają w luźnych bandach, a nie jako jedna organizacja, i żaden z nich nie zostaje w fabule wymieniony z imienia. Bandy gromadzą się w kryjówkach na otwartych wodach, eskortują skradzione statki oraz strzegą pól minowych i pól szczątków. Pojedynczy piraci czyhają też w pobliżu stacji na przepływające statki.", false],
		[1, "Cele i metody", "Piratom chodzi o łupy. Atakują statki dla ich ładunku i gromadzą się wszędzie tam, gdzie są kłopoty, czekając na osłabione statki, które łatwo dobić.", false],
		[23, "", "Krążą wokół kolonialnego pola minowego w pobliżu stacji [[station/9]], licząc na to, że dopadną statki, które w nie wpadną.", false],
		[35, "", "W tych samych kręgach obracają się najemnicy. Łowca nagród, którym jest [[character/11]], pływa z uzbrojoną eskortą, a jego statek liczy się przy nagrodach jako piracki.", false],
		[5, "Znani członkowie", "W fabule piraci pojawiają się tylko jako bezimienni piloci występujący jako [[character/10|pirat]], bez przywódcy ani słynnego kapitana.", false],
		[5, "Rola w fabule", "Piraci są pierwszymi celami nowego działa pilota. Za namową, jakiej udziela [[character/1]], pilot wytropia pirata w pobliżu stacji [[station/1]].", false],
		[21, "", "Ayumi postanawia przestać jedynie bronić ruchu i uderzyć w piratów. Wysyła pilota i jego towarzysza, którym jest [[character/3]], przeciw bandzie w pobliżu stacji [[station/8]].", false],
		[25, "", "Piratów spodziewa się na trasie do stacji [[station/10]], choć prawdziwe zagrożenie okazuje się tam kolonialne.", false],
		[26, "", "Otrzymawszy rozkaz, by stać się lepszym wojownikiem, pilot zajmuje się polowaniem na piratów, by zwiększyć liczbę zestrzeleń.", false],
		[42, "", "Kryjówka piratów w pobliżu stacji [[station/17]] służy jako poligon dla świeżo zamontowanego działa [[world/eclipse|Eclipse]].", false],
		[43, "", "Tamtejsi piraci szybko zaczynają wzywać posiłki.", false],
		[47, "", "Nawet podczas ostatnich ofensyw piraci zatrzymują [[character/5]] w drodze na stację [[station/0]].", false],
		[1, "W grze", "Piraci to standardowy wróg na otwartych wodach. Ich kadłuby stają się wytrzymalsze, a działa silniejsze w miarę wzrostu rangi pilota i postępów fabuły. Pojawiają się w kontraktach typu [[contract/0]], [[contract/1]], [[contract/2]] i [[contract/3]] oraz strzegą pól minowych i pól szczątków. Zob. [[guide/combat]].", false],
		[1, "", "Od [[chapter/12|rozdziału 12]] przy przybyciu pilota w pobliżu stacji mogą czekać nawet trzej piraci, a szansa na to rośnie z każdym rozdziałem. Od [[chapter/16|rozdziału 16]] piraci i inne wrogie statki używają też nagłych zrywów prędkości.", false],
		[1, "", "Każdy pirat zniszczony podczas rejsu podnosi nagrodę wypłacaną na następnej stacji: liczba zniszczonych, podniesiona do kwadratu, razy 100 kredytów na stacji kolonistów lub 50 na stacji rebeliantów. Długie polowania opłacają się więc znacznie bardziej niż krótkie. Ich wraki opadają powoli i można je przeszukać harpunem w poszukiwaniu ładunku, zanim opadną zbyt głęboko.", false],
		[1, "", "Piraci nie mają własnych stacji i żadna stacja nigdy nie przechodzi na ich stronę.", false],
	],
	"faction/rebels": [
		[1, "", "Rebelianci to jedna z sił, które mogą kontrolować stację. Ich natura i cele wyjaśniają się w miarę rozwoju fabuły. Zob. [[guide/allegiance]].", false],
		[12, "", "Rebelianci to ruch oporu, który powstaje przeciw rządom kolonii na oceanicznej planecie. Zaczynają jako tajna siatka z bazą na stacji [[station/3]] i rozprzestrzeniają się stacja po stacji. Chcą wolnego handlu i morza wykorzystywanego z rozwagą, a nie plądrowanego.", false],
		[12, "Historia", "Ruch jest już aktywny, gdy pilot po raz pierwszy o nim słyszy, dzięki komunikacji radiowej, którą M.A.I. przechwytuje ze stacji Talon.", false],
		[13, "", "Rebelianci zaczęli szyfrować swoje kanały zaledwie kilka dni po tej transmisji. Członkowie ruchu zachowują plany dla siebie i sprawdzają nowicjuszy, zanim im zaufają.", false],
		[18, "", "Przez długi czas ruch rośnie dzięki perswazji. Jego agenci zbierają informacje o stacjach i przeciągają na swoją stronę ich przywódców, a wiadomości wkrótce nazywają ruch rewolucją. Pierre spodziewa się, że pokojowa faza nie potrwa długo.", false],
		[26, "", "Zasadzka na stacji [[station/10]] pokazuje, że sama dyplomacja nie wygra walki, i ruch przygotowuje się do walki zbrojnej.", false],
		[31, "", "Aby przezwyciężyć przewagę liczebną kolonistów, przywództwo rebeliantów sprowadza zespół, którym kieruje [[world/abel|profesor Abel]], na stację [[station/14]], która staje się bazą operacyjną ruchu.", false],
		[13, "Organizacja", "Ruch jest nieliczny i ściśle zorganizowany. Rekrutów sprawdza się po przybyciu i mówi się im tylko to, co muszą wiedzieć. Misje są przekazywane przez nielicznych zaufanych agentów.", false],
		[18, "", "Przywódca ruchu kieruje jego działaniami z jednej z nowo pozyskanych stacji, a nawet jego własni członkowie niejasno określają, z której.", false],
		[19, "", "Przywódczyni podróżuje między stacjami, by osobiście prowadzić negocjacje. Pod jej kierunkiem służą agenci terenowi, piloci i inżynierowie.", false],
		[45, "", "Pod koniec wojny ruch wystawia całe eskadry okrętów bojowych.", false],
		[13, "Cele i metody", "Rebelianci potępiają wyzysk planety i jej mieszkańców i opowiadają się za wolnym handlem.", false],
		[15, "", "Ich gospodarka jest przeciwieństwem gospodarki kolonii. Łowią i zbierają tylko to, co morze może oddać, przerabiają połów na towary we własnych fabrykach i sprzedają je po uczciwych cenach rynkowych, dbając o zachowanie bioróżnorodności.", false],
		[16, "", "Wolą przekonywać ludzi niż z nimi walczyć. Agenci rozpoznają stacje, by znaleźć słabe punkty, dzięki którym da się przeciągnąć ich mieszkańców na swoją stronę.", false],
		[21, "", "Ich przywódczyni ostrzega, że wyzysk prowadzony przez kolonię wyjałowi planetę, tak jak wyjałowił inne. Ruch dąży do tego, by wcześniej przekonać wpływowych ludzi do przyłączenia się. Walczy też z piratami, którzy czerpią zyski z chaosu.", false],
		[31, "", "Gdy użycie siły staje się nieuniknione, rebelianci postanawiają zbudować broń rozstrzygającą, zamiast dorównywać kolonii statek za statek.", false],
		[12, "Znani członkowie", "[[character/4]] sprawdza nowicjuszy na stacji [[station/3]]. Radiooperatorzy, strażnicy i załogi konwojów rebeliantów występują jako [[character/7]].", false],
		[13, "", "[[character/5]] to agentka terenowa, która zapoznaje pilota ze sposobem życia ruchu.", false],
		[33, "", "Pierre kieruje później hangarem na stacji [[station/14]], dbając o gotowość statków ruchu.", false],
		[19, "", "[[character/2]] przewodzi ruchowi. To starsza kobieta, choć pilot zakładał, że przywódca jest mężczyzną.", false],
		[21, "", "[[character/3]] to jeden z najlepszych pilotów Ayumi, zdolny, ale arogancki.", false],
		[28, "", "Raymond zdradza dla nagrody wyznaczonej przez kolonię i porywa Ayumi.", false],
		[31, "", "[[world/abel]] kieruje zespołem naukowców, który stoi za [[world/biotek|generatorem Biotek]].", false],
		[45, "", "[[character/12]] dowodzi eskadrą bojową, która dołącza do pilota podczas ataku na stację [[station/18]].", false],
		[12, "Rola w fabule", "Po zerwaniu z kolonią pilot szuka ruchu na stacji Talon.", false],
		[13, "", "Pierre przyjmuje pilota na próbę. Pierwszym zadaniem jest przewiezienie Leah ze stacji [[station/4]] na stację [[station/5]].", false],
		[16, "", "Potem przychodzą kolejne zadania: produkcja towarów na stacjach rebeliantów i rozpoznanie stacji dla ruchu.", false],
		[19, "", "Pilot w końcu poznaje Ayumi i chroni ławicę kałamarnic przed myśliwymi kolonistów w pobliżu stacji [[station/7]].", false],
		[22, "", "U boku Raymonda pilot rozbija bandę piratów w pobliżu stacji [[station/8]].", false],
		[24, "", "Następnie pilot oczyszcza kolonialne pole minowe w pobliżu stacji [[station/9]].", false],
		[26, "", "Na stacji Sula przywództwo ruchu wpada w zasadzkę. Broń Raymonda zawodzi w decydującej chwili, a Leah podejrzewa sabotaż.", false],
		[28, "", "Raymond wciąga pilota w pułapkę, trzymając Ayumi jako zakładniczkę, ale pilot niszczy jego statek i odzyskuje ją żywą.", false],
		[31, "", "Ruch rozpoczyna realizację planu w trzech krokach, zaczynając od odzyskania skradzionego [[world/biotek|generatora Biotek]].", false],
		[33, "", "Drugim krokiem jest zdobycie działa [[world/eclipse|Eclipse]], które pilot kupuje za pośrednictwem handlarza z czarnego rynku.", false],
		[39, "", "Trzecim jest zbudowanie na stacji [[station/16]] inkubatora, który dopełnia generator.", false],
		[44, "", "Broń zostaje ukończona tuż przed atakiem kolonistów na stację Fiir. Eclipse pilota i nagła pomoc ze strony [[world/aquarians|Akwarian]] ratują stację.", false],
		[45, "", "Akwarianie obiecują wsparcie, a ruch planuje swoje ostatnie ofensywy z nimi jako sojusznikami.", false],
		[47, "", "Następują dwie ofensywy. Leah zdobywa stację [[station/109]], a pilot stację [[station/18]].", false],
		[48, "", "Wojna kończy się upadkiem stacji [[station/0]], a ruch kontroluje wszystkie stacje na planecie.", false],
		[1, "W grze", "Stacje rebeliantów są na [[chart|mapie stacji]] pomarańczowe. Mają wolne rynki i fabryki, więc można tam kupować, sprzedawać i wytwarzać towary; zob. [[guide/trading]]. Ich stocznie sprzedają każdy kadłub w ulepszonej wersji. Patrole wokół stacji rebeliantów walczą po stronie rebeliantów.", false],
		[1, "", "Na ich tablicach kontraktów pojawiają się kontrakty typu [[contract/0]], [[contract/1]], [[contract/2]], [[contract/3]], [[contract/6]], [[contract/8]], [[contract/9]], [[contract/10]], [[contract/13]] i [[contract/14]]. Nigdy nie wystawiają eskort, napaści na konwoje, polowań na ryby ani zleceń związanych z kapsułami, a ochronę ryb przestają wystawiać po ukończeniu fabuły. Gdy kontrakty rebeliantów wymagają walki z innymi statkami, przeciwnikami są koloniści lub piraci.", false],
		[1, "", "Stacja rebeliantów płaci za piratów połowę stawki kolonistów: liczba zniszczonych podczas rejsu, podniesiona do kwadratu, razy 50 kredytów.", false],
		[12, "", "Stacje przechodzą do rebeliantów w miarę postępów fabuły, najpierw po kilka, a potem dziesiątkami naraz. Stacja, która się przyłączy, nigdy nie wraca do kolonii. Ta strona wymienia stacje, które przyłączają się w każdym z rozdziałów, do których już dotarłeś.", false],
	],
	"goods/18": [
		[1, "", "Szczątki stworzenia zabitego zamiast złowionego harpunem. Truchło unosi się w górę i można je przyciągnąć harpunem, uzyskując mięso o masie jednej trzeciej zwierzęcia. Sprzedaje się po 12 do 31 cr i służy głównie, razem z gatunkiem [[species/14]], do wyrobu produktu [[goods/19]]. Jego stacją macierzystą jest [[station/68]].", false],
	],
	"goods/19": [
		[1, "", "Podstawowy produkt z dwóch składników, po jednym na jednostkę: [[goods/18]] i [[species/14]]. Może go wytworzyć każda fabryka. Sprzedaje się od 135 cr na stacji [[station/78]] do 360 cr na stacji [[station/27]] i jest składnikiem produktów [[goods/30]] i [[goods/36]].", false],
	],
	"goods/20": [
		[1, "", "Wyprawiona skóra z gatunku [[species/3]], konserwowana towarem [[goods/33]]. Jej stacją macierzystą jest [[station/164]], a najwięcej, do 1062 cr, można za nią dostać na stacji [[station/172]]. Stanowi też połowę receptury produktu [[goods/29]], więc połów mant można zamienić w jeden z najdroższych towarów konsumpcyjnych.", false],
	],
	"goods/21": [
		[1, "", "Danie z surowej ryby i wodorostów, przyrządzane z dwóch składników: [[species/4]] i [[species/17]]. Oba są pospolitymi, tanimi zdobyczami, co czyni sushi łatwym pierwszym produktem. Sprzedaje się od 420 cr na stacji [[station/76]] do 996 cr na stacji [[station/179]].", false],
	],
	"goods/22": [
		[1, "", "Wodoodporny barwnik z dwóch składników: [[species/10]] i [[goods/35]]. Sprzedaje się od 750 cr na stacji [[station/54]] do 1872 cr na stacji [[station/27]]. Jest też jednym z dwóch składników produktu [[goods/29]].", false],
	],
	"goods/23": [
		[1, "", "Porcje mięsa z gatunku [[species/7]], konserwowane towarem [[goods/33]]. Ponieważ marlina trudno złowić, stek jest produktem z wyższej półki: sprzedaje się od 456 cr na stacji [[station/109]] do 1260 cr na stacji [[station/19]].", false],
	],
	"goods/24": [
		[1, "", "Świecący związek pozyskiwany z dwóch gatunków, [[species/5]] i [[species/1]], przy użyciu towaru [[goods/35]]. Sprzedaje się od 850 cr na stacji [[station/83]] do 2500 cr na stacji [[station/179]]. Jest kluczowym składnikiem produktów [[goods/32]], [[goods/41]] i [[goods/36]].", false],
	],
	"goods/25": [
		[1, "", "Białko pozyskiwane z dwóch gatunków, [[species/6]] i [[species/8]], przetwarzane z użyciem towaru [[goods/33]]. Sprzedaje się od 900 cr na stacji [[station/23]] do 2600 cr na stacji [[station/27]] i stanowi bazę produktu [[goods/31]].", false],
	],
	"goods/26": [
		[1, "", "Mieszane danie rybne z trzech składników: [[species/8]], [[species/4]] i [[species/2]]. Ma najwyższą cenę minimalną spośród całej żywności, od 1916 cr na stacji [[station/196]] do 3030 cr na stacji [[station/179]], ale wymaga trzech różnych zdobyczy.", false],
	],
	"goods/27": [
		[1, "", "Farmaceutyki z czterech składników: [[species/1]], [[species/13]], [[species/16]] i [[goods/33]]. Sprzedają się od 930 cr na stacji [[station/151]] do 2316 cr na stacji [[station/179]] i są jednym ze składników produktu [[goods/41]]. Rynki rzadko je oferują.", false],
	],
	"goods/28": [
		[1, "", "Przetworzona biomasa, która wymaga po jednej sztuce każdego z pięciu rodzajów glonów: [[species/13]], [[species/14]], [[species/15]], [[species/16]] i [[species/17]]. Sprzedaje się od 550 cr na stacji [[station/74]] do 2700 cr na stacji [[station/19]], co jest największą rozpiętością spośród podstawowych produktów, i trafia do produktu [[goods/36]].", false],
	],
	"goods/29": [
		[1, "", "Odzież z dwóch składników, [[goods/20]] i [[goods/22]], więc łańcuch prowadzi z powrotem do gatunków [[species/3]] i [[species/10]]. Sprzedaje się od 1626 cr na stacji [[station/175]] do 3420 cr na stacji [[station/172]]. Rynki rzadko ją oferują.", false],
	],
	"goods/30": [
		[1, "", "Przenośne źródło energii składane z dwóch składników: [[goods/34]] i [[goods/19]]. Sprzedaje się od 1150 cr na stacji [[station/78]] do 1900 cr na stacji [[station/27]]. Rzadko spotyka się je na rynkach, więc zwykle jedynym sposobem na jego zdobycie jest samodzielna produkcja.", false],
	],
	"goods/31": [
		[1, "", "Produkty upiększające z dwóch składników: [[goods/25]] i [[goods/35]]. Sprzedają się od 1536 cr na stacji [[station/23]] do 3840 cr na stacji [[station/27]]. Rynki rzadko je oferują, więc pilot, który wytwarza kolagen, może pójść o krok dalej i zarobić znacznie więcej.", false],
	],
	"goods/32": [
		[1, "", "Lampa naśladująca naturalne światło dzienne, budowana z dwóch składników: [[goods/34]] i [[goods/24]]. Sprzedaje się od 2490 cr na stacji [[station/83]] do 5622 cr na stacji [[station/179]], co czyni ją najcenniejszym produktem, jaki fabryka może wytworzyć z połowu i towarów importowanych.", false],
	],
	"goods/33": [
		[1, "", "Produkt uboczny odsalania, tani i powszechnie dostępny po 20 do 36 cr. Nie wytwarza się jej z połowu, ale jest potrzebna do wyrobu produktów [[goods/20]], [[goods/23]], [[goods/25]] i [[goods/27]]. Kontrakty dostawcze nigdy jej nie wymagają.", false],
		[12, "", "Rynki rebeliantów uzupełniają jej zapasy między wizytami, bo jest importowana.", false],
	],
	"goods/34": [
		[1, "", "Importowane podzespoły, powszechnie dostępne po 193 do 297 cr. Nie produkuje się ich na miejscu, ale są potrzebne do wyrobu produktów [[goods/30]], [[goods/32]], [[goods/41]] i [[goods/36]]. Kontrakty dostawcze nigdy ich nie wymagają.", false],
		[12, "", "Rynki rebeliantów uzupełniają zapasy elektroniki między wizytami, bo jest importowana.", false],
	],
	"goods/35": [
		[1, "", "Importowana substancja chemiczna, powszechnie dostępna po 55 do 123 cr. Jest potrzebna do wyrobu produktów [[goods/22]], [[goods/24]] i [[goods/31]]. Kontrakty dostawcze nigdy jej nie wymagają.", false],
		[12, "", "Rynki rebeliantów uzupełniają jej zapasy między wizytami, bo jest importowana.", false],
	],
	"goods/36": [
		[1, "", "Aparat laboratoryjny do powielania materiału genetycznego. Wymaga czterech składników: [[goods/19]], [[goods/34]], [[goods/28]] i [[goods/24]], a złożyć go może tylko fabryka o poziomie techniki 11. Rynki nigdy go nie oferują.", false],
		[39, "", "Od [[chapter/39|rozdziału 39]] kampania wymaga od pilota zdobycia jednego egzemplarza.", false],
	],
	"goods/37": [
		[1, "", "Importowany narkotyk uważany za narastający problem społeczny. Nie wytwarza się go z połowu, a rynki nigdy go nie oferują.", false],
		[34, "", "W [[chapter/34|rozdziale 34]] pilot musi dostarczyć partię towaru kontaktowi w ramach umowy.", false],
	],
	"goods/38": [
		[1, "", "Ciężkie działo stacyjne w skrzyni, warte 89 000 cr. Nie można go kupić na rynkach. Po dostarczeniu i zamontowaniu staje się bronią [[equipment/42]].", false],
		[37, "", "Od [[chapter/33|rozdziału 33]] pilot go poszukuje, a w [[chapter/37|rozdziale 37]] przewozi je w ładowni.", false],
	],
	"goods/39": [
		[1, "", "Importowana składana łopata. Jej cena waha się od 9 cr do 999 cr w zależności od tego, jak daleko jest przewożona, co czyni ją ładunkiem spekulacyjnym. Żadna fabryka jej nie wytwarza, a kontrakty dostawcze nigdy jej nie wymagają. Jej stacją macierzystą jest [[station/89]].", false],
	],
	"goods/40": [
		[1, "", "Figurka sławnego bohatera sprzedawana kolekcjonerom. Jej cena rośnie od 999 cr do 9999 cr, od stacji [[station/90]] do stacji [[station/19]], co jest najbardziej stromym wzrostem spośród towarów handlowych. Rzadko trafia na rynki, a kontrakty dostawcze nigdy jej nie wymagają.", false],
	],
	"goods/41": [
		[1, "", "Mikroskopijne roboty medyczne budowane z trzech składników: [[goods/27]], [[goods/24]] i [[goods/34]]. Należą do najcenniejszych towarów, sprzedając się od 4315 cr na stacji [[station/76]] do 11 972 cr na stacji [[station/179]], a rynki prawie nigdy ich nie oferują.", false],
	],
	"guide/allegiance": [
		[1, "Dwa rodzaje stacji", "Każda stacja należy do jednej z dwóch stron, co pokazuje jej kolor na [[chart|mapie stacji]]: niebieski oznacza frakcję [[faction/colonists]], a pomarańczowy frakcję [[faction/rebels]]. Na początku fabuły wszystkie stacje należą do kolonistów.", false],
		[1, "", "Strona, do której należy stacja, wpływa na jej ofertę:", false],
		[1, "", "Handel: stacje kolonistów nie mają rynku ani warsztatu. Po przybyciu skupują całą zawartość ładowni po cenie minimalnej. Stacje rebeliantów swobodnie handlują i produkują; zob. [[guide/trading]].", true],
		[1, "", "Kontrakty: każda strona wystawia własny wybór rodzajów kontraktów; zob. [[guide/contracts]].", true],
		[1, "", "Nagrody: nagroda za piratów jest na stacji kolonistów dwa razy wyższa niż na stacji rebeliantów.", true],
		[1, "", "Statki: stocznie rebeliantów sprzedają każdy kadłub w ulepszonej wersji.", true],
		[1, "", "Patrole: statki krążące wokół stacji walczą po jej stronie.", true],
		[1, "", "Dokowanie, sklep z wyposażeniem, salon statków i tablica zleceń są dostępne dla pilota na stacjach obu rodzajów.", false],
		[1, "Jak zmienia się przynależność", "Stacje zmieniają stronę tylko wraz z postępami fabuły, nigdy w wyniku działań pilota w swobodnej grze. Stacja, która przeszła do rebeliantów, zostaje z nimi na stałe. Strona frakcji [[faction/rebels]] wymienia stacje, które przyłączają się w każdym osiągniętym przez ciebie rozdziale.", false],
		[12, "", "Pierwszą stacją rebeliantów jest [[station/3]], która należy do ruchu oporu już wtedy, gdy pilot po raz pierwszy o niej słyszy. W [[chapter/12|rozdziale 12]] dołącza stacja [[station/4]].", false],
		[14, "", "W kolejnych rozdziałach stacje przechodzą na drugą stronę pojedynczo lub po kilka.", false],
		[22, "", "Od [[chapter/22|rozdziału 22]] ruch rośnie znacznie szybciej, a naraz przyłącza się osiem lub więcej stacji.", false],
		[46, "", "W ostatnich rozdziałach zdecydowana większość mapy jest pomarańczowa.", false],
		[12, "Co to oznacza dla pilota", "W miarę jak kolejne stacje zmieniają stronę, na całej mapie otwierają się rynki i warsztaty, a połów przestaje być jedynym sposobem zarabiania. Stacji kolonistów lepiej unikać z cennym ładunkiem, ale to dobre miejsca na odebranie nagrody za piratów.", false],
	],
	"guide/basics": [
		[1, "Twój pierwszy statek", "Pilot zaczyna na stacji [[station/0]] z 15 000 kredytów i małą łodzią rybacką, którą jest [[ship/0]]. Ma ona na wyposażeniu harpun [[equipment/15]], osłonę [[equipment/18]], pancerz [[equipment/22]] i radar [[equipment/35]]. Nie ma żadnych dział.", false],
		[1, "", "Pierwsze rozdziały to wprowadzenie z przewodnikiem. Komputer pokładowy, [[character/1]], objaśnia każde nowe zadanie, gdy się pojawi: złowienie ryby, dokowanie, montaż wyposażenia i podróże. Bieżący cel jest zawsze widoczny w dzienniku misji.", false],
		[1, "Sterowanie", "Łodzią możesz sterować klawiaturą i myszą, padem lub dotykiem, a każdy klawisz da się przypisać na nowo w Ustawieniach. Ciąg zmienia się co ćwierć, a Stop zatrzymuje statek. Ruch boczny przesuwa łódź w bok nawet na postoju. Dopalacz działa tylko z zamontowanym dopalaczem. Kamera przełącza między czterema widokami.", false],
		[1, "", "Autopilot otwiera listę celów: bieżący cel misji, lokalny dok, lokalną bramę S.T.R.E.A.M. lub dowolną stację na mapie. Użycie sterów, ciągu lub broni oddaje ci sterowanie. Zob. [[guide/navigation]].", false],
		[1, "Dokowanie", "Aby zadokować, wpłyń w strefę dokowania stacji i użyj polecenia Dokuj albo wybierz dok z listy autopilota. Dokowanie jest zablokowane, dopóki trwa starcie misji w tym obszarze. Opuszczenie stacji zawsze bezpłatnie przywraca pełny kadłub, osłonę i pancerz.", false],
		[1, "Menu stacji", "Stacja po zadokowaniu oferuje sześć usług:", false],
		[1, "", "Hangar: sklep z wyposażeniem, salon statków, warsztat do wytwarzania towarów i podgląd twojego statku.", true],
		[1, "", "Misje: dziennik bieżących celów i tablica zleceń stacji.", true],
		[1, "", "Mapa: mapa stacji do planowania tras i sprawdzania, gdzie żyją gatunki.", true],
		[1, "", "Handel: rynek, na którym kupuje się i sprzedaje ładunek.", true],
		[1, "", "Status: twój statek, ładunek, ranga pilota, medale i statystyki.", true],
		[1, "", "System: zapis gry, ustawienia, pomoc i ta encyklopedia.", true],
		[1, "", "Niektóre usługi otwierają się później w fabule. Mapa stacji staje się dostępna w [[chapter/7|rozdziale 7]], a tablica zleceń w [[chapter/9|rozdziale 9]]. Stacje [[faction/colonists|kolonistów]] nigdy nie prowadzą handlu; zob. [[guide/trading]].", false],
		[1, "Zapisywanie", "Grę można zapisać tylko w doku. Każde przybycie na stację tworzy automatyczny punkt kontrolny, a menu System oferuje trzy dodatkowe miejsca zapisu. Powrót do menu głównego ze stacji najpierw zapisuje grę. Jeśli kadłub zostanie zniszczony, gra wznawia się od ostatniego zapisu na stacji, więc podczas długich wypraw dokuj regularnie.", false],
		[1, "", "Funkcja Przenieś zapis, również w menu System, eksportuje ostatni zapis ze stacji do pliku i pozwala wczytać go na innym urządzeniu.", false],
		[1, "Pomoc", "Pomoc w menu System objaśnia każdy ekran stacji. Na morzu menu pauzy zawiera mapę, dziennik misji, stan statku, medale i ustawienia. M.A.I. komentuje raz każdą nową sytuację, na przykład pierwszą bramę czy pierwsze zanurzenie poza bezpiecznym pasem głębokości. Te podpowiedzi można wyłączyć w ustawieniach rozgrywki.", false],
		[1, "", "Zanim wyruszysz daleko, przeczytaj stronę [[guide/depth]], a o pierwszych zarobkach przeczytasz na stronie [[guide/fishing]].", false],
	],
	"guide/combat": [
		[1, "Broń", "Działa dzielą się na dwie rodziny. Broń pociskowa, na przykład [[equipment/0]], [[equipment/6]] i [[equipment/9]], wystrzeliwuje serie pocisków. Broń promieniowa, czyli działa magnetyczne od modelu [[equipment/3]] wzwyż, trafia mocno i z dużej odległości, ale wolno się ładuje. Można zamontować kilka dział, a strzelają one razem ze stanowisk rozmieszczonych na dziobie.", false],
		[1, "", "Torpedy samonaprowadzające, od modelu [[equipment/12]] po model [[equipment/14]], przez półtorej sekundy płyną prosto, a potem skręcają w stronę najbliższego żywego celu w promieniu około 150 m. Można zamontować tylko jedną wyrzutnię torped. Strona każdej broni podaje obrażenia, zasięg i odstęp między strzałami.", false],
		[1, "Strzelanie", "Działa i torpedy tworzą jeden zestaw broni, a harpun drugi. Ogień używa wybranego zestawu, a Zestaw broni przełącza między nimi. Na myszy lewy przycisk strzela z dział, a prawy harpunem; na padzie prawy spust strzela z dział, a lewy harpunem.", false],
		[1, "", "Autoogień utrzymuje ogień z wybranego zestawu, dopóki go nie wyłączysz. Wyłącza też autopilota.", false],
		[1, "Ochrona", "Ostrzał najpierw wyczerpuje osłonę, potem pancerz, a na końcu kadłub. Gdy kadłub spadnie do zera, statek przepada, a gra wznawia się od ostatniego zapisu na stacji.", false],
		[1, "", "Osłony z pasywnym ładowaniem regenerują się na morzu. Pancerz nie, a kadłub regeneruje się tylko z systemem [[equipment/43]]. Opuszczenie stacji przywraca wszystkie trzy. Dopalacz, taki jak [[equipment/39]], daje krótki zryw prędkości, by zbliżyć się do wroga lub oderwać, a potem potrzebuje czasu na naładowanie.", false],
		[1, "Wrogowie", "Zwykłymi wrogami są [[faction/pirates]]. Ich kadłuby stają się wytrzymalsze, a działa silniejsze wraz ze wzrostem twojej rangi pilota i postępami fabuły. Od [[chapter/12|rozdziału 12]] w pobliżu stacji może czekać do trzech piratów.", false],
		[1, "", "Starcia misji mają własnych przeciwników: poszukiwane statki, bandy strzegące unieruchomionego statku, eskorty konwojów i pola minowe. Zob. [[guide/contracts]].", false],
		[10, "", "Akwarianie atakują kapsuły transportowe kolonistów. Walczą własną bronią, a po zniszczeniu nie zostawiają wraku.", false],
		[1, "Nagrody i łupy", "Każdy pirat zniszczony podczas wyprawy podnosi nagrodę wypłacaną przy następnym dokowaniu. Nagroda to liczba piratów podniesiona do kwadratu, pomnożona przez 100 kredytów na stacji kolonistów lub przez 50 na stacji rebeliantów. Czterech piratów w jednej wyprawie daje 1600 kredytów na stacji kolonistów.", false],
		[1, "", "Zniszczone statki zostawiają wrak z ładunkiem do wyłowienia harpunem. Zestrzelenia liczą się do medalu [[medal/4]], piraci do medalu [[medal/14]], a wiele zestrzeleń w jednej wyprawie do medalu [[medal/9]].", false],
		[1, "", "Nie strzelaj w pobliżu ryb, które chcesz złowić: zranione stworzenie ucieka, a zdobycz na harpunie przepada po trafieniu.", false],
	],
	"guide/contracts": [
		[1, "Tablica zleceń", "Od [[chapter/9|rozdziału 9]] usługa Misje na każdej stacji ma tablicę z jednym do ośmiu kontraktów. Każdy podaje zleceniodawcę, kaucję płaconą przy przyjęciu i wynagrodzenie wypłacane po sukcesie. Obok celu fabularnego można mieć naraz jeden kontrakt. Kaucja nie jest zwracana, więc porzucenie lub niewykonanie kontraktu oznacza jej utratę.", false],
		[1, "Rodzaje kontraktów", "Istnieje piętnaście rodzajów kontraktów:", false],
		[1, "", "[[contract/0]]: zniszcz jeden wzmocniony statek czekający w pobliżu stacji docelowej.", true],
		[1, "", "[[contract/1]] i [[contract/2]]: unieruchom statek płynący z bandą piratów, a potem trafiaj go harpunem, zanim ucieknie.", true],
		[1, "", "[[contract/3]]: zniszcz wszystkich członków bandy piratów.", true],
		[1, "", "[[contract/4]]: chroń konwój frachtowców przed napastnikami; utrata całego konwoju oznacza porażkę.", true],
		[1, "", "[[contract/5]]: zniszcz frachtowce strzeżonego konwoju.", true],
		[1, "", "[[contract/6]]: chroń ławicę stworzeń przed myśliwymi; zbyt duże straty oznaczają porażkę.", true],
		[1, "", "[[contract/7]]: złów lub zabij określoną liczbę osobników jednego gatunku.", true],
		[1, "", "[[contract/8]]: przewieź pasażera na inną stację, czasem z limitem przystanków po drodze.", true],
		[1, "", "[[contract/9]]: zniszcz unoszące się szczątki w ciągu około dwóch i pół minuty.", true],
		[1, "", "[[contract/10]]: zniszcz strzeżone pole minowe.", true],
		[1, "", "[[contract/11]]: broń kapsuł transportowych podczas startu.", true],
		[1, "", "[[contract/12]]: zniszcz kapsuły transportowe. Występuje tylko w fabule, nigdy na tablicy zleceń.", true],
		[1, "", "[[contract/13]] i [[contract/14]]: dostarcz określoną ilość produktu lub jednego gatunku na stację, która wystawiła zlecenie.", true],
		[1, "Kto co wystawia", "Stacje [[faction/colonists|kolonistów]] nigdy nie wystawiają kontraktów typu [[contract/6]], [[contract/12]], [[contract/13]] ani [[contract/14]]. Stacje [[faction/rebels|rebeliantów]] nigdy nie wystawiają kontraktów typu [[contract/4]], [[contract/5]], [[contract/7]], [[contract/11]] ani [[contract/12]], a po ukończeniu fabuły przestają wystawiać kontrakty typu [[contract/6]]. Kontraktów dostawczych nigdy nie wystawia dwadzieścia jeden stacji otwierających tabelę stacji gry, od stacji [[station/0]] do stacji [[station/20]].", false],
		[1, "Cele i wynagrodzenie", "Większość kontraktów prowadzi na inną stację, zwykle w twoim pasie głębokości i w odległości, która rośnie wraz z postępami fabuły. Wynagrodzenie zaczyna się od 3500 kredytów i rośnie z trudnością i odległością. Kontrakty typu [[contract/9]] płacą mniej, a eskorty, obrona ryb i obrona kapsuł więcej. Pasażer, który zgadza się na mniej przystanków, płaci dodatkowo. Kontrakty dostawcze wymagają połowy zwykłej kaucji.", false],
		[1, "", "Trudność rośnie wraz z twoją rangą pilota. Ranga rośnie, gdy łowisz stworzenia, niszczysz wrogów, wytwarzasz towary i wykonujesz kontrakty, więc lepiej płatne zlecenia oznaczają też twardszych przeciwników.", false],
		[1, "Wykonywanie kontraktu", "Po dotarciu do obszaru docelowego zaczyna się starcie. Opcja celu w autopilocie prowadzi do jego punktów nawigacyjnych. Dokowanie i brama pozostają zablokowane do rozstrzygnięcia starcia, a porażka kończy kontrakt. Dostawy są rozliczane, gdy zadokujesz z towarem.", false],
		[1, "", "Każdy wykonany kontrakt liczy się do medalu [[medal/12]].", false],
	],
	"guide/depth": [
		[1, "Głębokość w DEEP", "Każda stacja znajduje się na stałej głębokości, podanej na jej stronie razem z poziomem techniki. Większość leży między 15 000 a 30 000 m. Najwyżej, na 13 500 m, leży stacja [[station/28]], a najgłębiej, na 32 250 m, stacja [[station/81]]. Ocean nie ma dna, które przerwałoby zanurzanie: łódź może schodzić tak głęboko, jak wytrzyma jej kadłub.", false],
		[1, "Bezpieczny pas", "Statek jest bezpieczny tylko w pasie głębokości wyznaczonym przez dwa elementy wyposażenia. Osłona wyznacza płytką granicę, czyli najwyższy poziom, na jaki statek może się wznieść. Pancerz wyznacza głęboką granicę, czyli najniższy poziom, na jaki może zejść. Bez obu tych elementów pas obejmuje tylko zakres od 22 000 do 23 000 m.", false],
		[1, "", "Statek [[ship/0]] zaczyna z osłoną [[equipment/18]] o granicy 20 000 m i pancerzem [[equipment/22]] o granicy 25 000 m, więc jego pas obejmuje zakres od 20 000 do 25 000 m. Lepsze osłony pozwalają wznieść się wyżej, a lepszy pancerz zejść głębiej. Strona każdego elementu wyposażenia podaje jego granicę, a strona każdej stacji mówi, jaka granica pozwala do niej dotrzeć. Można zamontować tylko jedną osłonę i jeden pancerz.", false],
		[1, "Poza pasem", "Przekroczenie granicy włącza ostrzeżenie. Po pięciu sekundach poza pasem statek otrzymuje obrażenia kilka razy na sekundę. Zbyt głęboko ciśnienie wyczerpuje osłonę, zbyt wysoko pancerz. Gdy ta warstwa się wyczerpie, obrażenia trafiają prosto w kadłub.", false],
		[1, "", "Początkowo każde trafienie jest słabe. Rośnie o jeden punkt na każde 2000 m poniżej 30 000 m lub powyżej 15 000 m, więc skrajne głębokości szybko niszczą statek.", false],
		[1, "", "Pięć sekund zwłoki pozwala na krótkie wypady, na przykład w pogoni za zdobyczą lub przy mijaniu stacji. Przyspieszenie czasu jest ograniczone do 2×, gdy statek jest poza swoim pasem.", false],
		[1, "Regeneracja", "Osłony z pasywnym ładowaniem regenerują się tylko wtedy, gdy statek jest poniżej ich płytkiej granicy. Pancerz nie odnawia się na morzu, a kadłub regeneruje się tylko z systemem [[equipment/43]]. Wszystkie trzy są przywracane, gdy statek opuszcza stację.", false],
		[1, "Planowanie podróży", "Autopilot i S.T.R.E.A.M. zabiorą cię na stację poza twoim pasem, po ostrzeżeniu, ale przybycie kosztuje część ochrony. Kontrakty z tablicy zwykle wskazują stacje w twoim pasie, choć nie zawsze. Przed przyjęciem zlecenia sprawdź głębokość celu i w razie potrzeby zmień wyposażenie; zob. [[guide/fitting]].", false],
		[1, "Rekordy głębokości", "Gra zapisuje najwyższy i najniższy osiągnięty punkt. Medal [[medal/21]] nagradza wzniesienie się powyżej 15 000, 12 000 i 10 000 m, a inny medal nagradza zanurzenie poniżej 30 000, 32 000 i 35 000 m. Zob. [[guide/medals]].", false],
	],
	"guide/fishing": [
		[1, "Harpun", "Do połowu służy harpun, który tworzy osobny zestaw broni, niezależny od dział. Każdy pilot zaczyna z harpunem [[equipment/15]]; lepsze są harpuny [[equipment/16]] i [[equipment/17]]. Harpun ma trzy parametry: zasięg, tolerancję chwytu (jak blisko celu musi przejść strzał, by go zahaczyć) i spowolnienie (jak mocno paraliżuje zdobycz). Można zamontować tylko jeden harpun.", false],
		[1, "", "Harpun wystrzeliwuje się osobnym przyciskiem: prawym przyciskiem myszy lub lewym spustem. Można też wybrać zestaw połowowy poleceniem Zestaw broni i użyć polecenia Ogień.", false],
		[1, "Wyciąganie zdobyczy", "Trafienie zahacza stworzenie, które ucieka i się szarpie. Trzymaj je przed statkiem, aż opadnie z sił. Każde stworzenie walczy co najmniej 2,1 sekundy, a silniejsze gatunki dłużej; strona każdego gatunku podaje czas walki. Harpun z większym spowolnieniem nie pozwala uciekającej zdobyczy odpłynąć daleko.", false],
		[1, "", "Zdobycz przepada, jeśli zostanie zraniona, na przykład przez twoje własne działa, albo jeśli zniknie z pola widzenia, zanim się podda. Ponowne naciśnięcie przycisku harpuna uwalnia zahaczoną zdobycz.", false],
		[1, "", "Pokonane stworzenie zostaje wciągnięte na pokład. Zajmuje w ładowni tyle miejsca, ile wynosi jego masa w tonach, a pojedynczy osobnik może ważyć o jedną czwartą więcej lub mniej niż wartość podana dla gatunku. Jeśli ładownia jest zbyt pełna, stworzenie zostaje w wodzie.", false],
		[1, "Glony", "Pięć rodzajów glonów, od gatunku [[species/17]] po gatunek [[species/13]], tkwi nieruchomo na dnie. Poddają się niemal natychmiast, co czyni je najłatwiejszą zdobyczą.", false],
		[1, "Padlina i wraki", "Stworzenie zabite ogniem z dział zostawia unoszące się w górę truchło. Wyłowione harpunem daje towar [[goods/18]] o masie około jednej trzeciej zwierzęcia.", false],
		[1, "", "Zniszczone statki zostawiają wrak z jedną do siedmiu jednostek jakiegoś ładunku. Trafienie wraku harpunem przenosi ładunek na pokład. Każdy odzyskany wrak liczy się do medalu [[medal/18]].", false],
		[1, "Sprzedaż połowu", "Na stacji [[faction/colonists|kolonistów]] cała zawartość ładowni jest skupowana po przybyciu po cenie minimalnej. Na stacji [[faction/rebels|rebeliantów]] ryby i glony można sprzedać po cenach rynkowych lub użyć jako składników w warsztacie. Zob. [[guide/trading]].", false],
		[1, "", "Moduły ładowni zwiększają jej pojemność; zob. [[guide/fitting]]. Kontrakty typu [[contract/14]] płacą za dostarczenie określonej liczby sztuk jednego gatunku, a kontrakty typu [[contract/7]] wymagają złowienia lub zabicia określonej liczby.", false],
		[1, "", "Każdy połów liczy się do medalu [[medal/5]], a wiele połowów w jednej wyprawie do medalu [[medal/10]]. Złowienie wszystkich gatunków ryb daje medal [[medal/3]], a wszystkich glonów medal [[medal/2]].", false],
	],
	"guide/fitting": [
		[1, "Gniazda", "Każdy kadłub ma stałą liczbę gniazd wyposażenia, od sześciu w statku [[ship/0]] do dziesięciu w największych kadłubach, a każdy element zajmuje jedno gniazdo. Działa i moduły ładowni można montować wielokrotnie. Każdy inny rodzaj, łącznie z wyrzutniami torped, jest ograniczony do jednego na statek.", false],
		[1, "Rodzaje wyposażenia", "Działa i torpedy: zob. [[guide/combat]].", true],
		[1, "", "Harpuny: łowią stworzenia i odzyskują ładunek z wraków; zob. [[guide/fishing]].", true],
		[1, "", "Osłony: pochłaniają obrażenia jako pierwsze i wyznaczają płytką granicę głębokości. Niektóre ładują się na morzu.", true],
		[1, "", "Pancerz: pochłania obrażenia po osłonie i wyznacza głęboką granicę głębokości; zob. [[guide/depth]].", true],
		[1, "", "Moduły ładowni: dodają procent bazowej pojemności ładowni kadłuba. Ich działanie się sumuje.", true],
		[1, "", "Silniki: zwiększają zasięg S.T.R.E.A.M. o swoją wartość procentową.", true],
		[1, "", "Układy sterowania: przyspieszają skręty statku.", true],
		[1, "", "Radary: czujniki statku.", true],
		[1, "", "Dopalacze: zryw dodatkowej prędkości na kilka sekund, po którym następuje ładowanie.", true],
		[1, "", "System naprawczy: [[equipment/43]] powoli naprawia kadłub na morzu.", true],
		[1, "Kupno i sprzedaż", "Sklep stacji oferuje od dwóch do pięciu elementów, losowanych według rzadkości; rzadsze elementy pojawiają się częściej wraz z postępami fabuły. Ceny spadają z poziomem techniki: stacja o poziomie 10 sprzedaje po dolnej granicy zakresu cen danego elementu, a stacja o poziomie 1 blisko górnej.", false],
		[1, "", "Wyposażenie odsprzedaje się o jedną piątą taniej niż cena w sklepie stacji. Elementy, które miały już właściciela, również są sprzedawane o jedną piątą taniej. Modułu ładowni nie można sprzedać, jeśli ładownia nie pomieściłaby wtedy swojej zawartości.", false],
		[1, "", "Dwie stacje są wyjątkowe. Stacja [[station/28]] sprzedaje każdy element wyposażenia, a stacja [[station/81]] każdy kadłub, ale żadna osłona ani żaden pancerz nie pozwalają bezpiecznie dotrzeć na ich głębokość.", false],
		[1, "Naprawy", "Za naprawy się nie płaci. Kadłub, osłona i pancerz są przywracane do pełna za każdym razem, gdy statek opuszcza stację.", false],
		[1, "Kupno statku", "Salon statków oferuje do trzech kadłubów, a większe kadłuby pojawiają się dopiero wraz z postępami fabuły. Poziom techniki stacji obniża cenę kadłuba o tyle samo procent. Obecny statek jest przyjmowany w rozliczeniu za cztery piąte ceny katalogowej.", false],
		[1, "", "Całe wyposażenie i ładunek przechodzą na nowy kadłub, więc musi on mieć dość gniazd i miejsca w ładowni. Stocznie rebeliantów sprzedają każdy kadłub w ulepszonej wersji. Statek [[ship/10]] ma ogromną cenę katalogową, ale po zdobyciu wszystkich medali kosztuje 50 000 kredytów; zob. [[guide/medals]].", false],
	],
	"guide/help": [
		[1, "", "Okrętem podwodnym można sterować za pomocą klawiatury i myszy, pada lub ekranu dotykowego, a wszystkie trzy sposoby da się łączyć. Poniżej podano klawisze domyślne; każdy klawisz sterowania statkiem można zmienić w Ustawienia › Sterowanie › Przypisanie klawiszy, a Ustawienia › Sterowanie › Opis sterowania w każdej chwili pokazuje bieżący zestaw.", false],
		[1, "Klawiatura i mysz", "Ruch myszy obraca statek i pochyla jego dziób, a kamera podąża za nim. W i S zwiększają i zmniejszają ciąg o jedną czwartą naraz; A i D przesuwają statek w bok (albo go obracają, jeśli tak wybrano w ustawieniach sterowania), a strzałki pochylają dziób w górę i w dół. Przytrzymaj Alt lub Ctrl, aby rozglądać się myszą bez zmiany kursu.", false],
		[1, "", "Lewy przycisk myszy: ogień z dział.", true],
		[1, "", "Prawy przycisk myszy: strzał z harpuna.", true],
		[1, "", "Spacja: ogień wybraną grupą broni; Tab przełącza między grupą bojową a połowową.", true],
		[1, "", "Q: włączenie lub wyłączenie autoognia.", true],
		[1, "", "Shift: dopalacz, jeśli jest zamontowany.", true],
		[1, "", "E: dokowanie na stacji przed statkiem albo wejście do [[world/stream|S.T.R.E.A.M.]] przy bramie.", true],
		[1, "", "R: krótkie naciśnięcie otwiera menu autopilota, przytrzymanie kieruje statek prosto do bieżącego celu.", true],
		[1, "", "T: przyspieszenie czasu; szybsze stopnie są dostępne, gdy steruje autopilot, a w pobliżu nie ma zagrożeń.", true],
		[1, "", "M: mapa. C: zmiana kamery. L: reflektory (wymagają ustawienia „Rozszerzone oświetlenie”).", true],
		[1, "", "Esc: pauza lub powrót z dowolnego menu. F5 zapisuje grę podczas postoju w doku; F11 przełącza tryb pełnoekranowy.", true],
		[1, "", "W Ustawienia › Sterowanie › Sterowanie można sprawić, by kółko myszy zmieniało ciąg skokowo; wtedy S natychmiast zatrzymuje statek.", false],
		[1, "Pad", "Domyślnie sterują obie gałki: lewa przesuwa statek w bok lub go obraca i pochyla, prawa obraca i pochyla. Każdej osi gałek można przypisać inną funkcję, w tym ciąg lub kamerę, w Ustawienia › Sterowanie › Pad, gdzie ustawia się też odwrócenie pochylenia, wibracje i martwą strefę.", false],
		[1, "", "D-pad w górę i w dół: ciąg. A: ogień wybraną grupą broni. RT: działa. LT: harpun. Wciśnięcie lewej gałki: dopalacz.", true],
		[1, "", "X: zmiana grupy broni. Y: dokowanie lub wejście do S.T.R.E.A.M. LB: menu autopilota. RB: przyspieszenie czasu.", true],
		[1, "", "View: mapa. D-pad w lewo: krótkie naciśnięcie zmienia kamerę, przytrzymanie pozwala rozglądać się prawą gałką. D-pad w prawo: reflektory.", true],
		[1, "", "Start lub B: pauza. W menu A wybiera, a B cofa.", true],
		[1, "Ekran dotykowy", "Sterowanie dotykowe włącza się samo po dotknięciu ekranu; można je też włączyć lub wyłączyć w Ustawienia › Sterowanie › Sterowanie dotykowe. Pod lewym kciukiem pojawia się gałka sterowania, a przeciąganie palcem w dowolnym innym miejscu pozwala się rozglądać. Duży przycisk DZIAŁA strzela, dopóki jest przytrzymany, a wzdłuż jego krawędzi biegnie skala ciągu: przesuń palec po łuku, aby ustawić prędkość. W Ustawienia › Sterowanie › Sterowanie dotykowe › Ciąg można zamiast tego ustawić osobny pionowy suwak nad przyciskiem. HAK strzela harpunem, DOPALACZ uruchamia dopalacz, a przycisk DOKUJ pulsuje, gdy można zadokować. Dwukrotne dotknięcie przycisku DZIAŁA lub HAK włącza autoogień, a kolejne dotknięcie go wyłącza.", false],
		[1, "", "Przyciski CZAS, TRASA (autopilot), MAPA i PAUZA znajdują się przy krawędziach ekranu; kamera i pełny ekran są dostępne w menu pauzy. Każdy przycisk można przesunąć i zmienić jego rozmiar za pomocą opcji „Dostosuj układ sterowania”, a statkiem można też sterować, przechylając urządzenie.", false],
		[1, "Ekrany stacji", "Dokowanie automatycznie zapisuje grę i otwiera główny ekran stacji, który pokazuje, czy stacja należy do kolonistów, czy do rebeliantów, a także jej poziom techniki i kredyty pilota. Strzałki lub D-pad przenoszą między przyciskami, Enter lub A otwiera wybrany, a Esc lub B cofa. WYPŁYŃ wyprowadza statek z powrotem do wody.", false],
		[1, "", "Hangar: sklep z wyposażeniem (kupno i montaż albo sprzedaż zamontowanych elementów), salon statków z obracanym modelem każdego kadłuba i ceną, za jaką zostanie przyjęty obecny, warsztat do wytwarzania towarów na stacjach rebeliantów oraz przegląd statku i jego ładunku. Zob. [[guide/fitting]].", true],
		[1, "", "Misje: bieżące cele i dziennik, a gdy zostanie otwarta, także tablica kontraktów. Kontrakt wymaga kaucji, która przepada, jeśli się go porzuci. Zob. [[guide/contracts]].", true],
		[1, "", "Mapa: mapa stacji z wyszukiwaniem, widokiem głębokości z boku i przyciskami do ustawienia autopilota lub zaplanowania transferu S.T.R.E.A.M. Zob. [[guide/navigation]].", true],
		[1, "", "Handel: kupno i sprzedaż towarów; handlują tylko stacje rebeliantów. Zob. [[guide/trading]].", true],
		[1, "", "Status: statek, statystyki pilota i medale. Zob. [[guide/medals]].", true],
		[1, "", "System: trzy sloty zapisu, ustawienia, pomoc, ten przewodnik, przenoszenie zapisu, wczytanie punktu kontrolnego stacji i menu główne.", true],
	],
	"guide/medals": [
		[1, "Zdobywanie medali", "Medale odnotowują osiągnięcia pilota. Większość ma stopnie: brązowy, srebrny i złoty; pozostałe przyznaje się jednorazowo. Postępy są sprawdzane przy każdym dokowaniu, a nowe medale ogłasza się na stacji. Raz zdobytego medalu nie można stracić, a wyższy stopień zastępuje niższy. Twój profil w menu Status pokazuje dotąd zdobyte medale.", false],
		[1, "Medale za karierę", "Te medale liczą postępy z całej kariery (brąz, srebro, złoto):", false],
		[1, "", "[[medal/4]]: zniszczeni wrogowie, 50, 200 i 400.", true],
		[1, "", "[[medal/5]]: złowione stworzenia, 50, 150 i 300.", true],
		[1, "", "[[medal/6]]: stacje, na których zadokowano, 50, 100 i 200.", true],
		[1, "", "[[medal/8]]: wytworzone towary, 50, 250 i 500.", true],
		[1, "", "[[medal/12]]: wykonane kontrakty, 10, 25 i 50.", true],
		[1, "", "[[medal/13]]: przybycia do obszaru nowej stacji, 50, 150 i 300.", true],
		[1, "", "[[medal/14]]: zniszczeni piraci, 25, 150 i 350.", true],
		[1, "", "[[medal/18]]: odzyskane wraki, 25, 150 i 350.", true],
		[1, "", "[[medal/19]]: kredyty posiadane jednocześnie, 125 000, 500 000 i 1 000 000.", true],
		[1, "", "[[medal/20]]: kupione nowe elementy wyposażenia, 5, 10 i 20.", true],
		[1, "", "[[medal/11]]: godziny gry, 5, 7 i 10.", true],
		[1, "", "[[medal/21]]: najwyżej osiągnięty punkt, 15 000, 12 000 i 10 000 m.", true],
		[1, "Medale za jedną wyprawę", "Te medale oceniają pojedynczą wyprawę, od opuszczenia jednej stacji do zadokowania na następnej:", false],
		[1, "", "[[medal/9]]: zestrzelenia w jednej wyprawie, 5, 10 i 15.", true],
		[1, "", "[[medal/10]]: połowy w jednej wyprawie, 5, 10 i 15.", true],
		[1, "", "[[medal/1]]: dokowanie z kadłubem poniżej 30%, 15% i 5%.", true],
		[1, "", "[[medal/16]]: liczba zamontowanych broni przy dokowaniu, 3, 5 i 8.", true],
		[1, "", "[[medal/15]]: dokowanie bez zamontowanych dział. Początkowe rozdziały się nie liczą.", true],
		[1, "Wyróżnienia", "[[medal/0]]: przyznawany po przybyciu do kolonii.", true],
		[1, "", "[[medal/3]] i [[medal/2]]: złów każdy gatunek ryby i każdy rodzaj glonów co najmniej raz.", true],
		[1, "", "[[medal/7]]: wytwórz każdy produkt co najmniej raz.", true],
		[1, "", "[[medal/17]]: ukończ fabułę.", true],
		[1, "", "Istnieją jeszcze dwa medale. Jeden nagradza zanurzenie poniżej 30 000, 32 000 i 35 000 m. Drugi otrzymuje się za posiadanie wszystkich pozostałych medali, a pełny komplet obniża też cenę statku [[ship/10]] do 50 000 kredytów. Zob. [[guide/depth]] i [[guide/fitting]].", false],
	],
	"guide/navigation": [
		[1, "Mapa", "Dwieście stacji leży na kwadratowej mapie. [[chart]] w tej encyklopedii pokazuje każdą z nich w kolorze jej właściciela. W grze usługa Mapa na stacji i mapa na morzu pokazują tę samą mapę wraz z ostatnią trasą, celami misji i stacjami w zasięgu S.T.R.E.A.M. Strona każdej stacji podaje jej najbliższych sąsiadów wraz z odległością na mapie i głębokością.", false],
		[1, "Autopilot", "Autopilot steruje statkiem za ciebie. Jego lista oferuje bieżący cel misji, dokowanie na lokalnej stacji, lokalną bramę S.T.R.E.A.M. albo dowolną stację wybraną na mapie. Na długich dystansach płynie przez otwarte wody, omija stacje na swojej drodze i przechodzi z obszaru jednej stacji do następnego.", false],
		[1, "", "Każde użycie sterów, ciągu, dopalacza lub broni przywraca sterowanie ręczne, podobnie jak polecenie Wyłącz autopilota na liście. Włączenie autoognia również wyłącza autopilota.", false],
		[1, "", "Przyspieszenie czasu wynosi 1× lub 2× przy sterowaniu ręcznym i do 16× z autopilotem. Zagrożenie obniża je z powrotem do 2×: wrogi statek w promieniu około 550 m, zdobycz na harpunie lub opuszczenie bezpiecznego pasa głębokości. Wraca też do 1× po wejściu w obszar nowej stacji.", false],
		[1, "Bramy S.T.R.E.A.M.", "Każda stacja ma bramę S.T.R.E.A.M. w pewnej odległości. Wpłyń w strefę aktywacji bramy i użyj polecenia Dokuj, aby otworzyć mapę bramy z listą wszystkich stacji w zasięgu. Wybierz jedną i rozpocznij tranzyt. Brama się otwiera, a statek wypływa przy bramie stacji docelowej z niezmienionymi uszkodzeniami.", false],
		[1, "", "Brama sięga na około jedną szóstą szerokości mapy od bieżącej stacji. Silnik zwiększa ten zasięg o swoją wartość: silnik z oceną +30% sięga o 30% dalej. Do stacji poza zasięgiem trzeba dotrzeć w kilku skokach albo długim rejsem z autopilotem.", false],
		[1, "", "Dopóki trwa starcie misji w danym obszarze, nie można użyć ani bramy, ani doku stacji.", false],
		[1, "Przybycie", "Wejście w obszar stacji rozpoczyna każde czekające tam starcie misji. Opcja celu w autopilocie prowadzi do punktów nawigacyjnych starcia, a dokowanie odblokowuje się po jego rozstrzygnięciu. Zob. [[guide/contracts]].", false],
		[1, "", "Poza tym w wodach wokół stacji żyją miejscowe zwierzęta i krążą statki patrolowe. Od [[chapter/12|rozdziału 12]] może tam czyhać kilku piratów, tym częściej, im dalej w fabule. Zob. [[guide/combat]].", false],
		[1, "", "Każde przybycie w obszar nowej stacji liczy się do medalu [[medal/13]], a każde pierwsze dokowanie na danej stacji do medalu [[medal/6]].", false],
	],
	"guide/tips": [
		[1, "", "Krótkie rady dotyczące podróży, walki i zarabiania, zebrane na potrzeby tego przewodnika.", false],
		[1, "W rejsie", "Przytrzymanie klawisza autopilota (R) prowadzi statek prosto do bieżącego celu; krótkie naciśnięcie proponuje inne cele, na przykład najbliższą bramę S.T.R.E.A.M. lub stację wybraną na mapie.", true],
		[1, "", "Pod kontrolą autopilota czas można przyspieszyć znacznie bardziej niż przy sterowaniu ręcznym, o ile w pobliżu nie ma wroga.", true],
		[1, "", "Każde użycie sterów, ciągu lub broni odbiera kontrolę autopilotowi.", true],
		[1, "", "Dopalacz działa tylko wtedy, gdy jest zamontowany, i po każdym użyciu potrzebuje czasu na naładowanie.", true],
		[1, "", "Mapa oznacza stacje leżące poza zakresem głębokości kadłuba; mocniejszy kadłub lub osłona otwiera do nich dostęp. Zob. [[guide/depth]].", true],
		[1, "", "Swobodne rozglądanie się (Alt lub Ctrl z myszą albo przytrzymanie D-pada w lewo) pozwala sprawdzić, co jest za statkiem, bez zmiany kursu.", true],
		[1, "Walka i połów", "Działa i harpun mają osobne przyciski, więc rybę można zahaczyć w samym środku walki.", true],
		[1, "", "Autoogień podtrzymuje ostrzał z wybranej broni, gdy obie ręce są zajęte sterowaniem; wyłącza się po otwarciu menu.", true],
		[1, "", "Opcja „Stopklatka” w menu pauzy zatrzymuje scenę, aby można było swobodnie krążyć wokół niej kamerą.", true],
		[1, "Handel i pieniądze", "Rynek i warsztat mają tylko stacje rebeliantów; stacje kolonistów nadal sprzedają wyposażenie.", true],
		[1, "", "Warsztat zamienia ładunek w produkty; zanim wyprodukujesz całą ładownię, porównaj przedział cen receptury z rynkiem.", true],
		[1, "", "Nowy statek jest tańszy, niż się wydaje: obecny zostaje przyjęty w rozliczeniu.", true],
		[1, "", "Porzucenie kontraktu oznacza utratę kaucji, więc najpierw sprawdź jego głębokość i odległość.", true],
		[1, "Zapis", "Dokowanie zapisuje grę automatycznie, a ekran System ma jeszcze trzy sloty. F5 zapisuje grę podczas postoju w doku.", true],
		[1, "", "Opcja „Wczytaj punkt kontrolny stacji” przywraca stan z ostatniego dokowania, jeśli zanurzenie pójdzie źle.", true],
		[1, "", "Reflektory wymagają ustawienia „Rozszerzone oświetlenie”; gdy jest włączone, L je włącza i wyłącza.", true],
	],
	"guide/trading": [
		[1, "Gdzie odbywa się handel", "Rynek i warsztat mają tylko stacje [[faction/rebels|rebeliantów]]. Stacje [[faction/colonists|kolonistów]] skupują po przybyciu całą zawartość ładowni, każdą pozycję po cenie minimalnej, i niczego nie sprzedają. Na początku fabuły wszystkie stacje należą do kolonistów, więc dopóki nie otworzą się rynki, jedynym dochodem jest połów po stałych cenach. Zob. [[guide/allegiance]].", false],
		[1, "Ceny", "Każdy towar ma zakres cen, stację macierzystą i najlepszy rynek; wszystko to podaje jego strona. Na stacji macierzystej towar sprzedaje się po cenie minimalnej. Im dalej od stacji macierzystej leży stacja na mapie, tym wyższa cena, aż do pułapu w odległości najlepszego rynku i dalej.", false],
		[1, "", "Trzy towary importowane działają odwrotnie: [[goods/33]], [[goods/34]] i [[goods/35]] są najtańsze na swoim najlepszym rynku i drożeją, im dalej się od niego oddalasz. Rynki rebeliantów uzupełniają ich zapasy między wizytami.", false],
		[1, "", "Rynek kupuje i sprzedaje po tej samej cenie, po jednej jednostce naraz. Zysk daje przewożenie towarów między stacjami, a nie sama lada.", false],
		[1, "Co jest na rynkach", "Rynek oferuje do czterech produktów. Każdy musi mieścić się w poziomie techniki stacji, a produkty pojawiają się częściej w pobliżu swojej stacji macierzystej. Między wizytami półki nieco pustoszeją. Trzy ostatnio odwiedzone stacje zachowują swój asortyment; gdzie indziej półki są losowane na nowo po powrocie.", false],
		[1, "Produkcja", "Warsztat w hangarze przerabia składniki z ładowni na produkty. Stacja może wytwarzać każdy produkt do swojego poziomu techniki włącznie. Lista receptur pokazuje, ile sztuk każdego produktu można wykonać z zawartości ładowni, a strona każdego produktu podaje jego składniki. Na przykład jeden produkt [[goods/21]] wymaga jednej sztuki gatunku [[species/4]] i jednej sztuki gatunku [[species/17]].", false],
		[1, "", "Wytwarzanie towarów liczy się do medalu [[medal/8]], a wykonanie każdego produktu co najmniej raz daje medal [[medal/7]].", false],
		[1, "Jak zarabiać", "Kilka sposobów na zarobek:", false],
		[1, "", "Kupuj produkty na ich stacji macierzystej lub w jej pobliżu i wieź je w stronę ich najlepszego rynku.", true],
		[1, "", "Ryby i glony kosztują tylko czas. Przerobienie ich na produkty może być warte więcej niż sprzedaż surowca.", true],
		[1, "", "Nie dokuj na stacji kolonistów z cennym ładunkiem: wszystko na pokładzie zostanie skupione po cenie minimalnej.", true],
		[1, "", "Odzyskuj ładunek pozostawiony przez zniszczone statki i sprzedawaj go.", true],
		[1, "", "Kontrakty typu [[contract/13]] i [[contract/14]] płacą za dostarczenie produktu lub połowu na stację, która je wystawiła.", true],
		[1, "", "Poziom techniki stacji obniża też ceny wyposażenia i statków; zob. [[guide/fitting]].", false],
	],
	"home": [
		[1, "", "Witaj w encyklopedii DEEP, podwodnej przygody na skolonizowanym oceanicznym świecie. Znajdziesz tu dwieście głębinowych stacji, statki i wyposażenie do kupienia, stworzenia żyjące w wodzie, towary, którymi handluje się między rynkami, oferowane kontrakty i medale do zdobycia.", false],
		[1, "", "Strony fabularne odsłaniają się w miarę gry. Rozdziały, postacie i późniejsze wydarzenia pozostają ukryte, dopóki twój zapis do nich nie dotrze, więc możesz przeglądać encyklopedię bez obawy o spoilery. Nazwy i liczby pochodzą z twojej własnej kopii gry; przeglądy i poradniki napisano specjalnie dla tej encyklopedii.", false],
		[1, "", "Nowi piloci powinni zacząć od stron [[world/ocean]] i [[guide/basics]]. [[chart]] pokazuje wszystkie stacje i to, kto je kontroluje. Poradniki objaśniają po jednym aspekcie życia pod powierzchnią, na przykład: [[guide/depth]], [[guide/navigation]], [[guide/trading]] i [[guide/combat]].", false],
	],
	"intro/characters": [
		[1, "", "Te strony opisują postacie występujące w fabule: pilota, komputer pokładowy, sojuszników i wrogów spotkanych po drodze oraz głosy słyszane przez radio. Każda biografia podąża za kampanią po kolei i rozrasta się w miarę gry, pokazując tylko to, czego twój pilot już się dowiedział.", false],
		[1, "", "Niektórzy rozmówcy nie mają własnych imion. Nazwy ról, takie jak [[character/6]], [[character/7]] i [[character/10]], obejmują wiele pomniejszych głosów każdej frakcji, a ich strony wyjaśniają, kto się pod nimi wypowiada. Fabułę jako całość opisuje strona [[world/history]].", false],
	],
	"intro/contracts": [
		[1, "", "Piętnaście rodzajów zleceń, które może oferować stacja. Strona każdego rodzaju podaje cel, stronę, która go wystawia, ewentualne ograniczenia i rozdziały fabuły oparte na tym samym rodzaju misji. O kaucjach, wynagrodzeniu i o tym, jak trudność rośnie z rangą: [[guide/contracts]]. Kontrakty pojawiają się na tablicy zleceń od [[chapter/9|rozdziału 9]].", false],
	],
	"intro/equipment": [
		[1, "", "Całe wyposażenie, które można zamontować na statku: broń, torpedy, harpuny, osłony, pancerze, moduły ładowni, silniki, układy sterowania, radary, dopalacze i systemy naprawcze. Strona każdego elementu podaje jego parametry, rzadkość w sklepach, informację, czy można zamontować więcej niż jeden, oraz cenę na każdym poziomie techniki. Zob. [[guide/fitting]] i [[guide/combat]].", false],
	],
	"intro/factions": [
		[1, "", "Siły rządzące oceanem: [[faction/colonists]], [[faction/rebels]] i [[faction/pirates]]. Strona każdej frakcji wyjaśnia, jak wpływa ona na rozgrywkę, na przykład na handel, kontrakty i nagrody, oraz wymienia jej stacje i występy w fabule do twojego bieżącego rozdziału. O zmianie strony przez stacje: [[guide/allegiance]].", false],
	],
	"intro/goods": [
		[1, "", "Wszystko, co można przewozić w ładowni: połów, produkty, towary importowane i odzyskany ładunek. Strona każdego towaru podaje jego poziom techniki, stację macierzystą, najlepszy rynek i zakres cen, recepturę lub zastosowanie oraz ewentualne szczególne zasady. Jak działają ceny i jak zarabiać: [[guide/trading]].", false],
	],
	"intro/guide": [
		[1, "", "Praktyczne poradniki do gry w DEEP. Zacznij od strony [[guide/basics]], a potem przeczytaj kolejne: [[guide/depth]], [[guide/navigation]], [[guide/fishing]], [[guide/trading]], [[guide/combat]], [[guide/fitting]], [[guide/contracts]], [[guide/allegiance]] i [[guide/medals]]. Każdy poradnik prostym językiem objaśnia jeden aspekt życia pod powierzchnią, podaje liczby, których używa sama gra, i zawiera odnośniki do wspomnianych stacji, wyposażenia i medali. Szczegóły fabuły pozostają ukryte, dopóki twój zapis do nich nie dotrze.", false],
	],
	"intro/medals": [
		[1, "", "Medale, które może zdobyć pilot. Strona każdego medalu opisuje, za co jest przyznawany, a w przypadku medali stopniowanych, czego wymaga brąz, srebro i złoto. Kiedy medale są sprawdzane i które oceniają pojedynczą wyprawę: [[guide/medals]]. Medale są sprawdzane przy każdym dokowaniu, a pełny komplet przynosi osobną nagrodę.", false],
	],
	"intro/ships": [
		[1, "", "Wszystkie kadłuby łodzi podwodnych w grze, od początkowego statku [[ship/0]] po statek [[ship/10]]. Strona każdego statku podaje wytrzymałość kadłuba, pojemność ładowni, gniazda wyposażenia, sterowność i cenę katalogową, moment, od którego oferują go stocznie, oraz tabelę porównawczą wszystkich kadłubów. O kupnie statku i oddaniu starego w rozliczeniu: [[guide/fitting]].", false],
	],
	"intro/species": [
		[1, "", "Stworzenia i glony oceanu. Strona każdego gatunku podaje jego masę, wytrzymałość, czas walki na harpunie, zakres cen i stacje, w pobliżu których występuje, a także produkty i kontrakty, w których jest wykorzystywany. Jak je łowić: [[guide/fishing]].", false],
	],
	"intro/stations": [
		[1, "", "Dwieście stacji oceanu w kolejności alfabetycznej. Strona każdej stacji podaje jej poziom techniki, głębokość i położenie na mapie, stronę, do której należy, wyposażenie potrzebne do dotarcia na jej głębokość, gatunki żyjące w pobliżu, towary, dla których jest stacją macierzystą lub najlepszym rynkiem, jej rolę w fabule i najbliższych sąsiadów. [[chart]] pokazuje je wszystkie naraz.", false],
	],
	"intro/story": [
		[1, "", "Fabuła kampanii obejmuje 48 rozdziałów, od pierwszego połowu pilota. Ciągłe streszczenie fabuły, podzielone na akty, znajdziesz na stronie [[world/history]]. Rozrasta się ono w miarę gry i nigdy nie wykracza poza rozdział, do którego dotarł twój zapis.", false],
		[1, "", "Każdy rozdział ma też własną stronę ze streszczeniem misji, a gdy przejdziesz dalej, także z jej wynikiem. Zakończenie rozdziału pojawia się dopiero wtedy, gdy dotrzesz do następnego, więc te strony nigdy nie zdradzają więcej, niż już rozegrałeś.", false],
	],
	"intro/world": [
		[1, "", "Informacje o świecie gry DEEP. [[world/ocean]] opisuje samo miejsce akcji: głębokości i ciśnienie, światło i faunę. [[world/colony]] wyjaśnia, jak zarządza się stacjami, jak działają handel i kontrakty i kto pilnuje porządku. [[world/stream]] omawia bramy łączące stacje, a [[world/history]] opowiada historię do miejsca, do którego dotarłeś.", false],
		[1, "", "Te strony rozrastają się w miarę postępów twojego zapisu. Późniejsze wydarzenia, nowe postacie i tajemnice głębin pojawiają się dopiero wtedy, gdy do nich dotrzesz, a kolejne artykuły otwierają się, gdy fabuła odsłania ich tematy.", false],
	],
	"medal/0": [
		[1, "", "Każdy pilot otrzymuje ten medal po przybyciu na planetę. Nie wymaga żadnego wysiłku i po prostu oznacza początek kariery.", false],
	],
	"medal/1": [
		[1, "", "Przyznawany za zadokowanie z resztką kadłuba. Brąz wymaga mniej niż 30% kadłuba, srebro mniej niż 15%, a złoto mniej niż 5%. Liczy się stan kadłuba w chwili dokowania.", false],
	],
	"medal/10": [
		[1, "", "Przyznawany za wiele połowów podczas jednej wyprawy, między oddokowaniem a dokowaniem. Brąz wymaga ponad 5, srebro ponad 10, a złoto ponad 15. Pomaga duża ładownia.", false],
	],
	"medal/11": [
		[1, "", "Nagradza łączny czas gry w bieżącej karierze. Brąz przychodzi po ponad pięciu godzinach, srebro po siedmiu, a złoto po dziesięciu.", false],
	],
	"medal/12": [
		[1, "", "Liczy wykonane przez pilota kontrakty z tablic zleceń na stacjach. Brąz wymaga ponad 10, srebro ponad 25, a złoto ponad 50.", false],
	],
	"medal/13": [
		[1, "", "Liczy podróże między stacjami przez sieć S.T.R.E.A.M. Brąz wymaga ponad 50, srebro ponad 150, a złoto ponad 300.", false],
	],
	"medal/14": [
		[1, "", "Liczy piratów zniszczonych w ciągu kariery. Brąz wymaga ponad 25, srebro ponad 150, a złoto ponad 350.", false],
	],
	"medal/15": [
		[1, "", "Przyznawany za ukończenie wyprawy bez zamontowanych dział i torped. Harpuny nie liczą się jako broń. Rozdziały szkoleniowe się nie liczą.", false],
	],
	"medal/16": [
		[1, "", "Przyznawany za zadokowanie z wieloma zamontowanymi naraz działami i torpedami. Brąz wymaga co najmniej 3, srebro co najmniej 5, a złoto co najmniej 8, co wymaga kadłuba z dużą liczbą gniazd.", false],
	],
	"medal/17": [
		[1, "", "Przyznawany za ukończenie głównej fabuły. Nie da się go zdobyć w inny sposób, więc zwykle jest jednym z ostatnich medali, jakie zdobywa pilot.", false],
	],
	"medal/18": [
		[1, "", "Liczy skrzynie z ładunkiem wyłowione harpunem ze zniszczonych statków. Brąz wymaga ponad 25, srebro ponad 150, a złoto ponad 350.", false],
	],
	"medal/19": [
		[1, "", "Nagradza najwyższe osiągnięte saldo kredytów. Brąz wymaga ponad 125 000, srebro ponad 500 000, a złoto ponad 1 000 000.", false],
	],
	"medal/2": [
		[1, "", "Przyznawany za złowienie co najmniej jednej sztuki każdego z pięciu gatunków glonów. Glony tkwią nieruchomo na dnie, więc to jedno z łatwiejszych wyróżnień.", false],
	],
	"medal/20": [
		[1, "", "Liczy nowe elementy wyposażenia kupione w sklepach. Brąz wymaga ponad 5, srebro ponad 10, a złoto ponad 20.", false],
	],
	"medal/21": [
		[1, "", "Nagradza najpłytszą osiągniętą głębokość. Brąz wymaga wzniesienia się powyżej 15 000 m, srebro powyżej 12 000 m, a złoto powyżej 10 000 m. Dwa wyższe stopnie leżą poza granicą każdej osłony.", false],
	],
	"medal/22": [
		[1, "", "Nagradza najgłębsze zanurzenie. Brąz wymaga 30 000 m, srebro 32 000 m, a złoto 35 000 m. Dwa wyższe stopnie leżą poza granicą każdego pancerza.", false],
	],
	"medal/23": [
		[1, "", "Przyznawany po zdobyciu wszystkich pozostałych medali, w dowolnym stopniu. Jego posiadanie pozwala pilotowi kupić statek [[ship/10]] za ułamek ceny katalogowej.", false],
	],
	"medal/3": [
		[1, "", "Przyznawany za złowienie co najmniej jednego osobnika każdego gatunku pływających stworzeń. W wodach każdej stacji żyje inny zestaw gatunków, więc trzeba łowić w wielu miejscach.", false],
	],
	"medal/4": [
		[1, "", "Liczy wszystkich wrogów zniszczonych w ciągu kariery. Brąz wymaga ponad 50, srebro ponad 200, a złoto ponad 400.", false],
	],
	"medal/5": [
		[1, "", "Liczy wszystkie stworzenia i glony złowione harpunem w ciągu kariery. Brąz wymaga ponad 50 połowów, srebro ponad 150, a złoto ponad 300.", false],
	],
	"medal/6": [
		[1, "", "Przyznawany za dokowanie na wielu różnych stacjach. Brąz wymaga ponad 50, srebro ponad 100, a złoto ponad 200, czyli praktycznie wszystkich stacji na mapie.", false],
	],
	"medal/7": [
		[1, "", "Przyznawany, gdy pilot wytworzy każdy produkt co najmniej raz. Niektóre receptury wymagają towarów importowanych lub innych produktów, więc pełny zestaw wymaga planowania.", false],
	],
	"medal/8": [
		[1, "", "Liczy wszystkie towary wytworzone w fabrykach stacji. Brąz wymaga ponad 50 jednostek, srebro ponad 250, a złoto ponad 500.", false],
	],
	"medal/9": [
		[1, "", "Przyznawany za zniszczenie wielu wrogów podczas jednej wyprawy, od opuszczenia jednej stacji do zadokowania na następnej. Brąz wymaga ponad 5, srebro ponad 10, a złoto ponad 15.", false],
	],
	"ship/0": [
		[1, "Przegląd", "[[ship/0]] to kadłub, od którego zaczyna każdy pilot, i najtańszy na liście, za 45 000 cr. Jest też najsłabszy niemal pod każdym względem: 75 punktów kadłuba, ładownia 25 t i sześć gniazd wyposażenia. Jego sterowność 1,10 jest przeciętna, taka sama jak w znacznie większym statku [[ship/8]].", false],
		[1, "", "Fabrycznie ma zamontowane: [[equipment/15]], [[equipment/18]], [[equipment/22]] i [[equipment/35]]. Z sześciu gniazd tylko dwa zostają wolne na broń lub moduł ładowni.", false],
		[1, "W użyciu", "Prawdziwym ograniczeniem jest mała ładownia. Wypełnia ją kilka średnich zdobyczy, a przeciętny osobnik gatunku [[species/12]] waży więcej, niż statek może unieść. Za 30 000 cr więcej [[ship/1]] oferuje 40 punktów kadłuba więcej, prawie dwa razy większą ładownię i znacznie lepszą sterowność przy tej samej liczbie gniazd, więc większość pilotów wymienia startową łódź, gdy tylko pozwolą na to oszczędności. Do tego czasu to kadłub szkoleniowy: wystarcza na pierwsze połowy i lekkie potyczki z piratami blisko domu, ale nie na długie trasy handlowe ani ciężkie walki.", false],
	],
	"ship/1": [
		[1, "Przegląd", "[[ship/1]] to solidna, przystępna cenowo łódź rybacka. W porównaniu ze statkiem [[ship/0]] zyskuje 40 punktów kadłuba, 20 t ładowni i znacznie szybsze prowadzenie: jego sterowność 1,61 ustępuje tylko statkowi [[ship/5]]. Zachowuje jednak te same sześć gniazd i to ograniczenie określa ten kadłub. Harpun, osłona, pancerz i radar zostawiają miejsce tylko na dwa działa lub moduły ładowni.", false],
		[1, "W użyciu", "Zwykłe stocznie sprzedają go od pierwszego rozdziału za 75 000 cr, co czyni go naturalnym pierwszym ulepszeniem dla pilota, który głównie łowi i wykonuje krótkie zlecenia. Przewyższa nawet droższy statek [[ship/2]] pod względem kadłuba, ładowni i sterowności, ustępując tylko jednym gniazdem. Gdy misje wymagają większej siły ognia lub większej ładowni, siódme i ósme gniazdo późniejszych kadłubów liczy się bardziej niż sama wytrzymałość i Okeanos zwykle zostaje oddany w rozliczeniu.", false],
	],
	"ship/10": [
		[1, "Przegląd", "[[ship/10]] to luksusowy okręt flagowy i najlepszy kadłub uniwersalny. Łączy 200 punktów kadłuba, ładownię 100 t, dziesięć gniazd i sterowność 1,50. Pod względem kadłuba lub ładowni przewyższa go tylko [[ship/6]], a szybciej skręcają tylko [[ship/5]], [[ship/1]] i [[ship/3]]. Jego cena katalogowa, 5 000 000 cr, jest ponad czternaście razy wyższa niż cena statku [[ship/9]].", false],
		[1, "W użyciu", "Zwykłe stocznie oferują go od [[chapter/40|rozdziału 40]]. Niewielu pilotów stać na cenę katalogową. Pilot, który ma wszystkie medale, a więc zdobył medal [[medal/23]], może zamiast tego kupić go za 50 000 cr, przed zwykłą obniżką zależną od poziomu techniki stacji. To czyni statek Aquarius raczej nagrodą za skompletowanie medali niż praktycznym zakupem. Gdy staje się dostępny, duża część kampanii jest już za pilotem.", false],
	],
	"ship/2": [
		[1, "Przegląd", "[[ship/2]] to najtańszy kadłub z siedmioma gniazdami wyposażenia, za 100 000 cr. Jego wytrzymałość i ładownia (100 punktów i 40 t) są w rzeczywistości niższe niż w statku [[ship/1]], a sterowność 1,40 jest dobra, ale nie wybitna. Za dodatkowe pieniądze kupuje się siódme gniazdo, które może pomieścić drugie działo lub moduł ładowni.", false],
		[1, "W użyciu", "Jest w sprzedaży od pierwszego rozdziału, więc pilot, który wcześnie zaoszczędzi, może przejść na siedem gniazd na długo przed pojawieniem się czegoś lepszego. Jednak od [[chapter/5|rozdziału 5]] statek [[ship/3]] oferuje ten sam kadłub i liczbę gniazd, a do tego 6 t ładowni więcej i lepszą sterowność, za jedyne 5000 cr więcej. Od tego momentu Triops opłaca się głównie wtedy, gdy akurat jest w ofercie w pobliżu, a alternatywa nie. Pasuje pilotowi, który chce wcześnie walczyć z piratami, bo wolne gniazdo może pomieścić drugą broń.", false],
	],
	"ship/3": [
		[1, "Przegląd", "[[ship/3]] udoskonala siedmiogniazdowy układ statku [[ship/2]]. Za dopłatą zaledwie 5000 cr dodaje 6 t ładowni i podnosi sterowność z 1,40 do 1,57, co czyni go jednym z najzwrotniejszych kadłubów w grze. Jego 100 punktów kadłuba to nic szczególnego, więc większość ochrony zapewniają osłony i pancerz.", false],
		[1, "W użyciu", "Zwykłe stocznie zaczynają go oferować od [[chapter/5|rozdziału 5]]. Pasuje pilotowi, który chce walczyć i łowić z tej samej łodzi bez dużego wydatku, i pozostaje rozsądnym wyborem do pojawienia się kadłubów z ośmioma gniazdami. W porównaniu ze statkiem [[ship/4]], kolejnym kadłubem w ofercie, ma 75 punktów kadłuba i 24 t ładowni mniej, ale w zamian znacznie szybciej skręca i kosztuje o 25 000 cr mniej.", false],
	],
	"ship/4": [
		[1, "Przegląd", "[[ship/4]] to ciężki frachtowiec w miniaturze. Za 130 000 cr daje 175 punktów kadłuba, ładownię 70 t i osiem gniazd, co czyni go najtańszym kadłubem z ośmioma gniazdami. Ceną jest prowadzenie: jego sterowność 0,91 jest niższa niż w którymkolwiek wcześniejszym statku, a wolniej skręca tylko [[ship/6]].", false],
		[1, "W użyciu", "Pojawia się w zwykłych stoczniach od [[chapter/10|rozdziału 10]]. Najwięcej zyskują na nim handlarze i rybacy. Duża bazowa ładownia zwiększa też skuteczność modułów ładowni, bo ich premia to procent pojemności bazowej. Moduł sterowania łagodzi część ociężałości. Piloci nastawieni głównie na walkę mogą woleć statek [[ship/5]], który kosztuje 20 000 cr więcej i skręca dokładnie dwa razy szybciej, ale ma ledwie połowę wytrzymałości kadłuba.", false],
	],
	"ship/5": [
		[1, "Przegląd", "[[ship/5]] to myśliwiec do walki manewrowej. Jego sterowność 1,82 jest najlepsza spośród wszystkich kadłubów, dzięki czemu może trzymać się za przeciwnikiem i utrzymywać cel na celowniku. Ochronę ma jednak słabą: kadłub o 90 punktach jest słabszy niż w statku [[ship/1]], a ładownia 40 t skromna. Osiem gniazd zostawia dużo miejsca na broń.", false],
		[1, "W użyciu", "Zwykłe stocznie oferują go od [[chapter/15|rozdziału 15]] za 150 000 cr. Nagradza pilotów, którzy potrafią unikać trafień, najlepiej wspieranych mocną osłoną i pancerzem, a do przewozu towarów nadaje się słabo. Wszystkie zamontowane działa strzelają razem, więc wolne gniazda bezpośrednio przekładają się na siłę ognia. Pilot, który chce wytrzymalszego kadłuba z ośmioma gniazdami, powinien porównać go ze statkiem [[ship/4]] lub poczekać na statek [[ship/6]].", false],
	],
	"ship/6": [
		[1, "Przegląd", "[[ship/6]] to wielki masowiec. Jego ładownia 180 t znacznie przewyższa każdy inny kadłub i jest prawie dwa razy większa niż w statku [[ship/10]], a 220 punktów kadłuba to najwyższa wartość w grze. Za 170 000 cr jest też tańszy niż [[ship/7]] i każdy późniejszy kadłub. Wadą jest prowadzenie: przy sterowności 0,67 skręca wolniej niż jakikolwiek inny statek.", false],
		[1, "W użyciu", "Trafia do zwykłych stoczni od [[chapter/20|rozdziału 20]]. Do handlu i dużych wypraw połowowych nie ma sobie równych. Moduły ładowni liczą się od pojemności bazowej, więc jeden moduł +80% dodaje 144 t. W walce polega na przyjmowaniu obrażeń, a nie na ich unikaniu, a moduł sterowania jest niemal niezbędny przeciw zwinnym piratom. Mając tylko osiem gniazd, ma też mniej miejsca na działa niż kolejne kadłuby.", false],
	],
	"ship/7": [
		[1, "Przegląd", "[[ship/7]] to pierwszy kadłub z dziewięcioma gniazdami. Pozostałe parametry są przeciętne: 135 punktów kadłuba, ładownia 50 t i sterowność 1,23, lepsza niż w statku [[ship/0]], ale znacznie gorsza niż w statku [[ship/5]]. Za 215 000 cr kosztuje wyraźnie więcej niż [[ship/6]], więc cena w większości pokrywa dodatkowe gniazdo.", false],
		[1, "W użyciu", "Pojawia się w zwykłych stoczniach od [[chapter/25|rozdziału 25]]. Pasuje pilotowi, który chce o jedno działo lub moduł więcej, niż pozwala kadłub z ośmioma gniazdami, bez płacenia za kolejne statki z dziesięcioma gniazdami. Jako statek uniwersalny jest solidny, ale w żadnej dziedzinie nie wybitny. [[ship/8]], pięć rozdziałów później, dodaje dziesiąte gniazdo, 15 punktów kadłuba i 16 t ładowni za kolejne 85 000 cr.", false],
	],
	"ship/8": [
		[1, "Przegląd", "[[ship/8]] to pierwszy kadłub z dziesięcioma gniazdami. Ma 150 punktów kadłuba i ładownię 66 t, a steruje się nim jak statkiem [[ship/0]], przy sterowności 1,10. Za 300 000 cr kosztuje o 85 000 cr więcej niż [[ship/7]] w zamian za jedno gniazdo więcej i skromne zyski w kadłubie i ładowni.", false],
		[1, "W użyciu", "Zwykłe stocznie mają go w ofercie od [[chapter/30|rozdziału 30]]. Z dziesięcioma gniazdami pilot może zamontować pełny zestaw obronny, harpun i radar, a mimo to dołożyć kilka dział lub moduł ładowni. Prowadzenie jest tylko przeciętne, więc w bliskiej walce przydaje się moduł sterowania. [[ship/9]], który pojawia się pięć rozdziałów później, rezygnuje z 6 t ładowni na rzecz 15 punktów kadłuba i lepszej sterowności. Pontos pozostaje tańszym z nich i lepszym wyborem, gdy liczy się ładunek.", false],
	],
	"ship/9": [
		[1, "Przegląd", "[[ship/9]] to wysokiej klasy kadłub z dziesięcioma gniazdami. W porównaniu ze statkiem [[ship/8]] dodaje 15 punktów kadłuba i wyraźnie lepszą sterowność (1,36 wobec 1,10), ale traci 6 t ładowni. Za 350 000 cr kosztuje o 50 000 cr więcej.", false],
		[1, "W użyciu", "Zwykłe stocznie oferują go od [[chapter/35|rozdziału 35]]. Najlepiej pasuje pilotowi nastawionemu na walkę w późnej fazie kampanii, który więcej zyskuje na dziesięciu gniazdach i dobrym prowadzeniu niż na pojemności ładowni. Do handlu hurtowego [[ship/6]] przewozi trzy razy więcej za połowę ceny. Jedynym kadłubem, który pod większością względów przewyższa statek Lir, jest [[ship/10]], którego cena katalogowa jest zupełnie inną ligą.", false],
	],
	"species/0": [
		[1, "Przegląd", "[[species/0]] wzorowany jest na łodzikach, głowonogach z muszlą żyjących w tropikalnym Indo-Pacyfiku. Łodzik mieszka w zewnętrznej komorze spiralnej muszli i reguluje pływalność, zmieniając ilość gazu i płynu w komorach wewnętrznych. Pływa napędem odrzutowym, a pokarm chwyta dziesiątkami ramion pozbawionych przyssawek. Łodziki zwykle przebywają kilkaset metrów pod powierzchnią, a muszla może implodować, jeśli zejdą znacznie głębiej niż na około 800 m.", false],
		[1, "W grze", "W grze waży około 8 t i prawie nie stawia oporu na harpunie: obezwładnienie go zajmuje tylko 2,1 s. To jedna z najłatwiejszych zdobyczy, ale jej cena, od 44 do 156 cr za tonę, jest niska. Żyje w wodach 67 stacji.", false],
		[7, "", "W [[chapter/7|rozdziale 7]] pilot musi usunąć te zwierzęta z wód wokół stacji [[station/1]], łowiąc je lub zabijając.", false],
	],
	"species/1": [
		[1, "Przegląd", "[[species/1]] wywodzi się od gardzielca (Eurypharynx pelecanoides), ryby głębinowej występującej mniej więcej od 500 do 3000 m. Jego luźno osadzona paszcza jest ogromna w porównaniu z wąskim, biczowatym ciałem i może otworzyć się na tyle szeroko, by połknąć zaskakująco dużą zdobycz. Ogon kończy się małym narządem świetlnym. Dorosłe osobniki mierzą zwykle znacznie mniej niż metr.", false],
		[1, "W grze", "W grze to szybki pływak, który walczy z harpunem około 4 s, dwa razy dłużej niż [[species/0]] o tej samej masie 8 t. Wysiłek się opłaca: przy cenie od 70 do 255 cr za tonę to jedna z lepiej płatnych zdobyczy. Fabryki używają go do wyrobu produktów [[goods/24]] i [[goods/27]], obu cennych. Harpun z silnym spowolnieniem znacznie ułatwia jego złowienie.", false],
	],
	"species/10": [
		[1, "Przegląd", "[[species/10]] czerpie z kałamarnic i ośmiornic, głowonogów słynących ze zmiany barwy w ułamku sekundy. Ich skóra zawiera tysiące komórek barwnikowych zwanych chromatoforami, z których każdą otwierają lub zamykają drobne mięśnie, a także komórki odblaskowe dodające połysku. Wiele z nich ma też worek atramentowy; atrament mątwy był niegdyś źródłem brązowego barwnika sepii.", false],
		[1, "W grze", "W grze waży około 14 t, ma wytrzymałość 28 i walczy na lince około 3,4 s. Ceny surowca wynoszą od 59 do 164 cr za tonę. W połączeniu z rozpuszczalnikiem daje produkt [[goods/22]], potrzebny do wyrobu produktu [[goods/29]].", false],
		[19, "", "W [[chapter/19|rozdziale 19]] pilot musi chronić ich ławicę w pobliżu stacji [[station/7]] przed atakującymi statkami.", false],
	],
	"species/11": [
		[1, "Przegląd", "„Loricate” oznacza „pokryty płytami ochronnymi”, a [[species/11]] przywodzi na myśl żółwie morskie. Żyje dziś siedem gatunków. Ich skorupy składają się z płyt kostnych zrośniętych z kręgosłupem i żebrami. Największy jest żółw skórzasty, ze skorupą długości do około 2 m, który w poszukiwaniu meduz potrafi nurkować na ponad 1000 m. Samice wracają na plaże, by złożyć jaja.", false],
		[1, "W grze", "W grze waży około 8 t i poddaje się na harpunie po około 2,7 s. Jego cena jest niezwykle zmienna, od 40 do 244 cr za tonę, więc warto go sprzedawać tam, gdzie popyt jest wysoki. Żadna receptura fabryczna go nie używa.", false],
	],
	"species/12": [
		[1, "Przegląd", "[[species/12]] opiera się na zębowcach, grupie obejmującej kaszaloty, delfiny i morświny. Zdobycz znajdują dzięki echolokacji: wysyłają kliknięcia i nasłuchują ech. Kaszalot to największy uzębiony drapieżnik na Ziemi. Nurkuje na głębokość 1000 m lub więcej, by polować na kałamarnice, i może pozostawać pod wodą ponad godzinę.", false],
		[1, "W grze", "W grze to najcięższe stworzenie, około 30 t, o wytrzymałości 60. Jeden okaz może zapełnić małą ładownię, a przeciętny osobnik nie zmieści się w ładowni 25 t statku [[ship/0]]. Walczy tylko około 2,9 s. Ceny są bardzo zróżnicowane, od 22 do 200 cr za tonę, a żadna receptura go nie używa.", false],
	],
	"species/13": [
		[1, "Przegląd", "[[species/13]] przywodzi na myśl złotowiciowce (Chrysophyceae) i pokrewne złotobrązowe grupy. Ich barwa pochodzi od barwnika fukoksantyny, który maskuje chlorofil. Większość jest mikroskopijna i żyje w wodach słodkich, a niektóre powodują zakwity; jeden gatunek, Prymnesium parvum, wydziela toksyny, które mogą zabijać ryby.", false],
		[1, "W grze", "W grze, jak wszystkie glony, jest przytwierdzony do dna, waży stałe 2 t i daje się obezwładnić w 2,1 s. To najcenniejszy z pięciu rodzajów glonów, sprzedawany po 27 do 65 cr za tonę. Służy do wyrobu produktów [[goods/27]] i [[goods/28]].", false],
	],
	"species/14": [
		[1, "Przegląd", "[[species/14]] nawiązuje do sinic, czyli cyjanobakterii. Ściśle biorąc, nie są to glony, lecz bakterie fotosyntetyzujące. Należą do najstarszych znanych form życia i pomogły wypełnić ziemską atmosferę tlenem. Niektóre wiążą azot z powietrza, a niektóre potrafią uwalniać wodór, dlatego naukowcy badają je jako źródło czystego paliwa.", false],
		[1, "W grze", "W grze rośnie na dnie, waży 2 t i stawia niewielki opór. Sprzedaje się po 21 do 47 cr za tonę. Nieprzypadkowo łączy się go z towarem [[goods/18]], by wytworzyć produkt [[goods/19]], i jest jednym z pięciu rodzajów glonów potrzebnych do wyrobu produktu [[goods/28]].", false],
	],
	"species/15": [
		[1, "Przegląd", "[[species/15]] przedstawia brunatnice (Phaeophyceae), do których należą listownice. Gigantyczny kelp może wyrastać na dziesiątki metrów i tworzy podwodne lasy, w których schronienie znajduje wiele innych gatunków. Brunatnice są handlowym źródłem alginianów, używanych do zagęszczania żywności i w medycynie.", false],
		[1, "W grze", "W grze to najtańsza ze wszystkich zdobyczy, od 14 do 47 cr za tonę. Podobnie jak inne glony tkwi nieruchomo na dnie, waży 2 t i daje się obezwładnić w 2,1 s. Służy jedynie do wyrobu produktu [[goods/28]], który wymaga wszystkich pięciu rodzajów glonów.", false],
	],
	"species/16": [
		[1, "Przegląd", "[[species/16]] odnosi się do krasnorostów (Rhodophyta). Czerwony barwnik, fikoerytryna, pozwala im pochłaniać niebieskie światło, które przenika najgłębiej w morze, dzięki czemu rosną głębiej niż jakiekolwiek inne wodorosty. Z krasnorostów pozyskuje się agar i karagen, a nori, w które zawija się sushi, to także krasnorost.", false],
		[1, "W grze", "W grze to drugi pod względem wartości rodzaj glonów, warty od 27 do 62 cr za tonę. Tkwi na dnie, waży 2 t i łatwo go złowić harpunem. Razem z gatunkiem [[species/13]] trafia do produktu [[goods/27]], a jest też potrzebny do wyrobu produktu [[goods/28]].", false],
	],
	"species/17": [
		[1, "Przegląd", "[[species/17]] oznacza zielenice, najbliższych krewnych roślin lądowych. Znanym przybrzeżnym przykładem jest sałata morska (Ulva). Niektóre zielone wodorosty się jada; w Japonii suszone płatki zwane aonori posypuje się na potrawy. Zielenice potrzebują dużo światła, więc większość rośnie w płytkiej wodzie.", false],
		[1, "W grze", "W grze to mało cenna zdobycz, od 20 do 44 cr za tonę. Podobnie jak inne glony jest przytwierdzony do dna, waży 2 t i daje się obezwładnić w 2,1 s. Fabryki łączą go z gatunkiem [[species/4]], by wytworzyć produkt [[goods/21]], i jest jednym z pięciu rodzajów glonów w produkcie [[goods/28]].", false],
	],
	"species/2": [
		[1, "Przegląd", "[[species/2]] przedstawia meduzy, swobodnie pływające stadium wielu parzydełkowców. Meduza nie ma mózgu, kości ani krwi, a jej parasol to w większości woda. Porusza się, kurcząc parasol, i dryfuje z prądem, chwytając drobną zdobycz czułkami uzbrojonymi w komórki parzydełkowe. Niektóre gatunki świecą, a kilka form głębinowych jest czerwonych lub fioletowych.", false],
		[1, "W grze", "Przy masie około 2 t to jedno z najlżejszych stworzeń w grze, a wytrzymałość 4 oznacza, że może je zabić jeden zabłąkany strzał. Na harpunie poddaje się po około 2,5 s. Ceny wynoszą od 40 do 133 cr za tonę. W produkcji służy jedynie jako jeden z trzech składników produktu [[goods/26]].", false],
	],
	"species/3": [
		[1, "Przegląd", "[[species/3]] opiera się na mantach, największych płaszczkach świata. Większe gatunki oceaniczne mogą mieć około 7 m rozpiętości płetw. Manty to łagodne filtratory: pływają z otwartym pyskiem i dwoma mięsistymi płatami przed pyskiem kierują plankton do środka. Mają jeden z największych mózgów w stosunku do masy ciała spośród wszystkich ryb.", false],
		[1, "W grze", "W grze waży około 16 t i ma wytrzymałość 32, więc lepiej niż mniejsze zwierzęta znosi przypadkowy ostrzał. Na lince walczy około 3,6 s. Ceny surowca, od 65 do 182 cr za tonę, są umiarkowane, ale to stworzenie jest potrzebne do wyrobu produktu [[goods/20]], który z kolei trafia do produktu [[goods/29]].", false],
	],
	"species/4": [
		[1, "Przegląd", "[[species/4]] oznacza gęste ławice tworzone przez małe ryby, takie jak sardynki, sardele i śledzie. Ławica dezorientuje drapieżniki, którym trudno wybrać pojedynczy cel, a może też oszczędzać energię, bo ryby płyną w swoim śladzie. Takie ławice są podstawą wielu morskich łańcuchów pokarmowych i największych łowisk świata.", false],
		[1, "W grze", "W grze ławicę łowi się jako jeden ładunek 4 t. To niewymagająca zdobycz: harpun obezwładnia ją w około 2,5 s, a jej wytrzymałość wynosi tylko 8. Ceny wahają się od 53 do 138 cr za tonę. Jest składnikiem produktów [[goods/21]] i [[goods/26]], więc pilot, który łowi także gatunek [[species/17]] lub [[species/2]], ma gotowy łańcuch dostaw.", false],
	],
	"species/5": [
		[1, "Przegląd", "[[species/5]] nawiązuje do żabnicokształtnych, a zwłaszcza do gatunków głębinowych. Przekształcony kolec na głowie tworzy wędkę z przynętą na końcu. U wielu form głębinowych przynęta świeci światłem wytwarzanym przez symbiotyczne bakterie i zwabia zdobycz w pobliże szerokiego pyska. U niektórych gatunków maleńkie samce trwale zrastają się ze znacznie większymi samicami.", false],
		[1, "W grze", "W grze waży około 10 t i poddaje się na harpunie po około 2,5 s, więc łowi się go dość szybko. Rozpiętość cen, od 53 do 216 cr za tonę, jest duża. Razem z gatunkiem [[species/1]] i rozpuszczalnikiem jest potrzebny do wyrobu produktu [[goods/24]], ważnego składnika kilku cennych produktów.", false],
	],
	"species/6": [
		[1, "Przegląd", "„Diabeł morski” to stara nazwa żeglarska. Na przestrzeni wieków stosowano ją do mant z rodzaju Mobula, dużych ośmiornic, a nawet do pływacza szarego. Gra nie wiąże gatunku [[species/6]] z żadnym z tych zwierząt. Łączą je rozmiary i groźna reputacja, która rzadko odpowiada ich faktycznemu zachowaniu.", false],
		[1, "W grze", "W grze to ciężka zdobycz, około 20 t, o wytrzymałości 40. Walczy z harpunem około 4,2 s, najdłużej spośród stworzeń. Osiąga też najwyższy pułap cenowy spośród wszystkich stworzeń, do 364 cr za tonę. Fabryki łączą go z gatunkiem [[species/8]] i solą, by wytworzyć produkt [[goods/25]].", false],
	],
	"species/7": [
		[1, "Przegląd", "[[species/7]] opiera się na marlinach, dużych rybach z rostrum, żyjących na ciepłych otwartych oceanach. Marlin rozcina ławice zdobyczy włóczniowatym rostrum i należy do najszybszych ryb w morzu. Największe marliny błękitne przekraczają 4 m długości i kilkaset kilogramów masy. Wędkarze sportowi cenią je za długą, akrobatyczną walkę.", false],
		[1, "W grze", "W grze jest lekki, około 8 t, ale trudny do złowienia: pływa szybko i opiera się harpunowi około 4,2 s. Ułatwia to harpun o dużym zasięgu i silnym spowolnieniu. W zamian dobrze trzyma wartość, sprzedając się po 104 do 283 cr za tonę, co oznacza najwyższą cenę minimalną spośród stworzeń. Jest głównym składnikiem produktu [[goods/23]].", false],
	],
	"species/8": [
		[1, "Przegląd", "„Kościsty rekin” to dawna nazwa długoszpara, drugiej co do wielkości żyjącej ryby po rekinie wielorybim. Długoszpary mogą osiągać około 8 m lub więcej. Mimo rozmiarów są nieszkodliwymi filtratorami, które powoli pływają przy powierzchni z ogromnym otwartym pyskiem i odcedzają plankton. Migrują na duże odległości i często spędzają zimę w głębszych wodach.", false],
		[1, "W grze", "W grze [[species/8]] waży około 18 t i ma wytrzymałość 36. Walczy z harpunem około 3,8 s. Ceny wynoszą od 78 do 208 cr za tonę. To jedna z bardziej przydatnych zdobyczy w produkcji, bo trafia zarówno do produktu [[goods/25]], jak i [[goods/26]].", false],
	],
	"species/9": [
		[1, "Przegląd", "Żadne prawdziwe zwierzę nie nazywa się krewetką goliatem, ale prawdziwe olbrzymy istnieją. Krewetka tygrysia olbrzymia może dorastać do około 30 cm, a niektóre skorupiaki głębinowe są większe od swoich płytkowodnych krewnych, co nazywa się gigantyzmem głębinowym. Wiele krewetek głębinowych jest czerwonych, przez co są niemal niewidoczne w wodzie, do której nie dociera czerwone światło.", false],
		[1, "W grze", "W grze [[species/9]] to mała zdobycz, 2 t, o wytrzymałości 4, szybko obezwładniana w około 2,3 s. Ceny wahają się od 39 do 122 cr za tonę. Żadna receptura fabryczna jej nie używa, więc łowi się ją wyłącznie na sprzedaż. Kontrakty połowowe wymagają jej częściej niż rzadszych stworzeń, takich jak [[species/0]].", false],
	],
	"world/abel": [
		[31, "", "[[world/abel]] to naukowiec współpracujący z [[faction/rebels|ruchem oporu]]. Nigdy nie pojawia się na ekranie, ale jego badania są sercem planu, który obmyśla [[character/2]]: zbudowania broni zdolnej odwrócić losy wojny z kolonią.", false],
		[31, "Przeszłość", "Profesor przez wiele lat badał [[world/biotek|generator Biotek]], źródło energii, którego nikomu nie udało się zbudować. Był bliski ukończenia działającego prototypu, gdy ukradli go koloniści, którzy teraz próbują sami go dokończyć.", false],
		[31, "Rola w fabule", "[[character/2]] sprowadza jego i jego zespół na stację [[station/14]], by zbudowali nową broń rebeliantów. To najwyraźniej ci sami naukowcy, których konwój pilot ochraniał w drodze na stację ([[chapter/29]]). [[character/2]] od razu wyrusza na spotkanie z profesorem, a pilot i pozostali odbijają generator ([[chapter/30]]).", false],
		[33, "", "Po rajdzie profesor zabiera odzyskane kontenery do swojego laboratorium, by kontynuować prace nad prototypem ([[chapter/32]]).", false],
		[39, "", "Prace szybko postępują. Wkrótce prototyp jest prawie gotowy i brakuje tylko jednej części: to [[goods/36]], który powiela DNA cząstek glonów, by zapoczątkować reakcję łańcuchową wytwarzającą energię. [[character/2]] przekazuje jego wyjaśnienia, przyznając, że sama nie do końca je rozumie. Urządzenie można wytworzyć tylko na stacji [[station/16]] ([[chapter/38]]).", false],
		[42, "", "Gdy inkubator dociera na stację [[station/14]], profesor ma wszystko gotowe do jego zamontowania, a gotowa broń ma się wkrótce pojawić w hangarze. Ponieważ generator jest wciąż prototypem, pilot zostaje ostrzeżony, by obchodził się z nim ostrożnie ([[chapter/41]]).", false],
		[44, "", "Działo [[world/eclipse|Eclipse]] zasilane jego generatorem okazuje się rozstrzygające, gdy koloniści atakują stację [[station/14]].", false],
		[31, "Charakter", "Wszystko, co o nim wiadomo, pochodzi od [[character/2]] i [[character/5]]. Opisywany jest jako oddany swojej pracy badacz.", false],
		[39, "", "Jego wyjaśnienia są na tyle techniczne, że nawet [[character/2]] ma kłopot z ich powtórzeniem.", false],
	],
	"world/aquarians": [
		[10, "", "Akwarianie to istoty z głębin oceanu, podobno pół ludzie, pół ryby. Nazwa Akwarianie pochodzi od kolonistów, a kolonia uważa ich za szkodniki. Znani są głównie z ataków na kapsuły transportowe, które wynoszą eksport kolonii na orbitę. To, kim są i czego chcą, to jedno z pytań, na które fabuła powoli odpowiada.", false],
		[10, "Natura", "Początkowo o Akwarianach wiadomo niewiele. Żyją na otwartych wodach i poruszają się raczej jak morskie zwierzęta niż maszyny, a jednak walczą własną bronią. Koloniści traktują ich jak niebezpieczne zwierzęta i nigdy nie pytają, dlaczego atakują.", false],
		[11, "", "Po pierwszej walce pilota z nimi [[character/1]] zastanawia się, czy nie są znacznie inteligentniejsi, niż ktokolwiek zakładał. Pilot również zaczyna się zastanawiać, dlaczego w ogóle biorą na cel kapsuły.", false],
		[19, "", "Kolejne spotkania sugerują, że troszczą się o faunę oceanu. Widać ich, jak płyną obok ławicy [[species/10|barwnych kałamarnic]], którą koloniści próbują złowić, jakby jej strzegli.", false],
		[45, "", "Są inteligentni i zdolni do dyplomacji. Akwariański wysłannik przybywa na stację [[station/14]] i wydaje się rozumieć trochę ludzkiej mowy.", false],
		[10, "Stosunki z kolonią", "Starty kapsuł łączą kolonię z szerszą gospodarką, a Akwarianie raz po raz w nie uderzają. Każda uszkodzona lub utracona kapsuła psuje opinię stacji w oczach władz handlowych, więc koloniści wynajmują uzbrojonych pilotów, by przepędzali napastników. Obrona kapsuł to także regularny kontrakt kolonistów; zob. [[contract/11]].", false],
		[10, "", "W [[chapter/10|rozdziale 10]] pilot zostaje wysłany na stację [[station/2]], by bronić startu kapsuł, a [[character/9]] każe mu nie dopuścić do więcej niż kilku strat.", false],
		[11, "", "Nic nie wskazuje na to, by kolonia kiedykolwiek próbowała rozmawiać z Akwarianami. Po prostu płaci za ich przepędzenie lub zabicie.", false],
		[13, "Stosunki z rebeliantami", "Potępiając wyzysk prowadzony przez kolonię, [[faction/rebels]] mówią nie tylko o zasobach planety, ale i o jej mieszkańcach. Być może mają na myśli także Akwarian, ale przez długi czas obie strony nie mają ze sobą kontaktu.", false],
		[19, "", "Rebeliantów i Akwarian łączy wspólny interes w ochronie zwierząt oceanu. Gdy pilot osłania kałamarnice w pobliżu stacji [[station/7]], [[character/1]] sugeruje, że Akwarianie mogliby zostać sojusznikami.", false],
		[44, "", "Punkt zwrotny następuje podczas ataku kolonistów na stację [[station/14]] w [[chapter/43|rozdziale 43]]. Gdy doki stacji są trafione, a obrońcy w mniejszości, przybywa grupa Akwarian i atakuje kolonistów, odwracając losy bitwy. [[character/9]] i jego siły zostają rozgromieni.", false],
		[45, "", "Po bitwie wysłannik na stacji Fiir wyjaśnia, że Akwarianie są gotowi walczyć z rządami kolonistów. [[character/2]] ma nadzieję, że po pokonaniu kolonii ludzie i Akwarianie będą mogli żyć w harmonii z oceanem. Z ich pomocą rebelianci planują dwie ostatnie ofensywy.", false],
		[45, "", "W [[chapter/45|rozdziale 45]] grupa Akwarian wynurza się z głębin, by dołączyć do pilota i eskadry, którą dowodzi [[character/12]], w szturmie na stację [[station/18]].", false],
		[47, "", "Obie ofensywy kończą się sukcesem, a dowódcy rebeliantów przypisują Akwarianom dużą część zasługi za zwycięstwo.", false],
		[48, "", "Gdy kolonii już nie ma, na końcu historii trwa sojusz rebeliantów z Akwarianami, a wraz z nim obietnica, że ocean dostanie szansę, by się odrodzić.", false],
		[45, "Otwarte pytania", "Wiele spraw dotyczących Akwarian nigdy nie zostaje wyjaśnionych. Fabuła nie mówi, gdzie żyją, ilu ich jest, jak wytwarzają i używają broni ani jak nauczyli się rozumieć ludzką mowę. Pozostawia też otwartą kwestię, dlaczego wybrali sobie na cel kapsuły kolonii, choć ich późniejszy sojusz z rebeliantami sugeruje, że uważali eksport za część grabieży ich oceanu.", false],
		[10, "W grze", "W walce Akwarianie występują jako przypominający ryby wojownicy, którzy strzelają pociskami energii. Skręcają wolniej niż łodzie podwodne i nigdy nie używają zrywów prędkości. Zniszczony Akwarianin ginie jak morskie stworzenie, w jednym rozbłysku, i nie zostawia wraku do przeszukania ani niczego do złowienia.", false],
		[10, "", "Po stronie kolonii Akwarianie są wrogami w misjach obrony kapsuł. Kierują się prosto na kapsuły, więc obrońca musi szybko ich wytropić. Misja kończy się porażką, jeśli zostanie utraconych zbyt wiele kapsuł. Zniszczenie Akwarianina liczy się jako zestrzelenie, ale nie wlicza się do nagrody za piratów.", false],
		[44, "", "W ostatnich rozdziałach walczą po stronie pilota jako sojusznicy. Na radarze widać ich jako przyjazne kontakty i atakują statki kolonistów.", false],
	],
	"world/biotek": [
		[31, "", "Generator Biotek to eksperymentalne źródło energii opracowane przez [[world/abel|profesora Abla]]. Jest kluczem do planu rebeliantów, by przewyższyć kolonistów siłą ognia. Rebelianci chcą, by zasilał broń zbyt energożerną dla jakiejkolwiek zwykłej łodzi podwodnej, a odzyskanie go to pierwszy z trzech kroków tego planu. Sam generator nigdy nie jest sprzedawany ani montowany jako wyposażenie; w grze pilot zajmuje się częściami, których on potrzebuje.", false],
		[31, "Badania i kradzież", "Technologię stojącą za generatorem badano od lat, ale nikomu nie udało się zbudować działającego prototypu. Profesor Abel był bliski ukończenia prototypu, gdy ukradli go koloniści. Teraz próbują sami go dokończyć, a rebelianci są zdecydowani do tego nie dopuścić.", false],
		[31, "", "Krótko przed ujawnieniem planu [[character/2]] zorganizowała przewiezienie grupy wybitnych naukowców na stację [[station/14]]. W [[chapter/29|rozdziale 29]] pilot bezpiecznie przeprowadził ich konwój przez strefę przygraniczną w pobliżu stacji [[station/13]].", false],
		[31, "", "Na stacji Fiir Ayumi wyjaśnia, po co są naukowcy: to zespół Abla. Razem zamienią generator w serce nowej broni.", false],
		[31, "Plan w trzech krokach", "Ayumi przedstawia plan w trzech krokach. Po pierwsze rebelianci muszą odzyskać generator. Po drugie potrzebują broni na tyle potężnej, by była godna takiego generatora. Trzeciego kroku jeszcze nie wyjaśnia.", false],
		[31, "", "Według jednego z informatorów Ayumi skradziony generator jest przewożony zwykłym konwojem kolonistów do miejsca zwanego Maarth. Ponieważ nikt nie wie, który statek go wiezie, pilot, [[character/5]] i [[character/4]] muszą zatrzymać cały konwój w pobliżu stacji [[station/2]] i wyłowić każdy kontener.", false],
		[32, "", "Rajd się udaje i wszystkie kontenery zostają odzyskane, choć załogi kolonistów protestują, że wiozą tylko żywność i leki.", false],
		[33, "", "Na stacji Fiir Abel zabiera przejęty ładunek do laboratorium, by dokończyć prototyp. Tymczasem pilot wyrusza na poszukiwanie broni na drugi krok: działa [[world/eclipse|Eclipse]].", false],
		[39, "Jak to działa", "Generator czerpie energię z materii żywej. Inkubator polimerazowy kopiuje DNA cząstek glonów, a to kopiowanie wywołuje reakcję łańcuchową uwalniającą energię. Prototyp potrzebuje jeszcze tego inkubatora, czyli produktu [[goods/36]], zanim będzie mógł działać.", false],
		[39, "", "Tylko jedna stacja ma sprzęt do jego zbudowania: [[station/16]], najbardziej zaawansowana w oceanie. Trzecim krokiem pilota jest dotarcie tam i wyprodukowanie inkubatora.", false],
		[42, "", "Gdy inkubator trafia na stację Fiir, Abel kończy instalację, a generator zasila Eclipse na statku pilota. Rebelianci ostrzegają, że to wciąż prototyp.", false],
		[44, "", "W walce się sprawdza. Gdy koloniści atakują stację Fiir, Eclipse napędzane generatorem pomaga odwrócić losy bitwy. Widok działa na łodzi podwodnej wyraźnie wstrząsa urzędnikiem, którym jest [[character/9]].", false],
		[45, "", "Gdy stacja [[station/188]] trafia w ręce rebeliantów, zaczynają oni uzbrajać jak najwięcej jednostek w to samo połączenie działa i źródła energii.", false],
		[39, "W grze", "Krok trzeci obejmuje trzy rozdziały: podróż na stację Wagoll w [[chapter/39|rozdziale 39]], wyprodukowanie tam inkubatora w [[chapter/40|rozdziale 40]] i dostarczenie go na stację Fiir w [[chapter/41|rozdziale 41]]. Jego strona towaru podaje przedział cen, ale żaden rynek nigdy nie ma go w ofercie, więc jedynym sposobem na jego zdobycie jest zbudowanie go.", false],
		[39, "", "Inkubator wytwarza się w fabryce stacji o poziomie techniki 11, co w praktyce oznacza Wagoll. Jego receptura wymaga po jednej sztuce produktów [[goods/19]], [[goods/34]], [[goods/28]] i [[goods/24]]. Te z kolei powstają z martwych ryb i glonów, z towarów importowanych, ze wszystkich pięciu gatunków glonów oraz z towaru [[goods/35]] w połączeniu z gatunkami [[species/5]] i [[species/1]]. Ich zebranie to osobny, mały łańcuch produkcji.", false],
		[39, "", "Wagoll leży na głębokości 29 850 m, głębiej, niż pozwala większość pancerzy, więc pilot potrzebuje ciężkiego pancerza, takiego jak [[equipment/25]], by bezpiecznie tam dotrzeć. Inkubator to przedmiot fabularny, którego żaden rynek nie ma w ofercie. Po wyprodukowaniu pozostaje na pokładzie, dopóki nie zostanie dostarczony na stację Fiir.", false],
	],
	"world/colony": [
		[1, "", "Kolonia to ludzka osada na oceanicznej planecie: dwieście głębinowych stacji zarządzanych przez administrację kolonialną, wraz z osadnikami, rybakami i handlarzami, którzy na nich żyją i pracują. Na początku historii każda stacja należy do frakcji [[faction/colonists]], a cel kolonii jest oczywisty. Istnieje po to, by czerpać zasoby oceanu i wywozić je z planety. Ten artykuł opisuje, jak kolonia jest zorganizowana, jak działa jej gospodarka i jak jedno i drugie zmienia się w miarę rozwoju historii.", false],
		[1, "Kolonizacja", "Osadnicy przybyli na planetę z innych miejsc i zbudowali swoje domy pod powierzchnią, gdzie stacje stoją dziś na głębokościach mniej więcej od 13 500 do 32 250 m. Stacje bardzo się od siebie różnią. Każda ma poziom techniki od 1 do 11, który decyduje o tym, co może wytwarzać jej fabryka i ile liczą sobie jej sklepy, a każda ma własne wody, faunę i sąsiadów. Niektóre to duże węzły, jak stacja [[station/0]]; inne to małe placówki znane z jednego produktu.", false],
		[1, "", "Od nowo przybyłych oczekuje się, że będą ciągnąć swoją część wózka. Pilot przybywa na planetę łowić ryby, z małą łodzią i niewielkimi pieniędzmi, i szybko się przekonuje, że praca jest ciężka i źle płatna.", false],
		[10, "", "Kolonia ma gospodarkę eksportową. Jej stacje ładują towary do kapsuł transportowych i wystrzeliwują je na orbitę, gdzie odbierają je statki towarowe. Ponad miejscowymi urzędnikami stoją władze handlowe, które oceniają stacje według tego, jak niezawodnie docierają te przesyłki.", false],
		[12, "", "Plan samego pilota jest prosty: zarobić dość na bilet z planety.", false],
		[21, "", "Rebelianci opisują kolonizację jako szybką i bezwzględną. Ich zdaniem wysysa ona ocean szybciej, niż przyroda zdąży się odrodzić, jak stało się już na innych planetach.", false],
		[1, "Administracja i stacje", "Każda stacja to małe miasto z własnymi urzędnikami i usługami. Zadokowany pilot może odwiedzić hangar, by zamontować wyposażenie, sklep i stocznię, by kupić sprzęt i kadłuby, oraz mapę. Większość stacji ma też tablicę kontraktów, a niektóre rynek i fabrykę. Statki patrolowe krążą wokół każdej stacji między jej bramami S.T.R.E.A.M. i walczą po tej stronie, która ją kontroluje.", false],
		[2, "", "W codziennych sprawach w imieniu kolonii występują jej urzędnicy. Na stacji [[station/0]] połów pilota skupuje [[character/9]], który przy okazji udziela rad, o które nikt nie prosił.", false],
		[7, "", "Ochrona stacji zajmuje się lokalnymi zagrożeniami, a urzędnicy zlecają takie zadania wolnym strzelcom. Gdy wokół stacji [[station/1]] gromadzą się łodziki, jej ochrona chce się ich pozbyć, a Jack wysyła pilota, by się tym zajął.", false],
		[9, "", "Urzędnicy oczekują, że nowicjusze zdobędą zaufanie, zanim otrzymają ważną pracę. Pilot musi najpierw wykonać kontrakty z tablicy, zanim kolonia zaproponuje coś większego. Anonimowi urzędnicy, występujący jako [[character/6]], z którymi styka się pilot, są na ogół szorstcy i płacą tak mało, jak tylko mogą.", false],
		[1, "Stałe ceny", "Stacje kolonistów nie handlują. Nie ma tam rynku ani fabryki: gdy statek dokuje, stacja po prostu zabiera wszystko z jego ładowni i płaci za każdą rzecz cenę minimalną, najniższą, jaką kiedykolwiek mogłaby osiągnąć. Dostawa, którą zamówiła sama stacja, jest rozliczana w pierwszej kolejności; cała reszta idzie po stałej stawce. Dla rybaka, który nie ma gdzie indziej sprzedawać, to cała gospodarka.", false],
		[1, "", "Dlatego rybacy kolonii pozostają biedni. Cena minimalna często wynosi mniej niż połowę tego, co ten sam połów mógłby przynieść gdzie indziej, a innego kupca nie ma.", false],
		[1, "Rynki i ceny", "Wolne rynki istnieją tylko na stacjach poza kontrolą kolonii. Tam cena towaru zależy od odległości. Każdy towar ma stację macierzystą, gdzie sprzedaje się po cenie minimalnej, oraz najlepszy rynek, gdzie osiąga cenę maksymalną. Pomiędzy nimi cena rośnie wraz z odległością na mapie od stacji macierzystej. Trzy towary importowane, [[goods/33]], [[goods/34]] i [[goods/35]], działają odwrotnie i są najtańsze na swoim najlepszym rynku. Rynek kupuje i sprzedaje po tej samej cenie, więc zysk bierze się z przewożenia towarów, a nie z targowania się. Zob. [[guide/trading]].", false],
		[1, "", "Poziom techniki stacji wpływa też na jej sklepy. Statki i wyposażenie są tańsze na zaawansowanych stacjach: każdy poziom techniki obniża cenę kadłuba o jeden procent, a wyposażenie również kosztuje nieco mniej. Rzadsze wyposażenie pojawia się częściej w miarę postępów fabuły.", false],
		[1, "Fabryki i receptury", "Fabryki przerabiają surowy połów i towary importowane na produkty. Każdy produkt ma stałą recepturę i minimalny poziom techniki. [[goods/21]] wymaga składnika [[species/4]] i [[species/17|zielonych glonów]]; [[goods/22]] wymaga składników [[species/10]] i [[goods/35]]; [[goods/29]] łączy [[goods/20]] i farbę. Zaawansowane produkty, takie jak [[goods/41]], wymagają innych produktów jako składników, więc łańcuch produkcji może zamienić tanie ryby w cenne towary.", false],
		[1, "", "Fabryka może wytworzyć wszystko do poziomu techniki swojej stacji. Większość produktów wymaga tylko poziomu 1, ale co najmniej jeden przedmiot można zbudować wyłącznie na najbardziej zaawansowanej stacji. Strona każdego produktu podaje jego recepturę.", false],
		[1, "Tablica kontraktów", "Praca na kontrakt to sposób, w jaki kolonia zatrudnia wolnych strzelców. Tablica kontraktów zawiera od jednej do ośmiu ofert, każda ze zleceniodawcą, kaucją płatną przy przyjęciu i wynagrodzeniem wypłacanym po sukcesie. Wynagrodzenie rośnie wraz z trudnością i odległością, a trudność rośnie wraz z rangą pilota. Większość zleceń wysyła pilota na inną stację, zwykle mieszczącą się w pasie głębokości statku. Zob. [[guide/contracts]].", false],
		[1, "", "To, co oferuje tablica, zależy od tego, kto kontroluje stację. Koloniści zatrudniają eskortę konwojów, napastników na konwoje, myśliwych i strażników startów kapsuł. Wolne stacje wystawiają zamówienia na dostawy i połów oraz płacą za ochronę ławic zwierząt. Obie strony wystawiają listy gończe, akcje ratunkowe, polowania na piratów, przewozy pasażerów i sprzątanie.", false],
		[9, "", "Tablica kontraktów otwiera się dla pilota dopiero po pierwszych zleceniach dla kolonii, w [[chapter/9|rozdziale 9]]. Mapa stacji staje się dostępna nieco wcześniej.", false],
		[1, "Prawo i porządek", "Kolonia pilnuje własnego prawa na wodach. Stacje płacą nagrodę za każdego pirata zniszczonego podczas rejsu, wypłacaną przy dokowaniu. Kwota to liczba piratów podniesiona do kwadratu, razy 100 kredytów na stacji kolonistów i 50 na wolnej, więc długie polowanie opłaca się znacznie bardziej niż kilka krótkich.", false],
		[12, "", "Nie wszystkie wody należą do kolonii. Stacje kontrolowane przez ruch oporu traktują otaczające je wody jako terytorium neutralne i zatrzymują nieznane statki, zanim pozwolą im zadokować.", false],
		[35, "", "Część handlu jest nielegalna. Środki odurzające są zakazane co najmniej na niektórych stacjach, co zostawia pole dla handlarzy z czarnego rynku, takich jak [[character/8]]. Służby bezpieczeństwa wynajmują łowców nagród, takich jak [[character/11]], by usuwać takich ludzi.", false],
		[12, "Kolonia w fabule", "Dla pilota kolonia jest najpierw pracodawcą, a potem przeciwnikiem. Jack płaci stałe ceny, odstrzał łodzików na stacji [[station/1]] jest kiepsko płatny, a obrona kapsuł na stacji [[station/2]] kończy się tym, że Jack w ogóle odmawia nagrody. Mając dość, pilot idzie za radą M.A.I. i wyrusza na poszukiwanie ruchu oporu na stacji [[station/3]].", false],
		[13, "", "Ruch oporu sprzeciwia się kontroli kolonii nad handlem i wyzyskowi planety. Jego członkowie chcą wolnego handlu, uczciwych cen i morza, z którego łowi się z rozwagą.", false],
		[18, "", "Rebelianci najpierw zdobywają stacje dyplomacją, przekonując ich przywódców do zmiany stron. Każda stacja, która się przyłącza, otwiera przed pilotem rynek i fabrykę, więc gospodarka kolonii zmienia się stacja po stacji. Szerzą się pogłoski o rewolucji.", false],
		[23, "", "Kolonia nie oddaje swoich stacji bez walki. Jack, teraz postać o pewnych wpływach, zakłada pole minowe, by przeciąć szlak zaopatrzenia rebeliantów w pobliżu stacji [[station/9]].", false],
		[25, "", "Potem Jack urządza zasadzkę na przywódczynię rebeliantów w drodze na negocjacje na stacji [[station/10]].", false],
		[28, "", "Kolonia kupuje też zdrajców. Jack wyznacza nagrodę za przywódczynię rebeliantów i pilota, a pilot rebeliantów, którym jest [[character/3]], bierze pieniądze.", false],
		[31, "", "Kolonia ściga się też z rebeliantami o technologię. Jej ludzie ukradli prototyp, który zbudował [[world/abel|profesor Abel]], czyli [[world/biotek|generator Biotek]], i próbują sami go dokończyć.", false],
		[37, "", "Chciwość osłabia kolonię od środka. Sam Jack sprzedaje działo stacyjne, [[world/eclipse|Eclipse]], handlarzowi z czarnego rynku, który odsprzedaje je pilotowi.", false],
		[44, "", "W ostatnim pokazie siły koloniści uderzają głęboko na terytorium rebeliantów i atakują stację [[station/14]], ale zostają odparci, gdy do walki przeciw nim przyłączają się Akwarianie.", false],
		[45, "", "Po tej klęsce rebelianci przystępują do rozprawy z kolonią, przeprowadzając dwie wielkie ofensywy, po jednej na każdej półkuli.", false],
		[47, "", "Stacje południowe upadają, a kolonistom zostaje stacja [[station/0]] jako ostatni duży, silnie ufortyfikowany bastion.", false],
		[48, "", "Gosu upada w ostatecznej bitwie. Jack ucieka w kapsule ratunkowej, a rządy kolonii nad oceanem dobiegają końca, gdy wszystkie stacje są w rękach rebeliantów.", false],
	],
	"world/eclipse": [
		[33, "", "Eclipse to ciężkie działo zbudowane do obrony stacji. Jest tak energożerne, że nigdy nie miało być montowane na łodzi podwodnej. W drugim kroku planu rebeliantów pilot musi je zdobyć, by połączyć je z [[world/biotek|generatorem Biotek]], który może dostarczyć dość energii, by strzelać z niego na statku. Na liście wyposażenia broń figuruje jako [[equipment/42]], a działo w skrzyni, którym handluje się w fabule, to towar [[goods/38]].", false],
		[33, "Pochodzenie", "Eclipse należy do klasy dział stacyjnych przeznaczonych do stałej obrony. Zapotrzebowanie na energię to powód, dla którego pozostało na stacjach: żadna siłownia łodzi podwodnej nie byłaby w stanie utrzymać go w ogniu. Pilot zna je już jako broń stacjonarną, dlatego plan rebeliantów, by zamontować je na statku, brzmi tak nieprawdopodobnie.", false],
		[33, "", "Działa Eclipse produkuje stacja [[station/188]], która w chwili rozpoczęcia planu jest w rękach kolonistów. Najbliższa odpowiednia stacja pod kontrolą rebeliantów to [[station/15]]. Broni w ogóle nie można kupić na wolnym rynku.", false],
		[33, "", "Rebelianci potrzebują jej, bo ustępują kolonistom liczebnie. Zamiast dorównywać kolonistom statek za statek, liczą, że broń o takiej mocy, przenoszona przez łódź podwodną, przechyli szalę.", false],
		[33, "Zdobycie działa", "[[character/2]] nie ma jasnego planu, jak je zdobyć. Daje pilotowi 100 000 kredytów na łapówki, które okażą się konieczne, i wysyła go na stację Choral, by się rozejrzał.", false],
		[35, "", "Na stacji Choral do pilota podchodzi handlarz z czarnego rynku, którym jest [[character/8]], i twierdzi, że za odpowiednią cenę załatwi niemal wszystko. Spróbuje znaleźć Eclipse, ale tylko jeśli pilot najpierw zabije łowcę nagród, którym jest [[character/11]], wynajętego, by się go pozbyć.", false],
		[37, "", "Gdy Raoul ginie, Fenko załatwia Eclipse po wygórowanej cenie. Kupił je od urzędnika, którym jest [[character/9]], a ten najwyraźniej sprzedał działo dla zysku, nie wiedząc, że trafi w ręce jego wrogów.", false],
		[38, "", "Pilot kupuje broń i przewozi ją z powrotem na stację [[station/14]].", false],
		[39, "", "[[character/2]] postanawia nie pytać, jak zdobyto działo. Z ulgą słyszy, że nie zginęli za nie niewinni ludzie. Gdy pilot żartuje, że plan sprowadza się do podporządkowania sobie całej planety, stanowczo odrzuca ten pomysł.", false],
		[42, "Eclipse w akcji", "Gdy [[goods/36]] dociera na stację Fiir, [[world/abel|profesor Abel]] łączy działo z prototypem generatora, a Eclipse jest gotowe do zamontowania na łodzi podwodnej pilota. Rebelianci ostrzegają, że źródło energii jest wciąż tylko prototypem. Pilot ma rozkaz przetestować broń na bandzie piratów w pobliżu stacji [[station/17]].", false],
		[43, "", "Test wypada na tyle dobrze, że piraci wzywają posiłki. Zaraz potem działo przechodzi prawdziwą próbę, gdy koloniści atakują stację Fiir; Jack nie może uwierzyć, że pilot ma na pokładzie Eclipse.", false],
		[45, "", "Po obronie stacji Fiir rebelianci zdobywają stację [[station/188]] i przed ostatnimi ofensywami zaczynają montować działa Eclipse na jak największej liczbie własnych statków.", false],
		[47, "", "W bitwach o stacje [[station/18]] i [[station/109]] działo okazuje się niszczycielskie, a [[character/5]] nie szczędzi mu pochwał.", false],
		[37, "W grze", "W rozdziałach w okolicach [[chapter/37|rozdziału 37]] Eclipse w skrzyni jest w sprzedaży na stacji Choral jako towar fabularny. Kosztuje znacznie więcej niż jakikolwiek zwykły towar handlowy i nigdzie indziej nie jest dostępne.", false],
		[42, "", "W [[chapter/42|rozdziale 42]] działo [[equipment/42]] pojawia się w sklepie z wyposażeniem na stacji [[station/14]], a jego montaż nic nie kosztuje. Dopóki nie zostanie zamontowane, tablica kontraktów i mapa są zamknięte, a statek nie może wypłynąć. Na statku można zamontować tylko jedno Eclipse i nie da się go sprzedać, dopóki wojna nie zostanie wygrana.", false],
		[42, "", "Jako broń przewyższa wszystko, co jest w sprzedaży. Każdy strzał trafia mocniej niż z jakiegokolwiek innego działa w grze, przy zasięgu około 240 m, a działo strzela mniej więcej raz na sekundę. Strzela razem z resztą zestawu broni, więc współdziała z każdą inną zamontowaną bronią.", false],
	],
	"world/history": [
		[1, "", "Kampania opowiada o młodym pilocie łodzi podwodnej, który przybywa na odległą oceaniczną planetę, by pracować jako rybak dla tutejszej ludzkiej [[world/colony|kolonii]]. Koloniści żyją na stacjach rozsianych w głębinach [[world/ocean|oceanu]], a kolonia jest zależna od tego, co jej piloci złowią, sprzedadzą i przewiozą między stacjami. Pilot ma małą, skromnie wyposażoną łódź podwodną, którą dzieli z [[character/1]], komputerem pokładowym, który nigdy nie szczędzi rad ani opinii. Imię pilota wybiera gracz; ta encyklopedia nazywa bohatera po prostu pilotem.", false],
		[1, "", "Historia rozgrywa się w 48 rozdziałach. Zaczyna się od codzienności zwykłego rybaka: łowienia morskich stworzeń, sprzedaży połowu i dorywczych zleceń, które pozwalają związać koniec z końcem. Z czasem przeradza się w konflikt o to, jak należy traktować morze planety i jego mieszkańców, a także o to, kto ma o tym decydować. Po drodze pilot ma do czynienia z urzędnikami stacji, handlarzami, [[faction/pirates|piratami]] i dziwniejszymi mieszkańcami głębin, a wybory jednego rybaka okazują się ważyć znacznie więcej, niż ktokolwiek przypuszczał.", false],
		[1, "Akt I: Rybak na usługach kolonii", "Historia zaczyna się na otwartym morzu w [[chapter/1|rozdziale 1]]. Pilot już żałuje przeprowadzki na planetę, ale [[character/1]] przypomina, że przybyli tu łowić ryby, a pierwsze zadanie polega po prostu na trafieniu stworzenia harpunem i wciągnięciu go do ładowni. Początkowe sceny są zarazem wprowadzeniem do połowu morskich stworzeń.", false],
		[2, "", "Gdy pierwsze stworzenie trafia na pokład, [[character/1]] pokazuje, jak autopilot może przejąć stery, a w [[chapter/2|rozdziale 2]] pilot obiera kurs na stację [[station/0]], stację kolonistów, na której sprzedaje się połów.", false],
		[3, "", "Na stacji [[station/0]] pilot ma do czynienia z urzędnikiem kolonii, który skupuje połów. Jest nim [[character/9]]. [[character/9]] płaci swoją zwykłą stałą cenę, kpi z małej ładowni i poucza nowicjusza, że każdy musi dołożyć swoją cegiełkę dla kolonii. Drwi też, że pilot z porządnym działem mógłby zarobić więcej na polowaniu na [[faction/pirates|piratów]]. Gdy odchodzi, [[character/1]] nazywa go głupcem, ale podchwytuje wskazówkę i zauważa, że w hangarze jest w ofercie [[equipment/0]]. W [[chapter/3|rozdziale 3]] pilot kupuje działo i montuje je na statku.", false],
		[4, "", "Uzbrojony po raz pierwszy, pilot opuszcza stację w [[chapter/4|rozdziale 4]], by wypróbować nową broń, a [[character/1]] ostrzega przed strzelaniem do nieszkodliwych ryb. Okoliczne wody okazują się wolne od piratów, więc polowanie trzeba przenieść gdzie indziej.", false],
		[5, "", "[[character/1]] wyjaśnia, jak wyglądają dalekie podróże: statki pokonują wielkie odległości dzięki [[world/stream|sieci S.T.R.E.A.M.]], zawsze opuszczając sektor przez jego punkt wyjścia i docierając do punktu wejścia następnego. W [[chapter/5|rozdziale 5]] w pobliżu stacji [[station/1]] pojawia się samotny pirat. Po krótkiej lekcji przełączania broni, korzystania z autoognia i czytania radaru pilot po raz pierwszy staje do walki.", false],
		[6, "", "Pirat zostaje zniszczony, a [[character/1]] pokazuje, jak wyłowić harpunem skrzynie z ładunkiem, które zostawiają wraki, zanim opadną poza zasięg. Z działającą bronią i odrobiną odzyskanego ładunku pilot wraca na stację [[station/0]] w [[chapter/6|rozdziale 6]].", false],
		[7, "", "Na stacji [[character/9]] z zadowoleniem przyjmuje, że jego rada została wysłuchana, i proponuje coś, co sam nazywa prawdziwą robotą. [[species/0|Łodziki]] tłoczą się na trasach konwojów wokół stacji [[station/1]], a ochrona stacji chce się ich pozbyć. Pilot protestuje, że zwierzęta jedynie żywią się porostami pokrywającymi kadłuby stacji i że żadna mała ładownia nie pomieści ich wszystkich, ale [[character/9]] nie dba o to, w jaki sposób znikną. W [[chapter/7|rozdziale 7]] pilot usuwa je harpunem lub działem. Ani pilot, ani [[character/1]] nie są zadowoleni z tej pracy, bo stworzeń jest niewiele i są nieszkodliwe.", false],
		[8, "", "Odstrzał wstrząsa pilotem. Pilot przybył na planetę łowić ryby, a nie zabijać zwierzęta dla wygody stacji, a [[character/1]] może tylko mieć nadzieję, że zapłata choć trochę to wynagrodzi. W [[chapter/8|rozdziale 8]] obaj dokują na stacji [[station/1]], by ją odebrać.", false],
		[9, "", "Tamtejszy urzędnik kolonii ([[character/6]]) traktuje pilota jak wynajętego tępiciela szkodników i przyznaje, że zadanie zapewne nie miało sensu, bo łodziki i tak wracają. Zapłata to stałe 1000 $, do przyjęcia albo odrzucenia. Dalsza praca zależy od dowodu umiejętności: trzech wykonanych kontraktów z tablic na stacjach. [[chapter/9|Rozdział 9]] wysyła pilota do pracy na własny rachunek: bierze wszelkie eskorty, akcje odzyskiwania ładunku i zamówienia na połów, które są w zasięgu.", false],
		[10, "", "Trzy zlecenia przynoszą niechętne uznanie urzędnika i zadanie specjalne. Dziwne istoty, które koloniści nazywają [[world/aquarians|Akwarianami]], pół ludzie, pół ryby, atakują kapsuły transportowe wynoszące towary kolonii na orbitę, skąd odbierają je statki towarowe. Utracone lub uszkodzone kapsuły psują opinię stacji w oczach [[world/colony|władz handlowych]], więc pilot zostaje wysłany na stację [[station/2]], by odpędzić napastników. Następnym startem pokieruje tam [[character/9]].", false],
		[10, "", "W [[chapter/10|rozdziale 10]] start już trwa, gdy pilot przybywa na miejsce, a Akwarianie rzeczywiście atakują kapsuły. Przez radio odzywa się [[character/9]] z dosadnym ostrzeżeniem: posada pilota zależy od tego, czy straci nie więcej niż pięć kapsuł.", false],
		[11, "", "Atak zostaje odparty, ale pozostawia pytania. Pilot zastanawia się, dlaczego Akwarianie w ogóle biorą na cel kapsuły, a [[character/1]] sugeruje, że mogą być znacznie inteligentniejsi, niż sądzą koloniści. Coraz bardziej zaniepokojony tego rodzaju pracą pilot dokuje na stacji [[station/2]], by złożyć raport w [[chapter/11|rozdziale 11]].", false],
		[12, "Akt II: Ruch oporu", "Powitanie, jakie szykuje mu [[character/9]], wyczerpuje cierpliwość pilota wobec kolonii. Urzędnik obwinia pilota o uszkodzone kapsuły, odwołuje nagrodę i odchodzi wzburzony, mrucząc, że jemu pisane są większe rzeczy. Wtedy [[character/1]] mówi głośno to, co obaj czują: pilot pracuje dla kolonii całymi dniami, zarabia bardzo mało i nie ma nic do powiedzenia w sprawie połowu, który zabiera się po prostu po stałej cenie. Pilot chce tylko odłożyć dość na bilet z planety, ale [[character/1]] ma inny pomysł.", false],
		[12, "", "Przeszukując pasma radiowe, [[character/1]] wychwycił ślady ruchu oporu, który nadaje ze stacji [[station/3]]. Wybór należy do pilota, który wie, że może to oznaczać poważne kłopoty, a mimo to rusza w drogę. Od tej chwili [[character/1]] oznacza stacje ruchu na mapie na zielono (zob. [[faction/rebels]]).", false],
		[12, "", "W [[chapter/12|rozdziale 12]] dyskretne podejście do stacji [[station/3]] od razu się nie udaje. Strażnicy stacji zatrzymują statek i grożą otwarciem ognia, a pilot jąka się, podaje swoje imię, mówi, że wyruszył ze stacji [[station/0]], i prosi o przyjęcie do ruchu. Po długiej ciszy statek otrzymuje zgodę na dokowanie.", false],
		[13, "", "W środku nowego przybysza przesłuchuje [[character/4]], zadając szereg zawiłych pytań. Pilot przyznaje, że poza tym, iż ruch popiera wolny handel, nie wie prawie nic. Zgadza się to z wyznaniem, które czyni [[character/4]]: rebelianci zaczęli szyfrować łączność radiową zaledwie kilka dni temu. Ruchowi brakuje rąk do pracy, więc [[character/4]] przyjmuje pilota na próbę. Ruch zamierza przeniknąć na stacje kolonistów, przekonać ich przywódców do zmiany stron i położyć kres wyzyskowi planety i jej mieszkańców.", false],
		[13, "", "[[character/4]] nie zdradzi planów obcemu, więc pilot musi najpierw okazać się przydatny. W [[chapter/13|rozdziale 13]] zadanie polega na zabraniu sympatyków ze stacji [[station/4]] i dowiezieniu ich na stację [[station/5]]. Po drodze pilot przyznaje przed [[character/1]], że cała sprawa jest dla niego zagadką, ale zgadza się, że to lepsze niż słuchanie poleceń, jakie wydaje [[character/9]].", false],
		[14, "", "Łącznikiem na stacji [[station/4]] okazuje się jedna pasażerka: [[character/5]]. Jest serdeczna i bystra, wyraźnie cieszy się ze spotkania, a pilot równie wyraźnie jest nią oczarowany. Nie chce wyjaśnić planów ruchu, bo właśnie dzięki tajemnicy przetrwał on tak długo, i przesyła współrzędne podróży. [[character/1]] obserwuje ich dwoje z nieukrywaną irytacją, co pilot przekornie nazywa zazdrością. W [[chapter/14|rozdziale 14]] pilot jak najszybciej i najbezpieczniej przewozi pasażerkę, którą jest [[character/5]], na stację [[station/5]].", false],
		[15, "", "[[character/5]] ukrywa się na stacji [[station/5]], by załatwić pewne sprawy, ale najpierw wyjaśnia, dlaczego rebelianci trzymają się z dala od kolonistów. Nie ogałacają morza z zasobów. Biorą to, co może ono oddać, przerabiają połów na towary i uważają, by nie przełowić łowisk, tak aby przetrwała różnorodność życia. Aby pokazać, jak to działa, prosi pilota o wyprodukowanie pięciu ton towarów w fabryce stacji ruchu oporu ([[chapter/15]]). Proponuje stację [[station/90]], gdzie można łowić kałamarnice i kupić towar [[goods/35]], by wytworzyć produkt [[goods/22]].", false],
		[16, "", "Gdy pilot opanuje ten drugi sposób zarabiania, [[character/5]] dzwoni z nowym zadaniem. Ruch potrzebuje aktualnych raportów z każdej stacji, by znaleźć słabe punkty i przeciągnąć ludność na swoją stronę, bo perswazja będzie równie ważna jak siła ognia. Gdy pilot pyta, czy chodzi o rewolucję, odmawia dalszych wyjaśnień. W [[chapter/16|rozdziale 16]] pilot odwiedza stacje, na których jeszcze nie był, i przy okazji zarabia na ulepszenia statku.", false],
		[17, "", "Długa wiadomość, którą przysyła [[character/4]], a którą [[character/1]] streszcza w jednym zdaniu, wzywa pilota z powrotem na stację [[station/3]] w [[chapter/17|rozdziale 17]]. Tymczasem strefa rebeliantów się rozrasta: do ruchu przechodzą stacje [[station/6]], [[station/12]], [[station/106]] i [[station/180]].", false],
		[18, "Akt III: Przywódczyni", "[[character/4]] wyjaśnia, że dyplomacja po cichu poszerzyła strefę rebeliantów, więc pilot może teraz handlować na znacznie większej liczbie stacji. Kanały informacyjne już mówią o rewolucji. Wielu decydentów przyłączyło się bez jednego wystrzału, choć [[character/4]] spodziewa się, że prędzej czy później poleje się krew. Dalszymi krokami kieruje przywódca ruchu z jednej z nowo pozyskanych stacji, a pilot musi go odnaleźć, a raczej dać się odnaleźć. [[character/4]] zaznacza możliwe stacje i ostrzega, że niektóre mogą być poza zasięgiem bez lepszego pancerza lub osłon.", false],
		[18, "", "Na [[character/1]] organizacja ruchu nie robi wrażenia, a [[chapter/18|rozdział 18]] zamienia się w poszukiwania, w których można liczyć niemal wyłącznie na szczęście.", false],
		[19, "", "Trop kończy się na stacji [[station/6]], gdzie pilot poznaje przywódczynię ruchu, starszą kobietę, która od teraz będzie wydawać rozkazy. To [[character/2]]. Pilot zakładał, że przywódca jest mężczyzną, ale ona puszcza tę pomyłkę mimo uszu. Jej pierwsze zlecenie to eskorta. Ławicę stworzeń [[species/10]] trzeba doprowadzić na bezpieczne wody w pobliżu stacji [[station/7]], zanim koloniści zdążą je złowić lub zabić, a walka jest prawdopodobna. [[character/1]] narzeka, że nikt nie wspomniał o zapłacie, a pilot uznaje, że [[character/2]] chce najpierw sprawdzić, czy nowicjuszowi można zaufać.", false],
		[19, "", "W [[chapter/19|rozdziale 19]] pilot zauważa Akwarian płynących obok ławicy, a [[character/1]] zastanawia się, czy opiekują się oni morskimi stworzeniami. Wkrótce zbliżają się statki kolonistów i pilot musi je przechwycić, nie trafiając przy tym zwierząt.", false],
		[20, "", "Ławica przeżywa. [[character/2]] płaci skromne 2000 $ i od razu wzywa pilota z powrotem, a [[character/1]] narzeka, że sprzedaż zwierząt przyniosłaby znacznie więcej. W [[chapter/20|rozdziale 20]] pilot wraca na stację [[station/6]].", false],
		[21, "", "Tym razem pilot pyta wprost, o co chodzi ruchowi. [[character/2]] opisuje grupę ludzi zjednoczonych przeciw niszczeniu planety i jej mieszkańców. Kolonizacja postępuje tak szybko, a przyroda jest eksploatowana tak bezwzględnie, że morskie rośliny i zwierzęta wkrótce nie zdołają się odrodzić. Jeśli nic się nie zmieni, planeta skończy wyjałowiona jak wiele światów przed nią. Ruch chce temu zapobiec, przeciągając na swoją stronę ważnych decydentów, a pilot przyrzeka pomoc.", false],
		[21, "", "Najpilniejszym zmartwieniem, jakie ma [[character/2]], są [[faction/pirates|piraci]], którzy wykorzystują konflikt, by polować na łatwe ofiary. Dotąd ruch jedynie się bronił; teraz zaatakuje bezpośrednio formację piratów. Aby uspokoić zdenerwowanego pilota, przydziela mu eskortę: to [[character/3]], jeden z jej najlepszych pilotów, choć [[character/1]] podejrzewa, że tak naprawdę to pilot będzie eskortował jego. W [[chapter/21|rozdziale 21]] obaj spotykają się w pobliżu stacji [[station/8]]. [[character/3]] wita spóźnionego nowicjusza niecierpliwie i protekcjonalnie, każąc mu trzymać się z tyłu i uczyć się.", false],
		[22, "", "Banda zostaje rozbita. [[character/3]] zdobywa się na niechętną pochwałę, ale gdy [[character/2]] nagradza każdego z nich kwotą 5000 $, wpada we wściekłość, że pieniądze podzielono po równo, i oświadcza pilotowi, że nowicjusz w niczym nie pomógł. Pilot i [[character/1]] odpływają, zanim jego gniew się nasili. W [[chapter/22|rozdziale 22]] płyną na stację [[station/9]], na spotkanie z przywódczynią. [[character/2]] przeprowadziła tam udane rozmowy: stacja przyłączyła się do ruchu razem ze stacjami [[station/5]], [[station/37]] i kilkoma innymi.", false],
		[23, "", "Zanim [[character/2]] ruszy dalej, trzeba zabezpieczyć szlak zaopatrzenia do stacji [[station/37]]. Aby go przeciąć, tuż przed stacją pole minowe założył [[character/9]]. [[character/2]] zna go: był kiedyś nikim, ale szybko piął się w górę dzięki dobrze ulokowanym znajomym. Pilot, chętny pokrzyżować mu plany, wyrusza w [[chapter/23|rozdziale 23]] oczyścić pole. [[character/2]] ostrzega, że w pobliżu będą krążyć piraci i że każdą minę można zniszczyć dopiero wtedy, gdy pilot podpłynie na tyle blisko, by uruchomić jej czujnik ruchu.", false],
		[24, "", "Pole zostaje oczyszczone, szlak znów jest bezpieczny, a [[character/2]] płaci za tę pracę 4000 $. Po powrocie na stację [[station/9]] w [[chapter/24|rozdziale 24]] pilot zastaje znacznie większą strefę rebeliantów. Fala stacji w całym oceanie stoi teraz po stronie ruchu, wśród nich [[station/14]], [[station/22]] i [[station/25]].", false],
		[25, "", "Na stacji pilot spotyka znów [[character/5]], a ich rozmowa jest serdeczna, choć niezręczna, zwłaszcza że [[character/1]] udziela niechcianych rad. [[character/2]] przerywa to spotkanie. Runda negocjacji na stacji [[station/10]] może przyciągnąć kolejne stacje, a pilot i [[character/5]] mają eskortować tam przywódczynię i jej asa, którym jest [[character/3]]. Pilot niechętnie myśli o wspólnym rejsie z [[character/3|Raymondem]], ale [[character/2]] ręczy za jego umiejętności i nie spodziewa się niczego gorszego niż piraci.", false],
		[25, "", "W [[chapter/25|rozdziale 25]] grupa dociera na stację [[station/10]] i od razu wyczuwa, że coś jest nie tak. Czeka tam [[character/9]] z siłami kolonistów i rozkazuje atak, a [[character/2]] nie potrafi pojąć, skąd wiedział o ich przybyciu.", false],
		[26, "Akt IV: Zdrada", "Podczas walki [[character/3]] wstrzymuje ogień, twierdzi, że jego broń zawiodła, i ucieka, przepraszając przy tym. Reszta grupy przeżywa. [[character/2]] zastanawia się nad sabotażem, a [[character/5]] otwarcie oskarża [[character/3|Raymonda]] o zdradę; [[character/2]] broni go, mówiąc, że zawsze był jej lojalny. Pilot przyznaje, że wyglądało to podejrzanie, ale nalega, by wszyscy odpłynęli, zanim [[character/9]] ściągnie kolejne statki.", false],
		[26, "", "Grupa się rozdziela. [[character/2]] się ukrywa, a [[character/5]] prowadzi sprawy ruchu na stacji [[station/9]]. Pilot ma przed kolejnym spotkaniem stać się znacznie lepszym wojownikiem, bo teraz jest już jasne, że sama dyplomacja może nie wystarczyć do wygrania walki. W [[chapter/26|rozdziale 26]] pilot poluje na piratów i innych wrogów, by zwiększyć liczbę zestrzeleń.", false],
		[27, "", "Gdy pilot staje się groźniejszy, nagle odzywa się [[character/3]]. Pyta, co słychać u [[character/2]] i [[character/5]], twierdzi, że podczas nieobecności zdobył kluczowe informacje, i prosi o spotkanie w pobliżu stacji [[station/11]]. [[character/1]] jest pewien, że to pułapka, a pilot się z nim zgadza, po czym i tak rusza na spotkanie ([[chapter/27]]).", false],
		[28, "", "Pułapka jest prawdziwa. [[character/3]] trzyma w niewoli przywódczynię, którą jest [[character/2]], i żąda, by pilot się poddał, a [[character/2]] namawia pilota, by nie zważał na jej los. Za radą, jakiej udziela [[character/1]], pilot zajmuje [[character/3|Raymonda]] rozmową, podczas gdy komputer skanuje jego statek. [[character/3]] otwarcie przyznaje, że zmienił strony dla pieniędzy: [[character/2]] płaciła marnie, a [[character/9]] wyznaczył wysoką nagrodę za nią i za pilota. Gdy pilot odwołuje się do ideałów ruchu, [[character/3]] odpowiada, że ideały nie postawią jedzenia na stole.", false],
		[28, "", "Skan wykazuje statek jednoosobowy, więc [[character/2]] musi być zamknięta w jego ciężko opancerzonej ładowni. Pilot otwiera ogień. [[character/3]] okazuje się szybki i groźny, ale jego statek zostaje zniszczony, a pilot wyławia harpunem kontener ładunkowy, zanim opadnie zbyt głęboko. W [[chapter/28|rozdziale 28]] pilot przewozi go na stację [[station/12]], najbliższą bezpieczną stację, z nadzieją, że [[character/1]] trafnie odgadł jego zawartość.", false],
		[29, "", "[[character/1]] miał rację. [[character/2]] wychodzi z kontenera wstrząśnięta, ale cała, i dziękuje pilotowi za uratowanie życia. Nie ma czasu na odpoczynek: przed porwaniem organizowała przewóz zespołu wybitnych naukowców na stację [[station/14]], a [[character/3]] mógł już przekazać szczegóły. Nie chce jeszcze wyjaśnić, dlaczego naukowcy są tak ważni, i wysyła pilota, by bezpiecznie przeprowadził ich konwój przez strefę przygraniczną ([[chapter/29]]). W pobliżu stacji [[station/13]] pilot zastaje konwój pod ciężkim ostrzałem, wzywający pomocy.", false],
		[30, "", "Konwój przedostaje się dalej, a jego załogi przyznają, że ocalenie zawdzięczają pilotowi. [[character/2]] płaci 5000 $ i zwołuje spotkanie na stacji [[station/14]], gdzie obiecuje wyjaśnić, co dalej ([[chapter/30]]).", false],
		[31, "Akt V: Trzy kroki", "Na stacji [[station/14]] czekają [[character/5]], [[character/4]] i [[character/2]], a [[character/2]] wreszcie zdradza pilotowi swój plan. Starcia z kolonistami są coraz częstsze, a rebelianci wciąż ustępują im liczebnie, więc sprowadziła na stację [[world/abel|profesora Abla]] i jego zespół, by zbudowali broń, która przechyli szalę. Projekt ma trzy kroki. Pierwszym jest źródło energii, [[world/biotek|generator Biotek]], technologia badana od lat, z której nigdy nie powstał działający prototyp. Abel był bliski ukończenia prototypu, gdy ukradli go koloniści, którzy teraz próbują sami go dokończyć.", false],
		[31, "", "[[character/2]] wyrusza na spotkanie z Ablem, a odprawę przejmuje [[character/5]]. Informator donosi, że generator jest przewożony w stronę Maarth zwykłymi frachtowcami, by nie zwracać uwagi, co daje rebeliantom szansę uderzenia w pobliżu stacji [[station/2]]. Nikt nie wie, który statek go wiezie, więc trzeba zatrzymać cały konwój i odzyskać każdy kontener, czy się to komuś podoba, czy nie. W [[chapter/31|rozdziale 31]] konwój przechwytują pilot, [[character/5]] i [[character/4]]. Załogi błagają, że wiozą tylko żywność i leki, na co [[character/4]] odpowiada, że rebeliantom bardzo brakuje jednego i drugiego.", false],
		[32, "", "Wszystkie kontenery zostają odzyskane, a w [[chapter/32|rozdziale 32]] zespół dowozi łup na stację [[station/14]].", false],
		[33, "", "Abel zabiera ładunek do laboratorium, by pracować nad prototypem, a [[character/2]] rozdziela nowe obowiązki. [[character/5]] ma patrolować okolice stacji na wypadek niespodziewanego ataku, [[character/4]] jest potrzebny w hangarze, a pilotowi przypada drugi krok. Generator wymaga broni godnej jego mocy, a [[character/2]] wybrała działo [[equipment/42]], [[world/eclipse|stacjonarne działo obronne]], którego ogromne zapotrzebowanie na energię dotąd nie pozwalało zamontować go na żadnym statku.", false],
		[33, "", "Najbliższa stacja produkująca takie działa, [[station/188]], jest w rękach kolonistów, więc [[character/2]] wysyła pilota na stację rebeliantów [[station/15]]. Broń nie jest nigdzie sprzedawana i na tym plan przywódczyni się kończy. Po prostu przekazuje 100 000 $ na łapówki, które mogą okazać się potrzebne. Pilot nazywa to najbardziej mglistym planem, o jakim słyszał, i z radością go przyjmuje, a w [[chapter/33|rozdziale 33]] udaje się na stację, by się rozejrzeć.", false],
		[34, "", "Bez kontaktów i bez prawdziwego planu pilot zaczyna od przeglądania towarów miejscowego handlarza. W [[chapter/34|rozdziale 34]] trop prowadzi do ładunku towaru [[goods/37]], narkotyku zakazanego na tej stacji.", false],
		[35, "", "Transakcja przyciąga uwagę handlarza z czarnego rynku, który mówi o sobie w trzeciej osobie i twierdzi, że załatwi niemal wszystko. To [[character/8]]. Zapytany o działo [[equipment/42]], jest zdumiony i zastanawia się, czy pilot zamierza rozpętać wojnę. Mimo to zgadza się spróbować w zamian za przysługę: śmierć łowcy nagród, którego wynajęła administracja bezpieczeństwa, by pozbyć się handlarza, którym jest [[character/8]]. Tym łowcą jest [[character/11]]. W [[chapter/35|rozdziale 35]] pilot znajduje go patrolującego okolice stacji z własną eskortą. [[character/11]] zbywa pilota jako zwykłego rybaka.", false],
		[36, "", "Gdy walka obraca się przeciw niemu, [[character/11]] próbuje się wykręcić, ale jego statek zostaje zniszczony. W [[chapter/36|rozdziale 36]] pilot wraca na stację [[station/15]] z nadzieją, że handlarz dotrzyma słowa.", false],
		[37, "", "[[character/8]] wywiązuje się z umowy. Wytropił działo [[equipment/42]] i jest gotów je sprzedać, po cenie zawyżonej przez łapówki, które rzekomo zapłacił. Zapytany, skąd wziął takie działo, wymienia sprzedawcę: to [[character/9]]. [[character/1]] delektuje się ironią losu: chciwość, którą wykazuje [[character/9]], zbroi jego największych wrogów. W [[chapter/37|rozdziale 37]] pilot kupuje działo i ładuje je na pokład.", false],
		[38, "", "Z działem w ładowni drugi krok jest zakończony, a w [[chapter/38|rozdziale 38]] pilot wraca na stację [[station/14]], by sprawdzić, jak postępują prace nad prototypem.", false],
		[39, "", "[[character/2]] wolałaby nie wiedzieć, jak zdobyto działo, i ma tylko nadzieję, że nie przelano krwi; pilot ostrożnie odpowiada, że nie zginęli niewinni ludzie. Prototyp jest prawie gotowy, ale brakuje mu jednego małego urządzenia, którego nie da się wytworzyć na stacji: to [[goods/36]], który kopiuje materiał genetyczny cząstek glonów i w ten sposób wywołuje reakcję zasilającą generator. [[character/2]] przyznaje, że jedynie powtarza wyjaśnienia Abla. Gdy pilot z przekąsem nazywa urządzenie trzecim krokiem do podporządkowania sobie całej planety, ostro odrzuca ten pomysł.", false],
		[39, "", "Tylko stacja [[station/16]] ma sprzęt do zbudowania inkubatora, więc [[chapter/39|rozdział 39]] wysyła tam pilota po trzeci krok. [[character/1]] narzeka, że pilot zdaje się prowadzić całą rebelię w pojedynkę.", false],
		[40, "", "Na stacji staje się jasne, że budowa inkubatora będzie wszystkim, tylko nie prostą sprawą, a [[chapter/40|rozdział 40]] zamienia się w wymagające zadanie produkcyjne.", false],
		[41, "", "Inkubator jest gotowy, ku nieukrywanemu zaskoczeniu, jakie okazuje [[character/1]]. Wciąż niepewny, czy to wszystko jest słuszne, pilot przewozi go na stację [[station/14]] w [[chapter/41|rozdziale 41]].", false],
		[42, "", "[[character/5]] z zachwytem wita pilota i inkubator, a [[character/1]] oznajmia, że woli się wyłączyć, niż tego słuchać. Abel ma wszystko gotowe, a działo [[equipment/42]] powinno wkrótce być dostępne w hangarze. [[character/2]] chce od razu wypróbować działo na piratach, a [[character/5]] przekazuje współrzędne z ostrzeżeniem, że generator jest wciąż tylko prototypem. [[character/1]], rzekomo w trybie czuwania, daje jasno do zrozumienia, że słyszał każde słowo.", false],
		[42, "", "W [[chapter/42|rozdziale 42]] pilot montuje działo i atakuje kryjówkę piratów w pobliżu stacji [[station/17]]. Piraci szybko orientują się, z czym mają do czynienia, i wzywają posiłki.", false],
		[43, "Akt VI: Wojna o ocean", "Test przerywa wezwanie pomocy ze stacji [[station/14]], nadane otwarcie na nieszyfrowanym kanale. W [[chapter/43|rozdziale 43]] pilot pędzi z powrotem i zastaje stację pod niespodziewanym atakiem kolonistów. Wiele doków zostało trafionych, zbyt mało statków rebeliantów może wystartować, a [[character/2]] wierzy, że nadszedł koniec. Szturmem dowodzi [[character/9]], który drwi z pilota, że łowi ryby na rzecz rebeliantów, dopóki nie dowiaduje się, że działo [[equipment/42]] zaraz wypali.", false],
		[44, "", "W środku bitwy przybywają [[world/aquarians|Akwarianie]] i uderzają na kolonistów, walcząc po stronie rebeliantów. Atak się załamuje, a [[character/9]] ucieka, gdy widzi, że jest przegrany. [[character/2]] nazywa ten ratunek cudem i prosi pilota o zadokowanie, obiecując wyjątkowego gościa ([[chapter/44]]).", false],
		[45, "", "[[character/2]] przyznaje, że napaść zaskoczyła rebeliantów, bo nikt się nie spodziewał, że koloniści uderzą tak głęboko na wodach rebeliantów, i że w obronie nie byli osamotnieni. Gościem jest akwariański wysłannik, który rozumie trochę ludzkiej mowy. Za jego pośrednictwem Akwarianie oferują pomoc w obaleniu panowania kolonistów. Gdy wszystkie stacje zostaną zdobyte, a flota kolonistów pokonana, wszyscy mają żyć w harmonii z naturą.", false],
		[45, "", "Z pomocą Akwarian [[character/2]] planuje dwie wielkie ofensywy, by zdobyć pozostałe stacje na półkuli północnej i południowej. Stacja [[station/188]] upadła, a rebelianci montują działo [[equipment/42]] na tylu statkach, na ilu się da. By wykorzystać zaskoczenie, póki trwa, przywódczyni powierza pilotowi dowództwo szturmu na stację [[station/18]], a przeciw stacji [[station/109]] wysyła [[character/5]]. Gdy pilot martwi się o [[character/5]], [[character/2]] żartuje z oczywistego uczucia pilota i zauważa, że [[character/5]] sama jest wprawnym pilotem.", false],
		[45, "", "W [[chapter/45|rozdziale 45]] na miejscu czeka na rozkaz ataku dowódca eskadry Atmos. To [[character/12]]. Tymczasem z głębin wynurza się grupa Akwarian. Wszystkie statki kolonistów muszą zostać zniszczone, także frachtowce.", false],
		[46, "", "Obrońcy zostają rozbici. Pilot wysyła połowę eskadry na patrol wokół stacji, a z resztą dokuje w [[chapter/46|rozdziale 46]]. Eskadrą dowodzi [[character/12]]. Jednocześnie strony zmienia ogromna fala stacji, od stacji [[station/1]] i [[station/2]] po [[station/11]], [[station/18]] i [[station/109]].", false],
		[47, "", "[[character/5]] melduje, że jej szturm również się powiódł, a działo [[equipment/42]] okazało się niszczycielskie; pilot równie wiele zasługi przypisuje Akwarianom. Wszystkie stacje południowe są teraz w rękach rebeliantów. [[character/2]] przekazała wieść o zadaniu, które może być ostatnim: to stacja [[station/0]], ostatni wielki bastion kolonistów i miejsce, gdzie zaczęła się historia pilota. Stacja jest silnie ufortyfikowana, a [[character/2]] już jest w drodze, by osobiście poprowadzić atak. [[character/5]] podąża za nią, opóźniona przez piratów na swojej trasie, a w [[chapter/47|rozdziale 47]] pilot dołącza do nich na ostateczną bitwę.", false],
		[47, "", "Obroną dowodzi [[character/9]], który przechwala się, że z przyjemnością zniszczy statek pilota, a pilot rozpoznaje w tym echo ostatnich słów, które wypowiedział [[character/3]]. Gdy dowiaduje się, kto zabił [[character/3|Raymonda]], [[character/9]] próbuje wytrącić pilota z równowagi, twierdząc, że jest jego ojcem, a [[character/3]] był jego bratem. Pilot, który nie ma brata, a twarz ojca pamięta doskonale, od razu odrzuca to kłamstwo.", false],
		[48, "", "Flota kolonistów pada statek po statku, aż zostaje tylko [[character/9]]. Jest szybki i trudno go trafić, ale za radą, jakiej udziela [[character/1]], pilot unika jego ataków i uderza od tyłu. [[character/9]] ucieka w kapsule ratunkowej i, ku niedowierzaniu, jakie okazuje [[character/5]], wydaje się zabierać ze sobą całą stację. Przed ucieczką drwi, że w głębinach nie ma nic wartego zachodu i że ryby i tak nigdy go nie obchodziły.", false],
		[48, "", "Gdy [[character/9]] znika, wojna jest skończona, a w [[chapter/48|rozdziale 48]] stacja [[station/0]] i ostatnie opierające się stacje przechodzą do ruchu. Pilot podkreśla, że zwycięstwo należy do wszystkich. [[character/1]] domaga się swojej części zasługi i dostaje obietnicę rozbudowy pamięci, gdy pilot wróci na stały ląd, na co z oburzeniem oświadcza, że wcale jej nie potrzebuje. [[character/2]] dziękuje wszystkim i przyznaje, że rany planety będą się goić długo, ale wierzy, że i z tym sobie poradzą. [[character/5]] zaprasza pilota na świętowanie przy [[goods/21]], a pilot chętnie przyjmuje zaproszenie.", false],
		[48, "Motywy", "Główny konflikt dotyczy tego, jak należy korzystać z morza. Kolonia traktuje je jak zasób do eksploatacji i wysyłki na orbitę: skupuje połów po stałych cenach i wybija dzikie zwierzęta, które wchodzą jej w drogę. Ruch opowiada się za braniem tylko tego, co morze może oddać, ochroną różnorodności życia i wolnym handlem. Pierwsze zlecenia pilota, odstrzał łodzików i obrona kapsuł, pokazują kolonialne metody od środka. Rosnący dyskomfort pilota wobec nich sprawia, że jego zwrot ku ruchowi oporu jest wiarygodny.", false],
		[48, "", "Akwarianie przechodzą podobną drogę. Najpierw pojawiają się jako szkodniki atakujące kapsuły kolonii, a pilot dostaje zapłatę za ich odpędzanie. Później widać, jak opiekują się morskimi stworzeniami, a na stacji [[station/14]] odwracają losy przegranej bitwy. Z perspektywy czasu ich wcześniejsze napaści wyglądają na własny opór przeciw grabieży oceanu, choć gra pozostawia ich motywy w dużej mierze domysłom.", false],
		[48, "", "Pieniądze i lojalność przewijają się przez całą historię. [[character/3]] zdradza ruch dla nagrody, a [[character/9]] sprzedaje to samo działo, które później łamie jego atak na stację [[station/14]]. Pilot zaczyna, pragnąc jedynie zarobić na bilet do domu, a kończy jako jeden z dowódców ruchu, zaś narzekania, jakie [[character/1]] wygłasza na marną płacę, stają się raczej powracającym żartem niż motywacją.", false],
		[48, "", "Większość początkowych zdobyczy ruch zawdzięcza perswazji, a zasadzka na stacji [[station/10]] wyznacza moment, w którym perswazja przestaje wystarczać. Kampania zamyka następnie koło na stacji [[station/0]], tam gdzie [[character/9]] płacił kiedyś pilotowi stałą cenę za połów. Po ostatnim rozdziale pilot może dalej swobodnie łowić, handlować i przyjmować kontrakty na oceanie, który stoi teraz po stronie rebeliantów.", false],
	],
	"world/ocean": [
		[1, "", "Ocean to miejsce akcji gry DEEP: planeta, której zamieszkany świat leży głęboko pod falami. Osadnicy żyją na hermetycznych stacjach tysiące metrów pod powierzchnią, a łodzie podwodne są jedynym sposobem przemieszczania się między nimi. Wszystko, co kolonia je, sprzedaje i buduje, pochodzi z wody, od ryb i glonów po wytwarzane z nich towary. Ten artykuł opisuje ocean jako miejsce: jego głębiny, światło, faunę i florę oraz to, jak życie reaguje na ludzi, którzy na nie polują.", false],
		[1, "", "Pilot przybywa tu jako nowicjusz z małą łodzią rybacką i komputerem pokładowym, którym jest [[character/1]], i szybko zaczyna żałować, że nie został w domu. O ludziach zarządzających stacjami opowiada strona [[world/colony]], a o podróżach między nimi strona [[world/stream]].", false],
		[1, "Głębokość i ciśnienie", "Głębokość to najważniejsza cecha oceanu. Nie ma dna, które zatrzymałoby zanurzenie: łódź podwodna może opadać, dopóki woda jej nie zmiażdży. Statek utrzymuje przy życiu pas bezpiecznych głębokości wyznaczony przez jego wyposażenie. Osłona decyduje o tym, jak wysoko może się wznieść, a pancerz o tym, jak głęboko może zejść. Kadłub bez żadnego z nich jest bezpieczny tylko w wąskiej warstwie wody, mniej więcej od 22 000 do 23 000 m.", false],
		[1, "", "Poza swoim pasem statek jest miażdżony przez ciśnienie. Po kilku sekundach karencji woda zaczyna ścierać jego ochronę, najpierw jedną warstwę, a potem sam kadłub, a obrażenia rosną, im dalej statek wychodzi ponad 15 000 m lub poniżej 30 000 m. Krótkie wypady da się przetrwać, długie już nie. Wartości dla każdego elementu wyposażenia podaje jego własna strona, a pełne zasady wyjaśnia strona [[guide/depth]].", false],
		[1, "Gdzie leżą stacje", "Dwieście stacji z [[chart|mapy stacji]] jest zakotwiczonych na stałych głębokościach, niemal wszystkie między 15 000 a 30 000 m. Ponad połowa z nich, łącznie 109, leży między 20 000 a 25 000 m, czyli w pasie dostępnym dla startowego kadłuba [[ship/0]]. Około pięćdziesięciu leży płycej, a około czterdziestu pięciu głębiej. Skrajne przypadki to stacja [[station/28]], najwyżej położona, na 13 500 m, oraz stacja [[station/81]], najgłębsza, na 32 250 m.", false],
		[1, "", "Głębokość nie zależy od położenia na mapie. Płytkie i głębokie stacje sąsiadują ze sobą na całej mapie, więc sąsiedzi na mapie mogą dzielić tysiące metrów w pionie. Stacja [[station/14]], niedaleko środka mapy, leży w łatwym zasięgu zarówno stacji [[station/25]] na 17 700 m, jak i stacji [[station/81]] daleko pod nią. Pilot planujący trasę musi sprawdzać głębokość każdej stacji, a nie tylko odległość. Stacja [[station/0]], gdzie zaczyna się kariera pilota, leży na północnym zachodzie, na 22 500 m.", false],
		[1, "Światło i woda", "Do stacji nie dociera światło dzienne. Poza ich oświetlonymi reflektorami kadłubami woda jest ciemna, a łódź podwodna płynie w stożku własnych świateł, który woda pochłania w ciągu kilkudziesięciu metrów. W snopach światła unoszą się i dryfują drobne cząstki, a miejscami w mroku żarzą się słabe plamy świecącego planktonu. Wzniesienie się ponad 15 000 m, w stronę odległej powierzchni, jest odnotowywane jako osobne osiągnięcie: [[medal/21]].", false],
		[1, "", "Woda nie wszędzie ma ten sam kolor. Każdy region przybiera delikatny odcień od planktonu i glonów, które się w nim rozwijają, najsilniejszy w pobliżu stacji, gdzie te glony czują się najlepiej. Powolne prądy poruszają zawieszone w wodzie cząstki, ale są tylko elementem scenerii: nigdy nie spychają łodzi z kursu ani nie unoszą połowu.", false],
		[1, "Życie w morzu", "Ocean zamieszkuje trzynaście gatunków zwierząt i pięć gatunków glonów. Wśród nich są zarówno małe, łatwe zdobycze, takie jak [[species/2|meduzy]], [[species/0|łodziki]] i [[species/4|ławice ryb]], jak i silni pływacy, na przykład [[species/7]] czy [[species/8]]. Do osobliwości głębszych wód należą [[species/5]], [[species/1]], [[species/6]], [[species/9]] oraz opancerzone stworzenie [[species/11]]. [[species/3]] i zmieniające barwę stworzenie [[species/10]] są cenione za skórę i farbę.", false],
		[1, "", "Największym zwierzęciem jest [[species/12]]: może ważyć około 30 t, więcej niż cała ładownia małej łodzi podwodnej. Cięższe i twardsze zwierzęta dłużej walczą na harpunie i na ogół są więcej warte, ale żaden gatunek nie ma wszędzie tej samej ceny. Strona każdego gatunku wymienia stacje, na których wodach żyje, oraz towary z niego wytwarzane.", false],
		[1, "", "Każda stacja ma własną mieszankę fauny, zwykle pięć lub sześć gatunków. W wodach stacji pływa jednocześnie około dwudziestu zwierząt, wybranych z tej lokalnej mieszanki. Rybak szybko się uczy, które stacje odwiedzać po który połów, a mapa potrafi pokazać, gdzie występuje każdy już złowiony gatunek. Zob. [[guide/fishing]].", false],
		[1, "Dno morskie i glony", "Pięć gatunków glonów, [[species/17|zielone]], [[species/16|czerwone]], [[species/15|brunatne]], [[species/14|niebieskie]] i cenne [[species/13|złote]], to rośliny oceanu. Rosną zakorzenione w miejscu, zamiast pływać, każdy waży stałe 2 t, a na harpunie poddają się niemal od razu. Ich wartość tkwi w tym, czym się stają: [[goods/21]] wymaga zielonych glonów, [[goods/27]] złotych i czerwonych, a [[goods/28]] odrobiny wszystkich pięciu.", false],
		[7, "", "Glony rosną też na zewnętrznych powierzchniach samych stacji, razem z innymi drobnymi organizmami. Są ulubionym pożywieniem łodzików, dlatego te zwierzęta gromadzą się licznie wokół stacji.", false],
		[1, "Jak reaguje świat żywy", "Zwierzęta nie czekają po prostu, aż zostaną złowione. Stworzenie zranione ogniem z działa lub zabłąkanym strzałem rzuca się do ucieczki, a złapane na harpun szarpie się, aż opadnie z sił. Zwierzę zabite na miejscu przepada jako połów: jego truchło wypływa w górę i można je wyłowić jedynie jako towar [[goods/18]], wart ułamek żywego zwierzęcia. Piloci, którym zależy na czystym połowie, trzymają działa z dala od ryb.", false],
		[1, "", "W grze wody nigdy nie zostają przełowione. Gdy pilot odpływa, pozostawiona fauna zostaje uzupełniona, więc dobre łowisko pozostaje dobre. Spór o życie w morzu toczy się za to na tablicy kontraktów, gdzie jedni zleceniodawcy płacą za wytropienie gatunku, a inni za ochronę ławicy zwierząt przed myśliwymi. Zob. [[contract/7]] i [[contract/6]].", false],
		[4, "", "Od chwili, gdy pilot ma działo, [[character/1]] ostrzega przed strzelaniem do tych samych ryb, które przybyli łowić.", false],
		[7, "", "Kolonia traktuje dzikie zwierzęta, które wchodzą jej w drogę, jak uciążliwość do usunięcia. W [[chapter/7|rozdziale 7]] pilot zostaje wysłany, by oczyścić z łodzików wody stacji [[station/1]], gdzie podobno blokują trasy konwojów.", false],
		[9, "", "Odstrzał niewiele daje. Urzędnik, który za niego płaci, przyznaje, że zwierzęta wciąż wracają, bez względu na to, ile się ich usunie.", false],
		[15, "", "[[faction/rebels]] widzą morze inaczej. Biorą tylko to, co może ono oddać, przerabiają połów na towary i uważają, by nie przełowić łowisk, tak aby zachować różnorodność życia w oceanie.", false],
		[19, "", "W [[chapter/19|rozdziale 19]] pilot chroni ławicę [[species/10|barwnych kałamarnic]] w pobliżu stacji [[station/7]] przed myśliwymi kolonistów. Obok zwierząt płyną Akwarianie, najwyraźniej się nimi opiekując; zob. [[world/aquarians]].", false],
		[21, "", "Według przywódczyni rebeliantów, którą jest [[character/2]], szybka kolonizacja ogołaca ocean szybciej, niż jego rośliny i zwierzęta zdążą się odrodzić. Ostrzega, że jeśli tak dalej pójdzie, planeta skończy wyjałowiona, jak inne światy przed nią.", false],
		[48, "", "Gdy pod koniec wojny administracja kolonialna znika, rebelianci spodziewają się, że ocean będzie potrzebował dużo czasu, by się zagoić, ale zamierzają doprowadzić to do końca.", false],
		[1, "Niebezpieczeństwa głębin", "Poza ciśnieniem ocean kryje zagrożenia ze strony ludzi. [[faction/pirates]] polują na samotne statki na otwartych wodach, a w późniejszych rozdziałach niektórzy czyhają w pobliżu stacji. Pola minowe, dryfujące szczątki i uzbrojone konwoje pojawiają się w kontraktach i w fabule. O tym, kto kontroluje którą część oceanu, opowiadają strony [[world/colony]] i [[guide/allegiance]].", false],
	],
	"world/stream": [
		[1, "", "Sieć S.T.R.E.A.M. to system bram przejściowych łączących stacje kolonii. Każda stacja ma bramę w pewnej odległości od siebie, a łódź podwodna, która do niej wpłynie, niemal natychmiast wynurza się przy bramie innej stacji. Bez tej sieci przemierzanie [[chart|mapy stacji]] oznaczałoby długie rejsy przez ciemne, otwarte wody. Dzięki niej jeden pilot może pracować na całym oceanie. Sieć jest zarówno ważnym elementem rozgrywki, jak i stałym elementem świata; sterowanie opisuje strona [[guide/navigation]].", false],
		[1, "Bramy", "Każda stacja ma swoją bramę na otwartych wodach, z dala od doków. Statki opuszczają obszar stacji przez jej bramę i docierają do bramy celu, skąd płyną do doku. Bramę otwiera się z bliska: pilot wpływa w jej strefę aktywacji i otwiera mapę bramy, na której widnieje każda stacja w zasięgu.", false],
		[1, "", "Sama podróż jest niemal natychmiastowa. Statek wyłania się przy bramie docelowej z niezmienionymi uszkodzeniami, więc poobijana łódź podwodna dociera na miejsce wciąż poobijana. Lokalna fauna miejsca docelowego, patrole i ewentualne czekające tam starcie są już w wodzie.", false],
		[1, "Zasięg i silniki", "Brama nie sięga całego oceanu. Z każdej stacji obejmuje mniej więcej jedną szóstą szerokości mapy. Lepszy silnik zwiększa zasięg proporcjonalnie do swojego parametru, więc silnik o wartości +30% sięga o mniej więcej trzydzieści procent dalej. Stacje poza zasięgiem wymagają kilku skoków albo długiego rejsu na autopilocie, który jest znacznie wolniejszy nawet z przyspieszeniem czasu.", false],
		[1, "", "Rejsy po otwartych wodach przydają się przy krótkich trasach. Autopilot przeprowadza statek z obszaru jednej stacji do następnej, a przyspieszenie czasu może w tym czasie sięgać szesnastokrotności normalnej prędkości i spada, gdy pojawia się zagrożenie.", false],
		[1, "", "Sieć nie uwzględnia głębokości. Brama bez oporów dostarczy statek na stację leżącą poza jego pasem bezpiecznych głębokości, po ostrzeżeniu, a ciśnienie zaczyna ścierać jego ochronę, gdy tylko statek dotrze na miejsce. Przed wyruszeniem sprawdź głębokość celu na stronie stacji. Zob. [[guide/depth]].", false],
		[1, "Bramy i starcia", "Podczas walki bramy są zamknięte. Jeśli na wodach stacji trwa starcie związane z misją, ani z bramy, ani z doku nie można skorzystać, dopóki się nie rozstrzygnie. Pilot nie może po prostu uciec z zasadzki przez sieć, a każdy kontrakt trzeba doprowadzić do końca albo go oblać.", false],
		[1, "", "Przybycie przez bramę to też chwila, w której zaczynają się kłopoty. Wpłynięcie na obszar stacji uruchamia czekające tam starcie, od poszukiwanego przestępcy po konwój, który trzeba chronić. Statki patrolowe przepływają obok bram w ramach obchodów, a w późniejszych rozdziałach w pobliżu stacji mogą czekać piraci.", false],
		[1, "Nazwa", "Nazwa sieci jest zawsze zapisywana jako skrót, S.T.R.E.A.M., ale gra nigdy nie wyjaśnia, co oznaczają te litery. Pilot i [[character/1]] traktują bramy jako codzienną część życia, podobnie jak drogi czy koleje.", false],
		[1, "Rola w kolonii", "To sieć utrzymuje kolonię w całości. Zamienia dwieście rozproszonych stacji w jedną sprawnie działającą gospodarkę: połów można sprzedać daleko od miejsca, w którym go złowiono, a kontrakt może prowadzić przez całą mapę. Każde przybycie na nową stację liczy się do medalu [[medal/13]], a pierwsze dokowanie na każdej z nich do medalu [[medal/6]].", false],
		[5, "W fabule", "Pilot poznaje bramy wcześnie, gdy pierwsze polowanie na piratów prowadzi go poza okolice stacji [[station/0]]. Od tej pory niemal każda podróż w fabule przebiega przez nie, a autopilot może na życzenie doprowadzić statek do najbliższej bramy.", false],
		[12, "", "Bramy nie respektują granic politycznych. Gdy pilot po raz pierwszy wyrusza do ruchu oporu na stacji [[station/3]], statek trafia na wody, które rebelianci uważają za neutralne, i od razu zostaje zatrzymany przez strażników stacji.", false],
		[21, "", "Operacje rebeliantów wykorzystują bramy. Podczas misji przeciw bandzie piratów w pobliżu stacji [[station/8]] [[character/3]] czeka na pilota w pobliżu bramy stacji, zanim poprowadzi atak.", false],
		[45, "", "Podczas szturmu na stację [[station/18]] eskadra, którą dowodzi [[character/12]], czeka na pozycji w pobliżu bramy, tak aby atak mógł się zacząć w chwili przybycia pilota.", false],
	],
}
