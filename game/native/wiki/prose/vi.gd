const BLOCKS := {
	"chapter/1": [
		[1, "Tóm tắt", "Chiến dịch mở đầu ngoài khơi. Phi công, người mới đến hành tinh đại dương và đã ký hợp đồng làm ngư dân cho thuộc địa, đang ra biển trên một chiếc tàu ngầm nhỏ cùng [[character/1]], máy tính trên tàu hay nói. Chương này hướng dẫn đánh bắt bằng lao móc: ngắm vào một sinh vật, bắn lao móc, rồi giữ mục tiêu trong tầm nhìn khi nó vùng vẫy cho đến khi kiệt sức và có thể kéo vào. Xem [[guide/fishing]].", false],
		[2, "Kết quả", "Khi đã bắt được sinh vật đầu tiên, M.A.I. giới thiệu chế độ lái tự động, có thể điều khiển tàu đến một mục tiêu đã chọn, và chỉ đường cho phi công đến [[station/0]] để bán mẻ cá. Xem [[guide/navigation]].", false],
	],
	"chapter/10": [
		[10, "Tóm tắt", "Tại [[station/2]], cuộc phóng khoang đã bắt đầu và người Aquarian đang tấn công. [[character/9]] gửi qua radio một lời cảnh báo thẳng thừng: mất hơn năm khoang là không thể chấp nhận. Phi công phải đẩy lùi kẻ tấn công và giữ các khoang nguyên vẹn.", false],
		[11, "Kết quả", "Cuộc tấn công bị đẩy lùi, nhưng phi công vẫn băn khoăn vì sao người Aquarian lại nhắm vào các khoang. [[character/1]] cho rằng họ có thể thông minh hơn nhiều so với người định cư nghĩ. Phi công đến trạm để báo cáo, ngày càng nghi ngờ về công việc này.", false],
	],
	"chapter/11": [
		[11, "Tóm tắt", "Phi công cập bến [[station/2]] để báo cáo với [[character/9]] sau trận bảo vệ khoang.", false],
		[12, "Kết quả", "Jack đổ lỗi cho phi công về các khoang bị hư hại, hủy phần thưởng và bỏ đi kèm một câu rằng mình sinh ra để làm việc lớn. Sau đó [[character/1]] nêu ra một câu hỏi lớn hơn: phi công làm việc vất vả cho thuộc địa, kiếm được ít và chẳng có tiếng nói gì về mẻ cá. Phi công chỉ muốn đủ tiền mua vé rời khỏi hành tinh. M.A.I. tiết lộ rằng nó đã bắt được liên lạc radio của một phong trào kháng chiến đặt căn cứ tại [[station/3]] và đánh dấu trạm này trên bản đồ. Từ nay, các trạm kháng chiến hiện màu xanh lục.", false],
	],
	"chapter/12": [
		[12, "Tóm tắt", "Phi công đến [[station/3]] để tìm phong trào kháng chiến. Ý định tiếp cận lặng lẽ thất bại ngay lập tức: lính gác của trạm chặn tàu lại và đe dọa nổ súng. Phi công xưng tên, nói rằng chuyến đi bắt đầu từ [[station/0]] và xin gia nhập. Sau một khoảng im lặng căng thẳng, tàu được phép cập bến.", false],
		[13, "Kết quả", "Bên trong, [[character/4]] tra hỏi người mới đến. Phi công hầu như không biết gì ngoài việc phong trào ủng hộ tự do thương mại, điều này khớp với lời Pierre giải thích rằng mã hóa radio của họ chỉ vừa mới được bật. Đang thiếu người, Pierre nhận phi công vào thử việc. Phong trào dự định thuyết phục các lãnh đạo trạm của người định cư và chấm dứt việc bóc lột hành tinh. Nhiệm vụ đầu tiên là đón những người đồng tình tại [[station/4]] và đưa họ đến [[station/5]].", false],
	],
	"chapter/13": [
		[13, "Tóm tắt", "Phi công đến [[station/4]] để đón người liên lạc của phong trào, vẫn chưa hình dung rõ phong trào kháng chiến là gì hay công việc gồm những gì. [[character/1]] chỉ ra rằng dù sao việc này cũng thú vị hơn nhận lệnh từ [[character/9]], và phi công đồng ý.", false],
		[14, "Kết quả", "Người liên lạc là [[character/5]], ấm áp, nhanh nhẹn và rõ ràng rất vui được gặp phi công. Cô giữ kín kế hoạch của phong trào, nói rằng giữ bí mật là cách họ tồn tại đến nay, và gửi tọa độ cho chuyến đi. [[character/1]] quan sát hai người với vẻ bực bội ra mặt, khiến phi công trêu là nó ghen.", false],
	],
	"chapter/14": [
		[14, "Tóm tắt", "Với [[character/5]] trên tàu, phi công đưa cô đến [[station/5]] nhanh và an toàn nhất có thể.", false],
		[15, "Kết quả", "Tại [[station/5]], Leah đi ẩn náu để thu xếp một số việc. Trước khi đi, cô giải thích cách quân nổi dậy làm việc: họ chỉ lấy những gì biển có thể cho, chế biến mẻ cá thành hàng hóa và cẩn thận không đánh bắt quá mức. Cô đề nghị phi công thử làm và sản xuất năm tấn hàng hóa tại nhà máy của một trạm kháng chiến, gợi ý [[station/90]], nơi có thể bắt mực và mua [[goods/35]] để làm [[goods/22]].", false],
	],
	"chapter/15": [
		[15, "Tóm tắt", "Một chương về sản xuất. Phi công phải sản xuất năm tấn hàng hóa tại nhà máy của một trạm quân nổi dậy, kết hợp mẻ cá với nguyên liệu mua về thành sản phẩm có giá trị cao hơn nguyên liệu thô. Xem [[guide/trading]].", false],
		[16, "Kết quả", "[[character/5]] gọi lại. Giờ phi công đã có cách kiếm tiền thứ hai, cô giao một nhiệm vụ mới: ghé thăm càng nhiều trạm chưa biết càng tốt. Phong trào dùng thông tin mới từ mỗi trạm để tìm điểm yếu và lôi kéo dân chúng về phía mình. Khi phi công hỏi đây có phải một cuộc cách mạng không, cô từ chối nói thêm và khuyên trong lúc chờ đợi hãy kiếm tiền để nâng cấp tàu.", false],
	],
	"chapter/16": [
		[16, "Tóm tắt", "Phi công phải khám phá năm trạm chưa từng ghé. Việc khám phá mở rộng mạng lưới buôn bán và thu thập thông tin cho phong trào. Một số trạm có thể nằm ngoài giới hạn độ sâu hiện tại của tàu. Xem [[guide/depth]].", false],
		[17, "Kết quả", "[[character/4]] gửi một tin nhắn dài dòng, được [[character/1]] tóm gọn lại thành một ý duy nhất: phi công nên quay về [[station/3]] để nhận chỉ thị.", false],
	],
	"chapter/17": [
		[17, "Tóm tắt", "Phi công trở lại [[station/3]] theo yêu cầu của [[character/4]] và được cho cập bến.", false],
		[18, "Kết quả", "Pierre cho biết ngoại giao đã mở rộng vùng của quân nổi dậy, nên giờ phi công có thể buôn bán ở nhiều trạm hơn hẳn. Tin tức đã nói đến một cuộc cách mạng, và nhiều người có quyền quyết định đã gia nhập mà không đổ máu, dù Pierre ngờ rằng tình hình sẽ không mãi như vậy. Người lãnh đạo phong trào chỉ đạo các bước tiếp theo từ một trong những trạm vừa thu phục được và sẽ liên lạc. Pierre đánh dấu các trạm khả nghi và cảnh báo rằng đến được một số trạm có thể cần giáp hoặc khiên tốt hơn.", false],
	],
	"chapter/18": [
		[18, "Tóm tắt", "Phi công phải lần ra người lãnh đạo phong trào giữa các trạm vừa thu phục được, với rất ít manh mối ngoài vận may. Dấu vết dẫn đến [[station/6]].", false],
		[19, "Kết quả", "Tại [[station/6]], phi công gặp [[character/2]], người lãnh đạo phong trào và từ nay sẽ ra lệnh. Phi công vốn tưởng thủ lĩnh là đàn ông, điều bà gạt đi. Nhiệm vụ đầu tiên bà giao là hộ tống: một đàn [[species/10|bạch tuộc]] phải đến vùng nước an toàn trước khi người định cư bắt hoặc giết chúng, và nhiều khả năng sẽ có giao tranh. [[character/1]] càu nhàu rằng chẳng ai nhắc đến tiền công.", false],
	],
	"chapter/19": [
		[19, "Tóm tắt", "Gần [[station/7]], phi công phải bảo vệ một đàn [[species/10]] khỏi tàu của người định cư, đồng thời cẩn thận không bắn trúng lũ động vật. Người Aquarian đang bơi cùng đàn, và [[character/1]] tự hỏi liệu họ có chăm sóc các sinh vật biển hay không.", false],
		[20, "Kết quả", "Tàu của người định cư áp sát đàn động vật, và phi công phải chặn chúng trước khi chúng đến quá gần. Đàn sống sót. [[character/2]] trả một khoản thưởng khiêm tốn và yêu cầu phi công quay về ngay để nhận nhiệm vụ mới. M.A.I. phàn nàn rằng bắt rồi bán lũ động vật còn lời hơn.", false],
	],
	"chapter/2": [
		[2, "Tóm tắt", "Với cá trong khoang, phi công hướng về [[station/0]], trạm của người định cư chuyên thu mua mẻ cá trong ngày. Chương này là một chuyến đi đơn giản và là cơ hội đầu tiên để cập bến và tham quan một trạm.", false],
		[3, "Kết quả", "Tại [[station/0]], phi công gặp [[character/9]], người phụ trách thu mua cá. Hắn trả mức giá cố định như thường lệ, chế giễu khoang hàng nhỏ của phi công và gợi ý rằng ai có một khẩu súng thực sự thì có thể kiếm nhiều hơn bằng cách săn cướp biển. Khi hắn đi rồi, M.A.I. đồng ý rằng hắn thật khó chịu nhưng vẫn tiếp thu gợi ý: tình cờ [[equipment/0]] đang được bán trong xưởng tàu. M.A.I. cũng giải thích rằng trên mọi màn hình của trạm đều có phần trợ giúp.", false],
	],
	"chapter/20": [
		[20, "Tóm tắt", "Phi công trở về [[station/6]] để báo cáo với [[character/2]].", false],
		[21, "Kết quả", "Cuối cùng phi công hỏi Ayumi rằng phong trào theo đuổi điều gì. Bà mô tả một nhóm đoàn kết chống lại sự tàn phá hành tinh: việc thuộc địa hóa ồ ạt đang vắt kiệt tài nguyên nhanh hơn khả năng phục hồi của thiên nhiên, như đã xảy ra ở những thế giới khác, và mục tiêu là thuyết phục những người có ảnh hưởng đứng lên phản kháng. Trong khi đó, [[faction/pirates]] đang lợi dụng cuộc xung đột. Ayumi quyết định ra tay trước, phái phi công đi đánh một đội hình cướp biển cùng [[character/3]], một trong những phi công giỏi nhất của bà.", false],
	],
	"chapter/21": [
		[21, "Tóm tắt", "Gần [[station/8]], phi công cùng [[character/3]] tiêu diệt một băng cướp biển. Ngay từ đầu Raymond đã nóng vội và kẻ cả, bảo người mới cứ bám sau anh ta mà học.", false],
		[22, "Kết quả", "Băng cướp bị tiêu diệt. Raymond khen một cách miễn cưỡng, còn [[character/2]] trả cho mỗi người một khoản thưởng như nhau và hẹn gặp phi công tại [[station/9]]. Raymond giận dữ vì tiền bị chia đều và gạt bỏ đóng góp của phi công, và phi công rời đi trước khi anh ta nổi nóng hơn.", false],
	],
	"chapter/22": [
		[22, "Tóm tắt", "Phi công đến [[station/9]] để gặp [[character/2]], người vừa kết thúc các cuộc đàm phán ở đó. Một số trạm, trong đó có [[station/9]], nay đứng về phía phong trào.", false],
		[23, "Kết quả", "Trước khi đi, Ayumi muốn bảo đảm an toàn cho tuyến tiếp tế đến [[station/37]]. [[character/9]] đã rải một bãi thủy lôi ngay bên ngoài trạm để cắt đứt tuyến này. Ayumi biết hắn: từng là một nhân vật tầm thường, hắn thăng tiến nhanh nhờ các mối quan hệ hữu ích. Bà cảnh báo rằng nhiều khả năng cướp biển đang lượn quanh khu vực và thủy lôi chỉ có thể bị phá sau khi đã được kích hoạt.", false],
	],
	"chapter/23": [
		[23, "Tóm tắt", "Bên ngoài [[station/9]], phi công phải rà phá bãi thủy lôi chặn tuyến đường đến [[station/37]]. Ayumi đánh dấu các quả thủy lôi trên bản đồ. Phải tiến lại gần từng quả để kích hoạt cảm biến chuyển động của nó, và chỉ khi đó mới bắn được. Cướp biển rình rập gần đó chờ con mồi dễ xơi, nên phi công cũng phải xử lý chúng. Xem [[contract/10]].", false],
		[24, "Kết quả", "Bãi thủy lôi được rà phá và tuyến đường đến [[station/37]] lại an toàn. [[character/2]] hài lòng vì niềm tin của bà không đặt sai chỗ và trả tiền công cho phi công.", false],
	],
	"chapter/24": [
		[24, "Tóm tắt", "Phi công trở về [[station/9]] sau khi rà phá thủy lôi. Với tuyến tiếp tế đến [[station/37]] được mở lại, một nhóm lớn các trạm khắp đại dương nay buôn bán với phong trào, và vùng của quân nổi dậy trên bản đồ mở rộng đáng kể.", false],
		[25, "Kết quả", "Tại [[station/9]], phi công đoàn tụ với [[character/5]], cuộc trò chuyện ấm áp nhưng vụng về. [[character/2]] cắt ngang với công việc tiếp theo: các cuộc đàm phán tiếp tại [[station/10]] có thể kéo thêm nhiều trạm về phe. Phi công và Leah sẽ hộ tống Ayumi và [[character/3]] đến đó. Phi công không mấy hào hứng khi phải ra khơi cùng Raymond, nhưng Ayumi bảo đảm cho tay nghề của anh ta và không lường trước điều gì tệ hơn cướp biển.", false],
	],
	"chapter/25": [
		[25, "Tóm tắt", "Đoàn hộ tống đến [[station/10]] và nhận ra có điều gì đó không ổn. [[character/9]] đang chờ sẵn cùng lực lượng người định cư và ra lệnh tấn công. Ayumi không hiểu sao họ biết bà sẽ đến. Phi công phải cầm chân kẻ tấn công và giữ cho [[character/2]] sống sót.", false],
		[26, "Kết quả", "Trong trận đánh, [[character/3]] khai rằng vũ khí của anh ta bị hỏng và bỏ chạy. Những người còn lại sống sót. [[character/5]] buộc tội anh ta phản bội, trong khi Ayumi vẫn tin anh ta và nghi có kẻ phá hoại. Trước khi thêm người định cư kéo đến, cả nhóm tản ra: Ayumi đi ẩn náu, Leah lo liệu mọi việc ở [[station/9]], còn phi công được dặn phải trở thành một chiến binh giỏi hơn nhiều trước khi họ gặp lại.", false],
	],
	"chapter/26": [
		[26, "Tóm tắt", "Khi [[character/2]] đang ẩn náu và [[character/3]] đã biến mất, phi công phải tiêu diệt thêm mười tàu địch để chứng tỏ đã sẵn sàng cho những trận chiến khó khăn hơn phía trước. Cướp biển là mục tiêu thuận tiện, và các hợp đồng chiến đấu trên bảng hợp đồng còn có thêm nhiều mục tiêu. Đây là lúc thích hợp để nâng cấp vũ khí và giáp. Xem [[guide/combat]].", false],
		[27, "Kết quả", "[[character/3]] bất ngờ gọi đến, hỏi thăm Ayumi và Leah, và nói có thông tin khẩn cấp. Anh ta hẹn gặp gần [[station/11]]. [[character/1]] chắc chắn đó là một cái bẫy. Phi công đồng ý, và vẫn đi.", false],
	],
	"chapter/27": [
		[27, "Tóm tắt", "Gần [[station/11]], phi công đi theo các điểm đánh dấu đến cuộc gặp với [[character/3]], hoàn toàn chờ đợi một cái bẫy. Mục tiêu, trục vớt một con tàu bị vô hiệu hóa, ngầm báo rằng cuộc gặp sẽ không kết thúc bằng trò chuyện.", false],
		[28, "Kết quả", "Raymond đang giam giữ [[character/2]] và đòi phi công đầu hàng. Trong khi [[character/1]] quét tàu của hắn, phi công kéo dài cuộc nói chuyện. Raymond thừa nhận hắn đổi phe vì tiền: [[character/9]] đã treo thưởng cho cả Ayumi lẫn phi công. Kết quả quét cho thấy một con tàu một chỗ ngồi, vậy Ayumi phải ở trong khoang hàng bọc giáp. Phi công phá hủy tàu của Raymond và thu hồi thùng chứa trước khi nó chìm, rồi hướng về [[station/12]].", false],
	],
	"chapter/28": [
		[28, "Tóm tắt", "Phi công chở thùng chứa thu hồi được đến nơi an toàn là [[station/12]], trạm thân thiện gần nhất, với hy vọng [[character/1]] đoán đúng về thứ bên trong.", false],
		[29, "Kết quả", "[[character/2]] bước ra, run rẩy nhưng không bị thương, và cảm ơn phi công đã cứu mạng bà. Không có thời gian nghỉ ngơi. Trước khi bị bắt, bà đang tổ chức đưa một nhóm nhà khoa học tài năng đến [[station/14]], và có thể Raymond đã tiết lộ chi tiết. Phi công phải hộ tống đoàn tàu vượt qua vùng biên giới an toàn.", false],
	],
	"chapter/29": [
		[29, "Tóm tắt", "Gần [[station/13]], phi công thấy đoàn tàu của các nhà khoa học đang bị tấn công dữ dội, và đến vừa kịp lúc để giúp. Các tàu đồng minh kêu gọi hỗ trợ khi hàng phòng thủ của họ sụp đổ. Phi công phải đánh đuổi kẻ tấn công và hộ tống đoàn tàu vượt qua vùng biên giới. Mỗi con tàu bị mất đều đe dọa dự án bí mật của phong trào.", false],
		[30, "Kết quả", "Đoàn tàu vượt qua được, thủy thủ đoàn biết ơn vì được giải cứu. [[character/2]] gọi đó là một phen thoát hiểm trong gang tấc. [[character/2]] trả tiền cho phi công và hẹn gặp tại [[station/14]], nơi bà sẽ giải thích các bước tiếp theo.", false],
	],
	"chapter/3": [
		[3, "Tóm tắt", "Một chương hướng dẫn ngắn về lắp trang bị. Phi công ghé xưởng tàu ở [[station/0]] để mua và lắp [[equipment/0]], vũ khí đúng nghĩa đầu tiên của tàu. Chương này cho thấy cách mua trang bị và lắp vào một ô trống. Xem [[guide/fitting]].", false],
		[4, "Kết quả", "Khi khẩu súng điện từ đã được lắp, M.A.I. nhắc phi công không được bắn vào sinh vật biển vô hại và đề nghị lập tức thử súng với cướp biển.", false],
	],
	"chapter/30": [
		[30, "Tóm tắt", "Phi công đến [[station/14]], nơi đoàn tàu của các nhà khoa học đã tới.", false],
		[31, "Kết quả", "[[character/5]], [[character/4]] và [[character/2]] đang chờ. Ayumi giải thích kế hoạch: người định cư vẫn đông hơn quân nổi dậy, nên Giáo sư Abel và nhóm của ông sẽ chế tạo một vũ khí để cân bằng lực lượng, qua ba bước. Bước đầu tiên là một nguồn năng lượng, máy phát Biotek. Nguyên mẫu của Abel đã bị người định cư đánh cắp và họ đang tự tìm cách hoàn thiện nó. Leah cho biết thêm máy phát đang được chở cùng một đoàn tàu bình thường của người định cư gần [[station/2]]. Vì không ai biết tàu nào chở nó, phi công và Pierre phải chặn cả đoàn tàu và thu hồi mọi thùng chứa.", false],
	],
	"chapter/31": [
		[31, "Tóm tắt", "Gần [[station/2]], phi công, [[character/5]] và [[character/4]] chặn đoàn tàu của người định cư đang chở máy phát Biotek bị đánh cắp. Không ai biết tàu nào giữ máy phát, nên phải chặn mọi con tàu trong đoàn. Thủy thủ đoàn phản đối rằng họ chỉ chở lương thực và thuốc men, và [[character/4]] đáp lại bằng một câu đùa cay độc. Phi công phải vô hiệu hóa các tàu và dùng lao móc thu hồi mọi thùng chứa trước khi hàng chìm.", false],
		[32, "Kết quả", "Mọi thùng chứa đều được thu hồi, trong đó có máy phát, và cả nhóm trở về [[station/14]] để giao chiến lợi phẩm cho Giáo sư Abel.", false],
	],
	"chapter/32": [
		[32, "Tóm tắt", "Phi công trở về [[station/14]] với số hàng thu hồi được.", false],
		[33, "Kết quả", "Giáo sư Abel mang chiến lợi phẩm về phòng thí nghiệm. [[character/2]] cử [[character/5]] đi tuần tra bên ngoài [[station/14]], cử [[character/4]] xuống xưởng tàu, và giao cho phi công bước thứ hai. Máy phát cần một vũ khí xứng với công suất của nó: [[equipment/42]], một khẩu pháo phòng thủ trạm ngốn năng lượng đến mức chưa từng được lắp lên tàu. Nhà máy gần nhất, [[station/188]], nằm trong tay người định cư, nên phi công nên thử ở [[station/15]]. Khẩu pháo không được bán, vì vậy Ayumi giao một khoản tiền lớn để đút lót.", false],
	],
	"chapter/33": [
		[33, "Tóm tắt", "Bước thứ hai trong kế hoạch của [[character/2]] bắt đầu. Phi công lên đường đến [[station/15]], một trạm của quân nổi dậy, để kiếm một khẩu [[equipment/42]]. Khẩu pháo này thường được sản xuất tại trạm [[station/188]] của người định cư và không được bán công khai ở đâu cả. Phi công mang theo một khoản tiền đút lót lớn của Ayumi nhưng chẳng có kế hoạch gì cụ thể, và hy vọng cơ hội sẽ tự xuất hiện khi đến nơi.", false],
		[34, "Kết quả", "Phi công đến [[station/15]]. Không có người quen và không có kế hoạch, lựa chọn duy nhất là dạo quanh trạm xem có gì xảy ra.", false],
	],
	"chapter/34": [
		[34, "Tóm tắt", "Tại [[station/15]], manh mối bắt đầu từ hàng hóa của thương nhân địa phương. Mục tiêu là kiếm một chuyến hàng [[goods/37]], một mặt hàng bất hợp pháp ở trạm này, để thu hút đúng loại người cần chú ý.", false],
		[35, "Kết quả", "Một tay buôn chợ đen, [[character/8]], tiếp cận và đề nghị cung cấp hầu như mọi thứ. Khi phi công hỏi mua một khẩu [[equipment/42]], hắn sửng sốt nhưng đồng ý thử, đổi lại phi công phải giúp một việc: thủ tiêu [[character/11]], một thợ săn tiền thưởng được cơ quan an ninh thuê để trừ khử Fenko, đang tuần tra gần trạm.", false],
	],
	"chapter/35": [
		[35, "Tóm tắt", "Gần [[station/15]], phi công truy lùng [[character/11]], thợ săn tiền thưởng mà [[character/8]] muốn loại bỏ. Raoul không đi một mình: hắn mang theo hộ vệ và cố gạt phi công đi như một gã đánh cá tầm thường. Phi công phải tiêu diệt con tàu bị truy nã. Xem [[contract/0]].", false],
		[36, "Kết quả", "Tàu của Raoul bị tiêu diệt sau nỗ lực cuối cùng hòng thoát thân bằng lời lẽ, và đám hộ vệ của hắn bị đánh đuổi hoặc bị đánh chìm. Phi công quay về xem [[character/8]] có giữ lời hay không.", false],
	],
	"chapter/36": [
		[36, "Tóm tắt", "Phi công cập bến [[station/15]] để đòi [[character/8]] thực hiện lời hứa, không chắc có thể tin một tay buôn chợ đen sẽ giao hàng.", false],
		[37, "Kết quả", "Fenko đã tìm được một khẩu [[equipment/42]] và sẽ bán nó, với giá bị đội lên vì số tiền đút lót hắn đã chi. Khi phi công hỏi nó từ đâu ra, Fenko nêu tên người bán: [[character/9]]. [[character/1]] khoái chí trước sự trớ trêu khi lòng tham của Jack lại trang bị vũ khí cho chính kẻ thù của hắn. Phi công quyết định mua khẩu pháo và rời đi trước khi có gì thay đổi.", false],
	],
	"chapter/37": [
		[37, "Tóm tắt", "[[character/8]] giờ rao bán [[goods/38|Eclipse]] tại [[station/15]]. Phi công phải mua nó từ màn hình giao dịch và đưa lên tàu. Giá rất cao, nhưng khoản tiền đút lót của Ayumi vốn dành cho đúng việc này, và khoang hàng phải còn chỗ cho khẩu pháo lớn. Xem [[guide/trading]].", false],
		[38, "Kết quả", "Khẩu pháo đã nằm trong khoang hàng, điều mà [[character/1]] khó lòng tin nổi. Bước hai hoàn tất. Phi công quay về [[station/14]] để xem máy phát nguyên mẫu tiến triển đến đâu.", false],
	],
	"chapter/38": [
		[38, "Tóm tắt", "Phi công trở về [[station/14]] với [[equipment/42]] trong khoang hàng, háo hức xem Giáo sư Abel đã tiến xa đến đâu với nguyên mẫu.", false],
		[39, "Kết quả", "[[character/2]] không muốn biết khẩu pháo đã được kiếm bằng cách nào. Nguyên mẫu gần hoàn tất, nhưng có một bộ phận không thể chế tạo ở [[station/14]]: một [[goods/36]], thiết bị nhân bản DNA của các hạt tảo để khởi động phản ứng năng lượng của máy phát. Chỉ [[station/16]] có thiết bị để làm ra nó, nên bước thứ ba đưa phi công đến đó. [[character/1]] nhận xét rằng có vẻ phi công đang một mình gánh cả cuộc nổi dậy.", false],
	],
	"chapter/39": [
		[39, "Tóm tắt", "Bước thứ ba bắt đầu. Phi công đến [[station/16]], trạm duy nhất có thiết bị để làm ra [[goods/36]] mà máy phát Biotek cần. [[station/16]] nằm sâu hơn hầu hết các trạm khác, nên tàu có thể cần giáp tốt hơn mới đến được trạm an toàn. Xem [[guide/depth]].", false],
		[40, "Kết quả", "Phi công cập bến [[station/16]] và bắt đầu tìm hiểu những gì cần để làm lồng ấp, đoán trước rằng việc này chẳng hề đơn giản.", false],
	],
	"chapter/4": [
		[4, "Tóm tắt", "Một chương hướng dẫn về việc rời trạm. Phi công rời [[station/0]] để tìm cướp biển, nhưng vùng biển quanh đó yên ắng, nên M.A.I. đề nghị đi tiếp đến một trạm khác.", false],
		[5, "Kết quả", "M.A.I. giải thích về S.T.R.E.A.M.S, mạng lưới dòng hải lưu dùng cho các chuyến đi xa: tàu luôn rời một khu vực qua một cổng ra và đến khu vực tiếp theo qua một cổng vào, và chế độ lái tự động có thể lo liệu chuyến đi. Xem [[guide/navigation]].", false],
	],
	"chapter/40": [
		[40, "Tóm tắt", "Tại [[station/16]], phi công phải sản xuất một [[goods/36]] trong nhà máy của trạm. Lồng ấp là một sản phẩm cao cấp, và công thức của nó đòi hỏi nhiều nguyên liệu mà có thể phải bắt, mua hoặc chế tạo ở nơi khác trước. [[character/1]] đoán việc này sẽ phức tạp, và phi công cũng vậy. Xem [[guide/trading]].", false],
		[41, "Kết quả", "Lồng ấp đã hoàn thành. M.A.I. thừa nhận nó từng nghi ngờ phi công có làm nổi không. Vẫn băn khoăn liệu tất cả những việc này có đúng đắn không, phi công đặt lộ trình đến [[station/14]].", false],
	],
	"chapter/41": [
		[41, "Tóm tắt", "Phi công phải đưa [[goods/36]] đến [[station/14]] an toàn, nơi Giáo sư Abel đang chờ để hoàn thiện máy phát nguyên mẫu. Đây là mảnh ghép cuối cùng còn thiếu trong kế hoạch ba bước của [[character/2]].", false],
		[42, "Kết quả", "[[character/5]] nhận lồng ấp. Giáo sư Abel đã chuẩn bị sẵn mọi thứ, và [[equipment/42]] sẽ sớm có trong xưởng tàu. Ayumi muốn thử khẩu pháo ngay với cướp biển, và Leah chuyển tọa độ kèm lời cảnh báo rằng máy phát chỉ là nguyên mẫu. [[character/1]], được cho là đã tắt, tỏ rõ rằng nó nghe thấy từng lời.", false],
	],
	"chapter/42": [
		[42, "Tóm tắt", "Sau khi lắp [[equipment/42]] tại xưởng tàu ở [[station/14]], phi công hướng đến một sào huyệt cướp biển gần [[station/17]] để thử nó trong chiến đấu. Máy phát chỉ là nguyên mẫu, nên cuộc thử cũng là để kiểm tra nó có chịu được tải hay không. Cướp biển gọi tiếp viện ngay khi thấy đối thủ của mình là gì, và thêm tàu kéo đến giữa trận.", false],
		[43, "Kết quả", "Khi trận đánh kết thúc, [[character/1]] bắt được một tín hiệu cầu cứu từ [[station/14]], được gửi công khai trên một kênh không mã hóa. Phi công lập tức quay lại.", false],
	],
	"chapter/43": [
		[43, "Tóm tắt", "Lực lượng người định cư đã mở một cuộc tấn công bất ngờ vào [[station/14]]. Nhiều bến tàu bị hư hại và quân nổi dậy không thể xuất kích đủ tàu. [[character/9]] dẫn đầu cuộc tấn công và chế nhạo phi công, cho đến khi hắn nghe tin [[equipment/42]] đã sẵn sàng khai hỏa. Phi công phải bảo vệ trạm và các tàu đồng minh.", false],
		[44, "Kết quả", "Giữa trận chiến, người Aquarian xuất hiện và quay sang đánh người định cư, chiến đấu bên phía quân nổi dậy. Jack đào ngũ khi cuộc tấn công sụp đổ. [[character/2]] gọi cuộc giải cứu là một phép màu và yêu cầu phi công cập bến, nhắc đến một vị khách đặc biệt.", false],
	],
	"chapter/44": [
		[44, "Tóm tắt", "Phi công cập bến [[station/14]] sau trận chiến.", false],
		[45, "Kết quả", "Vị khách đặc biệt là một đại diện của người Aquarian. Người Aquarian sẽ giúp chấm dứt sự cai trị của người định cư, để mọi người có thể sống hòa hợp với biển cả. [[character/2]] lên kế hoạch cho hai cuộc tấn công lớn nhằm chiếm các trạm còn lại. Khi [[station/188]] đã nằm trong tay quân nổi dậy, càng nhiều tàu càng tốt đang được trang bị [[equipment/42]]. Phi công sẽ chỉ huy cuộc tấn công vào [[station/18]], với các đơn vị mới và sự hỗ trợ của người Aquarian, còn [[character/5]] chỉ huy cuộc tấn công vào [[station/109]].", false],
	],
	"chapter/45": [
		[45, "Tóm tắt", "Tại [[station/18]], phi công gặp [[character/12]], chỉ huy biệt đội Atmos, có các tàu đang chờ lệnh tấn công. Người Aquarian trồi lên từ đáy sâu để tham chiến. Phải tiêu diệt mọi tàu của người định cư, kể cả tàu chở hàng, trước khi có thể chiếm trạm. Trong khi đó [[character/5]] chỉ huy một cuộc tấn công song song vào [[station/109]].", false],
		[46, "Kết quả", "Lực lượng phòng thủ của người định cư cùng các tàu chở hàng bị quét sạch, và liên quân nổi dậy và Aquarian làm chủ vùng nước quanh trạm. Phi công cử một nửa biệt đội của Colin tuần tra quanh trạm và dẫn số còn lại vào cập bến.", false],
	],
	"chapter/46": [
		[46, "Tóm tắt", "Phi công cập bến [[station/18]] cùng một phần biệt đội của [[character/12]] để giữ trạm vừa chiếm được, trong khi số còn lại tuần tra bên ngoài.", false],
		[47, "Kết quả", "[[character/5]] báo rằng cuộc tấn công của cô vào [[station/109]] cũng thành công, và các trạm phía nam nay nằm dưới quyền kiểm soát của quân nổi dậy. Ayumi đã giao cho phi công nhiệm vụ có lẽ là cuối cùng: [[station/0]], thành trì lớn cuối cùng của người định cư và là trạm nơi câu chuyện của phi công bắt đầu. Trạm được phòng thủ kiên cố, và [[character/2]] đã lên đường. Leah theo sau, nhưng cướp biển đang chặn đường cô.", false],
	],
	"chapter/47": [
		[47, "Tóm tắt", "Tại [[station/0]], phi công cùng [[character/2]] và [[character/5]] bước vào trận chiến cuối cùng. Phải tiêu diệt mọi tàu phòng thủ trước khi có thể chiếm trạm. [[character/9]] có mặt trong số quân phòng thủ. Khi phi công nhắc đến số phận của [[character/3]], Jack tìm cách làm phi công rối trí bằng một câu chuyện hoang đường rằng hắn là cha của phi công và Raymond là anh em ruột của phi công. Phi công nhìn thấu ngay lập tức.", false],
		[48, "Kết quả", "Hạm đội người định cư lần lượt gục ngã cho đến khi chỉ còn lại Jack. Hắn tỏ ra nhanh nhẹn và nguy hiểm, nhưng cuối cùng phi công cũng vô hiệu hóa được tàu của hắn. Jack trốn thoát lên trên trong một khoang cứu hộ dường như kéo theo cả trạm, buông lời khinh miệt hành tinh khi rời đi. Trận chiến kết thúc.", false],
	],
	"chapter/48": [
		[48, "Tóm tắt", "Cuộc chiến đã thắng. Hạm đội người định cư bị đánh bại, [[character/9]] đã bỏ trốn khỏi hành tinh, còn [[station/0]] và những trạm cố thủ cuối cùng gia nhập quân nổi dậy. Mọi trạm nay đều đứng về phía phong trào.", false],
		[48, "", "Những người chiến thắng nhìn lại chặng đường. [[character/2]] cảm ơn phi công và [[character/5]], thừa nhận rằng sẽ mất nhiều thời gian để hàn gắn vết thương của hành tinh, nhưng bà tin họ cũng sẽ làm được. Leah mời phi công ăn mừng bên [[goods/21]], và phi công nhận lời. [[character/1]], được hứa nâng cấp bộ nhớ khi phi công trở lại đất liền, khăng khăng rằng nó chẳng cần thứ đó và tiếp tục trêu chọc đôi bạn đến tận cùng.", false],
		[48, "", "Chiến dịch đã hoàn tất. Phi công có thể tiếp tục khám phá, buôn bán và nhận hợp đồng khắp một thế giới nay đã yên bình dưới quân nổi dậy.", false],
	],
	"chapter/5": [
		[5, "Tóm tắt", "Trận chiến đầu tiên của phi công diễn ra gần [[station/1]]. M.A.I. giải thích cách chuyển đổi giữa vũ khí và lao móc, chế độ bắn tự động hỗ trợ ra sao và cách đọc radar: dấu đỏ là thù địch, dấu xanh lục là thân thiện và dấu vàng là điểm đánh dấu. Chẳng mấy chốc một tên [[faction/pirates|cướp biển]] đơn độc xuất hiện trên màn hình. Xem [[guide/combat]].", false],
		[6, "Kết quả", "Tên cướp biển bị tiêu diệt. M.A.I. chỉ ra rằng xác tàu để lại các thùng hàng, có thể dùng lao móc thu hồi trước khi chúng chìm ngoài tầm với, rồi đặt lộ trình quay về [[station/0]].", false],
	],
	"chapter/6": [
		[6, "Tóm tắt", "Phi công trở về [[station/0]] sau trận chiến thắng lợi đầu tiên, với một vũ khí hoạt động tốt và có thể cả ít hàng trục vớt được để bán. Đây là một chuyến đi ngắn trở về qua mạng lưới dòng hải lưu.", false],
		[7, "Kết quả", "[[character/9]] để ý thấy vũ khí mới và giao cái mà hắn gọi là việc thực sự. [[species/0|Ốc anh vũ]] đang tụ tập dày đặc trên các tuyến đoàn tàu quanh [[station/1]], và lực lượng an ninh của trạm muốn dẹp chúng đi. Phi công chỉ ra rằng chúng chỉ ăn rêu bám trên vỏ trạm và khoang hàng quá nhỏ để chở hết. Jack gạt bỏ cả hai ý kiến: lũ động vật phải biến mất, bằng bất cứ cách nào.", false],
	],
	"chapter/7": [
		[7, "Tóm tắt", "Gần [[station/1]], phi công phải dọn sạch [[species/0|ốc anh vũ]]. Giết hay bắt chúng đều được tính. Cả phi công lẫn [[character/1]] đều không thoải mái với công việc này, vì chúng hiếm và vô hại, nhưng cả hai vẫn đồng ý làm cho xong.", false],
		[8, "Kết quả", "Công việc khiến phi công bàng hoàng. Phi công đến hành tinh này để đánh cá, chứ không phải để tàn sát động vật cho tiện việc của thuộc địa. M.A.I. hy vọng tiền công ít nhất sẽ bù đắp được phần nào và đề nghị cập bến [[station/1]] để nhận tiền.", false],
	],
	"chapter/8": [
		[8, "Tóm tắt", "Phi công cập bến [[station/1]] để báo cáo về cuộc săn ốc anh vũ.", false],
		[9, "Kết quả", "Một viên chức người định cư tiếp phi công với thái độ khinh miệt chẳng buồn che giấu, coi công việc như diệt sinh vật gây hại và thừa nhận nó có lẽ vô ích vì lũ sinh vật cứ quay lại. Khoản tiền đưa ra rất ít và không được thương lượng. Trước khi giao thêm việc, viên chức muốn có bằng chứng về năng lực: ba công việc hoàn thành từ bảng hợp đồng của các trạm. [[character/1]] giải thích cách tìm hợp đồng, cảnh báo rằng một số địa điểm làm việc nằm ngoài giới hạn độ sâu của tàu, và chỉ cách lập lộ trình từ bản đồ của trạm.", false],
	],
	"chapter/9": [
		[9, "Tóm tắt", "Một chương về công việc tự do. Phi công phải hoàn thành ba hợp đồng từ bảng hợp đồng của bất kỳ trạm nào. Hợp đồng rất đa dạng, từ hộ tống, trục vớt đến đơn đặt hàng đánh bắt, và nên xem ở nhiều trạm. Xem [[guide/contracts]].", false],
		[10, "Kết quả", "Hài lòng, viên chức người định cư giao một nhiệm vụ đặc biệt. Những sinh vật kỳ lạ mà người định cư gọi là người Aquarian, nửa người nửa cá, đã tấn công các khoang vận chuyển đưa hàng hóa của thuộc địa lên quỹ đạo để thu gom. Khoang bị hư hại hay mất tích khiến trạm mang tiếng xấu với cơ quan thương mại. Lần phóng tiếp theo diễn ra tại [[station/2]], nơi [[character/9]] sẽ chỉ huy chiến dịch, và phi công phải đánh đuổi người Aquarian rồi báo cáo với hắn.", false],
	],
	"character/0": [
		[1, "", "Phi công là nhân vật của người chơi: một người mới đến thế giới đại dương bị thuộc địa hóa, lái một chiếc tàu ngầm nhỏ và kiếm sống bằng nghề đánh cá. Người chơi tự đặt tên cho phi công, và các bản tóm tắt chương ngắn trong nhật ký được viết như ghi chép của chính phi công. Phi công không bao giờ đơn độc trên biển, vì máy tính trên tàu, [[character/1]], bình luận về hầu hết mọi hành động. Câu chuyện bắt đầu tại [[station/0]], nơi phi công bán mẻ cá cho thuộc địa.", false],
		[1, "Lai lịch", "Cuộc sống của phi công trước chiến dịch hầu như không được kể lại. Phi công đến hành tinh này để đánh cá và hối hận về quyết định đó ngay từ nhiệm vụ đầu tiên, càu nhàu vì phải nghe lệnh một chiếc máy tính trên tàu. Mọi điều khác phải được ghép lại từ những gì phi công nói và làm.", false],
		[7, "", "Phi công hiểu rõ biển cả và các sinh vật của nó. Khi thuộc địa phàn nàn về [[species/0|ốc anh vũ]] tụ tập dày đặc trên các tuyến đoàn tàu, phi công chỉ ra rằng những con vật này ăn tảo và các sinh vật khác bám phủ vỏ trạm, nên sự hiện diện của chúng chẳng có gì lạ.", false],
		[12, "", "Ban đầu mục tiêu của phi công rất khiêm tốn. Phi công muốn kiếm đủ tiền mua vé rời khỏi hành tinh, và mức giá cố định trả cho mẻ cá khiến mục tiêu đó ngoài tầm với. Về sau, khi xin gia nhập phong trào kháng chiến, phi công khai [[station/0]] là quê nhà.", false],
		[1, "Ngư dân của thuộc địa", "Câu chuyện mở đầu với cảnh phi công lấp đầy khoang hàng và đặt lộ trình đến [[station/0]] ([[chapter/1]], [[chapter/2]]).", false],
		[3, "", "Ở đó [[character/9]] trả giá cố định cho mẻ cá, chế giễu khoang hàng nhỏ và gợi ý phi công nên thử săn [[faction/pirates|cướp biển]].", false],
		[6, "", "Phi công lắp một khẩu [[equipment/0]] và hạ tên cướp biển đầu tiên gần [[station/1]] ([[chapter/3]] đến [[chapter/5]]).", false],
		[7, "", "Sau đó [[character/9]] giao một việc kém dễ chịu hơn: dọn sạch [[species/0|ốc anh vũ]] khỏi các tuyến đường quanh [[station/1]] ([[chapter/7]]).", false],
		[8, "", "Cuộc tàn sát khiến phi công ghê tởm. Phi công đến đây để đánh cá, chứ không phải để giết hại những con vật vô hại.", false],
		[10, "", "Viên chức thuộc địa tại [[station/1]] trả rất ít, đòi ba hợp đồng làm bằng chứng về độ tin cậy ([[chapter/9]]) rồi cử phi công đi bảo vệ các khoang vận chuyển khỏi [[world/aquarians|người Aquarian]] tại [[station/2]] ([[chapter/10]]).", false],
		[12, "", "Phi công thắng trận nhưng bắt đầu băn khoăn vì sao [[world/aquarians|người Aquarian]] lại tấn công. Khi [[character/9]] đổ lỗi cho phi công về các khoang bị hư hại và giữ lại phần thưởng, [[character/1]] tiết lộ rằng nó đã nghe lén được một phong trào kháng chiến tại [[station/3]], và phi công quyết định đi tìm phong trào ấy ([[chapter/12]]).", false],
		[12, "Gia nhập phong trào kháng chiến", "Tại [[station/3]], lính gác của quân nổi dậy đe dọa nổ súng, và phi công phải lắp bắp xưng tên cùng mong muốn gia nhập trước khi được phép cập bến.", false],
		[13, "", "[[character/4]] nhận phi công vào thử việc, chủ yếu vì phong trào cần mọi bàn tay giúp sức, và cử phi công đi đón một người liên lạc từ [[station/4]] ([[chapter/13]]).", false],
		[14, "", "Người liên lạc là [[character/5]], và phi công rõ ràng bị cô cuốn hút trong lúc chở cô đến [[station/5]] ([[chapter/14]]).", false],
		[16, "", "[[character/5]] cho phi công thấy cách quân nổi dậy sống nhờ biển ([[chapter/15]]) rồi nhờ phi công đi thám thính các trạm mới cho phong trào ([[chapter/16]]). Đây là lần đầu tiên phi công nghe đến từ cách mạng.", false],
		[18, "", "Trở lại [[station/3]], [[character/4]] báo cáo những thắng lợi ngoại giao của phong trào và cử phi công đi tìm người lãnh đạo, gần như không có manh mối nào ([[chapter/18]]).", false],
		[19, "Phục vụ người lãnh đạo", "Người lãnh đạo là [[character/2]], người gặp phi công tại [[station/6]]; phi công vốn tưởng sẽ gặp một người đàn ông. Mệnh lệnh đầu tiên của bà là bảo vệ một đàn [[species/10|mực đổi màu]] khỏi thợ săn của người định cư ([[chapter/19]]).", false],
		[21, "", "Khi cuối cùng bà giải thích mục tiêu của phong trào, phi công dấn thân vì lý tưởng ấy. Bà cử phi công cùng phi công cừ khôi của bà, [[character/3]], đi đánh một băng cướp biển ([[chapter/21]]).", false],
		[23, "", "[[character/3]] coi phi công là của nợ. Tại [[station/9]], phi công biết rằng [[character/9]] nay là kẻ thù của phong trào và hăng hái rà phá bãi thủy lôi hắn rải trên một tuyến tiếp tế của quân nổi dậy ([[chapter/23]]).", false],
		[25, "", "Đoàn tụ với [[character/5]], phi công được giao hộ tống [[character/2]] và [[character/3]] đến cuộc đàm phán tại [[station/10]] ([[chapter/25]]).", false],
		[26, "", "Lực lượng của [[character/9]] đang chờ sẵn. [[character/3]] bỏ chạy, khai rằng vũ khí bị hỏng, và chỉ còn phi công cùng [[character/5]] bảo vệ [[character/2]]. Sau đó [[character/2]] đi ẩn náu và bảo phi công phải trở thành một chiến binh giỏi hơn nhiều ([[chapter/26]]).", false],
		[27, "Phản bội và giải cứu", "Về sau [[character/3]] gọi đến, hứa cung cấp thông tin khẩn cấp. Phi công ngờ là bẫy nhưng vẫn đồng ý gặp hắn gần [[station/11]] ([[chapter/27]]).", false],
		[28, "", "Đó đúng là một cái bẫy: [[character/3]] giam giữ [[character/2]] và đòi phi công đầu hàng. Theo kế hoạch của [[character/1]], phi công kéo dài cuộc nói chuyện trong khi nó quét tàu của hắn, và bảo hắn rằng cuộc chiến này là vì niềm tin chứ không phải vì tiền. Sau đó phi công phá hủy tàu của hắn và thu hồi khoang hàng bọc giáp, với [[character/2]] còn sống bên trong, trước khi nó chìm quá sâu ([[chapter/28]]).", false],
		[31, "Kế hoạch ba bước", "Sau khi bảo vệ đoàn tàu của các nhà khoa học ([[chapter/29]]), phi công được biết kế hoạch của [[character/2]] nhằm chế tạo một vũ khí cùng [[world/abel]]. Cùng [[character/4]] và [[character/5]], phi công cướp lấy [[world/biotek]] từ một đoàn tàu của người định cư ([[chapter/31]]).", false],
		[33, "", "Tiếp theo, phi công phải kiếm một khẩu pháo [[equipment/42]] không được bán ở đâu, trong tay chỉ có một quỹ đút lót. Phi công nhận xét rằng nhiệm vụ này được lên kế hoạch quá sơ sài nhưng vẫn vui vẻ nhận lời ([[chapter/33]]).", false],
		[37, "", "Tại [[station/15]], tay buôn chợ đen [[character/8]] đồng ý tìm một khẩu nếu phi công giết thợ săn tiền thưởng [[character/11]] ([[chapter/35]]). Phi công làm theo, và mua một khẩu pháo mà [[character/8]] có được từ [[character/9]] ([[chapter/37]]).", false],
		[39, "", "[[character/2]] không muốn biết khẩu pháo được tìm ra bằng cách nào, và phi công chỉ nói rằng không có người vô tội nào phải chết. Khi phi công đùa rằng kế hoạch này có thể dùng để thống trị hành tinh, bà dứt khoát bác bỏ ý đó ([[chapter/39]]).", false],
		[42, "", "Sau đó phi công sản xuất [[goods/36]] tại [[station/16]] và mang nó đến [[station/14]], hoàn thiện vũ khí ([[chapter/41]]).", false],
		[43, "Con đường đến chiến thắng", "Trong lúc thử vũ khí hoàn chỉnh với cướp biển gần [[station/17]], phi công nghe thấy tín hiệu cầu cứu từ [[station/14]] và quay về thì thấy [[character/9]] đang dẫn đầu một cuộc tấn công bất ngờ ([[chapter/43]]).", false],
		[44, "", "Với sự giúp đỡ của [[world/aquarians|người Aquarian]], cuộc tấn công bị đập tan và [[character/9]] bỏ chạy.", false],
		[46, "", "[[character/2]] giao cho phi công chỉ huy cuộc tấn công vào [[station/18]] ([[chapter/45]]). Mối lo đầu tiên của phi công là cho [[character/5]], người chỉ huy cuộc tấn công thứ hai, nhưng phi công chiếm được trạm với biệt đội của [[character/12]] và sự hỗ trợ của [[world/aquarians|người Aquarian]].", false],
		[47, "", "Trận chiến cuối cùng diễn ra tại [[station/0]], nơi câu chuyện bắt đầu ([[chapter/47]]). [[character/9]] tìm cách làm phi công rối trí bằng cách tự nhận là cha của phi công, còn [[character/3]] là anh em ruột của phi công, nhưng phi công lập tức gạt bỏ lời dối trá.", false],
		[48, "", "[[character/9]] bị đánh đuổi và thành trì cuối cùng của thuộc địa thất thủ. Phi công dành công lao cho những người bạn đã sát cánh chiến đấu và nhận lời mời ăn mừng của [[character/5]].", false],
		[1, "Tính cách", "Phi công thực tế và nhanh mồm nhanh miệng, thích cãi lại hơn là vâng lời. Những màn đấu khẩu giữa phi công và [[character/1]] kéo dài suốt chiến dịch.", false],
		[8, "", "Đằng sau những câu đùa, phi công có lương tâm. Phi công không thích giết động vật để kiếm lời và cảm thấy buồn nôn sau cuộc tàn sát ốc anh vũ.", false],
		[14, "", "Bên cạnh [[character/5]], phi công trở nên ấp úng và vụng về, điều mà cả cô lẫn [[character/1]] đều nhận ra.", false],
		[28, "", "Động cơ của phi công thay đổi qua chiến dịch. Đến lúc đối đầu với [[character/3]], phi công khẳng định cuộc đấu tranh là vì lý tưởng và lòng tham đã làm hắn mù quáng.", false],
		[1, "Các mối quan hệ", "[[character/1]] là người bạn đồng hành thân thiết nhất của phi công. Hai bên cãi nhau suốt, nhưng phi công dựa vào lời khuyên của nó và, về sau, vào sự mưu trí của nó.", false],
		[3, "", "[[character/9]] là người chủ đầu tiên của phi công và trở thành đối thủ lâu dài của phi công.", false],
		[14, "", "Phi công bị [[character/5]] thu hút ngay từ lần gặp đầu tiên, và tình cảm ấy có vẻ là từ cả hai phía.", false],
		[19, "", "[[character/2]] dần tin tưởng giao cho phi công những nhiệm vụ tế nhị nhất của phong trào. Bà đối xử với phi công bằng sự ấm áp và một uy quyền hay trêu chọc, gần như của bậc cha mẹ.", false],
		[1, "Với tư cách nhân vật của người chơi", "Khi chơi, phi công là bất cứ ai mà người chơi tạo nên. Giữa các mục tiêu của chương, phi công tự do đánh cá, buôn bán, nhận hợp đồng, chiến đấu và trang bị lại tàu; câu chuyện chỉ tiến triển khi mục tiêu của chương được hoàn thành. Những điều cơ bản được trình bày trong [[guide/basics]].", false],
	],
	"character/1": [
		[1, "", "[[character/1]] là máy tính trên chiếc tàu ngầm của phi công và là bạn đồng hành của phi công suốt chiến dịch. Nó vận hành các hệ thống của tàu, giải thích cách đánh cá, di chuyển và chiến đấu, và đưa ra không ngớt lời khuyên cùng bình luận. Óc hài hước của nó khô khan và thường nhắm vào phi công, nhưng nó tỏ ra là thứ gì đó hơn hẳn một cuốn sách hướng dẫn biết nói.", false],
		[1, "Vai trò bạn đồng hành", "Trên thực tế, [[character/1]] là người hướng dẫn của trò chơi. Mỗi cơ chế mới đều được giới thiệu qua nó: đánh bắt bằng lao móc, chế độ lái tự động và, tại các trạm, các màn hình trợ giúp. Nó lên tiếng qua radio trong các nhiệm vụ, chỉ ra mục tiêu và cảnh báo nguy hiểm.", false],
		[5, "", "Nó cũng giải thích cách di chuyển đường dài qua mạng lưới [[world/stream]] và cách đọc radar, nơi kẻ thù và bạn bè hiện thành các chấm màu còn điểm đánh dấu chỉ lộ trình. Sau mỗi trận đánh, nó nhắc phi công thu hồi hàng hóa mà tàu bị đánh bại để lại.", false],
		[12, "", "Vai trò của nó không chỉ dừng ở hướng dẫn. Nó dò các kênh radio, đánh dấu trạm trên bản đồ và chuyển tiếp tin nhắn.", false],
		[28, "", "Nó còn có thể quét các tàu khác ở cự ly gần, một khả năng tỏ ra quyết định trong cuộc đối đầu với [[character/3]].", false],
		[1, "Vai trò trong câu chuyện", "Chiến dịch mở đầu với cảnh [[character/1]] nhắc phi công rằng công việc là đánh cá, chứ không phải than phiền.", false],
		[3, "", "Nó không hề giấu việc đánh giá thấp [[character/9]] và thúc giục phi công mua khẩu [[equipment/0]] đang được bán.", false],
		[4, "", "Khi vũ khí đã được lắp, nó giục thử súng với cướp biển và dẫn đầu cuộc tìm kiếm chúng.", false],
		[7, "", "Nó không vui với cuộc tàn sát [[species/0|ốc anh vũ]] và hỏi tại sao những con vật này phải chết, khi chúng vốn đã quá ít ỏi.", false],
		[8, "", "Sau cuộc săn, nó nhận ra phi công bàng hoàng đến mức nào, và như thường lệ, ý nghĩ đầu tiên của nó là liệu công việc có ít nhất được trả công tử tế không.", false],
		[11, "", "Khi [[world/aquarians|người Aquarian]] tấn công các khoang tại [[station/2]], nó là người đầu tiên cho rằng những sinh vật này có thể thông minh hơn nhiều so với người định cư nghĩ.", false],
		[12, "Bước ngoặt", "[[character/1]] khởi động mạch truyện chính. Sau khi [[character/9]] lừa phi công thêm một lần nữa, nó lập luận rằng phi công làm việc vất vả mà được đền đáp ít ỏi và chẳng có tiếng nói gì về mẻ cá. Nó tiết lộ đã nghe lén được tín hiệu của một phong trào kháng chiến đang hình thành tại [[station/3]], đánh dấu trạm trên bản đồ và để phi công tự quyết định ([[chapter/12]]).", false],
		[12, "", "Khi đến nơi, nó đề nghị tiếp cận lặng lẽ, rồi bỏ ngay ý đó khi lính gác của quân nổi dậy lập tức chặn tàu lại.", false],
		[14, "Giữa quân nổi dậy", "Nó lập tức khó chịu với sự thân mật giữa phi công và [[character/5]]. Khi phi công trêu là nó ghen, nó đáp lại bằng cách nhại một cách mỉa mai câu cửa miệng của [[character/5]]. Những lời bóng gió của nó về đôi bạn kéo dài đến tận cuối chiến dịch.", false],
		[17, "", "Nó chuyển tiếp tin nhắn của phong trào, tóm gọn một trong những bức thư dài dòng của [[character/4]] trong một câu duy nhất.", false],
		[18, "", "Nó nghi ngờ quân nổi dậy được tổ chức tốt khi phi công bị cử đi tìm người lãnh đạo của họ mà gần như không có manh mối.", false],
		[19, "", "Với [[character/2]], nó bộc lộ mặt tính toán chuyện tiền nong, hỏi sao phi công làm việc mà không bàn đến tiền công. Khi phi công bênh vực [[character/2]], nó nói kháy rằng ít ra nó thì chẳng bao giờ phải ăn.", false],
		[22, "", "Nó ngưỡng mộ tay nghề của [[character/3]] nhưng khuyên phi công tránh xa tính khí nóng nảy của anh ta.", false],
		[27, "Con tin", "Khi [[character/3]] gọi đến đề nghị gặp mặt, [[character/1]] khẳng định đó là một cái bẫy.", false],
		[28, "", "Tại cuộc gặp, nó cho thấy giá trị thực sự của mình. Nó bảo phi công kéo dài cuộc nói chuyện với [[character/3]], biết rằng một kẻ cảm thấy an toàn sẽ khoe khoang về động cơ của mình. Trong lúc đó nó quét tàu của hắn, nhận ra tàu chỉ có một chỗ ngồi và kết luận rằng [[character/2]] hẳn đang ở trong khoang hàng bọc giáp. Nhận định đó giúp phi công phá hủy con tàu mà vẫn cứu được [[character/2]] ([[chapter/27]]).", false],
		[33, "Cuộc chiến", "Qua các nhiệm vụ [[world/biotek]] và [[world/eclipse|Eclipse]], nó không ngừng than phiền về tiền công ít ỏi.", false],
		[37, "", "Nó khoái chí trước sự trớ trêu khi khẩu pháo hóa ra đến từ [[character/9]], kẻ có lòng tham đã vũ trang cho chính kẻ thù của mình.", false],
		[39, "", "Nó càu nhàu rằng có vẻ phi công đang một mình gánh cả cuộc nổi dậy.", false],
		[41, "", "Về sau nó lấy chính câu trả lời của phi công cho lời phàn nàn ấy để đáp trả lại phi công.", false],
		[42, "", "Khi [[character/5]] nồng nhiệt chào đón phi công tại [[station/14]], nó tuyên bố sẽ tự tắt máy, dù hóa ra nó chỉ chuyển sang chế độ chờ.", false],
		[43, "", "Trong lúc thử khẩu pháo ngoài thực địa, nó bắt được một tín hiệu cầu cứu công khai, không mã hóa từ [[station/14]] và lập tức nhận ra có chuyện rất không ổn.", false],
		[44, "", "Trong trận chiến sau đó, nó là người đầu tiên báo rằng [[world/aquarians|người Aquarian]] đã đến chiến đấu bên phía quân nổi dậy.", false],
		[48, "", "Khi chiến tranh kết thúc, phi công hứa nâng cấp bộ nhớ cho nó, một lời đề nghị mà nó thấy hơi bị xúc phạm. Lời cuối cùng của nó về chiến dịch là thêm một nhận xét khô khan về phi công và [[character/5]].", false],
		[1, "Tính cách", "[[character/1]] thông minh, thẳng thắn và thiếu kiên nhẫn với kẻ huênh hoang. Nó thích chỉ ra những vụ làm ăn tồi và hiếm khi bỏ lỡ dịp trêu chọc.", false],
		[8, "", "Nó cũng biết quan tâm hơn mức nó chịu thừa nhận. Nó không thích giết chóc vô ích và luôn để mắt đến tâm trạng của phi công.", false],
		[28, "", "Cái đầu lạnh của nó dưới áp lực đã cứu vãn tình thế khi phi công bế tắc.", false],
		[1, "Các mối quan hệ", "Nó và phi công cãi nhau suốt nhưng hoàn toàn tin tưởng nhau.", false],
		[3, "", "Nó ghét [[character/9]] ngay từ cái nhìn đầu tiên.", false],
		[14, "", "Sự ghen tuông của nó với [[character/5]] là một trò đùa lặp đi lặp lại.", false],
		[19, "", "Nó tôn trọng [[character/2]] nhưng phàn nàn bà trả công quá ít.", false],
		[22, "", "Nó nhanh chóng đánh giá [[character/3]] và hóa ra đã đúng về anh ta.", false],
	],
	"character/10": [
		[5, "", "[[character/10]] là cái tên dùng cho những phi công ngoài vòng pháp luật của phe [[faction/pirates]] lên tiếng trong các nhiệm vụ. Chúng cướp bóc tàu thuyền khắp đại dương và là mục tiêu đầu tiên của phi công khi tàu đã có vũ khí.", false],
		[6, "Ai lên tiếng", "Một tên cướp biển là kẻ thù đầu tiên phi công đối mặt, gần [[station/1]], và gục ngã với một tiếng gào giận dữ ([[chapter/5]]).", false],
		[21, "", "Khi xung đột giữa người định cư và quân nổi dậy leo thang, cướp biển lợi dụng sự hỗn loạn để săn những con mồi dễ dàng, và [[character/2]] quyết định quân nổi dậy phải đánh trả ([[chapter/21]]).", false],
		[43, "", "Gần [[station/17]], một băng cướp biển trở thành mục tiêu đầu tiên của khẩu [[world/eclipse|Eclipse]]. Một tên hoảng loạn trước hỏa lực của phi công và gọi cứu viện, kéo thêm cướp biển vào trận ([[chapter/42]]). Cách đánh chúng được trình bày trong [[guide/combat]].", false],
	],
	"character/11": [
		[35, "", "[[character/11]] là một thợ săn tiền thưởng được cơ quan an ninh của [[station/15]] thuê để trừ khử tay buôn chợ đen [[character/8]]. [[character/8]] đòi mạng hắn làm cái giá cho một khẩu [[world/eclipse|Eclipse]].", false],
		[35, "Lai lịch", "Theo [[character/8]], [[character/11]] tuần tra vùng nước gần [[station/15]]. Hắn là một kiểu người thực thi pháp luật, làm việc cho chính quyền trạm, và mục tiêu của hắn là một tên tội phạm. Điều này khiến nhiệm vụ của phi công gây day dứt về mặt đạo đức: để có được vũ khí mà quân nổi dậy cần, phi công phải giết một người vì một tay buôn hàng cấm.", false],
		[36, "Vai trò trong câu chuyện", "Khi phi công tìm thấy hắn, [[character/11]] không đi một mình; hắn đi cùng vài tàu hộ tống. Hắn ra lệnh cho phi công tránh đường, gọi phi công là kẻ đánh cá và khăng khăng rằng hắn còn việc phải làm. Khi trận đánh trở nên bất lợi, hắn hỏi liệu rốt cuộc hai bên có thể giải quyết êm thấm không. Tàu của hắn bị phá hủy ([[chapter/35]]).", false],
		[37, "", "Cái chết của hắn mang lại cho phi công sự giúp đỡ của [[character/8]], và chẳng bao lâu tay buôn chào bán khẩu pháo.", false],
		[39, "", "Về sau phi công chỉ nói với [[character/2]] rằng không có người vô tội nào phải chết để có được khẩu pháo.", false],
		[36, "Tính cách", "[[character/11]] tự tin và coi thường người khác cho đến khi thua thế, rồi nhanh chóng tìm đường thoát. Hắn coi phi công là một trở ngại nhỏ, một ngư dân tầm thường lạc vào đường của hắn, và đánh giá phi công thấp một cách tai hại.", false],
	],
	"character/12": [
		[45, "", "[[character/12]] là chỉ huy biệt đội Atmos, một đơn vị [[faction/rebels|quân nổi dậy]] tham gia cuộc tấn công của phi công vào [[station/18]] trong các cuộc tổng tấn công cuối cùng.", false],
		[45, "Vai trò trong câu chuyện", "[[character/2]] hứa sẽ tập hợp các đơn vị cho phi công trong khi phi công đến [[station/18]]. Biệt đội của [[character/12]] là một trong số đó. Khi phi công đến nơi, anh báo rằng các tàu của mình đã vào vị trí và đang chờ lệnh tấn công. Cùng lúc đó một nhóm [[world/aquarians|người Aquarian]] từ đáy sâu kéo đến, và trận chiến bắt đầu theo lệnh của phi công ([[chapter/45]]).", false],
		[46, "", "Cùng nhau, họ tiêu diệt mọi tàu của người định cư, không tha cả tàu chở hàng.", false],
		[46, "", "Sau trận đánh, phi công ra lệnh cho [[character/12]] cử một nửa số tàu tuần tra quanh trạm trong khi số còn lại cập bến cùng phi công để nắm quyền kiểm soát. Anh tuân lệnh không chút thắc mắc.", false],
		[47, "", "Đây là trận đánh đầu tiên mà tàu quân nổi dậy và [[world/aquarians|người Aquarian]] sát cánh chiến đấu dưới quyền chỉ huy của phi công, và thắng lợi của nó mở đường cho cuộc tấn công cuối cùng vào thuộc địa.", false],
		[45, "Tính cách", "[[character/12]] nói ngắn gọn và tuân lệnh nhanh chóng. Anh là sĩ quan nổi dậy đầu tiên phục vụ dưới quyền chỉ huy của phi công, một dấu hiệu cho thấy phi công đã thăng tiến xa đến đâu kể từ những ngày đánh cá cho thuộc địa. Phong cách nói qua radio dứt khoát, đâu ra đấy của anh tương phản với những màn đấu khẩu của các bạn đồng hành khác của phi công.", false],
	],
	"character/2": [
		[18, "", "[[character/2]] là một thành viên của [[faction/rebels|phong trào kháng chiến]] mà phi công gặp tại [[station/6]].", false],
		[19, "", "Bà là người lãnh đạo phong trào, một phụ nữ lớn tuổi nắm quyền chỉ huy các nhiệm vụ của phi công ngay từ lần gặp đầu tiên. Điềm tĩnh, ấm áp và quyết đoán, bà điều khiển cuộc đấu tranh của phong trào chống lại sự cai trị của thuộc địa.", false],
		[21, "Lai lịch", "Phong trào do [[character/2]] lãnh đạo tự xem mình là sự liên kết của những người phản đối việc tàn phá hành tinh. Theo bà, tốc độ thuộc địa hóa và việc khai thác biển một cách tàn nhẫn khiến cây cỏ và động vật của biển không có thời gian phục hồi, và những thế giới khác đã bị vắt kiệt theo cùng một cách. Chiến lược của bà là lôi kéo những người điều hành các trạm thay vì chiến đấu.", false],
		[23, "", "Bà biết [[character/9]] từ trước. Khi bà mới gặp hắn, hắn chỉ là kẻ vô danh tiểu tốt, và bà tin rằng hắn thăng tiến nhờ đúng mối quan hệ chứ không nhờ tài năng gì.", false],
		[31, "", "Bà có một mạng lưới người cung cấp tin giữa các trạm và đủ quyền hạn để điều động các nhà khoa học, tiền bạc và tàu thuyền khắp vùng của quân nổi dậy.", false],
		[19, "Vai trò trong câu chuyện", "Mệnh lệnh đầu tiên của [[character/2]] là một nhiệm vụ hộ tống: phi công phải bảo vệ một đàn [[species/10|mực đổi màu]] khỏi thợ săn của người định cư ([[chapter/19]]). Bà không nói gì về tiền công và rất ít về kế hoạch của phong trào, có vẻ đang thử xem người mới có đáng tin không. Phi công thừa nhận đã tưởng sẽ gặp một người đàn ông, và bà bỏ qua chuyện đó.", false],
		[20, "", "Bà thưởng cho công việc một cách khiêm tốn và gọi phi công về ngay để nhận thêm việc.", false],
		[21, "", "Khi phi công đòi câu trả lời, bà giải thích mục tiêu của phong trào. Bà cũng quyết định rằng bọn cướp biển, kẻ đang lợi dụng cuộc xung đột, cần được dạy cho một bài học, và cử phi công cùng chiến binh giỏi nhất của bà, [[character/3]], đi đánh một băng cướp gần [[station/8]] ([[chapter/21]]).", false],
		[22, "", "Bà chia đều phần thưởng cho hai phi công, khiến [[character/3]] bực bội, rồi chuyển sang các cuộc đàm phán tại [[station/9]].", false],
		[23, "", "Ở đó bà cử phi công rà phá bãi thủy lôi mà [[character/9]] rải trên tuyến tiếp tế đến [[station/37]], cảnh báo về cướp biển và về những quả thủy lôi chỉ có thể bị phá hủy sau khi đã được kích hoạt ([[chapter/23]]).", false],
		[25, "Cuộc phục kích", "Mục tiêu tiếp theo của [[character/2]] là [[station/10]], nơi các cuộc đàm phán tiếp theo có thể kéo thêm nhiều trạm về phía quân nổi dậy. Bà đem theo [[character/3]], [[character/5]] và phi công làm hộ tống, và gạt đi mối nghi ngại của phi công về [[character/3]], gọi anh ta là người cứng đầu nhưng là một phi công giỏi ([[chapter/25]]).", false],
		[25, "", "Khi đến nơi, họ thấy [[character/9]] đang chờ sẵn cùng lực lượng của hắn. [[character/2]] bàng hoàng vì kế hoạch của họ đã bị biết trước.", false],
		[26, "", "[[character/3]] bỏ chạy khỏi trận đánh, và chỉ còn phi công cùng [[character/5]] đứng chắn giữa [[character/2]] và người định cư. Sau đó bà nói ra mối nghi có kẻ phá hoại, nhưng không chịu tin lời buộc tội của [[character/5]] rằng [[character/3]] là kẻ phản bội. Bà đi ẩn náu, để [[character/5]] phụ trách tại [[station/9]] và cảnh báo phi công rằng chỉ ngoại giao thôi có thể không thắng được cuộc chiến ([[chapter/26]]).", false],
		[28, "Bị giam cầm", "Niềm tin của bà vào [[character/3]] hóa ra đặt sai chỗ. Hắn bắt giữ bà và đem bà dâng cho [[character/9]]. Trong cuộc đối đầu gần [[station/11]], bà giục phi công đừng bận tâm đến an nguy của bà. Phi công giải cứu bà khỏi khoang hàng của con tàu bị phá hủy của [[character/3]], và bà đến [[station/12]], run rẩy nhưng không bị thương ([[chapter/28]]).", false],
		[29, "", "Ngay cả khi đó, bà vẫn nghĩ đến phong trào trước tiên. Trước khi bị bắt, bà đã thu xếp đưa một nhóm nhà khoa học đến [[station/14]], và bà lập tức cử phi công đi bảo vệ đoàn tàu của họ, vì sợ rằng [[character/3]] cũng đã phản bội cả đoàn tàu này ([[chapter/29]]).", false],
		[31, "Kế hoạch ba bước", "Tại [[station/14]], [[character/2]] tiết lộ kế hoạch của bà. Quân nổi dậy ngày càng đụng độ nhiều hơn với một hạm đội thuộc địa vẫn đông hơn họ, nên bà đã đưa [[world/abel]] và nhóm của ông đến để chế tạo một vũ khí. Công việc gồm ba bước, bước đầu tiên là một nguồn năng lượng, [[world/biotek]], thứ mà người định cư đã đánh cắp của vị giáo sư. Bà rời đi để gặp ông trong khi [[character/5]] tổ chức cuộc chặn đánh ([[chapter/31]]).", false],
		[33, "", "Cho bước thứ hai, bà muốn có một khẩu [[world/eclipse|Eclipse]], loại pháo thường dùng để phòng thủ trạm. Nơi sản xuất gần nhất, [[station/188]], nằm trong tay người định cư và vũ khí này không được bán, nên bà giao cho phi công một quỹ đút lót lớn và thừa nhận kế hoạch của bà chỉ đến thế ([[chapter/33]]).", false],
		[39, "", "Khi khẩu pháo về đến nơi, bà không muốn biết nó được kiếm bằng cách nào và mong rằng không có máu đổ. Bà phật ý khi phi công đùa rằng kế hoạch này có thể dùng để thống trị hành tinh. Cho bước cuối cùng, bà truyền đạt lời giải thích của vị giáo sư về lồng ấp, thẳng thắn thừa nhận mình không hiểu, và cử phi công đến [[station/16]] ([[chapter/39]]).", false],
		[43, "Những cuộc tổng tấn công", "Khi người định cư mở cuộc tấn công bất ngờ vào [[station/14]], ban đầu [[character/2]] tin rằng mọi thứ đã mất ([[chapter/43]]).", false],
		[44, "", "Bà sống sót và ghi công phi công cùng [[world/aquarians|người Aquarian]] đã cứu trạm.", false],
		[45, "", "Bà tiếp đón một sứ giả [[world/aquarians|người Aquarian]], người mang tin rằng dân tộc ông sẽ giúp chiến đấu chống thuộc địa. Với [[station/188]] nay nằm trong tay quân nổi dậy, bà dự định trang bị [[equipment/42]] cho càng nhiều tàu càng tốt và mở hai cuộc tổng tấn công cùng lúc: phi công sẽ chiếm [[station/18]], còn [[character/5]] tấn công [[station/109]] ([[chapter/45]]). Bà trêu phi công vì lo lắng cho [[character/5]].", false],
		[47, "", "Trong cuộc tấn công cuối cùng vào [[station/0]], bà đích thân xông vào trận ([[chapter/47]]).", false],
		[48, "", "Sau chiến thắng, bà cảm ơn phi công và [[character/5]], và thừa nhận rằng hành tinh sẽ cần rất nhiều thời gian để hồi phục.", false],
		[19, "Tính cách", "[[character/2]] ấm áp và điềm tĩnh, và bà nói chuyện với các thuộc cấp trẻ tuổi như thể họ là con mình. Bà đòi hỏi rất nhiều nhưng trả công ít.", false],
		[26, "", "Bà trung thành với người của mình đến mức thái quá. Bà vẫn bênh vực [[character/3]] rất lâu sau khi những người khác đã sinh nghi.", false],
		[28, "", "[[character/3]] gọi bà là kẻ mơ mộng đã quá già cho công việc này, một nhận xét mà phần còn lại của câu chuyện không chứng minh là đúng.", false],
		[33, "", "Kế hoạch của bà có thể táo bạo hơn là chi tiết, trông cậy vào khả năng ứng biến của thuộc cấp. Bà chuộng ngoại giao và mong tránh đổ máu, nhưng chấp nhận rằng phong trào phải chiến đấu.", false],
		[19, "Các mối quan hệ", "Bà dần tin tưởng phi công hơn hầu hết mọi người, và phi công đáp lại niềm tin đó.", false],
		[21, "", "Bà đánh giá [[character/3]] là phi công giỏi nhất của mình.", false],
		[23, "", "Bà chẳng có gì ngoài sự khinh bỉ dành cho [[character/9]].", false],
		[25, "", "Bà coi [[character/5]] là một phó tướng đáng tin cậy và giao cho cô phụ trách khi bà vắng mặt.", false],
		[31, "", "[[character/4]] làm việc dưới quyền bà với tư cách chuyên gia kỹ thuật, và [[world/abel]] chế tạo vũ khí cho bà.", false],
	],
	"character/3": [
		[21, "", "[[character/3]] là một trong những phi công giỏi nhất của [[character/2]], một chiến binh tài năng và kiêu ngạo mà bà ghép đôi với phi công trong một cuộc tập kích vào băng cướp biển gần [[station/8]].", false],
		[21, "Tính cách", "[[character/3]] nóng vội và khoác lác. Anh ta mắng phi công vì đến muộn, khẳng định có thể tự mình làm xong việc và bảo phi công cứ bám sau anh ta mà học. [[character/1]] ấn tượng với danh tiếng của anh ta, nếu không phải với cách cư xử.", false],
		[22, "", "Anh ta không hề tôn trọng người mới và chế giễu phi công là con nhà đánh cá.", false],
		[28, "", "Thực chất hắn là một kẻ đánh thuê. Hắn đo lòng trung thành bằng tiền và chẳng có chút kiên nhẫn nào với những lý tưởng thúc đẩy phong trào.", false],
		[21, "Vai trò trong câu chuyện", "[[character/2]] giới thiệu [[character/3]] là một trong những phi công giỏi nhất của bà và cử phi công cùng anh ta đi đánh cướp biển ([[chapter/21]]). Anh ta đã chờ sẵn ở mục tiêu, bực bội vì sự chậm trễ.", false],
		[22, "", "[[character/3]] là một phi công cừ khôi, và sau trận đánh anh ta dành cho phi công một lời khen miễn cưỡng gói trong một câu xúc phạm. Khi [[character/2]] chia đều phần thưởng, anh ta giận dữ, khăng khăng rằng phi công chẳng đóng góp mấy và phàn nàn rằng bà phí tiền vào lính mới.", false],
		[25, "", "[[character/2]] chọn anh ta vào đoàn hộ tống bà đến [[station/10]]. Phi công không hài lòng, nhưng bà bảo đảm rằng anh ta cứng đầu nhưng có tay nghề ([[chapter/25]]).", false],
		[26, "Cuộc phục kích", "Khi lực lượng của [[character/9]] giăng bẫy phục kích tại [[station/10]], [[character/3]] không bắn một phát nào. Anh ta khai rằng vũ khí bị hỏng, xin lỗi rồi bỏ chạy. [[character/5]] tin chắc anh ta đã phản bội họ, còn [[character/2]] ngờ có kẻ phá hoại nhưng vẫn bênh vực anh ta.", false],
		[27, "Phản bội", "Một thời gian sau, anh ta gọi cho phi công, lo lắng hỏi thăm [[character/2]] và [[character/5]] và khẳng định có tin quan trọng. Anh ta đề nghị gặp gần [[station/11]]. [[character/1]] chắc chắn đó là một cái bẫy ([[chapter/27]]).", false],
		[28, "", "Quả đúng vậy. [[character/3]] đã bắt giữ [[character/2]] và đe dọa giết bà nếu phi công không đầu hàng. Hắn thản nhiên giải thích lý do: hắn cho rằng [[character/2]] là kẻ mơ mộng, đã quá già để lãnh đạo, còn [[character/9]] đã treo một khoản thưởng lớn cho cả bà lẫn phi công. Hắn thừa nhận không biết vì sao [[character/9]] lại sợ phi công và cũng chẳng quan tâm. Hắn nói [[character/2]] trả công bèo bọt, nên hắn đổi chủ, và hắn gạt phăng những lời phi công nói về lý tưởng.", false],
		[28, "", "Trong lúc hắn nói, [[character/1]] quét con tàu một chỗ ngồi của hắn và suy ra [[character/2]] hẳn đang ở đâu. Rồi phi công tấn công. [[character/3]] nhanh nhẹn và tự tin đến phút cuối, nhưng tàu của hắn bị phá hủy. Phi công thu hồi khoang hàng bọc giáp với [[character/2]] còn sống bên trong, còn [[character/3]] chìm xuống cùng con tàu gần [[station/11]].", false],
		[28, "", "Nhìn lại, việc vũ khí của hắn hỏng tại [[station/10]] có vẻ là dàn dựng. Không có gì trong câu chuyện cho thấy lời xin lỗi của hắn là thật lòng.", false],
		[29, "", "Sự phản bội của hắn để lại hậu quả lâu dài. [[character/2]] lo rằng hắn đã tiết lộ tin tức về đoàn tàu chở các nhà khoa học của bà trước khi chết ([[chapter/29]]).", false],
		[47, "", "Trong trận chiến cuối cùng, [[character/9]] dùng một lời đe dọa mà phi công nhận ra là những câu cuối cùng của [[character/3]]. Khi biết phi công đã giết hắn, [[character/9]] khẳng định [[character/3]] là anh em ruột của phi công. Lời dối trá thất bại ngay lập tức.", false],
		[21, "Các mối quan hệ", "[[character/2]] hoàn toàn tin tưởng anh ta và đánh giá tay nghề của anh ta cao hơn các phi công khác của bà.", false],
		[22, "", "Anh ta đối xử với phi công bằng sự khinh miệt ngay từ đầu.", false],
		[26, "", "[[character/5]] không tin anh ta và là người đầu tiên gọi anh ta là kẻ phản bội.", false],
		[28, "", "Cuối cùng hắn bán mình cho [[character/9]], kẻ mà các đồng đội của hắn đang chiến đấu chống lại.", false],
	],
	"character/4": [
		[12, "", "[[character/4]] là một thành viên của [[faction/rebels|phong trào kháng chiến]] đóng tại [[station/3]].", false],
		[13, "", "Anh là người nổi dậy đầu tiên mà phi công gặp trực tiếp. Anh sàng lọc tân binh và giao cho họ những nhiệm vụ đầu tiên.", false],
		[13, "Sàng lọc phi công", "Khi phi công đến [[station/3]], [[character/4]] mở đầu bằng một tràng câu hỏi rối rắm về việc người mới đến biết những gì và biết bằng cách nào. Phi công thừa nhận chẳng biết gì ngoài lời đồn về một phong trào kháng chiến ủng hộ tự do thương mại. [[character/4]] tỏ ra hoài nghi, nhưng lưu ý rằng phong trào chỉ mới bắt đầu mã hóa liên lạc radio từ hai ngày trước, khiến câu chuyện trở nên đáng tin ([[chapter/12]]).", false],
		[13, "", "Thiếu cả thời gian lẫn người, [[character/4]] nhận phi công vào thử việc. Anh giải thích rằng quân nổi dậy dự định thâm nhập các trạm của người định cư và lôi kéo lãnh đạo của họ, vì việc bóc lột hành tinh phải chấm dứt. Anh từ chối nói thêm với người lạ, và giao cho phi công nhiệm vụ đầu tiên: đưa những người đồng tình từ [[station/4]] đến [[station/5]] ([[chapter/13]]).", false],
		[17, "Lan rộng cuộc cách mạng", "Về sau [[character/4]] triệu phi công trở lại [[station/3]] bằng một tin nhắn dài đến mức [[character/1]] chỉ đọc to ý chính ([[chapter/17]]).", false],
		[18, "", "Gặp trực tiếp, anh báo rằng ngoại giao đã kéo nhiều trạm về phía quân nổi dậy, nên giờ phi công có thể buôn bán trên một vùng rộng hơn. Báo chí đã nói đến một cuộc cách mạng, và [[character/4]] đồng tình với từ ấy. Đến nay chưa có máu đổ, dù anh cho rằng điều đó sẽ thay đổi. Anh cho phi công biết người lãnh đạo phong trào đang ở một trong những trạm vừa thu phục được và sẽ liên lạc, đồng thời cảnh báo rằng một số trạm chỉ đến được khi có giáp hoặc khiên tốt hơn; xem [[guide/depth]] ([[chapter/18]]).", false],
		[31, "Cuộc chặn đánh đoàn tàu", "[[character/4]] có mặt tại [[station/14]] khi phi công đến sau chuyến hộ tống các nhà khoa học. Anh đã chuẩn bị một bài phát biểu cảm ơn nhưng không bao giờ được đọc, và về sau lại bị ngắt lời giữa chừng khi phi công vội vã ra tàu. Anh chiến đấu cùng phi công và [[character/5]] đi đánh đoàn tàu của người định cư chở [[world/biotek]] ([[chapter/31]]).", false],
		[32, "", "Khi thủy thủ đoàn của đoàn tàu van nài rằng họ chỉ chở lương thực và thuốc men, [[character/4]] đáp qua radio rằng đó chính là thứ quân nổi dậy cần. [[character/5]] nhận xét rằng anh cũng khá hài hước.", false],
		[33, "", "Sau đó [[character/2]] giao cho anh phụ trách xưởng tàu, nơi có rất nhiều việc phải làm. Bà cũng chỉ định anh là người cần hỏi về mặt kỹ thuật của việc lắp một khẩu [[world/eclipse|Eclipse]] lên tàu ([[chapter/33]]).", false],
		[13, "Tính cách", "[[character/4]] thận trọng, câu nệ và kín đáo. Anh ra lệnh trước rồi mới giải thích, và chỉ chia sẻ kế hoạch của phong trào với những người đã xứng đáng.", false],
		[18, "", "Anh cũng nói dài dòng, một tật mà [[character/1]] chế giễu mỗi khi anh lên tiếng.", false],
		[32, "", "Đằng sau vẻ cứng nhắc là óc hài hước khô khan và cái nhìn thực tế về cuộc chiến sắp tới.", false],
		[13, "Các mối quan hệ", "[[character/4]] là người liên lạc đầu tiên của phi công trong phong trào. Lòng tin của anh tăng dần khi phi công chứng tỏ mình đáng tin cậy.", false],
		[19, "", "Anh làm việc dưới quyền [[character/2]] và chuyển tiếp mệnh lệnh của bà.", false],
		[32, "", "Anh chiến đấu bên cạnh [[character/5]], người hay trêu anh vì những câu đùa.", false],
	],
	"character/5": [
		[13, "", "[[character/5]] là một thành viên của [[faction/rebels|phong trào kháng chiến]] mà phi công được cử đi đón tại [[station/4]].", false],
		[14, "", "Vui vẻ, ấm áp và hay cười, cô trở thành một trong những đồng minh thân thiết nhất của phi công. Phi công bị cô cuốn hút ngay từ giây phút đầu tiên, khiến [[character/1]] bực bội mãi không thôi.", false],
		[14, "Lần gặp đầu tiên", "[[character/5]] nồng nhiệt chào đón phi công tại [[station/4]] và vội vã muốn lên đường. Khi phi công hỏi về phong trào, cô giải thích rằng tân binh không được cho biết nhiều, vì sự an toàn của chính họ và của phong trào. Cô gửi điểm đến cho máy tính trên tàu và nhấn mạnh rằng chuyến đi phải thật nhanh ([[chapter/13]]).", false],
		[15, "", "Tại [[station/5]], cô đi ẩn náu để thu xếp một số việc. Trước khi đi, cô giải thích quân nổi dậy khác người định cư ở điểm nào: họ sống nhờ những gì biển ban cho thay vì vơ vét nó, chế biến mẻ cá thành hàng hóa và cẩn thận không đánh bắt quá mức. Cô đề nghị phi công thử lối sống này bằng cách sản xuất năm tấn hàng hóa, và gợi ý [[station/90]], nơi mực và [[goods/35]] có thể được chế biến thành [[goods/22]] ([[chapter/14]]).", false],
		[16, "", "Khi hàng đã làm xong, cô gọi lại với một nhiệm vụ mới. Phong trào cần thông tin mới từ mọi trạm để tìm ra điểm yếu của thuộc địa, vì theo cô, chỉ vũ khí thôi sẽ không thắng được. Khi được hỏi liệu quân nổi dậy có đang chuẩn bị một cuộc cách mạng không, cô từ chối nói thêm ([[chapter/15]]).", false],
		[25, "Đoàn tụ và phục kích", "Phi công gặp lại [[character/5]] tại [[station/9]], nơi hai người trao nhau những lời khen vụng về. [[character/2]] cắt ngang cuộc đoàn tụ và giao cho cả hai hộ tống bà cùng [[character/3]] đến [[station/10]] ([[chapter/24]]).", false],
		[25, "", "[[character/5]] là người đầu tiên cảm thấy có điều không ổn khi họ đến nơi.", false],
		[26, "", "Trong cuộc phục kích, cô thấy [[character/3]] không chiến đấu và gọi với theo khi anh ta bỏ chạy. Sau đó cô thẳng thừng buộc tội anh ta phản bội và kêu gọi phi công ủng hộ. [[character/2]] để cô phụ trách tại [[station/9]] trong thời gian bà vắng mặt ([[chapter/25]]).", false],
		[31, "Kế hoạch ba bước", "Tại [[station/14]], [[character/5]] đã biết chuyện [[character/2]] được giải cứu. Cô phổ biến cho phi công bước đầu tiên của kế hoạch: một người cung cấp tin báo rằng [[world/biotek]] đang được chở đến Maarth, giấu giữa những chuyến hàng bình thường. Vì không ai biết tàu nào chở nó, cô ra lệnh tấn công cả đoàn tàu gần [[station/2]] ([[chapter/30]]).", false],
		[32, "", "Cô chỉ huy cuộc chặn đánh và bảo đảm mọi thùng hàng đều được thu hồi ([[chapter/31]]).", false],
		[33, "", "Sau đó [[character/2]] giao cho cô nhiệm vụ tuần tra bên ngoài [[station/14]] để phòng tấn công bất ngờ.", false],
		[42, "", "Khi phi công trở về với [[goods/36]], [[character/5]] mừng rỡ. Cô báo rằng [[world/abel]] đã chuẩn bị sẵn mọi thứ, chuyển lệnh của [[character/2]] thử khẩu pháo với cướp biển và nhắc phi công rằng máy phát chỉ là nguyên mẫu ([[chapter/41]]).", false],
		[45, "Những cuộc tổng tấn công", "Trong các cuộc tổng tấn công cuối cùng, [[character/5]] chỉ huy cuộc tấn công vào [[station/109]] trong khi phi công đánh [[station/18]]. [[character/2]] trấn an phi công rằng cô là một phi công giỏi và biết mình đang làm gì ([[chapter/44]]).", false],
		[47, "", "Cuộc tấn công của cô thành công. Cô gọi cho phi công báo tin cùng mệnh lệnh của [[character/2]] cho trận chiến cuối cùng tại [[station/0]], rồi tự mình lên đường, chiến đấu vượt qua cướp biển trên đường đi ([[chapter/46]]).", false],
		[48, "", "Tại [[station/0]], cô chiến đấu bên cạnh [[character/2]] và phi công. Sau chiến thắng, cô mời phi công ăn mừng bên [[goods/21]], và phi công nhận lời ([[chapter/47]]).", false],
		[14, "Tính cách", "[[character/5]] thân thiện và lạc quan, và thích một câu khen ngắn mà cô dùng ở mọi lúc mọi nơi. Cô cũng kín đáo và tận tụy, hiểu rõ phong trào đại diện cho điều gì.", false],
		[15, "", "Cô tin vào việc sống nhờ biển mà không làm hại nó, và biết cách giải thích ý tưởng ấy một cách đơn giản.", false],
		[26, "", "Cô nhanh chóng đánh giá người khác, và trong trường hợp [[character/3]], cô đã đánh giá đúng.", false],
		[14, "Các mối quan hệ", "Phi công bị cô thu hút ngay từ đầu, và qua chiến dịch tình cảm ấy rõ ràng trở nên từ cả hai phía. [[character/1]] không bao giờ thôi càu nhàu về chuyện đó.", false],
		[25, "", "[[character/2]] tin tưởng giao quyền chỉ huy cho cô và đối xử với cô cùng phi công bằng vẻ thích thú trìu mến.", false],
		[26, "", "Cô không bao giờ tin [[character/3]].", false],
		[32, "", "Cô làm việc chặt chẽ với [[character/4]] và thấy óc hài hước của anh thú vị.", false],
	],
	"character/6": [
		[8, "", "[[character/6]] là cái tên dùng cho nhiều người nói phụ thuộc phe [[faction/colonists]]: các viên chức, quản lý và thủy thủ đoàn vận tải của [[world/colony|bộ máy quản lý]] thuộc địa. Không ai trong số họ có tên; gộp lại, họ cho thấy thuộc địa đối xử ra sao với những người ngoài làm việc cho nó.", false],
		[9, "Ai lên tiếng", "Người đầu tiên là viên chức tại [[station/1]] tiếp phi công sau cuộc tàn sát [[species/0|ốc anh vũ]] ([[chapter/8]]). Viên chức này chuộng lời lẽ lịch sự cho việc bẩn thỉu, trả một khoản nhỏ cố định và không chịu mặc cả. Phi công phải hoàn thành ba hợp đồng trước khi được giao việc tốt hơn.", false],
		[10, "", "Cũng giọng nói ấy sau đó giao nhiệm vụ bảo vệ khoang vận chuyển tại [[station/2]]. Thuộc địa phóng hàng xuất khẩu lên quỹ đạo trong các khoang, và [[world/aquarians|người Aquarian]] liên tục tấn công chúng, khiến cơ quan thương mại lo ngại ([[chapter/9]]).", false],
		[32, "", "Rất lâu sau đó, thủy thủ đoàn của một đoàn tàu người định cư gần [[station/2]] van xin quân nổi dậy ngừng bắn, nói rằng họ chỉ chở lương thực và thuốc men ([[chapter/31]]).", false],
	],
	"character/7": [
		[12, "", "[[character/7]] là cái tên dùng cho những thành viên không tên của [[faction/rebels]] nói chuyện với phi công: nhân viên điều phối giao thông của trạm, lính gác và thủy thủ đoàn của các đoàn tàu. Giọng nói của họ đánh dấu lần tiếp xúc đầu tiên của phi công với phong trào và cuộc sống thường ngày của nó.", false],
		[12, "Ai lên tiếng", "Người nổi dậy đầu tiên mà phi công nghe thấy là một lính gác tại [[station/3]], người cảnh báo rằng tàu đã vào vùng nước trung lập và đe dọa nổ súng nếu tàu không xưng danh. Sau một khoảng im lặng dài, phi công được phép cập bến ([[chapter/12]]).", false],
		[17, "", "Khi phi công trở lại với tư cách thành viên đã được chấp nhận, trạm gọi phi công bằng tên và chỉ định một bến đỗ ([[chapter/17]]).", false],
		[29, "", "Về sau, thủy thủ đoàn của đoàn tàu chở các nhà khoa học gần [[station/13]] tuyệt vọng kêu cứu ([[chapter/29]]).", false],
		[30, "", "Sau đó họ cảm ơn phi công, nói rằng tự họ thì đã không thể sống sót.", false],
	],
	"character/8": [
		[34, "", "[[character/8]] là một thương nhân mà phi công gặp tại [[station/15]] trong lúc tìm cách kiếm một khẩu [[world/eclipse|Eclipse]].", false],
		[35, "", "Hắn là một tay buôn chợ đen luôn tự gọi mình ở ngôi thứ ba và khẳng định có thể cung cấp hầu như mọi thứ cho khách hàng có tiền.", false],
		[35, "Lai lịch", "[[character/8]] làm ăn tại [[station/15]], nơi buôn bán ma túy là phạm pháp. Hoạt động của hắn đã biến hắn thành mục tiêu: cơ quan an ninh của trạm đã thuê thợ săn tiền thưởng [[character/11]] để trừ khử hắn. Hắn có quan hệ ở nhiều nơi và sẵn sàng đút lót để có được thứ khách hàng muốn.", false],
		[35, "Thương vụ khẩu pháo", "Trong lúc phi công xem xét chợ địa phương, có vẻ như đang mua [[goods/37]], [[character/8]] gọi phi công ra một góc và cảnh báo rằng buôn bán thứ đó ở đây là phạm pháp. Khi hắn chào mời dịch vụ và phi công hỏi mua một khẩu [[equipment/42]], hắn sửng sốt và hỏi liệu phi công có định gây chiến không. Phi công nói là để dùng riêng. [[character/8]] đồng ý tìm một khẩu, với một điều kiện: phi công phải tìm và giết [[character/11]], kẻ đang tuần tra gần trạm ([[chapter/34]]).", false],
		[37, "", "Sau cái chết của [[character/11]], [[character/8]] chúc mừng phi công và giữ lời. Nhờ các mối quan hệ và rất nhiều tiền đút lót, hắn đã tìm được một khẩu [[equipment/42]] và chào bán với giá cắt cổ mà hắn vẫn gọi là món hời. Hắn tiết lộ người bán là một người tên Dawn, và hắn chẳng quan tâm đến tên tuổi miễn là hàng tốt ([[chapter/36]]).", false],
		[37, "", "Người bán là [[character/9]]. [[character/1]] chỉ ra sự trớ trêu: lòng tham của [[character/9]] đã trao vũ khí quan trọng nhất của quân nổi dậy vào tay kẻ thù của hắn. Phi công mua khẩu pháo và mang nó về [[station/14]] ([[chapter/37]]).", false],
		[35, "Tính cách", "[[character/8]] khôn ngoan, cẩn trọng và không có lương tâm. Hắn buôn hàng cấm và đòi mạng một người thản nhiên như đòi một khoản thanh toán. Hắn dè chừng bị nghe lén, gọi phi công ra một góc và bảo phi công im lặng trước khi bàn bất cứ chuyện làm ăn nào. Ngay cả với khách hàng trả tiền, hắn vẫn cân nhắc rủi ro: ban đầu hắn không chắc có nên bán một vũ khí như thế cho người lạ hay không.", false],
		[37, "", "Dù vậy, theo cách riêng của mình, hắn đáng tin: hắn giữ thỏa thuận một khi đã được trả tiền, và tìm cho phi công đúng thứ đã yêu cầu. Thói quen tự gọi tên mình và niềm tự hào vì quen đúng người ở đúng chỗ khiến hắn trở thành một trong những nhân vật đầy màu sắc của chiến dịch.", false],
		[35, "Các mối quan hệ", "[[character/11]] là kẻ săn lùng hắn và, thông qua phi công, trở thành nạn nhân của hắn.", false],
		[37, "", "Hắn làm ăn với [[character/9]] cũng như với phi công, chẳng bận tâm ai đứng về phe nào.", false],
	],
	"character/9": [
		[2, "", "[[character/9]], họ Dawn, là một viên chức người định cư tại [[station/0]], nơi phi công bán mẻ cá trong ngày.", false],
		[3, "", "Kiêu ngạo và đầy tham vọng, hắn đối xử với những người làm việc cho thuộc địa bằng sự khinh miệt ra mặt. Hắn là người chủ đầu tiên của phi công và trở thành đối thủ lâu dài của phi công.", false],
		[12, "Lai lịch", "[[character/9]] cho rằng mình sinh ra để làm những việc lớn hơn nhiều so với chức vụ ở các trạm.", false],
		[23, "", "[[character/2]] biết hắn từ khi hắn còn là một nhân vật tầm thường. Theo bà, hắn thăng tiến nhờ quan hệ tốt chứ không nhờ năng lực, và đến thời điểm cuộc nổi dậy, hắn nắm thực quyền trong lực lượng [[faction/colonists|thuộc địa]].", false],
		[3, "Những lần chạm trán đầu tiên", "[[character/9]] mua mẻ cá đầu tiên của phi công theo giá cố định và chế giễu khoang hàng nhỏ. Hắn nói thêm rằng phi công nên đi săn [[faction/pirates|cướp biển]] thì hơn, dù hắn nghi phi công cũng chẳng làm nổi việc đó ([[chapter/2]]).", false],
		[7, "", "Khi phi công trở lại với vũ khí, hắn nhận hết công lao và giao một việc: dọn sạch [[species/0|ốc anh vũ]] khỏi các tuyến đường quanh [[station/1]]. Hắn gạt đi phản đối của phi công và chẳng quan tâm những sinh vật ấy bị loại bỏ bằng cách nào ([[chapter/6]]).", false],
		[10, "", "Hắn chỉ huy cuộc phóng khoang tại [[station/2]] và cảnh báo phi công rằng mất hơn năm khoang sẽ khiến phi công mất việc ([[chapter/10]]).", false],
		[12, "", "Sau đó hắn đổ lỗi cho phi công về các khoang bị hư hại và giữ lại phần thưởng. Sự khinh miệt của hắn là giọt nước tràn ly đẩy phi công đến với phong trào kháng chiến ([[chapter/11]]).", false],
		[23, "Chống lại cuộc nổi dậy", "[[character/9]] quay sang chống lại quân nổi dậy khi họ lớn mạnh. Hắn cho rải một bãi thủy lôi trên tuyến tiếp tế của họ từ [[station/9]] đến [[station/37]] ([[chapter/22]]).", false],
		[25, "", "Hắn chờ sẵn cùng lực lượng của mình khi [[character/2]] đến đàm phán tại [[station/10]], và lập tức ra lệnh tấn công ([[chapter/25]]).", false],
		[28, "", "Hắn là kẻ chi tiền đằng sau sự phản bội của [[character/3]]. Hắn đã treo một khoản thưởng lớn cho [[character/2]] và phi công, có vẻ coi phi công là một mối đe dọa ([[chapter/27]]).", false],
		[37, "", "Lòng tham là nguyên nhân khiến hắn thất bại. Hắn bán một khẩu pháo [[world/eclipse|Eclipse]] cho tay buôn chợ đen [[character/8]], kẻ sau đó lại bán nó cho phi công ([[chapter/36]]).", false],
		[43, "Thất bại", "[[character/9]] dẫn đầu cuộc tấn công bất ngờ của người định cư vào [[station/14]]. Hắn chế nhạo phi công là kẻ đánh cá cho quân nổi dậy và sững sờ khi biết phi công mang theo một khẩu [[equipment/42]] ([[chapter/43]]).", false],
		[44, "", "Khi [[world/aquarians|người Aquarian]] tham chiến chống lại tàu của hắn, hắn bỏ dở cuộc tấn công và bỏ chạy.", false],
		[47, "", "[[character/9]] cố thủ lần cuối tại [[station/0]], thành trì cuối cùng của thuộc địa. Nghe tin phi công đã giết [[character/3]], hắn khẳng định [[character/3]] là anh em ruột của phi công và chính hắn là cha của phi công. Phi công lập tức nhìn thấu lời dối trá, và [[character/9]] thừa nhận nó suýt nữa đã có tác dụng ([[chapter/47]]).", false],
		[48, "", "Trong trận chiến sau đó, [[character/9]] là người định cư cuối cùng còn lại. Hắn trốn thoát trong một khoang cứu hộ, dường như kéo theo cả trạm, và bỏ lại đại dương phía sau cùng một lời khinh miệt dành cho cá và cho những ai ở lại.", false],
		[3, "Tính cách", "[[character/9]] thô lỗ, tự cao tự đại và coi thường bất kỳ ai dưới mình.", false],
		[12, "", "Hắn đổ lỗi cho người khác và nhận công khi mọi việc suôn sẻ.", false],
		[37, "", "Lòng tham của hắn lớn hơn lòng trung thành với chính phe mình.", false],
		[47, "", "Hắn là kẻ thao túng, dùng lời dối trá và tiền đút lót thay cho lòng can đảm, và bỏ chạy mỗi khi trận đánh trở nên bất lợi.", false],
		[3, "Các mối quan hệ", "Sự khinh miệt của hắn đối với phi công bắt đầu từ lần gặp đầu tiên và qua chiến dịch trở thành thù địch công khai.", false],
		[23, "", "[[character/2]] từ lâu đã khinh bỉ hắn.", false],
		[28, "", "Hắn mua lòng trung thành của [[character/3]] bằng một khoản tiền thưởng.", false],
		[37, "", "Hắn làm ăn với [[character/8]] mà không biết hàng sẽ rơi vào tay ai.", false],
	],
	"chart": [
		[1, "", "Hải đồ hiển thị cả hai trăm trạm dưới dạng các chấm tại vị trí của chúng trên bản đồ đại dương. Chấm xanh lam do [[faction/colonists]] nắm giữ, chấm cam do [[faction/rebels]] nắm giữ, tính theo chương bạn đã đến. Mọi trạm ban đầu đều màu xanh lam; các trạm chuyển sang màu cam khi cốt truyện tiến triển và không bao giờ đổi lại.", false],
		[1, "", "Trên trang trạm hoặc trang chương, trạm được nói đến được vẽ lớn hơn và có nhãn, còn các trạm gia nhập quân nổi dậy trong chương đó được viền ngoài. Bên dưới hải đồ, mọi trạm đều được liệt kê kèm liên kết đến trang của chúng. Khoảng cách giữa các trạm được đo bằng đơn vị hải đồ; xem [[guide/navigation]].", false],
	],
	"contract/0": [
		[1, "", "Truy lùng một con tàu bị truy nã đang chờ cách trạm 400 đến 1.200 m và tiêu diệt nó. Mục tiêu bền bỉ hơn nhiều so với cướp biển thông thường, và sức mạnh của nó tăng theo cấp của phi công. Vũ khí tầm xa và ngư lôi giúp bào mòn nó trước khi nó áp sát. Tiền thưởng được trả khi trở về một trạm.", false],
	],
	"contract/1": [
		[1, "", "Một băng gồm ba đến sáu tàu chờ dọc một lộ trình quanh co. Mục tiêu là chiếc cuối cùng, ở điểm đánh dấu cuối. Không thể đơn giản tiêu diệt nó: hãy vô hiệu hóa nó, rồi dùng lao móc kéo về trước khi nó trốn thoát. Hãy dọn sạch hộ vệ trước, để việc kéo không bị gián đoạn.", false],
	],
	"contract/10": [
		[1, "", "Phá hủy mọi quả thủy lôi trong một bãi gồm 15 đến 25 quả, cách trạm hai đến sáu trăm mét, được một con tàu duy nhất canh gác. Chỉ có thể bắn trúng thủy lôi ở cự ly gần, nên hãy tiếp cận từng quả thật cẩn thận. Khiên và giáp mạnh giúp hấp thụ các vụ nổ.", false],
	],
	"contract/11": [
		[1, "", "Các khoang tiếp tế đang bị tấn công. Hãy tiêu diệt kẻ tấn công trong khi đủ số khoang còn nguyên vẹn để đạt mức tối thiểu của hợp đồng. Hãy theo dõi số khoang và giao chiến trước với những kẻ tấn công đang áp sát chúng. Những công việc này trả nhiều hơn khoảng 30% so với hợp đồng cơ bản.", false],
		[10, "", "Kẻ tấn công là người Aquarian, những cư dân biển nửa người nhắm vào các khoang vận chuyển của người định cư.", false],
	],
	"contract/12": [
		[1, "", "Phá hủy một số lượng nhất định khoang tiếp tế được tàu vũ trang canh gác, có lực lượng đồng minh chiến đấu cùng. Trên thực tế không trạm nào đăng công việc này trên bảng, nên không thể nhận nó. Nó xuất hiện trong phần tra cứu chỉ vì được định nghĩa cùng các loại hợp đồng khác.", false],
	],
	"contract/13": [
		[1, "", "Sản xuất một số lượng nhất định của một sản phẩm và giao đến trạm đã đăng việc. Thù lao phụ thuộc vào giá trị sản phẩm và số lượng yêu cầu. Phần thưởng thường rất hậu hĩnh, và chỉ cần một nửa tiền cọc thông thường. Hãy kiểm tra công thức trước và thu gom nguyên liệu trước khi nhận việc. Những công việc này chỉ xuất hiện tại các trạm ngoài hai mươi trạm đầu tiên trên hải đồ.", false],
		[12, "", "Chỉ trạm của quân nổi dậy đăng công việc này.", false],
	],
	"contract/14": [
		[1, "", "Giao một số lượng chính xác của một loài sinh vật hoặc tảo được chỉ định đến trạm đăng việc. Số lượng từ 3 đến 24 đơn vị, và tiền cọc bằng một nửa thông thường. Những loài phổ biến được yêu cầu thường xuyên hơn loài hiếm. Radar đánh cá và khoang hàng lớn giúp những công việc này trở nên dễ dàng. Chúng chỉ xuất hiện tại các trạm ngoài hai mươi trạm đầu tiên.", false],
		[12, "", "Chỉ trạm của quân nổi dậy đăng công việc này.", false],
	],
	"contract/2": [
		[1, "", "Tàu của một kẻ bắt cóc đang giữ con tin. Giống như việc thu hồi, mục tiêu đi cùng một băng dọc lộ trình quanh co và phải bị vô hiệu hóa, rồi được kéo về bằng lao móc. Công việc thất bại nếu mục tiêu trốn thoát. Hãy lắp lao móc tầm xa tốt và hạ hộ vệ trước khi quay sang kẻ bắt cóc.", false],
	],
	"contract/3": [
		[1, "", "Truy lùng mọi tên cướp biển trong một băng gồm ba đến sáu tàu, rải rác trên các điểm đánh dấu của một lộ trình quanh co. Công việc hoàn thành khi không còn tên nào. Đây là hợp đồng đơn giản cho tàu có vũ trang, và quy mô của băng tăng theo độ khó của công việc.", false],
	],
	"contract/4": [
		[1, "", "Năm tàu chở hàng đi theo một lộ trình định sẵn, và kẻ cướp phục kích dọc đường. Công việc thành công khi mọi kẻ tấn công bị tiêu diệt. Công việc thất bại nếu mất hết tàu chở hàng. Hộ tống trả nhiều hơn khoảng 30% so với một cuộc săn cướp biển thông thường. Hãy ở gần đoàn tàu và giao chiến với kẻ cướp trước khi chúng đến được đoàn.", false],
	],
	"contract/5": [
		[1, "", "Tấn công một đoàn gồm hai hoặc ba tàu chở hàng tại một điểm đánh dấu và tiêu diệt chúng, bất chấp lực lượng hộ vệ có vũ trang. Chỉ cần tiêu diệt các tàu chở hàng, nên tập trung hỏa lực vào chúng có thể kết thúc công việc sớm. Ngư lôi hoặc súng tầm xa giúp hạ từng chiếc trong khi hộ vệ áp sát.", false],
	],
	"contract/6": [
		[1, "", "Một đàn gồm 15 đến 24 sinh vật bơi theo một lộ trình định sẵn, và thợ săn tấn công chúng dọc đường. Hãy tiêu diệt thợ săn trước khi tổn thất vượt quá giới hạn đã thỏa thuận. Đừng bao giờ bắn gần đàn: một phát bắn lạc cũng tính là tổn thất. Những công việc này trả nhiều hơn khoảng 30% so với hợp đồng cơ bản.", false],
		[12, "", "Chỉ trạm của quân nổi dậy đăng công việc này, và họ ngừng đăng khi cốt truyện đã hoàn tất.", false],
	],
	"contract/7": [
		[1, "", "Giết một số lượng nhất định của một loài trong số động vật hoang dã địa phương trong khi tàu thù địch tìm cách cản trở. Con mồi bắt bằng lao móc không được tính; sinh vật phải bị giết. Radar đánh cá giúp tìm đúng loài nhanh chóng. Những công việc này trả nhiều hơn khoảng 20% so với hợp đồng cơ bản.", false],
	],
	"contract/8": [
		[1, "", "Chở một hành khách đến một trạm khác. Một số hành khách đặt số lần nhảy S.T.R.E.A.M. tối đa, và càng được phép ít lần, thù lao càng cao. Hợp đồng hết hiệu lực nếu vượt quá giới hạn đó. Một động cơ tốt rất có ích ở đây, vì tầm xa hơn nghĩa là ít lần nhảy hơn.", false],
	],
	"contract/9": [
		[1, "", "Dọn sạch một bãi mảnh vụn gồm 15 đến 30 mảnh, cách trạm hai đến sáu trăm mét, trong khoảng hai phút rưỡi. Có thể có tàu thù địch hạng nhẹ. Thù lao thấp hơn khoảng 30% so với các hợp đồng khác, nhưng công việc nhanh gọn. Bộ tăng tốc và súng bắn nhanh giúp tiết kiệm từng giây quý giá.", false],
	],
	"equipment/0": [
		[1, "", "Khẩu súng cấp nhập môn: 3 sát thương mỗi phát, cứ 0,56 s một phát, tầm 228 m. Lực sát thương rất thấp, nhưng với giá khoảng 5.700 cr, đây là vũ khí rẻ nhất và là một trong những món phổ biến nhất ở cửa hàng. Có thể lắp nhiều khẩu, và mọi khẩu súng bắn cùng lúc, nên hai hoặc ba khẩu tạo thành một dàn hỏa lực tạm dùng được trong giai đoạn đầu cho đến khi đủ tiền mua thứ mạnh hơn.", false],
		[3, "", "Trong [[chapter/3]], phi công phải lắp một khẩu trước khi rời [[station/0]].", false],
	],
	"equipment/1": [
		[1, "", "Súng điện từ tầm trung tăng gấp đôi sát thương của [[equipment/0]] lên 6 mỗi phát và bắn nhanh hơn một chút, cứ 0,48 s một phát, tầm 260 m. Với giá gấp khoảng đôi, sát thương duy trì tăng hơn gấp đôi. Đây là lựa chọn hợp lý cho khẩu súng thứ hai ở các chương đầu, trước khi pháo nhiệt hạch xuất hiện trên kệ.", false],
	],
	"equipment/10": [
		[1, "", "Súng phóng khối này gây 20 sát thương mỗi 0,40 s với tầm 280 m, cho sát thương duy trì cao nhất trong mọi loại súng bán công khai. Nó cũng bắn xa hơn mọi pháo nhiệt hạch. Giá khoảng 42.000 đến 51.000 cr. Với một thân tàu chiến đấu còn ô trống, đây là một trong những lựa chọn súng tốt nhất.", false],
	],
	"equipment/11": [
		[1, "", "Súng phóng khối mạnh nhất gây 25 sát thương mỗi phát ở tầm 375 m, xa nhất trong các loại súng bắn nhanh. Với chu kỳ 0,51 s, sát thương duy trì xấp xỉ [[equipment/10]]. Thứ nó thêm vào là tầm bắn. Đây là khẩu súng hiếm và đắt nhất ở cửa hàng, giá 54.000 đến 60.000 cr.", false],
	],
	"equipment/12": [
		[1, "", "Ngư lôi tự dẫn cơ bản gây 20 sát thương và tự lái về phía mục tiêu, tầm tới 215 m. Nó chỉ nạp lại mỗi 4,3 s. Chỉ lắp được một bệ phóng ngư lôi, bất kể loại nào. Nó hữu ích trước những mục tiêu linh hoạt khó giữ trong tầm ngắm, nhưng tầm bắn ngắn.", false],
	],
	"equipment/13": [
		[1, "", "Ngư lôi tầm trung gây 30 sát thương, nạp lại trong 4,0 s và tầm 360 m, vượt [[equipment/12]] ở mọi mặt. Chỉ lắp được một bệ phóng ngư lôi, nên nó thay thế chứ không bổ sung cho mẫu rẻ hơn. Với giá 37.000 đến 39.000 cr, đây là vũ khí kết liễu đa năng tốt.", false],
	],
	"equipment/14": [
		[1, "", "Ngư lôi cao cấp nhất mang đầu đạn 50 sát thương, tầm tới 816 m, đòn đơn mạnh nhất trong mọi vũ khí được bán. Nó cần 6,8 s để nạp lại. Vì là ngư lôi duy nhất của tàu, nó kết hợp tốt với súng bắn nhanh: một đòn tầm xa khi trận đấu bắt đầu, rồi súng sẽ kết liễu. Nó hiếm và giá từ 62.500 cr trở lên.", false],
	],
	"equipment/15": [
		[1, "", "Lao móc khởi đầu có tầm 240 m và bỏ qua những phát ngắm kém với dung sai bắt 24 m, rộng nhất trong ba loại. Nó không làm chậm con mồi đã móc, nên sinh vật nhanh kéo mạnh và lâu kiệt sức. Nó đủ dùng cho tảo và động vật chậm chạp, và rẻ để thay thế.", false],
	],
	"equipment/16": [
		[1, "", "Lao móc này có tầm 400 m và làm chậm sinh vật đã móc 40%, giúp giữ những con mồi nhanh như [[species/7]] trong tầm nhìn dễ hơn nhiều. Dung sai bắt thu hẹp còn 18 m, nên việc ngắm quan trọng hơn. Với phi công thường xuyên đánh cá, đây là nâng cấp quan trọng nhất sau khoang hàng lớn hơn.", false],
	],
	"equipment/17": [
		[1, "", "Lao móc tốt nhất có tầm 560 m và làm chậm con mồi đã móc 70%, nên ngay cả sinh vật nhanh cũng bị khuất phục mà không cần đuổi theo nhiều. Dung sai bắt 14 m là hẹp nhất, nên nó đòi hỏi ngắm cẩn thận. Nó hiếm và đắt, giá 69.000 đến 83.000 cr, và chỉ lắp được một lao móc.", false],
	],
	"equipment/18": [
		[1, "", "Khiên cơ bản hấp thụ 100 điểm sát thương trước khi giáp bị chạm tới. Nó cũng đặt giới hạn nông của tàu ở 20.000 m. Nó không bao giờ tự nạp lại khi đang hoạt động; nó chỉ được hồi phục khi tàu rời trạm. Nó đủ cho những trận đánh đầu, nhưng phần lớn phi công thay nó sớm nhất có thể.", false],
	],
	"equipment/19": [
		[1, "", "Khiên này hấp thụ 175 điểm, nhiều hơn [[equipment/18]] ba phần tư, và cho phép tàu lên tới 18.400 m. Như mẫu cơ bản, nó không tự nạp lại khi đang hoạt động. Với giá 15.750 đến 18.000 cr, đây là nâng cấp khiên đáng giá rẻ nhất và mở đường đến nhiều trạm nông hơn.", false],
	],
	"equipment/2": [
		[1, "", "Súng điện từ mạnh nhất gây 9 sát thương mỗi phát ở tầm 322 m, nhưng chu kỳ bắn hơi chậm hơn [[equipment/1]], 0,62 s. Vì vậy sát thương duy trì chỉ nhỉnh hơn đôi chút. Với giá 16.000 đến 20.000 cr, nó đáng tiền xét về tầm bắn, nhưng [[equipment/6]] gây sát thương cao hơn rõ rệt chỉ với ít tiền hơn một chút.", false],
	],
	"equipment/20": [
		[1, "", "Khiên này hấp thụ 220 điểm và là loại đầu tiên tự nạp lại khi đang hoạt động, hồi một điểm mỗi 1,15 s khi tàu ở trong dải độ sâu của nó. Nó nâng giới hạn nông lên 16.800 m. Với giá trên 56.000 cr, nó đắt hơn nhiều so với [[equipment/19]], nhưng khả năng tự nạp lại giúp những trận đánh dài an toàn hơn hẳn.", false],
	],
	"equipment/21": [
		[1, "", "Khiên tốt nhất hấp thụ 310 điểm và hồi một điểm mỗi 0,65 s, nhanh gần gấp đôi [[equipment/20]]. Giới hạn nông 15.000 m của nó cao hơn mọi loại khiên khác, mở đường đến những trạm nông nhất. Nó hiếm và giá từ 93.750 cr trở lên, một khoản đầu tư cho giai đoạn cuối chiến dịch.", false],
	],
	"equipment/22": [
		[1, "", "Giáp cơ bản thêm 100 điểm bảo vệ, chịu sát thương sau khi khiên đã cạn và trước khi thân tàu bị trúng. Nó cũng đặt giới hạn sâu ở 25.000 m. Giáp không tự hồi phục khi đang hoạt động. Tấm giáp này rẻ và đủ dùng giai đoạn đầu, nhưng nhiều trạm sâu hơn nằm ngoài tầm của nó.", false],
	],
	"equipment/23": [
		[1, "", "Giáp này thêm 155 điểm và hạ giới hạn sâu xuống 26.800 m. Giá của nó xấp xỉ [[equipment/19]], loại khiên tương ứng, và cả hai cùng mở rộng dải độ sâu của tàu theo cả hai hướng. Đây là nâng cấp sớm tốt cho phi công muốn đến những trạm sâu hơn.", false],
	],
	"equipment/24": [
		[1, "", "Giáp này thêm 195 điểm và cho phép lặn tới 28.400 m. Nó đắt hơn đáng kể so với [[equipment/23]], giá 56.000 đến 72.000 cr, để đổi lấy mức tăng bảo vệ nhỏ hơn. Độ sâu bổ sung thường là lý do mạnh hơn để mua nó, vì nó đưa nhiều trạm sâu vào tầm với.", false],
	],
	"equipment/25": [
		[1, "", "Giáp tốt nhất thêm 270 điểm và cho phép lặn tới 30.000 m, giới hạn sâu nhất hiện có. Nó hiếm và giá từ 93.750 cr trở lên. Kết hợp với [[equipment/21]], nó cho phép tàu hoạt động gần như trên toàn bộ phạm vi độ sâu của các trạm.", false],
	],
	"equipment/26": [
		[1, "", "Mô-đun hàng hóa nhỏ nhất thêm 30% sức chứa cơ bản của thân tàu. Có thể lắp nhiều mô-đun, và phần thưởng của chúng cộng dồn. Vì phần thưởng là tỷ lệ của sức chứa cơ bản, nó cho thêm 7 t trên [[ship/0]] nhưng 54 t trên [[ship/6]]. Đây là cách rẻ nhất để tăng chỗ trong khoang trên thân tàu lớn.", false],
	],
	"equipment/27": [
		[1, "", "Mô-đun này thêm 50% sức chứa cơ bản của thân tàu và có thể cộng dồn với các mô-đun khác. Xét theo giá tiền, nó kém hiệu quả hơn [[equipment/26]] một chút, nhưng tiết kiệm ô, điều quan trọng hơn trên những thân tàu ít ô trống. Trên [[ship/4]], một mô-đun thêm 35 t, đủ để xứng đáng chiếm một ô trong chuyến buôn bán.", false],
	],
	"equipment/28": [
		[1, "", "Mô-đun lớn nhất thêm 80% sức chứa cơ bản, nhiều nhất trên mỗi ô trong các mô-đun hàng hóa. Trên [[ship/6]], nó thêm 144 t. Có thể lắp nhiều chiếc. Nó hiếm và giá từ 45.000 cr trở lên, nên chủ yếu đáng mua cho thân tàu khoang lớn chuyên buôn bán.", false],
	],
	"equipment/29": [
		[1, "", "Động cơ cơ bản mở rộng tầm S.T.R.E.A.M. của tàu trên hải đồ thêm 30%, nên có thể đến được nhiều trạm hơn chỉ trong một lần nhảy. Chỉ lắp được một động cơ. Nó rẻ và hữu ích ngay từ đầu, vì ít lần nhảy hơn nghĩa là những chuyến buôn bán và chở khách nhanh hơn.", false],
	],
	"equipment/3": [
		[1, "", "Súng cuộn từ đầu tiên là vũ khí tia được chế tạo cho tầm xa. Nó vươn tới 875 m, xa gần gấp bốn lần súng điện từ, và gây 15 sát thương, nhưng cần 2,5 s giữa các phát. Sát thương duy trì của nó xấp xỉ [[equipment/0]]. Nó đáng lắp để khai hỏa vào tàu đang tiếp cận trước khi chúng kịp đáp trả.", false],
	],
	"equipment/30": [
		[1, "", "Động cơ này mở rộng tầm S.T.R.E.A.M. thêm 60%, gấp đôi phần thưởng của [[equipment/29]], với giá khoảng gấp ba. Nó hợp với thương nhân thường xuyên chở hàng giữa các chợ xa nhau, vì giá tăng theo quãng đường hàng hóa được chở. Nó cũng đủ phổ biến để tìm thấy ở cửa hàng giữa chiến dịch.", false],
	],
	"equipment/31": [
		[1, "", "Động cơ tốt nhất mở rộng tầm S.T.R.E.A.M. thêm 130%, hơn gấp đôi tầm cơ bản. Nó hiếm và giá từ 90.000 cr trở lên. Nó đáng lắp khi các tuyến buôn bán dài hay điểm đến hợp đồng xa xôi khiến mỗi lần nhảy tiết kiệm được đều có giá trị.", false],
	],
	"equipment/32": [
		[1, "", "Bộ đẩy này thêm 0,15 vào chỉ số lái của thân tàu. Mức tăng là cố định, nên nó có tác dụng nhất trên thân tàu chậm: trên [[ship/6]], nó nâng khả năng lái từ 0,67 lên 0,82. Chỉ lắp được một bộ lái. Đây là giải pháp rẻ cho một tàu chở hàng ì ạch.", false],
	],
	"equipment/33": [
		[1, "", "Bộ đẩy này thêm 0,26 vào chỉ số lái, mức tăng gần gấp đôi [[equipment/32]] với giá khoảng gấp ba. Nó hợp với phi công thường chiến đấu trên thân tàu tầm trung và cần xoay vòng trong để tránh đòn tấn công của cướp biển. Trên [[ship/4]], nó nâng khả năng lái từ 0,91 lên 1,17, gần bằng chỉ số của [[ship/7]].", false],
	],
	"equipment/34": [
		[1, "", "Bộ đẩy tốt nhất thêm 0,56 vào chỉ số lái. Như vậy đủ để [[ship/6]] xoay tốt hơn [[ship/0]], hoặc giúp [[ship/5]] linh hoạt vô song. Nó hiếm và giá từ 87.000 cr trở lên, một món xa xỉ cho phi công chuyên chiến đấu. Trên thân tàu vốn đã dễ điều khiển, các bộ đẩy rẻ hơn có thể là cách dùng tiền tốt hơn.", false],
	],
	"equipment/35": [
		[1, "", "Radar cơ bản hiển thị tàu và các tín hiệu khác trên màn hình radar và đánh dấu chúng ở rìa tầm nhìn, giúp phi công tìm mục tiêu. Không có radar, màn hình chỉ hiển thị thông tin dẫn đường. Nó không nêu tên tàu thù địch cũng không hiển thị sinh vật, nhưng rẻ và thiết yếu.", false],
	],
	"equipment/36": [
		[1, "", "Radar chiến đấu này thêm khả năng nhận dạng: tàu thù địch trong tầm ngắm được gắn nhãn loại thân tàu và hàng hóa nó đang chở. Nó không hiển thị sinh vật, nên là công cụ của chiến binh. Với giá 18.500 đến 23.000 cr, nó đắt xấp xỉ [[equipment/37]], nên lựa chọn tùy vào việc phi công chủ yếu chiến đấu hay đánh cá.", false],
	],
	"equipment/37": [
		[1, "", "Radar đánh cá này hiển thị sinh vật trên màn hình radar cùng với tàu, giúp tìm những con mồi giá trị dễ hơn nhiều. Nó không gắn nhãn tàu thù địch như [[equipment/36]]. Với phi công tập trung đánh cá, đây là radar hữu ích nhất, chỉ sau [[equipment/38]].", false],
	],
	"equipment/38": [
		[1, "", "Radar cao cấp nhất kết hợp cả hai chuyên môn: nó gắn nhãn tàu thù địch và hiển thị sinh vật trên màn hình radar. Nó đắt khoảng gấp đôi mỗi loại radar chuyên dụng và hiếm có ở cửa hàng. Vì chỉ lắp được một radar, nó giúp không phải chọn giữa đánh cá và chiến đấu.", false],
	],
	"equipment/39": [
		[1, "", "Bộ tăng tốc cơ bản tăng gấp đôi tốc độ tàu trong 3 s, sau đó cần 20 s để nạp lại. Chỉ lắp được một bộ tăng tốc. Nó hữu ích để áp sát mục tiêu, thoát khỏi nguy hiểm hoặc đến cổng S.T.R.E.A.M. nhanh hơn, và phổ biến lại rẻ.", false],
	],
	"equipment/4": [
		[1, "", "Súng cuộn từ này nâng sát thương mỗi phát lên 22 nhưng kéo dài chu kỳ lên 3,4 s, nên sát thương duy trì hầu như không hơn [[equipment/3]]. Tầm bắn gần như không đổi, 884 m. Đây là lựa chọn tạm được khi mẫu rẻ hơn không có bán, nhưng mức nâng cấp không xứng với chênh lệch giá.", false],
	],
	"equipment/40": [
		[1, "", "Bộ tăng tốc này tăng tốc độ lên 2,5 lần trong khoảng 4 s và nạp lại trong khoảng 16 s. Mọi chỉ số đều tốt hơn [[equipment/39]], với giá khoảng gấp đôi. Đây là lựa chọn tốt giữa chiến dịch cho phi công chiến đấu, và nó cũng rút ngắn quãng đường đến cổng S.T.R.E.A.M. trong những chuyến đi dài.", false],
	],
	"equipment/41": [
		[1, "", "Bộ tăng tốc tốt nhất tăng gấp ba tốc độ trong khoảng 5 s và nạp lại trong 14,5 s, nên sẵn sàng thường xuyên hơn và kéo dài lâu hơn mọi loại khác. Nó hiếm, nhưng với giá khoảng 42.000 cr, nó rẻ hơn phần lớn trang bị hàng đầu.", false],
	],
	"equipment/42": [
		[1, "", "Một khẩu pháo trạm hạng nặng không bao giờ xuất hiện trên kệ hàng thông thường và không có giá niêm yết. Nó gây 40 sát thương mỗi phát, cứ 0,93 s một phát, với tầm 240 m, cho sát thương duy trì gần bằng những súng phóng khối tốt nhất trong khi mỗi phát đánh mạnh ngang một quả ngư lôi tầm trung.", false],
		[33, "", "Từ [[chapter/33]] trở đi, chiến dịch xoay quanh cuộc tìm kiếm một khẩu pháo loại này.", false],
		[42, "", "Trong [[chapter/42]], phi công phải lắp một khẩu trước khi khởi hành và thử nó với cướp biển.", false],
	],
	"equipment/43": [
		[1, "", "Robot sửa chữa này hồi phục một điểm thân tàu mỗi 0,6 s, khoảng 100 điểm mỗi phút, khi thân tàu bị hư hại. Nó không tác động đến khiên hay giáp. Nó hữu ích cho những nhiệm vụ dài và cho những tàu có thân yếu không chịu nổi một phát bắn lạc. Chỉ lắp được một chiếc, và nó chiếm một ô lẽ ra có thể lắp súng.", false],
	],
	"equipment/5": [
		[1, "", "Súng cuộn từ cao cấp nhất là vũ khí bắn tỉa. Mỗi tia gây 35 sát thương ở tầm tới 1.380 m, xa nhất trong mọi vũ khí, nhưng cứ 5,6 s mới bắn được một phát. Đây là một trong những món hiếm nhất ở cửa hàng. Lắp cùng các khẩu súng tầm ngắn, nó làm suy yếu mục tiêu từ lâu trước khi phần còn lại của dàn hỏa lực vươn tới.", false],
	],
	"equipment/6": [
		[1, "", "Pháo nhiệt hạch đầu tiên là vũ khí cận chiến: 10 sát thương mỗi 0,51 s, nhưng tầm chỉ 160 m, ngắn nhất trong mọi loại súng. Tốc độ gây sát thương cao hơn hẳn mọi khẩu súng điện từ. Nó hợp với thân tàu linh hoạt có thể áp sát nhanh, và khiến súng điện từ trở nên lỗi thời trong cận chiến.", false],
	],
	"equipment/7": [
		[1, "", "Bản nâng cấp này gây 14 sát thương mỗi 0,37 s, tốc độ bắn nhanh nhất trong mọi loại súng, và tăng tầm lên 216 m. Sát thương duy trì gần gấp đôi [[equipment/6]], chỉ đắt hơn vài nghìn tín dụng. Xét theo đồng tiền bỏ ra, đây là một trong những khẩu súng mạnh nhất trò chơi.", false],
	],
	"equipment/8": [
		[1, "", "Pháo nhiệt hạch mạnh nhất gây 18 sát thương mỗi 0,40 s ở tầm 220 m. Đây là cải tiến đáng kể so với [[equipment/7]], dù khoảng cách nhỏ hơn giữa hai mẫu đầu. Nó hiếm có ở cửa hàng. Khi gặp, đây là món đáng mua cho bất kỳ dàn hỏa lực tầm gần nào.", false],
	],
	"equipment/9": [
		[1, "", "Súng phóng khối đầu tiên đánh mạnh, 16 sát thương mỗi phát, nhưng chỉ bắn mỗi 0,6 s và tầm 195 m. Với giá từ 38.000 cr trở lên, nó gây sát thương mỗi giây thấp hơn [[equipment/7]] rẻ hơn. Nó chủ yếu là bước đệm để tiến tới các súng phóng khối về sau.", false],
	],
	"faction/colonists": [
		[1, "", "Người định cư là những người khai hoang và quản lý cai trị hành tinh đại dương khi câu chuyện bắt đầu. Họ nắm giữ toàn bộ hai trăm trạm, định giá mẻ cá và quyết định ai được giao việc. Thuộc địa của họ được xây dựng để khai thác tài nguyên của biển và chuyển chúng ra khỏi hành tinh. Về thuộc địa như một nơi chốn, xem [[world/colony]].", false],
		[1, "Lịch sử", "Người định cư đến hành tinh từ nơi khác và xây dựng các trạm sâu dưới biển. Khi phi công đến, thuộc địa đã được thiết lập từ lâu, với viên chức ở mọi trạm, tàu tuần tra ở mọi cổng và một dòng hàng xuất khẩu đều đặn.", false],
		[21, "", "Theo lời kể của quân nổi dậy, quá trình thuộc địa hóa diễn ra nhanh chóng và bất chấp hậu quả. Họ cảnh báo rằng đại dương đang bị rút cạn sự sống nhanh hơn khả năng phục hồi, và những hành tinh khác đã bị vắt kiệt theo cùng một cách.", false],
		[1, "Tổ chức", "Mỗi trạm do các viên chức thuộc địa điều hành, họ lo việc buôn bán, giao hợp đồng và chỉ huy các đội tuần tra địa phương. Đứng trên họ là một cơ quan thương mại giám sát hàng xuất khẩu và bắt các trạm chịu trách nhiệm về mọi tổn thất. An ninh trạm và các phi công riêng của thuộc địa đối phó với cướp biển và các mối đe dọa khác, thường bằng cách thuê người làm tự do.", false],
		[10, "", "Hàng hóa rời hành tinh bằng khoang vận chuyển, được phóng từ các trạm lên quỹ đạo và được tàu chở hàng thu gom ở đó.", false],
		[1, "Mục tiêu và phương pháp", "Mục tiêu của thuộc địa là lợi nhuận cho những kẻ đứng đầu. Nó mua mẻ cá và hàng hóa theo giá thấp cố định và không cho các trạm tự do buôn bán. Động vật cản đường bị tiêu diệt, và bất kỳ ai đe dọa các chuyến hàng đều bị đánh đuổi.", false],
		[23, "", "Đối mặt với cuộc nổi dậy, người định cư chuyển từ quản lý sang dùng vũ lực. Họ rải thủy lôi trên các tuyến tiếp tế, giăng bẫy phục kích và tấn công các trạm của quân nổi dậy.", false],
		[28, "", "Họ cũng sẵn sàng mua chuộc lòng trung thành. Một khoản tiền thưởng là đủ để khiến một phi công nổi dậy quay lưng với chính người lãnh đạo của mình.", false],
		[2, "Thành viên đáng chú ý", "[[character/9]] là người định cư mà phi công biết rõ nhất: một viên chức kiêu ngạo tại [[station/0]], coi thường phi công và mua mẻ cá theo giá cố định.", false],
		[9, "", "Các viên chức cấp thấp hơn xuất hiện dưới tên chung [[character/6|người định cư]] không danh tính, chẳng hạn viên chức tại [[station/1]] trả công bèo bọt cho cuộc tàn sát ốc anh vũ rồi giao cho phi công làm việc trên bảng hợp đồng.", false],
		[23, "", "Jack vươn lên nắm quyền lực đáng kể trong câu chuyện, có vẻ nhờ quan hệ tốt, và trở thành kẻ thù quyết liệt nhất của quân nổi dậy.", false],
		[28, "", "[[character/3]], một phi công nổi dậy, bí mật nhận tiền của thuộc địa và phản bội đồng đội.", false],
		[3, "Vai trò trong câu chuyện", "Ban đầu người định cư chỉ đơn giản là chủ của phi công. Jack mua mẻ cá và gợi ý phi công mua súng để săn cướp biển.", false],
		[7, "", "Tiếp đó hắn ra lệnh tiêu diệt [[species/0|ốc anh vũ]] tại [[station/1]], chẳng mấy bận tâm chúng bị bắt hay bị giết.", false],
		[10, "", "Sau vài hợp đồng, thuộc địa tin giao cho phi công việc bảo vệ một lần phóng khoang tại [[station/2]] chống lại người Aquarian.", false],
		[12, "", "Jack đổ lỗi cho phi công về các khoang bị hư hại trong trận đó và từ chối trả bất kỳ khoản nào. Chán ngán cách thuộc địa đối xử, phi công đi tìm phong trào kháng chiến.", false],
		[18, "", "Khi quân nổi dậy giành hết trạm này đến trạm khác bằng thuyết phục, thuộc địa mất dần chỗ đứng mà không cần nổ một phát súng.", false],
		[23, "", "Jack rải thủy lôi trên tuyến tiếp tế của quân nổi dậy giữa [[station/9]] và [[station/37]].", false],
		[25, "", "Sau đó hắn phục kích người lãnh đạo quân nổi dậy [[character/2]] trên đường bà đến đàm phán tại [[station/10]].", false],
		[28, "", "Tiền thưởng của Jack khiến Raymond quay sang chống lại quân nổi dậy. Raymond bắt cóc Ayumi, và phi công giải cứu bà.", false],
		[31, "", "Người định cư đã đánh cắp [[world/biotek]] nguyên mẫu của [[world/abel|Giáo sư Abel]]. Quân nổi dậy chặn đoàn tàu chở nó gần Cho.", false],
		[37, "", "Jack bán một khẩu pháo trạm [[world/eclipse|Eclipse]] trên chợ đen, không hề ngờ rằng nó sẽ được dùng để chống lại chính hắn.", false],
		[44, "", "Người định cư mở một cuộc tấn công bất ngờ vào [[station/14]], trái tim của cuộc nổi dậy, nhưng bị đánh tan khi người Aquarian đến trợ giúp quân nổi dậy. Jack bỏ chạy khỏi trận đánh.", false],
		[46, "", "Cuộc tổng tấn công đầu tiên của quân nổi dậy chiếm [[station/18]] từ tay người định cư.", false],
		[47, "", "Cuộc thứ hai chiếm [[station/109]], và sự kiểm soát của người định cư ở phía nam sụp đổ.", false],
		[48, "", "[[station/0]], thành trì cuối cùng của thuộc địa, thất thủ trong trận chiến cuối cùng. Jack trốn thoát trong một khoang cứu hộ, và sự cai trị của thuộc địa trên đại dương chấm dứt.", false],
		[1, "Trong trò chơi", "Trạm của người định cư hiện màu xanh lam trên [[chart]]. Chúng không có chợ và không có nhà máy: khi cập bến, chúng lấy toàn bộ khoang hàng theo giá sàn. Điều này khiến chúng là nơi không nên đến khi chở hàng giá trị. Cửa hàng và xưởng đóng tàu của chúng vẫn mở, nhưng xưởng đóng tàu chỉ bán thân tàu tiêu chuẩn. Xem [[guide/allegiance]].", false],
		[1, "", "Bảng hợp đồng của chúng có các hợp đồng [[contract/0]], [[contract/1]], [[contract/2]], [[contract/3]], [[contract/4]], [[contract/5]], [[contract/7]], [[contract/8]], [[contract/9]], [[contract/10]] và [[contract/11]], nhưng không bao giờ có giao hàng hay bảo vệ cá. Trong các nhiệm vụ đoàn tàu cho người định cư, tàu đối phương là quân nổi dậy.", false],
		[1, "", "Mặt khác, trạm của người định cư trả tiền thưởng cướp biển gấp đôi mức của quân nổi dậy: bình phương số tàu bị tiêu diệt trong chuyến, nhân với 100 tín dụng. Tàu tuần tra quanh các trạm của người định cư chiến đấu cho thuộc địa và giúp đánh cướp biển.", false],
		[12, "", "Các trạm rời khỏi thuộc địa khi câu chuyện tiến triển, không bao giờ do bất cứ điều gì làm trong lúc chơi tự do, và không trạm nào quay trở lại. Khi phi công đã đứng về phía quân nổi dậy, tàu của người định cư trở thành kẻ thù chính trong các nhiệm vụ cốt truyện.", false],
	],
	"faction/pirates": [
		[1, "", "Cướp biển là những kẻ ngoài vòng pháp luật cướp bóc tàu thuyền khắp đại dương. Chúng không phục vụ thuộc địa cũng không phục vụ quân nổi dậy, tấn công tàu đơn độc, đoàn tàu và bất kỳ ai trông giống con mồi dễ xơi. Chúng là đối thủ thường gặp nhất của phi công từ chuyến ra khơi có vũ trang đầu tiên cho đến cuối câu chuyện và cả sau đó.", false],
		[1, "Lịch sử", "Nạn cướp biển đã là chuyện thường ngày khi phi công đến. Các trạm trả tiền thưởng cho bất kỳ ai tiêu diệt tàu cướp biển, và săn cướp biển là một nghề phổ biến trong giới phi công có vũ trang.", false],
		[21, "", "Xung đột giữa người định cư và quân nổi dậy là món quà cho bọn cướp biển. Khi cả hai phe đều bị phân tâm, chúng tìm được nhiều nạn nhân hơn và dễ dàng hơn, và ban lãnh đạo quân nổi dậy quyết định không thể làm ngơ chúng nữa.", false],
		[1, "Tổ chức", "Cướp biển hoạt động thành những băng nhóm lỏng lẻo chứ không phải một tổ chức duy nhất, và không tên nào được nêu tên trong câu chuyện. Các băng tụ tập trong những sào huyệt ngoài vùng nước mở, hộ tống tàu bị cướp và canh giữ các bãi thủy lôi và bãi mảnh vụn. Những tên cướp đơn lẻ cũng phục sẵn gần các trạm chờ tàu qua lại.", false],
		[1, "Mục tiêu và phương pháp", "Cướp biển muốn chiến lợi phẩm. Chúng tấn công tàu để cướp hàng và tụ tập ở bất cứ nơi nào có rắc rối, chờ những con tàu bị suy yếu để xơi tái.", false],
		[23, "", "Chúng lượn lờ quanh bãi thủy lôi của thuộc địa gần [[station/9]], hy vọng xơi tái những con tàu bị mắc kẹt trong đó.", false],
		[35, "", "Những tay súng đánh thuê cũng lui tới cùng những chốn ấy. Thợ săn tiền thưởng [[character/11]] đi cùng một đội hộ tống có vũ trang, và về mặt tiền thưởng, tàu của hắn được tính là cướp biển.", false],
		[5, "Thành viên đáng chú ý", "Cướp biển chỉ xuất hiện trong câu chuyện dưới dạng những phi công [[character/10|cướp biển]] vô danh, không có thủ lĩnh hay thuyền trưởng nổi tiếng nào.", false],
		[5, "Vai trò trong câu chuyện", "Cướp biển là mục tiêu đầu tiên của khẩu súng điện từ mới của phi công. Theo gợi ý của [[character/1]], phi công truy lùng một tên cướp biển gần [[station/1]].", false],
		[21, "", "Ayumi quyết định thôi chỉ phòng thủ cho phong trào và ra tay đánh cướp biển. Bà cử phi công và [[character/3]] đi đánh một băng gần [[station/8]].", false],
		[25, "", "Cướp biển được dự đoán sẽ xuất hiện trên đường đến [[station/10]], dù mối đe dọa thực sự ở đó hóa ra đến từ thuộc địa.", false],
		[26, "", "Được lệnh phải trở thành một chiến binh giỏi hơn, phi công chuyển sang săn cướp biển để tăng số tàu hạ được.", false],
		[42, "", "Một sào huyệt cướp biển gần [[station/17]] trở thành bãi thử cho khẩu [[world/eclipse|Eclipse]] vừa được lắp.", false],
		[43, "", "Bọn cướp biển ở đó chẳng mấy chốc đã phải gọi tiếp viện.", false],
		[47, "", "Ngay cả trong các cuộc tổng tấn công cuối cùng, cướp biển vẫn cản đường [[character/5]] trên đường đến [[station/0]].", false],
		[1, "Trong trò chơi", "Cướp biển là kẻ thù tiêu chuẩn ngoài vùng nước mở. Thân tàu của chúng bền hơn và súng mạnh hơn khi cấp bậc của phi công tăng và câu chuyện tiến triển. Chúng xuất hiện trong các hợp đồng [[contract/0]], [[contract/1]], [[contract/2]] và [[contract/3]], và canh giữ các bãi thủy lôi và bãi mảnh vụn. Xem [[guide/combat]].", false],
		[1, "", "Từ [[chapter/12|chương 12]] trở đi, có thể có tối đa ba tên cướp biển chờ sẵn gần trạm khi phi công đến, và khả năng này tăng dần theo từng chương. Từ [[chapter/16|chương 16]], cướp biển và các tàu thù địch khác cũng biết tăng tốc đột ngột.", false],
		[1, "", "Mỗi tên cướp biển bị tiêu diệt trong một chuyến làm tăng tiền thưởng được trả ở trạm tiếp theo: bình phương số tàu bị tiêu diệt, nhân với 100 tín dụng tại trạm của người định cư hoặc 50 tại trạm của quân nổi dậy. Vì vậy những cuộc săn dài được trả công hậu hơn nhiều so với những cuộc săn ngắn. Xác tàu của chúng chìm chậm và có thể dùng lao móc thu hàng trước khi chìm quá sâu.", false],
		[1, "", "Cướp biển không có trạm riêng, và không trạm nào từng ngả về phía chúng.", false],
	],
	"faction/rebels": [
		[1, "", "Quân nổi dậy là một trong những thế lực có thể nắm giữ trạm. Bản chất và mục tiêu của họ dần sáng tỏ khi câu chuyện diễn tiến. Xem [[guide/allegiance]].", false],
		[12, "", "Quân nổi dậy là một phong trào kháng chiến nổi lên chống lại sự cai trị của thuộc địa trên hành tinh đại dương. Họ khởi đầu là một mạng lưới bí mật đóng tại [[station/3]] và lan rộng theo từng trạm. Họ muốn tự do thương mại và một vùng biển được sử dụng có chừng mực thay vì bị cướp bóc.", false],
		[12, "Lịch sử", "Phong trào đã hoạt động khi phi công lần đầu nghe nói đến nó, qua liên lạc radio mà M.A.I. bắt được từ Talon.", false],
		[13, "", "Quân nổi dậy chỉ bắt đầu mã hóa các kênh của mình vài ngày sau lần phát sóng đó. Các thành viên giữ kín kế hoạch và thử thách người mới trước khi tin tưởng.", false],
		[18, "", "Trong một thời gian dài, phong trào lớn mạnh nhờ thuyết phục. Các đặc vụ thu thập tin tức về các trạm và lôi kéo lãnh đạo của chúng, và chẳng bao lâu tin tức đã gọi phong trào là một cuộc cách mạng. Pierre cho rằng giai đoạn hòa bình sẽ không kéo dài.", false],
		[26, "", "Cuộc phục kích tại [[station/10]] cho thấy chỉ ngoại giao thôi sẽ không thắng được cuộc đấu tranh, và phong trào chuẩn bị chiến đấu.", false],
		[31, "", "Để vượt qua ưu thế quân số của người định cư, ban lãnh đạo quân nổi dậy đưa [[world/abel|Giáo sư Abel]] và nhóm của ông đến [[station/14]], nơi trở thành căn cứ hoạt động của phong trào.", false],
		[13, "Tổ chức", "Phong trào nhỏ và được tổ chức chặt chẽ. Tân binh được sàng lọc khi đến và chỉ được cho biết những gì cần biết. Nhiệm vụ được truyền xuống qua một vài đặc vụ đáng tin cậy.", false],
		[18, "", "Người lãnh đạo phong trào điều hành mọi bước tiến từ một trong những trạm vừa thu phục được, và ngay cả các thành viên cũng không rõ là trạm nào.", false],
		[19, "", "Người lãnh đạo đi lại giữa các trạm để trực tiếp đàm phán. Dưới quyền bà là các đặc vụ thực địa, phi công và kỹ sư.", false],
		[45, "", "Đến cuối cuộc chiến, phong trào đã có những biệt đội tàu chiến đấu hoàn chỉnh.", false],
		[13, "Mục tiêu và phương pháp", "Quân nổi dậy lên án việc bóc lột hành tinh cùng cư dân của nó và ủng hộ tự do thương mại.", false],
		[15, "", "Nền kinh tế của họ trái ngược với thuộc địa. Họ đánh bắt và khai thác chỉ những gì biển có thể cho, chế biến mẻ cá thành hàng hóa trong nhà máy của mình và buôn bán theo giá thị trường công bằng, cẩn thận bảo tồn đa dạng sinh học.", false],
		[16, "", "Họ thích lôi kéo người khác hơn là chiến đấu với họ. Các đặc vụ thám thính các trạm để tìm ra điểm yếu có thể dùng để thuyết phục dân chúng ở đó.", false],
		[21, "", "Người lãnh đạo của họ cảnh báo rằng sự bóc lột của thuộc địa sẽ vắt kiệt hành tinh như đã từng xảy ra với những hành tinh khác. Phong trào muốn thuyết phục những người có ảnh hưởng gia nhập trước khi điều đó xảy ra. Nó cũng chủ động đánh vào bọn cướp biển đang trục lợi từ sự hỗn loạn.", false],
		[31, "", "Khi không thể tránh được vũ lực, quân nổi dậy bắt tay chế tạo một vũ khí quyết định thay vì đọ từng con tàu với thuộc địa.", false],
		[12, "Thành viên đáng chú ý", "[[character/4]] sàng lọc người mới tại [[station/3]]. Các nhân viên radio, lính gác và thủy thủ đoàn các đoàn tàu của quân nổi dậy xuất hiện dưới tên [[character/7]].", false],
		[13, "", "[[character/5]] là một đặc vụ thực địa, người giới thiệu cho phi công lối sống của phong trào.", false],
		[33, "", "Về sau Pierre điều hành xưởng tàu tại [[station/14]], giữ cho tàu của phong trào luôn sẵn sàng.", false],
		[19, "", "[[character/2]] lãnh đạo phong trào. Bà là một phụ nữ lớn tuổi, dù phi công vốn tưởng người lãnh đạo là đàn ông.", false],
		[21, "", "[[character/3]] là một trong những phi công giỏi nhất của Ayumi, tài năng nhưng kiêu ngạo.", false],
		[28, "", "Raymond trở thành kẻ phản bội vì một khoản tiền thưởng của thuộc địa và bắt cóc Ayumi.", false],
		[31, "", "[[world/abel|Giáo sư Abel]] đứng đầu nhóm khoa học đằng sau [[world/biotek]].", false],
		[45, "", "[[character/12]] chỉ huy một biệt đội chiến đấu cùng phi công tấn công [[station/18]].", false],
		[12, "Vai trò trong câu chuyện", "Sau khi bất hòa với thuộc địa, phi công tìm đến phong trào tại Talon.", false],
		[13, "", "Pierre nhận phi công vào thử việc. Nhiệm vụ đầu tiên là đưa Leah từ [[station/4]] đến [[station/5]].", false],
		[16, "", "Những nhiệm vụ tiếp theo nối nhau: sản xuất hàng hóa tại các trạm nổi dậy và thám thính các trạm cho phong trào.", false],
		[19, "", "Cuối cùng phi công gặp Ayumi và bảo vệ một đàn mực khỏi thợ săn của người định cư gần [[station/7]].", false],
		[22, "", "Cùng với Raymond, phi công tiêu diệt một băng cướp biển gần [[station/8]].", false],
		[24, "", "Sau đó phi công rà phá một bãi thủy lôi của thuộc địa gần [[station/9]].", false],
		[26, "", "Tại Sula, ban lãnh đạo bị phục kích. Súng của Raymond hỏng vào đúng thời khắc quyết định, và Leah nghi có kẻ phá hoại.", false],
		[28, "", "Raymond dụ phi công vào bẫy với Ayumi làm con tin, nhưng phi công phá hủy tàu của hắn và cứu bà còn sống.", false],
		[31, "", "Phong trào triển khai một kế hoạch ba bước, bắt đầu bằng việc thu hồi [[world/biotek]] bị đánh cắp.", false],
		[33, "", "Bước thứ hai là kiếm một khẩu pháo [[world/eclipse|Eclipse]], thứ mà phi công mua qua một tay buôn chợ đen.", false],
		[39, "", "Bước thứ ba là chế tạo lồng ấp để hoàn thiện máy phát, tại [[station/16]].", false],
		[44, "", "Vũ khí được hoàn thiện ngay trước khi người định cư tấn công Fiir. Khẩu Eclipse của phi công cùng sự trợ giúp bất ngờ của [[world/aquarians|người Aquarian]] đã cứu trạm.", false],
		[45, "", "Người Aquarian cam kết ủng hộ, và phong trào lên kế hoạch cho các cuộc tổng tấn công cuối cùng với họ là đồng minh.", false],
		[47, "", "Hai cuộc tổng tấn công diễn ra. Leah chiếm [[station/109]] và phi công chiếm [[station/18]].", false],
		[48, "", "Cuộc chiến kết thúc với sự thất thủ của [[station/0]], và phong trào nắm giữ mọi trạm trên hành tinh.", false],
		[1, "Trong trò chơi", "Trạm của quân nổi dậy hiện màu cam trên [[chart]]. Chúng có chợ tự do và nhà máy, nên có thể mua, bán và làm hàng hóa ở đó; xem [[guide/trading]]. Xưởng đóng tàu của chúng bán mọi thân tàu ở phiên bản nâng cấp. Tàu tuần tra quanh các trạm nổi dậy chiến đấu cho quân nổi dậy.", false],
		[1, "", "Bảng hợp đồng của chúng có các hợp đồng [[contract/0]], [[contract/1]], [[contract/2]], [[contract/3]], [[contract/6]], [[contract/8]], [[contract/9]], [[contract/10]], [[contract/13]] và [[contract/14]]. Chúng không bao giờ đăng việc hộ tống, cướp đoàn tàu, săn cá hay việc liên quan đến khoang vận chuyển, và ngừng đăng việc bảo vệ cá khi câu chuyện đã kết thúc. Khi hợp đồng của quân nổi dậy có giao chiến với tàu khác, đối thủ là người định cư hoặc cướp biển.", false],
		[1, "", "Trạm của quân nổi dậy trả tiền thưởng cướp biển bằng một nửa mức của người định cư: bình phương số tàu bị tiêu diệt trong chuyến, nhân với 50 tín dụng.", false],
		[12, "", "Các trạm gia nhập quân nổi dậy khi câu chuyện tiến triển, lúc đầu chỉ vài trạm một lần, về sau hàng chục trạm cùng lúc. Một trạm đã gia nhập thì không bao giờ quay về với thuộc địa. Trang này liệt kê các trạm gia nhập trong mỗi chương mà bạn đã đến.", false],
	],
	"goods/18": [
		[1, "", "Phần còn lại của một sinh vật bị giết thay vì bị bắt bằng lao móc. Xác nổi lên và có thể dùng lao móc kéo về, thu được lượng thịt bằng một phần ba khối lượng con vật. Nó bán với giá 12 đến 31 cr và chủ yếu được dùng cùng [[species/14]] để làm [[goods/19]]. Trạm gốc của nó là [[station/68]].", false],
	],
	"goods/19": [
		[1, "", "Một sản phẩm cơ bản làm từ [[goods/18]] và [[species/14]], mỗi thứ một đơn vị cho mỗi đơn vị sản phẩm. Nhà máy nào cũng làm được. Nó bán từ 135 cr tại [[station/78]] đến 360 cr tại [[station/27]], và là nguyên liệu của [[goods/30]] và [[goods/36]].", false],
	],
	"goods/20": [
		[1, "", "Da thuộc từ [[species/3]], được xử lý bằng [[goods/33]]. Trạm gốc của nó là [[station/164]], và nó bán được giá nhất, tới 1.062 cr, tại [[station/172]]. Nó cũng là một nửa công thức của [[goods/29]], nên một mẻ cá đuối manta có thể trở thành một trong những hàng tiêu dùng đắt giá nhất.", false],
	],
	"goods/21": [
		[1, "", "Một món cá sống và rong biển, làm từ [[species/4]] và [[species/17]]. Cả hai nguyên liệu đều là con mồi phổ biến, rẻ tiền, khiến sushi là sản phẩm đầu tay dễ làm. Nó bán từ 420 cr tại [[station/76]] đến 996 cr tại [[station/179]].", false],
	],
	"goods/22": [
		[1, "", "Một loại thuốc nhuộm chịu nước làm từ [[species/10]] và [[goods/35]]. Nó bán từ 750 cr tại [[station/54]] đến 1.872 cr tại [[station/27]]. Nó cũng là một trong hai nguyên liệu của [[goods/29]].", false],
	],
	"goods/23": [
		[1, "", "Những miếng thịt [[species/7]], được bảo quản bằng [[goods/33]]. Vì cá cờ khó bắt, bít tết là sản phẩm cao cấp: nó bán từ 456 cr tại [[station/109]] đến 1.260 cr tại [[station/19]].", false],
	],
	"goods/24": [
		[1, "", "Một hợp chất phát sáng chiết xuất từ [[species/5]] và [[species/1]] bằng [[goods/35]]. Nó bán từ 850 cr tại [[station/83]] đến 2.500 cr tại [[station/179]]. Nó là đầu vào chủ chốt của [[goods/32]], [[goods/41]] và [[goods/36]].", false],
	],
	"goods/25": [
		[1, "", "Một loại protein chiết xuất từ [[species/6]] và [[species/8]], được xử lý bằng [[goods/33]]. Nó bán từ 900 cr tại [[station/23]] đến 2.600 cr tại [[station/27]], và là thành phần nền của [[goods/31]].", false],
	],
	"goods/26": [
		[1, "", "Một món cá trộn làm từ [[species/8]], [[species/4]] và [[species/2]]. Nó có giá sàn cao nhất trong các loại thực phẩm, từ 1.916 cr tại [[station/196]] đến 3.030 cr tại [[station/179]], nhưng cần ba loại con mồi khác nhau.", false],
	],
	"goods/27": [
		[1, "", "Dược phẩm làm từ [[species/1]], [[species/13]], [[species/16]] và [[goods/33]]. Nó bán từ 930 cr tại [[station/151]] đến 2.316 cr tại [[station/179]] và là một trong các nguyên liệu của [[goods/41]]. Chợ hiếm khi bày bán.", false],
	],
	"goods/28": [
		[1, "", "Một loại sinh khối đã qua chế biến, cần mỗi loại tảo một đơn vị trong cả năm loại: [[species/13]], [[species/14]], [[species/15]], [[species/16]] và [[species/17]]. Nó bán từ 550 cr tại [[station/74]] đến 2.700 cr tại [[station/19]], chênh lệch lớn nhất trong các sản phẩm cơ bản, và được dùng cho [[goods/36]].", false],
	],
	"goods/29": [
		[1, "", "Quần áo làm từ [[goods/20]] và [[goods/22]], nên chuỗi cung ứng bắt nguồn từ [[species/3]] và [[species/10]]. Nó bán từ 1.626 cr tại [[station/175]] đến 3.420 cr tại [[station/172]]. Chợ hiếm khi bày bán.", false],
	],
	"goods/30": [
		[1, "", "Một nguồn điện di động lắp ráp từ [[goods/34]] và [[goods/19]]. Nó bán từ 1.150 cr tại [[station/78]] đến 1.900 cr tại [[station/27]]. Nó hiếm khi có ở chợ, nên tự làm thường là cách duy nhất để có.", false],
	],
	"goods/31": [
		[1, "", "Mỹ phẩm làm từ [[goods/25]] và [[goods/35]]. Chúng bán từ 1.536 cr tại [[station/23]] đến 3.840 cr tại [[station/27]]. Chợ hiếm khi bày bán, nên phi công làm collagen có thể tiến thêm một bước và kiếm được nhiều hơn đáng kể.", false],
	],
	"goods/32": [
		[1, "", "Một loại đèn mô phỏng ánh sáng ban ngày tự nhiên, chế tạo từ [[goods/34]] và [[goods/24]]. Nó bán từ 2.490 cr tại [[station/83]] đến 5.622 cr tại [[station/179]], là sản phẩm giá trị nhất mà nhà máy có thể làm từ con mồi và hàng nhập khẩu.", false],
	],
	"goods/33": [
		[1, "", "Sản phẩm phụ của quá trình khử muối, rẻ và có bán rộng rãi với giá 20 đến 36 cr. Nó không làm từ con mồi, nhưng cần cho [[goods/20]], [[goods/23]], [[goods/25]] và [[goods/27]]. Hợp đồng giao hàng không bao giờ yêu cầu nó.", false],
		[12, "", "Chợ của quân nổi dậy bổ sung lại nó giữa các lần ghé, vì đây là hàng nhập khẩu.", false],
	],
	"goods/34": [
		[1, "", "Linh kiện nhập khẩu, có bán rộng rãi với giá 193 đến 297 cr. Chúng không được sản xuất tại chỗ, nhưng cần cho [[goods/30]], [[goods/32]], [[goods/41]] và [[goods/36]]. Hợp đồng giao hàng không bao giờ yêu cầu chúng.", false],
		[12, "", "Chợ của quân nổi dậy bổ sung lại đồ điện tử giữa các lần ghé, vì đây là hàng nhập khẩu.", false],
	],
	"goods/35": [
		[1, "", "Một hóa chất nhập khẩu, có bán rộng rãi với giá 55 đến 123 cr. Nó cần cho [[goods/22]], [[goods/24]] và [[goods/31]]. Hợp đồng giao hàng không bao giờ yêu cầu nó.", false],
		[12, "", "Chợ của quân nổi dậy bổ sung lại nó giữa các lần ghé, vì đây là hàng nhập khẩu.", false],
	],
	"goods/36": [
		[1, "", "Một thiết bị phòng thí nghiệm để sao chép vật chất di truyền. Nó cần [[goods/19]], [[goods/34]], [[goods/28]] và [[goods/24]], và chỉ nhà máy cấp công nghệ 11 mới lắp ráp được. Chợ không bao giờ bày bán.", false],
		[39, "", "Từ [[chapter/39]] trở đi, chiến dịch yêu cầu phi công kiếm được một thiết bị này.", false],
	],
	"goods/37": [
		[1, "", "Một loại ma túy nhập khẩu được coi là vấn nạn xã hội ngày càng nghiêm trọng. Nó không làm từ con mồi, và chợ không bao giờ bày bán.", false],
		[34, "", "Trong [[chapter/34]], phi công phải giao một chuyến hàng cho một người liên lạc như một phần của cuộc giao dịch.", false],
	],
	"goods/38": [
		[1, "", "Một khẩu pháo trạm hạng nặng đóng trong thùng, trị giá 89.000 cr. Không thể mua nó ở chợ. Khi đã được giao và lắp đặt, nó trở thành vũ khí [[equipment/42]].", false],
		[37, "", "Đây là thứ phi công tìm kiếm từ [[chapter/33]], và phi công chở một khẩu trong [[chapter/37]].", false],
	],
	"goods/39": [
		[1, "", "Một chiếc xẻng gấp nhập khẩu. Giá của nó dao động từ 9 cr đến 999 cr tùy theo quãng đường vận chuyển, khiến nó thành món hàng đầu cơ. Không nhà máy nào làm ra nó, và hợp đồng giao hàng không bao giờ yêu cầu nó. Trạm gốc của nó là [[station/89]].", false],
	],
	"goods/40": [
		[1, "", "Một bức tượng nhỏ của một người hùng nổi tiếng, bán cho các nhà sưu tầm. Giá từ 999 cr đến 9.999 cr, từ [[station/90]] đến [[station/19]], mức tăng mạnh nhất trong mọi mặt hàng. Nó ít gặp ở chợ, và hợp đồng giao hàng không bao giờ yêu cầu nó.", false],
	],
	"goods/41": [
		[1, "", "Những robot y tế siêu nhỏ chế tạo từ [[goods/27]], [[goods/24]] và [[goods/34]]. Chúng thuộc loại hàng giá trị nhất, bán từ 4.315 cr tại [[station/76]] đến 11.972 cr tại [[station/179]], và chợ gần như không bao giờ bày bán.", false],
	],
	"guide/allegiance": [
		[1, "Hai loại trạm", "Mỗi trạm do một trong hai phe nắm giữ, thể hiện bằng màu của nó trên [[chart]]: xanh lam cho [[faction/colonists]] và cam cho [[faction/rebels]]. Khi cốt truyện bắt đầu, mọi trạm đều thuộc người định cư.", false],
		[1, "", "Phe nắm giữ quyết định trạm cung cấp những gì:", false],
		[1, "", "Buôn bán: trạm của người định cư không có chợ và không có xưởng chế tạo. Họ mua toàn bộ khoang hàng ngay khi đến theo giá sàn. Trạm của quân nổi dậy buôn bán và sản xuất tự do; xem [[guide/trading]].", true],
		[1, "", "Hợp đồng: mỗi phe đăng một tập hợp loại hợp đồng riêng; xem [[guide/contracts]].", true],
		[1, "", "Tiền thưởng: tiền thưởng cướp biển tại trạm của người định cư cao gấp đôi tại trạm của quân nổi dậy.", true],
		[1, "", "Tàu: xưởng đóng tàu của quân nổi dậy bán mỗi thân tàu ở phiên bản nâng cấp.", true],
		[1, "", "Tuần tra: các tàu đi tuần quanh một trạm chiến đấu cho phe của trạm đó.", true],
		[1, "", "Cập bến, cửa hàng trang bị, đại lý tàu và bảng hợp đồng đều mở cho phi công ở cả hai loại trạm.", false],
		[1, "Phe thay đổi như thế nào", "Các trạm chỉ đổi phe khi cốt truyện tiến triển, không bao giờ do hành động của phi công khi chơi tự do. Một khi đã gia nhập quân nổi dậy, trạm sẽ ở lại với họ. Trang [[faction/rebels]] liệt kê các trạm gia nhập trong mỗi chương bạn đã đến.", false],
		[12, "", "Trạm đầu tiên của quân nổi dậy là [[station/3]], đã theo phong trào kháng chiến từ khi phi công nghe nói đến lần đầu. [[station/4]] theo sau ở [[chapter/12|chương 12]].", false],
		[14, "", "Qua các chương tiếp theo, các trạm đổi phe từng trạm hoặc vài trạm một lúc.", false],
		[22, "", "Từ [[chapter/22|chương 22]], phong trào lớn mạnh nhanh hơn nhiều, với tám trạm trở lên gia nhập cùng lúc.", false],
		[46, "", "Đến những chương cuối, phần lớn hải đồ đã chuyển sang màu cam.", false],
		[12, "Ý nghĩa đối với phi công", "Khi càng nhiều trạm đổi phe, chợ và xưởng chế tạo mở ra khắp hải đồ và đánh cá không còn là cách kiếm sống duy nhất. Trạm của người định cư trở thành nơi nên tránh khi khoang chứa hàng giá trị, nhưng lại là nơi tốt để nhận tiền thưởng cướp biển.", false],
	],
	"guide/basics": [
		[1, "Con tàu đầu tiên", "Phi công bắt đầu tại [[station/0]] với 15.000 tín dụng và một chiếc [[ship/0]], tàu ngầm đánh cá cỡ nhỏ. Tàu được lắp sẵn lao móc [[equipment/15]], một [[equipment/18]], [[equipment/22]] và một [[equipment/35]]. Tàu không có súng.", false],
		[1, "", "Các chương đầu là phần nhập môn có hướng dẫn. [[character/1]], máy tính của tàu, giải thích từng việc mới khi nó xuất hiện: bắt cá, cập bến, lắp trang bị và di chuyển. Mục tiêu hiện tại luôn có trong nhật ký nhiệm vụ.", false],
		[1, "Lái tàu", "Bạn có thể lái tàu ngầm bằng bàn phím và chuột, tay cầm hoặc điều khiển cảm ứng, và mọi phím đều có thể gán lại trong Cài đặt. Ga thay đổi theo từng nấc một phần tư, và Dừng sẽ dừng tàu. Động cơ đẩy bên hông trượt tàu ngầm sang ngang ngay cả khi tàu đang đứng yên. Tăng tốc chỉ hoạt động khi đã lắp bộ tăng tốc. Camera chuyển vòng qua bốn góc nhìn.", false],
		[1, "", "Lái tự động mở một danh sách điểm đến: mục tiêu hiện tại, bến của trạm tại chỗ, cổng S.T.R.E.A.M. tại chỗ hoặc bất kỳ trạm nào trên hải đồ. Thao tác lái, ga hay vũ khí sẽ trả quyền điều khiển lại cho bạn. Xem [[guide/navigation]].", false],
		[1, "Cập bến", "Để cập bến, hãy lái vào khu vực cập bến của trạm và dùng Cập bến, hoặc chọn bến trong danh sách lái tự động. Không thể cập bến khi một cuộc giao tranh nhiệm vụ trong khu vực chưa kết thúc. Rời trạm luôn hồi phục đầy thân tàu, khiên và giáp, miễn phí.", false],
		[1, "Menu của trạm", "Một trạm đã cập bến cung cấp sáu dịch vụ:", false],
		[1, "", "Xưởng tàu: cửa hàng trang bị, đại lý tàu và chỗ xem tàu của bạn.", true],
		[1, "", "Nhiệm vụ: nhật ký các mục tiêu hiện tại và bảng hợp đồng của trạm.", true],
		[1, "", "Bản đồ: hải đồ các trạm, để lập lộ trình và tìm nơi các loài sinh sống.", true],
		[1, "", "Giao dịch: chợ để mua và bán hàng hóa, cùng xưởng chế tạo hàng hóa, trên hai thẻ.", true],
		[1, "", "Trạng thái: tàu, hàng hóa, cấp phi công, huân chương và thống kê của bạn.", true],
		[1, "", "Hệ thống: lưu game, cài đặt, trợ giúp và phần tra cứu này.", true],
		[1, "", "Một số dịch vụ mở muộn hơn trong cốt truyện. Bản đồ của trạm mở ở [[chapter/7|chương 7]] và bảng hợp đồng ở [[chapter/9|chương 9]]. Các trạm do [[faction/colonists]] nắm giữ không bao giờ buôn bán; xem [[guide/trading]].", false],
		[1, "Lưu game", "Bạn chỉ có thể lưu khi đang cập bến. Mỗi lần đến một trạm sẽ tự động ghi một điểm lưu, và menu Hệ thống có thêm ba ô lưu. Quay về menu chính từ một trạm sẽ lưu trước. Nếu thân tàu bị phá hủy, trò chơi tiếp tục từ bản lưu tại trạm gần nhất, nên hãy cập bến thường xuyên trong những chuyến đi dài.", false],
		[1, "", "Chuyển bản lưu, cũng nằm trong menu Hệ thống, xuất bản lưu tại trạm gần nhất ra tệp và nhập nó trên thiết bị khác.", false],
		[1, "Trợ giúp", "Trợ giúp trong menu Hệ thống giải thích từng màn hình của trạm. Khi đang ở ngoài biển, menu tạm dừng chứa hải đồ, nhật ký nhiệm vụ, trạng thái tàu, huân chương và cài đặt. M.A.I. bình luận một lần cho mỗi tình huống mới, chẳng hạn cổng đầu tiên hay lần lặn đầu tiên ra ngoài dải độ sâu an toàn. Có thể tắt các gợi ý này trong cài đặt lối chơi.", false],
		[1, "", "Tiếp theo, hãy đọc [[guide/depth]] trước khi đi xa, và [[guide/fishing]] để có thu nhập đầu tiên.", false],
	],
	"guide/combat": [
		[1, "Vũ khí", "Súng chia làm hai họ. Vũ khí đạn, như [[equipment/0]], [[equipment/6]] và [[equipment/9]], bắn ra loạt đạn liên tục. Vũ khí tia, các loại súng cuộn từ [[equipment/3]] trở lên, đánh mạnh ở tầm xa nhưng nạp lại chậm. Có thể lắp nhiều súng, và chúng bắn cùng lúc từ các giá gắn bố trí khắp mũi tàu.", false],
		[1, "", "Ngư lôi tự dẫn, từ [[equipment/12]] đến [[equipment/14]], lao thẳng trong một giây rưỡi, rồi chuyển hướng về mục tiêu còn sống gần nhất trong khoảng 150 m. Chỉ lắp được một bệ phóng ngư lôi. Mỗi trang vũ khí cho biết sát thương, tầm bắn và chu kỳ bắn.", false],
		[1, "Khai hỏa", "Súng và ngư lôi tạo thành một nhóm vũ khí, lao móc là một nhóm khác. Bắn dùng nhóm đang chọn, và Nhóm vũ khí chuyển đổi giữa chúng. Với chuột, nút trái bắn súng và nút phải bắn lao móc; với tay cầm, cò phải bắn súng và cò trái bắn lao móc.", false],
		[1, "", "Tự động bắn giữ cho nhóm đang chọn liên tục khai hỏa cho đến khi bạn tắt nó. Nó cũng kết thúc lái tự động.", false],
		[1, "Bảo vệ", "Hỏa lực địch rút cạn khiên trước, rồi đến giáp, rồi đến thân tàu. Khi thân tàu về không, tàu bị mất, và trò chơi tiếp tục từ bản lưu tại trạm gần nhất.", false],
		[1, "", "Khiên có khả năng tự nạp lại sẽ hồi phục khi đang ở ngoài biển. Giáp thì không, và thân tàu chỉ hồi phục khi có [[equipment/43]]. Rời trạm sẽ hồi phục cả ba. Bộ tăng tốc như [[equipment/39]] cho một cú tăng tốc ngắn để áp sát hoặc thoát ra, rồi cần thời gian để nạp lại.", false],
		[1, "Kẻ địch", "[[faction/pirates]] là kẻ địch thường gặp. Thân tàu của chúng chắc hơn và súng mạnh hơn khi cấp phi công của bạn và cốt truyện tiến triển. Từ [[chapter/12|chương 12]] trở đi, có thể có tới ba tên chờ sẵn gần một trạm.", false],
		[1, "", "Các cuộc giao tranh nhiệm vụ có đối thủ riêng: tàu bị truy nã, băng nhóm canh giữ một con tàu bị vô hiệu hóa, hộ vệ đoàn tàu và bãi thủy lôi. Xem [[guide/contracts]].", false],
		[10, "", "Người Aquarian tấn công các khoang vận chuyển của người định cư. Họ chiến đấu bằng vũ khí riêng và không để lại xác tàu khi bị tiêu diệt.", false],
		[1, "Tiền thưởng và chiến lợi phẩm", "Mỗi tên cướp biển bị tiêu diệt trong một chuyến làm tăng tiền thưởng được trả ở lần cập bến tiếp theo. Tiền thưởng bằng bình phương số cướp biển, nhân với 100 tín dụng tại trạm của người định cư hoặc 50 tại trạm của quân nổi dậy. Bốn tên cướp biển trong một chuyến mang về 1.600 tín dụng tại trạm của người định cư.", false],
		[1, "", "Tàu bị phá hủy để lại xác tàu có hàng hóa để trục vớt bằng lao móc. Số lần hạ địch được tính vào [[medal/4]], cướp biển được tính vào [[medal/14]], và hạ nhiều địch trong một chuyến được tính vào [[medal/9]].", false],
		[1, "", "Đừng để súng nhắm vào con cá bạn muốn bắt: sinh vật bị thương sẽ bỏ chạy, và con đang mắc lao móc sẽ mất nếu bị bắn trúng.", false],
	],
	"guide/contracts": [
		[1, "Bảng hợp đồng", "Từ [[chapter/9|chương 9]], dịch vụ Nhiệm vụ của mỗi trạm có một bảng hợp đồng gồm từ một đến tám hợp đồng. Mỗi hợp đồng ghi bên đặt hàng, tiền cọc phải trả khi nhận và thù lao được trả khi thành công. Bạn có thể giữ một hợp đồng cùng lúc với mục tiêu cốt truyện. Tiền cọc không được hoàn lại, nên bỏ dở hay thất bại một hợp đồng sẽ mất khoản đó.", false],
		[1, "Các loại hợp đồng", "Có mười lăm loại hợp đồng:", false],
		[1, "", "[[contract/0]]: tiêu diệt một con tàu được gia cố đang chờ gần trạm mục tiêu.", true],
		[1, "", "[[contract/1]] và [[contract/2]]: vô hiệu hóa một con tàu đi cùng băng cướp biển, rồi móc nó bằng lao móc trước khi nó trốn thoát.", true],
		[1, "", "[[contract/3]]: tiêu diệt mọi thành viên của một băng cướp biển.", true],
		[1, "", "[[contract/4]]: bảo vệ một đoàn tàu chở hàng khỏi kẻ cướp; mất toàn bộ đoàn tàu là thất bại.", true],
		[1, "", "[[contract/5]]: tiêu diệt các tàu chở hàng của một đoàn tàu có hộ vệ.", true],
		[1, "", "[[contract/6]]: bảo vệ một đàn sinh vật khỏi thợ săn; mất quá nhiều là thất bại.", true],
		[1, "", "[[contract/7]]: bắt hoặc giết một số lượng của một loài.", true],
		[1, "", "[[contract/8]]: chở một hành khách đến trạm khác, đôi khi có giới hạn số điểm dừng dọc đường.", true],
		[1, "", "[[contract/9]]: phá hủy mảnh vụn trôi nổi trong khoảng hai phút rưỡi.", true],
		[1, "", "[[contract/10]]: phá hủy một bãi thủy lôi có canh gác.", true],
		[1, "", "[[contract/11]]: bảo vệ các khoang vận chuyển trong một lần phóng.", true],
		[1, "", "[[contract/12]]: phá hủy các khoang vận chuyển. Loại này chỉ có trong cốt truyện, không bao giờ xuất hiện trên bảng hợp đồng.", true],
		[1, "", "[[contract/13]] và [[contract/14]]: giao một số lượng sản phẩm, hoặc của một loài, đến trạm đã đăng việc.", true],
		[1, "Ai đăng loại nào", "Trạm của [[faction/colonists|người định cư]] không bao giờ đăng [[contract/6]], [[contract/12]], [[contract/13]] hay [[contract/14]]. Trạm của [[faction/rebels|quân nổi dậy]] không bao giờ đăng [[contract/4]], [[contract/5]], [[contract/7]], [[contract/11]] hay [[contract/12]], và ngừng đăng [[contract/6]] khi cốt truyện đã hoàn tất. Hợp đồng giao hàng không bao giờ được đăng tại hai mươi mốt trạm đầu tiên trong bảng trạm của trò chơi, từ [[station/0]] đến [[station/20]].", false],
		[1, "Điểm đến và thù lao", "Phần lớn hợp đồng dẫn đến một trạm khác, thường nằm trong dải độ sâu của bạn và trong một khoảng cách tăng dần khi cốt truyện tiến triển. Thù lao bắt đầu từ 3.500 tín dụng và tăng theo độ khó và khoảng cách. [[contract/9]] trả ít hơn; hộ tống, bảo vệ cá và bảo vệ khoang trả nhiều hơn. Hành khách cho phép ít điểm dừng hơn sẽ trả thêm. Hợp đồng giao hàng chỉ yêu cầu một nửa tiền cọc thông thường.", false],
		[1, "", "Độ khó tăng theo cấp phi công của bạn. Cấp tăng khi bạn bắt sinh vật, tiêu diệt kẻ địch, làm hàng hóa và hoàn thành hợp đồng, nên những việc trả công cao hơn cũng đi kèm đối thủ mạnh hơn.", false],
		[1, "Thực hiện hợp đồng", "Khi đến khu vực mục tiêu, cuộc giao tranh bắt đầu. Tùy chọn mục tiêu của lái tự động sẽ lái tàu đến các điểm đánh dấu. Cập bến và cổng bị khóa cho đến khi cuộc giao tranh được giải quyết, và thất bại sẽ kết thúc hợp đồng. Hợp đồng giao hàng được thanh toán khi bạn cập bến cùng hàng hóa.", false],
		[1, "", "Mỗi hợp đồng hoàn thành được tính vào [[medal/12]].", false],
	],
	"guide/depth": [
		[1, "Độ sâu trong DEEP", "Mỗi trạm nằm ở một độ sâu cố định, hiển thị cùng cấp công nghệ trên trang của trạm. Phần lớn nằm trong khoảng 15.000 đến 30.000 m. [[station/28]] nằm cao nhất, ở 13.500 m, và [[station/81]] sâu nhất, ở 32.250 m. Đại dương không có đáy để chặn đường lặn: tàu ngầm có thể chìm sâu chừng nào thân tàu còn chịu được.", false],
		[1, "Dải an toàn", "Tàu chỉ an toàn trong một dải độ sâu do hai món trang bị quyết định. Khiên đặt giới hạn nông, tức độ cao nhất tàu có thể nổi lên. Giáp đặt giới hạn sâu, tức độ sâu nhất tàu có thể chìm xuống. Khi không lắp cả hai, dải này chỉ từ 22.000 đến 23.000 m.", false],
		[1, "", "[[ship/0]] khởi đầu với một [[equipment/18]] chịu được đến 20.000 m và [[equipment/22]] chịu được đến 25.000 m, nên dải của tàu là từ 20.000 đến 25.000 m. Khiên tốt hơn cho phép tàu lên cao hơn và giáp tốt hơn cho phép lặn sâu hơn. Mỗi trang trang bị cho biết mức chịu đựng của nó, và mỗi trang trạm cho biết cần mức nào để đến được. Chỉ lắp được một khiên và một giáp.", false],
		[1, "Ra ngoài dải an toàn", "Vượt qua một giới hạn sẽ kích hoạt cảnh báo. Sau năm giây ở ngoài dải, tàu chịu sát thương nhiều lần mỗi giây. Quá sâu, áp suất rút cạn khiên; quá cao, nó rút cạn giáp. Khi lớp đó cạn kiệt, sát thương đánh thẳng vào thân tàu.", false],
		[1, "", "Ban đầu mỗi lần sát thương rất nhỏ. Nó tăng thêm một điểm cho mỗi 2.000 m sâu hơn 30.000 m hoặc cao hơn 15.000 m, nên ở độ sâu cực đoan, tàu bị bào mòn rất nhanh.", false],
		[1, "", "Năm giây ân hạn cho phép những chuyến ra ngoài ngắn, chẳng hạn để đuổi theo con mồi hoặc vượt qua một trạm. Tăng tốc thời gian bị giới hạn ở 2× khi tàu ở ngoài dải an toàn.", false],
		[1, "Hồi phục", "Khiên có khả năng tự nạp lại chỉ hồi phục khi tàu ở sâu hơn giới hạn nông của nó. Giáp không hồi phục khi đang ở ngoài biển, và thân tàu chỉ hồi phục khi có [[equipment/43]]. Cả ba đều được hồi phục khi tàu rời trạm.", false],
		[1, "Lập kế hoạch chuyến đi", "Lái tự động và S.T.R.E.A.M. vẫn sẽ đưa bạn đến một trạm ngoài dải an toàn, sau một lời cảnh báo, nhưng khi đến nơi bạn sẽ mất một phần lớp bảo vệ. Hợp đồng trên bảng hợp đồng thường dẫn đến các trạm trong dải của bạn, nhưng không phải lúc nào cũng vậy. Hãy kiểm tra độ sâu của điểm đến trước khi nhận việc, và lắp lại trang bị nếu cần; xem [[guide/fitting]].", false],
		[1, "Kỷ lục độ sâu", "Điểm cao nhất và thấp nhất bạn đạt được đều được ghi lại. [[medal/21]] thưởng cho việc lên cao hơn 15.000, 12.000 và 10.000 m, và một huân chương khác thưởng cho việc lặn sâu hơn 30.000, 32.000 và 35.000 m. Xem [[guide/medals]].", false],
	],
	"guide/fishing": [
		[1, "Lao móc", "Đánh bắt dùng lao móc, tạo thành nhóm vũ khí riêng, tách biệt với súng. Mọi phi công đều bắt đầu với [[equipment/15]]; [[equipment/16]] và [[equipment/17]] tốt hơn. Lao móc có ba chỉ số: tầm, dung sai bắt (phát bắn phải đi gần mục tiêu đến mức nào để móc được) và làm chậm (mức nó làm tê liệt con mồi). Chỉ lắp được một lao móc.", false],
		[1, "", "Bắn lao móc bằng nút riêng của nó: chuột phải hoặc cò trái. Bạn cũng có thể chọn nhóm lao móc bằng Nhóm vũ khí rồi dùng Bắn.", false],
		[1, "Bắt con mồi", "Một phát trúng sẽ móc sinh vật, khiến nó bỏ chạy và vùng vẫy. Hãy giữ nó trước mũi tàu cho đến khi nó kiệt sức. Mọi sinh vật đều vùng vẫy ít nhất 2,1 giây, và những loài khỏe hơn vùng vẫy lâu hơn; trang của mỗi loài cho biết thời gian vùng vẫy. Lao móc làm chậm mạnh hơn giữ con mồi đang chạy trốn không chạy xa được.", false],
		[1, "", "Con mồi bị mất nếu nó bị thương, chẳng hạn do chính súng của bạn, hoặc nếu nó rời khỏi tầm nhìn trước khi chịu thua. Nhấn nút lao móc lần nữa sẽ thả con mồi đang bị móc.", false],
		[1, "", "Khi đã bị khuất phục, sinh vật được kéo vào và đưa lên tàu. Nó chiếm chỗ trong khoang theo khối lượng tính bằng tấn, và mỗi cá thể có thể nặng hơn hoặc nhẹ hơn một phần tư so với chỉ số của loài. Nếu khoang quá đầy, sinh vật sẽ ở lại dưới nước.", false],
		[1, "Tảo", "Năm loại tảo, từ [[species/17]] đến [[species/13]], đứng yên dưới đáy biển. Chúng chịu thua gần như ngay lập tức, nên là loại con mồi dễ bắt nhất.", false],
		[1, "Xác sinh vật và xác tàu", "Sinh vật bị giết bằng súng để lại một cái xác nổi lên trên. Dùng lao móc thu nó sẽ được [[goods/18]] nặng khoảng một phần ba con vật.", false],
		[1, "", "Tàu bị phá hủy để lại xác tàu chứa từ một đến bảy đơn vị một loại hàng. Dùng lao móc móc xác tàu để đưa hàng lên tàu. Mỗi xác tàu trục vớt được tính vào [[medal/18]].", false],
		[1, "Bán mẻ cá", "Tại trạm của [[faction/colonists|người định cư]], toàn bộ khoang hàng bị mua ngay khi đến theo giá sàn. Tại trạm của [[faction/rebels|quân nổi dậy]], cá và tảo có thể bán theo giá chợ hoặc dùng làm nguyên liệu trong xưởng chế tạo. Xem [[guide/trading]].", false],
		[1, "", "Mô-đun hàng hóa tăng sức chứa của khoang; xem [[guide/fitting]]. Hợp đồng [[contract/14]] trả tiền cho việc giao một số lượng của một loài, và hợp đồng [[contract/7]] yêu cầu bắt hoặc giết một số lượng nhất định.", false],
		[1, "", "Mỗi con mồi được tính vào [[medal/5]], và bắt được nhiều con trong một chuyến được tính vào [[medal/10]]. Bắt đủ mọi loài cá sẽ được [[medal/3]], và đủ mọi loài tảo sẽ được [[medal/2]].", false],
	],
	"guide/fitting": [
		[1, "Ô trang bị", "Mỗi thân tàu có một số ô trang bị cố định, từ sáu ô trên [[ship/0]] đến mười ô trên các thân tàu lớn nhất, và mỗi món chiếm một ô. Súng và mô-đun hàng hóa có thể lắp nhiều chiếc. Mọi loại khác, kể cả bệ phóng ngư lôi, chỉ được một chiếc mỗi tàu.", false],
		[1, "Các loại trang bị", "Súng và ngư lôi: xem [[guide/combat]].", true],
		[1, "", "Lao móc: bắt sinh vật và trục vớt xác tàu; xem [[guide/fishing]].", true],
		[1, "", "Khiên: hấp thụ sát thương trước tiên và đặt giới hạn độ sâu nông. Một số loại tự nạp lại khi đang ở ngoài biển.", true],
		[1, "", "Giáp: hấp thụ sát thương sau khiên và đặt giới hạn độ sâu sâu; xem [[guide/depth]].", true],
		[1, "", "Mô-đun hàng hóa: thêm một tỷ lệ phần trăm sức chứa hàng cơ bản của thân tàu. Hiệu quả cộng dồn.", true],
		[1, "", "Động cơ: mở rộng tầm S.T.R.E.A.M. theo tỷ lệ phần trăm của nó.", true],
		[1, "", "Bộ lái: giúp tàu xoay nhanh hơn.", true],
		[1, "", "Radar: hệ thống cảm biến của tàu.", true],
		[1, "", "Bộ tăng tốc: tăng thêm tốc độ trong vài giây, sau đó cần nạp lại.", true],
		[1, "", "Hệ thống sửa chữa: [[equipment/43]] từ từ sửa thân tàu khi đang ở ngoài biển.", true],
		[1, "Mua và bán", "Cửa hàng của một trạm bày bán từ hai đến năm món, chọn theo độ hiếm; món hiếm xuất hiện thường xuyên hơn khi cốt truyện tiến triển. Giá giảm theo cấp công nghệ: trạm cấp công nghệ 10 bán ở mức thấp nhất trong khoảng giá của món hàng, trạm cấp 1 bán gần mức cao nhất.", false],
		[1, "", "Trang bị được bán lại với giá thấp hơn một phần năm so với giá cửa hàng của trạm. Món đã qua sử dụng cũng được bán ra rẻ hơn một phần năm. Không thể bán mô-đun hàng hóa nếu khi bỏ nó đi khoang không còn chứa hết hàng.", false],
		[1, "", "Có hai trạm đặc biệt. [[station/28]] bán mọi loại trang bị và [[station/81]] bán mọi thân tàu, nhưng không có khiên hay giáp nào chịu được độ sâu của hai trạm này một cách an toàn.", false],
		[1, "Sửa chữa", "Không có phí sửa chữa. Thân tàu, khiên và giáp được hồi phục đầy mỗi khi tàu rời trạm.", false],
		[1, "Mua tàu", "Đại lý tàu bán tối đa ba thân tàu, và thân tàu lớn hơn chỉ xuất hiện khi cốt truyện tiến triển. Cấp công nghệ của trạm bằng bao nhiêu thì giá thân tàu giảm bấy nhiêu phần trăm. Tàu hiện tại của bạn được đổi lại với giá bằng bốn phần năm giá niêm yết.", false],
		[1, "", "Mọi trang bị và hàng hóa được chuyển sang thân tàu mới, nên tàu mới cần đủ ô trang bị và chỗ trong khoang. Xưởng đóng tàu của quân nổi dậy bán mỗi thân tàu ở phiên bản nâng cấp. [[ship/10]] có giá niêm yết rất lớn nhưng chỉ bán 50.000 tín dụng khi đã giành được mọi huân chương; xem [[guide/medals]].", false],
	],
	"guide/help": [
		[1, "", "Có thể lái tàu ngầm bằng bàn phím và chuột, tay cầm hoặc màn hình cảm ứng, và có thể dùng xen kẽ cả ba. Các phím dưới đây là mặc định; mọi phím dùng khi ở ngoài biển đều có thể đổi trong Cài đặt › Điều khiển › Gán phím, còn Cài đặt › Điều khiển › Bảng điều khiển luôn hiển thị bộ phím đang dùng.", false],
		[1, "Bàn phím và chuột", "Di chuột để xoay tàu và ngóc hoặc chúi mũi tàu, camera sẽ đi theo. W và S tăng và giảm ga mỗi lần một phần tư; A và D dịch tàu sang ngang (hoặc xoay tàu, nếu thiết lập bộ lái quy định như vậy), còn các phím mũi tên ngóc và chúi mũi tàu. Giữ Alt hoặc Ctrl để nhìn quanh bằng chuột mà không lái.", false],
		[1, "", "Chuột trái: bắn súng.", true],
		[1, "", "Chuột phải: phóng lao móc.", true],
		[1, "", "Space: bắn nhóm vũ khí đang chọn; Tab chuyển giữa nhóm chiến đấu và nhóm đánh bắt.", true],
		[1, "", "Q: bật hoặc tắt tự động bắn.", true],
		[1, "", "Shift: tăng tốc, nếu đã lắp bộ tăng tốc.", true],
		[1, "", "E: cập bến trạm phía trước, hoặc đi vào [[world/stream|S.T.R.E.A.M.]] tại một cổng.", true],
		[1, "", "R: nhấn nhanh để mở menu lái tự động, giữ để đi thẳng tới mục tiêu hiện tại.", true],
		[1, "", "T: tăng tốc thời gian; các mức nhanh hơn chỉ có khi lái tự động đang điều khiển tàu và không có mối nguy nào ở gần.", true],
		[1, "", "M: bản đồ. C: đổi camera. L: đèn pha (khi bật Chiếu sáng nâng cao).", true],
		[1, "", "Esc: tạm dừng, hoặc quay lại từ bất kỳ menu nào. F5 lưu khi đang cập bến; F11 bật tắt toàn màn hình.", true],
		[1, "", "Trong Cài đặt › Điều khiển › Bộ lái có thể cho con lăn chuột chỉnh ga theo từng nấc; khi đó S dừng tàu ngay lập tức.", false],
		[1, "Tay cầm", "Bố cục Tiêu chuẩn ngắm bằng cần phải; cần trái chỉnh ga (lên và xuống) và dịch ngang (trái và phải). Trong Cài đặt › Điều khiển › Tay cầm có thể chuyển sang bố cục Cổ điển của các bản phát hành trước, và nếu muốn thì giao vai trò khác cho mỗi trục của cần; đảo trục dọc, độ rung và vùng chết cũng được chỉnh ở đó.", false],
		[1, "", "RT: súng. LT: lao móc. RB: bắn nhóm vũ khí đang chọn. LB hoặc nhấn cần trái: tăng tốc.", true],
		[1, "", "A: cập bến hoặc đi vào S.T.R.E.A.M. X: menu lái tự động. Y: đổi camera. Giữ nhấn cần phải để nhìn quanh bằng nó.", true],
		[1, "", "View: bản đồ. D-pad lên và xuống: thời gian nhanh hơn và chậm hơn. D-pad trái: đổi nhóm vũ khí. D-pad phải: đèn pha.", true],
		[1, "", "Start hoặc B: tạm dừng. Trong menu, A để chọn và B để quay lại.", true],
		[1, "Cảm ứng", "Điều khiển cảm ứng tự bật khi chạm vào màn hình, hoặc có thể bật tắt trong Cài đặt › Điều khiển › Điều khiển cảm ứng. Một cần lái hiện ra dưới ngón cái bên trái; kéo ở bất kỳ chỗ nào khác để nhìn quanh. Nút lớn SÚNG bắn khi được giữ và có thanh ga chạy quanh viền: trượt dọc theo vòng cung để đặt tốc độ. Trong Cài đặt › Điều khiển › Điều khiển cảm ứng › Ga, có thể dùng thanh trượt dọc riêng phía trên nút thay thế. MÓC phóng lao móc, TĂNG TỐC kích hoạt tăng tốc, và nút CẬP BẾN nhấp nháy khi có thể cập bến. Chạm hai lần vào SÚNG hoặc MÓC để tự động bắn, chạm lần nữa để dừng.", false],
		[1, "", "THỜI GIAN, LỘ TRÌNH (lái tự động), BẢN ĐỒ và TẠM DỪNG nằm ở các cạnh màn hình; camera và toàn màn hình nằm trong menu tạm dừng. Mọi nút đều có thể di chuyển và đổi kích thước bằng Chỉnh vị trí nút điều khiển, và cũng có thể lái tàu bằng cách nghiêng thiết bị.", false],
		[1, "Màn hình tại trạm", "Cập bến sẽ tự động lưu trò chơi và mở màn hình chính của trạm, cho biết trạm thuộc về người định cư hay quân nổi dậy, cấp công nghệ của trạm và số tín dụng của phi công. Phím mũi tên hoặc D-pad di chuyển giữa các nút, Enter hoặc A mở nút đang chọn, còn Esc hoặc B quay lại. KHỞI HÀNH đưa tàu trở ra biển.", false],
		[1, "", "Xưởng tàu: cửa hàng trang bị (mua và lắp, hoặc bán thứ đang lắp), đại lý tàu với mô hình xoay được của từng thân tàu và giá đổi lại cho tàu hiện tại, và phần tổng quan về tàu cùng hàng hóa trên tàu. Xem [[guide/fitting]].", true],
		[1, "", "Nhiệm vụ: các mục tiêu hiện tại và nhật ký, cùng bảng việc với các hợp đồng khi bảng này mở ra. Mỗi hợp đồng cần một khoản tiền cọc, sẽ mất nếu bỏ dở hợp đồng. Xem [[guide/contracts]].", true],
		[1, "", "Bản đồ: hải đồ các trạm, có tìm kiếm, góc nhìn cạnh theo độ sâu và các nút để đặt lái tự động hoặc lên kế hoạch chuyển qua S.T.R.E.A.M. Xem [[guide/navigation]].", true],
		[1, "", "Giao dịch: mua và bán hàng hóa ở thẻ Hàng hóa và chế tạo chúng ở thẻ Xưởng chế tạo (LB / RB để chuyển); chỉ trạm của quân nổi dậy mới buôn bán. Hàng hóa trong khoang đứng đầu danh sách. Xem [[guide/trading]].", true],
		[1, "", "Trạng thái: con tàu, thống kê của phi công và các huân chương. Xem [[guide/medals]].", true],
		[1, "", "Hệ thống: ba ô lưu, cài đặt, trợ giúp, tài liệu tra cứu này, chuyển bản lưu, tải lại điểm lưu tại trạm và menu chính.", true],
	],
	"guide/medals": [
		[1, "Giành huân chương", "Huân chương ghi nhận thành tích của phi công. Phần lớn có ba hạng đồng, bạc và vàng; số còn lại là phần thưởng một lần. Tiến độ được kiểm tra mỗi khi tàu cập bến, và huân chương mới được công bố tại trạm. Huân chương đã giành được thì không bao giờ mất, và hạng cao hơn thay thế hạng thấp hơn. Hồ sơ của bạn trong mục Trạng thái hiển thị các huân chương đã giành được.", false],
		[1, "Huân chương sự nghiệp", "Những huân chương này tính trên toàn bộ sự nghiệp (đồng, bạc, vàng):", false],
		[1, "", "[[medal/4]]: số kẻ địch bị tiêu diệt, 50, 200 và 400.", true],
		[1, "", "[[medal/5]]: số sinh vật bắt được, 50, 150 và 300.", true],
		[1, "", "[[medal/6]]: số trạm đã cập bến, 50, 100 và 200.", true],
		[1, "", "[[medal/8]]: số hàng hóa đã làm, 50, 250 và 500.", true],
		[1, "", "[[medal/12]]: số hợp đồng hoàn thành, 10, 25 và 50.", true],
		[1, "", "[[medal/13]]: số lần đến khu vực trạm mới, 50, 150 và 300.", true],
		[1, "", "[[medal/14]]: số cướp biển bị tiêu diệt, 25, 150 và 350.", true],
		[1, "", "[[medal/18]]: số xác tàu trục vớt, 25, 150 và 350.", true],
		[1, "", "[[medal/19]]: số tín dụng nắm giữ cùng một lúc, 125.000, 500.000 và 1.000.000.", true],
		[1, "", "[[medal/20]]: số món trang bị mới đã mua, 5, 10 và 20.", true],
		[1, "", "[[medal/11]]: số giờ chơi, 5, 7 và 10.", true],
		[1, "", "[[medal/21]]: điểm cao nhất đã đạt, 15.000, 12.000 và 10.000 m.", true],
		[1, "Huân chương một chuyến", "Những huân chương này đánh giá một chuyến đi duy nhất, từ khi rời một trạm đến khi cập bến trạm kế tiếp:", false],
		[1, "", "[[medal/9]]: số lần hạ địch trong một chuyến, 5, 10 và 15.", true],
		[1, "", "[[medal/10]]: số con mồi trong một chuyến, 5, 10 và 15.", true],
		[1, "", "[[medal/1]]: cập bến khi thân tàu dưới 30%, 15% và 5%.", true],
		[1, "", "[[medal/16]]: số vũ khí đã lắp khi cập bến, 3, 5 và 8.", true],
		[1, "", "[[medal/15]]: cập bến khi không lắp súng nào. Các chương mở đầu không được tính.", true],
		[1, "Phần thưởng", "[[medal/0]] được trao khi đến thuộc địa.", true],
		[1, "", "[[medal/3]] và [[medal/2]]: bắt mỗi loài cá và mỗi loài tảo ít nhất một lần.", true],
		[1, "", "[[medal/7]]: làm mỗi sản phẩm ít nhất một lần.", true],
		[1, "", "[[medal/17]]: hoàn thành cốt truyện.", true],
		[1, "", "Còn hai huân chương nữa. Một huân chương thưởng cho việc lặn sâu hơn 30.000, 32.000 và 35.000 m. Huân chương còn lại được trao khi đã có mọi huân chương khác, và bộ sưu tập đầy đủ đó cũng giảm giá [[ship/10]] xuống 50.000 tín dụng. Xem [[guide/depth]] và [[guide/fitting]].", false],
	],
	"guide/navigation": [
		[1, "Hải đồ", "Hai trăm trạm nằm trên một hải đồ hình vuông. [[chart]] trong phần tra cứu này hiển thị mỗi trạm theo màu của phe sở hữu. Trong trò chơi, dịch vụ Bản đồ của trạm và bản đồ khi ở ngoài biển hiển thị cùng một hải đồ, kèm lộ trình gần đây của bạn, các điểm đến nhiệm vụ và các trạm trong tầm S.T.R.E.A.M. Mỗi trang trạm liệt kê các trạm lân cận gần nhất cùng khoảng cách trên hải đồ và độ sâu.", false],
		[1, "Lái tự động", "Lái tự động điều khiển tàu thay bạn. Danh sách của nó gồm mục tiêu hiện tại, cập bến tại trạm tại chỗ, cổng S.T.R.E.A.M. tại chỗ hoặc bất kỳ trạm nào được chọn trên hải đồ. Trên quãng đường dài, nó đi xuyên vùng nước mở, lái vòng qua các trạm cản đường và đi từ khu vực của trạm này sang khu vực của trạm kế tiếp.", false],
		[1, "", "Bất kỳ thao tác lái, ga, tăng tốc hay vũ khí nào cũng trả lại quyền điều khiển thủ công, cũng như mục Tắt lái tự động trong danh sách. Bật tự động bắn cũng kết thúc lái tự động.", false],
		[1, "", "Tăng tốc thời gian chạy ở 1× hoặc 2× khi lái tay và tới 16× khi lái tự động. Khi có nguy hiểm, nó giảm về 2×: tàu thù địch trong khoảng 550 m, con mồi đang mắc lao móc, hoặc rời khỏi dải độ sâu an toàn. Nó cũng trở về 1× khi vào khu vực của một trạm mới.", false],
		[1, "Cổng S.T.R.E.A.M.", "Mỗi trạm có một cổng S.T.R.E.A.M. cách trạm một quãng. Hãy lái vào khu vực kích hoạt của cổng và dùng Cập bến để mở hải đồ cổng, liệt kê mọi trạm trong tầm. Chọn một trạm và bắt đầu chuyển tiếp. Cổng mở ra và tàu xuất hiện tại cổng của trạm đích, với mức hư hại giữ nguyên.", false],
		[1, "", "Một cổng vươn tới khoảng một phần sáu bề rộng hải đồ tính từ trạm hiện tại. Động cơ mở rộng tầm này theo chỉ số của nó: động cơ +30% vươn xa thêm 30%. Những trạm ngoài tầm cần nhảy nhiều chặng, hoặc một chuyến đi dài bằng lái tự động.", false],
		[1, "", "Khi một cuộc giao tranh nhiệm vụ trong khu vực chưa kết thúc, không thể dùng cả cổng lẫn bến của trạm.", false],
		[1, "Đến nơi", "Khi vào khu vực của một trạm, mọi cuộc giao tranh nhiệm vụ đang chờ ở đó sẽ bắt đầu. Tùy chọn mục tiêu của lái tự động dẫn đến các điểm đánh dấu của cuộc giao tranh, và cập bến được mở khóa khi nó được giải quyết. Xem [[guide/contracts]].", false],
		[1, "", "Nếu không, vùng nước quanh trạm có động vật hoang dã địa phương và tàu tuần tra. Từ [[chapter/12|chương 12]] trở đi, có thể có vài tên cướp biển phục sẵn, càng về sau cốt truyện càng thường xuyên. Xem [[guide/combat]].", false],
		[1, "", "Mỗi lần đến khu vực của một trạm mới được tính vào [[medal/13]], và mỗi trạm cập bến lần đầu được tính vào [[medal/6]].", false],
	],
	"guide/tips": [
		[1, "", "Những lời khuyên ngắn về di chuyển, chiến đấu và kiếm tiền, tập hợp cho tài liệu tra cứu này.", false],
		[1, "Trên hành trình", "Giữ phím lái tự động (R) sẽ đưa tàu thẳng tới mục tiêu hiện tại; nhấn nhanh sẽ đưa ra các điểm đến khác, chẳng hạn cổng S.T.R.E.A.M. gần nhất hoặc một trạm được chọn trên hải đồ.", true],
		[1, "", "Khi lái tự động đang điều khiển, thời gian có thể tăng tốc nhiều hơn hẳn so với khi lái tay, miễn là không có kẻ địch ở gần.", true],
		[1, "", "Bất kỳ thao tác lái, ga hay vũ khí nào cũng lấy lại quyền điều khiển từ lái tự động.", true],
		[1, "", "Tăng tốc chỉ hoạt động khi đã lắp bộ tăng tốc, và cần thời gian nạp lại sau mỗi lần dùng.", true],
		[1, "", "Hải đồ đánh dấu các trạm nằm ngoài giới hạn độ sâu của thân tàu; thân tàu hoặc khiên mạnh hơn sẽ mở đường tới đó. Xem [[guide/depth]].", true],
		[1, "", "Nhìn tự do (Alt hoặc Ctrl kết hợp chuột, hoặc giữ nhấn cần phải) cho phép xem phía sau tàu mà không đổi hướng đi.", true],
		[1, "Chiến đấu và đánh bắt", "Súng và lao móc dùng hai nút riêng, nên có thể móc một con cá ngay giữa trận đánh.", true],
		[1, "", "Tự động bắn giữ cho các vũ khí đang chọn tiếp tục bắn trong khi cả hai tay lo lái; chế độ này dừng khi mở một menu.", true],
		[1, "", "Dừng hình trong menu tạm dừng sẽ đóng băng cảnh để camera có thể di chuyển tự do xung quanh.", true],
		[1, "Buôn bán và tiền bạc", "Chỉ trạm của quân nổi dậy mới có chợ hoặc xưởng chế tạo; trạm của người định cư vẫn bán trang bị.", true],
		[1, "", "Xưởng chế tạo biến hàng hóa thành sản phẩm; hãy so khoảng giá của công thức với giá chợ trước khi làm đầy cả khoang.", true],
		[1, "", "Tàu mới rẻ hơn vẻ ngoài: tàu hiện tại được tính đổi lại một phần giá.", true],
		[1, "", "Tiền cọc của hợp đồng sẽ mất nếu bỏ dở hợp đồng, vì vậy hãy kiểm tra độ sâu và khoảng cách trước.", true],
		[1, "Lưu trò chơi", "Cập bến sẽ tự động lưu, và màn hình Hệ thống có thêm ba ô lưu. F5 lưu khi đang cập bến.", true],
		[1, "", "Tải lại điểm lưu tại trạm đưa bạn về lần cập bến gần nhất nếu chuyến lặn không suôn sẻ.", true],
		[1, "", "Đèn pha cần bật thiết lập Chiếu sáng nâng cao; khi đã bật, L dùng để bật và tắt đèn.", true],
	],
	"guide/trading": [
		[1, "Nơi diễn ra buôn bán", "Chỉ các trạm của [[faction/rebels|quân nổi dậy]] mới có chợ và xưởng chế tạo. Trạm của [[faction/colonists|người định cư]] mua toàn bộ khoang hàng ngay khi đến, mỗi món theo giá sàn, và không bán gì cả. Khi cốt truyện bắt đầu, mọi trạm đều thuộc người định cư, nên đánh cá theo giá cố định là nguồn thu nhập duy nhất cho đến khi chợ mở. Xem [[guide/allegiance]].", false],
		[1, "Giá cả", "Mỗi mặt hàng có một khoảng giá, một trạm gốc và một chợ tốt nhất, tất cả đều hiển thị trên trang của nó. Tại trạm gốc, mặt hàng được bán theo giá sàn. Trạm càng nằm xa trạm gốc trên hải đồ, giá càng cao, cho đến giá trần ở khoảng cách của chợ tốt nhất và xa hơn nữa.", false],
		[1, "", "Ba mặt hàng nhập khẩu hoạt động theo chiều ngược lại: [[goods/33]], [[goods/34]] và [[goods/35]] rẻ nhất tại chợ tốt nhất của chúng và càng đắt khi bạn đi càng xa. Chợ của quân nổi dậy bổ sung lại chúng giữa các lần ghé.", false],
		[1, "", "Chợ mua và bán cùng một giá, mỗi lần một đơn vị. Lợi nhuận đến từ việc chở hàng giữa các trạm, không phải từ quầy hàng.", false],
		[1, "Chợ bán những gì", "Mỗi chợ bày bán tối đa bốn sản phẩm. Mỗi sản phẩm phải nằm trong cấp công nghệ của trạm, và sản phẩm xuất hiện dễ hơn ở gần trạm gốc của nó. Hàng trên kệ vơi đi đôi chút giữa các lần ghé. Ba trạm được ghé gần đây nhất giữ nguyên hàng; ở những nơi khác, kệ hàng được bày lại từ đầu khi bạn quay lại.", false],
		[1, "Sản xuất", "Thẻ Xưởng chế tạo của màn hình giao dịch biến nguyên liệu trong khoang thành sản phẩm. Một trạm có thể làm bất kỳ sản phẩm nào đến cấp công nghệ của nó. Danh sách công thức đưa những gì khoang hàng có thể làm lên trước và cho biết làm được bao nhiêu; mỗi trang sản phẩm liệt kê nguyên liệu của nó. Ví dụ, một [[goods/21]] cần một [[species/4]] và một [[species/17]].", false],
		[1, "", "Việc sản xuất hàng hóa được tính vào [[medal/8]], và làm mỗi sản phẩm ít nhất một lần sẽ được [[medal/7]].", false],
		[1, "Kiếm lời", "Một số cách kiếm tiền:", false],
		[1, "", "Mua sản phẩm tại hoặc gần trạm gốc của nó và chở về phía chợ tốt nhất.", true],
		[1, "", "Cá và tảo chỉ tốn thời gian. Chế biến chúng thành sản phẩm có thể lời hơn bán thô.", true],
		[1, "", "Đừng cập bến trạm của người định cư khi khoang đang chứa hàng giá trị: mọi thứ trên tàu sẽ bị lấy theo giá sàn.", true],
		[1, "", "Trục vớt hàng hóa do tàu bị phá hủy để lại và đem bán.", true],
		[1, "", "Hợp đồng [[contract/13]] và [[contract/14]] trả tiền cho việc giao một sản phẩm hoặc con mồi đến trạm đã đăng hợp đồng.", true],
		[1, "", "Cấp công nghệ của trạm cũng làm giảm giá trang bị và tàu; xem [[guide/fitting]].", false],
	],
	"home": [
		[1, "", "Chào mừng đến với phần tra cứu của DEEP, cuộc phiêu lưu tàu ngầm trên một thế giới đại dương bị thuộc địa hóa. Tại đây bạn có thể tra cứu hai trăm trạm dưới biển sâu, các tàu và trang bị có thể mua, các sinh vật dưới nước, hàng hóa buôn bán giữa các chợ, các hợp đồng được giao và các huân chương có thể giành được.", false],
		[1, "", "Các trang cốt truyện mở ra khi bạn chơi. Chương, nhân vật và các sự kiện về sau được ẩn cho đến khi bản lưu của bạn đạt tới, nên bạn có thể xem mà không sợ bị tiết lộ nội dung. Tên và số liệu lấy từ bản trò chơi của chính bạn; phần tổng quan và hướng dẫn được viết riêng cho phần tra cứu này.", false],
		[1, "", "Phi công mới nên bắt đầu với [[world/ocean]] và [[guide/basics]]. [[chart]] hiển thị mọi trạm và phe nắm giữ chúng. Mỗi hướng dẫn giải thích một khía cạnh của cuộc sống dưới mặt nước, từ [[guide/depth]] và [[guide/navigation]] đến [[guide/trading]] và [[guide/combat]].", false],
	],
	"intro/characters": [
		[1, "", "Các trang này mô tả những con người trong câu chuyện: phi công, máy tính trên tàu, các đồng minh và kẻ thù gặp trên đường đi, cùng những giọng nói vang lên qua radio. Mỗi tiểu sử đi theo trình tự của chiến dịch và mở rộng dần khi bạn chơi, chỉ hiển thị những gì phi công của bạn đã biết.", false],
		[1, "", "Một số người nói không có tên riêng. Những tên vai trò như [[character/6]], [[character/7]] và [[character/10]] đại diện cho nhiều giọng nói phụ của từng phe, và trang của họ giải thích ai lên tiếng dưới các tên đó. Để xem toàn bộ câu chuyện, hãy đọc [[world/history]].", false],
	],
	"intro/contracts": [
		[1, "", "Mười lăm loại công việc mà một trạm có thể giao. Mỗi trang nêu mục tiêu, phe nào đăng, các hạn chế nếu có, và các chương cốt truyện dựa trên cùng loại nhiệm vụ. Xem [[guide/contracts]] để biết về tiền cọc, thù lao và độ khó tăng theo cấp của bạn như thế nào. Hợp đồng xuất hiện trên bảng hợp đồng từ [[chapter/9|chương 9]].", false],
	],
	"intro/equipment": [
		[1, "", "Mọi trang bị có thể lắp lên tàu: vũ khí, ngư lôi, lao móc, khiên, giáp, mô-đun hàng hóa, động cơ, bộ lái, radar, bộ tăng tốc và hệ thống sửa chữa. Mỗi trang cho biết các chỉ số của món đồ, độ hiếm trong cửa hàng, có lắp được nhiều chiếc hay không, và giá ở mọi cấp công nghệ. Xem [[guide/fitting]] và [[guide/combat]].", false],
	],
	"intro/factions": [
		[1, "", "Các thế lực của đại dương: [[faction/colonists]], [[faction/rebels]] và [[faction/pirates]]. Mỗi trang giải thích phe đó ảnh hưởng thế nào đến lối chơi, như buôn bán, hợp đồng và tiền thưởng, đồng thời liệt kê các trạm của phe và những lần xuất hiện trong cốt truyện tính đến chương hiện tại của bạn. Xem [[guide/allegiance]] để biết các trạm đổi phe như thế nào.", false],
	],
	"intro/goods": [
		[1, "", "Mọi thứ có thể chở trong khoang: con mồi, sản phẩm, hàng nhập khẩu và hàng trục vớt. Mỗi trang hiển thị cấp công nghệ, trạm gốc, chợ tốt nhất và khoảng giá của mặt hàng, công thức của nó hoặc nó được dùng để làm gì, và mọi quy tắc đặc biệt. Xem [[guide/trading]] để biết giá cả vận hành ra sao và cách kiếm lời.", false],
	],
	"intro/guide": [
		[1, "", "Các hướng dẫn thực hành khi chơi DEEP. Hãy bắt đầu với [[guide/basics]], sau đó đọc về [[guide/depth]], [[guide/navigation]], [[guide/fishing]], [[guide/trading]], [[guide/combat]], [[guide/fitting]], [[guide/contracts]], [[guide/allegiance]] và [[guide/medals]]. Mỗi hướng dẫn giải thích một khía cạnh của cuộc sống dưới mặt nước bằng ngôn ngữ dễ hiểu, với các số liệu chính trò chơi sử dụng, và liên kết đến các trạm, trang bị và huân chương được nhắc đến. Chi tiết cốt truyện được ẩn cho đến khi bản lưu của bạn đạt tới.", false],
	],
	"intro/medals": [
		[1, "", "Các huân chương phi công có thể giành được. Mỗi trang mô tả huân chương đó thưởng cho điều gì và, với huân chương có hạng, cần đạt gì để được đồng, bạc và vàng. Xem [[guide/medals]] để biết huân chương được kiểm tra khi nào và huân chương nào đánh giá một chuyến đi duy nhất. Huân chương được kiểm tra mỗi khi bạn cập bến, và một bộ đầy đủ có phần thưởng riêng.", false],
	],
	"intro/ships": [
		[1, "", "Mọi thân tàu ngầm trong trò chơi, từ [[ship/0]] khởi đầu đến [[ship/10]]. Mỗi trang liệt kê độ bền thân tàu, sức chứa hàng, ô trang bị, khả năng lái và giá niêm yết, thời điểm xưởng đóng tàu bắt đầu bán, cùng bảng so sánh mọi thân tàu. Xem [[guide/fitting]] để biết cách mua tàu và đổi tàu cũ.", false],
	],
	"intro/species": [
		[1, "", "Các sinh vật và tảo của đại dương. Mỗi trang cho biết khối lượng, độ bền, thời gian vùng vẫy khi mắc lao móc, khoảng giá và các trạm nơi loài đó sinh sống, cùng các sản phẩm và hợp đồng sử dụng nó. Xem [[guide/fishing]] để biết cách bắt chúng.", false],
	],
	"intro/stations": [
		[1, "", "Hai trăm trạm của đại dương, theo thứ tự bảng chữ cái. Mỗi trang cho biết cấp công nghệ, độ sâu và vị trí trên hải đồ của trạm, phe nắm giữ, trang bị độ sâu cần để đến được, các loài sống gần đó, những mặt hàng có trạm gốc hoặc chợ tốt nhất tại đây, vai trò của trạm trong cốt truyện và các trạm lân cận gần nhất. [[chart]] hiển thị tất cả cùng lúc.", false],
	],
	"intro/story": [
		[1, "", "Câu chuyện của chiến dịch trải dài qua 48 chương, từ mẻ cá đầu tiên của phi công trở đi. Để đọc toàn bộ cốt truyện liền mạch, chia theo từng hồi, hãy xem [[world/history]]. Trang này mở rộng dần khi bạn chơi và không bao giờ vượt quá chương mà bản lưu của bạn đã đến.", false],
		[1, "", "Mỗi chương cũng có trang riêng, với phần tóm tắt nhiệm vụ và, khi bạn đã đi tiếp, kết quả của nó. Phần kết của một chương chỉ hiện ra khi bạn đến chương tiếp theo, nên các trang này không bao giờ tiết lộ nhiều hơn những gì bạn đã chơi.", false],
	],
	"intro/world": [
		[1, "", "Thông tin nền về thế giới của DEEP. [[world/ocean]] mô tả chính bối cảnh: độ sâu và áp suất, ánh sáng và động vật hoang dã. [[world/colony]] giải thích cách các trạm được điều hành, thương mại và hợp đồng vận hành ra sao và ai giữ gìn trật tự. [[world/stream]] trình bày mạng lưới cổng kết nối các trạm, còn [[world/history]] kể câu chuyện đến chừng nào bạn đã chơi.", false],
		[1, "", "Các trang này mở rộng dần khi bản lưu của bạn tiến triển. Những sự kiện về sau, nhân vật mới và bí mật của đáy sâu chỉ xuất hiện khi bạn đã đến đó, và những bài viết mới sẽ mở ra khi câu chuyện hé lộ các chủ đề mà chúng đề cập.", false],
	],
	"medal/0": [
		[1, "", "Mọi phi công đều nhận huân chương này khi đặt chân đến hành tinh. Nó không đòi hỏi chút nỗ lực nào và chỉ đánh dấu khởi đầu sự nghiệp.", false],
	],
	"medal/1": [
		[1, "", "Trao cho việc cập bến khi thân tàu chỉ còn rất ít. Hạng đồng cần thân tàu dưới 30%, bạc dưới 15% và vàng dưới 5%. Thân tàu được tính tại thời điểm cập bến.", false],
	],
	"medal/10": [
		[1, "", "Trao cho việc bắt được nhiều con mồi trong một chuyến ra khơi, từ khi rời bến đến khi cập bến. Hạng đồng cần hơn 5, bạc hơn 10 và vàng hơn 15. Khoang hàng lớn sẽ có ích.", false],
	],
	"medal/11": [
		[1, "", "Ghi nhận tổng thời gian chơi trong sự nghiệp hiện tại. Hạng đồng đạt được sau hơn năm giờ, bạc sau bảy giờ và vàng sau mười giờ.", false],
	],
	"medal/12": [
		[1, "", "Tính các hợp đồng từ bảng hợp đồng của trạm mà phi công đã hoàn thành. Hạng đồng cần hơn 10, bạc hơn 25 và vàng hơn 50.", false],
	],
	"medal/13": [
		[1, "", "Tính các chuyến đi qua mạng lưới S.T.R.E.A.M. giữa các trạm. Hạng đồng cần hơn 50, bạc hơn 150 và vàng hơn 300.", false],
	],
	"medal/14": [
		[1, "", "Tính số cướp biển bị tiêu diệt trong suốt sự nghiệp. Hạng đồng cần hơn 25, bạc hơn 150 và vàng hơn 350.", false],
	],
	"medal/15": [
		[1, "", "Trao cho việc hoàn thành một chuyến ra khơi mà không lắp súng hay ngư lôi. Lao móc không được tính là vũ khí. Các chương hướng dẫn không được tính.", false],
	],
	"medal/16": [
		[1, "", "Trao cho việc cập bến khi lắp nhiều súng và ngư lôi cùng lúc. Hạng đồng cần ít nhất 3, bạc ít nhất 5 và vàng ít nhất 8, đòi hỏi một thân tàu có nhiều ô.", false],
	],
	"medal/17": [
		[1, "", "Trao cho việc hoàn thành cốt truyện chính. Không thể giành nó bằng cách nào khác, nên nó thường là một trong những huân chương cuối cùng phi công giành được.", false],
	],
	"medal/18": [
		[1, "", "Tính các thùng hàng thu hồi bằng lao móc từ tàu bị phá hủy. Hạng đồng cần hơn 25, bạc hơn 150 và vàng hơn 350.", false],
	],
	"medal/19": [
		[1, "", "Ghi nhận số dư tín dụng lớn nhất từng đạt. Hạng đồng cần hơn 125.000, bạc hơn 500.000 và vàng hơn 1.000.000.", false],
	],
	"medal/2": [
		[1, "", "Trao cho việc bắt được ít nhất một cá thể của mỗi loài trong năm loài tảo. Tảo đứng yên dưới đáy biển, nên đây là một trong những phần thưởng dễ đạt hơn.", false],
	],
	"medal/20": [
		[1, "", "Tính các món trang bị mới mua ở cửa hàng. Hạng đồng cần hơn 5, bạc hơn 10 và vàng hơn 20.", false],
	],
	"medal/21": [
		[1, "", "Ghi nhận độ sâu nông nhất từng đạt. Hạng đồng cần lên cao hơn 15.000 m, bạc cao hơn 12.000 m và vàng cao hơn 10.000 m. Hai hạng cao hơn vượt quá giới hạn định mức của mọi loại khiên.", false],
	],
	"medal/22": [
		[1, "", "Ghi nhận lần lặn sâu nhất. Hạng đồng cần 30.000 m, bạc 32.000 m và vàng 35.000 m. Hai hạng cao hơn vượt quá giới hạn định mức của mọi loại giáp.", false],
	],
	"medal/23": [
		[1, "", "Trao khi đã giành được mọi huân chương khác, ở bất kỳ hạng nào. Có huân chương này, phi công được mua [[ship/10]] với giá chỉ bằng một phần nhỏ giá niêm yết.", false],
	],
	"medal/3": [
		[1, "", "Trao cho việc bắt được ít nhất một cá thể của mỗi loài sinh vật biết bơi. Vùng nước của mỗi trạm có tổ hợp loài khác nhau, nên điều này đòi hỏi đánh bắt ở nhiều nơi.", false],
	],
	"medal/4": [
		[1, "", "Tính tổng số kẻ địch bị tiêu diệt trong suốt sự nghiệp. Hạng đồng cần hơn 50, bạc hơn 200 và vàng hơn 400.", false],
	],
	"medal/5": [
		[1, "", "Tính mọi sinh vật hoặc tảo bắt được bằng lao móc trong suốt sự nghiệp. Hạng đồng cần hơn 50 con mồi, bạc hơn 150 và vàng hơn 300.", false],
	],
	"medal/6": [
		[1, "", "Trao cho việc cập bến tại nhiều trạm khác nhau. Hạng đồng cần hơn 50, bạc hơn 100 và vàng hơn 200, tức là gần như mọi trạm trên hải đồ.", false],
	],
	"medal/7": [
		[1, "", "Trao khi phi công đã sản xuất mọi sản phẩm ít nhất một lần. Một số công thức cần hàng nhập khẩu hoặc sản phẩm khác, nên hoàn thành trọn bộ đòi hỏi lên kế hoạch.", false],
	],
	"medal/8": [
		[1, "", "Tính mọi hàng hóa được sản xuất trong nhà máy của trạm. Hạng đồng cần hơn 50 đơn vị, bạc hơn 250 và vàng hơn 500.", false],
	],
	"medal/9": [
		[1, "", "Trao cho việc tiêu diệt nhiều kẻ địch trong một chuyến ra khơi, từ khi rời một trạm đến khi cập bến trạm kế tiếp. Hạng đồng cần hơn 5, bạc hơn 10 và vàng hơn 15.", false],
	],
	"ship/0": [
		[1, "Tổng quan", "[[ship/0]] là thân tàu mà mọi phi công đều bắt đầu, và rẻ nhất trong danh sách với giá 45.000 cr. Nó cũng yếu nhất ở hầu hết mọi mặt: 75 điểm thân tàu, khoang 25 t và sáu ô trang bị. Chỉ số lái 1,10 ở mức trung bình, ngang với [[ship/8]] lớn hơn nhiều.", false],
		[1, "", "Tàu được lắp sẵn [[equipment/15]], [[equipment/18]], [[equipment/22]] và [[equipment/35]]. Như vậy trong sáu ô chỉ còn hai ô trống cho vũ khí hoặc mô-đun hàng hóa.", false],
		[1, "Khi sử dụng", "Khoang hàng nhỏ mới là giới hạn thực sự. Vài con mồi cỡ vừa đã lấp đầy nó, và một con [[species/12]] trung bình nặng hơn sức chở của tàu. Chỉ thêm 30.000 cr, [[ship/1]] có thêm 40 điểm thân tàu, sức chứa gần gấp đôi và khả năng lái nhạy hơn nhiều với cùng số ô, nên phần lớn phi công thay chiếc tàu khởi đầu ngay khi đủ tiền. Trước đó, nó là thân tàu tập luyện: đủ tốt cho những chuyến đánh cá đầu tiên và những trận đánh cướp biển nhẹ gần nhà, nhưng không hợp cho những chuyến buôn bán xa hay chiến đấu nặng.", false],
	],
	"ship/1": [
		[1, "Tổng quan", "[[ship/1]] là một tàu đánh cá chắc chắn, giá phải chăng. So với [[ship/0]], nó có thêm 40 điểm thân tàu, 20 t hàng và khả năng điều khiển nhanh hơn nhiều: chỉ số lái 1,61 chỉ đứng sau [[ship/5]]. Tuy nhiên nó vẫn giữ sáu ô, và giới hạn đó định hình thân tàu này. Một lao móc, khiên, giáp và radar chỉ còn chỗ cho hai khẩu súng hoặc mô-đun hàng hóa.", false],
		[1, "Khi sử dụng", "Xưởng đóng tàu thường bán nó từ chương đầu tiên với giá 75.000 cr, nên đây là lựa chọn nâng cấp đầu tiên tự nhiên cho phi công chủ yếu đánh cá và làm việc vặt ngắn. Nó thậm chí vượt cả [[ship/2]] đắt hơn về thân tàu, sức chứa và khả năng lái, chỉ kém một ô. Khi nhiệm vụ đòi hỏi nhiều hỏa lực hơn hoặc khoang lớn hơn, ô thứ bảy và thứ tám của các thân tàu sau quan trọng hơn độ bền thuần túy, và chiếc Okeanos thường được đem đổi.", false],
	],
	"ship/10": [
		[1, "Tổng quan", "[[ship/10]] là soái hạm hạng sang và là thân tàu toàn diện nhất. Nó kết hợp 200 điểm thân tàu, khoang 100 t, mười ô và khả năng lái 1,50. Chỉ [[ship/6]] hơn nó về thân tàu hoặc sức chứa, và chỉ [[ship/5]], [[ship/1]] và [[ship/3]] xoay nhanh hơn. Giá niêm yết 5.000.000 cr gấp hơn mười bốn lần giá của [[ship/9]].", false],
		[1, "Khi sử dụng", "Xưởng đóng tàu thường bán nó từ [[chapter/40]]. Ít phi công trả nổi giá niêm yết. Phi công có đủ mọi huân chương, tức hoàn thành [[medal/23]], có thể mua nó với giá 50.000 cr, trước khi trừ mức giảm thông thường theo cấp công nghệ của trạm. Điều đó khiến chiếc Aquarius là phần thưởng cho việc hoàn thành bộ sưu tập huân chương hơn là một món mua sắm thực tế. Khi nó có mặt, phần lớn chiến dịch đã ở lại phía sau phi công.", false],
	],
	"ship/2": [
		[1, "Tổng quan", "[[ship/2]] là thân tàu rẻ nhất có bảy ô trang bị, với giá 100.000 cr. Chỉ số thân tàu và sức chứa (100 điểm và 40 t) thực ra thấp hơn [[ship/1]], và khả năng lái 1,40 chỉ ở mức khá chứ không nổi bật. Số tiền bỏ thêm mua được ô thứ bảy, có thể lắp thêm một khẩu súng hoặc một mô-đun hàng hóa.", false],
		[1, "Khi sử dụng", "Nó được bán từ chương đầu tiên, nên phi công tiết kiệm sớm có thể lên bảy ô từ rất lâu trước khi có gì tốt hơn xuất hiện. Tuy nhiên từ [[chapter/5]] trở đi, [[ship/3]] có cùng thân tàu và số ô, thêm 6 t hàng và lái tốt hơn chỉ với 5.000 cr nữa. Sau thời điểm đó, chiếc Triops chủ yếu đáng mua khi tình cờ được bán gần đó mà lựa chọn kia thì không. Nó hợp với phi công muốn đánh cướp biển sớm, vì ô dư có thể lắp vũ khí thứ hai.", false],
	],
	"ship/3": [
		[1, "Tổng quan", "[[ship/3]] cải tiến bố cục bảy ô của [[ship/2]]. Chỉ thêm 5.000 cr, nó có thêm 6 t khoang hàng và tăng khả năng lái từ 1,40 lên 1,57, trở thành một trong những thân tàu linh hoạt nhất trò chơi. 100 điểm thân tàu không có gì đặc biệt, nên khiên và giáp đảm nhận phần lớn việc bảo vệ.", false],
		[1, "Khi sử dụng", "Xưởng đóng tàu thường bắt đầu bán nó từ [[chapter/5]]. Nó hợp với phi công muốn vừa chiến đấu vừa đánh cá trên cùng một con tàu mà không phải bỏ ra nhiều tiền, và vẫn là lựa chọn hợp lý cho đến khi thân tàu tám ô xuất hiện. So với [[ship/4]], thân tàu xuất hiện kế tiếp, nó kém 75 điểm thân tàu và 24 t hàng nhưng đổi lại xoay nhanh hơn nhiều và rẻ hơn 25.000 cr.", false],
	],
	"ship/4": [
		[1, "Tổng quan", "[[ship/4]] là một tàu chở hàng hạng nặng thu nhỏ. Nó có 175 điểm thân tàu, khoang 70 t và tám ô với giá 130.000 cr, là thân tàu tám ô rẻ nhất. Cái giá phải trả là khả năng điều khiển: chỉ số lái 0,91 thấp hơn mọi tàu trước đó, và chỉ [[ship/6]] xoay chậm hơn.", false],
		[1, "Khi sử dụng", "Nó xuất hiện ở xưởng đóng tàu thường từ [[chapter/10]]. Thương nhân và người đánh cá được lợi nhiều nhất. Khoang cơ bản lớn cũng giúp mô-đun hàng hóa hiệu quả hơn, vì phần thưởng của chúng tính theo phần trăm sức chứa cơ bản. Một bộ lái bù lại phần nào sự ì ạch. Phi công chủ yếu chiến đấu có thể thích [[ship/5]] hơn, đắt hơn 20.000 cr và xoay nhanh đúng gấp đôi, nhưng độ bền thân tàu chỉ bằng khoảng một nửa.", false],
	],
	"ship/5": [
		[1, "Tổng quan", "[[ship/5]] là tàu không chiến. Chỉ số lái 1,82 là cao nhất trong mọi thân tàu, cho phép nó bám sau đối thủ và giữ mục tiêu trong tầm ngắm. Tuy nhiên khả năng bảo vệ mỏng manh: với 90 điểm, thân tàu còn yếu hơn [[ship/1]], và khoang 40 t chỉ ở mức khiêm tốn. Tám ô để lại nhiều chỗ cho vũ khí.", false],
		[1, "Khi sử dụng", "Xưởng đóng tàu thường bán nó từ [[chapter/15]] với giá 150.000 cr. Nó phát huy hiệu quả với phi công biết né đòn, lý tưởng là có khiên và giáp mạnh hỗ trợ, và là lựa chọn kém cho việc chở hàng. Vì mọi khẩu súng đã lắp đều bắn cùng lúc, ô trống chuyển thẳng thành hỏa lực. Phi công muốn một thân tàu tám ô chắc chắn hơn nên so sánh với [[ship/4]] hoặc chờ [[ship/6]].", false],
	],
	"ship/6": [
		[1, "Tổng quan", "[[ship/6]] là tàu chở hàng rời cỡ lớn. Khoang 180 t vượt xa mọi thân tàu khác, gần gấp đôi [[ship/10]], và 220 điểm thân tàu là cao nhất trò chơi. Với giá 170.000 cr, nó cũng rẻ hơn [[ship/7]] và mọi thân tàu ra sau. Nhược điểm là khả năng điều khiển: với chỉ số lái 0,67, nó xoay chậm hơn mọi tàu khác.", false],
		[1, "Khi sử dụng", "Nó có mặt ở xưởng đóng tàu thường từ [[chapter/20]]. Cho buôn bán và những chuyến đánh cá lớn, nó không có đối thủ. Mô-đun hàng hóa tính theo sức chứa cơ bản, nên chỉ một mô-đun +80% đã thêm 144 t. Trong chiến đấu, nó dựa vào khả năng chịu đòn thay vì né tránh, và một bộ lái gần như không thể thiếu khi đối đầu cướp biển nhanh nhẹn. Chỉ có tám ô, nó cũng ít chỗ cho súng hơn các thân tàu ra sau.", false],
	],
	"ship/7": [
		[1, "Tổng quan", "[[ship/7]] là thân tàu đầu tiên có chín ô. Các chỉ số khác ở mức trung bình: 135 điểm thân tàu, khoang 50 t và khả năng lái 1,23, hơn [[ship/0]] nhưng kém xa [[ship/5]]. Với giá 215.000 cr, nó đắt hơn đáng kể so với [[ship/6]], nên giá tiền chủ yếu trả cho ô dư thêm.", false],
		[1, "Khi sử dụng", "Nó xuất hiện ở xưởng đóng tàu thường từ [[chapter/25]]. Nó hợp với phi công muốn thêm một khẩu súng hoặc mô-đun so với thân tàu tám ô, mà không phải trả tiền cho những tàu mười ô ra sau. Là một tàu đa năng, nó ổn nhưng không nổi bật ở mặt nào. [[ship/8]], ra sau năm chương, có thêm ô thứ mười, thêm 15 điểm thân tàu và 16 t hàng với thêm 85.000 cr.", false],
	],
	"ship/8": [
		[1, "Tổng quan", "[[ship/8]] là thân tàu mười ô đầu tiên. Nó có 150 điểm thân tàu và khoang 66 t, và lái giống [[ship/0]] với chỉ số 1,10. Với giá 300.000 cr, nó đắt hơn [[ship/7]] 85.000 cr để có thêm một ô và một chút cải thiện về thân tàu và sức chứa.", false],
		[1, "Khi sử dụng", "Xưởng đóng tàu thường niêm yết nó từ [[chapter/30]]. Với mười ô, phi công có thể lắp đủ bộ phòng thủ, một lao móc và một radar, mà vẫn gắn được vài khẩu súng hoặc một mô-đun hàng hóa. Khả năng điều khiển chỉ ở mức trung bình, nên một bộ lái sẽ có ích trong cận chiến. [[ship/9]], ra sau năm chương, bớt 6 t khoang để đổi lấy thêm 15 điểm thân tàu và khả năng lái tốt hơn. Chiếc Pontos vẫn rẻ hơn trong hai chiếc và là lựa chọn tốt hơn khi sức chứa quan trọng.", false],
	],
	"ship/9": [
		[1, "Tổng quan", "[[ship/9]] là thân tàu mười ô cao cấp. So với [[ship/8]], nó có thêm 15 điểm thân tàu và khả năng lái nhạy hơn rõ rệt (1,36 so với 1,10), nhưng mất 6 t hàng. Với giá 350.000 cr, nó đắt hơn 50.000 cr.", false],
		[1, "Khi sử dụng", "Xưởng đóng tàu thường bán nó từ [[chapter/35]]. Nó hợp nhất với phi công thiên về chiến đấu ở giai đoạn cuối chiến dịch, người được lợi từ mười ô và khả năng điều khiển tốt hơn là từ khoang hàng. Để buôn bán số lượng lớn, [[ship/6]] chở được gấp ba với nửa giá. Thân tàu duy nhất vượt chiếc Lir ở hầu hết mọi mặt là [[ship/10]], có giá niêm yết ở một đẳng cấp khác.", false],
	],
	"species/0": [
		[1, "Tổng quan", "[[species/0]] được mô phỏng theo ốc anh vũ, loài động vật chân đầu có vỏ ở vùng nhiệt đới Ấn Độ Dương - Thái Bình Dương. Ốc anh vũ sống trong khoang ngoài cùng của chiếc vỏ xoắn và điều chỉnh sức nổi bằng cách thay đổi lượng khí và chất lỏng trong các khoang bên trong. Nó bơi bằng lực đẩy phản lực và bắt mồi bằng hàng chục xúc tu không có giác hút. Ốc anh vũ thường sống ở độ sâu vài trăm mét, và vỏ có thể vỡ sập nếu chúng xuống sâu hơn nhiều so với khoảng 800 m.", false],
		[1, "Trong trò chơi", "Trong trò chơi, nó nặng khoảng 8 t và hầu như không kháng cự khi mắc lao móc: chỉ cần 2,1 s để khuất phục nó. Điều đó khiến nó là một trong những con mồi dễ bắt nhất, nhưng giá 44 đến 156 cr mỗi tấn lại thấp. Nó sống ở vùng nước của 67 trạm.", false],
		[7, "", "Trong [[chapter/7]], phi công phải dọn sạch loài vật này khỏi vùng nước quanh [[station/1]], bằng cách bắt hoặc giết chúng.", false],
	],
	"species/1": [
		[1, "Tổng quan", "[[species/1]] lấy tên từ Eurypharynx pelecanoides, một loài cá biển sâu sống ở độ sâu khoảng 500 đến 3.000 m. Cái miệng khớp lỏng của nó rất lớn so với thân hình mảnh mai như roi, và có thể há rộng đủ để nuốt trọn con mồi lớn hơn nhiều so với tưởng tượng. Đuôi kết thúc bằng một cơ quan phát sáng nhỏ. Con trưởng thành thường dài chưa đến một mét.", false],
		[1, "Trong trò chơi", "Trong trò chơi, nó bơi nhanh và chống lại lao móc khoảng 4 s, lâu gấp đôi một con [[species/0]] cùng khối lượng 8 t. Công sức được đền đáp: với giá 70 đến 255 cr mỗi tấn, nó là một trong những con mồi có giá tốt hơn. Nhà máy dùng nó để làm [[goods/24]] và [[goods/27]], đều là sản phẩm giá trị. Lao móc có khả năng làm chậm mạnh giúp bắt nó dễ hơn nhiều.", false],
	],
	"species/10": [
		[1, "Tổng quan", "[[species/10]] lấy cảm hứng từ mực và bạch tuộc, những loài chân đầu nổi tiếng vì đổi màu chỉ trong tích tắc. Da của chúng chứa hàng nghìn tế bào sắc tố gọi là tế bào mang sắc, mỗi tế bào được các cơ nhỏ xíu mở hoặc đóng, cùng với các tế bào phản quang tạo ánh lấp lánh. Nhiều loài còn có túi mực; mực của cá mực nang từng là nguồn của sắc tố nâu sepia.", false],
		[1, "Trong trò chơi", "Trong trò chơi, nó nặng khoảng 14 t, có độ bền 28 và vùng vẫy trên dây khoảng 3,4 s. Giá thô từ 59 đến 164 cr mỗi tấn. Kết hợp với dung môi, nó cho ra [[goods/22]], thứ cần để làm [[goods/29]].", false],
		[19, "", "Trong [[chapter/19]], phi công phải bảo vệ một đàn loài này gần [[station/7]] khỏi các tàu tấn công.", false],
	],
	"species/11": [
		[1, "Tổng quan", "“Loricate” nghĩa là được bao phủ bằng các tấm giáp bảo vệ, và [[species/11]] gợi nhớ đến rùa biển. Ngày nay có bảy loài. Mai của chúng gồm các tấm xương gắn liền với cột sống và xương sườn. Rùa da là loài lớn nhất, với mai dài tới khoảng 2 m, và có thể lặn sâu hơn 1.000 m để tìm sứa. Con cái quay về bãi biển để đẻ trứng.", false],
		[1, "Trong trò chơi", "Trong trò chơi, nó nặng khoảng 8 t và chịu thua sau khoảng 2,7 s khi mắc lao móc. Giá của nó biến động bất thường, từ 40 đến 244 cr mỗi tấn, nên đáng bán ở nơi có nhu cầu cao. Không có công thức nhà máy nào dùng nó.", false],
	],
	"species/12": [
		[1, "Tổng quan", "[[species/12]] dựa trên cá voi có răng, nhóm bao gồm cá nhà táng, cá heo và cá heo chuột. Chúng tìm con mồi bằng định vị tiếng vang, phát ra những tiếng lách cách và lắng nghe tiếng dội lại. Cá nhà táng là loài săn mồi có răng lớn nhất trên Trái Đất. Nó lặn sâu 1.000 m hoặc hơn để săn mực và có thể ở dưới nước hơn một giờ.", false],
		[1, "Trong trò chơi", "Trong trò chơi, đây là sinh vật nặng nhất, khoảng 30 t, với độ bền 60. Chỉ một con đã có thể lấp đầy một khoang nhỏ, và một cá thể trung bình không vừa khoang 25 t của [[ship/0]]. Nó chỉ vùng vẫy khoảng 2,9 s. Giá dao động rộng, từ 22 đến 200 cr mỗi tấn, và không có công thức nào dùng nó.", false],
	],
	"species/13": [
		[1, "Tổng quan", "[[species/13]] gợi nhớ đến tảo vàng (Chrysophyceae) và các nhóm tảo vàng nâu có họ hàng. Màu của chúng đến từ sắc tố fucoxanthin, che lấp chất diệp lục. Phần lớn có kích thước hiển vi và sống ở nước ngọt, và một số gây hiện tượng nở hoa; một loài, Prymnesium parvum, tiết ra độc tố có thể giết cá.", false],
		[1, "Trong trò chơi", "Trong trò chơi, như mọi loài tảo, nó bám chặt dưới đáy biển, nặng cố định 2 t và bị khuất phục trong 2,1 s. Đây là loài giá trị nhất trong năm loại tảo, bán với giá 27 đến 65 cr mỗi tấn. Nó được dùng để làm [[goods/27]] và [[goods/28]].", false],
	],
	"species/14": [
		[1, "Tổng quan", "[[species/14]] gợi đến tảo lam, hay vi khuẩn lam. Nói chính xác, chúng không phải tảo mà là vi khuẩn quang hợp. Chúng thuộc những dạng sống cổ xưa nhất từng biết và đã góp phần làm bầu khí quyển Trái Đất giàu oxy. Một số loài cố định nitơ từ không khí, và một số có thể giải phóng hydro, vì thế các nhà nghiên cứu xem chúng là nguồn nhiên liệu sạch tiềm năng.", false],
		[1, "Trong trò chơi", "Trong trò chơi, nó mọc dưới đáy biển, nặng 2 t và hầu như không kháng cự. Nó bán với giá 21 đến 47 cr mỗi tấn. Thật hợp lý, nó được kết hợp với [[goods/18]] để làm [[goods/19]], và là một trong năm loại tảo cần cho [[goods/28]].", false],
	],
	"species/15": [
		[1, "Tổng quan", "[[species/15]] đại diện cho tảo nâu (Phaeophyceae), bao gồm cả tảo bẹ. Tảo bẹ khổng lồ có thể cao hàng chục mét và tạo thành những khu rừng dưới nước làm nơi trú ẩn cho nhiều loài khác. Tảo nâu là nguồn alginate thương mại, dùng để làm đặc thực phẩm và trong y học.", false],
		[1, "Trong trò chơi", "Trong trò chơi, đây là con mồi rẻ nhất, từ 14 đến 47 cr mỗi tấn. Như các loài tảo khác, nó nằm yên dưới đáy biển, nặng 2 t và bị khuất phục trong 2,1 s. Công dụng duy nhất của nó là để làm [[goods/28]], thứ cần đủ cả năm loại tảo.", false],
	],
	"species/16": [
		[1, "Tổng quan", "[[species/16]] chỉ tảo đỏ (Rhodophyta). Một sắc tố đỏ, phycoerythrin, cho phép chúng hấp thụ ánh sáng xanh lam vốn xuyên sâu nhất vào biển, nên chúng mọc sâu hơn mọi loại rong biển khác. Tảo đỏ cho ta thạch agar và carrageenan, và rong nori dùng để cuộn sushi cũng là một loại tảo đỏ.", false],
		[1, "Trong trò chơi", "Trong trò chơi, đây là loài tảo giá trị thứ hai, từ 27 đến 62 cr mỗi tấn. Nó đứng yên dưới đáy biển, nặng 2 t và dễ bắt bằng lao móc. Nó được dùng để làm [[goods/27]] cùng với [[species/13]] và cũng cần cho [[goods/28]].", false],
	],
	"species/17": [
		[1, "Tổng quan", "[[species/17]] đại diện cho tảo lục, họ hàng gần nhất của thực vật trên cạn. Rau diếp biển (Ulva) là một ví dụ quen thuộc ở vùng ven biển. Một số loại rong biển xanh được dùng làm thực phẩm; ở Nhật Bản, những mảnh vụn khô gọi là aonori được rắc lên món ăn. Tảo lục cần nhiều ánh sáng, nên phần lớn mọc ở vùng nước nông.", false],
		[1, "Trong trò chơi", "Trong trò chơi, đây là con mồi giá trị thấp, từ 20 đến 44 cr mỗi tấn. Như các loài tảo khác, nó bám dưới đáy, nặng 2 t và bị khuất phục trong 2,1 s. Nhà máy kết hợp nó với [[species/4]] để làm [[goods/21]], và nó là một trong năm loại tảo của [[goods/28]].", false],
	],
	"species/2": [
		[1, "Tổng quan", "[[species/2]] đại diện cho thủy mẫu, giai đoạn bơi tự do của nhiều loài thuộc ngành ruột khoang. Sứa không có não, xương hay máu, và chiếc dù của nó chủ yếu là nước. Nó di chuyển bằng cách co bóp chiếc dù và trôi theo dòng nước, bắt những con mồi nhỏ bằng xúc tu có tế bào châm. Một số loài phát sáng, và nhiều dạng sống ở biển sâu có màu đỏ hoặc tím.", false],
		[1, "Trong trò chơi", "Nặng khoảng 2 t, đây là một trong những sinh vật nhẹ nhất trò chơi, và độ bền 4 nghĩa là chỉ một phát bắn lạc cũng có thể giết nó. Khi mắc lao móc, nó chịu thua sau khoảng 2,5 s. Giá từ 40 đến 133 cr mỗi tấn. Công dụng duy nhất của nó trong sản xuất là một trong ba nguyên liệu của [[goods/26]].", false],
	],
	"species/3": [
		[1, "Tổng quan", "[[species/3]] dựa trên cá đuối manta, loài cá đuối lớn nhất thế giới. Những loài sống ở đại dương lớn hơn có sải vây khoảng 7 m. Cá đuối manta là loài ăn lọc hiền lành: chúng bơi với miệng mở và dùng hai thùy thịt phía trước miệng để lùa sinh vật phù du vào trong. Chúng có bộ não thuộc loại lớn nhất so với kích thước cơ thể trong các loài cá.", false],
		[1, "Trong trò chơi", "Trong trò chơi, nó nặng khoảng 16 t và có độ bền 32, nên chịu được đạn sượt qua tốt hơn những động vật nhỏ hơn. Nó vùng vẫy trên dây khoảng 3,6 s. Giá thô 65 đến 182 cr mỗi tấn ở mức vừa phải, nhưng đây là sinh vật cần để làm [[goods/20]], thứ lại được dùng để làm [[goods/29]].", false],
	],
	"species/4": [
		[1, "Tổng quan", "[[species/4]] đại diện cho những đàn cá dày đặc do các loài cá nhỏ như cá mòi, cá cơm và cá trích tạo thành. Bơi theo đàn khiến kẻ săn mồi bối rối, khó chọn ra một mục tiêu riêng lẻ, và cũng có thể giúp tiết kiệm năng lượng khi cá bơi theo dòng nước của nhau. Những đàn cá này là nền tảng của nhiều chuỗi thức ăn biển và của những ngư trường lớn nhất thế giới.", false],
		[1, "Trong trò chơi", "Trong trò chơi, cả đàn được bắt thành một mẻ 4 t. Đây là con mồi dễ dàng: lao móc khuất phục nó trong khoảng 2,5 s, và độ bền chỉ 8. Giá từ 53 đến 138 cr mỗi tấn. Nó là nguyên liệu của [[goods/21]] và [[goods/26]], nên phi công bắt thêm [[species/17]] hoặc [[species/2]] sẽ có sẵn chuỗi cung ứng.", false],
	],
	"species/5": [
		[1, "Tổng quan", "[[species/5]] chỉ các loài cá vây chân, đặc biệt là các loài biển sâu. Một chiếc gai biến đổi trên đầu tạo thành cần câu với mồi nhử ở đầu. Ở nhiều dạng biển sâu, mồi nhử phát sáng nhờ vi khuẩn cộng sinh, dụ con mồi đến gần cái miệng rộng. Ở một số loài, con đực tí hon dính vĩnh viễn vào con cái lớn hơn nhiều.", false],
		[1, "Trong trò chơi", "Trong trò chơi, nó nặng khoảng 10 t và chịu thua lao móc sau khoảng 2,5 s, nên khá nhanh bắt. Khoảng giá 53 đến 216 cr mỗi tấn khá rộng. Cùng với [[species/1]] và dung môi, nó cần để làm [[goods/24]], đầu vào chủ chốt của nhiều sản phẩm giá trị cao.", false],
	],
	"species/6": [
		[1, "Tổng quan", "“Cá quỷ” là một cái tên cũ của dân đi biển. Qua nhiều thế kỷ, nó từng được dùng cho cá đuối quỷ thuộc chi Mobula, cho bạch tuộc lớn và thậm chí cả cá voi xám. Trò chơi không gắn [[species/6]] với riêng loài nào trong số đó. Điểm chung của chúng là kích thước lớn và tiếng tăm đáng sợ hiếm khi khớp với hành vi thực tế.", false],
		[1, "Trong trò chơi", "Trong trò chơi, đây là con mồi nặng, khoảng 20 t, với độ bền 40. Nó chống lại lao móc khoảng 4,2 s, thuộc loại lâu nhất trong các sinh vật. Nó cũng có giá trần cao nhất trong các sinh vật, lên tới 364 cr mỗi tấn. Nhà máy kết hợp nó với [[species/8]] và muối để làm [[goods/25]].", false],
	],
	"species/7": [
		[1, "Tổng quan", "[[species/7]] dựa trên cá cờ, loài cá mỏ lớn sống ở đại dương mở vùng nước ấm. Cá cờ dùng chiếc mỏ như ngọn giáo để quật vào đàn mồi và là một trong những loài cá nhanh nhất biển cả. Những con cá cờ xanh lớn nhất dài hơn 4 m và nặng vài trăm kilôgam. Cá cờ được giới câu cá thể thao ưa chuộng vì những màn vật lộn dài và nhào lộn.", false],
		[1, "Trong trò chơi", "Trong trò chơi, nó nhẹ, khoảng 8 t, nhưng khó bắt: nó bơi nhanh và chống lại lao móc khoảng 4,2 s. Lao móc có tầm xa và làm chậm mạnh giúp việc này dễ hơn. Đổi lại nó giữ giá tốt, bán từ 104 đến 283 cr mỗi tấn, giá sàn cao nhất trong các sinh vật. Nó là nguyên liệu chính của [[goods/23]].", false],
	],
	"species/8": [
		[1, "Tổng quan", "“Cá mập xương” là tên cũ của cá nhám phơi nắng, loài cá còn sống lớn thứ hai sau cá nhám voi. Cá nhám phơi nắng có thể dài khoảng 8 m hoặc hơn. Dù to lớn, chúng là loài ăn lọc vô hại, bơi chậm gần mặt nước với cái miệng khổng lồ mở rộng để lọc sinh vật phù du. Chúng di cư những quãng đường dài và thường trú đông ở vùng nước sâu hơn.", false],
		[1, "Trong trò chơi", "Trong trò chơi, [[species/8]] nặng khoảng 18 t và có độ bền 36. Nó chống lại lao móc khoảng 3,8 s. Giá từ 78 đến 208 cr mỗi tấn. Đây là một trong những con mồi hữu ích hơn cho sản xuất, vì nó được dùng cho cả [[goods/25]] lẫn [[goods/26]].", false],
	],
	"species/9": [
		[1, "Tổng quan", "Không có loài vật thật nào tên là tôm khổng lồ goliath, nhưng những con tôm khổng lồ thực sự có tồn tại. Tôm sú có thể dài tới khoảng 30 cm, và một số loài giáp xác biển sâu lớn hơn họ hàng ở vùng nước nông, một hiện tượng gọi là chứng khổng lồ biển sâu. Nhiều loài tôm biển sâu có màu đỏ, khiến chúng gần như vô hình trong vùng nước mà ánh sáng đỏ không xuyên tới.", false],
		[1, "Trong trò chơi", "Trong trò chơi, [[species/9]] là con mồi nhỏ 2 t với độ bền 4, bị khuất phục nhanh trong khoảng 2,3 s. Giá từ 39 đến 122 cr mỗi tấn. Không có công thức nhà máy nào dùng nó, nên nó được bắt chỉ để bán. Hợp đồng đánh bắt yêu cầu nó thường xuyên hơn so với những sinh vật hiếm hơn như [[species/0]].", false],
	],
	"world/abel": [
		[31, "", "[[world/abel]] là một nhà khoa học làm việc cùng [[faction/rebels|phong trào kháng chiến]]. Ông không bao giờ xuất hiện trên màn hình, nhưng công trình nghiên cứu của ông là trọng tâm trong kế hoạch của [[character/2]] nhằm chế tạo một vũ khí có thể xoay chuyển cuộc chiến chống lại thuộc địa.", false],
		[31, "Lai lịch", "Vị giáo sư đã dành nhiều năm nghiên cứu [[world/biotek]], một nguồn năng lượng chưa ai chế tạo thành công. Ông đã gần hoàn thành một nguyên mẫu hoạt động được thì người định cư đánh cắp nó, và giờ họ đang tự tìm cách hoàn thiện nó.", false],
		[31, "Vai trò trong câu chuyện", "[[character/2]] đưa ông và nhóm của ông đến [[station/14]] để chế tạo vũ khí mới cho quân nổi dậy. Rõ ràng họ chính là các nhà khoa học có đoàn tàu được phi công bảo vệ trên đường đến đó ([[chapter/29]]). [[character/2]] lập tức rời đi để gặp ông trong khi phi công và những người khác thu hồi máy phát ([[chapter/30]]).", false],
		[33, "", "Sau cuộc chặn đánh, vị giáo sư mang các thùng hàng thu hồi được về phòng thí nghiệm để tiếp tục làm nguyên mẫu ([[chapter/32]]).", false],
		[39, "", "Công việc của ông tiến triển nhanh. Chẳng bao lâu nguyên mẫu đã gần hoàn tất và chỉ còn thiếu một bộ phận: một [[goods/36]] nhân bản DNA của các hạt tảo để khởi động phản ứng dây chuyền tạo ra năng lượng. [[character/2]] truyền đạt lại lời giải thích của ông, đồng thời thừa nhận bà không hiểu hết. Thiết bị này chỉ có thể được làm tại [[station/16]] ([[chapter/38]]).", false],
		[42, "", "Khi lồng ấp đến [[station/14]], ông đã chuẩn bị sẵn mọi thứ để lắp nó, và vũ khí hoàn chỉnh sẽ sớm có trong xưởng tàu. Vì máy phát vẫn chỉ là nguyên mẫu, phi công được nhắc phải cẩn thận với nó ([[chapter/41]]).", false],
		[44, "", "Khẩu [[world/eclipse|Eclipse]] chạy bằng máy phát của ông đóng vai trò quyết định khi người định cư tấn công [[station/14]].", false],
		[31, "Tính cách", "Mọi điều biết về ông đều đến từ [[character/2]] và [[character/5]]. Ông được mô tả là một nhà nghiên cứu tận tụy.", false],
		[39, "", "Những lời giải thích của ông mang tính kỹ thuật đến mức ngay cả [[character/2]] cũng khó nhắc lại.", false],
	],
	"world/aquarians": [
		[10, "", "Người Aquarian là những sinh vật của đại dương sâu thẳm, được cho là nửa người nửa cá. Aquarian là cái tên người định cư đặt cho họ, và thuộc địa coi họ là loài gây hại. Họ được biết đến chủ yếu qua việc tấn công các khoang vận chuyển đưa hàng xuất khẩu của thuộc địa lên quỹ đạo. Họ là ai và họ muốn gì là một trong những câu hỏi mà câu chuyện dần dần trả lời.", false],
		[10, "Bản chất", "Ban đầu người ta biết rất ít về người Aquarian. Họ sống ngoài vùng nước mở và di chuyển như động vật biển chứ không như máy móc, nhưng lại chiến đấu bằng vũ khí của riêng mình. Người định cư coi họ là những con vật nguy hiểm và không bao giờ hỏi vì sao họ tấn công.", false],
		[11, "", "Sau trận đánh đầu tiên của phi công với họ, [[character/1]] tự hỏi liệu họ có thông minh hơn nhiều so với mọi người vẫn nghĩ hay không. Phi công cũng bắt đầu thắc mắc vì sao họ lại nhắm vào các khoang.", false],
		[19, "", "Những lần chạm trán sau đó cho thấy họ chăm lo cho động vật hoang dã của đại dương. Họ được thấy bơi cùng một đàn [[species/10|mực đổi màu]] mà người định cư đang tìm cách bắt, như thể đang bảo vệ chúng.", false],
		[45, "", "Họ thông minh và có khả năng ngoại giao. Một sứ giả người Aquarian đến [[station/14]] và dường như hiểu được phần nào tiếng nói của loài người.", false],
		[10, "Quan hệ với thuộc địa", "Các lần phóng khoang là mối liên kết của thuộc địa với nền kinh tế bên ngoài, và người Aquarian liên tục tấn công chúng. Mỗi khoang bị hư hại hay bị mất đều khiến trạm mang tiếng xấu với cơ quan thương mại, nên người định cư thuê các phi công có vũ trang để đánh đuổi kẻ tấn công. Bảo vệ khoang cũng là một loại hợp đồng thường gặp của người định cư; xem [[contract/11]].", false],
		[10, "", "Trong [[chapter/10]], phi công được cử đến [[station/2]] để bảo vệ một lần phóng khoang, với lệnh của [[character/9]] là chỉ được để mất một vài khoang.", false],
		[11, "", "Không có gì cho thấy thuộc địa từng cố gắng nói chuyện với người Aquarian. Nó chỉ đơn giản trả tiền để đánh đuổi hoặc giết họ.", false],
		[13, "Quan hệ với quân nổi dậy", "Khi lên án sự bóc lột của thuộc địa, [[faction/rebels]] nói đến cả cư dân của hành tinh chứ không chỉ tài nguyên của nó. Có lẽ người Aquarian nằm trong số những cư dân ấy, nhưng trong một thời gian dài hai bên không hề tiếp xúc.", false],
		[19, "", "Quân nổi dậy và người Aquarian có chung mối quan tâm bảo vệ động vật của đại dương. Khi phi công che chở đàn mực gần [[station/7]], [[character/1]] cho rằng người Aquarian có thể trở thành đồng minh.", false],
		[44, "", "Bước ngoặt đến trong cuộc tấn công của người định cư vào [[station/14]] trong [[chapter/43]]. Khi các bến tàu của trạm bị trúng đòn và quân phòng thủ bị áp đảo về số lượng, một nhóm người Aquarian xuất hiện và tấn công người định cư, xoay chuyển trận đánh. [[character/9]] và lực lượng của hắn tháo chạy tán loạn.", false],
		[45, "", "Sau trận đánh, vị sứ giả tại Fiir giải thích rằng người Aquarian sẵn sàng chiến đấu chống lại sự cai trị của người định cư. [[character/2]] hy vọng rằng một khi thuộc địa bị đánh bại, con người và người Aquarian có thể sống hòa hợp với đại dương. Với sự giúp đỡ của họ, quân nổi dậy lên kế hoạch cho hai cuộc tổng tấn công cuối cùng.", false],
		[45, "", "Trong [[chapter/45]], một nhóm người Aquarian trồi lên từ đáy sâu để cùng phi công và biệt đội của [[character/12]] tấn công [[station/18]].", false],
		[47, "", "Cả hai cuộc tổng tấn công đều thành công, và các chỉ huy quân nổi dậy ghi công người Aquarian phần lớn trong chiến thắng.", false],
		[48, "", "Khi thuộc địa không còn, liên minh giữa quân nổi dậy và người Aquarian vẫn đứng vững ở cuối câu chuyện, cùng với lời hứa để đại dương được hồi phục.", false],
		[45, "Những câu hỏi còn bỏ ngỏ", "Nhiều điều về người Aquarian không bao giờ được giải thích. Câu chuyện không cho biết họ sống ở đâu, có bao nhiêu người, họ chế tạo hay sử dụng vũ khí ra sao, hay bằng cách nào họ hiểu được tiếng nói của loài người. Nó cũng bỏ ngỏ lý do họ nhắm riêng vào các khoang của thuộc địa, dù liên minh về sau của họ với quân nổi dậy gợi ý rằng họ coi hàng xuất khẩu là một phần của việc cướp bóc đại dương của mình.", false],
		[10, "Trong trò chơi", "Khi chiến đấu, người Aquarian xuất hiện như những chiến binh dạng cá bắn ra các tia năng lượng. Họ xoay trở chậm hơn tàu ngầm và không bao giờ tăng tốc đột ngột. Một người Aquarian bị tiêu diệt chết như một sinh vật biển, tan biến trong một lần, và không để lại xác tàu để trục vớt hay thứ gì để bắt.", false],
		[10, "", "Về phía thuộc địa, người Aquarian là kẻ thù trong các nhiệm vụ bảo vệ khoang. Họ lao thẳng đến các khoang, nên người bảo vệ phải nhanh chóng săn lùng họ. Nhiệm vụ thất bại nếu mất quá nhiều khoang. Tiêu diệt người Aquarian được tính là một lần hạ địch, nhưng không được tính vào tiền thưởng săn cướp biển.", false],
		[44, "", "Trong các chương cuối, họ chiến đấu bên phía phi công với tư cách đồng minh. Họ hiện trên radar như các tín hiệu thân thiện và tấn công tàu của người định cư.", false],
	],
	"world/biotek": [
		[31, "", "Máy phát Biotek là một nguồn năng lượng thử nghiệm do [[world/abel|Giáo sư Abel]] phát triển. Nó là chìa khóa trong kế hoạch của quân nổi dậy nhằm áp đảo hỏa lực người định cư. Quân nổi dậy định dùng nó để cấp năng lượng cho một vũ khí quá ngốn điện đối với bất kỳ tàu ngầm thông thường nào, và thu hồi nó là bước đầu tiên trong ba bước của kế hoạch đó. Bản thân máy phát không bao giờ được bán hay lắp như trang bị; khi chơi, phi công xử lý những bộ phận mà nó cần.", false],
		[31, "Nghiên cứu và vụ đánh cắp", "Công nghệ đằng sau máy phát đã được nghiên cứu nhiều năm mà chưa ai tạo ra được một nguyên mẫu hoạt động. Giáo sư Abel đã gần hoàn thành một chiếc thì người định cư đánh cắp nó. Giờ họ đang tự tìm cách hoàn thiện nó, điều mà quân nổi dậy quyết ngăn chặn.", false],
		[31, "", "Không lâu trước khi tiết lộ kế hoạch, [[character/2]] đã thu xếp cho một nhóm nhà khoa học tài năng đến [[station/14]]. Trong [[chapter/29]], phi công đã hộ tống đoàn tàu của họ vượt qua vùng biên giới gần [[station/13]] an toàn.", false],
		[31, "", "Tại Fiir, Ayumi giải thích vai trò của các nhà khoa học: họ là nhóm của Abel. Cùng nhau, họ sẽ biến máy phát thành trái tim của một vũ khí mới.", false],
		[31, "Kế hoạch ba bước", "Ayumi trình bày kế hoạch gồm ba bước. Thứ nhất, quân nổi dậy phải thu hồi máy phát. Thứ hai, họ cần một vũ khí đủ mạnh để xứng với một máy phát như vậy. Bà chưa giải thích bước thứ ba.", false],
		[31, "", "Theo một người cung cấp tin của Ayumi, máy phát bị đánh cắp đang được chuyển đi trong một đoàn tàu bình thường của người định cư, hướng đến một nơi gọi là Maarth. Vì không ai biết tàu nào chở nó, phi công, [[character/5]] và [[character/4]] phải chặn cả đoàn tàu gần [[station/2]] và trục vớt mọi thùng hàng.", false],
		[32, "", "Cuộc chặn đánh thành công và mọi thùng hàng đều được thu hồi, dù thủy thủ đoàn người định cư phản đối rằng họ chỉ chở lương thực và thuốc men.", false],
		[33, "", "Trở lại Fiir, Abel mang số hàng thu được về phòng thí nghiệm để hoàn thiện nguyên mẫu. Trong khi đó phi công lên đường tìm vũ khí cho bước thứ hai, [[world/eclipse|Eclipse]].", false],
		[39, "Cách hoạt động", "Máy phát lấy năng lượng từ vật chất sống. Một lồng ấp polymerase sao chép DNA của các hạt tảo, và quá trình sao chép này khởi động một phản ứng dây chuyền giải phóng năng lượng. Nguyên mẫu vẫn cần lồng ấp đó, [[goods/36]], trước khi có thể vận hành.", false],
		[39, "", "Chỉ một trạm có thiết bị để làm nó: [[station/16]], trạm tiên tiến nhất đại dương. Bước thứ ba của phi công là đến đó và sản xuất lồng ấp.", false],
		[42, "", "Khi lồng ấp đã được giao đến Fiir, Abel hoàn tất việc lắp đặt và máy phát cấp năng lượng cho khẩu Eclipse trên chính con tàu của phi công. Quân nổi dậy nhắc rằng nó vẫn chỉ là nguyên mẫu.", false],
		[44, "", "Nó trụ vững trong chiến đấu. Khi người định cư tấn công Fiir, khẩu Eclipse chạy bằng máy phát góp phần xoay chuyển trận đánh. [[character/9]] lộ rõ vẻ bàng hoàng khi thấy khẩu pháo trên một chiếc tàu ngầm.", false],
		[45, "", "Khi [[station/188]] đã nằm trong tay quân nổi dậy, họ bắt tay vào trang bị cùng tổ hợp pháo và nguồn năng lượng ấy cho càng nhiều đơn vị càng tốt.", false],
		[39, "Trong trò chơi", "Bước thứ ba kéo dài ba chương: đến Wagoll trong [[chapter/39]], sản xuất lồng ấp ở đó trong [[chapter/40]] và giao nó đến Fiir trong [[chapter/41]]. Trang mặt hàng của nó ghi một khoảng giá, nhưng không chợ nào bày bán, nên cách duy nhất để có một chiếc là tự làm.", false],
		[39, "", "Lồng ấp được làm trong nhà máy của một trạm cấp công nghệ 11, mà trên thực tế nghĩa là Wagoll. Công thức của nó cần mỗi thứ một đơn vị: [[goods/19]], [[goods/34]], [[goods/28]] và [[goods/24]]. Những thứ này lần lượt đến từ cá chết và tảo, từ hàng nhập khẩu, từ cả năm loại tảo, và từ [[goods/35]] cùng [[species/5]] và [[species/1]]. Thu thập chúng là cả một chuỗi sản xuất nhỏ.", false],
		[39, "", "Wagoll nằm ở độ sâu 29.850 m, sâu hơn mức mà phần lớn các loại giáp chịu được, nên phi công cần giáp nặng như [[equipment/25]] để đến đó an toàn. Lồng ấp là một vật phẩm cốt truyện không chợ nào bày bán. Khi đã làm xong, nó nằm trên tàu cho đến khi được giao đến Fiir.", false],
	],
	"world/colony": [
		[1, "", "Thuộc địa là khu định cư của loài người trên hành tinh đại dương: hai trăm trạm biển sâu do một bộ máy quản lý thuộc địa điều hành, cùng với những người định cư, ngư dân và thương nhân sống và làm việc trong đó. Khi câu chuyện bắt đầu, mọi trạm đều thuộc về [[faction/colonists]], và mục đích của thuộc địa rất rõ ràng. Nó tồn tại để lấy tài nguyên của đại dương và chuyển đi nơi khác. Bài viết này trình bày cách thuộc địa được tổ chức, nền kinh tế của nó vận hành ra sao và cả hai thay đổi thế nào khi câu chuyện diễn tiến.", false],
		[1, "Thuộc địa hóa", "Những người định cư đến hành tinh từ nơi khác và dựng nhà dưới mặt nước, nơi các trạm hiện nằm ở độ sâu khoảng 13.500 đến 32.250 m. Các trạm rất khác nhau. Mỗi trạm có một cấp công nghệ từ 1 đến 11, quyết định nhà máy của nó sản xuất được gì và cửa hàng tính giá bao nhiêu, và mỗi trạm có vùng nước, động vật hoang dã và láng giềng riêng. Một số là trung tâm lớn như [[station/0]]; số khác là những tiền đồn nhỏ nổi tiếng với một sản phẩm duy nhất.", false],
		[1, "", "Người mới đến được trông đợi phải tự lo liệu phần mình. Phi công đến hành tinh để đánh cá, với một chiếc tàu nhỏ và ít tiền, và nhanh chóng nhận ra công việc vất vả mà lương lại bèo bọt.", false],
		[10, "", "Thuộc địa là một nền kinh tế xuất khẩu. Các trạm chất hàng hóa vào khoang vận chuyển và phóng chúng lên quỹ đạo, nơi tàu chở hàng thu gom chúng. Đứng trên các viên chức địa phương là một cơ quan thương mại đánh giá các trạm theo mức độ tin cậy của những chuyến hàng này.", false],
		[12, "", "Kế hoạch riêng của phi công chỉ đơn giản là kiếm đủ tiền mua vé rời khỏi hành tinh.", false],
		[21, "", "Quân nổi dậy mô tả quá trình thuộc địa hóa là nhanh chóng và tàn nhẫn. Theo họ, nó đang vắt kiệt đại dương nhanh hơn khả năng phục hồi của thiên nhiên, như đã xảy ra trên những hành tinh khác.", false],
		[1, "Bộ máy quản lý và các trạm", "Mỗi trạm là một thị trấn nhỏ với viên chức và dịch vụ riêng. Khi đã cập bến, phi công có thể vào xưởng tàu để lắp trang bị, đến cửa hàng và xưởng đóng tàu để mua thiết bị và thân tàu, và xem bản đồ. Phần lớn các trạm còn có bảng hợp đồng, và một số có chợ và nhà máy. Tàu tuần tra đi vòng quanh mỗi trạm giữa các cổng S.T.R.E.A.M. của nó và chiến đấu cho phe nào đang nắm giữ trạm.", false],
		[2, "", "Các viên chức thuộc địa đại diện cho thuộc địa trong những việc hằng ngày. Tại [[station/0]], [[character/9]] mua mẻ cá của phi công và ban phát những lời khuyên chẳng ai cần.", false],
		[7, "", "An ninh trạm xử lý các mối đe dọa tại chỗ, và các viên chức giao những việc như vậy cho người làm tự do. Khi ốc anh vũ tụ tập quanh [[station/1]], nhân viên an ninh ở đó muốn dẹp chúng đi, và Jack cử phi công đi lo việc này.", false],
		[9, "", "Các viên chức đòi người mới phải tạo được lòng tin trước khi nhận việc quan trọng. Phi công phải hoàn thành các hợp đồng trên bảng hợp đồng trước khi thuộc địa giao việc gì lớn hơn. Những viên chức [[character/6]] vô danh mà phi công gặp thường cộc lốc và trả càng ít càng tốt.", false],
		[1, "Giá cố định", "Trạm của người định cư không buôn bán. Không có chợ cũng không có nhà máy: khi tàu cập bến, trạm chỉ đơn giản lấy mọi thứ trong khoang và trả giá sàn cho từng món, mức thấp nhất mà món đó có thể bán được. Đơn hàng do chính trạm đặt được thanh toán trước; mọi thứ khác theo mức giá cố định. Với một ngư dân không còn nơi nào khác để bán, đó là toàn bộ nền kinh tế.", false],
		[1, "", "Điều này khiến ngư dân của thuộc địa mãi nghèo. Giá sàn thường chưa bằng một nửa số tiền mà cùng mẻ cá đó có thể bán được ở nơi khác, và không có người mua nào khác.", false],
		[1, "Chợ và giá cả", "Chợ tự do chỉ tồn tại ở những trạm nằm ngoài sự kiểm soát của thuộc địa. Ở đó giá một mặt hàng phụ thuộc vào khoảng cách. Mỗi mặt hàng có một trạm gốc, nơi nó bán theo giá sàn, và một chợ tốt nhất, nơi nó đạt giá trần. Ở giữa, giá tăng theo khoảng cách trên hải đồ tính từ trạm gốc. Ba mặt hàng nhập khẩu, [[goods/33]], [[goods/34]] và [[goods/35]], đi theo chiều ngược lại và rẻ nhất ở chợ tốt nhất của chúng. Chợ mua và bán cùng một giá, nên lợi nhuận đến từ việc chở hàng chứ không phải từ mặc cả. Xem [[guide/trading]].", false],
		[1, "", "Cấp công nghệ của trạm cũng định hình cửa hàng của nó. Tàu và trang bị rẻ hơn ở các trạm tiên tiến: mỗi cấp công nghệ giảm một phần trăm giá thân tàu, và trang bị cũng rẻ hơn một chút. Trang bị hiếm xuất hiện thường xuyên hơn khi câu chuyện tiến triển.", false],
		[1, "Nhà máy và công thức", "Nhà máy biến mẻ cá thô và hàng nhập khẩu thành sản phẩm. Mỗi sản phẩm có công thức cố định và cấp công nghệ tối thiểu. [[goods/21]] cần một [[species/4]] và [[species/17|tảo lục]]; [[goods/22]] cần một [[species/10]] và [[goods/35]]; [[goods/29]] kết hợp [[goods/20]] với sơn. Những sản phẩm cao cấp như [[goods/41]] cần các sản phẩm khác làm nguyên liệu, nên một chuỗi sản xuất có thể biến cá rẻ tiền thành hàng hóa giá trị.", false],
		[1, "", "Một nhà máy có thể làm bất cứ thứ gì đến cấp công nghệ của trạm. Phần lớn sản phẩm chỉ cần cấp 1, nhưng ít nhất có một món chỉ có thể làm tại trạm tiên tiến nhất. Trang của mỗi sản phẩm liệt kê công thức của nó.", false],
		[1, "Bảng hợp đồng", "Công việc theo hợp đồng là cách thuộc địa thuê người làm tự do. Một bảng hợp đồng liệt kê từ một đến tám lời mời, mỗi lời mời có bên đặt hàng, tiền cọc phải trả khi nhận và thù lao trả khi thành công. Thù lao tăng theo độ khó và khoảng cách, còn độ khó tăng theo cấp bậc của phi công. Phần lớn công việc đưa phi công đến một trạm khác, thường là trạm nằm trong dải độ sâu của tàu. Xem [[guide/contracts]].", false],
		[1, "", "Một bảng hợp đồng đưa ra những gì tùy thuộc vào phe nắm giữ trạm. Người định cư thuê người hộ tống đoàn tàu, người cướp đoàn tàu, thợ săn và người bảo vệ cho các lần phóng khoang của họ. Các trạm tự do đăng đơn hàng giao nhận và đánh bắt, và trả tiền để bảo vệ các đàn động vật. Cả hai phe đều đăng lệnh truy nã, giải cứu, săn cướp biển, chở khách và dọn dẹp.", false],
		[9, "", "Bảng hợp đồng chỉ mở cho phi công sau những công việc đầu tiên cho thuộc địa, trong [[chapter/9]]. Bản đồ trạm có sớm hơn một chút.", false],
		[1, "Luật pháp và trật tự", "Thuộc địa áp đặt luật lệ riêng dưới nước. Các trạm trả tiền thưởng cho mỗi tên cướp biển bị tiêu diệt trong một chuyến, nhận khi cập bến. Số tiền bằng bình phương số cướp biển, nhân với 100 tín dụng tại trạm của người định cư và 50 tại trạm tự do, nên một cuộc săn dài được trả nhiều hơn hẳn vài cuộc săn ngắn.", false],
		[12, "", "Không phải vùng nước nào cũng thuộc về thuộc địa. Các trạm do phong trào kháng chiến nắm giữ coi vùng nước quanh mình là lãnh thổ trung lập và chặn hỏi những con tàu lạ trước khi cho cập bến.", false],
		[35, "", "Một số mặt hàng bị cấm buôn bán. Chất gây say bị cấm ít nhất ở một số trạm, tạo chỗ cho những tay buôn chợ đen như [[character/8]]. Cơ quan an ninh thuê thợ săn tiền thưởng như [[character/11]] để trừ khử những kẻ như vậy.", false],
		[12, "Thuộc địa trong câu chuyện", "Với phi công, thuộc địa trước tiên là người chủ rồi sau đó là đối thủ. Jack trả giá cố định, cuộc tàn sát ốc anh vũ tại [[station/1]] được trả công bèo bọt, và trận bảo vệ khoang tại [[station/2]] kết thúc với việc Jack từ chối trả bất kỳ phần thưởng nào. Chán ngán, phi công nghe theo lời khuyên của M.A.I. và đi tìm phong trào kháng chiến tại [[station/3]].", false],
		[13, "", "Phong trào kháng chiến phản đối việc thuộc địa kiểm soát thương mại và bóc lột hành tinh. Các thành viên của nó muốn tự do thương mại, giá cả công bằng và một vùng biển được đánh bắt có chừng mực.", false],
		[18, "", "Ban đầu quân nổi dậy giành các trạm bằng ngoại giao, thuyết phục lãnh đạo của chúng đổi phe. Mỗi trạm gia nhập đều mở chợ và nhà máy cho phi công, nên nền kinh tế của thuộc địa thay đổi theo từng trạm. Lời bàn tán về một cuộc cách mạng lan rộng.", false],
		[23, "", "Thuộc địa không chịu lặng lẽ từ bỏ các trạm của mình. Jack, nay đã là một nhân vật có chút ảnh hưởng, rải một bãi thủy lôi để cắt đứt một tuyến tiếp tế của quân nổi dậy gần [[station/9]].", false],
		[25, "", "Sau đó Jack phục kích người lãnh đạo quân nổi dậy trên đường bà đến đàm phán tại [[station/10]].", false],
		[28, "", "Thuộc địa còn mua chuộc kẻ phản bội. Jack treo thưởng cho người lãnh đạo quân nổi dậy và phi công, và phi công nổi dậy [[character/3]] nhận tiền.", false],
		[31, "", "Thuộc địa cũng đang chạy đua công nghệ với quân nổi dậy. Người của nó đã đánh cắp [[world/biotek]] nguyên mẫu của [[world/abel|Giáo sư Abel]] và đang tự tìm cách hoàn thiện nó.", false],
		[37, "", "Lòng tham làm suy yếu thuộc địa từ bên trong. Chính Jack bán một khẩu pháo trạm, [[world/eclipse|Eclipse]], cho một tay buôn chợ đen, kẻ sau đó bán lại nó cho phi công.", false],
		[44, "", "Trong lần phô trương sức mạnh cuối cùng, người định cư đánh sâu vào lãnh thổ của quân nổi dậy và tấn công [[station/14]], nhưng rồi bị đánh bật khi người Aquarian tham chiến chống lại họ.", false],
		[45, "", "Sau thất bại đó, quân nổi dậy tiến tới kết liễu thuộc địa bằng hai cuộc tổng tấn công lớn, mỗi cuộc ở một bán cầu.", false],
		[47, "", "Các trạm phía nam thất thủ, và người định cư chỉ còn lại [[station/0]] làm thành trì lớn cuối cùng, được phòng thủ kiên cố.", false],
		[48, "", "Gosu thất thủ trong trận chiến cuối cùng. Jack trốn thoát trong một khoang cứu hộ, và sự cai trị của thuộc địa trên đại dương chấm dứt, với mọi trạm nằm trong tay quân nổi dậy.", false],
	],
	"world/eclipse": [
		[33, "", "Eclipse là một khẩu pháo hạng nặng được chế tạo để phòng thủ trạm. Nó ngốn năng lượng đến mức chưa bao giờ được dự định lắp lên tàu ngầm. Ở bước thứ hai trong kế hoạch của quân nổi dậy, phi công phải kiếm được một khẩu để ghép với [[world/biotek]], thứ có thể cung cấp đủ năng lượng để bắn nó từ một con tàu. Vũ khí này là [[equipment/42]] trong danh sách trang bị, còn khẩu pháo đóng thùng được buôn bán trong câu chuyện là [[goods/38]].", false],
		[33, "Nguồn gốc", "Eclipse thuộc một dòng pháo trạm được thiết kế cho hệ thống phòng thủ cố định. Nhu cầu năng lượng của nó là lý do nó chỉ nằm trên các trạm: không nhà máy năng lượng nào của tàu ngầm có thể giữ cho nó khai hỏa. Phi công vốn đã biết đến nó như một vũ khí cố định, nên kế hoạch mang một khẩu lên tàu của quân nổi dậy nghe thật khó tin.", false],
		[33, "", "Pháo Eclipse được sản xuất tại [[station/188]], trạm nằm trong tay người định cư khi kế hoạch bắt đầu. Trạm phù hợp gần nhất dưới quyền kiểm soát của quân nổi dậy là [[station/15]]. Vũ khí này hoàn toàn không được bán trên thị trường công khai.", false],
		[33, "", "Quân nổi dậy cần nó vì họ yếu thế về quân số. Thay vì đọ từng con tàu với người định cư, họ hy vọng một vũ khí có sức mạnh như vậy, gắn trên một chiếc tàu ngầm, có thể làm nghiêng cán cân.", false],
		[33, "Kiếm khẩu pháo", "[[character/2]] không có kế hoạch rõ ràng để kiếm một khẩu. Bà đưa cho phi công 100.000 tín dụng cho bất kỳ khoản đút lót nào cần thiết và cử phi công đến Choral để dò la.", false],
		[35, "", "Tại Choral, phi công được tay buôn chợ đen [[character/8]] tiếp cận, kẻ khẳng định có thể kiếm hầu như mọi thứ nếu có tiền. Hắn sẽ thử tìm một khẩu Eclipse, nhưng chỉ khi phi công giết thợ săn tiền thưởng [[character/11]] trước, kẻ đã được thuê để trừ khử hắn.", false],
		[37, "", "Khi Raoul đã chết, Fenko đưa ra một khẩu Eclipse với giá cắt cổ. Hắn mua nó từ [[character/9]], kẻ dường như đã bán khẩu pháo để kiếm lời mà không biết nó sẽ rơi vào tay kẻ thù của mình.", false],
		[38, "", "Phi công mua vũ khí và chở nó về [[station/14]].", false],
		[39, "", "[[character/2]] quyết định không hỏi khẩu pháo được kiếm bằng cách nào. Bà nhẹ nhõm khi nghe rằng không có người vô tội nào phải chết vì nó. Khi phi công đùa rằng kế hoạch này chẳng khác gì chinh phục cả hành tinh, bà dứt khoát bác bỏ ý đó.", false],
		[42, "Eclipse đi vào hoạt động", "Sau khi [[goods/36]] đến Fiir, [[world/abel|Giáo sư Abel]] nối khẩu pháo với máy phát nguyên mẫu, và Eclipse sẵn sàng được lắp lên chính chiếc tàu ngầm của phi công. Quân nổi dậy cảnh báo rằng nguồn năng lượng vẫn chỉ là nguyên mẫu. Lệnh dành cho phi công là thử vũ khí với một băng cướp biển gần [[station/17]].", false],
		[43, "", "Cuộc thử diễn ra tốt đến mức bọn cướp biển phải gọi tiếp viện. Ngay sau đó khẩu pháo đối mặt với thử thách thực sự, khi người định cư tấn công Fiir; Jack khó lòng tin nổi phi công đang mang một khẩu Eclipse.", false],
		[45, "", "Sau trận phòng thủ Fiir, quân nổi dậy chiếm [[station/188]] và bắt đầu lắp Eclipse cho càng nhiều tàu của mình càng tốt, chuẩn bị cho các cuộc tổng tấn công cuối cùng.", false],
		[47, "", "Trong các trận chiến giành [[station/18]] và [[station/109]], khẩu pháo tỏ ra có sức hủy diệt khủng khiếp, và [[character/5]] hết lời khen ngợi nó.", false],
		[37, "Trong trò chơi", "Trong các chương quanh [[chapter/37]], khẩu Eclipse đóng thùng được bán tại Choral như một mặt hàng cốt truyện. Nó đắt hơn bất kỳ mặt hàng thông thường nào và không bao giờ có hàng ở nơi khác.", false],
		[42, "", "Trong [[chapter/42]], [[equipment/42]] xuất hiện trong cửa hàng trang bị tại [[station/14]] và lắp đặt miễn phí. Cho đến khi nó được lắp, bảng hợp đồng và bản đồ bị đóng và tàu không thể rời đi. Mỗi tàu chỉ lắp được một khẩu Eclipse, và không thể bán nó cho đến khi cuộc chiến giành thắng lợi.", false],
		[42, "", "Là một vũ khí, nó vượt trội mọi thứ đang được bán. Mỗi phát bắn mạnh hơn bất kỳ khẩu súng nào khác trong trò chơi, với tầm khoảng 240 m, và nó bắn khoảng một phát mỗi giây. Nó khai hỏa cùng với cả dàn súng còn lại, nên kết hợp được với mọi vũ khí khác đã lắp.", false],
	],
	"world/history": [
		[1, "", "Chiến dịch kể về một phi công tàu ngầm trẻ tuổi đến một hành tinh đại dương xa xôi để làm ngư dân cho [[world/colony|thuộc địa]] của loài người ở đó. Người định cư sống trong những trạm rải rác dưới đáy sâu của [[world/ocean|đại dương]], và thuộc địa phụ thuộc vào những gì các phi công của nó đánh bắt, buôn bán và chuyên chở giữa các trạm. Phi công sở hữu một chiếc tàu ngầm nhỏ, trang bị khiêm tốn, và đi chung với [[character/1]], máy tính trên tàu, vốn không bao giờ thiếu lời khuyên hay ý kiến. Người chơi tự đặt tên cho phi công; tài liệu này chỉ gọi nhân vật chính là phi công.", false],
		[1, "", "Câu chuyện trải dài qua 48 chương. Nó bắt đầu bằng công việc thường ngày của một ngư dân: bắt sinh vật biển, bán mẻ cá và nhận việc vặt để kiếm sống. Từ đó, câu chuyện mở rộng thành một cuộc xung đột về cách đối xử với biển cả và các sinh vật của hành tinh, và về việc ai có quyền quyết định điều đó. Trên đường đi, phi công phải đối mặt với các viên chức trạm, thương nhân, [[faction/pirates]] và những cư dân kỳ lạ hơn của đáy sâu, và lựa chọn của một ngư dân hóa ra có ý nghĩa lớn hơn nhiều so với những gì ai cũng tưởng.", false],
		[1, "Hồi I: Ngư dân của thuộc địa", "Câu chuyện mở đầu ngoài khơi trong [[chapter/1]]. Phi công đã bắt đầu hối hận vì chuyển đến hành tinh này, nhưng [[character/1]] nhắc rằng họ đến đây để đánh cá, và việc đầu tiên chỉ đơn giản là phóng lao móc vào một sinh vật rồi kéo nó vào khoang. Những cảnh mở đầu đồng thời là phần làm quen với việc đánh bắt sinh vật biển.", false],
		[2, "", "Khi sinh vật đầu tiên đã được kéo lên, [[character/1]] cho thấy chế độ lái tự động có thể đảm nhận việc điều khiển tàu, và trong [[chapter/2]] phi công đặt lộ trình đến [[station/0]], trạm của người định cư nơi mẻ cá được bán.", false],
		[3, "", "Tại [[station/0]], phi công làm việc với [[character/9]], viên chức thuộc địa thu mua cá. [[character/9]] trả mức giá cố định như thường lệ, chế giễu khoang hàng nhỏ và giảng giải cho người mới đến rằng ai cũng phải góp phần cho thuộc địa. Hắn còn mỉa mai rằng một phi công có súng tử tế có thể kiếm nhiều hơn bằng cách săn [[faction/pirates]]. Khi hắn đi rồi, [[character/1]] gọi hắn là đồ ngốc nhưng vẫn tiếp thu gợi ý, lưu ý rằng [[equipment/0]] đang được bán trong xưởng tàu. Trong [[chapter/3]], phi công mua khẩu súng và lắp nó lên tàu.", false],
		[4, "", "Lần đầu tiên có vũ khí, phi công rời trạm trong [[chapter/4]] để thử nó, trong khi [[character/1]] nhắc không được bắn vào cá vô hại. Vùng biển quanh đó hóa ra không có cướp biển nào, nên cuộc săn phải chuyển sang nơi khác.", false],
		[5, "", "[[character/1]] giải thích cách thực hiện những chuyến đi xa: tàu vượt qua những khoảng cách lớn nhờ [[world/stream|mạng lưới S.T.R.E.A.M.]], luôn rời một khu vực qua điểm ra của nó và đến điểm vào của khu vực tiếp theo. Trong [[chapter/5]], một tên cướp biển đơn độc xuất hiện gần [[station/1]]. Sau một bài học nhanh về chuyển đổi vũ khí, dùng chế độ bắn tự động và đọc radar, phi công chiến đấu lần đầu tiên.", false],
		[6, "", "Tên cướp biển bị tiêu diệt, và [[character/1]] chỉ cách dùng lao móc thu các thùng hàng mà xác tàu để lại trước khi chúng chìm ngoài tầm với. Với một vũ khí dùng được và chút hàng trục vớt, phi công quay về [[station/0]] trong [[chapter/6]].", false],
		[7, "", "Trở lại trạm, [[character/9]] hài lòng vì lời khuyên của mình được nghe theo và giao cái mà hắn gọi là việc thực sự. [[species/0|Ốc anh vũ]] đang tụ tập dày đặc trên các tuyến đoàn tàu quanh [[station/1]], và lực lượng an ninh của trạm muốn dẹp chúng đi. Phi công phản đối rằng những con vật này chỉ ăn lớp sinh vật bám phủ trên vỏ trạm, và không khoang hàng nhỏ nào chở hết được chúng, nhưng [[character/9]] chẳng quan tâm chúng biến mất bằng cách nào. Trong [[chapter/7]], phi công dọn sạch chúng, bằng lao móc hoặc bằng súng. Cả phi công lẫn [[character/1]] đều không vui với công việc này, vì loài vật ấy vừa ít ỏi vừa vô hại.", false],
		[8, "", "Cuộc tàn sát khiến phi công bàng hoàng. Phi công đến hành tinh này để đánh cá, chứ không phải để giết động vật cho tiện việc của một trạm, và [[character/1]] chỉ có thể hy vọng tiền công bù đắp được phần nào. Cả hai cập bến [[station/1]] để nhận tiền trong [[chapter/8]].", false],
		[9, "", "Viên chức người định cư ở đó ([[character/6]]) đối xử với phi công như một kẻ diệt sâu bọ thuê và thừa nhận công việc có lẽ vô ích, vì ốc anh vũ cứ quay lại. Khoản tiền là 1.000 $ cố định, nhận hay không thì tùy. Mọi công việc tiếp theo đều tùy vào bằng chứng năng lực: ba hợp đồng hoàn thành từ bảng hợp đồng của các trạm. [[chapter/9]] đưa phi công đi làm tự do, nhận bất kỳ việc hộ tống, trục vớt hay đơn đặt hàng đánh bắt nào trong tầm tay.", false],
		[10, "", "Ba công việc mang lại sự chấp thuận miễn cưỡng của viên chức và một nhiệm vụ đặc biệt. Những sinh vật kỳ lạ mà người định cư gọi là [[world/aquarians|người Aquarian]], nửa người nửa cá, đã tấn công các khoang vận chuyển phóng hàng hóa của thuộc địa lên quỹ đạo, nơi tàu chở hàng thu gom chúng. Khoang bị mất hay hư hại khiến trạm mang tiếng xấu với [[world/colony|cơ quan thương mại]], nên phi công được cử đến [[station/2]] để đánh đuổi kẻ tấn công. [[character/9]] sẽ có mặt ở đó để chỉ huy lần phóng tiếp theo.", false],
		[10, "", "Trong [[chapter/10]], cuộc phóng đã bắt đầu khi phi công đến nơi, và người Aquarian quả thật đang tấn công các khoang. [[character/9]] gửi qua radio một lời cảnh báo thẳng thừng: công việc của phi công tùy thuộc vào việc không để mất quá năm khoang.", false],
		[11, "", "Cuộc tấn công bị đẩy lùi, nhưng để lại nhiều câu hỏi. Phi công băn khoăn vì sao người Aquarian lại nhắm vào các khoang, và [[character/1]] cho rằng họ có thể thông minh hơn nhiều so với người định cư nghĩ. Ngày càng bất an với kiểu công việc này, phi công cập bến [[station/2]] để báo cáo trong [[chapter/11]].", false],
		[12, "Hồi II: Phong trào kháng chiến", "Cách [[character/9]] đón tiếp làm cạn kiệt sự kiên nhẫn của phi công với thuộc địa. Hắn đổ lỗi cho phi công về các khoang bị hư hại, hủy phần thưởng rồi hậm hực bỏ đi, lẩm bẩm rằng mình sinh ra để làm việc lớn. Sau đó [[character/1]] nói ra điều cả hai đều cảm thấy: phi công làm việc cả ngày cho thuộc địa, kiếm được rất ít và chẳng có tiếng nói gì về mẻ cá, thứ chỉ đơn giản bị thu mua theo giá cố định. Phi công chỉ muốn dành dụm đủ tiền mua vé rời khỏi hành tinh, nhưng [[character/1]] có ý khác.", false],
		[12, "", "Trong lúc dò các băng tần radio, [[character/1]] đã bắt được dấu hiệu của một phong trào kháng chiến phát sóng từ [[station/3]]. Quyết định được để cho phi công, người biết rằng việc này có thể dẫn đến rắc rối lớn nhưng vẫn quyết đi. Từ nay [[character/1]] đánh dấu các trạm của phong trào bằng màu xanh lục trên bản đồ (xem [[faction/rebels]]).", false],
		[12, "", "Trong [[chapter/12]], ý định tiếp cận [[station/3]] một cách kín đáo thất bại ngay lập tức. Lính gác của trạm chặn tàu lại và đe dọa nổ súng, phi công lắp bắp xưng tên, nói rằng chuyến đi bắt đầu từ [[station/0]] và xin gia nhập. Sau một khoảng im lặng dài, tàu được phép cập bến.", false],
		[13, "", "Bên trong, [[character/4]] tra hỏi người mới đến bằng một tràng câu hỏi rối rắm. Phi công thừa nhận hầu như không biết gì ngoài việc phong trào ủng hộ tự do thương mại. Điều đó khớp với lời chính [[character/4]] thừa nhận rằng quân nổi dậy chỉ mới bắt đầu mã hóa liên lạc radio vài ngày trước. Đang thiếu người giúp, [[character/4]] nhận phi công vào thử việc. Phong trào định thâm nhập các trạm của người định cư, thuyết phục lãnh đạo của họ đổi phe và chấm dứt việc bóc lột hành tinh cùng cư dân của nó.", false],
		[13, "", "[[character/4]] không chia sẻ kế hoạch với người lạ, nên trước hết phi công phải chứng tỏ mình có ích. Trong [[chapter/13]], nhiệm vụ là đón những người đồng tình tại [[station/4]] và đưa họ đến [[station/5]]. Trên đường đi, phi công thú nhận với [[character/1]] rằng toàn bộ chuyện này vẫn là một bí ẩn, nhưng đồng ý rằng dù sao nó cũng hơn nhận lệnh từ [[character/9]].", false],
		[14, "", "Người liên lạc tại [[station/4]] chỉ là một hành khách duy nhất, [[character/5]]. Cô ấm áp và nhanh nhẹn, rõ ràng rất vui được gặp phi công, và phi công cũng rõ ràng bị cô cuốn hút. Cô không chịu giải thích kế hoạch của phong trào, nói rằng giữ bí mật là lý do nó tồn tại được đến giờ, rồi gửi tọa độ cho chuyến đi. [[character/1]] quan sát hai người với vẻ bực bội ra mặt, khiến phi công trêu là nó ghen. Trong [[chapter/14]], phi công chở [[character/5]] đến [[station/5]] nhanh và an toàn nhất có thể.", false],
		[15, "", "Tại [[station/5]], [[character/5]] đi ẩn náu để thu xếp một số việc, nhưng trước đó cô giải thích vì sao quân nổi dậy giữ khoảng cách với người định cư. Họ không vơ vét tài nguyên của biển. Họ chỉ lấy những gì biển có thể cho, chế biến mẻ cá thành hàng hóa và cẩn thận không đánh bắt quá mức, để sự đa dạng sự sống của biển được bảo tồn. Để cho thấy cách làm này, cô đề nghị phi công sản xuất năm tấn hàng hóa tại nhà máy của một trạm kháng chiến ([[chapter/15]]). Cô gợi ý [[station/90]], nơi có thể bắt mực và mua [[goods/35]] để làm [[goods/22]].", false],
		[16, "", "Khi phi công đã học được cách kiếm tiền thứ hai này, [[character/5]] gọi đến với một nhiệm vụ mới. Phong trào cần thông tin cập nhật từ mọi trạm để tìm ra điểm yếu và lôi kéo dân chúng, vì sức thuyết phục sẽ quan trọng không kém hỏa lực. Khi phi công hỏi liệu đây có phải một cuộc cách mạng không, cô từ chối nói thêm. Trong [[chapter/16]], phi công đi một vòng các trạm chưa từng ghé, vừa đi vừa kiếm tiền nâng cấp tàu.", false],
		[17, "", "Một tin nhắn dài từ [[character/4]], được [[character/1]] tóm gọn trong một dòng, gọi phi công trở lại [[station/3]] trong [[chapter/17]]. Trong lúc đó vùng của quân nổi dậy đang mở rộng: [[station/6]], [[station/12]], [[station/106]] và [[station/180]] đã ngả về phía phong trào.", false],
		[18, "Hồi III: Người lãnh đạo", "[[character/4]] giải thích rằng ngoại giao đã lặng lẽ mở rộng vùng của quân nổi dậy, nên giờ phi công có thể buôn bán ở nhiều trạm hơn hẳn. Các kênh tin tức đã nói đến một cuộc cách mạng. Nhiều người có quyền quyết định đã gia nhập mà không cần nổ một phát súng, dù [[character/4]] cho rằng sớm muộn gì cũng sẽ đổ máu. Các bước tiếp theo do người lãnh đạo phong trào chỉ đạo từ một trong những trạm vừa thu phục được, và phi công phải tìm ra người lãnh đạo ấy, hay đúng hơn là để người đó tìm ra mình. [[character/4]] đánh dấu các trạm khả nghi và cảnh báo rằng một số trạm có thể nằm ngoài tầm với nếu không có giáp hoặc khiên tốt hơn.", false],
		[18, "", "[[character/1]] chẳng mấy ấn tượng với cách phong trào được tổ chức, và [[chapter/18]] trở thành một cuộc tìm kiếm gần như chỉ trông vào vận may.", false],
		[19, "", "Dấu vết kết thúc tại [[station/6]], nơi phi công gặp [[character/2]], một người phụ nữ lớn tuổi lãnh đạo phong trào và từ nay sẽ ra lệnh. Phi công vốn tưởng người lãnh đạo là đàn ông, một nhầm lẫn bà bỏ qua. Nhiệm vụ đầu tiên bà giao là hộ tống. Một đàn [[species/10]] phải được dẫn đến vùng nước an toàn gần [[station/7]] trước khi người định cư kịp bắt hoặc giết chúng, và nhiều khả năng sẽ có giao tranh. [[character/1]] càu nhàu rằng chẳng ai nhắc đến tiền công, còn phi công cho rằng trước hết [[character/2]] muốn biết liệu người mới đến có đáng tin không.", false],
		[19, "", "Trong [[chapter/19]], phi công thấy người Aquarian bơi cùng đàn sinh vật, và [[character/1]] tự hỏi liệu họ có chăm sóc các sinh vật biển hay không. Chẳng bao lâu tàu của người định cư áp sát, và phi công phải chặn chúng mà không bắn trúng lũ động vật.", false],
		[20, "", "Đàn sinh vật sống sót. [[character/2]] trả một khoản khiêm tốn 2.000 $ và gọi phi công về ngay, trong khi [[character/1]] phàn nàn rằng bán lũ động vật còn lời hơn nhiều. Trong [[chapter/20]], phi công trở về [[station/6]].", false],
		[21, "", "Lần này phi công hỏi thẳng phong trào theo đuổi điều gì. [[character/2]] mô tả một nhóm người đoàn kết chống lại sự tàn phá hành tinh và cư dân của nó. Quá trình thuộc địa hóa diễn ra quá nhanh, và thiên nhiên bị khai thác tàn nhẫn đến mức cây cỏ và động vật dưới biển sẽ sớm không thể phục hồi. Nếu không có gì thay đổi, hành tinh sẽ bị vắt kiệt như nhiều thế giới trước đó. Phong trào muốn ngăn chặn điều này bằng cách kéo những người có quyền quyết định quan trọng về phía mình, và phi công cam kết giúp đỡ.", false],
		[21, "", "Mối lo trước mắt của [[character/2]] là [[faction/pirates]], kẻ đang lợi dụng cuộc xung đột để săn những mục tiêu dễ xơi. Đến nay phong trào chỉ tự vệ; giờ nó sẽ trực tiếp tấn công một đội hình cướp biển. Để trấn an phi công đang lo lắng, bà cử thêm một người hộ tống, [[character/3]], một trong những phi công giỏi nhất của bà, dù [[character/1]] ngờ rằng thực ra phi công mới là người đi hộ tống. Trong [[chapter/21]], hai người gặp nhau gần [[station/8]]. [[character/3]] đón người mới đến muộn bằng thái độ sốt ruột và kẻ cả, bảo phi công cứ bám sau anh ta mà học.", false],
		[22, "", "Băng cướp bị tiêu diệt. [[character/3]] khen một cách miễn cưỡng, nhưng khi [[character/2]] thưởng cho mỗi người 5.000 $, anh ta giận dữ vì tiền bị chia đều và bảo phi công rằng người mới chẳng đóng góp gì. Phi công và [[character/1]] rời đi trước khi anh ta nổi nóng hơn. Trong [[chapter/22]], họ đến [[station/9]] để gặp [[character/2]], người vừa đàm phán thành công ở đó: trạm đã gia nhập phong trào cùng với [[station/5]], [[station/37]] và một số trạm khác.", false],
		[23, "", "Trước khi [[character/2]] lên đường, tuyến tiếp tế đến [[station/37]] phải được bảo đảm an toàn. [[character/9]] đã rải một bãi thủy lôi ngay bên ngoài trạm để cắt đứt tuyến này. [[character/2]] biết hắn: từng là kẻ vô danh tiểu tốt, hắn thăng tiến nhanh nhờ những người bạn có vị trí tốt. Háo hức phá hỏng kế hoạch của hắn, phi công lên đường rà phá bãi thủy lôi trong [[chapter/23]]. [[character/2]] cảnh báo rằng cướp biển sẽ lượn lờ gần đó, và mỗi quả thủy lôi chỉ có thể bị phá hủy khi phi công đã đến đủ gần để kích hoạt cảm biến chuyển động của nó.", false],
		[24, "", "Bãi thủy lôi được rà phá, tuyến đường lại an toàn, và [[character/2]] trả 4.000 $ cho công việc. Trở lại [[station/9]] trong [[chapter/24]], phi công thấy vùng của quân nổi dậy đã rộng hơn nhiều. Một làn sóng trạm khắp đại dương nay đứng về phía phong trào, trong đó có [[station/14]], [[station/22]] và [[station/25]].", false],
		[25, "", "Tại trạm, phi công đoàn tụ với [[character/5]], cuộc trò chuyện ấm áp nhưng vụng về, kèm những lời chỉ bảo không ai cần của [[character/1]]. [[character/2]] cắt ngang cuộc đoàn tụ. Một vòng đàm phán tại [[station/10]] có thể kéo thêm nhiều trạm về phe, và phi công cùng [[character/5]] sẽ hộ tống bà và [[character/3]] đến đó. Phi công không mấy hào hứng khi phải ra khơi cùng [[character/3]], nhưng [[character/2]] bảo đảm cho tay nghề của anh ta và không lường trước điều gì tệ hơn cướp biển.", false],
		[25, "", "Trong [[chapter/25]], đoàn đến [[station/10]] và lập tức cảm thấy có điều gì đó không ổn. [[character/9]] đang chờ sẵn cùng lực lượng người định cư và ra lệnh tấn công, và [[character/2]] không hiểu sao hắn biết họ sẽ đến.", false],
		[26, "Hồi IV: Phản bội", "Trong trận đánh, [[character/3]] không nổ súng, khai rằng vũ khí của anh ta bị hỏng rồi bỏ chạy, vừa chạy vừa xin lỗi. Những người còn lại sống sót. [[character/2]] nghi có kẻ phá hoại, trong khi [[character/5]] công khai buộc tội [[character/3]] phản bội; [[character/2]] bênh vực anh ta, nói rằng anh ta luôn trung thành với bà. Phi công thừa nhận sự việc trông đáng ngờ, nhưng giục mọi người rời đi trước khi [[character/9]] kịp điều thêm tàu đến.", false],
		[26, "", "Cả nhóm tản ra. [[character/2]] đi ẩn náu, còn [[character/5]] duy trì công việc của phong trào tại [[station/9]]. Phi công được dặn phải trở thành một chiến binh giỏi hơn nhiều trước khi họ gặp lại, vì giờ đã rõ rằng chỉ ngoại giao thôi có thể không đủ để thắng cuộc đấu tranh. Trong [[chapter/26]], phi công săn cướp biển và các kẻ thù khác để tăng số tàu hạ được.", false],
		[27, "", "Khi phi công đã trở nên nguy hiểm hơn, [[character/3]] bất ngờ gọi đến. Anh ta hỏi thăm [[character/2]] và [[character/5]], khẳng định đã thu thập được thông tin quan trọng trong thời gian vắng mặt và đề nghị gặp gần [[station/11]]. [[character/1]] chắc chắn đó là một cái bẫy, và phi công đồng ý, rồi vẫn đi ([[chapter/27]]).", false],
		[28, "", "Cái bẫy là thật. [[character/3]] đang giam giữ [[character/2]] và đòi phi công đầu hàng, trong khi [[character/2]] giục phi công mặc kệ bà. Theo lời khuyên của [[character/1]], phi công kéo dài cuộc nói chuyện với [[character/3]] trong lúc máy tính quét tàu của hắn. [[character/3]] thản nhiên thừa nhận hắn đổi phe vì tiền: [[character/2]] trả công bèo bọt, còn [[character/9]] đã treo một khoản thưởng lớn cho cả bà lẫn phi công. Khi phi công viện đến lý tưởng của phong trào, [[character/3]] đáp rằng lý tưởng không mang lại cơm ăn.", false],
		[28, "", "Kết quả quét cho thấy một con tàu một chỗ ngồi, vậy [[character/2]] hẳn bị nhốt trong khoang hàng bọc giáp dày của nó. Phi công nổ súng. [[character/3]] tỏ ra nhanh nhẹn và nguy hiểm, nhưng tàu của hắn bị phá hủy, và phi công dùng lao móc thu hồi thùng hàng trước khi nó chìm quá sâu. Trong [[chapter/28]], phi công chở nó đến [[station/12]], trạm an toàn gần nhất, với hy vọng [[character/1]] đoán đúng thứ bên trong.", false],
		[29, "", "[[character/1]] đã đúng. [[character/2]] bước ra, run rẩy nhưng không bị thương, và cảm ơn phi công đã cứu mạng bà. Không có thời gian nghỉ ngơi: trước khi bị bắt cóc, bà đang tổ chức đưa một nhóm nhà khoa học tài năng đến [[station/14]], và có thể [[character/3]] đã tiết lộ chi tiết. Bà chưa chịu giải thích vì sao các nhà khoa học lại quan trọng, và cử phi công hộ tống đoàn tàu của họ vượt qua vùng biên giới an toàn ([[chapter/29]]). Gần [[station/13]], phi công thấy đoàn tàu đã bị tấn công dữ dội và đang kêu cứu.", false],
		[30, "", "Đoàn tàu vượt qua được, và thủy thủ đoàn ghi công phi công đã giúp họ sống sót. [[character/2]] trả 5.000 $ và triệu tập một cuộc gặp tại [[station/14]], nơi bà hứa sẽ giải thích những gì tiếp theo ([[chapter/30]]).", false],
		[31, "Hồi V: Ba bước", "Tại [[station/14]], [[character/5]], [[character/4]] và [[character/2]] đang chờ, và cuối cùng [[character/2]] cho phi công biết kế hoạch của bà. Các cuộc đụng độ với người định cư ngày càng thường xuyên và quân nổi dậy vẫn yếu thế về quân số, nên bà đã đưa [[world/abel|Giáo sư Abel]] và nhóm của ông đến trạm để chế tạo một vũ khí có thể xoay chuyển cán cân. Dự án gồm ba bước. Bước đầu tiên là một nguồn năng lượng, [[world/biotek|máy phát Biotek]], một công nghệ được nghiên cứu nhiều năm mà chưa từng cho ra một nguyên mẫu hoạt động được. Abel đã gần hoàn thành một chiếc thì người định cư đánh cắp nó, và giờ họ đang tự tìm cách hoàn thiện nó.", false],
		[31, "", "[[character/2]] rời đi để gặp Abel, và [[character/5]] tiếp tục phần chỉ thị. Một người cung cấp tin báo rằng máy phát đang được chở về phía Maarth trên những tàu chở hàng bình thường để tránh bị chú ý, tạo cơ hội cho quân nổi dậy ra tay gần [[station/2]]. Không ai biết tàu nào chở nó, nên phải chặn cả đoàn tàu và thu hồi mọi thùng hàng, dù muốn hay không. Trong [[chapter/31]], phi công, [[character/5]] và [[character/4]] chặn đoàn tàu. Thủy thủ đoàn van nài rằng họ chỉ chở lương thực và thuốc men, và [[character/4]] đáp rằng quân nổi dậy đang rất cần cả hai thứ đó.", false],
		[32, "", "Mọi thùng hàng đều được thu hồi, và trong [[chapter/32]] cả nhóm mang chiến lợi phẩm về [[station/14]].", false],
		[33, "", "Abel mang số hàng về phòng thí nghiệm để làm tiếp nguyên mẫu, và [[character/2]] giao nhiệm vụ mới. [[character/5]] sẽ tuần tra bên ngoài trạm phòng tấn công bất ngờ, [[character/4]] được cần đến ở xưởng tàu, còn phi công nhận bước thứ hai. Máy phát cần một vũ khí xứng với công suất của nó, và [[character/2]] đã chọn [[equipment/42]], một [[world/eclipse|khẩu pháo phòng thủ cố định]] mà nhu cầu năng lượng khổng lồ cho đến nay vẫn khiến nó chưa từng được lắp lên tàu nào.", false],
		[33, "", "Trạm gần nhất sản xuất loại pháo này, [[station/188]], nằm trong tay người định cư, nên [[character/2]] cử phi công đến trạm [[station/15]] của quân nổi dậy thay vào đó. Vũ khí này không được bán ở đâu cả, và kế hoạch của bà dừng lại ở đó. Bà chỉ đơn giản giao 100.000 $ cho bất kỳ khoản đút lót nào cần đến. Phi công gọi đó là kế hoạch mơ hồ nhất từng nghe và vui vẻ nhận lời, và [[chapter/33]] đưa phi công đến trạm để dò la.", false],
		[34, "", "Không có người quen và cũng chẳng có kế hoạch thực sự, phi công bắt đầu bằng việc xem hàng của thương nhân địa phương. Trong [[chapter/34]], manh mối dẫn đến một chuyến hàng [[goods/37]], một loại ma túy bị cấm trên trạm.", false],
		[35, "", "Vụ giao dịch thu hút [[character/8]], một tay buôn chợ đen luôn nói về bản thân ở ngôi thứ ba và khẳng định có thể cung cấp hầu như mọi thứ. Khi được hỏi mua [[equipment/42]], hắn sửng sốt và tự hỏi liệu phi công có định gây chiến không. Dù vậy, hắn đồng ý thử, đổi lại một việc: cái chết của [[character/11]], thợ săn tiền thưởng được cơ quan an ninh thuê để trừ khử [[character/8]]. Trong [[chapter/35]], phi công tìm thấy [[character/11]] đang tuần tra gần trạm cùng đội hộ tống riêng. Hắn gạt phi công đi như một gã đánh cá tầm thường.", false],
		[36, "", "Khi trận đánh trở nên bất lợi, [[character/11]] tìm cách dùng lời lẽ để thoát thân, nhưng tàu của hắn bị phá hủy. Phi công trở về [[station/15]] trong [[chapter/36]], hy vọng tay buôn sẽ giữ lời.", false],
		[37, "", "[[character/8]] giữ lời. Hắn đã lần ra một khẩu [[equipment/42]] và sẽ bán nó, với giá bị đội lên vì những khoản đút lót mà hắn nói đã chi. Khi được hỏi làm sao có được khẩu pháo như vậy, hắn nêu tên người bán: [[character/9]]. [[character/1]] khoái chí trước sự trớ trêu khi lòng tham của [[character/9]] lại đang vũ trang cho những kẻ thù tồi tệ nhất của hắn. Trong [[chapter/37]], phi công mua khẩu pháo và đưa nó lên tàu.", false],
		[38, "", "Với khẩu pháo trong khoang hàng, bước thứ hai đã hoàn tất, và trong [[chapter/38]] phi công trở về [[station/14]] để xem nguyên mẫu tiến triển ra sao.", false],
		[39, "", "[[character/2]] không muốn biết khẩu pháo được kiếm bằng cách nào và chỉ mong không có máu đổ; phi công thận trọng trả lời rằng không có người vô tội nào phải chết. Nguyên mẫu gần hoàn tất, nhưng còn thiếu một thiết bị nhỏ không thể làm ở trạm: một [[goods/36]], thứ sao chép vật chất di truyền của các hạt tảo và nhờ đó khởi động phản ứng cung cấp năng lượng cho máy phát. [[character/2]] thừa nhận bà chỉ đang nhắc lại lời giải thích của Abel. Khi phi công mỉa mai gọi thiết bị này là bước thứ ba để chinh phục cả hành tinh, bà gay gắt bác bỏ ý đó.", false],
		[39, "", "Chỉ [[station/16]] có thiết bị để làm lồng ấp, nên [[chapter/39]] đưa phi công đến đó cho bước thứ ba. [[character/1]] than phiền rằng có vẻ phi công đang một mình gánh cả cuộc nổi dậy.", false],
		[40, "", "Tại trạm, rõ ràng việc làm lồng ấp sẽ chẳng hề đơn giản, và [[chapter/40]] trở thành một công việc sản xuất đầy thử thách.", false],
		[41, "", "Lồng ấp đã hoàn thành, khiến [[character/1]] ngạc nhiên ra mặt. Vẫn chưa chắc tất cả những việc này có đúng đắn không, phi công chở nó đến [[station/14]] trong [[chapter/41]].", false],
		[42, "", "[[character/5]] vui mừng đón phi công và lồng ấp, trong khi [[character/1]] tuyên bố sẽ tự tắt máy cho khỏi phải nghe. Abel đã chuẩn bị sẵn mọi thứ, và [[equipment/42]] sẽ sớm có trong xưởng tàu. [[character/2]] muốn thử khẩu pháo với cướp biển ngay, và [[character/5]] chuyển tọa độ kèm lời cảnh báo rằng máy phát vẫn chỉ là nguyên mẫu. [[character/1]], được cho là đang ở chế độ chờ, tỏ rõ rằng nó nghe thấy từng lời.", false],
		[42, "", "Trong [[chapter/42]], phi công lắp khẩu pháo và tấn công một sào huyệt cướp biển gần [[station/17]]. Bọn cướp biển sớm nhận ra mình đang đối mặt với thứ gì và gọi tiếp viện.", false],
		[43, "Hồi VI: Cuộc chiến giành đại dương", "Cuộc thử bị cắt ngang bởi một tín hiệu cầu cứu từ [[station/14]], phát công khai trên một kênh không mã hóa. Phi công vội vã quay về trong [[chapter/43]] và thấy trạm đang bị người định cư tấn công bất ngờ. Nhiều bến tàu bị trúng đòn, quá ít tàu của quân nổi dậy có thể xuất kích, và [[character/2]] tin rằng ngày tàn đã đến. [[character/9]] dẫn đầu cuộc tấn công và chế nhạo phi công vì đi đánh cá thuê cho quân nổi dậy, cho đến khi hắn biết [[equipment/42]] sắp khai hỏa.", false],
		[44, "", "Giữa trận chiến, [[world/aquarians|người Aquarian]] xuất hiện và lao vào đánh người định cư, chiến đấu bên phía quân nổi dậy. Cuộc tấn công sụp đổ, và [[character/9]] đào ngũ ngay khi thấy đã thua. [[character/2]] gọi cuộc giải cứu là một phép màu và yêu cầu phi công cập bến, hứa hẹn một vị khách đặc biệt ([[chapter/44]]).", false],
		[45, "", "[[character/2]] thừa nhận cuộc tập kích khiến quân nổi dậy trở tay không kịp, vì không ai ngờ người định cư lại đánh sâu đến thế vào vùng nước của quân nổi dậy, và rằng trận phòng thủ không phải công của riêng họ. Vị khách là một đại biểu người Aquarian hiểu đôi chút tiếng nói của loài người. Thông qua ông, người Aquarian đề nghị giúp chấm dứt sự thống trị của người định cư. Một khi mọi trạm đã bị chiếm và hạm đội người định cư bị đánh bại, mọi người sẽ sống hòa hợp với thiên nhiên.", false],
		[45, "", "Với sự giúp đỡ của người Aquarian, [[character/2]] lên kế hoạch cho hai cuộc tổng tấn công lớn nhằm chiếm các trạm còn lại ở bán cầu bắc và bán cầu nam. [[station/188]] đã thất thủ, và quân nổi dậy đang lắp [[equipment/42]] cho càng nhiều tàu càng tốt. Để tận dụng yếu tố bất ngờ khi còn có thể, bà giao cho phi công chỉ huy cuộc tấn công vào [[station/18]] và cử [[character/5]] đánh [[station/109]]. Khi phi công lo lắng cho [[character/5]], [[character/2]] trêu tình cảm lộ liễu của phi công và chỉ ra rằng chính [[character/5]] cũng là một phi công giỏi.", false],
		[45, "", "Trong [[chapter/45]], phi công đến nơi và thấy [[character/12]], chỉ huy biệt đội Atmos, đang chờ lệnh tấn công, trong khi một nhóm người Aquarian trồi lên từ đáy sâu. Mọi tàu của người định cư đều phải bị tiêu diệt, kể cả tàu chở hàng.", false],
		[46, "", "Quân phòng thủ bị quét sạch. Phi công cử một nửa biệt đội của [[character/12]] tuần tra quanh trạm và cập bến cùng số còn lại trong [[chapter/46]]. Cùng lúc đó, một làn sóng lớn các trạm đổi phe, từ [[station/1]] và [[station/2]] đến [[station/11]], [[station/18]] và [[station/109]].", false],
		[47, "", "[[character/5]] gọi đến báo rằng cuộc tấn công của cô cũng thành công và [[equipment/42]] đã tỏ ra có sức hủy diệt khủng khiếp; phi công cũng ghi công người Aquarian không kém. Mọi trạm phía nam nay đã nằm trong tay quân nổi dậy. [[character/2]] đã gửi tin về nhiệm vụ có lẽ là cuối cùng: [[station/0]], thành trì lớn cuối cùng của người định cư và là trạm nơi câu chuyện của phi công bắt đầu. Trạm được phòng thủ kiên cố, và [[character/2]] đã lên đường để đích thân chỉ huy cuộc tấn công. [[character/5]] theo sau, bị cướp biển cản đường làm chậm trễ, và trong [[chapter/47]] phi công cùng họ bước vào trận chiến cuối cùng.", false],
		[47, "", "[[character/9]] chỉ huy phòng thủ và khoác lác rằng hắn sẽ khoái trá khi phá hủy tàu của phi công, điều mà phi công nhận ra là lời lặp lại những câu cuối cùng của [[character/3]]. Khi biết ai đã giết [[character/3]], [[character/9]] tìm cách làm phi công rối trí bằng cách tự nhận là cha của phi công, còn [[character/3]] là anh em ruột của phi công. Phi công, người không có anh em nào và vẫn nhớ rõ khuôn mặt cha mình, lập tức gạt bỏ lời dối trá.", false],
		[48, "", "Hạm đội người định cư lần lượt gục ngã từng chiếc cho đến khi chỉ còn lại [[character/9]]. Hắn nhanh nhẹn và khó bắn trúng, nhưng theo lời khuyên của [[character/1]], phi công né các đòn tấn công của hắn và đánh từ phía sau. [[character/9]] trốn thoát trong một khoang cứu hộ và, trước sự sửng sốt của [[character/5]], dường như kéo theo cả trạm. Trước khi đi, hắn buông lời khinh miệt rằng dưới đáy sâu chẳng có gì đáng giá và hắn vốn chẳng bao giờ ưa cá.", false],
		[48, "", "Khi [[character/9]] đã đi, chiến tranh kết thúc, và trong [[chapter/48]] [[station/0]] cùng những trạm cố thủ cuối cùng gia nhập phong trào. Phi công khẳng định chiến thắng thuộc về tất cả mọi người. [[character/1]] đòi phần công lao của mình và được hứa nâng cấp bộ nhớ khi phi công trở lại đất liền, điều mà nó phẫn nộ tuyên bố là không cần. [[character/2]] cảm ơn tất cả và thừa nhận rằng vết thương của hành tinh sẽ cần rất lâu để lành, nhưng bà tin họ cũng sẽ làm được. [[character/5]] mời phi công ăn mừng bên [[goods/21]], và phi công vui vẻ nhận lời.", false],
		[48, "Chủ đề", "Xung đột trung tâm xoay quanh câu hỏi biển cả nên được sử dụng ra sao. Thuộc địa coi biển là nguồn tài nguyên để khai thác và chuyển lên quỹ đạo: nó thu mua mẻ cá theo giá cố định và tiêu diệt những loài vật cản đường. Phong trào chủ trương chỉ lấy những gì biển có thể cho, bảo vệ sự đa dạng sự sống của biển và tự do buôn bán. Những công việc đầu tiên của phi công, cuộc tàn sát ốc anh vũ và trận bảo vệ khoang vận chuyển, cho thấy cách làm của thuộc địa từ bên trong. Chính nỗi bất an ngày càng lớn của phi công với những việc đó khiến bước ngoặt sang phía kháng chiến trở nên thuyết phục.", false],
		[48, "", "Người Aquarian đi theo cùng một hành trình. Ban đầu họ xuất hiện như loài gây hại tấn công các khoang của thuộc địa, và phi công được trả tiền để đánh đuổi họ. Về sau họ được thấy đang trông chừng các sinh vật biển, và tại [[station/14]] họ xoay chuyển một trận chiến tưởng đã thua. Nhìn lại, những cuộc tập kích ban đầu của họ giống như một cuộc kháng cự riêng chống lại việc cướp bóc đại dương, dù trò chơi phần lớn để người chơi tự suy đoán động cơ của họ.", false],
		[48, "", "Tiền bạc và lòng trung thành xuyên suốt câu chuyện. [[character/3]] phản bội phong trào vì tiền thưởng, còn [[character/9]] bán chính khẩu pháo sau này đập tan cuộc tấn công của hắn vào [[station/14]]. Phi công khởi đầu chỉ mong có đủ tiền mua vé về nhà và kết thúc với tư cách một trong những chỉ huy của phong trào, trong khi những lời phàn nàn về tiền công ít ỏi của [[character/1]] trở thành một trò đùa lặp đi lặp lại chứ không phải động cơ.", false],
		[48, "", "Phong trào giành được phần lớn chỗ đứng ban đầu nhờ thuyết phục, và trận phục kích tại [[station/10]] đánh dấu thời điểm thuyết phục thôi không còn đủ. Chiến dịch sau đó khép lại vòng tròn tại [[station/0]], trạm nơi [[character/9]] từng trả cho phi công giá cố định cho mẻ cá. Sau chương cuối, phi công vẫn tự do đánh cá, buôn bán và nhận hợp đồng khắp một đại dương nay đã đứng về phía quân nổi dậy.", false],
	],
	"world/ocean": [
		[1, "", "Đại dương là bối cảnh của DEEP: một hành tinh có thế giới sinh sống nằm sâu dưới những con sóng. Người định cư sống trong các trạm điều áp ở độ sâu hàng nghìn mét, và tàu ngầm là phương tiện duy nhất để đi lại giữa chúng. Mọi thứ thuộc địa ăn, bán và xây dựng đều đến từ nước, từ cá và tảo đến những mặt hàng làm từ chúng. Bài viết này mô tả đại dương như một nơi chốn: độ sâu, ánh sáng, động vật hoang dã và cách sự sống ấy phản ứng với những con người săn bắt nó.", false],
		[1, "", "Phi công đến đây như một người mới với chiếc tàu ngầm đánh cá nhỏ và máy tính trên tàu [[character/1]], và chẳng bao lâu đã ước giá mà mình đừng đến. Về những người điều hành các trạm, xem [[world/colony]]; về việc đi lại giữa các trạm, xem [[world/stream]].", false],
		[1, "Độ sâu và áp suất", "Độ sâu là đặc điểm quyết định của đại dương. Không có đáy biển nào chặn đường lặn: tàu ngầm có thể chìm mãi cho đến khi bị nước nghiền nát. Thứ giữ cho tàu sống sót là một dải độ sâu an toàn do trang bị quyết định. Khiên quyết định tàu có thể lên cao đến đâu, còn giáp quyết định tàu có thể xuống sâu đến đâu. Một thân tàu không có cả hai chỉ an toàn trong một lớp nước hẹp, khoảng 22.000 đến 23.000 m.", false],
		[1, "", "Ra ngoài dải của mình, tàu bị áp suất ép chặt. Sau vài giây ân hạn, nước bắt đầu bào mòn lớp bảo vệ của tàu, hết lớp này đến lớp khác rồi đến chính thân tàu, và hư hại càng tăng khi tàu càng đi xa khỏi mốc 15.000 m phía trên hoặc 30.000 m phía dưới. Những chuyến ra ngoài ngắn thì có thể sống sót; những chuyến dài thì không. Số liệu của từng món trang bị nằm trên trang riêng của nó, và [[guide/depth]] giải thích đầy đủ các quy tắc.", false],
		[1, "Vị trí các trạm", "Hai trăm trạm trên [[chart]] được neo ở độ sâu cố định, gần như tất cả nằm trong khoảng 15.000 đến 30.000 m. Hơn một nửa, tổng cộng 109 trạm, nằm trong khoảng 20.000 đến 25.000 m, dải mà [[ship/0]] khởi đầu có thể đến được. Khoảng năm mươi trạm nằm nông hơn và khoảng bốn mươi lăm trạm sâu hơn. Những trường hợp ngoại lệ là [[station/28]], cao nhất ở 13.500 m, và [[station/81]], sâu nhất ở 32.250 m.", false],
		[1, "", "Độ sâu không theo địa lý. Trạm nông và trạm sâu nằm cạnh nhau khắp hải đồ, nên những trạm láng giềng trên bản đồ có thể cách nhau hàng nghìn mét theo chiều thẳng đứng. [[station/14]], gần trung tâm hải đồ, nằm trong tầm dễ dàng đến cả [[station/25]] ở 17.700 m lẫn [[station/81]] ở sâu bên dưới. Phi công khi lập lộ trình phải xem độ sâu của từng trạm, chứ không chỉ khoảng cách. [[station/0]], nơi sự nghiệp của phi công bắt đầu, nằm ở phía tây bắc, ở độ sâu 22.500 m.", false],
		[1, "Ánh sáng và nước", "Ánh sáng ban ngày không chạm tới các trạm. Bên ngoài lớp vỏ được đèn pha chiếu sáng của chúng, nước tối đen, và tàu ngầm di chuyển nhờ chùm sáng hình nón từ đèn pha của chính nó, thứ ánh sáng bị nước nuốt chửng chỉ sau vài chục mét. Những hạt li ti lơ lửng và trôi dạt trong chùm sáng, và đây đó những mảng sinh vật phù du phát quang mờ nhạt tỏa sáng trong bóng tối. Việc lên cao hơn 15.000 m, hướng về phía mặt biển xa xôi, được ghi nhận như một thành tích riêng, [[medal/21]].", false],
		[1, "", "Nước không cùng một màu ở mọi nơi. Mỗi vùng mang một sắc thái nhạt từ sinh vật phù du và tảo phát triển mạnh ở đó, đậm nhất gần những trạm mà các loài tảo ấy ưa sống nhất. Những dòng chảy chậm khuấy động các hạt lơ lửng, nhưng chúng chỉ là một phần của cảnh vật: chúng không bao giờ đẩy tàu ngầm chệch hướng hay cuốn mất con mồi.", false],
		[1, "Sinh vật biển", "Đại dương là nơi sinh sống của mười ba loài động vật và năm loại tảo. Chúng trải từ những con mồi nhỏ, dễ bắt như [[species/2|sứa]], [[species/0|ốc anh vũ]] và [[species/4|đàn cá]] đến những tay bơi khỏe như [[species/7]] và [[species/8]]. Những sinh vật kỳ lạ của biển sâu gồm [[species/5]], [[species/1]], [[species/6]], [[species/9]] và [[species/11]] bọc giáp. [[species/3]] và [[species/10]] đổi màu được săn lùng để lấy da và làm sơn.", false],
		[1, "", "Loài vật lớn nhất là [[species/12]], có thể nặng khoảng 30 t, hơn cả toàn bộ khoang hàng của một chiếc tàu ngầm nhỏ. Những con vật nặng hơn và dai sức hơn vùng vẫy lâu hơn trên lao móc và thường bán được giá hơn, nhưng không loài nào có giá như nhau ở mọi nơi. Trang của mỗi loài liệt kê những trạm có vùng nước nơi nó sinh sống và các mặt hàng làm từ nó.", false],
		[1, "", "Mỗi trạm có tổ hợp động vật hoang dã riêng, thường gồm năm hoặc sáu loài. Vào bất kỳ thời điểm nào cũng có khoảng hai mươi con vật bơi trong vùng nước của một trạm, lấy từ tổ hợp địa phương ấy. Người đánh cá sớm học được nên đến trạm nào để bắt loài nào, và bản đồ có thể cho thấy nơi tìm thấy từng loài đã từng bắt được. Xem [[guide/fishing]].", false],
		[1, "Đáy biển và tảo", "Năm loại tảo, [[species/17|tảo lục]], [[species/16|tảo đỏ]], [[species/15|tảo nâu]], [[species/14|tảo lam]] và [[species/13|tảo vàng]] quý giá, là thực vật của đại dương. Chúng mọc bám cố định chứ không bơi, mỗi cây nặng cố định 2 t, và gần như đầu hàng ngay khi trúng lao móc. Giá trị của chúng nằm ở những gì chúng trở thành: [[goods/21]] cần tảo lục, [[goods/27]] cần tảo vàng và tảo đỏ, còn [[goods/28]] cần một ít của cả năm loại.", false],
		[7, "", "Tảo cũng mọc trên bề mặt bên ngoài của chính các trạm, cùng với những sinh vật nhỏ khác. Chúng là món ăn ưa thích của ốc anh vũ, đó là lý do những con vật này tụ tập đông đúc quanh các trạm.", false],
		[1, "Thế giới sống phản ứng ra sao", "Động vật không chỉ đơn giản chờ bị bắt. Một sinh vật bị thương, do trúng đạn hay một phát bắn lạc, sẽ hoảng sợ bỏ chạy, còn con bị mắc lao móc thì vùng vẫy cho đến khi kiệt sức. Một con vật bị giết ngay lập tức coi như mất: xác của nó nổi lên và chỉ có thể kéo về dưới dạng [[goods/18]], chỉ đáng một phần nhỏ giá trị của con vật còn sống. Những phi công muốn có mẻ cá nguyên vẹn luôn giữ súng tránh xa đàn cá.", false],
		[1, "", "Khi chơi, vùng nước không bao giờ bị đánh bắt cạn kiệt. Khi phi công rời đi, động vật hoang dã bị bỏ lại sẽ được thay thế, nên một ngư trường tốt vẫn luôn tốt. Thay vào đó, cuộc tranh giành sự sống của biển hiện lên trên bảng hợp đồng, nơi một số bên đặt hàng trả tiền để săn lùng một loài, còn những bên khác trả tiền để bảo vệ một đàn động vật khỏi thợ săn. Xem [[contract/7]] và [[contract/6]].", false],
		[4, "", "Ngay từ khi phi công có súng, [[character/1]] đã cảnh báo không được bắn vào chính những con cá mà họ đến để bắt.", false],
		[7, "", "Thuộc địa coi động vật hoang dã cản đường là phiền toái cần loại bỏ. Trong [[chapter/7]], phi công được cử đi dọn sạch ốc anh vũ khỏi vùng nước của [[station/1]], nơi chúng bị cho là chặn các tuyến đoàn tàu.", false],
		[9, "", "Cuộc tàn sát chẳng đạt được bao nhiêu. Viên chức trả tiền cho việc này thừa nhận rằng dù bị loại bỏ bao nhiêu con, lũ vật vẫn cứ quay lại.", false],
		[15, "", "[[faction/rebels]] nhìn biển cả theo cách khác. Họ chỉ khai thác những gì biển có thể cho, chế biến mẻ cá thành hàng hóa và cẩn thận không đánh bắt quá mức, nhằm bảo tồn sự đa dạng sự sống trong đại dương.", false],
		[19, "", "Trong [[chapter/19]], phi công bảo vệ một đàn [[species/10|mực đổi màu]] gần [[station/7]] khỏi thợ săn của người định cư. Người Aquarian bơi cùng những con vật, dường như đang trông chừng chúng; xem [[world/aquarians]].", false],
		[21, "", "Theo người lãnh đạo quân nổi dậy [[character/2]], quá trình thuộc địa hóa nhanh chóng đang vắt kiệt đại dương nhanh hơn khả năng phục hồi của cây cỏ và động vật. Bà cảnh báo rằng nếu cứ tiếp diễn, hành tinh sẽ bị vắt kiệt, như những thế giới khác trước nó.", false],
		[48, "", "Khi bộ máy cai trị thuộc địa không còn vào cuối cuộc chiến, quân nổi dậy dự đoán đại dương sẽ cần rất lâu để hồi phục, nhưng họ quyết tâm theo đuổi đến cùng.", false],
		[1, "Hiểm họa của đáy sâu", "Ngoài áp suất, đại dương còn chứa những hiểm họa do con người gây ra. [[faction/pirates]] săn những con tàu đơn độc ngoài vùng nước mở, và ở các chương sau, một số còn phục sẵn gần các trạm. Bãi thủy lôi, mảnh vụn trôi nổi và các đoàn tàu vũ trang xuất hiện trong các hợp đồng và trong cốt truyện. Về việc ai kiểm soát phần nào của đại dương, xem [[world/colony]] và [[guide/allegiance]].", false],
	],
	"world/stream": [
		[1, "", "Mạng lưới S.T.R.E.A.M. là hệ thống cổng chuyển tiếp kết nối các trạm của thuộc địa với nhau. Mỗi trạm có một cổng cách trạm một quãng, và tàu ngầm đi vào một cổng sẽ gần như lập tức xuất hiện tại cổng của một trạm khác. Không có mạng lưới, vượt qua [[chart]] đồng nghĩa với những chuyến đi dài qua vùng nước mở tối tăm. Có nó, một phi công đơn lẻ có thể làm việc trên khắp đại dương. Mạng lưới vừa là một phần trung tâm của lối chơi vừa là một yếu tố cố định của bối cảnh; về cách điều khiển, xem [[guide/navigation]].", false],
		[1, "Các cổng", "Mỗi trạm có cổng nằm ngoài vùng nước mở, cách xa các bến tàu. Tàu rời khu vực của một trạm qua cổng của nó và đến cổng của trạm đích, rồi từ đó chạy vào cập bến. Cổng được mở từ cự ly gần: phi công lái vào khu vực kích hoạt của cổng và mở hải đồ cổng, liệt kê mọi trạm trong tầm.", false],
		[1, "", "Bản thân chuyến đi gần như tức thời. Tàu xuất hiện ở cổng bên kia với mức hư hại giữ nguyên, nên một chiếc tàu ngầm tơi tả vẫn tơi tả khi đến nơi. Động vật hoang dã địa phương, tàu tuần tra và bất kỳ cuộc chạm trán nào đang chờ ở trạm đích đều đã có sẵn dưới nước.", false],
		[1, "Tầm xa và động cơ", "Một cổng không vươn tới toàn bộ đại dương. Từ bất kỳ trạm nào, nó bao quát khoảng một phần sáu bề rộng hải đồ. Động cơ tốt hơn mở rộng tầm theo tỷ lệ với chỉ số của nó, nên động cơ +30% vươn xa thêm khoảng ba mươi phần trăm. Những trạm ngoài tầm cần nhảy nhiều chặng, hoặc một chuyến đi dài bằng lái tự động, chậm hơn nhiều ngay cả khi tăng tốc thời gian.", false],
		[1, "", "Đi lại qua vùng nước mở vẫn hữu ích cho những chuyến ngắn. Chế độ lái tự động đi từ khu vực của một trạm sang khu vực tiếp theo, và trong lúc đó tăng tốc thời gian có thể lên đến mười sáu lần tốc độ bình thường, rồi giảm xuống khi gặp nguy hiểm.", false],
		[1, "", "Mạng lưới không tính đến độ sâu. Sau một lời cảnh báo, cổng vẫn sẵn lòng đưa tàu đến một trạm nằm ngoài dải độ sâu an toàn của nó, và áp suất bắt đầu bào mòn lớp bảo vệ ngay khi tàu đến nơi. Hãy kiểm tra độ sâu của điểm đến trên trang trạm trước khi khởi hành. Xem [[guide/depth]].", false],
		[1, "Cổng và các cuộc chạm trán", "Cổng bị đóng khi đang có giao tranh. Nếu một cuộc chạm trán nhiệm vụ đang diễn ra trong vùng nước của trạm, cả cổng lẫn bến tàu đều không dùng được cho đến khi nó được giải quyết. Phi công không thể đơn giản thoát khỏi một cuộc phục kích qua mạng lưới, và mọi hợp đồng đều phải được chiến đấu đến cùng hoặc thất bại.", false],
		[1, "", "Việc đến qua cổng cũng là lúc rắc rối bắt đầu. Đi vào khu vực của một trạm sẽ kích hoạt bất kỳ cuộc chạm trán nào đang chờ ở đó, từ một tên tội phạm bị truy nã đến một đoàn tàu cần được bảo vệ. Tàu tuần tra đi tuần qua các cổng, và ở các chương sau, cướp biển có thể đang chờ sẵn gần trạm.", false],
		[1, "Tên gọi", "Tên của mạng lưới luôn được viết dưới dạng viết tắt, S.T.R.E.A.M., nhưng trò chơi không bao giờ cho biết các chữ cái ấy đại diện cho gì. Phi công và [[character/1]] coi các cổng là một phần bình thường của cuộc sống, giống như đường sá hay đường sắt.", false],
		[1, "Vai trò trong thuộc địa", "Mạng lưới là thứ gắn kết thuộc địa. Nó biến hai trăm trạm rải rác thành một nền kinh tế thống nhất: một mẻ cá có thể được bán ở nơi xa chỗ đánh bắt, và một hợp đồng có thể dẫn phi công đi khắp hải đồ. Mỗi lần đến một trạm mới được tính vào [[medal/13]], và lần cập bến đầu tiên ở mỗi trạm được tính vào [[medal/6]].", false],
		[5, "Trong câu chuyện", "Phi công được làm quen với các cổng từ sớm, khi cuộc săn cướp biển đầu tiên đưa phi công ra khỏi [[station/0]]. Từ đó, hầu như mọi chuyến đi trong câu chuyện đều đi qua chúng, và chế độ lái tự động có thể đưa tàu đến cổng địa phương theo yêu cầu.", false],
		[12, "", "Các cổng không tôn trọng biên giới chính trị. Khi phi công lần đầu đi đến phong trào kháng chiến tại [[station/3]], tàu đến vùng nước mà quân nổi dậy gọi là trung lập và lập tức bị lính gác của trạm chặn hỏi.", false],
		[21, "", "Các chiến dịch của quân nổi dậy tận dụng các cổng. Trong nhiệm vụ đánh băng cướp biển gần [[station/8]], [[character/3]] chờ phi công gần cổng của trạm trước khi dẫn đầu cuộc tấn công.", false],
		[45, "", "Trong cuộc tấn công vào [[station/18]], biệt đội của [[character/12]] chờ sẵn ở vị trí gần cổng, để cuộc tấn công có thể bắt đầu ngay khi phi công đến.", false],
	],
}
