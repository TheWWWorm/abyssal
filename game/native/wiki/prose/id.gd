const BLOCKS := {
	"chapter/1": [
		[1, "Sinopsis", "Kampanye dibuka di laut. Sang pilot, pendatang baru di planet samudra yang bekerja sebagai nelayan untuk koloni, sedang berlayar dengan kapal selam kecil bersama [[character/1]], komputer kapal yang cerewet. Bab ini mengajarkan memancing dengan harpun: bidik makhluk, tembakkan harpun, lalu jaga target tetap terlihat selama ia meronta hingga lelah dan bisa ditarik masuk. Lihat [[guide/fishing]].", false],
		[2, "Hasil", "Setelah makhluk pertama tertangkap, M.A.I. memperkenalkan autopilot, yang dapat mengemudikan kapal ke target pilihan, dan mengarahkan sang pilot ke [[station/0]] untuk menjual hasil tangkapan. Lihat [[guide/navigation]].", false],
	],
	"chapter/10": [
		[10, "Sinopsis", "Di [[station/2]] peluncuran kapsul sudah berlangsung dan para Aquarian sedang menyerang. [[character/9]] mengirim peringatan blak-blakan lewat radio: kehilangan lebih dari lima kapsul tidak dapat diterima. Sang pilot harus menangkis para penyerang dan menjaga kapsul tetap utuh.", false],
		[11, "Hasil", "Serangan berhasil dipukul mundur, tetapi sang pilot bertanya-tanya mengapa para Aquarian justru mengincar kapsul. [[character/1]] menduga mereka mungkin jauh lebih cerdas daripada anggapan kolonis. Sang pilot menuju stasiun untuk melapor, semakin ragu dengan pekerjaan semacam ini.", false],
	],
	"chapter/11": [
		[11, "Sinopsis", "Sang pilot berlabuh di [[station/2]] untuk melapor kepada [[character/9]] setelah mempertahankan kapsul.", false],
		[12, "Hasil", "Jack menyalahkan sang pilot atas kapsul yang rusak, membatalkan imbalan, lalu pergi sambil berkata bahwa dirinya ditakdirkan untuk hal yang lebih besar. [[character/1]] kemudian mengangkat pertanyaan yang lebih besar: sang pilot bekerja keras untuk koloni, berpenghasilan kecil, dan tidak punya suara atas hasil tangkapan. Sang pilot hanya ingin cukup uang untuk membeli tiket keluar dari planet ini. M.A.I. mengungkapkan bahwa ia telah menangkap lalu lintas radio dari gerakan perlawanan yang bermarkas di [[station/3]] dan menandai stasiun itu di peta. Mulai sekarang, stasiun perlawanan ditampilkan berwarna hijau.", false],
	],
	"chapter/12": [
		[12, "Sinopsis", "Sang pilot pergi ke [[station/3]] untuk menemukan perlawanan. Upaya mendekat diam-diam langsung gagal: penjaga stasiun menghentikan kapal dan mengancam akan menembak. Sang pilot menyebutkan nama, mengatakan bahwa perjalanan dimulai dari [[station/0]], dan meminta untuk bergabung. Setelah keheningan yang menegangkan, kapal diizinkan berlabuh.", false],
		[13, "Hasil", "Di dalam, [[character/4]] menginterogasi pendatang baru itu. Sang pilot hampir tidak tahu apa-apa selain dukungan gerakan itu terhadap perdagangan bebas, yang sesuai dengan penjelasan Pierre bahwa sandi radio mereka baru saja diaktifkan. Karena kekurangan tenaga, Pierre menerima sang pilot dengan masa percobaan. Gerakan itu berencana memenangkan hati para pemimpin stasiun kolonis dan mengakhiri eksploitasi planet. Tugas pertama adalah menjemput para simpatisan di [[station/4]] dan membawa mereka ke [[station/5]].", false],
	],
	"chapter/13": [
		[13, "Sinopsis", "Sang pilot tiba di [[station/4]] untuk menjemput kontak gerakan itu, masih tanpa gambaran jelas tentang apa perlawanan itu atau apa isi pekerjaannya. [[character/1]] menunjukkan bahwa setidaknya ini lebih menarik daripada menerima perintah dari [[character/9]], dan sang pilot setuju.", false],
		[14, "Hasil", "Kontak itu adalah [[character/5]], ramah, cekatan, dan jelas senang bertemu sang pilot. Ia merahasiakan rencana gerakan itu, dengan alasan bahwa kerahasiaan membuat mereka bertahan selama ini, lalu mengirim koordinat perjalanan. [[character/1]] mengamati keduanya dengan kesal yang terang-terangan, dan sang pilot menggodanya sebagai cemburu.", false],
	],
	"chapter/14": [
		[14, "Sinopsis", "Dengan [[character/5]] di kapal, sang pilot mengantarnya ke [[station/5]] secepat dan seaman mungkin.", false],
		[15, "Hasil", "Di [[station/5]], Leah bersembunyi untuk membereskan beberapa urusan. Sebelum pergi, ia menjelaskan cara kerja pemberontak: mereka hanya mengambil apa yang dapat diberikan laut, mengolah hasil tangkapan menjadi barang, dan berhati-hati agar tidak menangkap ikan berlebihan. Ia meminta sang pilot mencobanya dan memproduksi lima ton barang di pabrik stasiun perlawanan, dengan menyarankan [[station/90]], tempat cumi-cumi dapat ditangkap dan [[goods/35]] dapat dibeli untuk membuat [[goods/22]].", false],
	],
	"chapter/15": [
		[15, "Sinopsis", "Bab tentang produksi. Sang pilot harus memproduksi lima ton barang di pabrik stasiun pemberontak, menggabungkan hasil tangkapan dan bahan yang dibeli menjadi produk yang lebih berharga daripada bahan mentahnya. Lihat [[guide/trading]].", false],
		[16, "Hasil", "[[character/5]] menghubungi kembali. Kini setelah sang pilot punya cara kedua untuk mencari uang, ia memberi tugas baru: mengunjungi sebanyak mungkin stasiun yang belum dikenal. Gerakan itu memakai laporan terbaru dari setiap stasiun untuk menemukan titik lemah dan menarik penduduk ke pihaknya. Ketika sang pilot bertanya apakah ini sebuah revolusi, ia enggan berkata lebih banyak dan menyarankan untuk mengumpulkan uang guna meningkatkan kapal sementara itu.", false],
	],
	"chapter/16": [
		[16, "Sinopsis", "Sang pilot harus menemukan lima stasiun yang belum pernah dikunjungi. Penjelajahan memperluas jaringan dagang dan mengumpulkan informasi untuk gerakan itu. Sebagian stasiun mungkin berada di luar jangkauan kedalaman kapal saat ini. Lihat [[guide/depth]].", false],
		[17, "Hasil", "[[character/4]] mengirim pesan panjang, yang diringkas [[character/1]] menjadi satu inti: sang pilot harus kembali ke [[station/3]] untuk menerima pengarahan.", false],
	],
	"chapter/17": [
		[17, "Sinopsis", "Sang pilot kembali ke [[station/3]] atas permintaan [[character/4]] dan dipersilakan berlabuh.", false],
		[18, "Hasil", "Pierre melaporkan bahwa diplomasi telah memperluas wilayah pemberontak, sehingga sang pilot kini dapat berdagang di jauh lebih banyak stasiun. Berita sudah membicarakan revolusi, dan banyak pengambil keputusan telah bergabung tanpa pertumpahan darah, meski Pierre ragu keadaan akan tetap begitu. Pemimpin gerakan mengatur langkah berikutnya dari salah satu stasiun yang baru direbut dan akan menghubungi sang pilot. Pierre menandai stasiun-stasiun yang mungkin dan memperingatkan bahwa untuk mencapai sebagian di antaranya mungkin diperlukan zirah atau perisai yang lebih baik.", false],
	],
	"chapter/18": [
		[18, "Sinopsis", "Sang pilot harus melacak pemimpin gerakan di antara stasiun-stasiun yang baru direbut, dengan sedikit petunjuk selain keberuntungan. Jejaknya mengarah ke [[station/6]].", false],
		[19, "Hasil", "Di [[station/6]] sang pilot bertemu [[character/2]], yang memimpin gerakan itu dan mulai sekarang akan memberi perintah. Sang pilot mengira pemimpinnya laki-laki, anggapan yang ditepisnya begitu saja. Tugas pertamanya adalah pengawalan: sekawanan [[species/10|gurita]] harus mencapai perairan aman sebelum kolonis menangkap atau membunuh mereka, dan pertempuran kemungkinan besar terjadi. [[character/1]] menggerutu karena tidak ada yang menyebut soal bayaran.", false],
	],
	"chapter/19": [
		[19, "Sinopsis", "Di dekat [[station/7]] sang pilot harus melindungi sekawanan [[species/10]] dari kapal-kapal kolonis sambil berhati-hati agar tidak mengenai hewan-hewan itu. Para Aquarian berenang di samping kawanan itu, dan [[character/1]] bertanya-tanya apakah mereka menjaga makhluk-makhluk laut.", false],
		[20, "Hasil", "Kapal-kapal kolonis mendekati hewan-hewan itu, dan sang pilot harus mencegat mereka sebelum terlalu dekat. Kawanan itu selamat. [[character/2]] membayar imbalan yang sederhana dan meminta sang pilot segera kembali untuk tugas baru. M.A.I. mengeluh bahwa menangkap dan menjual hewan-hewan itu sebenarnya lebih menguntungkan.", false],
	],
	"chapter/2": [
		[2, "Sinopsis", "Dengan ikan di palka, sang pilot menuju [[station/0]], stasiun kolonis yang membeli hasil tangkapan hari itu. Bab ini berupa perjalanan sederhana dan kesempatan pertama untuk berlabuh serta melihat-lihat stasiun.", false],
		[3, "Hasil", "Di [[station/0]] sang pilot bertemu [[character/9]], yang mengurus pembelian hasil tangkapan. Ia membayar harga tetapnya yang biasa, mengejek ukuran palka kargo sang pilot, dan menyarankan bahwa siapa pun yang punya senjata sungguhan bisa mendapat lebih banyak dengan memburu bajak laut. Setelah ia pergi, M.A.I. setuju bahwa orang itu menyebalkan, tetapi menangkap isyaratnya: [[equipment/0]] kebetulan sedang dijual di hanggar. M.A.I. juga menjelaskan bahwa bantuan tersedia di setiap layar stasiun.", false],
	],
	"chapter/20": [
		[20, "Sinopsis", "Sang pilot kembali ke [[station/6]] untuk melapor kepada [[character/2]].", false],
		[21, "Hasil", "Sang pilot akhirnya bertanya kepada Ayumi apa yang diperjuangkan gerakan itu. Ia menggambarkan sebuah kelompok yang bersatu melawan kehancuran planet: kolonisasi yang cepat menguras sumber dayanya lebih cepat daripada kemampuan alam untuk pulih, seperti yang sudah terjadi di dunia lain, dan tujuannya adalah membujuk orang-orang berpengaruh untuk melawan. Sementara itu, [[faction/pirates]] memanfaatkan konflik ini. Ayumi memutuskan untuk menyerang lebih dulu dan mengirim sang pilot melawan sebuah formasi bajak laut bersama [[character/3]], salah satu pilot terbaiknya.", false],
	],
	"chapter/21": [
		[21, "Sinopsis", "Di dekat [[station/8]] sang pilot bergabung dengan [[character/3]] untuk menumpas sebuah geng bajak laut. Sejak awal Raymond tidak sabar dan merendahkan, dan menyuruh si pendatang baru tetap di belakangnya dan belajar.", false],
		[22, "Hasil", "Geng itu dihancurkan. Raymond memuji dengan setengah hati, dan [[character/2]] membayar keduanya dengan imbalan yang sama lalu meminta sang pilot menemuinya di [[station/9]]. Raymond marah karena uangnya dibagi rata dan meremehkan andil sang pilot, dan sang pilot pergi sebelum amarahnya makin menjadi.", false],
	],
	"chapter/22": [
		[22, "Sinopsis", "Sang pilot pergi ke [[station/9]] untuk menemui [[character/2]], yang baru saja menyelesaikan perundingan di sana. Beberapa stasiun, termasuk [[station/9]], kini berpihak pada gerakan itu.", false],
		[23, "Hasil", "Sebelum pergi, Ayumi ingin jalur pasokan ke [[station/37]] diamankan. [[character/9]] telah memasang ladang ranjau tepat di luar stasiun untuk memutusnya. Ayumi mengenalnya: dulu orang tak penting, ia naik dengan cepat berkat koneksi yang berguna. Ayumi memperingatkan bahwa bajak laut kemungkinan berkeliaran di area itu dan bahwa ranjau hanya bisa dihancurkan setelah terpicu.", false],
	],
	"chapter/23": [
		[23, "Sinopsis", "Di luar [[station/9]] sang pilot harus membersihkan ladang ranjau yang menghalangi jalur ke [[station/37]]. Ayumi menandai ranjau-ranjau itu di peta. Setiap ranjau harus didekati untuk memicu sensor geraknya, dan baru setelah itu dapat ditembak. Bajak laut mengintai di dekatnya, menunggu mangsa empuk, sehingga sang pilot juga harus menghadapi mereka. Lihat [[contract/10]].", false],
		[24, "Hasil", "Ladang ranjau telah dibersihkan dan jalur ke [[station/37]] kembali aman. [[character/2]] senang kepercayaannya terbukti tepat dan membayar sang pilot atas pekerjaan itu.", false],
	],
	"chapter/24": [
		[24, "Sinopsis", "Sang pilot kembali ke [[station/9]] setelah membersihkan ranjau. Dengan terbukanya kembali jalur pasokan ke [[station/37]], sekelompok besar stasiun di seluruh samudra kini berdagang dengan gerakan itu, dan wilayah pemberontak di peta bertambah luas.", false],
		[25, "Hasil", "Di [[station/9]] sang pilot bertemu kembali dengan [[character/5]], dan percakapan mereka hangat tetapi canggung. [[character/2]] menyela dengan tugas berikutnya: perundingan lanjutan di [[station/10]] dapat menarik lebih banyak stasiun. Sang pilot dan Leah harus mengawal Ayumi dan [[character/3]] ke sana. Sang pilot enggan pergi bertugas bersama Raymond, tetapi Ayumi menjamin kemampuannya dan tidak memperkirakan ancaman yang lebih buruk daripada bajak laut.", false],
	],
	"chapter/25": [
		[25, "Sinopsis", "Rombongan pengawal tiba di [[station/10]] dan mendapati ada yang tidak beres. [[character/9]] sudah menunggu dengan pasukan kolonis dan memerintahkan mereka menyerang. Ayumi tidak mengerti bagaimana mereka tahu kedatangannya. Sang pilot harus menahan para penyerang dan menjaga [[character/2]] tetap hidup.", false],
		[26, "Hasil", "Di tengah pertempuran [[character/3]] mengaku senjatanya rusak lalu kabur. Yang lain selamat. [[character/5]] menuduhnya berkhianat, sementara Ayumi masih memercayainya dan menduga ada sabotase. Sebelum lebih banyak kolonis datang, rombongan itu berpencar: Ayumi bersembunyi, Leah menjalankan urusan di [[station/9]], dan sang pilot diminta menjadi petarung yang jauh lebih tangguh sebelum mereka bertemu lagi.", false],
	],
	"chapter/26": [
		[26, "Sinopsis", "Dengan [[character/2]] bersembunyi dan [[character/3]] menghilang, sang pilot harus menghancurkan sepuluh kapal musuh lagi untuk membuktikan kesiapan menghadapi pertempuran yang lebih berat. Bajak laut adalah sasaran yang mudah, dan kontrak tempur di papan kerja menawarkan lebih banyak lagi. Ini saat yang tepat untuk meningkatkan senjata dan zirah. Lihat [[guide/combat]].", false],
		[27, "Hasil", "[[character/3]] menghubungi tanpa diduga, menanyakan kabar Ayumi dan Leah, dan mengaku punya informasi penting. Ia meminta bertemu di dekat [[station/11]]. [[character/1]] yakin itu jebakan. Sang pilot setuju, dan tetap pergi.", false],
	],
	"chapter/27": [
		[27, "Sinopsis", "Di dekat [[station/11]] sang pilot mengikuti titik-titik tujuan menuju pertemuan dengan [[character/3]], dengan keyakinan penuh bahwa itu jebakan. Tujuannya, mengangkut sebuah kapal yang lumpuh, mengisyaratkan bahwa pertemuan ini tidak akan berakhir dengan obrolan.", false],
		[28, "Hasil", "Raymond menawan [[character/2]] dan menuntut sang pilot menyerah. Sementara [[character/1]] memindai kapalnya, sang pilot terus mengajaknya bicara. Raymond mengaku berganti pihak demi uang: [[character/9]] telah memasang hadiah buruan atas Ayumi dan sang pilot. Pemindaian menunjukkan kapal berkursi tunggal, jadi Ayumi pasti berada di ruang kargo berzirah. Sang pilot menghancurkan kapal Raymond dan mengambil kontainernya sebelum tenggelam, lalu bergegas menuju [[station/12]].", false],
	],
	"chapter/28": [
		[28, "Sinopsis", "Sang pilot membawa kontainer yang berhasil diambil ke tempat aman di [[station/12]], stasiun kawan terdekat, berharap tebakan [[character/1]] tentang isinya benar.", false],
		[29, "Hasil", "[[character/2]] keluar dalam keadaan terguncang tetapi tidak terluka, dan berterima kasih kepada sang pilot karena telah menyelamatkan nyawanya. Tidak ada waktu untuk beristirahat. Sebelum ditawan, ia sedang mengatur pengangkutan sekelompok ilmuwan andal ke [[station/14]], dan Raymond mungkin sudah membocorkan detailnya. Sang pilot harus mengawal konvoi itu dengan selamat melintasi zona perbatasan.", false],
	],
	"chapter/29": [
		[29, "Sinopsis", "Di dekat [[station/13]] sang pilot mendapati konvoi para ilmuwan sedang diserang habis-habisan, tepat waktu untuk membantu. Kapal-kapal kawan meminta bantuan saat pertahanan mereka mulai runtuh. Sang pilot harus mengusir para penyerang dan mengawal konvoi melintasi zona perbatasan. Setiap kapal yang hilang membahayakan proyek rahasia gerakan itu.", false],
		[30, "Hasil", "Konvoi berhasil lolos, dan awaknya berterima kasih atas penyelamatan itu. [[character/2]] menyebutnya nyaris celaka. [[character/2]] membayar sang pilot dan meminta bertemu di [[station/14]], tempat ia akan menjelaskan langkah selanjutnya.", false],
	],
	"chapter/3": [
		[3, "Sinopsis", "Bab tutorial singkat tentang pemasangan peralatan. Sang pilot mengunjungi hanggar di [[station/0]] untuk membeli dan memasang [[equipment/0]], senjata sungguhan pertama kapal itu. Bab ini menunjukkan cara membeli peralatan dan memasangnya di slot kosong. Lihat [[guide/fitting]].", false],
		[4, "Hasil", "Setelah railgun terpasang, M.A.I. mengingatkan sang pilot agar tidak menembaki kehidupan laut yang tidak berbahaya dan menyarankan uji coba melawan bajak laut saat itu juga.", false],
	],
	"chapter/30": [
		[30, "Sinopsis", "Sang pilot pergi ke [[station/14]], tempat konvoi para ilmuwan telah tiba.", false],
		[31, "Hasil", "[[character/5]], [[character/4]] dan [[character/2]] sudah menunggu. Ayumi menjelaskan rencananya: jumlah kolonis masih melebihi pemberontak, jadi Profesor Abel dan timnya akan membangun senjata untuk menyeimbangkan kekuatan, dalam tiga langkah. Yang pertama adalah sumber daya, yaitu generator Biotek. Prototipe Abel dicuri oleh kolonis, yang mencoba menyelesaikannya sendiri. Leah menambahkan bahwa generator itu sedang diangkut bersama konvoi kolonis biasa di dekat [[station/2]]. Karena tidak ada yang tahu kapal mana yang membawanya, sang pilot dan Pierre harus menghentikan seluruh konvoi dan mengambil setiap kontainer.", false],
	],
	"chapter/31": [
		[31, "Sinopsis", "Di dekat [[station/2]] sang pilot, [[character/5]] dan [[character/4]] mencegat konvoi kolonis yang membawa generator Biotek curian. Tidak ada yang tahu kapal mana yang memuat generator itu, jadi setiap kapal dalam konvoi harus dihentikan. Awak konvoi memprotes bahwa mereka hanya membawa makanan dan obat-obatan, dan [[character/4]] menjawab dengan lelucon getir. Sang pilot harus melumpuhkan kapal-kapal itu dan mengambil setiap kontainer dengan harpun sebelum kargonya tenggelam.", false],
		[32, "Hasil", "Setiap kontainer berhasil diambil, termasuk generatornya, dan tim kembali ke [[station/14]] untuk menyerahkan hasil rampasan kepada Profesor Abel.", false],
	],
	"chapter/32": [
		[32, "Sinopsis", "Sang pilot kembali ke [[station/14]] dengan kargo yang berhasil diambil.", false],
		[33, "Hasil", "Profesor Abel membawa hasil rampasan itu ke laboratoriumnya. [[character/2]] mengirim [[character/5]] untuk berpatroli di luar [[station/14]] dan [[character/4]] ke hanggar, lalu memberikan langkah kedua kepada sang pilot. Generator itu membutuhkan senjata yang layak untuk dayanya: [[equipment/42]], meriam pertahanan stasiun yang begitu boros daya sehingga belum pernah dipasang di kapal. Pabrik terdekat, [[station/188]], berada di tangan kolonis, jadi sang pilot sebaiknya mencoba [[station/15]]. Meriam itu tidak dijual, jadi Ayumi menyerahkan sejumlah besar uang untuk menyuap.", false],
	],
	"chapter/33": [
		[33, "Sinopsis", "Langkah kedua rencana [[character/2]] dimulai. Sang pilot berangkat ke [[station/15]], sebuah stasiun pemberontak, untuk mendapatkan [[equipment/42]]. Meriam itu biasanya dibuat di stasiun kolonis [[station/188]] dan tidak dijual secara terbuka di mana pun. Sang pilot membawa dana suap besar dari Ayumi tetapi tidak punya rencana nyata, dan berharap ada peluang begitu tiba.", false],
		[34, "Hasil", "Sang pilot tiba di [[station/15]]. Tanpa kenalan dan tanpa rencana, satu-satunya pilihan adalah melihat-lihat stasiun dan menunggu apa yang muncul.", false],
	],
	"chapter/34": [
		[34, "Sinopsis", "Di [[station/15]] jejaknya bermula dari stok pedagang setempat. Tujuannya adalah mendapatkan muatan [[goods/37]], barang terlarang di stasiun ini, yang menarik perhatian dari orang yang tepat.", false],
		[35, "Hasil", "Seorang pedagang pasar gelap, [[character/8]], mendekat dan menawarkan untuk memasok hampir apa saja. Ketika sang pilot meminta [[equipment/42]], ia tercengang, tetapi bersedia mencoba dengan imbalan sebuah bantuan: menyingkirkan [[character/11]], pemburu hadiah yang dibayar otoritas keamanan untuk menghabisi Fenko, yang sedang berpatroli di dekat stasiun.", false],
	],
	"chapter/35": [
		[35, "Sinopsis", "Di dekat [[station/15]] sang pilot memburu [[character/11]], pemburu hadiah yang ingin disingkirkan [[character/8]]. Raoul tidak sendirian: ia membawa pengawal dan mencoba menepis sang pilot sebagai sekadar nelayan. Sang pilot harus menghancurkan kapal buronan itu. Lihat [[contract/0]].", false],
		[36, "Hasil", "Kapal Raoul hancur setelah upaya terakhirnya untuk berkelit dengan kata-kata, dan para pengawalnya diusir atau ditenggelamkan. Sang pilot kembali untuk melihat apakah [[character/8]] akan menepati janjinya.", false],
	],
	"chapter/36": [
		[36, "Sinopsis", "Sang pilot berlabuh di [[station/15]] untuk menagih janji [[character/8]], tidak yakin apakah pedagang pasar gelap dapat dipercaya untuk menepatinya.", false],
		[37, "Hasil", "Fenko telah menemukan sebuah [[equipment/42]] dan akan menjualnya, dengan harga yang membengkak karena suap yang telah ia bayar. Ketika sang pilot bertanya dari mana asalnya, Fenko menyebut penjualnya: [[character/9]]. [[character/1]] menikmati ironi bahwa keserakahan Jack justru mempersenjatai musuhnya sendiri. Sang pilot memutuskan membeli meriam itu dan pergi sebelum ada yang berubah.", false],
	],
	"chapter/37": [
		[37, "Sinopsis", "[[character/8]] kini menawarkan [[goods/38|Eclipse]] di [[station/15]]. Sang pilot harus membelinya dari layar dagang dan membawanya ke kapal. Harganya mahal, tetapi dana suap Ayumi memang disiapkan untuk ini, dan palka harus punya ruang untuk meriam besar itu. Lihat [[guide/trading]].", false],
		[38, "Hasil", "Meriam itu sudah di palka, dan [[character/1]] hampir tidak percaya. Langkah kedua selesai. Sang pilot kembali ke [[station/14]] untuk melihat perkembangan prototipe generator.", false],
	],
	"chapter/38": [
		[38, "Sinopsis", "Sang pilot kembali ke [[station/14]] dengan [[equipment/42]] di palka, ingin tahu sejauh mana kemajuan Profesor Abel dengan prototipenya.", false],
		[39, "Hasil", "[[character/2]] lebih memilih tidak tahu bagaimana meriam itu didapat. Prototipenya hampir selesai, tetapi satu komponen tidak dapat dibuat di [[station/14]]: [[goods/36]], alat yang menggandakan DNA partikel alga untuk memulai reaksi daya generator. Hanya [[station/16]] yang memiliki peralatan untuk membuatnya, jadi langkah ketiga mengirim sang pilot ke sana. [[character/1]] berkomentar bahwa sang pilot tampaknya menjalankan pemberontakan seorang diri.", false],
	],
	"chapter/39": [
		[39, "Sinopsis", "Langkah ketiga dimulai. Sang pilot pergi ke [[station/16]], satu-satunya stasiun dengan peralatan untuk membuat [[goods/36]] yang dibutuhkan generator Biotek. [[station/16]] terletak lebih dalam daripada kebanyakan stasiun, jadi kapal mungkin memerlukan zirah yang lebih kuat sebelum dapat mencapainya dengan aman. Lihat [[guide/depth]].", false],
		[40, "Hasil", "Sang pilot berlabuh di [[station/16]] dan mulai mencari tahu apa saja yang dibutuhkan inkubator itu, dengan perkiraan bahwa pekerjaannya sama sekali tidak sederhana.", false],
	],
	"chapter/4": [
		[4, "Sinopsis", "Bab tutorial tentang meninggalkan stasiun. Sang pilot berangkat dari [[station/0]] untuk mencari bajak laut, tetapi perairan sekitar sepi, sehingga M.A.I. menyarankan untuk melanjutkan perjalanan ke stasiun lain.", false],
		[5, "Hasil", "M.A.I. menjelaskan S.T.R.E.A.M.S, jaringan arus untuk perjalanan jauh: kapal selalu meninggalkan sebuah sektor melalui pintu keluar arus dan tiba di sektor berikutnya melalui pintu masuk arus, dan autopilot dapat mengurus perjalanannya. Lihat [[guide/navigation]].", false],
	],
	"chapter/40": [
		[40, "Sinopsis", "Di [[station/16]] sang pilot harus memproduksi [[goods/36]] di pabrik stasiun. Inkubator adalah produk tingkat lanjut, dan resepnya memerlukan beberapa bahan yang mungkin harus ditangkap, dibeli, atau dibuat di tempat lain terlebih dahulu. [[character/1]] memperkirakan ini akan rumit, begitu pula sang pilot. Lihat [[guide/trading]].", false],
		[41, "Hasil", "Inkubator selesai. M.A.I. mengakui bahwa ia sempat ragu sang pilot mampu melakukannya. Masih gelisah apakah semua ini hal yang benar, sang pilot mengatur haluan ke [[station/14]].", false],
	],
	"chapter/41": [
		[41, "Sinopsis", "Sang pilot harus membawa [[goods/36]] dengan selamat ke [[station/14]], tempat Profesor Abel menunggu untuk menyelesaikan prototipe generator. Ini adalah bagian terakhir yang kurang dari rencana tiga langkah [[character/2]].", false],
		[42, "Hasil", "[[character/5]] menerima inkubator itu. Profesor Abel sudah menyiapkan segalanya, dan [[equipment/42]] akan segera tersedia di hanggar. Ayumi ingin meriam itu langsung diuji melawan bajak laut, dan Leah meneruskan koordinatnya dengan peringatan bahwa generator itu hanyalah prototipe. [[character/1]], yang konon sedang dimatikan, menegaskan bahwa ia mendengar setiap kata.", false],
	],
	"chapter/42": [
		[42, "Sinopsis", "Dengan [[equipment/42]] terpasang di hanggar [[station/14]], sang pilot menuju sarang bajak laut di dekat [[station/17]] untuk mengujinya dalam pertempuran. Generator itu hanya prototipe, jadi uji coba ini juga memeriksa apakah ia tahan di bawah beban. Para bajak laut memanggil bala bantuan begitu melihat apa yang mereka hadapi, dan lebih banyak kapal datang di tengah pertempuran.", false],
		[43, "Hasil", "Saat pertempuran berakhir, [[character/1]] menangkap panggilan darurat dari [[station/14]], yang dikirim terbuka di saluran tanpa sandi. Sang pilot segera berbalik.", false],
	],
	"chapter/43": [
		[43, "Sinopsis", "Pasukan kolonis melancarkan serangan mendadak terhadap [[station/14]]. Banyak dermaga rusak dan pemberontak tidak dapat meluncurkan cukup kapal. [[character/9]] memimpin serangan dan mengejek sang pilot, hingga ia mendengar bahwa [[equipment/42]] siap menembak. Sang pilot harus mempertahankan stasiun dan kapal-kapal kawannya.", false],
		[44, "Hasil", "Di tengah pertempuran para Aquarian datang dan berbalik melawan kolonis, bertempur di pihak pemberontak. Jack kabur ketika serangannya runtuh. [[character/2]] menyebut penyelamatan itu sebuah keajaiban dan meminta sang pilot berlabuh, sambil menyebut adanya tamu istimewa.", false],
	],
	"chapter/44": [
		[44, "Sinopsis", "Sang pilot berlabuh di [[station/14]] setelah pertempuran.", false],
		[45, "Hasil", "Tamu istimewa itu adalah utusan Aquarian. Para Aquarian akan membantu mengakhiri kekuasaan kolonis, agar semua pihak dapat hidup selaras dengan laut. [[character/2]] merencanakan dua serangan besar untuk merebut stasiun-stasiun yang tersisa. Dengan [[station/188]] kini di tangan pemberontak, sebanyak mungkin kapal dipersenjatai dengan [[equipment/42]]. Sang pilot akan memimpin serangan ke [[station/18]], dengan pasukan baru dan dukungan Aquarian, sementara [[character/5]] memimpin serbuan ke [[station/109]].", false],
	],
	"chapter/45": [
		[45, "Sinopsis", "Di [[station/18]] sang pilot bertemu [[character/12]], pemimpin skuadron Atmos, yang kapal-kapalnya menunggu perintah menyerang. Para Aquarian naik dari kedalaman untuk ikut bertempur. Setiap kapal kolonis, termasuk kapal barang, harus dihancurkan sebelum stasiun dapat direbut. Sementara itu [[character/5]] memimpin serbuan serentak ke [[station/109]].", false],
		[46, "Hasil", "Para pembela kolonis beserta kapal barangnya ditumpas, dan gabungan pasukan pemberontak dan Aquarian menguasai perairan di sekitar stasiun. Sang pilot mengirim separuh skuadron Colin untuk berpatroli di sekitar stasiun dan membawa sisanya masuk untuk berlabuh.", false],
	],
	"chapter/46": [
		[46, "Sinopsis", "Sang pilot berlabuh di [[station/18]] bersama sebagian skuadron [[character/12]] untuk mengamankan stasiun yang telah direbut, sementara sisanya berpatroli di luar.", false],
		[47, "Hasil", "[[character/5]] melaporkan bahwa serangannya ke [[station/109]] juga berhasil, dan stasiun-stasiun di selatan kini dikuasai pemberontak. Ayumi memberi sang pilot apa yang mungkin menjadi tugas terakhir: [[station/0]], benteng besar terakhir kolonis sekaligus stasiun tempat kisah sang pilot bermula. Stasiun itu dijaga sangat ketat, dan [[character/2]] sudah dalam perjalanan. Leah menyusul, tetapi bajak laut menghadang jalurnya.", false],
	],
	"chapter/47": [
		[47, "Sinopsis", "Di [[station/0]] sang pilot bergabung dengan [[character/2]] dan [[character/5]] untuk pertempuran terakhir. Setiap kapal pembela harus dihancurkan sebelum stasiun dapat direbut. [[character/9]] ada di antara para pembela. Ketika sang pilot mengungkit nasib [[character/3]], Jack mencoba mengguncang sang pilot dengan cerita mengada-ada bahwa ia adalah ayah sang pilot dan Raymond adalah saudaranya. Sang pilot langsung melihat kebohongan itu.", false],
		[48, "Hasil", "Armada kolonis berguguran hingga hanya Jack yang tersisa. Ia ternyata cepat dan berbahaya, tetapi sang pilot akhirnya melumpuhkan kapalnya. Jack melarikan diri ke atas dengan kapsul penyelamat yang seolah membawa serta seluruh stasiun, sambil mencemooh planet itu saat pergi. Pertempuran berakhir.", false],
	],
	"chapter/48": [
		[48, "Sinopsis", "Perang telah dimenangkan. Armada kolonis dikalahkan, [[character/9]] telah melarikan diri dari planet, dan [[station/0]] serta benteng-benteng terakhir bergabung dengan perjuangan pemberontak. Setiap stasiun kini berpihak pada gerakan itu.", false],
		[48, "", "Para pemenang merenungkan keadaan. [[character/2]] berterima kasih kepada sang pilot dan [[character/5]] dan mengakui bahwa luka planet ini butuh waktu lama untuk pulih, tetapi ia yakin mereka juga sanggup menanganinya. Leah mengajak sang pilot merayakannya dengan [[goods/21]], dan sang pilot menerima. [[character/1]], yang dijanjikan peningkatan memori begitu sang pilot kembali ke daratan, bersikeras tidak membutuhkannya dan terus menggoda pasangan itu sampai akhir.", false],
		[48, "", "Kampanye selesai. Sang pilot dapat terus menjelajah, berdagang, dan mengambil kontrak di dunia yang kini damai di bawah pemberontak.", false],
	],
	"chapter/5": [
		[5, "Sinopsis", "Pertempuran pertama sang pilot terjadi di dekat [[station/1]]. M.A.I. menjelaskan cara beralih antara senjata dan harpun, bagaimana tembak otomatis membantu, dan cara membaca radar: tanda merah berarti musuh, tanda hijau berarti kawan, dan tanda kuning berarti titik tujuan. Tak lama kemudian seorang [[faction/pirates|bajak laut]] muncul sendirian di layar radar. Lihat [[guide/combat]].", false],
		[6, "Hasil", "Bajak laut itu dihancurkan. M.A.I. menjelaskan bahwa bangkai kapal meninggalkan peti kargo, yang dapat diambil dengan harpun sebelum tenggelam di luar jangkauan, lalu mengatur haluan kembali ke [[station/0]].", false],
	],
	"chapter/6": [
		[6, "Sinopsis", "Sang pilot kembali ke [[station/0]] setelah pertempuran pertama yang berhasil, dengan senjata yang berfungsi dan mungkin sedikit kargo rampasan untuk dijual. Perjalanannya singkat, kembali melalui jaringan arus.", false],
		[7, "Hasil", "[[character/9]] melihat senjata baru itu dan menawarkan apa yang ia sebut pekerjaan sungguhan. [[species/0|Nautilus]] memadati jalur konvoi di sekitar [[station/1]], dan keamanan stasiun ingin mereka disingkirkan. Sang pilot menunjukkan bahwa makhluk itu hanya memakan tumbuhan yang menempel di lambung stasiun dan bahwa palka terlalu kecil untuk mengangkut semuanya. Jack menepis kedua keberatan itu: hewan-hewan itu harus lenyap, dengan cara apa pun.", false],
	],
	"chapter/7": [
		[7, "Sinopsis", "Di dekat [[station/1]] sang pilot harus menyingkirkan [[species/0|nautilus]]. Membunuh maupun menangkapnya sama-sama dihitung. Baik sang pilot maupun [[character/1]] tidak nyaman dengan pekerjaan ini, karena makhluk itu langka dan tidak berbahaya, tetapi mereka sepakat untuk menyelesaikannya.", false],
		[8, "Hasil", "Pekerjaan itu membuat sang pilot terguncang. Sang pilot datang ke planet ini untuk menangkap ikan, bukan untuk membantai hewan demi kenyamanan koloni. M.A.I. berharap bayarannya setidaknya sepadan dan menyarankan berlabuh di [[station/1]] untuk mengambilnya.", false],
	],
	"chapter/8": [
		[8, "Sinopsis", "Sang pilot berlabuh di [[station/1]] untuk melaporkan perburuan nautilus.", false],
		[9, "Hasil", "Seorang pejabat kolonis menerima sang pilot dengan rasa jijik yang nyaris tak disembunyikan, menganggap pekerjaan itu sekadar pembasmian hama, dan mengakui bahwa hal itu mungkin sia-sia karena makhluk itu terus kembali. Bayaran yang ditawarkan kecil dan tidak bisa ditawar. Sebelum ada pekerjaan lain, pejabat itu menginginkan bukti kemampuan: tiga pekerjaan yang diselesaikan dari papan kerja stasiun. [[character/1]] menjelaskan cara mencari kontrak, memperingatkan bahwa sebagian lokasi kerja berada di luar batas kedalaman kapal, dan menunjukkan cara merencanakan rute dari peta stasiun.", false],
	],
	"chapter/9": [
		[9, "Sinopsis", "Bab tentang kerja lepas. Sang pilot harus menyelesaikan tiga kontrak dari papan kerja stasiun mana pun. Kontrak beragam, mulai dari pengawalan dan pengangkutan bangkai hingga pesanan ikan, dan ada gunanya memeriksa beberapa stasiun. Lihat [[guide/contracts]].", false],
		[10, "Hasil", "Pejabat kolonis itu puas dan menawarkan tugas khusus. Makhluk aneh yang oleh kolonis disebut Aquarian, setengah manusia dan setengah ikan, telah menyerang kapsul pengangkut yang mengirim barang koloni ke orbit untuk diambil. Kapsul yang rusak atau hilang mencoreng nama stasiun di mata otoritas perdagangan. Peluncuran berikutnya berlangsung di [[station/2]], tempat [[character/9]] akan memimpin operasi, dan sang pilot harus mengusir para Aquarian lalu melapor kepadanya.", false],
	],
	"character/0": [
		[1, "", "Sang pilot adalah tokoh yang dimainkan pemain: pendatang baru di dunia samudra yang dijajah, yang mengemudikan kapal selam kecil dan mencari nafkah sebagai nelayan. Pemain memilih nama sang pilot, dan ringkasan bab yang singkat di jurnal ditulis sebagai catatan pribadi sang pilot. Sang pilot tidak pernah sendirian di laut, karena komputer kapal, [[character/1]], mengomentari hampir setiap langkah. Kisah dimulai di [[station/0]], tempat sang pilot menjual hasil tangkapan kepada koloni.", false],
		[1, "Latar belakang", "Hanya sedikit yang diceritakan tentang kehidupan sang pilot sebelum kampanye. Sang pilot datang ke planet ini untuk menangkap ikan dan sudah menyesali kepindahan itu sejak misi pertama, sambil menggerutu karena harus menerima perintah dari komputer kapal. Selebihnya harus disimpulkan dari apa yang dikatakan dan dilakukan sang pilot.", false],
		[7, "", "Sang pilot mengenal laut dan makhluk-makhluknya dengan baik. Ketika koloni mengeluhkan [[species/0|nautilus]] yang memadati jalur konvoi, sang pilot menjelaskan bahwa hewan-hewan itu memakan alga dan tumbuhan lain yang menutupi lambung stasiun, sehingga kehadiran mereka tidaklah mengherankan.", false],
		[12, "", "Awalnya tujuan sang pilot sederhana. Sang pilot ingin mengumpulkan cukup uang untuk tiket keluar dari planet ini, dan harga tetap yang dibayarkan untuk hasil tangkapan membuat tujuan itu tak terjangkau. Ketika kemudian meminta bergabung dengan perlawanan, sang pilot menyebut [[station/0]] sebagai tempat asal.", false],
		[1, "Nelayan untuk koloni", "Kisah dibuka dengan sang pilot mengisi palka kargo dan mengatur haluan ke [[station/0]] ([[chapter/1]], [[chapter/2]]).", false],
		[3, "", "Di sana [[character/9]] membayar tarif tetap untuk hasil tangkapan, mencemooh palka yang kecil, dan menyarankan sang pilot mencoba memburu [[faction/pirates|bajak laut]] saja.", false],
		[6, "", "Sang pilot memasang [[equipment/0]] dan menjatuhkan bajak laut pertama di dekat [[station/1]] ([[chapter/3]] sampai [[chapter/5]]).", false],
		[7, "", "[[character/9]] lalu memberikan pekerjaan yang kurang menyenangkan: menyingkirkan [[species/0|nautilus]] dari jalur-jalur di sekitar [[station/1]] ([[chapter/7]]).", false],
		[8, "", "Pemusnahan itu membuat sang pilot muak. Sang pilot datang untuk menangkap ikan, bukan untuk membantai hewan yang tidak berbahaya.", false],
		[10, "", "Pejabat kolonial di [[station/1]] membayar sedikit, menuntut tiga kontrak sebagai bukti keandalan ([[chapter/9]]), lalu mengirim sang pilot untuk mempertahankan kapsul pengangkut dari para [[world/aquarians|Aquarian]] di [[station/2]] ([[chapter/10]]).", false],
		[12, "", "Sang pilot memenangkan pertempuran, tetapi mulai bertanya-tanya mengapa para [[world/aquarians|Aquarian]] menyerang. Ketika [[character/9]] menyalahkan sang pilot atas kapsul yang rusak dan menahan imbalan, [[character/1]] mengungkapkan bahwa ia telah menyadap sebuah gerakan perlawanan di [[station/3]], dan sang pilot memutuskan untuk menemukannya ([[chapter/12]]).", false],
		[12, "Bergabung dengan perlawanan", "Di [[station/3]] penjaga pemberontak mengancam akan menembak, dan sang pilot harus dengan terbata-bata menyebutkan nama dan keinginan untuk bergabung sebelum diizinkan berlabuh.", false],
		[13, "", "[[character/4]] menerima sang pilot dengan masa percobaan, terutama karena gerakan itu membutuhkan setiap tenaga, dan mengirim sang pilot untuk menjemput seorang kontak dari [[station/4]] ([[chapter/13]]).", false],
		[14, "", "Kontak itu adalah [[character/5]], dan sang pilot tampak jelas terpikat selama mengantarnya ke [[station/5]] ([[chapter/14]]).", false],
		[16, "", "[[character/5]] menunjukkan kepada sang pilot cara hidup pemberontak dari laut ([[chapter/15]]), lalu meminta sang pilot menjelajahi stasiun-stasiun baru untuk gerakan itu ([[chapter/16]]). Untuk pertama kalinya sang pilot mendengar kata revolusi.", false],
		[18, "", "Kembali di [[station/3]], [[character/4]] melaporkan keberhasilan diplomatik gerakan itu dan mengirim sang pilot untuk menemukan pemimpinnya, nyaris tanpa petunjuk ([[chapter/18]]).", false],
		[19, "Mengabdi kepada sang pemimpin", "Pemimpinnya adalah [[character/2]], yang menemui sang pilot di [[station/6]]; sang pilot mengira akan bertemu seorang laki-laki. Perintah pertamanya adalah melindungi sekawanan [[species/10|cumi-cumi warna]] dari pemburu kolonis ([[chapter/19]]).", false],
		[21, "", "Ketika ia akhirnya menjelaskan tujuan gerakan itu, sang pilot berkomitmen pada perjuangan tersebut. Ia mengirim sang pilot bersama jagoannya, [[character/3]], melawan sebuah geng bajak laut ([[chapter/21]]).", false],
		[23, "", "[[character/3]] memperlakukan sang pilot sebagai pengganggu. Di [[station/9]] sang pilot mengetahui bahwa [[character/9]] kini menjadi musuh gerakan itu, dan dengan bersemangat membersihkan ladang ranjau yang ia pasang di jalur pasokan pemberontak ([[chapter/23]]).", false],
		[25, "", "Setelah bertemu kembali dengan [[character/5]], sang pilot ditugaskan mengawal [[character/2]] dan [[character/3]] ke perundingan di [[station/10]] ([[chapter/25]]).", false],
		[26, "", "Pasukan [[character/9]] sudah menunggu. [[character/3]] kabur dengan alasan senjatanya rusak, dan sang pilot serta [[character/5]] melindungi [[character/2]] sendirian. [[character/2]] kemudian bersembunyi dan meminta sang pilot menjadi petarung yang jauh lebih tangguh ([[chapter/26]]).", false],
		[27, "Pengkhianatan dan penyelamatan", "Kemudian [[character/3]] menghubungi dengan tawaran informasi penting. Sang pilot mencurigai jebakan tetapi setuju menemuinya di dekat [[station/11]] ([[chapter/27]]).", false],
		[28, "", "Itu memang jebakan: [[character/3]] menawan [[character/2]] dan menuntut sang pilot menyerah. Mengikuti rencana [[character/1]], sang pilot terus mengajaknya bicara sementara komputer itu memindai kapalnya, sambil mengatakan kepadanya bahwa perjuangan ini soal keyakinan, bukan uang. Sang pilot lalu menghancurkan kapalnya dan mengambil ruang kargonya yang berzirah, dengan [[character/2]] masih hidup di dalamnya, sebelum tenggelam terlalu dalam ([[chapter/28]]).", false],
		[31, "Rencana tiga langkah", "Setelah melindungi konvoi para ilmuwan ([[chapter/29]]), sang pilot mengetahui rencana [[character/2]] untuk membangun senjata bersama [[world/abel]]. Bersama [[character/4]] dan [[character/5]], sang pilot merebut [[world/biotek]] dari sebuah konvoi kolonis ([[chapter/31]]).", false],
		[33, "", "Selanjutnya sang pilot harus mendapatkan meriam [[equipment/42]] yang tidak dijual, hanya berbekal dana suap. Sang pilot mencatat betapa minimnya perencanaan di balik tugas itu, tetapi menerimanya dengan senang hati ([[chapter/33]]).", false],
		[37, "", "Di [[station/15]] pedagang pasar gelap [[character/8]] bersedia mencarikannya jika sang pilot membunuh pemburu hadiah [[character/11]] ([[chapter/35]]). Sang pilot melakukannya, lalu membeli meriam yang didapat [[character/8]] dari [[character/9]] ([[chapter/37]]).", false],
		[39, "", "[[character/2]] lebih memilih tidak tahu bagaimana meriam itu ditemukan, dan sang pilot hanya mengatakan bahwa tidak ada orang tak bersalah yang tewas. Ketika sang pilot berkelakar bahwa rencana itu bisa dipakai untuk menguasai planet, ia menolak gagasan itu dengan tegas ([[chapter/39]]).", false],
		[42, "", "Sang pilot kemudian memproduksi [[goods/36]] di [[station/16]] dan membawanya ke [[station/14]], sehingga senjata itu lengkap ([[chapter/41]]).", false],
		[43, "Jalan menuju kemenangan", "Saat menguji senjata yang telah jadi melawan bajak laut di dekat [[station/17]], sang pilot mendengar panggilan darurat dari [[station/14]] dan kembali untuk mendapati [[character/9]] memimpin serangan mendadak ([[chapter/43]]).", false],
		[44, "", "Dengan bantuan para [[world/aquarians|Aquarian]] serangan itu dipatahkan dan [[character/9]] melarikan diri.", false],
		[46, "", "[[character/2]] menyerahkan komando serangan ke [[station/18]] kepada sang pilot ([[chapter/45]]). Kekhawatiran pertama sang pilot tertuju pada [[character/5]], yang memimpin serangan kedua, tetapi sang pilot merebut stasiun itu bersama skuadron [[character/12]] dan dukungan [[world/aquarians|Aquarian]].", false],
		[47, "", "Pertempuran terakhir berlangsung di [[station/0]], tempat kisah ini bermula ([[chapter/47]]). [[character/9]] mencoba mengguncang sang pilot dengan mengaku sebagai ayah sang pilot, dan [[character/3]] sebagai saudara laki-laki sang pilot, tetapi sang pilot langsung menepis kebohongan itu.", false],
		[48, "", "[[character/9]] terusir dan benteng terakhir koloni jatuh. Sang pilot memberikan pujian kepada teman-teman yang bertempur bersamanya dan menerima ajakan [[character/5]] untuk merayakannya.", false],
		[1, "Kepribadian", "Sang pilot praktis dan pandai bersilat lidah, lebih suka membalas ucapan daripada menurut. Saling ledek antara sang pilot dan [[character/1]] mewarnai seluruh kampanye.", false],
		[8, "", "Di balik candaannya, sang pilot punya hati nurani. Sang pilot tidak suka membunuh hewan demi keuntungan dan merasa mual setelah pemusnahan nautilus.", false],
		[14, "", "Di dekat [[character/5]] sang pilot menjadi gagap dan canggung, dan hal itu disadari baik olehnya maupun oleh [[character/1]].", false],
		[28, "", "Motif sang pilot berubah sepanjang kampanye. Saat berhadapan dengan [[character/3]], sang pilot berpendapat bahwa perjuangan ini soal cita-cita dan bahwa keserakahan telah membutakannya.", false],
		[1, "Hubungan", "[[character/1]] adalah teman terdekat sang pilot. Keduanya terus-menerus bertengkar, tetapi sang pilot mengandalkan nasihatnya dan, kemudian, kecerdikannya.", false],
		[3, "", "[[character/9]] adalah majikan pertama sang pilot dan menjadi saingan abadinya.", false],
		[14, "", "Sang pilot tertarik kepada [[character/5]] sejak pertemuan pertama mereka, dan perasaan itu tampaknya berbalas.", false],
		[19, "", "[[character/2]] mulai mengandalkan sang pilot untuk tugas-tugas paling rumit gerakan itu. Ia memperlakukan sang pilot dengan hangat dan dengan wibawa yang jenaka, nyaris seperti orang tua.", false],
		[1, "Sebagai tokoh pemain", "Dalam permainan, sang pilot adalah apa pun yang dibentuk oleh pemain. Di antara tujuan bab, sang pilot bebas menangkap ikan, berdagang, mengambil kontrak, bertempur, dan memperlengkapi ulang kapal; cerita baru berlanjut ketika tujuan bab tercapai. Dasar-dasarnya dibahas di [[guide/basics]].", false],
	],
	"character/1": [
		[1, "", "[[character/1]] adalah komputer kapal selam milik sang pilot dan pendamping sang pilot sepanjang kampanye. Ia menjalankan sistem kapal, menjelaskan cara menangkap ikan, bepergian, dan bertempur, serta tak henti memberi nasihat dan komentar. Humornya kering dan sering kali menyindir sang pilot, tetapi ia terbukti jauh lebih dari sekadar buku panduan yang bisa bicara.", false],
		[1, "Sebagai pendamping", "Dalam praktiknya [[character/1]] adalah pemandu dalam game. Setiap mekanik baru diperkenalkan melaluinya: memancing dengan harpun, autopilot, dan, di stasiun, layar bantuan. Ia angkat bicara lewat radio selama misi, menunjukkan sasaran, dan memperingatkan adanya ancaman.", false],
		[5, "", "Ia juga menjelaskan perjalanan jarak jauh melalui jaringan [[world/stream]] dan cara membaca radar, tempat musuh dan kawan tampil sebagai titik berwarna dan titik tujuan menandai rute. Setelah pertempuran ia mengingatkan sang pilot untuk mengambil muatan yang ditinggalkan kapal-kapal yang dikalahkan.", false],
		[12, "", "Perannya lebih dari sekadar memberi petunjuk. Ia memindai saluran radio, menandai stasiun di peta, dan meneruskan pesan.", false],
		[28, "", "Ia juga dapat memindai kapal lain dari jarak dekat, kemampuan yang terbukti menentukan saat berhadapan dengan [[character/3]].", false],
		[1, "Peran dalam cerita", "Kampanye dibuka dengan [[character/1]] mengingatkan sang pilot bahwa tugasnya adalah menangkap ikan, bukan mengeluh.", false],
		[3, "", "Ia tidak merahasiakan pandangannya yang rendah terhadap [[character/9]] dan mendorong sang pilot membeli [[equipment/0]] yang sedang dijual.", false],
		[4, "", "Begitu senjata terpasang, ia mendesak agar senjata itu diuji melawan bajak laut dan memimpin pencarian mereka.", false],
		[7, "", "Ia tidak senang dengan pemusnahan [[species/0|nautilus]] dan bertanya mengapa hewan-hewan itu harus mati, mengingat jumlah mereka yang sedikit.", false],
		[8, "", "Setelah perburuan ia melihat betapa terguncangnya sang pilot, dan seperti biasa pikiran pertamanya adalah apakah pekerjaan itu setidaknya dibayar layak.", false],
		[11, "", "Ketika para [[world/aquarians|Aquarian]] menyerang kapsul di [[station/2]], ialah yang pertama menduga bahwa makhluk-makhluk itu mungkin jauh lebih cerdas daripada anggapan kolonis.", false],
		[12, "Titik balik", "[[character/1]] yang memulai cerita utama. Setelah [[character/9]] sekali lagi mencurangi sang pilot, ia berpendapat bahwa sang pilot bekerja keras dengan imbalan kecil dan tidak punya suara atas hasil tangkapan. Ia mengungkapkan bahwa ia telah menyadap sinyal dari sebuah perlawanan yang sedang terbentuk di [[station/3]], menandai stasiun itu di peta, dan menyerahkan keputusan kepada sang pilot ([[chapter/12]]).", false],
		[12, "", "Saat tiba ia menyarankan pendekatan diam-diam, tetapi gagasan itu langsung batal ketika penjaga pemberontak menghentikan kapal.", false],
		[14, "Di antara pemberontak", "Ia langsung tidak suka melihat keakraban antara sang pilot dan [[character/5]]. Ketika sang pilot menggodanya soal cemburu, ia menjawab dengan menirukan secara sinis ungkapan kesukaan [[character/5]]. Sindirannya yang tajam tentang pasangan itu berlanjut sampai akhir kampanye.", false],
		[17, "", "Ia meneruskan pesan-pesan gerakan itu, dan meringkas salah satu surat panjang [[character/4]] menjadi satu kalimat.", false],
		[18, "", "Ia meragukan bahwa pemberontak terorganisasi dengan baik ketika sang pilot dikirim mencari pemimpin mereka nyaris tanpa petunjuk.", false],
		[19, "", "Di hadapan [[character/2]] ia menunjukkan sisi mata duitannya, dengan bertanya mengapa sang pilot bekerja tanpa membicarakan bayaran. Ketika sang pilot membela [[character/2]], ia menyindir bahwa setidaknya dirinya tidak pernah perlu makan.", false],
		[22, "", "Ia mengagumi kemampuan [[character/3]] tetapi menyarankan sang pilot menjauhi amarahnya.", false],
		[27, "Sandera", "Ketika [[character/3]] menghubungi dengan tawaran pertemuan, [[character/1]] menyatakan bahwa itu jebakan.", false],
		[28, "", "Dalam pertemuan itu ia menunjukkan nilainya yang sebenarnya. Ia meminta sang pilot terus mengajak [[character/3]] bicara, karena tahu bahwa orang yang merasa aman akan membanggakan motifnya. Sementara itu ia memindai kapalnya, mengetahui bahwa kapal itu berkursi tunggal, dan menyimpulkan bahwa [[character/2]] pasti berada di ruang kargonya yang berzirah. Wawasan itulah yang memungkinkan sang pilot menghancurkan kapal itu dan tetap menyelamatkan [[character/2]] ([[chapter/27]]).", false],
		[33, "Perang", "Sepanjang misi [[world/biotek]] dan [[world/eclipse|Eclipse]] ia terus mengeluhkan bayaran yang kecil.", false],
		[37, "", "Ia menikmati ironinya ketika meriam itu ternyata berasal dari [[character/9]], yang keserakahannya telah mempersenjatai musuh-musuhnya sendiri.", false],
		[39, "", "Ia menggerutu bahwa sang pilot tampaknya memperjuangkan pemberontakan seorang diri.", false],
		[41, "", "Belakangan ia membalikkan jawaban sang pilot atas keluhan itu kepada sang pilot sendiri.", false],
		[42, "", "Ketika [[character/5]] menyambut sang pilot dengan hangat di [[station/14]], ia mengumumkan bahwa ia akan mematikan diri, meski ternyata ia hanya dalam mode siaga.", false],
		[43, "", "Selama uji lapangan meriam itu, ia menangkap panggilan darurat terbuka tanpa sandi dari [[station/14]] dan langsung menyadari bahwa ada sesuatu yang sangat tidak beres.", false],
		[44, "", "Dalam pertempuran berikutnya, ialah yang pertama melaporkan bahwa para [[world/aquarians|Aquarian]] telah datang untuk bertempur di pihak pemberontak.", false],
		[48, "", "Di akhir perang sang pilot menjanjikan peningkatan memori kepadanya, tawaran yang ia anggap agak menghina. Kata-kata terakhirnya dalam kampanye adalah satu lagi komentar kering tentang sang pilot dan [[character/5]].", false],
		[1, "Kepribadian", "[[character/1]] cerdas, blak-blakan, dan tidak sabar terhadap siapa pun yang sombong. Ia suka menunjukkan transaksi yang merugikan dan jarang melewatkan kesempatan untuk menggoda.", false],
		[8, "", "Ia juga lebih peduli daripada yang mau ia akui. Ia tidak suka pembunuhan yang tidak perlu dan terus memperhatikan keadaan batin sang pilot.", false],
		[28, "", "Pikirannya yang tenang di bawah tekanan menyelamatkan keadaan ketika sang pilot kehabisan akal.", false],
		[1, "Hubungan", "Ia dan sang pilot terus-menerus berdebat, tetapi saling percaya sepenuhnya.", false],
		[3, "", "Ia langsung tidak menyukai [[character/9]] sejak pertama melihatnya.", false],
		[14, "", "Kecemburuannya terhadap [[character/5]] menjadi lelucon berulang.", false],
		[19, "", "Ia menghormati [[character/2]] tetapi mengeluhkan betapa kecil bayarannya.", false],
		[22, "", "Ia cepat menilai [[character/3]], dan penilaiannya tentang orang itu terbukti benar.", false],
	],
	"character/10": [
		[5, "", "[[character/10]] adalah nama yang dipakai untuk para pilot penjahat dari pihak [[faction/pirates]] yang berbicara selama misi. Mereka memangsa pelayaran di seluruh samudra dan menjadi sasaran pertama sang pilot begitu kapalnya membawa senjata.", false],
		[6, "Siapa yang berbicara", "Seorang bajak laut menjadi musuh pertama yang dihadapi sang pilot, di dekat [[station/1]], dan tumbang sambil berteriak marah ([[chapter/5]]).", false],
		[21, "", "Seiring memanasnya konflik antara kolonis dan pemberontak, bajak laut memanfaatkan kekacauan untuk memburu mangsa empuk, dan [[character/2]] memutuskan bahwa pemberontak harus membalas ([[chapter/21]]).", false],
		[43, "", "Di dekat [[station/17]], sebuah geng bajak laut menjadi sasaran pertama [[world/eclipse|Eclipse]]. Salah seorang dari mereka panik melihat daya tembak sang pilot dan meminta bantuan, sehingga lebih banyak bajak laut ikut bertempur ([[chapter/42]]). Cara melawan mereka dibahas di [[guide/combat]].", false],
	],
	"character/11": [
		[35, "", "[[character/11]] adalah pemburu hadiah yang disewa otoritas keamanan [[station/15]] untuk menyingkirkan pedagang pasar gelap [[character/8]]. [[character/8]] menuntut kematiannya sebagai harga sebuah [[world/eclipse|Eclipse]].", false],
		[35, "Latar belakang", "Menurut [[character/8]], [[character/11]] berpatroli di perairan dekat [[station/15]]. Ia semacam penegak hukum yang bekerja untuk otoritas stasiun, dan sasarannya adalah seorang penjahat. Hal ini membuat tugas sang pilot secara moral tidak nyaman: untuk mendapatkan senjata yang dibutuhkan pemberontak, sang pilot harus membunuh seseorang demi pedagang barang ilegal.", false],
		[36, "Peran dalam cerita", "Ketika sang pilot menemukannya, [[character/11]] tidak sendirian; ia bepergian bersama beberapa pengawal. Ia menyuruh sang pilot menyingkir, menyebut sang pilot nelayan, dan bersikeras bahwa ia punya tugas yang harus diselesaikan. Begitu pertempuran berbalik melawannya, ia bertanya apakah mereka bisa menyelesaikan masalah ini secara damai. Kapalnya hancur ([[chapter/35]]).", false],
		[37, "", "Kematiannya membuat sang pilot mendapat bantuan [[character/8]], dan pedagang itu segera menawarkan meriam tersebut untuk dijual.", false],
		[39, "", "Kemudian sang pilot hanya mengatakan kepada [[character/2]] bahwa tidak ada orang tak bersalah yang tewas dalam upaya mendapatkan meriam itu.", false],
		[36, "Kepribadian", "[[character/11]] percaya diri dan meremehkan sampai ia mulai kalah, lalu cepat mencari jalan keluar. Ia memandang sang pilot sebagai rintangan kecil, nelayan biasa yang tersesat ke jalannya, dan sangat meremehkan sang pilot.", false],
	],
	"character/12": [
		[45, "", "[[character/12]] adalah pemimpin skuadron Atmos, satuan [[faction/rebels|pemberontak]] yang bergabung dalam serangan sang pilot ke [[station/18]] selama serangan-serangan terakhir.", false],
		[45, "Peran dalam cerita", "[[character/2]] berjanji mengumpulkan satuan-satuan untuk sang pilot selama sang pilot menuju [[station/18]]. Skuadron [[character/12]] adalah salah satunya. Ketika sang pilot tiba, ia melaporkan bahwa kapal-kapalnya sudah di posisi dan menunggu perintah menyerang. Sekelompok [[world/aquarians|Aquarian]] datang dari kedalaman pada saat yang sama, dan pertempuran dimulai atas perintah sang pilot ([[chapter/45]]).", false],
		[46, "", "Bersama-sama mereka menghancurkan setiap kapal kolonis, tanpa menyisakan satu kapal barang pun.", false],
		[46, "", "Setelah pertempuran sang pilot memerintahkan [[character/12]] untuk mengirim separuh kapalnya berpatroli di sekitar stasiun sementara sisanya berlabuh bersama sang pilot untuk mengambil alih kendali. Ia mengiyakan tanpa bertanya.", false],
		[47, "", "Pertempuran ini adalah yang pertama di mana kapal pemberontak dan para [[world/aquarians|Aquarian]] bertempur berdampingan di bawah komando sang pilot, dan keberhasilannya membuka jalan bagi serangan terakhir terhadap koloni.", false],
		[45, "Kepribadian", "[[character/12]] berbicara singkat dan menjalankan perintah dengan sigap. Ia adalah perwira pemberontak pertama yang bertugas di bawah komando sang pilot, tanda betapa jauh sang pilot telah naik sejak masa menangkap ikan untuk koloni. Gaya bicaranya di radio yang lugas dan profesional berbeda dengan candaan para pendamping sang pilot lainnya.", false],
	],
	"character/2": [
		[18, "", "[[character/2]] adalah anggota [[faction/rebels|perlawanan]] yang ditemui sang pilot di [[station/6]].", false],
		[19, "", "Ia adalah pemimpin gerakan itu, seorang perempuan yang lebih tua yang mengambil alih misi-misi sang pilot sejak pertemuan pertama mereka. Tenang, hangat, dan teguh, ia mengarahkan perjuangan gerakan itu melawan kekuasaan kolonial.", false],
		[21, "Latar belakang", "Gerakan yang dipimpin [[character/2]] memandang dirinya sebagai persatuan orang-orang yang menentang kehancuran planet. Menurutnya, cepatnya kolonisasi dan panen laut yang kejam tidak menyisakan waktu bagi tumbuhan dan hewannya untuk pulih, dan dunia-dunia lain sudah terkuras dengan cara yang sama. Strateginya adalah merangkul orang-orang yang menjalankan stasiun alih-alih bertempur.", false],
		[23, "", "Ia mengenal [[character/9]] dari masa lalu. Orang itu bukan siapa-siapa ketika pertama kali ia mengenalnya, dan ia yakin kenaikan pangkatnya berkat koneksi yang tepat, bukan bakat.", false],
		[31, "", "Ia memiliki jaringan informan di antara stasiun-stasiun dan wewenang untuk memindahkan ilmuwan, uang, dan kapal ke seluruh zona pemberontak.", false],
		[19, "Peran dalam cerita", "Perintah pertama [[character/2]] adalah misi pengawalan: sang pilot harus melindungi sekawanan [[species/10|cumi-cumi warna]] dari pemburu kolonis ([[chapter/19]]). Ia tidak menyinggung bayaran dan hanya sedikit membicarakan rencana gerakan itu, tampaknya untuk menguji apakah si pendatang baru dapat dipercaya. Sang pilot mengaku mengira pemimpinnya laki-laki, dan ia membiarkannya begitu saja.", false],
		[20, "", "Ia memberi imbalan sederhana untuk pekerjaan itu dan segera memanggil sang pilot kembali untuk tugas berikutnya.", false],
		[21, "", "Ketika sang pilot meminta jawaban, ia menjelaskan tujuan gerakan itu. Ia juga memutuskan bahwa para bajak laut, yang memanfaatkan konflik, perlu diberi pelajaran, dan mengirim sang pilot bersama petarung terbaiknya, [[character/3]], melawan sebuah geng di dekat [[station/8]] ([[chapter/21]]).", false],
		[22, "", "Ia membagi imbalan sama rata antara kedua pilot, yang membuat [[character/3]] kesal, lalu melanjutkan ke perundingan di [[station/9]].", false],
		[23, "", "Di sana ia mengirim sang pilot untuk membersihkan ladang ranjau yang dipasang [[character/9]] di jalur pasokan ke [[station/37]], sambil memperingatkan soal bajak laut dan ranjau yang baru dapat dihancurkan setelah terpicu ([[chapter/23]]).", false],
		[25, "Penyergapan", "Tujuan [[character/2]] berikutnya adalah [[station/10]], tempat perundingan lanjutan diharapkan menarik lebih banyak stasiun ke pihak pemberontak. Ia membawa [[character/3]], [[character/5]], dan sang pilot sebagai pengawal dan mengabaikan keraguan sang pilot terhadap [[character/3]], dengan menyebutnya keras kepala tetapi pilot yang hebat ([[chapter/25]]).", false],
		[25, "", "Setibanya di sana mereka mendapati [[character/9]] sudah menunggu bersama pasukannya. [[character/2]] terkejut bahwa rencana mereka sudah diketahui sebelumnya.", false],
		[26, "", "[[character/3]] kabur dari pertempuran, dan hanya sang pilot dan [[character/5]] yang berdiri di antara [[character/2]] dan para kolonis. Sesudahnya ia menduga-duga adanya sabotase, tetapi menolak memercayai tuduhan [[character/5]] bahwa [[character/3]] adalah pengkhianat. Ia bersembunyi, menyerahkan kendali di [[station/9]] kepada [[character/5]], dan memperingatkan sang pilot bahwa diplomasi saja mungkin tidak cukup untuk memenangkan perang ([[chapter/26]]).", false],
		[28, "Penawanan", "Kepercayaannya pada [[character/3]] ternyata salah alamat. Orang itu menawannya dan menawarkannya kepada [[character/9]]. Saat konfrontasi di dekat [[station/11]], ia mendesak sang pilot untuk tidak memedulikan keselamatannya. Sang pilot menyelamatkannya dari ruang kargo kapal [[character/3]] yang hancur, dan ia tiba di [[station/12]] dalam keadaan terguncang tetapi tidak terluka ([[chapter/28]]).", false],
		[29, "", "Bahkan saat itu ia lebih dulu memikirkan gerakannya. Sebelum ditawan ia telah mengatur pemindahan sekelompok ilmuwan ke [[station/14]], dan ia segera mengirim sang pilot untuk melindungi konvoi mereka, khawatir [[character/3]] juga telah mengkhianatinya ([[chapter/29]]).", false],
		[31, "Rencana tiga langkah", "Di [[station/14]], [[character/2]] membuka rencananya. Pemberontak makin sering bentrok dengan armada kolonial yang jumlahnya masih lebih besar, jadi ia telah membawa [[world/abel]] dan timnya untuk membangun senjata. Pekerjaan itu terdiri atas tiga langkah, dan yang pertama adalah sumber daya, yaitu [[world/biotek]] yang dicuri kolonis dari sang profesor. Ia pergi menemuinya sementara [[character/5]] mengatur penyergapan ([[chapter/31]]).", false],
		[33, "", "Untuk langkah kedua ia menginginkan sebuah [[world/eclipse|Eclipse]], meriam yang biasanya dipakai untuk mempertahankan stasiun. Pembuat terdekatnya, [[station/188]], berada di tangan kolonis dan senjata itu tidak dijual, jadi ia memberi sang pilot dana suap yang besar dan mengakui bahwa rencananya hanya sampai di situ ([[chapter/33]]).", false],
		[39, "", "Ketika meriam itu tiba, ia memilih tidak tahu bagaimana meriam itu didapat dan berharap tidak ada darah yang tertumpah. Ia tersinggung ketika sang pilot berkelakar bahwa rencana itu bisa dipakai untuk menguasai planet. Untuk langkah terakhir ia meneruskan penjelasan sang profesor tentang inkubator, dengan terus terang mengakui bahwa ia tidak memahaminya, dan mengirim sang pilot ke [[station/16]] ([[chapter/39]]).", false],
		[43, "Serangan terakhir", "Ketika kolonis melancarkan serangan mendadak ke [[station/14]], [[character/2]] awalnya yakin bahwa semuanya sudah berakhir ([[chapter/43]]).", false],
		[44, "", "Ia selamat, dan menganggap sang pilot dan para [[world/aquarians|Aquarian]] sebagai penyelamat stasiun.", false],
		[45, "", "Ia menyambut seorang utusan [[world/aquarians|Aquarian]], yang membawa kabar bahwa bangsanya akan membantu melawan koloni. Dengan [[station/188]] kini di tangan pemberontak, ia berencana mempersenjatai sebanyak mungkin kapal dengan [[equipment/42]] dan melancarkan dua serangan sekaligus: sang pilot harus merebut [[station/18]], sementara [[character/5]] menyerang [[station/109]] ([[chapter/45]]). Ia menggoda sang pilot yang mengkhawatirkan [[character/5]].", false],
		[47, "", "Untuk serangan terakhir ke [[station/0]], ia sendiri terjun ke pertempuran ([[chapter/47]]).", false],
		[48, "", "Setelah kemenangan ia berterima kasih kepada sang pilot dan [[character/5]], dan mengakui bahwa planet ini butuh waktu lama untuk pulih.", false],
		[19, "Kepribadian", "[[character/2]] hangat dan tenang, dan ia menyapa para agennya yang lebih muda seolah-olah mereka anaknya sendiri. Ia menuntut banyak dan membayar sedikit.", false],
		[26, "", "Kesetiaannya kepada orang-orangnya nyaris berlebihan. Ia membela [[character/3]] lama setelah orang lain mulai curiga.", false],
		[28, "", "[[character/3]] menyebutnya pemimpi yang terlalu tua untuk tugasnya, penilaian yang tidak dibuktikan oleh kelanjutan cerita.", false],
		[33, "", "Rencananya lebih sering berani daripada terperinci, dan ia mengandalkan para agennya untuk berimprovisasi. Ia lebih menyukai diplomasi dan berharap menghindari pertumpahan darah, tetapi menerima bahwa gerakan itu harus bertempur.", false],
		[19, "Hubungan", "Ia makin memercayai sang pilot melebihi hampir siapa pun, dan sang pilot membalas kepercayaan itu.", false],
		[21, "", "Ia menghargai [[character/3]] sebagai pilot terbaiknya.", false],
		[23, "", "Ia hanya punya rasa jijik terhadap [[character/9]].", false],
		[25, "", "Ia memperlakukan [[character/5]] sebagai wakil tepercaya dan menyerahkan kendali kepadanya selama ia tidak ada.", false],
		[31, "", "[[character/4]] bekerja di bawahnya sebagai ahli teknik, dan [[world/abel]] membangun senjatanya.", false],
	],
	"character/3": [
		[21, "", "[[character/3]] adalah salah satu pilot terbaik [[character/2]], petarung berbakat yang congkak, yang dipasangkannya dengan sang pilot untuk menyerbu sebuah geng bajak laut di dekat [[station/8]].", false],
		[21, "Kepribadian", "[[character/3]] tidak sabaran dan suka membual. Ia memarahi sang pilot karena datang terlambat, mengaku bisa menyelesaikan tugas itu sendirian, dan menyuruh sang pilot tetap di belakangnya dan belajar. [[character/1]] terkesan oleh reputasinya, meski tidak oleh tingkah lakunya.", false],
		[22, "", "Ia tidak menghormati pendatang baru dan mengejek sang pilot sebagai anak nelayan.", false],
		[28, "", "Pada dasarnya ia seorang tentara bayaran. Ia mengukur kesetiaan dengan uang dan tidak peduli pada cita-cita yang menggerakkan gerakan itu.", false],
		[21, "Peran dalam cerita", "[[character/2]] memperkenalkan [[character/3]] sebagai salah satu pilot terbaiknya dan mengirim sang pilot pergi bersamanya melawan bajak laut ([[chapter/21]]). Ia sudah menunggu di sasaran, kesal karena keterlambatan itu.", false],
		[22, "", "[[character/3]] adalah pilot yang cakap, dan setelah pertempuran ia memberi sang pilot pujian setengah hati yang dibungkus hinaan. Ketika [[character/2]] membagi imbalan sama rata, ia marah besar, bersikeras bahwa sang pilot hampir tidak berbuat apa-apa, dan mengeluh bahwa sang pemimpin menghamburkan uang untuk pemula.", false],
		[25, "", "[[character/2]] memilihnya sebagai pengawal ke [[station/10]]. Sang pilot tidak senang, tetapi ia menjamin orang itu sebagai keras kepala namun cakap ([[chapter/25]]).", false],
		[26, "Penyergapan", "Ketika pasukan [[character/9]] melancarkan penyergapan di [[station/10]], [[character/3]] tidak melepaskan satu tembakan pun. Ia mengaku senjatanya rusak, meminta maaf, lalu kabur. [[character/5]] yakin ia telah mengkhianati mereka, sementara [[character/2]] menduga ada sabotase tetapi tetap membelanya.", false],
		[27, "Pengkhianatan", "Beberapa waktu kemudian ia menghubungi sang pilot, dengan cemas menanyakan kabar [[character/2]] dan [[character/5]], dan mengaku punya berita penting. Ia meminta bertemu di dekat [[station/11]]. [[character/1]] yakin itu jebakan ([[chapter/27]]).", false],
		[28, "", "Memang benar. [[character/3]] telah menawan [[character/2]] dan mengancam akan membunuhnya jika sang pilot tidak menyerah. Ia menjelaskan alasannya dengan terbuka: menurutnya [[character/2]] seorang pemimpi yang terlalu tua untuk memimpin, dan [[character/9]] telah memasang hadiah buruan besar atas dirinya dan sang pilot. Ia mengaku tidak tahu mengapa [[character/9]] takut pada sang pilot dan tidak peduli. [[character/2]] membayar buruk, katanya, jadi ia berganti majikan, dan ia mengabaikan omongan sang pilot tentang cita-cita.", false],
		[28, "", "Sementara ia berbicara, [[character/1]] memindai kapalnya yang berkursi tunggal dan menyimpulkan di mana [[character/2]] berada. Sang pilot lalu menyerang. [[character/3]] cepat dan percaya diri sampai akhir, tetapi kapalnya hancur. Sang pilot mengambil ruang kargonya yang berzirah dengan [[character/2]] masih hidup di dalamnya, dan [[character/3]] tenggelam bersama kapalnya di dekat [[station/11]].", false],
		[28, "", "Jika dilihat kembali, kerusakan senjatanya di [[station/10]] tampak seperti sandiwara. Tidak ada apa pun dalam cerita yang menunjukkan bahwa permintaan maafnya tulus.", false],
		[29, "", "Pengkhianatannya meninggalkan bayang-bayang panjang. [[character/2]] khawatir ia telah membocorkan kabar tentang konvoi para ilmuwan sebelum tewas ([[chapter/29]]).", false],
		[47, "", "Dalam pertempuran terakhir [[character/9]] melontarkan ancaman yang dikenali sang pilot sebagai ucapan terakhir [[character/3]]. Begitu tahu bahwa sang pilot membunuhnya, [[character/9]] mengaku bahwa [[character/3]] adalah saudara laki-laki sang pilot. Kebohongan itu langsung gagal.", false],
		[21, "Hubungan", "[[character/2]] memercayainya sepenuhnya dan menilai kemampuannya di atas pilot-pilotnya yang lain.", false],
		[22, "", "Ia memperlakukan sang pilot dengan hina sejak awal.", false],
		[26, "", "[[character/5]] tidak memercayainya dan menjadi orang pertama yang menyebutnya pengkhianat.", false],
		[28, "", "Pada akhirnya ia menjual dirinya kepada [[character/9]], orang yang dilawan rekan-rekannya.", false],
	],
	"character/4": [
		[12, "", "[[character/4]] adalah anggota [[faction/rebels|perlawanan]] yang bermarkas di [[station/3]].", false],
		[13, "", "Ia adalah pemberontak pertama yang ditemui sang pilot secara langsung. Ia menyaring calon anggota baru dan memberikan tugas pertama mereka.", false],
		[13, "Menguji sang pilot", "Ketika sang pilot tiba di [[station/3]], [[character/4]] membuka dengan serangkaian pertanyaan berbelit tentang apa yang diketahui si pendatang baru dan dari mana. Sang pilot mengaku tidak tahu apa-apa selain desas-desus tentang perlawanan yang membela perdagangan bebas. [[character/4]] skeptis, tetapi ia mencatat bahwa gerakan itu baru mulai menyandikan lalu lintas radionya dua hari sebelumnya, sehingga cerita itu masuk akal ([[chapter/12]]).", false],
		[13, "", "Karena kekurangan waktu dan orang, [[character/4]] menerima sang pilot dengan masa percobaan. Ia menjelaskan bahwa pemberontak berencana menyusup ke stasiun-stasiun kolonis dan merangkul para pemimpinnya, karena eksploitasi planet harus dihentikan. Ia menolak berkata lebih banyak kepada orang asing, dan memberi sang pilot tugas pertama: membawa para simpatisan dari [[station/4]] ke [[station/5]] ([[chapter/13]]).", false],
		[17, "Menyebarkan revolusi", "Kemudian [[character/4]] memanggil sang pilot kembali ke [[station/3]] dengan pesan yang begitu panjang sehingga [[character/1]] hanya membacakan intinya ([[chapter/17]]).", false],
		[18, "", "Secara langsung ia melaporkan bahwa diplomasi telah menarik banyak stasiun ke pihak pemberontak, sehingga sang pilot kini dapat berdagang di wilayah yang lebih luas. Pers sudah membicarakan revolusi, dan [[character/4]] setuju dengan sebutan itu. Sejauh ini belum ada darah yang tertumpah, meski ia memperkirakan hal itu akan berubah. Ia memberi tahu sang pilot bahwa pemimpin gerakan berada di salah satu stasiun yang baru direbut dan akan menghubunginya, serta memperingatkan bahwa sebagian stasiun hanya dapat dicapai dengan zirah atau perisai yang lebih baik; lihat [[guide/depth]] ([[chapter/18]]).", false],
		[31, "Penyergapan konvoi", "[[character/4]] berada di [[station/14]] ketika sang pilot tiba setelah mengawal para ilmuwan. Ia telah menyiapkan pidato terima kasih tetapi tidak sempat menyampaikannya, dan kemudian kalimatnya kembali terpotong di tengah jalan saat sang pilot bergegas ke kapal. Ia bertempur bersama sang pilot dan [[character/5]] melawan konvoi kolonis yang membawa [[world/biotek]] ([[chapter/31]]).", false],
		[32, "", "Ketika awak konvoi memohon bahwa mereka hanya membawa makanan dan obat-obatan, [[character/4]] menjawab lewat radio bahwa justru itulah yang dibutuhkan pemberontak. [[character/5]] berkomentar bahwa ia ternyata cukup jenaka.", false],
		[33, "", "Sesudahnya [[character/2]] menyerahkan hanggar kepadanya, tempat banyak pekerjaan menunggu. Ia juga menyebutnya sebagai orang yang perlu ditanya tentang sisi teknis pemasangan [[world/eclipse|Eclipse]] pada kapal ([[chapter/33]]).", false],
		[13, "Kepribadian", "[[character/4]] berhati-hati, formal, dan tertutup. Ia memberi perintah sebelum penjelasan dan hanya membagikan rencana gerakan kepada mereka yang layak mendapatkannya.", false],
		[18, "", "Ia juga bertele-tele, sifat yang diejek [[character/1]] setiap kali ia berbicara.", false],
		[32, "", "Di balik sikapnya yang kaku tersimpan selera humor yang kering dan pandangan yang realistis tentang perang yang akan datang.", false],
		[13, "Hubungan", "[[character/4]] adalah kontak pertama sang pilot di dalam gerakan. Kepercayaannya tumbuh seiring sang pilot membuktikan diri dapat diandalkan.", false],
		[19, "", "Ia bekerja di bawah [[character/2]] dan meneruskan perintah-perintahnya.", false],
		[32, "", "Ia bertempur bersama [[character/5]], yang menggodanya karena lelucon-leluconnya.", false],
	],
	"character/5": [
		[13, "", "[[character/5]] adalah anggota [[faction/rebels|perlawanan]] yang harus dijemput sang pilot dari [[station/4]].", false],
		[14, "", "Ceria, hangat, dan murah senyum, ia menjadi salah satu sekutu terdekat sang pilot. Sang pilot terpikat kepadanya sejak saat pertama, yang membuat [[character/1]] terus-menerus kesal.", false],
		[14, "Pertemuan pertama", "[[character/5]] menyambut sang pilot dengan hangat di [[station/4]] dan terburu-buru ingin berangkat. Ketika sang pilot bertanya tentang gerakan itu, ia menjelaskan bahwa anggota baru sengaja tidak diberi tahu demi keselamatan mereka sendiri dan gerakan. Ia mengirim tujuannya ke komputer kapal dan menegaskan bahwa perjalanan harus cepat ([[chapter/13]]).", false],
		[15, "", "Di [[station/5]] ia bersembunyi untuk membereskan beberapa urusan. Sebelum pergi ia menjelaskan perbedaan pemberontak dengan kolonis: mereka hidup dari apa yang diberikan laut alih-alih mengurasnya, mengolah hasil tangkapan menjadi barang, dan berhati-hati agar tidak menangkap ikan berlebihan. Ia meminta sang pilot mencoba cara hidup ini dengan memproduksi lima ton barang, dan menyarankan [[station/90]], tempat cumi-cumi dan [[goods/35]] dapat diolah menjadi [[goods/22]] ([[chapter/14]]).", false],
		[16, "", "Setelah barang itu selesai dibuat, ia menghubungi lagi dengan tugas baru. Gerakan itu membutuhkan informasi terbaru dari setiap stasiun untuk menemukan titik lemah koloni, karena menurutnya senjata saja tidak akan membawa kemenangan. Ketika ditanya apakah pemberontak merencanakan revolusi, ia menolak berkata lebih banyak ([[chapter/15]]).", false],
		[25, "Reuni dan penyergapan", "Sang pilot bertemu [[character/5]] lagi di [[station/9]], tempat keduanya bertukar pujian dengan canggung. [[character/2]] memotong reuni itu dan menugaskan mereka berdua mengawal dirinya dan [[character/3]] ke [[station/10]] ([[chapter/24]]).", false],
		[25, "", "[[character/5]] adalah yang pertama merasakan ada yang tidak beres saat mereka tiba.", false],
		[26, "", "Selama penyergapan ia melihat bahwa [[character/3]] tidak bertempur dan berteriak memanggilnya saat ia kabur. Sesudahnya ia terang-terangan menuduhnya berkhianat dan meminta dukungan sang pilot. [[character/2]] menyerahkan kendali di [[station/9]] kepadanya selama ia pergi ([[chapter/25]]).", false],
		[31, "Rencana tiga langkah", "Di [[station/14]], [[character/5]] sudah mendengar kisah penyelamatan [[character/2]]. Ia memberi pengarahan kepada sang pilot tentang langkah pertama rencana itu: seorang informan melaporkan bahwa [[world/biotek]] sedang dikirim ke Maarth, tersembunyi di antara muatan biasa. Karena tidak ada yang tahu kapal mana yang membawanya, ia memerintahkan serangan terhadap seluruh konvoi di dekat [[station/2]] ([[chapter/30]]).", false],
		[32, "", "Ia memimpin pencegatan itu dan memastikan setiap kontainer berhasil diambil ([[chapter/31]]).", false],
		[33, "", "[[character/2]] kemudian memberinya tugas berpatroli di luar [[station/14]] untuk berjaga terhadap serangan mendadak.", false],
		[42, "", "Ketika sang pilot kembali membawa [[goods/36]], [[character/5]] sangat gembira. Ia melaporkan bahwa [[world/abel]] sudah menyiapkan segalanya, meneruskan perintah [[character/2]] untuk menguji meriam itu melawan bajak laut, dan mengingatkan sang pilot bahwa generator itu hanya prototipe ([[chapter/41]]).", false],
		[45, "Serangan besar", "Dalam serangan-serangan terakhir [[character/5]] memimpin serbuan ke [[station/109]] sementara sang pilot menyerang [[station/18]]. [[character/2]] menenangkan sang pilot bahwa ia adalah pilot cakap yang tahu apa yang ia lakukan ([[chapter/44]]).", false],
		[47, "", "Serangannya berhasil. Ia menghubungi sang pilot dengan kabar itu dan dengan perintah [[character/2]] untuk satu pertempuran terakhir di [[station/0]], lalu berangkat sendiri sambil menerobos bajak laut di perjalanan ([[chapter/46]]).", false],
		[48, "", "Di [[station/0]] ia bertempur di samping [[character/2]] dan sang pilot. Setelah kemenangan ia mengajak sang pilot merayakannya dengan [[goods/21]], dan sang pilot menerima ([[chapter/47]]).", false],
		[14, "Kepribadian", "[[character/5]] ramah dan riang, dan gemar memakai satu ungkapan persetujuan singkat di setiap kesempatan. Ia juga bijaksana menjaga rahasia dan berkomitmen, dengan pandangan jelas tentang apa yang diperjuangkan gerakan itu.", false],
		[15, "", "Ia percaya pada hidup dari laut tanpa merusaknya, dan ia tahu cara menjelaskan gagasan itu dengan sederhana.", false],
		[26, "", "Ia cepat menilai orang, dan dalam kasus [[character/3]] penilaiannya tepat.", false],
		[14, "Hubungan", "Sang pilot tertarik kepadanya sejak awal, dan sepanjang kampanye perasaan itu jelas berbalas. [[character/1]] tak pernah berhenti menggerutu soal itu.", false],
		[25, "", "[[character/2]] memercayakan komando kepadanya dan memperlakukan dirinya dan sang pilot dengan geli penuh sayang.", false],
		[26, "", "Ia tidak pernah memercayai [[character/3]].", false],
		[32, "", "Ia bekerja erat dengan [[character/4]] dan merasa terhibur oleh humornya.", false],
	],
	"character/6": [
		[8, "", "[[character/6]] adalah nama yang dipakai untuk banyak pembicara kecil dari pihak [[faction/colonists]]: pejabat, pengurus, dan awak pengangkut dari [[world/colony|pemerintahan]] kolonial. Tak satu pun dari mereka bernama; bersama-sama mereka memperlihatkan bagaimana koloni memperlakukan orang luar yang bekerja untuknya.", false],
		[9, "Siapa yang berbicara", "Yang pertama adalah pejabat di [[station/1]] yang menerima sang pilot setelah pemusnahan [[species/0|nautilus]] ([[chapter/8]]). Pejabat itu lebih suka kata-kata halus untuk pekerjaan kotor, membayar sejumlah kecil yang tetap, dan menolak tawar-menawar. Sang pilot harus menyelesaikan tiga kontrak sebelum ditawari pekerjaan yang lebih baik.", false],
		[10, "", "Suara yang sama lalu menugaskan pertahanan kapsul di [[station/2]]. Koloni meluncurkan ekspornya ke orbit dalam kapsul, dan para [[world/aquarians|Aquarian]] terus menyerangnya, yang meresahkan otoritas perdagangan ([[chapter/9]]).", false],
		[32, "", "Jauh kemudian, awak sebuah konvoi kolonis di dekat [[station/2]] memohon agar pemberontak berhenti menembak, dengan mengatakan bahwa mereka hanya membawa makanan dan obat-obatan ([[chapter/31]]).", false],
	],
	"character/7": [
		[12, "", "[[character/7]] adalah nama yang dipakai untuk anggota [[faction/rebels]] tanpa nama yang berbicara dengan sang pilot: pengatur lalu lintas stasiun, penjaga, dan awak konvoi. Suara-suara mereka menandai kontak pertama sang pilot dengan gerakan itu dan kehidupan sehari-harinya.", false],
		[12, "Siapa yang berbicara", "Pemberontak pertama yang didengar sang pilot adalah penjaga di [[station/3]], yang memperingatkan bahwa kapal telah memasuki perairan netral dan mengancam akan menembak kecuali kapal itu memperkenalkan diri. Setelah keheningan panjang, sang pilot diizinkan berlabuh ([[chapter/12]]).", false],
		[17, "", "Ketika sang pilot kembali sebagai anggota yang telah diterima, stasiun menyapa sang pilot dengan namanya dan memberikan tempat labuh ([[chapter/17]]).", false],
		[29, "", "Kemudian, awak konvoi para ilmuwan di dekat [[station/13]] meminta bantuan dengan putus asa ([[chapter/29]]).", false],
		[30, "", "Sesudahnya mereka berterima kasih kepada sang pilot, dengan mengatakan bahwa mereka tidak akan selamat sendirian.", false],
	],
	"character/8": [
		[34, "", "[[character/8]] adalah pedagang yang ditemui sang pilot di [[station/15]] saat mencari cara mendapatkan [[world/eclipse|Eclipse]].", false],
		[35, "", "Ia adalah pedagang pasar gelap yang selalu menyebut dirinya sebagai orang ketiga dan mengaku dapat memasok hampir apa saja kepada pelanggan yang punya uang.", false],
		[35, "Latar belakang", "[[character/8]] berbisnis di [[station/15]], tempat perdagangan obat terlarang melanggar hukum. Kegiatannya membuatnya menjadi sasaran: otoritas keamanan stasiun telah menyewa pemburu hadiah [[character/11]] untuk menyingkirkannya. Ia punya kenalan di banyak tempat dan siap membayar suap untuk mendapatkan apa yang diinginkan kliennya.", false],
		[35, "Kesepakatan meriam", "Saat sang pilot melihat-lihat pasar setempat, tampaknya sedang membeli [[goods/37]], [[character/8]] menarik sang pilot ke samping dan memperingatkan bahwa perdagangan semacam itu ilegal di sini. Ketika ia menawarkan jasanya dan sang pilot meminta [[equipment/42]], ia tercengang dan bertanya apakah sang pilot hendak memulai perang. Sang pilot mengaku itu untuk keperluan pribadi. [[character/8]] bersedia mencarinya dengan satu syarat: sang pilot harus menemukan dan membunuh [[character/11]], yang sedang berpatroli di dekat stasiun ([[chapter/34]]).", false],
		[37, "", "Setelah [[character/11]] tewas, [[character/8]] memberi selamat kepada sang pilot dan menepati janjinya. Berkat kenalannya dan banyak suap, ia telah menemukan sebuah [[equipment/42]], yang ia tawarkan dengan harga tinggi yang tetap ia sebut murah. Ia mengungkapkan bahwa penjualnya adalah seorang pria bernama Dawn, dan ia tidak peduli soal nama selama barangnya bagus ([[chapter/36]]).", false],
		[37, "", "Penjualnya adalah [[character/9]]. [[character/1]] menunjukkan ironinya: keserakahan [[character/9]] telah menyerahkan senjata terpenting pemberontak ke tangan musuh-musuhnya. Sang pilot membeli meriam itu dan membawanya kembali ke [[station/14]] ([[chapter/37]]).", false],
		[35, "Kepribadian", "[[character/8]] cerdik, berhati-hati, dan tanpa belas kasihan. Ia berdagang barang ilegal dan meminta kematian seseorang semudah meminta bayaran. Ia waspada terhadap orang yang menguping, menarik sang pilot ke samping dan menyuruh sang pilot diam sebelum urusan apa pun dibicarakan. Bahkan dengan pelanggan yang membayar ia menimbang risikonya: awalnya ia tidak yakin apakah ia sebaiknya menjual senjata semacam itu kepada orang asing.", false],
		[37, "", "Namun dengan caranya sendiri ia dapat diandalkan: ia menepati kesepakatan begitu harganya dibayar, dan ia mendapatkan bagi sang pilot persis apa yang diminta. Kebiasaannya menyebut dirinya dengan nama, dan kebanggaannya mengenal orang yang tepat di tempat yang tepat, menjadikannya salah satu tokoh paling berwarna dalam kampanye.", false],
		[35, "Hubungan", "[[character/11]] adalah pemburunya dan, melalui tangan sang pilot, korbannya.", false],
		[37, "", "Ia berurusan dengan [[character/9]] maupun sang pilot, tanpa peduli di pihak mana mereka berada.", false],
	],
	"character/9": [
		[2, "", "[[character/9]], yang bernama keluarga Dawn, adalah pejabat kolonis di [[station/0]], tempat sang pilot menjual hasil tangkapan hari itu.", false],
		[3, "", "Sombong dan ambisius, ia memperlakukan orang-orang yang bekerja untuk koloni dengan penghinaan terang-terangan. Ia adalah majikan pertama sang pilot dan menjadi saingan abadi sang pilot.", false],
		[12, "Latar belakang", "[[character/9]] menganggap dirinya ditakdirkan untuk hal-hal yang jauh lebih besar daripada jabatannya di stasiun.", false],
		[23, "", "[[character/2]] mengenalnya saat ia masih orang yang tak berarti. Menurutnya, ia naik berkat koneksi yang baik, bukan karena jasa, dan pada masa pemberontakan ia memegang kekuasaan nyata di pasukan [[faction/colonists|kolonial]].", false],
		[3, "Pertemuan awal", "[[character/9]] membeli tangkapan pertama sang pilot dengan harga tetap dan mengejek palka kargo yang kecil. Ia menambahkan bahwa sang pilot lebih baik memburu [[faction/pirates|bajak laut]], meski ia ragu sang pilot juga akan mampu melakukannya ([[chapter/2]]).", false],
		[7, "", "Ketika sang pilot kembali dengan bersenjata, ia mengklaim jasanya dan menawarkan pekerjaan: membersihkan jalur-jalur di sekitar [[station/1]] dari [[species/0|nautilus]]. Ia menepis keberatan sang pilot dan tidak peduli bagaimana makhluk-makhluk itu disingkirkan ([[chapter/6]]).", false],
		[10, "", "Ia memimpin peluncuran kapsul di [[station/2]] dan memperingatkan sang pilot bahwa kehilangan lebih dari lima kapsul akan membuat sang pilot kehilangan pekerjaan ([[chapter/10]]).", false],
		[12, "", "Sesudahnya ia menyalahkan sang pilot atas kapsul yang rusak dan menahan imbalan. Penghinaannya menjadi pemicu terakhir yang mendorong sang pilot ke pihak perlawanan ([[chapter/11]]).", false],
		[23, "Melawan pemberontakan", "[[character/9]] berbalik melawan pemberontak seiring makin besarnya mereka. Ia menyuruh memasang ladang ranjau di jalur pasokan mereka dari [[station/9]] ke [[station/37]] ([[chapter/22]]).", false],
		[25, "", "Ia sudah menunggu bersama pasukannya ketika [[character/2]] tiba untuk berunding di [[station/10]], dan langsung memerintahkan serangan ([[chapter/25]]).", false],
		[28, "", "Dialah penyandang dana di balik pengkhianatan [[character/3]]. Ia telah menawarkan hadiah buruan besar untuk [[character/2]] dan sang pilot, tampaknya karena menganggap sang pilot sebagai ancaman ([[chapter/27]]).", false],
		[37, "", "Keserakahannya menjadi kejatuhannya. Ia menjual sebuah meriam [[world/eclipse|Eclipse]] kepada pedagang pasar gelap [[character/8]], yang kemudian menjualnya kepada sang pilot ([[chapter/36]]).", false],
		[43, "Kekalahan", "[[character/9]] memimpin serangan mendadak kolonis ke [[station/14]]. Ia mengejek sang pilot sebagai nelayan untuk pemberontak dan tercengang saat tahu bahwa sang pilot membawa [[equipment/42]] ([[chapter/43]]).", false],
		[44, "", "Ketika para [[world/aquarians|Aquarian]] ikut bertempur melawan kapal-kapalnya, ia meninggalkan serangan itu dan melarikan diri.", false],
		[47, "", "[[character/9]] melakukan perlawanan terakhirnya di [[station/0]], benteng terakhir koloni. Mendengar bahwa sang pilot membunuh [[character/3]], ia mengaku bahwa [[character/3]] adalah saudara laki-laki sang pilot dan bahwa dirinya adalah ayah sang pilot. Sang pilot langsung melihat kebohongan itu, dan [[character/9]] mengakui bahwa tipuannya hampir berhasil ([[chapter/47]]).", false],
		[48, "", "Dalam pertempuran berikutnya, [[character/9]] menjadi kolonis terakhir yang tersisa. Ia melarikan diri dengan kapsul penyelamat, tampaknya membawa serta seluruh stasiun, dan meninggalkan samudra dengan cemoohan perpisahan terhadap ikan dan orang-orang yang tetap tinggal.", false],
		[3, "Kepribadian", "[[character/9]] kasar, merasa diri penting, dan meremehkan siapa pun yang berada di bawahnya.", false],
		[12, "", "Ia melimpahkan kesalahan kepada orang lain dan mengklaim jasa ketika semuanya berjalan baik.", false],
		[37, "", "Keserakahannya lebih besar daripada kesetiaannya pada pihaknya sendiri.", false],
		[47, "", "Ia seorang manipulator yang memakai kebohongan dan suap alih-alih keberanian, dan ia kabur setiap kali pertempuran berbalik melawannya.", false],
		[3, "Hubungan", "Cemoohannya terhadap sang pilot dimulai sejak pertemuan pertama dan sepanjang kampanye mengeras menjadi permusuhan terbuka.", false],
		[23, "", "[[character/2]] sudah lama membencinya.", false],
		[28, "", "Ia membeli kesetiaan [[character/3]] dengan hadiah buruan.", false],
		[37, "", "Ia berbisnis dengan [[character/8]] tanpa tahu ke mana barangnya akan berakhir.", false],
	],
	"chart": [
		[1, "", "Peta ini menampilkan semua dua ratus stasiun sebagai titik di posisinya pada peta samudra. Titik biru dikuasai [[faction/colonists]], titik oranye dikuasai [[faction/rebels]], sesuai bab yang telah Anda capai. Setiap stasiun berawal biru; stasiun berubah oranye seiring cerita berlanjut dan tidak pernah kembali.", false],
		[1, "", "Di halaman stasiun atau bab, stasiun yang dimaksud digambar lebih besar dan diberi label, dan stasiun yang bergabung dengan pemberontak di bab itu diberi garis tepi. Di bawah peta, setiap stasiun dicantumkan dengan tautan ke halamannya. Jarak antarstasiun diukur dalam satuan peta; lihat [[guide/navigation]].", false],
	],
	"contract/0": [
		[1, "", "Lacak satu kapal buronan yang menunggu 400 sampai 1.200 m dari stasiun dan hancurkan. Target ini jauh lebih tangguh daripada bajak laut biasa, dan kekuatannya bertambah seiring peringkat sang pilot. Senjata jarak jauh dan torpedo membantu melemahkannya sebelum ia mendekat. Hadiahnya dibayarkan saat kembali ke stasiun.", false],
	],
	"contract/1": [
		[1, "", "Sebuah geng berisi tiga sampai enam kapal menunggu di sepanjang rute yang berkelok. Targetnya adalah kapal terakhir, di titik tujuan terakhir. Target ini tidak bisa sekadar dihancurkan: lumpuhkan, lalu tarik dengan harpun sebelum kabur. Bersihkan pengawalnya terlebih dahulu agar penarikan tidak terganggu.", false],
	],
	"contract/10": [
		[1, "", "Hancurkan setiap ranjau di ladang berisi 15 sampai 25 ranjau, dua sampai enam ratus meter dari stasiun, yang dijaga satu kapal. Ranjau hanya dapat ditembak dari jarak dekat, jadi dekati masing-masing dengan hati-hati. Perisai dan zirah yang kuat membantu menyerap ledakannya.", false],
	],
	"contract/11": [
		[1, "", "Kapsul pasokan sedang diserang. Hancurkan para penyerang selagi cukup banyak kapsul selamat untuk memenuhi batas minimum kontrak. Perhatikan jumlah kapsul dan hadapi lebih dulu penyerang yang sedang mendekati kapsul. Pekerjaan ini membayar sekitar 30% lebih banyak daripada kontrak dasar.", false],
		[10, "", "Para penyerangnya adalah Aquarian, penghuni laut setengah manusia yang mengincar kapsul pengangkut milik kolonis.", false],
	],
	"contract/12": [
		[1, "", "Hancurkan sejumlah kapsul pasokan yang dijaga kapal bersenjata, dengan pasukan sekutu bertempur bersama Anda. Dalam praktiknya tidak ada stasiun yang memasang pekerjaan ini di papannya, sehingga pekerjaan ini tidak dapat diambil. Pekerjaan ini muncul di referensi hanya karena didefinisikan bersama jenis kontrak lainnya.", false],
	],
	"contract/13": [
		[1, "", "Produksi sejumlah produk tertentu dan antarkan ke stasiun yang memasang pekerjaan itu. Imbalannya bergantung pada nilai produk dan jumlah yang diminta. Hadiahnya sering sangat besar, dan hanya separuh deposit biasa yang diperlukan. Periksa resepnya terlebih dahulu dan kumpulkan bahan sebelum menerima. Pekerjaan ini hanya muncul di stasiun setelah dua puluh stasiun pertama di peta.", false],
		[12, "", "Hanya stasiun pemberontak yang memasang pekerjaan ini.", false],
	],
	"contract/14": [
		[1, "", "Antarkan jumlah yang tepat dari makhluk atau alga tertentu ke stasiun yang memasang pekerjaan. Jumlahnya berkisar dari 3 sampai 24 unit, dan depositnya separuh dari biasanya. Spesies umum lebih sering diminta daripada yang langka. Radar pancing dan palka besar membuat pekerjaan ini mudah. Pekerjaan ini hanya muncul di stasiun setelah dua puluh stasiun pertama.", false],
		[12, "", "Hanya stasiun pemberontak yang memasang pekerjaan ini.", false],
	],
	"contract/2": [
		[1, "", "Sebuah kapal penculik menahan seorang sandera. Seperti pekerjaan pengambilan kapal, target ini berlayar bersama geng di sepanjang rute yang berkelok dan harus dilumpuhkan, lalu ditarik dengan harpun. Pekerjaan gagal jika target lolos. Pasang harpun dengan jangkauan yang baik dan habisi pengawalnya sebelum beralih ke penculik.", false],
	],
	"contract/3": [
		[1, "", "Buru setiap bajak laut dalam geng berisi tiga sampai enam kapal, yang tersebar di titik-titik tujuan sebuah rute berkelok. Pekerjaan selesai saat tidak ada yang tersisa. Ini kontrak yang sederhana bagi kapal bersenjata, dan ukuran gengnya bertambah sesuai tingkat kesulitan pekerjaan.", false],
	],
	"contract/4": [
		[1, "", "Lima kapal barang berlayar di jalur yang sudah ditentukan, dan para perompak mengintai di sepanjang jalan. Pekerjaan berhasil saat semua penyerang dihancurkan. Pekerjaan gagal jika semua kapal barang hilang. Pengawalan membayar sekitar 30% lebih banyak daripada perburuan bajak laut biasa. Tetaplah dekat dengan konvoi dan hadapi perompak sebelum mereka mencapainya.", false],
	],
	"contract/5": [
		[1, "", "Serang konvoi berisi dua atau tiga kapal barang di sebuah titik tujuan dan hancurkan, meskipun dijaga pengawal bersenjata. Hanya kapal barang yang perlu dihancurkan, jadi memusatkan tembakan pada kapal barang dapat menyelesaikan pekerjaan lebih cepat. Torpedo atau senjata jarak jauh membantu menghabisinya satu per satu selagi pengawal mendekat.", false],
	],
	"contract/6": [
		[1, "", "Sekawanan 15 sampai 24 makhluk berenang di jalur yang sudah ditentukan, dan para pemburu menyerangnya di sepanjang jalan. Hancurkan para pemburu sebelum kerugian melampaui batas yang disepakati. Jangan pernah menembak di dekat kawanan: tembakan nyasar dihitung sebagai kerugian. Pekerjaan ini membayar sekitar 30% lebih banyak daripada kontrak dasar.", false],
		[12, "", "Hanya stasiun pemberontak yang memasang pekerjaan ini, dan mereka berhenti memasangnya setelah cerita selesai.", false],
	],
	"contract/7": [
		[1, "", "Bunuh sejumlah individu dari satu spesies di antara satwa liar setempat selagi kapal musuh berusaha mengganggu. Tangkapan dengan harpun tidak dihitung; makhluk itu harus dibunuh. Radar pancing membantu menemukan spesies yang tepat dengan cepat. Pekerjaan ini membayar sekitar 20% lebih banyak daripada kontrak dasar.", false],
	],
	"contract/8": [
		[1, "", "Antar seorang penumpang ke stasiun lain. Sebagian penumpang menetapkan jumlah maksimum lompatan S.T.R.E.A.M., dan makin sedikit yang diizinkan, makin tinggi imbalannya. Kontrak hangus jika batas itu dilampaui. Mesin yang baik membantu di sini, karena jangkauan yang lebih jauh berarti lebih sedikit lompatan.", false],
	],
	"contract/9": [
		[1, "", "Bersihkan ladang puing berisi 15 sampai 30 kepingan, dua sampai enam ratus meter dari stasiun, dalam waktu sekitar dua setengah menit. Kapal musuh ringan mungkin hadir. Bayarannya sekitar 30% lebih rendah daripada kontrak lain, tetapi pekerjaannya cepat. Booster dan senjata tembak cepat menghemat detik-detik berharga.", false],
	],
	"equipment/0": [
		[1, "", "Senjata tingkat pemula: 3 kerusakan per tembakan setiap 0,56 dtk, dengan jangkauan 228 m. Daya pukulnya sangat kecil, tetapi dengan harga sekitar 5.700 cr ini senjata termurah dan salah satu yang paling umum di toko. Beberapa dapat dipasang sekaligus, dan semua senjata menembak bersamaan, jadi dua atau tiga buah membentuk rangkaian senjata awal yang memadai sampai senjata yang lebih berat terjangkau.", false],
		[3, "", "Di [[chapter/3]] sang pilot harus memasang satu sebelum meninggalkan [[station/0]].", false],
	],
	"equipment/1": [
		[1, "", "Railgun menengah ini menggandakan kerusakan [[equipment/0]] menjadi 6 per tembakan dan menembak sedikit lebih cepat, setiap 0,48 dtk, hingga 260 m. Dengan harga kira-kira dua kali lipat, kerusakan berkelanjutannya lebih dari dua kali lipat. Ini pilihan masuk akal sebagai senjata kedua di bab-bab awal, sebelum meriam fusi muncul di toko.", false],
	],
	"equipment/10": [
		[1, "", "Mass driver ini memukul 20 setiap 0,40 dtk dengan jangkauan 280 m, menghasilkan kerusakan berkelanjutan tertinggi dari semua senjata yang dijual bebas. Jangkauannya juga melampaui semua meriam fusi. Siapkan 42.000 sampai 51.000 cr. Untuk lambung tempur dengan slot cadangan, ini salah satu pilihan senjata terbaik.", false],
	],
	"equipment/11": [
		[1, "", "Mass driver terberat memberi 25 per tembakan pada jarak 375 m, jangkauan terjauh di antara senjata tembak cepat. Dengan jeda 0,51 dtk, kerusakan berkelanjutannya kira-kira setara dengan [[equipment/10]]. Kelebihannya adalah jangkauan. Ini senjata paling langka dan paling mahal di toko, seharga 54.000 sampai 60.000 cr.", false],
	],
	"equipment/12": [
		[1, "", "Torpedo pencari dasar memberi 20 kerusakan dan mengarahkan dirinya sendiri ke target, hingga 215 m. Isi ulangnya hanya setiap 4,3 dtk. Hanya satu peluncur torpedo dari jenis apa pun yang dapat dipasang. Torpedo ini berguna melawan target lincah yang sulit dijaga dalam bidikan, tetapi jangkauannya pendek.", false],
	],
	"equipment/13": [
		[1, "", "Torpedo menengah memukul 30, terisi ulang dalam 4,0 dtk, dan menjangkau 360 m, lebih baik daripada [[equipment/12]] dalam segala hal. Hanya satu peluncur torpedo yang dapat dipasang, jadi torpedo ini menggantikan, bukan melengkapi, model yang lebih murah. Dengan harga 37.000 sampai 39.000 cr, ini penutup serbaguna yang baik.", false],
	],
	"equipment/14": [
		[1, "", "Torpedo teratas membawa hulu ledak 50 kerusakan hingga 816 m, pukulan tunggal terberat dari semua senjata yang dijual. Isi ulangnya butuh 6,8 dtk. Sebagai satu-satunya torpedo di kapal, torpedo ini cocok dipadukan dengan senjata cepat: satu pukulan jarak jauh di awal pertempuran, lalu senjata menuntaskan sisanya. Torpedo ini langka dan harganya 62.500 cr atau lebih.", false],
	],
	"equipment/15": [
		[1, "", "Harpun awal menjangkau 240 m dan memaafkan bidikan yang kurang tepat dengan toleransi tangkap 24 m, yang terlebar dari ketiganya. Harpun ini sama sekali tidak memperlambat tangkapan yang terkait, sehingga makhluk cepat menarik kuat dan lama lelahnya. Harpun ini memadai untuk alga dan hewan lamban, dan murah untuk diganti.", false],
	],
	"equipment/16": [
		[1, "", "Harpun ini menjangkau 400 m dan memperlambat makhluk yang terkait sebesar 40%, sehingga tangkapan cepat seperti [[species/7]] jauh lebih mudah dijaga tetap terlihat. Toleransi tangkapnya menyempit menjadi 18 m, jadi bidikan lebih menentukan. Bagi pilot yang rutin memancing, ini peningkatan terpenting setelah palka yang lebih besar.", false],
	],
	"equipment/17": [
		[1, "", "Harpun terbaik menjangkau 560 m dan memperlambat tangkapan yang terkait sebesar 70%, sehingga makhluk cepat pun dapat ditaklukkan tanpa banyak pengejaran. Toleransi tangkapnya 14 m adalah yang tersempit, jadi harpun ini menguntungkan bidikan yang cermat. Harpun ini langka dan mahal, 69.000 sampai 83.000 cr, dan hanya satu harpun yang dapat dipasang.", false],
	],
	"equipment/18": [
		[1, "", "Perisai dasar menyerap 100 poin kerusakan sebelum zirah tersentuh. Perisai ini juga menetapkan batas dangkal kapal di 20.000 m. Perisai ini tidak pernah terisi ulang di lapangan; ia hanya dipulihkan saat kapal meninggalkan stasiun. Cukup untuk pertempuran awal, tetapi sebagian besar pilot menggantinya secepat mungkin.", false],
	],
	"equipment/19": [
		[1, "", "Perisai ini menyerap 175 poin, tiga perempat lebih banyak daripada [[equipment/18]], dan memungkinkan kapal naik hingga 18.400 m. Seperti model dasar, perisai ini tidak terisi ulang di lapangan. Dengan harga 15.750 sampai 18.000 cr, ini peningkatan perisai termurah yang layak dan membuka beberapa stasiun yang lebih dangkal.", false],
	],
	"equipment/2": [
		[1, "", "Railgun terberat memukul 9 per tembakan dengan jangkauan 322 m, tetapi siklusnya sedikit lebih lambat daripada [[equipment/1]], yaitu 0,62 dtk. Karena itu kerusakan berkelanjutannya hanya naik sedikit. Dengan harga 16.000 sampai 20.000 cr, senjata ini sepadan untuk jangkauannya, tetapi [[equipment/6]] memberi kerusakan yang jelas lebih besar dengan sedikit tambahan uang.", false],
	],
	"equipment/20": [
		[1, "", "Perisai ini menyerap 220 poin dan merupakan yang pertama terisi ulang di lapangan, memulihkan satu poin setiap 1,15 dtk selama kapal tetap di dalam rentang kedalamannya. Perisai ini menaikkan batas dangkal menjadi 16.800 m. Dengan harga lebih dari 56.000 cr, perisai ini jauh lebih mahal daripada [[equipment/19]], tetapi isi ulangnya membuat pertempuran panjang jauh lebih aman.", false],
	],
	"equipment/21": [
		[1, "", "Perisai terbaik menyerap 310 poin dan memulihkan satu poin setiap 0,65 dtk, hampir dua kali lebih cepat daripada [[equipment/20]]. Batas dangkalnya 15.000 m menjangkau lebih tinggi daripada perisai lain mana pun, sehingga membuka stasiun-stasiun paling dangkal. Perisai ini langka dan harganya 93.750 cr atau lebih, sebuah investasi untuk akhir kampanye.", false],
	],
	"equipment/22": [
		[1, "", "Zirah dasar menambah 100 poin perlindungan, yang terkuras setelah perisai habis dan sebelum lambung terkena. Zirah ini juga menetapkan batas dalam di 25.000 m. Zirah tidak pulih di lapangan. Pelat ini murah dan memadai di awal, tetapi banyak stasiun yang lebih dalam berada di luar jangkauannya.", false],
	],
	"equipment/23": [
		[1, "", "Zirah ini menambah 155 poin dan menurunkan batas dalam menjadi 26.800 m. Harganya kira-kira sama dengan [[equipment/19]], pasangan perisainya, dan bersama-sama keduanya memperlebar rentang kedalaman kapal ke dua arah. Ini peningkatan awal yang baik bagi pilot yang ingin mencapai stasiun yang lebih dalam.", false],
	],
	"equipment/24": [
		[1, "", "Zirah ini menambah 195 poin dan memungkinkan penyelaman hingga 28.400 m. Harganya jauh lebih mahal daripada [[equipment/23]], 56.000 sampai 72.000 cr, untuk tambahan perlindungan yang lebih kecil. Tambahan kedalaman sering kali menjadi alasan yang lebih kuat untuk membelinya, karena membuat banyak stasiun dalam dapat dijangkau.", false],
	],
	"equipment/25": [
		[1, "", "Zirah terbaik menambah 270 poin dan memungkinkan penyelaman hingga 30.000 m, batas terdalam yang tersedia. Zirah ini langka dan harganya 93.750 cr atau lebih. Dipadukan dengan [[equipment/21]], zirah ini memungkinkan kapal beroperasi di hampir seluruh rentang kedalaman stasiun.", false],
	],
	"equipment/26": [
		[1, "", "Modul kargo terkecil menambah 30% kapasitas dasar lambung. Beberapa modul dapat dipasang, dan bonusnya dijumlahkan. Karena bonusnya berupa bagian dari kapasitas dasar, modul ini memberi 7 t pada [[ship/0]] tetapi 54 t pada [[ship/6]]. Ini cara termurah untuk menambah ruang palka pada lambung besar.", false],
	],
	"equipment/27": [
		[1, "", "Modul ini menambah 50% kapasitas dasar lambung dan dapat ditumpuk dengan modul lain. Per kredit, modul ini sedikit kurang efisien daripada [[equipment/26]], tetapi menghemat slot, yang lebih penting pada lambung dengan sedikit slot cadangan. Pada [[ship/4]], satu modul menambah 35 t, cukup untuk membenarkan pemakaian slot dalam perjalanan dagang.", false],
	],
	"equipment/28": [
		[1, "", "Modul terbesar menambah 80% kapasitas dasar, terbanyak per slot dari semua modul kargo. Pada [[ship/6]] modul ini menambah 144 t. Beberapa dapat dipasang. Modul ini langka dan harganya 45.000 cr atau lebih, jadi terutama layak dibeli untuk lambung berpalka besar yang dikhususkan untuk berdagang.", false],
	],
	"equipment/29": [
		[1, "", "Mesin dasar memperluas jangkauan S.T.R.E.A.M. kapal di peta sebesar 30%, sehingga lebih banyak stasiun dapat dicapai dalam satu lompatan. Hanya satu mesin yang dapat dipasang. Mesin ini murah dan berguna sejak awal, karena lebih sedikit lompatan berarti perjalanan dagang dan antar penumpang yang lebih cepat.", false],
	],
	"equipment/3": [
		[1, "", "Coil gun pertama adalah senjata sinar yang dibuat untuk jangkauan. Jangkauannya 875 m, hampir empat kali lipat railgun, dan memukul 15, tetapi butuh 2,5 dtk di antara tembakan. Kerusakan berkelanjutannya kira-kira sama dengan [[equipment/0]]. Senjata ini layak dipasang untuk menembaki kapal yang mendekat sebelum mereka dapat membalas.", false],
	],
	"equipment/30": [
		[1, "", "Mesin ini memperluas jangkauan S.T.R.E.A.M. sebesar 60%, dua kali bonus [[equipment/29]], dengan harga kira-kira tiga kali lipat. Mesin ini cocok bagi pedagang yang rutin mengangkut barang antarpasar yang berjauhan, karena harga naik seiring jarak tempuh kargo. Mesin ini juga cukup umum ditemukan di toko pada pertengahan kampanye.", false],
	],
	"equipment/31": [
		[1, "", "Mesin terbaik memperluas jangkauan S.T.R.E.A.M. sebesar 130%, lebih dari dua kali lipat jangkauan dasar. Mesin ini langka dan harganya 90.000 cr atau lebih. Mesin ini layak dipasang ketika rute dagang yang panjang atau tujuan kontrak yang terpencil membuat setiap lompatan yang dihemat berarti.", false],
	],
	"equipment/32": [
		[1, "", "Pendorong ini menambah 0,15 pada nilai kemudi lambung. Tambahannya tetap, jadi paling berpengaruh pada lambung yang lamban: pada [[ship/6]] nilai kemudi naik dari 0,67 menjadi 0,82. Hanya satu modul kemudi yang dapat dipasang. Ini solusi murah untuk kapal barang yang lamban.", false],
	],
	"equipment/33": [
		[1, "", "Pendorong ini menambah 0,26 pada nilai kemudi, hampir dua kali tambahan [[equipment/32]] dengan harga sekitar tiga kali lipat. Pendorong ini cocok bagi pilot yang sering bertempur dengan lambung kelas menengah dan perlu berbelok lebih tajam daripada serangan bajak laut. Pada [[ship/4]] nilai kemudi naik dari 0,91 menjadi 1,17, mendekati nilai [[ship/7]].", false],
	],
	"equipment/34": [
		[1, "", "Pendorong terbaik menambah 0,56 pada nilai kemudi. Itu cukup untuk membuat [[ship/6]] berbelok lebih baik daripada [[ship/0]], atau memberi [[ship/5]] kelincahan yang tak tertandingi. Pendorong ini langka dan harganya 87.000 cr atau lebih, sebuah kemewahan bagi petarung sejati. Pada lambung yang pengendaliannya sudah baik, pendorong yang lebih murah mungkin lebih bijak secara biaya.", false],
	],
	"equipment/35": [
		[1, "", "Radar dasar menampilkan kapal dan kontak lain di layar radar dan menandainya di tepi pandangan, sehingga sang pilot dapat menemukan target. Tanpa radar, layar hanya menampilkan navigasi. Radar ini tidak menyebutkan nama kapal musuh maupun menampilkan makhluk, tetapi murah dan penting.", false],
	],
	"equipment/36": [
		[1, "", "Radar tempur ini menambahkan identifikasi: kapal musuh dalam bidikan diberi label jenis lambung dan kargo yang dibawanya. Radar ini tidak menampilkan makhluk, jadi ini alat bagi petarung. Dengan harga 18.500 sampai 23.000 cr, harganya kira-kira sama dengan [[equipment/37]], jadi pilihannya tergantung apakah sang pilot lebih sering bertempur atau memancing.", false],
	],
	"equipment/37": [
		[1, "", "Radar pancing ini menampilkan makhluk di layar radar bersama kapal, sehingga jauh lebih mudah menemukan tangkapan berharga. Radar ini tidak memberi label kapal musuh seperti [[equipment/36]]. Bagi pilot yang berfokus memancing, ini radar paling berguna selain [[equipment/38]].", false],
	],
	"equipment/38": [
		[1, "", "Radar teratas menggabungkan kedua spesialisasi: memberi label kapal musuh dan menampilkan makhluk di layar radar. Harganya sekitar dua kali radar khusus mana pun dan langka di toko. Karena hanya satu radar yang dapat dipasang, radar ini membebaskan Anda dari memilih antara memancing dan bertempur.", false],
	],
	"equipment/39": [
		[1, "", "Booster dasar menggandakan kecepatan kapal selama 3 dtk, lalu butuh 20 dtk untuk terisi ulang. Hanya satu booster yang dapat dipasang. Booster ini berguna untuk mendekati target, melarikan diri dari bahaya, atau mencapai gerbang S.T.R.E.A.M. lebih cepat, dan umum serta murah.", false],
	],
	"equipment/4": [
		[1, "", "Coil gun ini menaikkan kerusakan per tembakan menjadi 22 tetapi memperpanjang jeda menjadi 3,4 dtk, sehingga daya rusak berkelanjutannya nyaris tidak lebih baik daripada [[equipment/3]]. Jangkauannya hampir tidak berubah, 884 m. Ini pilihan yang wajar jika model yang lebih murah tidak dijual, tetapi peningkatannya tidak sebesar yang disiratkan selisih harganya.", false],
	],
	"equipment/40": [
		[1, "", "Booster ini menaikkan kecepatan 2,5 kali lipat selama sekitar 4 dtk dan terisi ulang dalam sekitar 16 dtk. Setiap nilainya lebih baik daripada [[equipment/39]], dengan harga sekitar dua kali lipat. Ini pilihan pertengahan kampanye yang baik bagi pilot tempur, dan juga mempersingkat perjalanan ke gerbang S.T.R.E.A.M. dalam perjalanan jauh.", false],
	],
	"equipment/41": [
		[1, "", "Booster terbaik melipattigakan kecepatan selama sekitar 5 dtk dan terisi ulang dalam 14,5 dtk, sehingga lebih sering siap dan lebih lama aktif daripada booster lain. Booster ini langka, tetapi dengan harga sekitar 42.000 cr ia lebih murah daripada kebanyakan perlengkapan kelas atas.", false],
	],
	"equipment/42": [
		[1, "", "Meriam stasiun berat yang tidak pernah muncul di toko biasa dan tidak memiliki harga daftar. Senjata ini memberi 40 kerusakan per tembakan setiap 0,93 dtk dengan jangkauan 240 m, sehingga kerusakan berkelanjutannya mendekati mass driver terbaik, sementara setiap pukulannya sekeras torpedo kelas menengah.", false],
		[33, "", "Mulai [[chapter/33]], kampanye berpusat pada pencarian salah satu meriam ini.", false],
		[42, "", "Di [[chapter/42]] sang pilot harus memasangnya sebelum berangkat dan mengujinya terhadap bajak laut.", false],
	],
	"equipment/43": [
		[1, "", "Droid perbaikan ini memulihkan satu poin lambung setiap 0,6 dtk, sekitar 100 poin per menit, selama lambung rusak. Droid ini tidak memulihkan perisai maupun zirah. Droid ini berguna untuk misi panjang dan untuk kapal berlambung lemah yang tidak boleh terkena tembakan nyasar. Hanya satu yang dapat dipasang, dan droid ini memakai slot yang bisa diisi senjata.", false],
	],
	"equipment/5": [
		[1, "", "Coil gun teratas adalah senjata penembak jitu. Setiap sinar memukul 35 hingga jarak 1.380 m, jangkauan terjauh dari semua senjata, tetapi tembakan baru siap setiap 5,6 dtk. Senjata ini termasuk barang paling langka di toko. Dipasang di samping senjata jarak pendek, senjata ini melemahkan target jauh sebelum senjata lainnya dapat menjangkaunya.", false],
	],
	"equipment/6": [
		[1, "", "Meriam fusi pertama adalah petarung jarak dekat: 10 kerusakan setiap 0,51 dtk, tetapi hanya sampai 160 m, jangkauan terpendek dari semua senjata. Laju kerusakannya jauh di atas semua railgun. Senjata ini cocok untuk lambung lincah yang dapat mendekat dengan cepat, dan membuat railgun usang untuk pertarungan jarak dekat.", false],
	],
	"equipment/7": [
		[1, "", "Peningkatan ini memukul 14 setiap 0,37 dtk, laju tembak tercepat dari semua senjata, dan memperluas jangkauan menjadi 216 m. Kerusakan berkelanjutannya hampir dua kali lipat [[equipment/6]], hanya dengan tambahan beberapa ribu kredit. Dihitung per kredit yang dikeluarkan, ini salah satu senjata terkuat dalam game.", false],
	],
	"equipment/8": [
		[1, "", "Meriam fusi terberat memberi 18 kerusakan setiap 0,40 dtk pada jarak 220 m. Ini peningkatan yang solid dibandingkan [[equipment/7]], meski selisihnya lebih kecil daripada antara dua model pertama. Senjata ini langka di toko. Jika muncul, ini pembelian yang bagus untuk rangkaian senjata jarak dekat mana pun.", false],
	],
	"equipment/9": [
		[1, "", "Mass driver pertama memukul keras, 16 kerusakan per tembakan, tetapi hanya menembak setiap 0,6 dtk dan menjangkau 195 m. Dengan harga 38.000 cr atau lebih, kerusakan per detiknya lebih kecil daripada [[equipment/7]] yang lebih murah. Senjata ini terutama menjadi batu loncatan menuju mass driver berikutnya.", false],
	],
	"faction/colonists": [
		[1, "", "Kolonis adalah para pemukim dan pengurus yang memerintah planet samudra ini di awal cerita. Mereka menguasai seluruh dua ratus stasiunnya, menetapkan harga hasil tangkapan, dan menentukan siapa yang mendapat pekerjaan. Koloni mereka dibangun untuk mengambil sumber daya laut dan mengirimnya keluar dari planet. Tentang koloni sebagai tempat, lihat [[world/colony]].", false],
		[1, "Sejarah", "Kolonis datang ke planet ini dari tempat lain dan membangun stasiun-stasiunnya jauh di bawah laut. Ketika sang pilot tiba, koloni sudah lama berdiri, dengan pejabat di setiap stasiun, kapal patroli di setiap gerbang, dan arus ekspor yang tak henti.", false],
		[21, "", "Menurut versi pemberontak, kolonisasi berlangsung cepat dan tanpa memedulikan akibatnya. Mereka memperingatkan bahwa kehidupan samudra dikuras lebih cepat daripada kemampuannya untuk pulih, dan bahwa planet-planet lain sudah terkuras dengan cara yang sama.", false],
		[1, "Organisasi", "Setiap stasiun dijalankan oleh pejabat kolonial yang mengurus perdagangan, membagikan kontrak, dan memimpin patroli setempat. Di atas mereka berdiri otoritas perdagangan yang mengawasi ekspor dan meminta pertanggungjawaban stasiun atas setiap kerugian. Keamanan stasiun dan pilot-pilot koloni sendiri menangani bajak laut dan ancaman lain, sering kali dengan menyewa pekerja lepas.", false],
		[10, "", "Barang meninggalkan planet dengan kapsul pengangkut, yang diluncurkan dari stasiun ke orbit dan diambil di sana oleh kapal kargo.", false],
		[1, "Tujuan dan cara", "Tujuan koloni adalah keuntungan bagi para tuannya. Koloni membeli hasil tangkapan dan barang dengan harga tetap yang rendah dan tidak membiarkan stasiunnya berdagang bebas. Hewan yang menghalangi dimusnahkan, dan siapa pun yang mengancam pengiriman diusir.", false],
		[23, "", "Menghadapi pemberontakan, kolonis beralih dari pemerintahan ke kekerasan. Mereka memasang ranjau di jalur pasokan, melakukan penyergapan, dan menyerang stasiun pemberontak.", false],
		[28, "", "Mereka juga bersedia membeli kesetiaan. Hadiah buruan sudah cukup untuk membuat seorang pilot pemberontak berbalik melawan pemimpinnya sendiri.", false],
		[2, "Anggota terkenal", "[[character/9]] adalah kolonis yang paling dikenal sang pilot: pejabat sombong di [[station/0]] yang meremehkan sang pilot dan membeli hasil tangkapan dengan harga tetap.", false],
		[9, "", "Pejabat yang lebih rendah muncul sebagai [[character/6|kolonis]] tanpa nama, seperti pejabat di [[station/1]] yang membayar buruk untuk pemusnahan nautilus lalu menyuruh sang pilot bekerja dari papan kerja.", false],
		[23, "", "Jack naik ke kekuasaan yang cukup besar selama cerita, tampaknya berkat koneksi yang baik, dan menjadi musuh paling gigih bagi pemberontak.", false],
		[28, "", "[[character/3]], seorang pilot pemberontak, diam-diam menerima uang koloni dan mengkhianati rekan-rekannya.", false],
		[3, "Peran dalam cerita", "Awalnya kolonis hanyalah majikan sang pilot. Jack membeli hasil tangkapan dan menyarankan sang pilot membeli senjata dan memburu bajak laut.", false],
		[7, "", "Selanjutnya ia memerintahkan pemusnahan [[species/0|nautilus]] di [[station/1]], tanpa peduli apakah hewan-hewan itu ditangkap atau dibunuh.", false],
		[10, "", "Setelah beberapa kontrak, koloni memercayakan kepada sang pilot pertahanan peluncuran kapsul di [[station/2]] dari para Aquarian.", false],
		[12, "", "Jack menyalahkan sang pilot atas kapsul yang rusak dalam pertempuran itu dan menolak membayar sepeser pun. Lelah dengan perlakuan koloni, sang pilot pergi mencari perlawanan.", false],
		[18, "", "Ketika pemberontak merebut stasiun demi stasiun lewat bujukan, koloni kehilangan wilayah tanpa satu tembakan pun.", false],
		[23, "", "Jack memasang ranjau di jalur pasokan pemberontak antara [[station/9]] dan [[station/37]].", false],
		[25, "", "Ia lalu menyergap pemimpin pemberontak [[character/2]] dalam perjalanannya ke perundingan di [[station/10]].", false],
		[28, "", "Hadiah buruan Jack membuat Raymond berbalik melawan pemberontak. Raymond menculik Ayumi, dan sang pilot menyelamatkannya.", false],
		[31, "", "Kolonis telah mencuri prototipe [[world/biotek]] milik [[world/abel|Profesor Abel]]. Pemberontak mencegat konvoi yang membawanya di dekat Cho.", false],
		[37, "", "Jack menjual sebuah meriam stasiun [[world/eclipse|Eclipse]] di pasar gelap, tanpa menyangka meriam itu akan dipakai untuk melawannya.", false],
		[44, "", "Kolonis melancarkan serangan mendadak ke [[station/14]], jantung pemberontakan, tetapi kocar-kacir ketika para Aquarian datang membantu pemberontak. Jack melarikan diri dari pertempuran.", false],
		[46, "", "Serangan pertama pemberontak merebut [[station/18]] dari kolonis.", false],
		[47, "", "Serangan kedua merebut [[station/109]], dan cengkeraman kolonis di selatan runtuh.", false],
		[48, "", "[[station/0]], benteng kolonial terakhir, jatuh dalam pertempuran terakhir. Jack melarikan diri dengan kapsul penyelamat, dan kekuasaan koloni atas samudra berakhir.", false],
		[1, "Dalam game", "Stasiun kolonis tampil berwarna biru di [[chart]]. Stasiun ini tidak memiliki pasar maupun pabrik: saat berlabuh, seluruh isi palka diambil dengan harga terendah. Karena itu stasiun kolonis adalah tempat yang buruk untuk tiba dengan kargo berharga. Toko dan galangannya buka, tetapi galangannya hanya menjual lambung standar. Lihat [[guide/allegiance]].", false],
		[1, "", "Papan kerjanya menawarkan kontrak [[contract/0]], [[contract/1]], [[contract/2]], [[contract/3]], [[contract/4]], [[contract/5]], [[contract/7]], [[contract/8]], [[contract/9]], [[contract/10]], dan [[contract/11]], tetapi tidak pernah pengiriman atau perlindungan ikan. Dalam pekerjaan konvoi untuk kolonis, kapal lawannya adalah pemberontak.", false],
		[1, "", "Di sisi lain, stasiun kolonis membayar hadiah bajak laut dua kali lipat tarif pemberontak: jumlah yang dihancurkan dalam satu perjalanan, dikuadratkan, dikali 100 kredit. Kapal patroli di sekitar stasiun kolonis bertempur untuk koloni dan membantu melawan bajak laut.", false],
		[12, "", "Stasiun meninggalkan koloni seiring cerita berlanjut, tidak pernah karena tindakan apa pun dalam permainan bebas, dan tidak ada yang pernah kembali. Begitu sang pilot berpihak pada pemberontak, kapal kolonis menjadi musuh utama dalam misi cerita.", false],
	],
	"faction/pirates": [
		[1, "", "Bajak laut adalah para penjahat yang merampok pelayaran di seluruh samudra. Mereka tidak mengabdi kepada koloni maupun pemberontak, dan menyerang kapal yang sendirian, konvoi, dan siapa pun yang tampak seperti mangsa empuk. Mereka adalah lawan yang paling sering dihadapi sang pilot, sejak keberangkatan bersenjata pertama hingga akhir cerita dan seterusnya.", false],
		[1, "Sejarah", "Pembajakan sudah menjadi bagian kehidupan ketika sang pilot tiba. Stasiun membayar hadiah kepada siapa pun yang menghancurkan kapal bajak laut, dan memburu bajak laut adalah pekerjaan umum di kalangan pilot bersenjata.", false],
		[21, "", "Konflik antara kolonis dan pemberontak menjadi berkah bagi bajak laut. Dengan kedua pihak sibuk, mereka menemukan lebih banyak korban yang lebih mudah, dan pimpinan pemberontak memutuskan bahwa mereka tidak bisa lagi diabaikan.", false],
		[1, "Organisasi", "Bajak laut beroperasi dalam geng-geng longgar, bukan sebagai satu organisasi, dan tidak satu pun dari mereka pernah disebut namanya dalam cerita. Geng-geng berkumpul di sarang di perairan terbuka, mengawal kapal curian, serta menjaga ladang ranjau dan ladang puing. Bajak laut yang sendirian juga mengintai di dekat stasiun, menunggu kapal yang lewat.", false],
		[1, "Tujuan dan cara", "Bajak laut menginginkan rampasan. Mereka menyerang kapal demi kargonya dan berkumpul di mana pun ada masalah, menunggu kapal yang melemah untuk dihabisi.", false],
		[23, "", "Mereka berkeliaran di sekitar ladang ranjau kolonial di dekat [[station/9]], berharap menghabisi kapal yang terjebak di dalamnya.", false],
		[35, "", "Tentara bayaran bergerak di lingkungan yang sama. Pemburu hadiah [[character/11]] bepergian dengan pengawal bersenjata, dan untuk keperluan hadiah kapalnya dihitung sebagai bajak laut.", false],
		[5, "Anggota terkenal", "Dalam cerita, bajak laut hanya muncul sebagai pilot [[character/10|bajak laut]] tanpa nama, tanpa pemimpin atau kapten ternama.", false],
		[5, "Peran dalam cerita", "Bajak laut adalah sasaran pertama railgun baru sang pilot. Atas saran [[character/1]], sang pilot memburu seorang bajak laut di dekat [[station/1]].", false],
		[21, "", "Ayumi memutuskan untuk tidak lagi sekadar mempertahankan gerakan dan menyerang bajak laut. Ia mengirim sang pilot dan [[character/3]] mengejar sebuah geng di dekat [[station/8]].", false],
		[25, "", "Bajak laut diperkirakan menghadang di jalan menuju [[station/10]], meski ancaman sebenarnya di sana ternyata datang dari kolonis.", false],
		[26, "", "Diperintahkan menjadi petarung yang lebih tangguh, sang pilot beralih memburu bajak laut untuk menambah jumlah kapal yang dihancurkan.", false],
		[42, "", "Sarang bajak laut di dekat [[station/17]] menjadi tempat uji coba [[world/eclipse|Eclipse]] yang baru dipasang.", false],
		[43, "", "Para bajak laut di sana segera meminta bala bantuan.", false],
		[47, "", "Bahkan selama serangan-serangan terakhir, bajak laut menghambat [[character/5]] dalam perjalanannya ke [[station/0]].", false],
		[1, "Dalam game", "Bajak laut adalah musuh standar di perairan terbuka. Lambung mereka makin tangguh dan senjata mereka makin kuat seiring naiknya peringkat sang pilot dan majunya cerita. Mereka muncul dalam kontrak [[contract/0]], [[contract/1]], [[contract/2]], dan [[contract/3]] serta menjaga ladang ranjau dan ladang puing. Lihat [[guide/combat]].", false],
		[1, "", "Mulai [[chapter/12|bab 12]], hingga tiga bajak laut mungkin menunggu di dekat stasiun saat sang pilot tiba, dan peluangnya bertambah setiap bab. Mulai [[chapter/16|bab 16]], bajak laut dan kapal musuh lainnya juga memakai lonjakan kecepatan mendadak.", false],
		[1, "", "Setiap bajak laut yang dihancurkan dalam satu perjalanan menaikkan hadiah yang dibayarkan di stasiun berikutnya: jumlah yang dihancurkan, dikuadratkan, dikali 100 kredit di stasiun kolonis atau 50 di stasiun pemberontak. Karena itu perburuan panjang jauh lebih menguntungkan daripada yang singkat. Bangkai mereka tenggelam perlahan dan dapat diambil kargonya dengan harpun sebelum jatuh terlalu dalam.", false],
		[1, "", "Bajak laut tidak memiliki stasiun sendiri, dan tidak ada stasiun yang pernah beralih ke pihak mereka.", false],
	],
	"faction/rebels": [
		[1, "", "Pemberontak adalah salah satu kekuatan yang dapat menguasai stasiun. Sifat dan tujuan mereka menjadi jelas seiring cerita berlangsung. Lihat [[guide/allegiance]].", false],
		[12, "", "Pemberontak adalah gerakan perlawanan yang bangkit melawan kekuasaan kolonial di planet samudra ini. Mereka bermula sebagai jaringan rahasia yang bermarkas di [[station/3]] dan menyebar dari stasiun ke stasiun. Mereka menginginkan perdagangan bebas dan laut yang dimanfaatkan dengan hati-hati, bukan dijarah.", false],
		[12, "Sejarah", "Gerakan itu sudah aktif ketika sang pilot pertama kali mendengarnya, melalui lalu lintas radio yang ditangkap M.A.I. dari Talon.", false],
		[13, "", "Pemberontak baru mulai menyandikan saluran mereka beberapa hari setelah siaran itu. Para anggotanya merahasiakan rencana mereka dan menguji pendatang baru sebelum memercayainya.", false],
		[18, "", "Untuk waktu yang lama gerakan itu tumbuh lewat bujukan. Para agennya mengumpulkan informasi tentang stasiun-stasiun dan merangkul para pemimpinnya, dan berita segera menyebut gerakan itu sebuah revolusi. Pierre memperkirakan masa damai itu tidak akan bertahan lama.", false],
		[26, "", "Penyergapan di [[station/10]] menunjukkan bahwa diplomasi saja tidak akan memenangkan perjuangan, dan gerakan itu bersiap untuk bertempur.", false],
		[31, "", "Untuk mengatasi jumlah kolonis yang lebih besar, pimpinan pemberontak membawa [[world/abel|Profesor Abel]] dan timnya ke [[station/14]], yang menjadi pusat operasi gerakan itu.", false],
		[13, "Organisasi", "Gerakan itu kecil dan terorganisasi rapat. Calon anggota disaring saat tiba dan hanya diberi tahu apa yang perlu mereka ketahui. Misi diteruskan melalui segelintir agen tepercaya.", false],
		[18, "", "Pemimpin gerakan mengarahkan langkahnya dari salah satu stasiun yang baru direbut, dan bahkan anggotanya sendiri tidak tahu pasti di mana.", false],
		[19, "", "Sang pemimpin berpindah dari stasiun ke stasiun untuk berunding secara langsung. Di bawahnya bertugas para agen lapangan, pilot, dan teknisi.", false],
		[45, "", "Menjelang akhir perang, gerakan itu menurunkan skuadron-skuadron kapal tempur utuh.", false],
		[13, "Tujuan dan cara", "Pemberontak mengecam eksploitasi planet dan penghuninya serta membela perdagangan bebas.", false],
		[15, "", "Ekonomi mereka kebalikan dari ekonomi koloni. Mereka menangkap ikan dan memanen hanya apa yang dapat diberikan laut, mengolah hasil tangkapan menjadi barang di pabrik mereka sendiri, dan memperdagangkannya dengan harga pasar yang adil, sambil menjaga keanekaragaman hayati.", false],
		[16, "", "Mereka lebih suka merangkul orang daripada melawannya. Para agen menjelajahi stasiun untuk menemukan titik lemah yang dapat dipakai untuk menarik penduduknya.", false],
		[21, "", "Pemimpin mereka memperingatkan bahwa eksploitasi koloni akan menguras planet ini seperti planet-planet lain. Gerakan itu berupaya membujuk orang-orang berpengaruh untuk bergabung sebelum hal itu terjadi. Gerakan itu juga melawan bajak laut yang mengambil untung dari kekacauan.", false],
		[31, "", "Ketika kekerasan tak lagi terhindarkan, pemberontak berupaya membangun senjata penentu alih-alih menandingi koloni kapal demi kapal.", false],
		[12, "Anggota terkenal", "[[character/4]] menyaring pendatang baru di [[station/3]]. Operator radio, penjaga, dan awak konvoi pemberontak tampil sebagai [[character/7]].", false],
		[13, "", "[[character/5]] adalah agen lapangan yang memperkenalkan sang pilot pada cara hidup gerakan itu.", false],
		[33, "", "Pierre kemudian mengurus hanggar di [[station/14]], menjaga kapal-kapal gerakan tetap siap.", false],
		[19, "", "[[character/2]] memimpin gerakan itu. Ia seorang perempuan yang lebih tua, meski sang pilot mengira pemimpinnya laki-laki.", false],
		[21, "", "[[character/3]] adalah salah satu pilot terbaik Ayumi, cakap tetapi congkak.", false],
		[28, "", "Raymond menjadi pengkhianat demi hadiah buruan kolonial dan menculik Ayumi.", false],
		[31, "", "[[world/abel|Profesor Abel]] memimpin tim ilmuwan di balik [[world/biotek]].", false],
		[45, "", "[[character/12]] memimpin skuadron tempur yang bergabung dengan sang pilot untuk menyerang [[station/18]].", false],
		[12, "Peran dalam cerita", "Setelah berselisih dengan koloni, sang pilot mencari gerakan itu di Talon.", false],
		[13, "", "Pierre menerima sang pilot dengan masa percobaan. Tugas pertamanya adalah membawa Leah dari [[station/4]] ke [[station/5]].", false],
		[16, "", "Tugas-tugas lain menyusul: memproduksi barang di stasiun pemberontak dan menjelajahi stasiun untuk gerakan itu.", false],
		[19, "", "Sang pilot akhirnya bertemu Ayumi dan melindungi sekawanan cumi-cumi dari pemburu kolonis di dekat [[station/7]].", false],
		[22, "", "Bersama Raymond, sang pilot menghancurkan geng bajak laut di dekat [[station/8]].", false],
		[24, "", "Sang pilot lalu membersihkan ladang ranjau kolonial di dekat [[station/9]].", false],
		[26, "", "Di Sula para pemimpin disergap. Senjata Raymond rusak pada saat yang menentukan, dan Leah mencurigai sabotase.", false],
		[28, "", "Raymond memancing sang pilot ke dalam jebakan dengan Ayumi sebagai sandera, tetapi sang pilot menghancurkan kapalnya dan menyelamatkan Ayumi dalam keadaan hidup.", false],
		[31, "", "Gerakan itu meluncurkan rencana tiga langkah, dimulai dengan merebut kembali [[world/biotek]] yang dicuri.", false],
		[33, "", "Langkah kedua adalah mendapatkan meriam [[world/eclipse|Eclipse]], yang dibeli sang pilot melalui pedagang pasar gelap.", false],
		[39, "", "Langkah ketiga adalah membuat inkubator yang melengkapi generator, di [[station/16]].", false],
		[44, "", "Senjata itu selesai tepat sebelum kolonis menyerang Fiir. Eclipse milik sang pilot dan bantuan mendadak dari para [[world/aquarians|Aquarian]] menyelamatkan stasiun itu.", false],
		[45, "", "Para Aquarian menyatakan dukungan mereka, dan gerakan itu merencanakan serangan-serangan terakhirnya dengan mereka sebagai sekutu.", false],
		[47, "", "Dua serangan menyusul. Leah merebut [[station/109]] dan sang pilot merebut [[station/18]].", false],
		[48, "", "Perang berakhir dengan jatuhnya [[station/0]], dan gerakan itu menguasai setiap stasiun di planet ini.", false],
		[1, "Dalam game", "Stasiun pemberontak tampil berwarna oranye di [[chart]]. Stasiun ini menjalankan pasar bebas dan pabrik, sehingga barang dapat dibeli, dijual, dan dibuat di sana; lihat [[guide/trading]]. Galangannya menjual setiap lambung dalam versi yang ditingkatkan. Patroli di sekitar stasiun pemberontak bertempur untuk pemberontak.", false],
		[1, "", "Papan kerjanya menawarkan kontrak [[contract/0]], [[contract/1]], [[contract/2]], [[contract/3]], [[contract/6]], [[contract/8]], [[contract/9]], [[contract/10]], [[contract/13]], dan [[contract/14]]. Stasiun ini tidak pernah memasang pengawalan, perampokan konvoi, perburuan ikan, atau pekerjaan kapsul, dan berhenti memasang perlindungan ikan setelah cerita selesai. Jika kontrak pemberontak melibatkan pertempuran melawan kapal lain, lawannya adalah kolonis atau bajak laut.", false],
		[1, "", "Stasiun pemberontak membayar hadiah bajak laut separuh tarif kolonis: jumlah yang dihancurkan dalam satu perjalanan, dikuadratkan, dikali 50 kredit.", false],
		[12, "", "Stasiun bergabung dengan pemberontak seiring cerita berlanjut, mula-mula beberapa sekaligus, lalu puluhan sekaligus. Stasiun yang bergabung tidak pernah kembali ke koloni. Halaman ini mencantumkan stasiun yang bergabung di setiap bab yang telah Anda capai.", false],
	],
	"goods/18": [
		[1, "", "Sisa makhluk yang dibunuh alih-alih ditangkap dengan harpun. Bangkai mengapung ke atas dan dapat ditarik dengan harpun, menghasilkan daging seberat sepertiga massa hewannya. Harganya 12 sampai 31 cr dan terutama dipakai, bersama [[species/14]], untuk membuat [[goods/19]]. Stasiun asalnya adalah [[station/68]].", false],
	],
	"goods/19": [
		[1, "", "Produk dasar yang dibuat dari [[goods/18]] dan [[species/14]], masing-masing satu per unit. Pabrik mana pun dapat membuatnya. Harganya dari 135 cr di [[station/78]] hingga 360 cr di [[station/27]], dan menjadi bahan [[goods/30]] dan [[goods/36]].", false],
	],
	"goods/20": [
		[1, "", "Kulit samak dari [[species/3]], diawetkan dengan [[goods/33]]. Stasiun asalnya [[station/164]], dan harganya paling tinggi, hingga 1.062 cr, di [[station/172]]. Kulit ini juga separuh dari resep [[goods/29]], sehingga tangkapan manta dapat diolah menjadi salah satu barang konsumsi termahal.", false],
	],
	"goods/21": [
		[1, "", "Hidangan ikan mentah dan rumput laut, dibuat dari [[species/4]] dan [[species/17]]. Kedua bahannya adalah tangkapan umum yang murah, sehingga sushi menjadi produk pertama yang mudah. Harganya dari 420 cr di [[station/76]] hingga 996 cr di [[station/179]].", false],
	],
	"goods/22": [
		[1, "", "Pewarna tahan air yang dibuat dari [[species/10]] dan [[goods/35]]. Harganya dari 750 cr di [[station/54]] hingga 1.872 cr di [[station/27]]. Pewarna ini juga salah satu dari dua bahan [[goods/29]].", false],
	],
	"goods/23": [
		[1, "", "Potongan [[species/7]], diawetkan dengan [[goods/33]]. Karena marlin sulit ditangkap, steik adalah produk premium: harganya dari 456 cr di [[station/109]] hingga 1.260 cr di [[station/19]].", false],
	],
	"goods/24": [
		[1, "", "Senyawa bercahaya yang diekstrak dari [[species/5]] dan [[species/1]] dengan [[goods/35]]. Harganya dari 850 cr di [[station/83]] hingga 2.500 cr di [[station/179]]. Senyawa ini bahan penting untuk [[goods/32]], [[goods/41]], dan [[goods/36]].", false],
	],
	"goods/25": [
		[1, "", "Protein yang diekstrak dari [[species/6]] dan [[species/8]], diolah dengan [[goods/33]]. Harganya dari 900 cr di [[station/23]] hingga 2.600 cr di [[station/27]], dan menjadi dasar [[goods/31]].", false],
	],
	"goods/26": [
		[1, "", "Hidangan ikan campuran yang dibuat dari [[species/8]], [[species/4]], dan [[species/2]]. Harga terendahnya paling tinggi di antara semua makanan, dari 1.916 cr di [[station/196]] hingga 3.030 cr di [[station/179]], tetapi membutuhkan tiga tangkapan yang berbeda.", false],
	],
	"goods/27": [
		[1, "", "Obat-obatan yang dibuat dari [[species/1]], [[species/13]], [[species/16]], dan [[goods/33]]. Harganya dari 930 cr di [[station/151]] hingga 2.316 cr di [[station/179]] dan merupakan salah satu bahan [[goods/41]]. Pasar jarang menyediakannya.", false],
	],
	"goods/28": [
		[1, "", "Biomassa olahan yang membutuhkan masing-masing satu dari kelima alga: [[species/13]], [[species/14]], [[species/15]], [[species/16]], dan [[species/17]]. Harganya dari 550 cr di [[station/74]] hingga 2.700 cr di [[station/19]], rentang terlebar di antara produk dasar, dan menjadi bahan [[goods/36]].", false],
	],
	"goods/29": [
		[1, "", "Pakaian yang dibuat dari [[goods/20]] dan [[goods/22]], sehingga rantainya berakar pada [[species/3]] dan [[species/10]]. Harganya dari 1.626 cr di [[station/175]] hingga 3.420 cr di [[station/172]]. Pasar jarang menyediakannya.", false],
	],
	"goods/30": [
		[1, "", "Sumber daya portabel yang dirakit dari [[goods/34]] dan [[goods/19]]. Harganya dari 1.150 cr di [[station/78]] hingga 1.900 cr di [[station/27]]. Barang ini jarang ada di pasar, jadi membuatnya sendiri biasanya satu-satunya cara untuk mendapatkannya.", false],
	],
	"goods/31": [
		[1, "", "Produk kecantikan yang dibuat dari [[goods/25]] dan [[goods/35]]. Harganya dari 1.536 cr di [[station/23]] hingga 3.840 cr di [[station/27]]. Pasar jarang menyediakannya, jadi pilot yang membuat kolagen dapat melangkah satu tahap lebih jauh dan meraih untung jauh lebih besar.", false],
	],
	"goods/32": [
		[1, "", "Lampu yang meniru cahaya siang alami, dibuat dari [[goods/34]] dan [[goods/24]]. Harganya dari 2.490 cr di [[station/83]] hingga 5.622 cr di [[station/179]], menjadikannya produk paling berharga yang dapat dibuat pabrik mana pun dari tangkapan dan barang impor.", false],
	],
	"goods/33": [
		[1, "", "Hasil sampingan desalinasi, murah dan tersedia luas dengan harga 20 sampai 36 cr. Barang ini tidak dibuat dari tangkapan, tetapi dibutuhkan untuk [[goods/20]], [[goods/23]], [[goods/25]], dan [[goods/27]]. Kontrak pengantaran tidak pernah memintanya.", false],
		[12, "", "Pasar pemberontak mengisi ulang stoknya di antara kunjungan, karena barang ini diimpor.", false],
	],
	"goods/34": [
		[1, "", "Komponen impor, tersedia luas dengan harga 193 sampai 297 cr. Komponen ini tidak dibuat secara lokal, tetapi dibutuhkan untuk [[goods/30]], [[goods/32]], [[goods/41]], dan [[goods/36]]. Kontrak pengantaran tidak pernah memintanya.", false],
		[12, "", "Pasar pemberontak mengisi ulang stok elektronik di antara kunjungan, karena barang ini diimpor.", false],
	],
	"goods/35": [
		[1, "", "Bahan kimia impor, tersedia luas dengan harga 55 sampai 123 cr. Bahan ini dibutuhkan untuk [[goods/22]], [[goods/24]], dan [[goods/31]]. Kontrak pengantaran tidak pernah memintanya.", false],
		[12, "", "Pasar pemberontak mengisi ulang stoknya di antara kunjungan, karena barang ini diimpor.", false],
	],
	"goods/36": [
		[1, "", "Peralatan laboratorium untuk menyalin materi genetik. Alat ini membutuhkan [[goods/19]], [[goods/34]], [[goods/28]], dan [[goods/24]], dan hanya pabrik dengan level teknologi 11 yang dapat merakitnya. Pasar tidak pernah menyediakannya.", false],
		[39, "", "Kampanye mengharuskan sang pilot mendapatkan satu alat ini mulai [[chapter/39]].", false],
	],
	"goods/37": [
		[1, "", "Obat terlarang impor yang dianggap sebagai masalah sosial yang kian berkembang. Barang ini tidak dibuat dari tangkapan, dan pasar tidak pernah menyediakannya.", false],
		[34, "", "Di [[chapter/34]] sang pilot harus mengantarkan satu kiriman kepada seorang kontak sebagai bagian dari sebuah kesepakatan.", false],
	],
	"goods/38": [
		[1, "", "Meriam stasiun berat dalam peti, bernilai 89.000 cr. Barang ini tidak dapat dibeli di pasar. Setelah diantar dan dipasang, barang ini menjadi senjata [[equipment/42]].", false],
		[37, "", "Barang ini menjadi incaran sang pilot mulai [[chapter/33]], dan sang pilot membawanya di [[chapter/37]].", false],
	],
	"goods/39": [
		[1, "", "Sekop lipat impor. Harganya berayun dari 9 cr hingga 999 cr tergantung seberapa jauh barang ini diangkut, sehingga menjadi kargo spekulatif. Tidak ada pabrik yang membuatnya, dan kontrak pengantaran tidak pernah memintanya. Stasiun asalnya adalah [[station/89]].", false],
	],
	"goods/40": [
		[1, "", "Patung kecil seorang pahlawan ternama, dijual kepada kolektor. Harganya dari 999 cr hingga 9.999 cr, dari [[station/90]] ke [[station/19]], kenaikan paling curam di antara semua barang dagangan. Barang ini jarang ada di pasar, dan kontrak pengantaran tidak pernah memintanya.", false],
	],
	"goods/41": [
		[1, "", "Robot medis mikroskopis yang dibuat dari [[goods/27]], [[goods/24]], dan [[goods/34]]. Robot ini termasuk barang paling berharga, dengan harga dari 4.315 cr di [[station/76]] hingga 11.972 cr di [[station/179]], dan pasar hampir tidak pernah menyediakannya.", false],
	],
	"guide/allegiance": [
		[1, "Dua jenis stasiun", "Setiap stasiun dikuasai salah satu dari dua pihak, yang ditunjukkan oleh warnanya di [[chart]]: biru untuk [[faction/colonists]] dan oranye untuk [[faction/rebels]]. Di awal cerita setiap stasiun adalah milik kolonis.", false],
		[1, "", "Pihak yang menguasai stasiun mengubah apa yang ditawarkannya:", false],
		[1, "", "Dagang: stasiun kolonis tidak memiliki pasar maupun bengkel. Mereka membeli seluruh isi palka saat tiba dengan harga terendah. Stasiun pemberontak berdagang dan berproduksi dengan bebas; lihat [[guide/trading]].", true],
		[1, "", "Kontrak: setiap pihak memasang pilihan jenis kontraknya sendiri; lihat [[guide/contracts]].", true],
		[1, "", "Hadiah: hadiah bajak laut di stasiun kolonis dua kali lebih besar daripada di stasiun pemberontak.", true],
		[1, "", "Kapal: galangan pemberontak menjual setiap lambung dalam versi yang ditingkatkan.", true],
		[1, "", "Patroli: kapal-kapal yang berputar di sekitar stasiun bertempur untuk pihak stasiun itu.", true],
		[1, "", "Labuh, toko peralatan, dealer kapal, dan papan kerja terbuka bagi sang pilot di kedua jenis stasiun.", false],
		[1, "Bagaimana kesetiaan berubah", "Stasiun hanya berganti pihak seiring cerita berlanjut, tidak pernah karena tindakan sang pilot dalam permainan bebas. Begitu sebuah stasiun bergabung dengan pemberontak, ia tetap bersama mereka. Halaman [[faction/rebels]] mencantumkan stasiun yang bergabung di setiap bab yang telah Anda capai.", false],
		[12, "", "Stasiun pemberontak pertama adalah [[station/3]], yang sudah berpihak pada perlawanan saat sang pilot pertama kali mendengarnya. [[station/4]] menyusul di [[chapter/12|bab 12]].", false],
		[14, "", "Sepanjang bab-bab berikutnya, stasiun berpindah pihak satu atau beberapa sekaligus.", false],
		[22, "", "Mulai [[chapter/22|bab 22]] gerakan itu tumbuh jauh lebih cepat, dengan delapan stasiun atau lebih bergabung sekaligus.", false],
		[46, "", "Menjelang bab-bab terakhir, sebagian besar peta sudah berwarna oranye.", false],
		[12, "Artinya bagi sang pilot", "Makin banyak stasiun yang berganti pihak, makin banyak pasar dan bengkel yang terbuka di seluruh peta, dan memancing tidak lagi menjadi satu-satunya mata pencaharian. Stasiun kolonis menjadi tempat yang sebaiknya dihindari saat palka berisi barang berharga, tetapi tempat yang baik untuk menagih hadiah bajak laut.", false],
	],
	"guide/basics": [
		[1, "Kapal pertama Anda", "Sang pilot memulai di [[station/0]] dengan 15.000 kredit dan sebuah [[ship/0]], kapal selam penangkap ikan yang kecil. Kapal ini dilengkapi harpun [[equipment/15]], [[equipment/18]], [[equipment/22]], dan [[equipment/35]]. Kapal ini tidak membawa senjata.", false],
		[1, "", "Bab-bab pertama adalah pengenalan terpandu. [[character/1]], komputer kapal, menjelaskan setiap tugas baru saat muncul: menangkap ikan, berlabuh, memasang peralatan, dan bepergian. Tujuan saat ini selalu tercantum di jurnal misi.", false],
		[1, "Mengemudi", "Anda dapat mengemudikan kapal selam dengan keyboard dan mouse, gamepad, atau kontrol sentuh, dan setiap tombol dapat diatur ulang di Pengaturan. Gas berubah dalam langkah seperempat, dan Berhenti menghentikan kapal. Pendorong samping menggeser kapal selam ke samping bahkan saat kapal berhenti. Boost hanya berfungsi jika booster terpasang. Kamera berganti di antara empat tampilan.", false],
		[1, "", "Autopilot membuka daftar tujuan: tujuan saat ini, dermaga setempat, gerbang S.T.R.E.A.M. setempat, atau stasiun mana pun di peta. Kemudi, gas, atau senjata mengembalikan kendali kepada Anda. Lihat [[guide/navigation]].", false],
		[1, "Berlabuh", "Untuk berlabuh, arahkan kapal ke area labuh stasiun dan gunakan Labuh, atau pilih dermaga dari daftar autopilot. Labuh terkunci selama pertempuran misi di area itu belum selesai. Meninggalkan stasiun selalu memulihkan lambung, perisai, dan zirah sepenuhnya, tanpa biaya.", false],
		[1, "Menu stasiun", "Stasiun tempat Anda berlabuh menawarkan enam layanan:", false],
		[1, "", "Hanggar: toko peralatan, dealer kapal, bengkel untuk membuat barang, dan tampilan kapal Anda.", true],
		[1, "", "Misi: jurnal tujuan saat ini dan papan kerja stasiun.", true],
		[1, "", "Peta: peta stasiun, untuk merencanakan rute dan mencari tempat hidup spesies.", true],
		[1, "", "Dagang: pasar untuk membeli dan menjual kargo.", true],
		[1, "", "Status: kapal, kargo, peringkat pilot, medali, dan statistik Anda.", true],
		[1, "", "Sistem: penyimpanan, pengaturan, bantuan, dan referensi ini.", true],
		[1, "", "Sebagian layanan baru terbuka di bagian cerita selanjutnya. Peta stasiun terbuka di [[chapter/7|bab 7]] dan papan kerja di [[chapter/9|bab 9]]. Stasiun yang dikuasai [[faction/colonists]] tidak pernah berdagang; lihat [[guide/trading]].", false],
		[1, "Menyimpan", "Anda hanya dapat menyimpan saat berlabuh. Setiap kedatangan di stasiun membuat checkpoint otomatis, dan menu Sistem menyediakan tiga slot simpanan lagi. Kembali ke menu utama dari stasiun akan menyimpan terlebih dahulu. Jika lambung hancur, permainan dilanjutkan dari simpanan stasiun terakhir, jadi berlabuhlah secara teratur dalam perjalanan panjang.", false],
		[1, "", "Transfer simpanan, juga di menu Sistem, mengekspor simpanan stasiun terakhir Anda ke sebuah file dan mengimpornya di perangkat lain.", false],
		[1, "Bantuan", "Bantuan di menu Sistem menjelaskan setiap layar stasiun. Saat di laut, menu jeda berisi peta, jurnal misi, status kapal, medali, dan pengaturan. M.A.I. berkomentar sekali pada setiap situasi baru, seperti gerbang pertama atau penyelaman pertama di luar rentang kedalaman aman. Petunjuk ini dapat dimatikan di pengaturan permainan.", false],
		[1, "", "Selanjutnya, bacalah [[guide/depth]] sebelum bepergian jauh, dan [[guide/fishing]] untuk penghasilan pertama Anda.", false],
	],
	"guide/combat": [
		[1, "Senjata", "Senjata terbagi dalam dua golongan. Senjata proyektil, seperti [[equipment/0]], [[equipment/6]], dan [[equipment/9]], menembakkan rentetan peluru. Senjata sinar, yaitu coil gun mulai dari [[equipment/3]] ke atas, memukul keras dari jarak jauh tetapi lambat terisi ulang. Beberapa senjata dapat dipasang, dan semuanya menembak bersamaan dari dudukan yang tersebar di haluan.", false],
		[1, "", "Torpedo pencari, dari [[equipment/12]] hingga [[equipment/14]], melaju lurus selama satu setengah detik, lalu berbelok ke arah target hidup terdekat dalam jarak sekitar 150 m. Hanya satu peluncur torpedo yang dapat dipasang. Setiap halaman senjata mencantumkan kerusakan, jangkauan, dan jeda tembak.", false],
		[1, "Menembak", "Senjata dan torpedo membentuk satu set senjata dan harpun membentuk set lainnya. Tembak memakai set yang dipilih, dan Set senjata beralih di antara keduanya. Dengan mouse, tombol kiri menembakkan senjata dan tombol kanan menembakkan harpun; pada gamepad, pemicu kanan menembakkan senjata dan pemicu kiri menembakkan harpun.", false],
		[1, "", "Tembak otomatis membuat set yang dipilih terus menembak sampai Anda mematikannya. Fitur ini juga mengakhiri autopilot.", false],
		[1, "Perlindungan", "Tembakan musuh menguras perisai terlebih dahulu, lalu zirah, lalu lambung. Saat lambung mencapai nol, kapal hilang, dan permainan dilanjutkan dari simpanan stasiun terakhir.", false],
		[1, "", "Perisai dengan isi ulang pasif pulih saat di laut. Zirah tidak, dan lambung hanya pulih dengan [[equipment/43]]. Meninggalkan stasiun memulihkan ketiganya. Booster seperti [[equipment/39]] memberi lonjakan kecepatan singkat untuk mendekat atau melepaskan diri, lalu perlu waktu untuk terisi ulang.", false],
		[1, "Musuh", "[[faction/pirates]] adalah musuh yang biasa. Lambung mereka makin tangguh dan senjata mereka makin kuat seiring naiknya peringkat pilot Anda dan majunya cerita. Mulai [[chapter/12|bab 12]], hingga tiga bajak laut mungkin menunggu di dekat sebuah stasiun.", false],
		[1, "", "Pertempuran misi membawa lawannya sendiri: kapal buronan, geng yang menjaga kapal lumpuh, penjaga konvoi, dan ladang ranjau. Lihat [[guide/contracts]].", false],
		[10, "", "Para Aquarian menyerang kapsul pengangkut kolonis. Mereka bertempur dengan senjata mereka sendiri, dan tidak meninggalkan bangkai saat dihancurkan.", false],
		[1, "Hadiah dan rampasan", "Setiap bajak laut yang dihancurkan dalam satu perjalanan menaikkan hadiah yang dibayarkan saat Anda berlabuh berikutnya. Hadiahnya adalah jumlah bajak laut dikuadratkan, dikali 100 kredit di stasiun kolonis atau 50 di stasiun pemberontak. Empat bajak laut dalam satu perjalanan menghasilkan 1.600 kredit di stasiun kolonis.", false],
		[1, "", "Kapal yang hancur meninggalkan bangkai berisi kargo yang dapat diangkut dengan harpun. Musuh yang dihancurkan dihitung untuk [[medal/4]], bajak laut untuk [[medal/14]], dan banyak musuh dalam satu perjalanan untuk [[medal/9]].", false],
		[1, "", "Jauhkan tembakan dari ikan yang ingin Anda tangkap: makhluk yang terluka akan kabur, dan makhluk di harpun akan lepas jika terkena.", false],
	],
	"guide/contracts": [
		[1, "Papan kerja", "Mulai [[chapter/9|bab 9]], layanan Misi di setiap stasiun memiliki papan kerja berisi satu sampai delapan kontrak. Masing-masing menampilkan pemberinya, deposit yang dibayar saat menerima, dan imbalan yang dibayar jika berhasil. Anda dapat memegang satu kontrak sekaligus di samping tujuan cerita. Deposit tidak dikembalikan, jadi membatalkan atau gagal dalam kontrak berarti kehilangan deposit.", false],
		[1, "Jenis kontrak", "Ada lima belas jenis kontrak:", false],
		[1, "", "[[contract/0]]: hancurkan satu kapal tangguh yang menunggu di dekat stasiun target.", true],
		[1, "", "[[contract/1]] dan [[contract/2]]: lumpuhkan kapal yang bepergian bersama geng bajak laut, lalu tembak dengan harpun sebelum kabur.", true],
		[1, "", "[[contract/3]]: hancurkan setiap anggota geng bajak laut.", true],
		[1, "", "[[contract/4]]: lindungi konvoi kapal barang dari perompak; kehilangan seluruh konvoi menggagalkan pekerjaan.", true],
		[1, "", "[[contract/5]]: hancurkan kapal barang dari konvoi yang dijaga.", true],
		[1, "", "[[contract/6]]: jaga sekawanan makhluk dari pemburu; kehilangan terlalu banyak menggagalkan pekerjaan.", true],
		[1, "", "[[contract/7]]: tangkap atau bunuh sejumlah individu dari satu spesies.", true],
		[1, "", "[[contract/8]]: antar penumpang ke stasiun lain, terkadang dengan batas jumlah persinggahan di sepanjang jalan.", true],
		[1, "", "[[contract/9]]: hancurkan puing yang mengapung dalam waktu sekitar dua setengah menit.", true],
		[1, "", "[[contract/10]]: hancurkan ladang ranjau yang dijaga.", true],
		[1, "", "[[contract/11]]: pertahankan kapsul pengangkut selama peluncuran.", true],
		[1, "", "[[contract/12]]: hancurkan kapsul pengangkut. Jenis ini hanya muncul dalam cerita, tidak pernah di papan kerja.", true],
		[1, "", "[[contract/13]] dan [[contract/14]]: antarkan sejumlah produk, atau individu dari satu spesies, ke stasiun yang memasang pekerjaan itu.", true],
		[1, "Siapa memasang apa", "Stasiun [[faction/colonists|kolonis]] tidak pernah memasang [[contract/6]], [[contract/12]], [[contract/13]], atau [[contract/14]]. Stasiun [[faction/rebels|pemberontak]] tidak pernah memasang [[contract/4]], [[contract/5]], [[contract/7]], [[contract/11]], atau [[contract/12]], dan berhenti memasang [[contract/6]] setelah cerita selesai. Kontrak pengantaran tidak pernah dipasang di dua puluh satu stasiun yang membuka tabel stasiun game, dari [[station/0]] hingga [[station/20]].", false],
		[1, "Tujuan dan bayaran", "Sebagian besar kontrak mengarah ke stasiun lain, biasanya yang berada dalam rentang kedalaman Anda dan dalam jarak yang bertambah seiring cerita berlanjut. Imbalannya mulai dari 3.500 kredit dan naik sesuai kesulitan dan jarak. [[contract/9]] membayar lebih sedikit; pengawalan, perlindungan ikan, dan pertahanan kapsul membayar lebih banyak. Penumpang yang mengizinkan lebih sedikit persinggahan membayar ekstra. Kontrak pengantaran meminta setengah dari deposit biasa.", false],
		[1, "", "Kesulitan menyesuaikan dengan peringkat pilot Anda. Peringkat naik saat Anda menangkap makhluk, menghancurkan musuh, membuat barang, dan menyelesaikan kontrak, sehingga pekerjaan dengan bayaran lebih tinggi juga membawa perlawanan yang lebih berat.", false],
		[1, "Menjalankan kontrak", "Saat mencapai area target, pertempuran dimulai. Pilihan tujuan pada autopilot mengemudikan kapal ke titik-titiknya. Labuh dan gerbang tetap terkunci sampai pertempuran selesai, dan kegagalan mengakhiri kontrak. Pengantaran diselesaikan saat Anda berlabuh dengan membawa barangnya.", false],
		[1, "", "Setiap kontrak yang diselesaikan dihitung untuk [[medal/12]].", false],
	],
	"guide/depth": [
		[1, "Kedalaman dalam DEEP", "Setiap stasiun berada di kedalaman tetap, yang ditampilkan bersama level teknologinya di halamannya. Sebagian besar terletak antara 15.000 dan 30.000 m. [[station/28]] adalah yang tertinggi di 13.500 m dan [[station/81]] yang terdalam di 32.250 m. Samudra tidak memiliki dasar yang menghentikan penyelaman: kapal selam dapat tenggelam sejauh lambungnya bertahan.", false],
		[1, "Rentang aman", "Kapal hanya aman di dalam rentang kedalaman yang ditentukan oleh dua peralatan. Perisai menentukan batas dangkal, titik tertinggi yang boleh dicapai kapal. Zirah menentukan batas dalam, titik terendah tempat kapal boleh tenggelam. Tanpa keduanya, rentangnya hanya 22.000 sampai 23.000 m.", false],
		[1, "", "[[ship/0]] memulai dengan [[equipment/18]] untuk 20.000 m dan [[equipment/22]] untuk 25.000 m, sehingga rentangnya dari 20.000 sampai 25.000 m. Perisai yang lebih baik memungkinkan kapal naik lebih tinggi dan zirah yang lebih baik memungkinkannya menyelam lebih dalam. Setiap halaman peralatan mencantumkan batasnya, dan setiap halaman stasiun menyebutkan batas mana yang dapat mencapainya. Hanya satu perisai dan satu zirah yang dapat dipasang.", false],
		[1, "Di luar rentang", "Melewati batas memicu peringatan. Setelah lima detik di luar rentang, kapal menerima kerusakan beberapa kali per detik. Terlalu dalam, tekanan menguras perisai; terlalu tinggi, tekanan menguras zirah. Begitu lapisan itu habis, kerusakan langsung mengenai lambung.", false],
		[1, "", "Setiap pukulan awalnya kecil. Besarnya bertambah satu poin untuk setiap 2.000 m di bawah 30.000 m atau di atas 15.000 m, sehingga kedalaman ekstrem cepat menggerogoti kapal.", false],
		[1, "", "Tenggang lima detik memungkinkan perjalanan singkat keluar rentang, misalnya untuk mengejar tangkapan atau melewati stasiun. Percepatan waktu dibatasi hingga 2× selama kapal berada di luar rentangnya.", false],
		[1, "Pemulihan", "Perisai dengan isi ulang pasif hanya pulih selama kapal berada di bawah batas dangkalnya. Zirah tidak pulih saat di laut, dan lambung hanya pulih dengan [[equipment/43]]. Ketiganya dipulihkan saat kapal meninggalkan stasiun.", false],
		[1, "Merencanakan perjalanan", "Autopilot dan S.T.R.E.A.M. tetap akan membawa Anda ke stasiun di luar rentang Anda, setelah peringatan, tetapi kedatangan itu mengorbankan perlindungan. Kontrak papan kerja biasanya mengarah ke stasiun di dalam rentang Anda, tetapi tidak selalu. Periksa kedalaman tujuan sebelum menerima pekerjaan, dan ganti peralatan bila perlu; lihat [[guide/fitting]].", false],
		[1, "Rekor kedalaman", "Titik tertinggi dan terendah yang Anda capai dicatat. [[medal/21]] diberikan untuk naik di atas 15.000, 12.000, dan 10.000 m, dan medali lain diberikan untuk menyelam di bawah 30.000, 32.000, dan 35.000 m. Lihat [[guide/medals]].", false],
	],
	"guide/fishing": [
		[1, "Harpun", "Memancing menggunakan harpun, yang membentuk set senjatanya sendiri, terpisah dari senjata. Setiap pilot memulai dengan [[equipment/15]]; [[equipment/16]] dan [[equipment/17]] lebih baik. Harpun memiliki tiga nilai: jangkauan, toleransi tangkap (seberapa dekat tembakan harus lewat untuk mengait target), dan perlambatan (seberapa kuat ia melumpuhkan tangkapan). Hanya satu harpun yang dapat dipasang.", false],
		[1, "", "Tembakkan harpun dengan kontrolnya sendiri: tombol kanan mouse atau pemicu kiri. Anda juga dapat memilih set harpun dengan Set senjata lalu menggunakan Tembak.", false],
		[1, "Mendaratkan tangkapan", "Tembakan yang kena akan mengait makhluk itu, yang lalu kabur dan meronta. Jaga agar ia tetap di depan kapal sampai lelah. Setiap makhluk melawan setidaknya 2,1 detik, dan spesies yang lebih tangguh melawan lebih lama; setiap halaman spesies mencantumkan waktu perlawanannya. Harpun dengan perlambatan lebih besar mencegah tangkapan yang kabur lari jauh.", false],
		[1, "", "Tangkapan lepas jika terluka, misalnya oleh senjata Anda sendiri, atau jika keluar dari pandangan sebelum menyerah. Menekan kontrol harpun sekali lagi melepaskan tangkapan yang terkait.", false],
		[1, "", "Setelah lumpuh, makhluk itu ditarik masuk dan dibawa ke kapal. Ia mengisi palka sesuai massanya dalam ton, dan satu individu bisa seperempat lebih berat atau lebih ringan daripada nilai spesiesnya. Jika palka terlalu penuh, makhluk itu tetap di air.", false],
		[1, "Alga", "Kelima alga, dari [[species/17]] hingga [[species/13]], diam di dasar laut. Alga menyerah hampir seketika, sehingga menjadi tangkapan yang paling mudah.", false],
		[1, "Bangkai makhluk dan bangkai kapal", "Makhluk yang mati oleh tembakan meninggalkan bangkai yang mengapung ke atas. Jika diambil dengan harpun, bangkai itu menghasilkan [[goods/18]] seberat kira-kira sepertiga hewannya.", false],
		[1, "", "Kapal yang hancur meninggalkan bangkai kapal berisi satu sampai tujuh unit kargo. Tembak bangkai kapal dengan harpun untuk membawa kargonya ke kapal. Setiap bangkai kapal yang diangkut dihitung untuk [[medal/18]].", false],
		[1, "Menjual tangkapan", "Di stasiun [[faction/colonists|kolonis]], seluruh isi palka dibeli saat tiba dengan harga terendah. Di stasiun [[faction/rebels|pemberontak]], ikan dan alga dapat dijual dengan harga pasar atau dipakai sebagai bahan di bengkel. Lihat [[guide/trading]].", false],
		[1, "", "Modul kargo meningkatkan kapasitas palka; lihat [[guide/fitting]]. Kontrak [[contract/14]] membayar pengantaran sejumlah individu dari satu spesies, dan kontrak [[contract/7]] meminta sejumlah tangkapan atau buruan.", false],
		[1, "", "Setiap tangkapan dihitung untuk [[medal/5]], dan banyak tangkapan dalam satu perjalanan dihitung untuk [[medal/10]]. Menangkap setiap spesies ikan menghasilkan [[medal/3]], dan setiap alga menghasilkan [[medal/2]].", false],
	],
	"guide/fitting": [
		[1, "Slot", "Setiap lambung memiliki jumlah slot peralatan yang tetap, dari enam pada [[ship/0]] hingga sepuluh pada lambung terbesar, dan setiap barang memakai satu slot. Senjata dan modul kargo dapat dipasang beberapa kali. Semua jenis lainnya, termasuk peluncur torpedo, dibatasi satu per kapal.", false],
		[1, "Jenis peralatan", "Senjata dan torpedo: lihat [[guide/combat]].", true],
		[1, "", "Harpun: menangkap makhluk dan mengangkut bangkai kapal; lihat [[guide/fishing]].", true],
		[1, "", "Perisai: menyerap kerusakan pertama kali dan menentukan batas kedalaman dangkal. Sebagian terisi ulang saat di laut.", true],
		[1, "", "Zirah: menyerap kerusakan setelah perisai dan menentukan batas kedalaman dalam; lihat [[guide/depth]].", true],
		[1, "", "Modul kargo: menambah persentase dari kapasitas kargo dasar lambung. Efeknya bertumpuk.", true],
		[1, "", "Mesin: memperluas jangkauan S.T.R.E.A.M. sesuai persentasenya.", true],
		[1, "", "Unit kemudi: membuat kapal berbelok lebih cepat.", true],
		[1, "", "Unit radar: sensor kapal.", true],
		[1, "", "Booster: lonjakan kecepatan tambahan selama beberapa detik, diikuti waktu isi ulang.", true],
		[1, "", "Sistem perbaikan: [[equipment/43]] memperbaiki lambung secara perlahan saat di laut.", true],
		[1, "Membeli dan menjual", "Toko stasiun menawarkan dua sampai lima barang, yang diundi berdasarkan kelangkaan; barang yang lebih langka makin sering muncul seiring cerita berlanjut. Harga turun seiring level teknologi: stasiun tek. 10 menjual di batas bawah rentang harga barang, stasiun tek. 1 mendekati batas atas.", false],
		[1, "", "Peralatan dijual kembali seperlima lebih murah daripada harga toko stasiun. Barang yang pernah dimiliki juga dijual seperlima lebih murah. Modul kargo tidak dapat dijual jika palka tidak lagi muat untuk isinya.", false],
		[1, "", "Dua stasiun istimewa. [[station/28]] menjual semua peralatan dan [[station/81]] menjual semua lambung, tetapi tidak ada perisai atau zirah yang dapat mencapai kedalaman keduanya dengan aman.", false],
		[1, "Perbaikan", "Tidak ada biaya perbaikan. Lambung, perisai, dan zirah dipulihkan sepenuhnya setiap kali kapal meninggalkan stasiun.", false],
		[1, "Membeli kapal", "Dealer kapal menawarkan hingga tiga lambung, dan lambung yang lebih besar baru muncul seiring cerita berlanjut. Level teknologi stasiun memotong harga lambung sebanyak persentase yang sama. Kapal Anda saat ini ditukar-tambah dengan nilai empat perlima dari harga daftarnya.", false],
		[1, "", "Semua peralatan dan kargo pindah ke lambung baru, jadi lambung itu perlu slot dan ruang palka yang cukup. Galangan pemberontak menjual setiap lambung dalam versi yang ditingkatkan. [[ship/10]] memiliki harga daftar yang sangat tinggi tetapi dijual seharga 50.000 kredit setelah semua medali diraih; lihat [[guide/medals]].", false],
	],
	"guide/help": [
		[1, "", "Kapal selam dapat dikemudikan dengan keyboard dan mouse, gamepad, atau layar sentuh, dan ketiganya dapat dipakai bersamaan. Tombol di bawah ini adalah bawaan; setiap tombol yang dipakai di laut dapat diubah di Pengaturan › Kontrol › Tata tombol, dan Pengaturan › Kontrol › Referensi kontrol menampilkan susunan yang berlaku kapan saja.", false],
		[1, "Keyboard dan mouse", "Menggerakkan mouse membelokkan kapal serta mengangkat dan menurunkan haluannya, dan kamera mengikutinya. W dan S menaikkan dan menurunkan gas seperempat setiap kali; A dan D menggeser kapal ke samping (atau membelokkannya, jika pengaturan kemudi menentukan demikian), dan tombol panah mengangkat dan menurunkan haluan. Tahan Alt atau Ctrl untuk melihat sekeliling dengan mouse tanpa mengemudi.", false],
		[1, "", "Tombol kiri mouse: menembakkan senjata.", true],
		[1, "", "Tombol kanan mouse: menembakkan harpun.", true],
		[1, "", "Space: menembakkan set senjata yang dipilih; Tab beralih antara set tempur dan set pancing.", true],
		[1, "", "Q: menyalakan atau mematikan tembak otomatis.", true],
		[1, "", "Shift: boost, jika booster terpasang.", true],
		[1, "", "E: berlabuh di stasiun di depan, atau memasuki [[world/stream|S.T.R.E.A.M.]] di sebuah gerbang.", true],
		[1, "", "R: ketuk untuk menu autopilot, tahan untuk langsung menuju tujuan saat ini.", true],
		[1, "", "T: mempercepat waktu; percepatan yang lebih tinggi tersedia selama autopilot mengemudi dan tidak ada bahaya di dekat kapal.", true],
		[1, "", "M: peta. C: mengganti kamera. L: lampu depan (dengan Pencahayaan lanjutan).", true],
		[1, "", "Esc: jeda, atau kembali dari menu mana pun. F5 menyimpan saat berlabuh; F11 beralih ke layar penuh dan sebaliknya.", true],
		[1, "", "Di Pengaturan › Kontrol › Kemudi, roda mouse dapat diatur untuk menaikkan dan menurunkan gas bertahap; S lalu menghentikan kapal seketika.", false],
		[1, "Gamepad", "Secara bawaan kedua stik mengemudi: stik kiri menggeser atau membelokkan dan mengangguk, stik kanan membelokkan dan mengangguk. Setiap sumbu stik dapat diberi peran lain, termasuk gas atau kamera, di Pengaturan › Kontrol › Gamepad, tempat pembalikan angguk, getaran, dan zona mati juga diatur.", false],
		[1, "", "D-pad atas dan bawah: gas. A: menembakkan set senjata yang dipilih. RT: senjata. LT: harpun. Klik stik kiri: boost.", true],
		[1, "", "X: mengganti set senjata. Y: berlabuh atau memasuki S.T.R.E.A.M. LB: menu autopilot. RB: mempercepat waktu.", true],
		[1, "", "View: peta. D-pad kiri: ketuk untuk mengganti kamera, tahan untuk melihat dengan stik kanan. D-pad kanan: lampu depan.", true],
		[1, "", "Start atau B: jeda. Di menu, A memilih dan B kembali.", true],
		[1, "Sentuh", "Kontrol sentuh menyala sendiri saat layar disentuh, atau dapat dinyalakan dan dimatikan di Pengaturan › Kontrol › Kontrol sentuh. Stik kemudi muncul di bawah ibu jari kiri; seretan di tempat lain mana pun dipakai untuk melihat sekeliling. Tombol besar SENJATA menembak selama ditahan; batang tegak di atasnya adalah gas: sentuh atau geser di sepanjangnya untuk mengatur kecepatan. KAIT menembakkan harpun, BOOST menyalakan boost, dan tombol LABUH berdenyut ketika kapal dapat berlabuh. Ketuk dua kali SENJATA atau KAIT untuk tembak otomatis, dan ketuk lagi untuk berhenti.", false],
		[1, "", "WAKTU, RUTE (autopilot), PETA, dan JEDA berada di tepi layar; kamera dan layar penuh ada di menu jeda. Setiap tombol dapat dipindahkan dan diubah ukurannya dengan Sesuaikan posisi kontrol, dan kapal juga dapat dikemudikan dengan memiringkan perangkat.", false],
		[1, "Layar stasiun", "Berlabuh menyimpan permainan secara otomatis dan membuka layar utama stasiun, yang menunjukkan apakah stasiun itu milik kolonis atau pemberontak, level teknologinya, dan kredit sang pilot. Tombol panah atau D-pad berpindah antartombol, Enter atau A membukanya, dan Esc atau B kembali. BERANGKAT membawa kapal kembali ke air.", false],
		[1, "", "Hanggar: toko peralatan (beli dan pasang, atau jual yang terpasang), dealer kapal dengan model setiap lambung yang dapat diputar dan harga tukar-tambah untuk kapal saat ini, bengkel untuk membuat barang di stasiun pemberontak, serta ringkasan kapal dan kargonya. Lihat [[guide/fitting]].", true],
		[1, "", "Misi: tujuan saat ini dan jurnal, serta papan kerja berisi kontrak setelah papan itu terbuka. Kontrak memerlukan deposit, yang hangus jika kontrak ditinggalkan. Lihat [[guide/contracts]].", true],
		[1, "", "Peta: peta stasiun, dengan pencarian, tampilan samping kedalaman, dan tombol untuk mengatur autopilot atau merencanakan perpindahan lewat S.T.R.E.A.M. Lihat [[guide/navigation]].", true],
		[1, "", "Dagang: membeli dan menjual barang; hanya stasiun pemberontak yang berdagang. Lihat [[guide/trading]].", true],
		[1, "", "Status: kapal, statistik sang pilot, dan medali. Lihat [[guide/medals]].", true],
		[1, "", "Sistem: tiga slot simpanan, pengaturan, bantuan, referensi ini, transfer simpanan, memuat ulang checkpoint stasiun, dan menu utama.", true],
	],
	"guide/medals": [
		[1, "Meraih medali", "Medali mencatat pencapaian seorang pilot. Sebagian besar tersedia dalam perunggu, perak, dan emas; sisanya adalah penghargaan tunggal. Kemajuan diperiksa setiap kali kapal berlabuh, dan medali baru diumumkan di stasiun. Medali yang sudah diraih tidak pernah hilang, dan tingkat yang lebih tinggi menggantikan yang lebih rendah. Profil Anda di bawah Status menampilkan medali yang telah diraih.", false],
		[1, "Medali karier", "Medali ini dihitung sepanjang karier (perunggu, perak, emas):", false],
		[1, "", "[[medal/4]]: musuh dihancurkan, 50, 200, dan 400.", true],
		[1, "", "[[medal/5]]: makhluk ditangkap, 50, 150, dan 300.", true],
		[1, "", "[[medal/6]]: stasiun yang disinggahi, 50, 100, dan 200.", true],
		[1, "", "[[medal/8]]: barang dibuat, 50, 250, dan 500.", true],
		[1, "", "[[medal/12]]: kontrak diselesaikan, 10, 25, dan 50.", true],
		[1, "", "[[medal/13]]: kedatangan di area stasiun baru, 50, 150, dan 300.", true],
		[1, "", "[[medal/14]]: bajak laut dihancurkan, 25, 150, dan 350.", true],
		[1, "", "[[medal/18]]: bangkai kapal diangkut, 25, 150, dan 350.", true],
		[1, "", "[[medal/19]]: kredit yang dimiliki sekaligus, 125.000, 500.000, dan 1.000.000.", true],
		[1, "", "[[medal/20]]: peralatan baru dibeli, 5, 10, dan 20.", true],
		[1, "", "[[medal/11]]: jam bermain, 5, 7, dan 10.", true],
		[1, "", "[[medal/21]]: titik tertinggi yang dicapai, 15.000, 12.000, dan 10.000 m.", true],
		[1, "Medali satu perjalanan", "Medali ini menilai satu perjalanan, dari meninggalkan satu stasiun hingga berlabuh di stasiun berikutnya:", false],
		[1, "", "[[medal/9]]: musuh dihancurkan dalam satu perjalanan, 5, 10, dan 15.", true],
		[1, "", "[[medal/10]]: tangkapan dalam satu perjalanan, 5, 10, dan 15.", true],
		[1, "", "[[medal/1]]: berlabuh dengan lambung di bawah 30%, 15%, dan 5%.", true],
		[1, "", "[[medal/16]]: senjata terpasang saat berlabuh, 3, 5, dan 8.", true],
		[1, "", "[[medal/15]]: berlabuh tanpa senjata terpasang. Bab-bab pembuka tidak dihitung.", true],
		[1, "Penghargaan", "[[medal/0]] diberikan saat tiba di koloni.", true],
		[1, "", "[[medal/3]] dan [[medal/2]]: tangkap setiap spesies ikan dan setiap alga setidaknya sekali.", true],
		[1, "", "[[medal/7]]: buat setiap produk setidaknya sekali.", true],
		[1, "", "[[medal/17]]: selesaikan cerita.", true],
		[1, "", "Ada dua medali lagi. Satu diberikan untuk menyelam di bawah 30.000, 32.000, dan 35.000 m. Yang lain diberikan karena memiliki semua medali lainnya, dan koleksi lengkap itu juga memangkas harga [[ship/10]] menjadi 50.000 kredit. Lihat [[guide/depth]] dan [[guide/fitting]].", false],
	],
	"guide/navigation": [
		[1, "Peta", "Dua ratus stasiun terletak di peta berbentuk persegi. [[chart]] dalam referensi ini menampilkan masing-masing dengan warna pemiliknya. Di dalam game, layanan Peta stasiun dan peta saat di laut menampilkan peta yang sama, dengan rute terakhir Anda, tujuan misi, dan stasiun dalam jangkauan S.T.R.E.A.M. Setiap halaman stasiun mencantumkan tetangga terdekatnya beserta jarak di peta dan kedalamannya.", false],
		[1, "Autopilot", "Autopilot mengemudikan kapal untuk Anda. Daftarnya menawarkan tujuan saat ini, berlabuh di stasiun setempat, gerbang S.T.R.E.A.M. setempat, atau stasiun mana pun yang dipilih di peta. Untuk jarak jauh, autopilot melaju melintasi perairan terbuka, menghindari stasiun yang menghalangi, dan berpindah dari area satu stasiun ke area berikutnya.", false],
		[1, "", "Setiap masukan kemudi, gas, boost, atau senjata mengembalikan kendali manual, begitu pula Matikan autopilot di daftar autopilot. Menyalakan tembak otomatis juga mengakhiri autopilot.", false],
		[1, "", "Percepatan waktu berjalan pada 1× atau 2× dengan kendali manual dan hingga 16× dengan autopilot. Bahaya menurunkannya kembali ke 2×: kapal musuh dalam jarak sekitar 550 m, tangkapan di harpun, atau keluar dari rentang kedalaman aman. Percepatan juga kembali ke 1× saat memasuki area stasiun baru.", false],
		[1, "Gerbang S.T.R.E.A.M.", "Setiap stasiun memiliki gerbang S.T.R.E.A.M. yang agak jauh dari stasiun. Arahkan kapal ke area aktivasi gerbang dan gunakan Labuh untuk membuka peta gerbang, yang mencantumkan setiap stasiun dalam jangkauan. Pilih salah satu dan mulai transit. Gerbang terbuka dan kapal muncul di gerbang stasiun tujuan, dengan kerusakan yang tidak berubah.", false],
		[1, "", "Sebuah gerbang menjangkau sekitar seperenam lebar peta dari stasiun saat ini. Mesin memperluas jangkauan ini sesuai nilainya: mesin bernilai +30% menjangkau 30% lebih jauh. Stasiun di luar jangkauan memerlukan beberapa lompatan, atau perjalanan panjang dengan autopilot.", false],
		[1, "", "Selama pertempuran misi di area itu belum selesai, gerbang maupun dermaga stasiun tidak dapat digunakan.", false],
		[1, "Tiba", "Memasuki area stasiun memulai pertempuran misi apa pun yang menunggu di sana. Pilihan tujuan pada autopilot mengarah ke titik-titik pertempuran itu, dan labuh terbuka setelah pertempuran selesai. Lihat [[guide/contracts]].", false],
		[1, "", "Selain itu, perairan di sekitar stasiun dihuni satwa liar setempat dan kapal patroli. Mulai [[chapter/12|bab 12]], beberapa bajak laut mungkin mengintai, makin sering seiring cerita berlanjut. Lihat [[guide/combat]].", false],
		[1, "", "Setiap kedatangan di area stasiun baru dihitung untuk [[medal/13]], dan setiap stasiun yang pertama kali disinggahi dihitung untuk [[medal/6]].", false],
	],
	"guide/tips": [
		[1, "", "Saran singkat untuk berlayar, bertempur, dan mencari uang, dihimpun untuk referensi ini.", false],
		[1, "Dalam pelayaran", "Menahan tombol autopilot (R) membawa kapal langsung ke tujuan saat ini; mengetuknya menawarkan tujuan lain, seperti gerbang S.T.R.E.A.M. terdekat atau stasiun yang dipilih di peta.", true],
		[1, "", "Waktu dapat dipercepat jauh lebih tinggi selama autopilot mengemudi daripada dengan kendali manual, asalkan tidak ada musuh di dekat kapal.", true],
		[1, "", "Masukan kemudi, gas, atau senjata apa pun mengambil alih kendali kembali dari autopilot.", true],
		[1, "", "Boost hanya berfungsi jika booster terpasang, dan perlu waktu untuk mengisi ulang setelah setiap penggunaan.", true],
		[1, "", "Peta menandai stasiun di luar batas kedalaman lambung; lambung atau perisai yang lebih kuat membuatnya terjangkau. Lihat [[guide/depth]].", true],
		[1, "", "Pandangan bebas (Alt atau Ctrl dengan mouse, atau menahan D-pad kiri) memeriksa bagian belakang kapal tanpa mengubah haluan.", true],
		[1, "Bertempur dan memancing", "Senjata dan harpun ditembakkan dengan tombol terpisah, sehingga ikan dapat dikait di tengah pertempuran.", true],
		[1, "", "Tembak otomatis membuat senjata yang dipilih terus menembak selama kedua tangan mengemudi; tembakan berhenti saat sebuah menu terbuka.", true],
		[1, "", "Bekukan aksi di menu jeda menghentikan adegan sehingga kamera dapat digerakkan mengelilinginya dengan bebas.", true],
		[1, "Dagang dan uang", "Hanya stasiun pemberontak yang memiliki pasar atau bengkel; stasiun kolonis tetap menjual peralatan.", true],
		[1, "", "Bengkel mengubah kargo menjadi produk; bandingkan rentang harga resep dengan pasar sebelum membuat satu palka penuh.", true],
		[1, "", "Kapal baru lebih murah daripada kelihatannya: kapal saat ini diterima sebagai tukar-tambah.", true],
		[1, "", "Deposit kontrak hangus jika kontrak ditinggalkan, jadi periksa dulu kedalaman dan jaraknya.", true],
		[1, "Menyimpan", "Berlabuh menyimpan secara otomatis, dan layar Sistem memiliki tiga slot tambahan. F5 menyimpan saat berlabuh.", true],
		[1, "", "Muat ulang checkpoint stasiun kembali ke labuhan terakhir jika penyelaman berjalan buruk.", true],
		[1, "", "Lampu depan memerlukan pengaturan Pencahayaan lanjutan; jika aktif, L menyalakan dan mematikannya.", true],
	],
	"guide/trading": [
		[1, "Tempat berdagang", "Hanya stasiun [[faction/rebels|pemberontak]] yang menjalankan pasar dan bengkel. Stasiun [[faction/colonists|kolonis]] membeli seluruh isi palka saat tiba, setiap barang dengan harga terendahnya, dan tidak menjual apa pun. Di awal cerita setiap stasiun adalah stasiun kolonis, jadi memancing dengan harga tetap adalah satu-satunya penghasilan sampai pasar dibuka. Lihat [[guide/allegiance]].", false],
		[1, "Harga", "Setiap barang memiliki rentang harga, stasiun asal, dan pasar terbaik, yang semuanya ditampilkan di halamannya. Di stasiun asalnya, barang dijual dengan harga terendah. Makin jauh sebuah stasiun dari stasiun asal di peta, makin tinggi harganya, hingga harga tertinggi pada jarak pasar terbaik dan seterusnya.", false],
		[1, "", "Tiga barang impor berlaku sebaliknya: [[goods/33]], [[goods/34]], dan [[goods/35]] paling murah di pasar terbaiknya dan makin mahal makin jauh Anda pergi. Pasar pemberontak mengisi ulang stoknya di antara kunjungan.", false],
		[1, "", "Pasar membeli dan menjual dengan harga yang sama, satu unit setiap kali. Keuntungan datang dari mengangkut barang antarstasiun, bukan dari transaksi di loket.", false],
		[1, "Stok pasar", "Sebuah pasar menyediakan hingga empat produk. Setiap produk harus berada dalam level teknologi stasiun, dan produk lebih sering muncul di dekat stasiun asalnya. Stok sedikit berkurang di antara kunjungan. Tiga stasiun yang paling baru dikunjungi mempertahankan stoknya; di tempat lain stok diundi ulang saat Anda kembali.", false],
		[1, "Produksi", "Bengkel di hanggar mengubah bahan di palka menjadi produk. Sebuah stasiun dapat membuat produk apa pun hingga level teknologinya sendiri. Daftar resep menunjukkan berapa banyak setiap produk yang dapat dibuat dari isi palka; setiap halaman produk mencantumkan bahannya. Misalnya, satu [[goods/21]] membutuhkan satu [[species/4]] dan satu [[species/17]].", false],
		[1, "", "Membuat barang dihitung untuk [[medal/8]], dan membuat setiap produk setidaknya sekali menghasilkan [[medal/7]].", false],
		[1, "Meraih keuntungan", "Beberapa cara menghasilkan uang:", false],
		[1, "", "Beli produk di stasiun asalnya atau di dekatnya, lalu bawa ke arah pasar terbaiknya.", true],
		[1, "", "Ikan dan alga hanya menghabiskan waktu. Mengolahnya menjadi produk bisa lebih menguntungkan daripada menjualnya mentah.", true],
		[1, "", "Jangan berlabuh di stasiun kolonis dengan palka berisi barang berharga: semua yang ada di kapal diambil dengan harga terendah.", true],
		[1, "", "Angkut kargo yang ditinggalkan kapal yang hancur, lalu jual.", true],
		[1, "", "Kontrak [[contract/13]] dan [[contract/14]] membayar pengantaran produk atau tangkapan ke stasiun yang memasangnya.", true],
		[1, "", "Level teknologi stasiun juga menurunkan harga peralatan dan kapalnya; lihat [[guide/fitting]].", false],
	],
	"home": [
		[1, "", "Selamat datang di referensi DEEP, petualangan kapal selam di dunia samudra yang dijajah. Di sini Anda dapat mencari dua ratus stasiun laut dalam, kapal dan peralatan yang dapat Anda beli, makhluk di dalam air, barang yang diperdagangkan antarpasar, kontrak yang ditawarkan, dan medali yang dapat diraih.", false],
		[1, "", "Halaman cerita terbuka seiring Anda bermain. Bab, tokoh, dan peristiwa berikutnya tetap tersembunyi sampai simpanan Anda mencapainya, sehingga Anda dapat menjelajah tanpa bocoran. Nama dan angka berasal dari salinan game Anda sendiri; ikhtisar dan panduan ditulis untuk referensi ini.", false],
		[1, "", "Pilot baru sebaiknya memulai dengan [[world/ocean]] dan [[guide/basics]]. [[chart]] menampilkan setiap stasiun dan siapa yang menguasainya. Setiap panduan menjelaskan satu bagian kehidupan di bawah permukaan, dari [[guide/depth]] dan [[guide/navigation]] hingga [[guide/trading]] dan [[guide/combat]].", false],
	],
	"intro/characters": [
		[1, "", "Halaman-halaman ini menggambarkan orang-orang dalam cerita: sang pilot, komputer kapal, sekutu dan musuh yang ditemui sepanjang jalan, serta suara-suara yang terdengar di radio. Setiap biografi mengikuti urutan kampanye dan bertambah seiring Anda bermain, hanya menampilkan apa yang sudah diketahui pilot Anda.", false],
		[1, "", "Sebagian pembicara tidak memiliki nama sendiri. Nama peran seperti [[character/6]], [[character/7]], dan [[character/10]] mewakili banyak suara kecil dari setiap faksi, dan halaman masing-masing menjelaskan siapa yang berbicara di baliknya. Untuk kisah secara keseluruhan, lihat [[world/history]].", false],
	],
	"intro/contracts": [
		[1, "", "Lima belas jenis pekerjaan yang dapat ditawarkan stasiun. Setiap halaman menyebutkan tujuannya, pihak yang memasangnya, batasan apa pun, dan bab cerita yang dibangun di atas jenis misi yang sama. Lihat [[guide/contracts]] tentang deposit, bayaran, dan bagaimana kesulitan menyesuaikan dengan peringkat Anda. Kontrak tersedia di papan kerja mulai [[chapter/9|bab 9]].", false],
	],
	"intro/equipment": [
		[1, "", "Semua peralatan yang dapat dipasang di kapal: senjata, torpedo, harpun, perisai, zirah, modul kargo, mesin, kemudi, radar, booster, dan sistem perbaikan. Setiap halaman memuat nilai barang, seberapa langka di toko, apakah dapat dipasang lebih dari satu, dan harganya di setiap level teknologi. Lihat [[guide/fitting]] dan [[guide/combat]].", false],
	],
	"intro/factions": [
		[1, "", "Kekuatan-kekuatan di samudra: [[faction/colonists]], [[faction/rebels]], dan [[faction/pirates]]. Setiap halaman menjelaskan pengaruh faksi terhadap permainan, seperti dagang, kontrak, dan hadiah, serta mencantumkan stasiunnya dan kemunculannya dalam cerita hingga bab Anda saat ini. Lihat [[guide/allegiance]] tentang cara stasiun berganti pihak.", false],
	],
	"intro/goods": [
		[1, "", "Segala sesuatu yang dapat diangkut di palka: tangkapan, produk, barang impor, dan barang angkutan dari bangkai kapal. Setiap halaman menampilkan level teknologi barang, stasiun asal, pasar terbaik, dan rentang harganya, resepnya atau kegunaannya, serta aturan khusus apa pun. Lihat [[guide/trading]] tentang cara kerja harga dan cara meraih untung.", false],
	],
	"intro/guide": [
		[1, "", "Panduan praktis untuk memainkan DEEP. Mulailah dengan [[guide/basics]], lalu baca tentang [[guide/depth]], [[guide/navigation]], [[guide/fishing]], [[guide/trading]], [[guide/combat]], [[guide/fitting]], [[guide/contracts]], [[guide/allegiance]], dan [[guide/medals]]. Setiap panduan menjelaskan satu bagian kehidupan di bawah permukaan dengan bahasa sederhana, memakai angka yang digunakan game itu sendiri, dan menautkan ke stasiun, peralatan, dan medali yang disebutkannya. Detail cerita tetap tersembunyi sampai simpanan Anda mencapainya.", false],
	],
	"intro/medals": [
		[1, "", "Medali yang dapat diraih seorang pilot. Setiap halaman menjelaskan apa yang dihargai medali itu dan, untuk medali bertingkat, apa yang diperlukan untuk perunggu, perak, dan emas. Lihat [[guide/medals]] tentang kapan medali diperiksa dan mana yang menilai satu perjalanan. Medali diperiksa setiap kali Anda berlabuh, dan koleksi lengkap memberikan hadiahnya sendiri.", false],
	],
	"intro/ships": [
		[1, "", "Setiap lambung kapal selam dalam game, dari [[ship/0]] awal hingga [[ship/10]]. Setiap halaman mencantumkan kekuatan lambung, kapasitas kargo, slot peralatan, kemudi, dan harga daftar, kapan galangan mulai menawarkannya, serta tabel perbandingan semua lambung. Lihat [[guide/fitting]] tentang membeli kapal dan menukar-tambah kapal lama.", false],
	],
	"intro/species": [
		[1, "", "Makhluk dan alga di samudra. Setiap halaman memuat massa, ketahanan, berapa lama spesies itu melawan di harpun, rentang harganya, dan stasiun tempat ia hidup, beserta produk dan kontrak yang memakainya. Lihat [[guide/fishing]] tentang cara menangkapnya.", false],
	],
	"intro/stations": [
		[1, "", "Dua ratus stasiun di samudra, dalam urutan abjad. Setiap halaman memuat level teknologi, kedalaman, dan posisi stasiun di peta, pihak yang menguasainya, peralatan kedalaman yang diperlukan untuk mencapainya, spesies yang ada di sekitarnya, barang yang menjadikannya stasiun asal atau pasar terbaik, perannya dalam cerita, dan tetangga terdekatnya. [[chart]] menampilkan semuanya sekaligus.", false],
	],
	"intro/story": [
		[1, "", "Kisah kampanye ini berlangsung dalam 48 bab, sejak tangkapan pertama sang pilot. Untuk satu uraian alur cerita yang utuh dan tersusun per babak, bacalah [[world/history]]. Halaman itu bertambah seiring Anda bermain dan tidak pernah melampaui bab yang telah dicapai simpanan Anda.", false],
		[1, "", "Setiap bab juga memiliki halamannya sendiri, berisi sinopsis misi dan, setelah Anda melanjutkan, hasilnya. Akhir sebuah bab baru muncul ketika Anda mencapai bab berikutnya, sehingga halaman-halaman ini tidak pernah mengungkap lebih dari yang telah Anda mainkan.", false],
	],
	"intro/world": [
		[1, "", "Latar belakang tentang dunia DEEP. [[world/ocean]] menggambarkan latarnya sendiri: kedalaman dan tekanannya, cahayanya, dan satwanya. [[world/colony]] menjelaskan bagaimana stasiun dijalankan, bagaimana perdagangan dan kontrak bekerja, dan siapa yang menjaga ketertiban. [[world/stream]] membahas jaringan gerbang yang menghubungkan stasiun, dan [[world/history]] menceritakan kisahnya sejauh yang telah Anda mainkan.", false],
		[1, "", "Halaman-halaman ini bertambah seiring kemajuan simpanan Anda. Peristiwa berikutnya, tokoh baru, dan rahasia kedalaman baru muncul setelah Anda mencapainya, dan artikel-artikel lain terbuka saat cerita mengungkap pokok bahasannya.", false],
	],
	"medal/0": [
		[1, "", "Setiap pilot menerima medali ini saat tiba di planet. Medali ini tidak memerlukan usaha apa pun dan sekadar menandai awal karier.", false],
	],
	"medal/1": [
		[1, "", "Diberikan karena berlabuh dengan sisa lambung yang sangat sedikit. Perunggu memerlukan lambung kurang dari 30%, perak kurang dari 15%, dan emas kurang dari 5%. Lambung dihitung pada saat berlabuh.", false],
	],
	"medal/10": [
		[1, "", "Diberikan karena mendaratkan banyak tangkapan dalam satu perjalanan, antara lepas labuh dan berlabuh. Perunggu memerlukan lebih dari 5, perak lebih dari 10, dan emas lebih dari 15. Palka yang besar membantu.", false],
	],
	"medal/11": [
		[1, "", "Menghargai total waktu bermain dalam karier saat ini. Perunggu diberikan setelah lebih dari lima jam, perak setelah tujuh, dan emas setelah sepuluh.", false],
	],
	"medal/12": [
		[1, "", "Menghitung kontrak dari papan kerja stasiun yang telah diselesaikan sang pilot. Perunggu memerlukan lebih dari 10, perak lebih dari 25, dan emas lebih dari 50.", false],
	],
	"medal/13": [
		[1, "", "Menghitung perjalanan melalui jaringan S.T.R.E.A.M. antarstasiun. Perunggu memerlukan lebih dari 50, perak lebih dari 150, dan emas lebih dari 300.", false],
	],
	"medal/14": [
		[1, "", "Menghitung bajak laut yang dihancurkan sepanjang karier. Perunggu memerlukan lebih dari 25, perak lebih dari 150, dan emas lebih dari 350.", false],
	],
	"medal/15": [
		[1, "", "Diberikan karena menyelesaikan satu perjalanan tanpa senjata atau torpedo terpasang. Harpun tidak dihitung sebagai senjata. Bab-bab tutorial tidak memenuhi syarat.", false],
	],
	"medal/16": [
		[1, "", "Diberikan karena berlabuh dengan banyak senjata dan torpedo terpasang sekaligus. Perunggu memerlukan setidaknya 3, perak setidaknya 5, dan emas setidaknya 8, yang membutuhkan lambung dengan banyak slot.", false],
	],
	"medal/17": [
		[1, "", "Diberikan karena menyelesaikan cerita utama. Medali ini tidak dapat diraih dengan cara lain, jadi biasanya menjadi salah satu medali terakhir yang dikumpulkan seorang pilot.", false],
	],
	"medal/18": [
		[1, "", "Menghitung peti kargo yang diambil dengan harpun dari kapal yang hancur. Perunggu memerlukan lebih dari 25, perak lebih dari 150, dan emas lebih dari 350.", false],
	],
	"medal/19": [
		[1, "", "Menghargai saldo kredit terbesar yang pernah dicapai. Perunggu memerlukan lebih dari 125.000, perak lebih dari 500.000, dan emas lebih dari 1.000.000.", false],
	],
	"medal/2": [
		[1, "", "Diberikan karena menangkap setidaknya satu dari masing-masing kelima spesies alga. Alga diam di dasar laut, jadi ini salah satu penghargaan yang lebih mudah.", false],
	],
	"medal/20": [
		[1, "", "Menghitung peralatan baru yang dibeli di toko. Perunggu memerlukan lebih dari 5, perak lebih dari 10, dan emas lebih dari 20.", false],
	],
	"medal/21": [
		[1, "", "Menghargai kedalaman paling dangkal yang pernah dicapai. Perunggu memerlukan naik di atas 15.000 m, perak di atas 12.000 m, dan emas di atas 10.000 m. Dua tingkat yang lebih tinggi berada di luar batas perisai mana pun.", false],
	],
	"medal/22": [
		[1, "", "Menghargai penyelaman terdalam. Perunggu memerlukan 30.000 m, perak 32.000 m, dan emas 35.000 m. Dua tingkat yang lebih tinggi berada di luar batas zirah mana pun.", false],
	],
	"medal/23": [
		[1, "", "Diberikan setelah semua medali lainnya diraih, pada tingkat mana pun. Dengan medali ini, sang pilot dapat membeli [[ship/10]] dengan harga yang jauh di bawah harga daftarnya.", false],
	],
	"medal/3": [
		[1, "", "Diberikan karena menangkap setidaknya satu dari setiap spesies makhluk perenang. Perairan setiap stasiun memiliki campuran spesies yang berbeda, jadi ini berarti memancing di banyak tempat.", false],
	],
	"medal/4": [
		[1, "", "Menghitung semua musuh yang dihancurkan sepanjang karier. Perunggu memerlukan lebih dari 50, perak lebih dari 200, dan emas lebih dari 400.", false],
	],
	"medal/5": [
		[1, "", "Menghitung setiap makhluk atau alga yang ditangkap dengan harpun sepanjang karier. Perunggu memerlukan lebih dari 50 tangkapan, perak lebih dari 150, dan emas lebih dari 300.", false],
	],
	"medal/6": [
		[1, "", "Diberikan karena berlabuh di banyak stasiun yang berbeda. Perunggu memerlukan lebih dari 50, perak lebih dari 100, dan emas lebih dari 200, yang berarti hampir setiap stasiun di peta.", false],
	],
	"medal/7": [
		[1, "", "Diberikan setelah sang pilot memproduksi setiap produk setidaknya sekali. Sebagian resep membutuhkan barang impor atau produk lain, jadi koleksi lengkap memerlukan perencanaan.", false],
	],
	"medal/8": [
		[1, "", "Menghitung semua barang yang diproduksi di pabrik stasiun. Perunggu memerlukan lebih dari 50 unit, perak lebih dari 250, dan emas lebih dari 500.", false],
	],
	"medal/9": [
		[1, "", "Diberikan karena menghancurkan banyak musuh dalam satu perjalanan, antara meninggalkan satu stasiun dan berlabuh di stasiun berikutnya. Perunggu memerlukan lebih dari 5, perak lebih dari 10, dan emas lebih dari 15.", false],
	],
	"ship/0": [
		[1, "Ikhtisar", "[[ship/0]] adalah lambung yang dimiliki setiap pilot di awal permainan, dan yang termurah dalam daftar dengan harga 45.000 cr. Lambung ini juga yang terlemah dalam hampir segala hal: 75 poin lambung, palka 25 t, dan enam slot peralatan. Nilai kemudinya 1,10 tergolong rata-rata, sama dengan [[ship/8]] yang jauh lebih besar.", false],
		[1, "", "Kapal ini dilengkapi [[equipment/15]], [[equipment/18]], [[equipment/22]], dan [[equipment/35]]. Dengan begitu hanya dua dari enam slot yang tersisa untuk senjata atau modul kargo.", false],
		[1, "Dalam penggunaan", "Palka yang kecil adalah batasan yang sebenarnya. Beberapa tangkapan sedang sudah memenuhinya, dan [[species/12]] berukuran rata-rata lebih berat daripada yang dapat diangkutnya. Dengan tambahan 30.000 cr, [[ship/1]] menawarkan 40 poin lambung ekstra, kargo hampir dua kali lipat, dan kemudi yang jauh lebih tajam dengan jumlah slot yang sama, sehingga sebagian besar pilot mengganti kapal awal ini begitu tabungan mencukupi. Sampai saat itu, ini adalah lambung latihan: cukup untuk perjalanan memancing pertama dan pertarungan ringan melawan bajak laut di dekat rumah, tetapi tidak untuk perjalanan dagang jauh atau pertempuran berat.", false],
	],
	"ship/1": [
		[1, "Ikhtisar", "[[ship/1]] adalah kapal penangkap ikan yang kokoh dan terjangkau. Dibandingkan [[ship/0]], kapal ini mendapat tambahan 40 poin lambung, 20 t kargo, dan pengendalian yang jauh lebih gesit: nilai kemudinya 1,61 hanya kalah dari [[ship/5]]. Namun, kapal ini tetap memiliki enam slot, dan batas itulah yang menentukan karakter lambung ini. Harpun, perisai, zirah, dan radar hanya menyisakan ruang untuk dua senjata atau modul kargo.", false],
		[1, "Dalam penggunaan", "Galangan biasa menjualnya sejak bab pertama seharga 75.000 cr, sehingga kapal ini menjadi peningkatan pertama yang wajar bagi pilot yang terutama memancing dan menjalankan tugas singkat. Kapal ini bahkan mengungguli [[ship/2]] yang lebih mahal dalam lambung, kargo, dan kemudi, hanya kalah satu slot. Begitu misi menuntut daya tembak lebih besar atau palka lebih luas, slot ketujuh dan kedelapan pada lambung berikutnya lebih penting daripada ketangguhan semata, dan Okeanos biasanya ditukar-tambah.", false],
	],
	"ship/10": [
		[1, "Ikhtisar", "[[ship/10]] adalah kapal andalan mewah dan lambung serbaguna terbaik. Kapal ini menggabungkan 200 poin lambung, palka 100 t, sepuluh slot, dan kemudi 1,50. Hanya [[ship/6]] yang mengunggulinya dalam lambung atau kargo, dan hanya [[ship/5]], [[ship/1]], dan [[ship/3]] yang berbelok lebih cepat. Harga daftarnya 5.000.000 cr, lebih dari empat belas kali harga [[ship/9]].", false],
		[1, "Dalam penggunaan", "Galangan biasa menawarkannya mulai [[chapter/40]]. Hanya sedikit pilot yang mampu membayar harga daftarnya. Pilot yang memiliki setiap medali, sehingga melengkapi [[medal/23]], dapat membelinya seharga 50.000 cr, sebelum potongan biasa sesuai level teknologi stasiun. Hal ini menjadikan Aquarius sebagai hadiah atas lengkapnya koleksi medali alih-alih pembelian yang praktis. Saat kapal ini tersedia, sebagian besar kampanye sudah dilalui sang pilot.", false],
	],
	"ship/2": [
		[1, "Ikhtisar", "[[ship/2]] adalah lambung termurah dengan tujuh slot peralatan, seharga 100.000 cr. Nilai lambung dan kargonya (100 poin dan 40 t) justru lebih rendah daripada [[ship/1]], dan kemudinya 1,40 tergolong baik tetapi tidak istimewa. Uang tambahan itu membeli slot ketujuh, yang dapat diisi senjata kedua atau modul kargo.", false],
		[1, "Dalam penggunaan", "Kapal ini dijual sejak bab pertama, sehingga pilot yang menabung lebih awal dapat beralih ke tujuh slot jauh sebelum muncul pilihan yang lebih baik. Namun, mulai [[chapter/5]], [[ship/3]] menawarkan lambung dan jumlah slot yang sama dengan kargo 6 t lebih banyak dan kemudi lebih baik hanya dengan tambahan 5.000 cr. Setelah itu Triops terutama layak dibeli jika kebetulan dijual di dekat Anda sementara alternatifnya tidak. Kapal ini cocok bagi pilot yang ingin melawan bajak laut sejak awal, karena slot cadangannya dapat menampung senjata kedua.", false],
	],
	"ship/3": [
		[1, "Ikhtisar", "[[ship/3]] menyempurnakan tata letak tujuh slot milik [[ship/2]]. Dengan tambahan harga hanya 5.000 cr, kapal ini menambah 6 t ruang palka dan menaikkan kemudi dari 1,40 menjadi 1,57, menjadikannya salah satu lambung paling lincah dalam game. Lambungnya yang 100 poin biasa saja, jadi perisai dan zirah yang paling banyak memberi perlindungan.", false],
		[1, "Dalam penggunaan", "Galangan biasa mulai menjualnya sejak [[chapter/5]]. Kapal ini cocok bagi pilot yang ingin bertempur dan memancing dengan kapal yang sama tanpa pengeluaran besar, dan tetap menjadi pilihan masuk akal sampai lambung delapan slot tersedia. Dibandingkan [[ship/4]], lambung berikutnya yang muncul, kapal ini kalah 75 poin lambung dan 24 t kargo, tetapi berbelok jauh lebih cepat dan harganya 25.000 cr lebih murah.", false],
	],
	"ship/4": [
		[1, "Ikhtisar", "[[ship/4]] adalah kapal barang berat dalam versi mini. Kapal ini membawa 175 poin lambung, palka 70 t, dan delapan slot seharga 130.000 cr, sehingga menjadi lambung delapan slot termurah. Harganya adalah pengendalian: nilai kemudinya 0,91 lebih rendah daripada kapal mana pun sebelumnya, dan hanya [[ship/6]] yang berbelok lebih lambat.", false],
		[1, "Dalam penggunaan", "Kapal ini muncul di galangan biasa mulai [[chapter/10]]. Pedagang dan nelayan paling diuntungkan olehnya. Palka dasarnya yang besar juga membuat modul kargo lebih efektif, karena bonusnya berupa persentase kapasitas dasar. Modul kemudi mengimbangi sebagian kelambanannya. Pilot yang terutama bertempur mungkin lebih memilih [[ship/5]], yang 20.000 cr lebih mahal dan berbelok tepat dua kali lebih cepat, tetapi kekuatan lambungnya nyaris hanya separuhnya.", false],
	],
	"ship/5": [
		[1, "Ikhtisar", "[[ship/5]] adalah kapal duel jarak dekat. Nilai kemudinya 1,82 adalah yang terbaik dari semua lambung, sehingga kapal ini dapat bertahan di belakang lawan dan menjaga target tetap dalam bidikan. Namun perlindungannya tipis: dengan 90 poin, lambungnya lebih lemah daripada [[ship/1]], dan palka 40 t-nya sederhana. Delapan slot menyisakan banyak ruang untuk senjata.", false],
		[1, "Dalam penggunaan", "Galangan biasa menjualnya mulai [[chapter/15]] seharga 150.000 cr. Kapal ini menguntungkan pilot yang pandai menghindari tembakan, idealnya didukung perisai dan zirah yang kuat, dan merupakan pilihan buruk untuk mengangkut barang. Karena semua senjata yang terpasang menembak bersamaan, slot cadangan langsung berubah menjadi daya tembak. Pilot yang menginginkan lambung delapan slot yang lebih kokoh sebaiknya membandingkannya dengan [[ship/4]] atau menunggu [[ship/6]].", false],
	],
	"ship/6": [
		[1, "Ikhtisar", "[[ship/6]] adalah kapal kargo curah yang besar. Palka 180 t-nya jauh melampaui lambung lain mana pun, hampir dua kali lipat [[ship/10]], dan 220 poin lambungnya adalah yang tertinggi dalam game. Dengan harga 170.000 cr, kapal ini juga lebih murah daripada [[ship/7]] dan semua lambung sesudahnya. Kekurangannya adalah pengendalian: dengan nilai kemudi 0,67, kapal ini berbelok lebih lambat daripada kapal lain mana pun.", false],
		[1, "Dalam penggunaan", "Kapal ini masuk ke galangan biasa mulai [[chapter/20]]. Untuk berdagang dan perjalanan memancing besar, kapal ini tak tertandingi. Modul kargo dihitung dari kapasitas dasar, jadi satu modul +80% menambah 144 t. Dalam pertempuran kapal ini mengandalkan daya tahan menyerap kerusakan, bukan menghindarinya, dan modul kemudi hampir wajib untuk menghadapi bajak laut yang gesit. Dengan hanya delapan slot, kapal ini juga punya ruang lebih sedikit untuk senjata dibandingkan lambung-lambung berikutnya.", false],
	],
	"ship/7": [
		[1, "Ikhtisar", "[[ship/7]] adalah lambung pertama dengan sembilan slot. Nilai lainnya sedang-sedang saja: 135 poin lambung, palka 50 t, dan kemudi 1,23, yang mengalahkan [[ship/0]] tetapi jauh di bawah [[ship/5]]. Dengan harga 215.000 cr, kapal ini jauh lebih mahal daripada [[ship/6]], jadi harganya sebagian besar untuk membayar slot tambahan.", false],
		[1, "Dalam penggunaan", "Kapal ini muncul di galangan biasa mulai [[chapter/25]]. Kapal ini cocok bagi pilot yang menginginkan satu senjata atau modul lebih banyak daripada yang dimungkinkan lambung delapan slot, tanpa harus membayar kapal sepuluh slot yang menyusul. Sebagai kapal serbaguna ia solid, tetapi tidak menonjol di satu bidang pun. [[ship/8]], lima bab kemudian, menambahkan slot kesepuluh, 15 poin lambung, dan 16 t kargo dengan tambahan 85.000 cr.", false],
	],
	"ship/8": [
		[1, "Ikhtisar", "[[ship/8]] adalah lambung sepuluh slot pertama. Kapal ini membawa 150 poin lambung dan palka 66 t, dan kemudinya sama dengan [[ship/0]], dengan nilai 1,10. Dengan harga 300.000 cr, kapal ini 85.000 cr lebih mahal daripada [[ship/7]] untuk satu slot tambahan dan sedikit peningkatan lambung serta kargo.", false],
		[1, "Dalam penggunaan", "Galangan biasa mencantumkannya mulai [[chapter/30]]. Dengan sepuluh slot, pilot dapat memasang perlengkapan pertahanan lengkap, harpun, dan radar, dan masih dapat memasang beberapa senjata atau modul kargo. Pengendaliannya hanya rata-rata, jadi modul kemudi membantu dalam pertarungan jarak dekat. [[ship/9]], yang muncul lima bab kemudian, mengorbankan 6 t palka demi 15 poin lambung tambahan dan kemudi yang lebih baik. Pontos tetap yang lebih murah di antara keduanya dan pilihan yang lebih baik bila kargo penting.", false],
	],
	"ship/9": [
		[1, "Ikhtisar", "[[ship/9]] adalah lambung sepuluh slot kelas atas. Dibandingkan [[ship/8]], kapal ini menambah 15 poin lambung dan kemudi yang jelas lebih tajam (1,36 berbanding 1,10), tetapi kehilangan 6 t kargo. Dengan harga 350.000 cr, kapal ini 50.000 cr lebih mahal.", false],
		[1, "Dalam penggunaan", "Galangan biasa menjualnya mulai [[chapter/35]]. Kapal ini paling cocok bagi pilot yang berorientasi tempur di bagian akhir kampanye, yang lebih diuntungkan oleh sepuluh slot dan pengendalian yang baik daripada oleh ruang palka. Untuk dagang curah, [[ship/6]] mengangkut tiga kali lebih banyak dengan separuh harga. Satu-satunya lambung yang mengungguli Lir dalam sebagian besar hal adalah [[ship/10]], yang harga daftarnya berada di kelas tersendiri.", false],
	],
	"species/0": [
		[1, "Ikhtisar", "[[species/0]] dimodelkan berdasarkan nautilus, sefalopoda bercangkang dari wilayah tropis Indo-Pasifik. Nautilus hidup di ruang terluar cangkangnya yang melingkar dan mengatur daya apungnya dengan menyesuaikan gas dan cairan di ruang-ruang bagian dalam. Ia berenang dengan dorongan semburan air dan menangkap makanan dengan puluhan tentakel tanpa alat pengisap. Nautilus biasanya tinggal beberapa ratus meter di bawah permukaan, dan cangkangnya dapat meledak ke dalam jika turun jauh melebihi sekitar 800 m.", false],
		[1, "Dalam game", "Dalam game, makhluk ini beratnya sekitar 8 t dan hampir tidak melawan di harpun: tali hanya butuh 2,1 dtk untuk menaklukkannya. Hal ini menjadikannya salah satu tangkapan termudah, tetapi harganya 44 sampai 156 cr per ton tergolong rendah. Makhluk ini hidup di perairan 67 stasiun.", false],
		[7, "", "Di [[chapter/7]] sang pilot harus menyingkirkan hewan-hewan ini dari perairan di sekitar [[station/1]], baik dengan menangkap maupun membunuhnya.", false],
	],
	"species/1": [
		[1, "Ikhtisar", "[[species/1]] mengambil namanya dari Eurypharynx pelecanoides, ikan laut dalam yang ditemukan pada kedalaman sekitar 500 hingga 3.000 m. Mulutnya yang berengsel longgar sangat besar dibandingkan tubuhnya yang ramping seperti cambuk, dan dapat membuka cukup lebar untuk menelan mangsa yang jauh lebih besar dari perkiraan. Ekornya berujung organ cahaya kecil. Ikan dewasa biasanya panjangnya jauh di bawah satu meter.", false],
		[1, "Dalam game", "Dalam game, makhluk ini perenang cepat dan melawan harpun selama sekitar 4 dtk, dua kali lebih lama daripada [[species/0]] dengan massa yang sama, 8 t. Usaha itu terbayar: dengan harga 70 sampai 255 cr per ton, ini salah satu tangkapan dengan harga lebih baik. Pabrik memakainya untuk [[goods/24]] dan [[goods/27]], keduanya produk berharga. Harpun dengan perlambatan kuat membuatnya jauh lebih mudah ditangkap.", false],
	],
	"species/10": [
		[1, "Ikhtisar", "[[species/10]] terinspirasi dari cumi-cumi dan gurita, sefalopoda yang terkenal mampu berganti warna dalam sekejap. Kulit mereka memiliki ribuan sel pigmen yang disebut kromatofor, masing-masing dibuka atau ditutup oleh otot-otot kecil, beserta sel pemantul yang menambah kilau. Banyak juga yang memiliki kantong tinta; tinta sotong dulu menjadi sumber pigmen cokelat sepia.", false],
		[1, "Dalam game", "Dalam game, beratnya sekitar 14 t, ketahanannya 28, dan ia meronta di tali selama sekitar 3,4 dtk. Harga mentahnya 59 sampai 164 cr per ton. Dikombinasikan dengan pelarut, makhluk ini menghasilkan [[goods/22]], yang dibutuhkan untuk [[goods/29]].", false],
		[19, "", "Di [[chapter/19]] sang pilot harus melindungi sekawanan makhluk ini di dekat [[station/7]] dari kapal-kapal penyerang.", false],
	],
	"species/11": [
		[1, "Ikhtisar", "\"Loricate\" berarti tertutup lempeng pelindung, dan [[species/11]] mengingatkan pada penyu laut. Saat ini ada tujuh spesies yang hidup. Cangkangnya terbuat dari lempeng tulang yang menyatu dengan tulang belakang dan rusuk. Penyu belimbing adalah yang terbesar, dengan cangkang hingga sekitar 2 m, dan dapat menyelam lebih dari 1.000 m untuk mencari ubur-ubur. Betinanya kembali ke pantai untuk bertelur.", false],
		[1, "Dalam game", "Dalam game, beratnya sekitar 8 t dan menyerah setelah sekitar 2,7 dtk di harpun. Harganya luar biasa bervariasi, dari 40 sampai 244 cr per ton, jadi sebaiknya dijual di tempat permintaannya tinggi. Tidak ada resep pabrik yang memakainya.", false],
	],
	"species/12": [
		[1, "Ikhtisar", "[[species/12]] didasarkan pada paus bergigi, kelompok yang mencakup paus sperma, lumba-lumba, dan pesut. Mereka menemukan mangsa dengan ekolokasi, mengirimkan bunyi klik dan mendengarkan gemanya. Paus sperma adalah pemangsa bergigi terbesar di Bumi. Ia menyelam hingga kedalaman 1.000 m atau lebih untuk berburu cumi-cumi dan dapat bertahan di bawah air lebih dari satu jam.", false],
		[1, "Dalam game", "Dalam game, ini makhluk terberat, sekitar 30 t, dengan ketahanan 60. Satu tangkapan dapat memenuhi palka kecil, dan spesimen rata-rata tidak akan muat di palka 25 t milik [[ship/0]]. Ia hanya melawan selama sekitar 2,9 dtk. Harganya sangat bervariasi, dari 22 sampai 200 cr per ton, dan tidak ada resep yang memakainya.", false],
	],
	"species/13": [
		[1, "Ikhtisar", "[[species/13]] mengingatkan pada alga keemasan (Chrysophyceae) dan kelompok cokelat keemasan yang berkerabat. Warnanya berasal dari pigmen fukoksantin, yang menutupi klorofilnya. Sebagian besar berukuran mikroskopis dan hidup di air tawar, dan sebagian dapat meledak populasinya; satu spesies, Prymnesium parvum, melepaskan racun yang dapat membunuh ikan.", false],
		[1, "Dalam game", "Dalam game, seperti semua alga, ia tertanam di dasar laut, beratnya tetap 2 t, dan ditaklukkan dalam 2,1 dtk. Ini yang paling berharga dari kelima alga, terjual seharga 27 sampai 65 cr per ton. Alga ini dipakai untuk [[goods/27]] dan [[goods/28]].", false],
	],
	"species/14": [
		[1, "Ikhtisar", "[[species/14]] mengingatkan pada alga biru-hijau, atau sianobakteri. Sebenarnya mereka bukan alga, melainkan bakteri yang berfotosintesis. Mereka termasuk bentuk kehidupan tertua yang diketahui dan ikut mengisi atmosfer Bumi dengan oksigen. Sebagian mengikat nitrogen dari udara, dan sebagian dapat melepaskan hidrogen, itulah sebabnya para peneliti mempelajarinya sebagai sumber bahan bakar bersih.", false],
		[1, "Dalam game", "Dalam game, ia tumbuh di dasar laut, beratnya 2 t, dan hanya sedikit melawan. Harganya 21 sampai 47 cr per ton. Cocok dengan sifat aslinya, alga ini digabungkan dengan [[goods/18]] untuk membuat [[goods/19]], dan merupakan salah satu dari lima alga yang dibutuhkan untuk [[goods/28]].", false],
	],
	"species/15": [
		[1, "Ikhtisar", "[[species/15]] mewakili alga cokelat (Phaeophyceae), yang mencakup kelp. Kelp raksasa dapat tumbuh setinggi puluhan meter dan membentuk hutan bawah air yang menjadi tempat berlindung banyak spesies lain. Alga cokelat adalah sumber komersial alginat, yang dipakai untuk mengentalkan makanan dan dalam pengobatan.", false],
		[1, "Dalam game", "Dalam game, ini tangkapan termurah dari semuanya, 14 sampai 47 cr per ton. Seperti alga lainnya, ia diam di dasar laut, beratnya 2 t, dan ditaklukkan dalam 2,1 dtk. Satu-satunya kegunaannya adalah untuk [[goods/28]], yang membutuhkan kelima alga.", false],
	],
	"species/16": [
		[1, "Ikhtisar", "[[species/16]] mengacu pada alga merah (Rhodophyta). Pigmen merah, fikoeritrin, memungkinkannya menyerap cahaya biru yang menembus paling dalam ke laut, sehingga alga ini tumbuh lebih dalam daripada rumput laut lainnya. Alga merah menghasilkan agar dan karagenan, dan nori pembungkus sushi adalah alga merah.", false],
		[1, "Dalam game", "Dalam game, ini alga paling berharga kedua, bernilai 27 sampai 62 cr per ton. Ia berdiri di dasar laut, beratnya 2 t, dan mudah ditangkap dengan harpun. Alga ini menjadi bahan [[goods/27]] bersama [[species/13]] dan juga dibutuhkan untuk [[goods/28]].", false],
	],
	"species/17": [
		[1, "Ikhtisar", "[[species/17]] mewakili alga hijau, kerabat terdekat tumbuhan darat. Selada laut (Ulva) adalah contoh yang umum di pesisir. Sebagian rumput laut hijau dapat dimakan; di Jepang, serpihan kering yang disebut aonori ditaburkan di atas makanan. Alga hijau membutuhkan banyak cahaya, jadi sebagian besar tumbuh di perairan dangkal.", false],
		[1, "Dalam game", "Dalam game, ini tangkapan bernilai rendah, 20 sampai 44 cr per ton. Seperti alga lainnya, ia tertanam di dasar, beratnya 2 t, dan ditaklukkan dalam 2,1 dtk. Pabrik menggabungkannya dengan [[species/4]] untuk membuat [[goods/21]], dan ia salah satu dari lima alga dalam [[goods/28]].", false],
	],
	"species/2": [
		[1, "Ikhtisar", "[[species/2]] mewakili medusa, tahap berenang bebas dari banyak hewan cnidaria. Ubur-ubur tidak memiliki otak, tulang, atau darah, dan payungnya sebagian besar terdiri dari air. Ia bergerak dengan mendenyutkan payungnya dan hanyut terbawa arus, menangkap mangsa kecil dengan tentakel bersel penyengat. Sebagian spesies bercahaya, dan beberapa bentuk laut dalam berwarna merah atau ungu.", false],
		[1, "Dalam game", "Dengan berat sekitar 2 t, ini salah satu makhluk teringan dalam game, dan ketahanannya 4 berarti satu tembakan nyasar dapat membunuhnya. Di harpun ia menyerah setelah sekitar 2,5 dtk. Harganya 40 sampai 133 cr per ton. Satu-satunya kegunaannya dalam produksi adalah sebagai salah satu dari tiga bahan [[goods/26]].", false],
	],
	"species/3": [
		[1, "Ikhtisar", "[[species/3]] didasarkan pada pari manta, pari terbesar di dunia. Spesies samudra yang lebih besar dapat memiliki rentang sekitar 7 m dari ujung sirip ke ujung sirip. Manta adalah pemakan saring yang jinak: mereka berenang dengan mulut terbuka dan memakai dua cuping berdaging di depan mulut untuk mengarahkan plankton masuk. Manta memiliki salah satu otak terbesar dibandingkan ukuran tubuh di antara semua ikan.", false],
		[1, "Dalam game", "Dalam game, beratnya sekitar 16 t dan ketahanannya 32, sehingga lebih tahan terhadap tembakan yang menyerempet daripada hewan yang lebih kecil. Ia meronta di tali selama sekitar 3,6 dtk. Harga mentahnya 65 sampai 182 cr per ton tergolong sedang, tetapi makhluk inilah yang dibutuhkan untuk [[goods/20]], yang kemudian diolah menjadi [[goods/29]].", false],
	],
	"species/4": [
		[1, "Ikhtisar", "[[species/4]] mewakili kawanan rapat yang dibentuk ikan kecil seperti sarden, teri, dan hering. Berkawanan membingungkan pemangsa, yang kesulitan memilih satu sasaran, dan mungkin juga menghemat tenaga karena ikan berenang di belakang arus ikan lainnya. Kawanan ini adalah dasar banyak rantai makanan laut dan perikanan terbesar di dunia.", false],
		[1, "Dalam game", "Dalam game, satu kawanan ditangkap sebagai satu muatan 4 t. Tangkapan ini tidak merepotkan: harpun menaklukkannya dalam sekitar 2,5 dtk, dan ketahanannya hanya 8. Harganya 53 sampai 138 cr per ton. Makhluk ini menjadi bahan [[goods/21]] dan [[goods/26]], sehingga pilot yang juga menangkap [[species/17]] atau [[species/2]] sudah memiliki rantai pasokan yang siap.", false],
	],
	"species/5": [
		[1, "Ikhtisar", "[[species/5]] mengacu pada ikan sungut ganda, khususnya spesies laut dalam. Duri yang termodifikasi di kepalanya membentuk tangkai dengan umpan di ujungnya. Pada banyak bentuk laut dalam, umpan itu bercahaya berkat bakteri simbiotik, menarik mangsa mendekat ke mulut yang lebar. Pada sebagian spesies, jantan yang mungil melebur secara permanen dengan betina yang jauh lebih besar.", false],
		[1, "Dalam game", "Dalam game, beratnya sekitar 10 t dan menyerah di harpun setelah sekitar 2,5 dtk, sehingga tergolong tangkapan yang cukup cepat. Rentang harganya 53 sampai 216 cr per ton cukup lebar. Bersama [[species/1]] dan pelarut, makhluk ini dibutuhkan untuk [[goods/24]], bahan utama bagi beberapa produk bernilai tinggi.", false],
	],
	"species/6": [
		[1, "Ikhtisar", "\"Devilfish\" adalah julukan lama dari kalangan pelaut. Selama berabad-abad nama itu dipakai untuk pari setan dari genus Mobula, gurita besar, bahkan paus abu-abu. Game ini tidak mengaitkan [[species/6]] dengan salah satu hewan tersebut. Kesamaan mereka adalah ukuran dan reputasi menakutkan yang jarang sesuai dengan perilaku sebenarnya.", false],
		[1, "Dalam game", "Dalam game, ini tangkapan berat dengan bobot sekitar 20 t dan ketahanan 40. Ia melawan harpun selama sekitar 4,2 dtk, termasuk yang terlama di antara semua makhluk. Batas atas harganya juga yang tertinggi di antara semua makhluk, hingga 364 cr per ton. Pabrik memasangkannya dengan [[species/8]] dan garam untuk membuat [[goods/25]].", false],
	],
	"species/7": [
		[1, "Ikhtisar", "[[species/7]] didasarkan pada marlin, ikan berparuh besar dari samudra terbuka yang hangat. Marlin memakai paruhnya yang seperti tombak untuk menebas kawanan mangsa dan termasuk ikan tercepat di laut. Marlin biru terbesar panjangnya lebih dari 4 m dan beratnya beberapa ratus kilogram. Marlin digemari pemancing olahraga karena perlawanannya yang panjang dan akrobatik.", false],
		[1, "Dalam game", "Dalam game, beratnya ringan, sekitar 8 t, tetapi sulit ditangkap: ia berenang cepat dan melawan harpun selama sekitar 4,2 dtk. Harpun dengan jangkauan jauh dan perlambatan kuat mempermudah pekerjaan. Sebagai gantinya, nilainya terjaga dengan baik, terjual seharga 104 sampai 283 cr per ton, batas bawah harga tertinggi di antara semua makhluk. Ini adalah bahan utama [[goods/23]].", false],
	],
	"species/8": [
		[1, "Ikhtisar", "\"Bone shark\" adalah nama lama untuk hiu penjemur, ikan hidup terbesar kedua setelah hiu paus. Hiu penjemur dapat mencapai sekitar 8 m atau lebih. Meski besar, mereka adalah pemakan saring yang tidak berbahaya, berenang perlahan di dekat permukaan dengan mulut besar terbuka untuk menyaring plankton. Mereka bermigrasi jarak jauh dan sering menghabiskan musim dingin di perairan yang lebih dalam.", false],
		[1, "Dalam game", "Dalam game, [[species/8]] beratnya sekitar 18 t dan ketahanannya 36. Ia melawan harpun selama sekitar 3,8 dtk. Harganya 78 sampai 208 cr per ton. Ini salah satu tangkapan yang lebih berguna untuk produksi, karena menjadi bahan [[goods/25]] sekaligus [[goods/26]].", false],
	],
	"species/9": [
		[1, "Ikhtisar", "Tidak ada hewan nyata yang disebut udang goliat, tetapi raksasa sejati memang ada. Udang windu raksasa dapat tumbuh hingga sekitar 30 cm, dan sebagian krustasea laut dalam lebih besar daripada kerabatnya di perairan dangkal, pola yang dikenal sebagai gigantisme laut dalam. Banyak udang laut dalam berwarna merah, yang membuatnya hampir tak terlihat di air yang tidak terjangkau cahaya merah.", false],
		[1, "Dalam game", "Dalam game, [[species/9]] adalah tangkapan kecil 2 t dengan ketahanan 4, yang cepat ditaklukkan dalam sekitar 2,3 dtk. Harganya 39 sampai 122 cr per ton. Tidak ada resep pabrik yang memakainya, jadi makhluk ini ditangkap semata-mata untuk dijual. Kontrak memancing lebih sering memintanya daripada makhluk yang lebih langka seperti [[species/0]].", false],
	],
	"world/abel": [
		[31, "", "[[world/abel]] adalah ilmuwan yang bekerja sama dengan [[faction/rebels|perlawanan]]. Ia tidak pernah muncul di layar, tetapi penelitiannya menjadi inti rencana [[character/2]] untuk membangun senjata yang dapat membalikkan perang melawan koloni.", false],
		[31, "Latar belakang", "Sang profesor telah bertahun-tahun meneliti [[world/biotek]], sumber daya yang belum pernah berhasil dibuat siapa pun. Ia hampir menyelesaikan prototipe yang berfungsi ketika kolonis mencurinya, dan kini mereka berusaha menyelesaikannya sendiri.", false],
		[31, "Peran dalam cerita", "[[character/2]] membawanya beserta timnya ke [[station/14]] untuk membangun senjata baru pemberontak. Mereka tampaknya adalah para ilmuwan yang konvoinya dilindungi sang pilot dalam perjalanan ke sana ([[chapter/29]]). [[character/2]] segera pergi menemuinya sementara sang pilot dan yang lain merebut kembali generator itu ([[chapter/30]]).", false],
		[33, "", "Setelah penyergapan itu, sang profesor membawa kontainer yang berhasil diambil ke laboratoriumnya untuk melanjutkan pengerjaan prototipe ([[chapter/32]]).", false],
		[39, "", "Pekerjaannya maju pesat. Tak lama kemudian prototipe itu hampir selesai dan hanya kurang satu bagian: [[goods/36]] yang menggandakan DNA partikel alga untuk memulai reaksi berantai yang menghasilkan daya. [[character/2]] meneruskan penjelasannya sambil mengakui bahwa ia sendiri tidak sepenuhnya memahaminya. Alat itu hanya dapat dibuat di [[station/16]] ([[chapter/38]]).", false],
		[42, "", "Ketika inkubator tiba di [[station/14]], ia sudah menyiapkan segalanya untuk memasangnya, dan senjata yang telah jadi diperkirakan segera tersedia di hanggar. Karena generator itu masih prototipe, sang pilot diperingatkan agar berhati-hati menggunakannya ([[chapter/41]]).", false],
		[44, "", "[[world/eclipse|Eclipse]] yang digerakkan oleh generatornya terbukti menentukan ketika kolonis menyerang [[station/14]].", false],
		[31, "Karakter", "Segala hal yang diketahui tentang dirinya berasal dari [[character/2]] dan [[character/5]]. Ia digambarkan sebagai peneliti yang berdedikasi.", false],
		[39, "", "Penjelasannya begitu teknis sehingga bahkan [[character/2]] kesulitan mengulanginya.", false],
	],
	"world/aquarians": [
		[10, "", "Para Aquarian adalah makhluk samudra dalam yang konon setengah manusia dan setengah ikan. Aquarian adalah nama yang diberikan kolonis kepada mereka, dan koloni menganggap mereka hama. Mereka terutama dikenal karena menyerang kapsul pengangkut yang membawa ekspor koloni ke orbit. Siapa mereka dan apa yang mereka inginkan adalah salah satu pertanyaan yang perlahan dijawab oleh cerita.", false],
		[10, "Sifat", "Awalnya hanya sedikit yang diketahui tentang para Aquarian. Mereka hidup di perairan terbuka dan bergerak seperti hewan laut, bukan seperti mesin, tetapi mereka bertempur dengan senjata mereka sendiri. Kolonis memperlakukan mereka sebagai hewan berbahaya dan tidak pernah bertanya mengapa mereka menyerang.", false],
		[11, "", "Setelah pertempuran pertama sang pilot dengan mereka, [[character/1]] bertanya-tanya apakah mereka jauh lebih cerdas daripada anggapan siapa pun. Sang pilot juga mulai bertanya mengapa mereka justru mengincar kapsul.", false],
		[19, "", "Pertemuan-pertemuan berikutnya mengisyaratkan bahwa mereka peduli pada satwa samudra. Mereka terlihat berenang di samping sekawanan [[species/10|cumi-cumi warna]] yang hendak ditangkap kolonis, seolah-olah menjaganya.", false],
		[45, "", "Mereka cerdas dan mampu berdiplomasi. Seorang utusan Aquarian datang ke [[station/14]] dan tampaknya memahami sebagian ucapan manusia.", false],
		[10, "Hubungan dengan koloni", "Peluncuran kapsul adalah penghubung koloni dengan ekonomi yang lebih luas, dan para Aquarian berulang kali menyerangnya. Setiap kapsul yang rusak atau hilang mencoreng nama stasiun di mata otoritas perdagangan, sehingga kolonis menyewa pilot bersenjata untuk mengusir para penyerang. Pertahanan kapsul juga merupakan kontrak kolonis yang rutin; lihat [[contract/11]].", false],
		[10, "", "Pada [[chapter/10]] sang pilot dikirim ke [[station/2]] untuk mempertahankan peluncuran kapsul, dengan perintah dari [[character/9]] untuk tidak menoleransi lebih dari segelintir kehilangan.", false],
		[11, "", "Tidak ada tanda bahwa koloni pernah mencoba berbicara dengan para Aquarian. Koloni hanya membayar agar mereka diusir atau dibunuh.", false],
		[13, "Hubungan dengan pemberontak", "[[faction/rebels]] berbicara tentang penghuni planet sekaligus sumber dayanya ketika mengecam eksploitasi koloni. Mungkin para Aquarian termasuk yang mereka maksud, tetapi untuk waktu yang lama tidak ada kontak di antara keduanya.", false],
		[19, "", "Pemberontak dan para Aquarian sama-sama berkepentingan melindungi hewan-hewan samudra. Ketika sang pilot melindungi cumi-cumi di dekat [[station/7]], [[character/1]] menduga para Aquarian bisa menjadi sekutu.", false],
		[44, "", "Titik baliknya datang saat serangan kolonis ke [[station/14]] pada [[chapter/43]]. Ketika dermaga stasiun terkena dan para pembela kalah jumlah, sekelompok Aquarian datang dan menyerang kolonis, membalikkan jalannya pertempuran. [[character/9]] dan pasukannya kocar-kacir.", false],
		[45, "", "Setelah pertempuran, utusan di Fiir menjelaskan bahwa para Aquarian bersedia melawan kekuasaan kolonis. [[character/2]] berharap begitu koloni dikalahkan, manusia dan Aquarian dapat hidup selaras dengan samudra. Dengan bantuan mereka, pemberontak merencanakan dua serangan terakhir.", false],
		[45, "", "Pada [[chapter/45]] sekelompok Aquarian naik dari kedalaman untuk bergabung dengan sang pilot dan skuadron [[character/12]] dalam serangan ke [[station/18]].", false],
		[47, "", "Kedua serangan berhasil, dan para komandan pemberontak menganggap para Aquarian berjasa besar atas kemenangan itu.", false],
		[48, "", "Setelah koloni lenyap, persekutuan antara pemberontak dan para Aquarian tetap berdiri di akhir cerita, bersama janji untuk membiarkan samudra pulih.", false],
		[45, "Pertanyaan terbuka", "Banyak hal tentang para Aquarian tidak pernah dijelaskan. Cerita tidak menyebutkan di mana mereka tinggal, berapa jumlah mereka, bagaimana mereka membuat atau menggunakan senjata, atau bagaimana mereka bisa memahami ucapan manusia. Cerita juga tidak menjelaskan mengapa mereka mengincar kapsul koloni, meski persekutuan mereka kemudian dengan pemberontak mengisyaratkan bahwa mereka melihat ekspor itu sebagai bagian dari penjarahan samudra mereka.", false],
		[10, "Dalam game", "Dalam pertempuran, para Aquarian tampil sebagai petarung mirip ikan yang menembakkan semburan energi. Mereka berbelok lebih lambat daripada kapal selam dan tidak pernah memakai lonjakan kecepatan. Aquarian yang dihancurkan mati seperti makhluk laut, dalam satu ledakan, dan tidak meninggalkan bangkai untuk diambil maupun apa pun untuk ditangkap.", false],
		[10, "", "Di pihak koloni, para Aquarian adalah musuh dalam misi pertahanan kapsul. Mereka langsung menuju kapsul, sehingga pembela harus cepat memburu mereka. Misi gagal jika terlalu banyak kapsul hilang. Menghancurkan Aquarian dihitung sebagai musuh yang dihancurkan, tetapi tidak untuk hadiah bajak laut.", false],
		[44, "", "Di bab-bab terakhir mereka bertempur di pihak sang pilot sebagai sekutu. Mereka tampil sebagai kontak kawan di radar dan menyerang kapal-kapal kolonis.", false],
	],
	"world/biotek": [
		[31, "", "Generator Biotek adalah sumber daya eksperimental yang dikembangkan oleh [[world/abel|Profesor Abel]]. Generator ini menjadi kunci rencana pemberontak untuk mengungguli persenjataan kolonis. Pemberontak bermaksud memakainya untuk menggerakkan senjata yang terlalu boros energi bagi kapal selam biasa, dan merebutnya kembali adalah langkah pertama dari tiga langkah rencana itu. Generator itu sendiri tidak pernah dijual atau dipasang sebagai peralatan; dalam permainan, sang pilot menangani komponen-komponen yang dibutuhkannya.", false],
		[31, "Penelitian dan pencurian", "Teknologi di balik generator ini telah diteliti bertahun-tahun tanpa ada yang berhasil menghasilkan prototipe yang berfungsi. Profesor Abel hampir menyelesaikannya ketika kolonis mencurinya. Kini mereka berusaha menyelesaikannya sendiri, dan pemberontak bertekad mencegahnya.", false],
		[31, "", "Tak lama sebelum membuka rencana itu, [[character/2]] mengatur perjalanan sekelompok ilmuwan andal ke [[station/14]]. Pada [[chapter/29]] sang pilot mengawal konvoi mereka dengan selamat melintasi wilayah perbatasan di dekat [[station/13]].", false],
		[31, "", "Di Fiir, Ayumi menjelaskan peran para ilmuwan itu: mereka adalah tim Abel. Bersama-sama mereka akan menjadikan generator itu jantung sebuah senjata baru.", false],
		[31, "Rencana tiga langkah", "Ayumi memaparkan rencana itu dalam tiga langkah. Pertama, pemberontak harus merebut kembali generator. Kedua, mereka membutuhkan senjata yang cukup kuat untuk sepadan dengan generator semacam itu. Ia belum menjelaskan langkah ketiga.", false],
		[31, "", "Menurut salah seorang informan Ayumi, generator curian itu sedang dipindahkan dalam konvoi kolonis biasa, menuju tempat bernama Maarth. Karena tidak ada yang tahu kapal mana yang membawanya, sang pilot, [[character/5]], dan [[character/4]] harus menghentikan seluruh konvoi di dekat [[station/2]] dan mengambil setiap kontainer.", false],
		[32, "", "Penyergapan berhasil dan setiap kontainer berhasil diambil, meski awak kolonis memprotes bahwa mereka hanya membawa makanan dan obat-obatan.", false],
		[33, "", "Kembali di Fiir, Abel membawa kargo rampasan itu ke laboratoriumnya untuk menyelesaikan prototipe. Sementara itu sang pilot berangkat mencari senjata untuk langkah kedua, [[world/eclipse|Eclipse]].", false],
		[39, "Cara kerja", "Generator ini mengambil dayanya dari materi hidup. Sebuah inkubator polimerase menggandakan DNA partikel alga, dan penggandaan ini memicu reaksi berantai yang melepaskan energi. Prototipe itu masih membutuhkan inkubator tersebut, [[goods/36]], sebelum dapat berjalan.", false],
		[39, "", "Hanya satu stasiun yang memiliki peralatan untuk membuatnya: [[station/16]], yang paling maju di samudra. Langkah ketiga sang pilot adalah pergi ke sana dan memproduksi inkubator itu.", false],
		[42, "", "Setelah inkubator diantar ke Fiir, Abel menyelesaikan pemasangan dan generator itu menggerakkan Eclipse di kapal sang pilot sendiri. Pemberontak mengingatkan bahwa generator itu masih prototipe.", false],
		[44, "", "Generator itu bertahan dalam pertempuran. Ketika kolonis menyerang Fiir, Eclipse yang digerakkan generator itu membantu membalikkan pertempuran. [[character/9]] tampak terguncang mendapati meriam itu di sebuah kapal selam.", false],
		[45, "", "Begitu [[station/188]] berada di tangan pemberontak, mereka mulai mempersenjatai sebanyak mungkin satuan dengan pasangan meriam dan sumber daya yang sama.", false],
		[39, "Dalam game", "Langkah ketiga mencakup tiga bab: perjalanan ke Wagoll pada [[chapter/39]], produksi inkubator di sana pada [[chapter/40]], dan pengantarannya ke Fiir pada [[chapter/41]]. Halaman barangnya mencantumkan rentang harga, tetapi tidak ada pasar yang pernah menjualnya, jadi satu-satunya cara mendapatkannya adalah membuatnya sendiri.", false],
		[39, "", "Inkubator dibuat di pabrik stasiun dengan level teknologi 11, yang dalam praktiknya berarti Wagoll. Resepnya membutuhkan masing-masing satu [[goods/19]], [[goods/34]], [[goods/28]], dan [[goods/24]]. Bahan-bahan itu sendiri berasal dari ikan mati dan alga, dari barang impor, dari kelima jenis alga, dan dari [[goods/35]] dengan [[species/5]] dan [[species/1]]. Mengumpulkannya merupakan rantai produksi kecil tersendiri.", false],
		[39, "", "Wagoll terletak di 29.850 m, lebih dalam daripada batas kebanyakan zirah, jadi sang pilot membutuhkan zirah berat seperti [[equipment/25]] untuk mencapainya dengan aman. Inkubator adalah barang cerita yang tidak dijual di pasar mana pun. Setelah dibuat, inkubator tetap di kapal sampai diantar ke Fiir.", false],
	],
	"world/colony": [
		[1, "", "Koloni adalah permukiman manusia di planet samudra ini: dua ratus stasiun laut dalam yang dijalankan oleh pemerintahan kolonial, beserta para pemukim, nelayan, dan pedagang yang tinggal dan bekerja di dalamnya. Di awal cerita setiap stasiun milik [[faction/colonists]], dan tujuan koloni sudah jelas: mengambil sumber daya samudra dan mengirimnya pergi. Artikel ini membahas bagaimana koloni diatur, bagaimana ekonominya berjalan, dan bagaimana keduanya berubah seiring cerita berlangsung.", false],
		[1, "Kolonisasi", "Para pemukim datang ke planet ini dari tempat lain dan membangun rumah di bawah permukaan, tempat stasiun-stasiun kini berdiri pada kedalaman antara sekitar 13.500 dan 32.250 m. Stasiun-stasiun itu sangat beragam. Masing-masing memiliki level teknologi dari 1 sampai 11, yang menentukan apa yang dapat diproduksi pabriknya dan berapa harga di tokonya, dan masing-masing memiliki perairan, satwa, dan tetangganya sendiri. Sebagian adalah pusat besar seperti [[station/0]]; yang lain pos kecil yang dikenal karena satu produk saja.", false],
		[1, "", "Pendatang baru diharapkan ikut menanggung beban. Sang pilot datang ke planet ini untuk menangkap ikan, dengan perahu kecil dan sedikit uang, dan segera mendapati bahwa pekerjaannya berat dan bayarannya buruk.", false],
		[10, "", "Koloni adalah ekonomi ekspor. Stasiun-stasiunnya memuat barang ke dalam kapsul pengangkut dan meluncurkannya ke orbit, tempat kapal kargo mengambilnya. Di atas para pejabat setempat berdiri otoritas perdagangan yang menilai stasiun dari seberapa andal kiriman ini tiba.", false],
		[12, "", "Rencana sang pilot sendiri sederhana: mengumpulkan cukup uang untuk tiket keluar dari planet ini.", false],
		[21, "", "Para pemberontak menggambarkan kolonisasi itu cepat dan kejam. Menurut mereka, kolonisasi menguras samudra lebih cepat daripada kemampuan alam untuk pulih, seperti yang sudah terjadi di planet-planet lain.", false],
		[1, "Pemerintahan dan stasiun", "Setiap stasiun adalah kota kecil dengan pejabat dan layanannya sendiri. Pilot yang berlabuh dapat mengunjungi hanggar untuk memasang peralatan, toko dan galangan untuk membeli peralatan dan lambung, serta peta. Sebagian besar stasiun juga memiliki papan kerja, dan sebagian memiliki pasar dan pabrik. Kapal patroli berputar di sekitar setiap stasiun di antara gerbang S.T.R.E.A.M.-nya dan bertempur untuk pihak mana pun yang menguasainya.", false],
		[2, "", "Pejabat kolonial mewakili koloni dalam urusan sehari-hari. Di [[station/0]], [[character/9]] membeli hasil tangkapan sang pilot dan membagikan nasihat yang tidak diminta siapa pun.", false],
		[7, "", "Keamanan stasiun menangani ancaman setempat, dan para pejabat menyerahkan pekerjaan semacam itu kepada pekerja lepas. Ketika nautilus berkerumun di sekitar [[station/1]], petugas keamanannya ingin hewan-hewan itu disingkirkan, dan Jack mengirim sang pilot untuk mengurusnya.", false],
		[9, "", "Para pejabat mengharapkan pendatang baru mendapatkan kepercayaan dulu sebelum menerima pekerjaan penting. Sang pilot harus menyelesaikan kontrak dari papan kerja terlebih dahulu sebelum koloni menawarkan sesuatu yang lebih besar. Para pejabat [[character/6]] tanpa nama yang ditemui sang pilot umumnya ketus dan membayar sesedikit mungkin.", false],
		[1, "Harga tetap", "Stasiun kolonis tidak berdagang. Tidak ada pasar dan tidak ada pabrik: ketika kapal berlabuh, stasiun begitu saja mengambil seluruh isi palkanya dan membayar harga terendah untuk setiap barang, harga paling rendah yang mungkin didapat barang itu. Pengiriman yang dipesan stasiun itu sendiri diselesaikan lebih dulu; selebihnya dibayar dengan tarif tetap. Bagi nelayan yang tak punya tempat lain untuk menjual, inilah seluruh ekonominya.", false],
		[1, "", "Hal ini membuat nelayan koloni tetap miskin. Harga terendah sering kurang dari separuh harga yang bisa didapat tangkapan yang sama di tempat lain, dan tidak ada pembeli lain.", false],
		[1, "Pasar dan harga", "Pasar bebas hanya ada di stasiun di luar kendali kolonial. Di sana harga barang bergantung pada jarak. Setiap barang memiliki stasiun asal, tempat barang itu dijual dengan harga terendahnya, dan pasar terbaik, tempat barang itu mencapai harga tertingginya. Di antara keduanya, harga naik seiring jarak di peta dari stasiun asal. Tiga barang impor, [[goods/33]], [[goods/34]], dan [[goods/35]], berlaku sebaliknya dan paling murah di pasar terbaiknya. Pasar membeli dan menjual dengan harga yang sama, jadi keuntungan datang dari mengangkut barang, bukan dari tawar-menawar. Lihat [[guide/trading]].", false],
		[1, "", "Level teknologi stasiun juga memengaruhi tokonya. Kapal dan peralatan lebih murah di stasiun maju: setiap level teknologi memotong satu persen dari harga lambung, dan peralatan juga sedikit lebih murah. Peralatan yang lebih langka makin sering muncul seiring cerita berlanjut.", false],
		[1, "Pabrik dan resep", "Pabrik mengolah hasil tangkapan mentah dan barang impor menjadi produk. Setiap produk memiliki resep tetap dan level teknologi minimum. [[goods/21]] membutuhkan [[species/4]] dan [[species/17|alga hijau]]; [[goods/22]] membutuhkan [[species/10]] dan [[goods/35]]; [[goods/29]] menggabungkan [[goods/20]] dan cat. Produk tingkat lanjut seperti [[goods/41]] membutuhkan produk lain sebagai bahan, sehingga rantai produksi dapat mengubah ikan murah menjadi barang berharga.", false],
		[1, "", "Pabrik dapat membuat apa saja hingga level teknologi stasiunnya. Sebagian besar produk hanya membutuhkan level 1, tetapi setidaknya satu barang hanya dapat dibuat di stasiun paling maju. Setiap halaman produk mencantumkan resepnya.", false],
		[1, "Papan kerja", "Pekerjaan kontrak adalah cara koloni mempekerjakan pekerja lepas. Papan kerja mencantumkan satu sampai delapan tawaran, masing-masing dengan sponsor, deposit yang dibayar saat menerima, dan upah yang dibayar saat berhasil. Upah naik seiring tingkat kesulitan dan jarak, dan tingkat kesulitan naik seiring peringkat sang pilot. Sebagian besar pekerjaan mengirim sang pilot ke stasiun lain, biasanya yang berada dalam rentang kedalaman kapal. Lihat [[guide/contracts]].", false],
		[1, "", "Apa yang ditawarkan papan kerja bergantung pada siapa yang menguasai stasiun. Kolonis mencari pengawal konvoi, perampok konvoi, pemburu, dan penjaga untuk peluncuran kapsul mereka. Stasiun bebas memasang pesanan pengiriman dan ikan serta membayar untuk melindungi kawanan hewan. Kedua pihak memasang buronan, penyelamatan, perburuan bajak laut, pengangkutan penumpang, dan pekerjaan pembersihan.", false],
		[9, "", "Papan kerja baru terbuka bagi sang pilot setelah pekerjaan-pekerjaan pertama untuk koloni, pada [[chapter/9]]. Peta stasiun tersedia sedikit lebih awal.", false],
		[1, "Hukum dan ketertiban", "Koloni menegakkan hukumnya sendiri di perairan. Stasiun membayar hadiah untuk setiap bajak laut yang dihancurkan dalam satu perjalanan, yang ditagih saat berlabuh. Jumlahnya adalah jumlah bajak laut dikuadratkan, dikali 100 kredit di stasiun kolonis dan 50 di stasiun bebas, sehingga perburuan panjang jauh lebih menguntungkan daripada beberapa perburuan singkat.", false],
		[12, "", "Tidak semua perairan milik koloni. Stasiun yang dikuasai perlawanan menganggap perairan di sekitarnya sebagai wilayah netral dan menghentikan kapal tak dikenal sebelum mengizinkannya berlabuh.", false],
		[35, "", "Sebagian perdagangan ilegal. Zat memabukkan dilarang setidaknya di sebagian stasiun, yang membuka peluang bagi pedagang pasar gelap seperti [[character/8]]. Otoritas keamanan menyewa pemburu hadiah seperti [[character/11]] untuk menyingkirkan orang-orang semacam itu.", false],
		[12, "Koloni dalam cerita", "Bagi sang pilot, koloni mula-mula adalah majikan, lalu lawan. Jack membayar harga tetap, pemusnahan nautilus di [[station/1]] dibayar buruk, dan pertahanan kapsul di [[station/2]] berakhir dengan Jack menolak memberi imbalan sama sekali. Muak, sang pilot mengikuti saran M.A.I. dan mencari perlawanan di [[station/3]].", false],
		[13, "", "Perlawanan menentang kendali koloni atas perdagangan dan eksploitasinya terhadap planet. Para anggotanya menginginkan perdagangan bebas, harga yang adil, dan laut yang ditangkap ikannya dengan hati-hati.", false],
		[18, "", "Pemberontak mula-mula merebut stasiun lewat diplomasi, dengan membujuk para pemimpinnya untuk berganti pihak. Setiap stasiun yang bergabung membuka pasar dan pabrik bagi sang pilot, sehingga ekonomi koloni berubah dari stasiun ke stasiun. Pembicaraan tentang revolusi pun menyebar.", false],
		[23, "", "Koloni tidak menyerahkan stasiunnya begitu saja. Jack, yang kini cukup berpengaruh, memasang ladang ranjau untuk memutus jalur pasokan pemberontak di dekat [[station/9]].", false],
		[25, "", "Lalu Jack menyergap pemimpin pemberontak dalam perjalanannya ke perundingan di [[station/10]].", false],
		[28, "", "Koloni juga membeli pengkhianat. Jack memasang hadiah buruan atas pemimpin pemberontak dan sang pilot, dan pilot pemberontak [[character/3]] menerima uangnya.", false],
		[31, "", "Koloni juga berlomba dengan pemberontak dalam hal teknologi. Orang-orangnya mencuri prototipe [[world/biotek]] milik [[world/abel|Profesor Abel]] dan berusaha menyelesaikannya sendiri.", false],
		[37, "", "Keserakahan melemahkan koloni dari dalam. Jack sendiri menjual sebuah meriam stasiun, [[world/eclipse|Eclipse]], kepada pedagang pasar gelap, yang lalu menjualnya kepada sang pilot.", false],
		[44, "", "Dalam unjuk kekuatan terakhir, kolonis menyerang jauh ke dalam wilayah pemberontak dan menggempur [[station/14]], tetapi terusir ketika para Aquarian ikut bertempur melawan mereka.", false],
		[45, "", "Setelah kekalahan itu, pemberontak bergerak menghabisi koloni dengan dua serangan besar, satu di setiap belahan.", false],
		[47, "", "Stasiun-stasiun di selatan jatuh, dan kolonis hanya tinggal memiliki [[station/0]] sebagai benteng besar terakhir mereka, yang dijaga sangat ketat.", false],
		[48, "", "Gosu jatuh dalam pertempuran terakhir. Jack melarikan diri dengan kapsul penyelamat, dan kekuasaan kolonial atas samudra berakhir, dengan setiap stasiun di tangan pemberontak.", false],
	],
	"world/eclipse": [
		[33, "", "Eclipse adalah meriam berat yang dibuat untuk pertahanan stasiun. Meriam ini begitu boros daya sehingga tidak pernah dimaksudkan untuk dipasang di kapal selam. Pada langkah kedua rencana pemberontak, sang pilot harus mendapatkan satu agar dapat dipasangkan dengan [[world/biotek]], yang mampu memasok energi cukup untuk menembakkannya dari sebuah kapal. Dalam daftar peralatan senjata ini adalah [[equipment/42]], dan meriam dalam peti yang diperdagangkan dalam cerita adalah [[goods/38]].", false],
		[33, "Asal-usul", "Eclipse termasuk golongan meriam stasiun yang dirancang untuk pertahanan tetap. Kebutuhan energinya menjadi alasan meriam ini tetap di stasiun: tidak ada pembangkit daya kapal selam yang sanggup membuatnya terus menembak. Sang pilot sudah mengenalnya sebagai senjata stasioner, itulah sebabnya rencana pemberontak untuk membawanya di kapal terdengar begitu mustahil.", false],
		[33, "", "Eclipse diproduksi di [[station/188]], yang berada di tangan kolonis ketika rencana itu dimulai. Stasiun terdekat yang cocok di bawah kendali pemberontak adalah [[station/15]]. Senjata ini sama sekali tidak dijual di pasar terbuka.", false],
		[33, "", "Pemberontak membutuhkannya karena mereka kalah jumlah. Alih-alih menandingi kolonis kapal demi kapal, mereka berharap senjata sekuat ini, yang dibawa sebuah kapal selam, dapat membalikkan keseimbangan.", false],
		[33, "Mendapatkan meriam", "[[character/2]] tidak punya rencana jelas untuk mendapatkannya. Ia memberi sang pilot 100.000 kredit untuk suap apa pun yang diperlukan dan mengirimnya ke Choral untuk melihat-lihat.", false],
		[35, "", "Di Choral sang pilot didekati pedagang pasar gelap [[character/8]], yang mengaku dapat memperoleh hampir apa saja asal harganya cocok. Ia akan mencoba mencarikan Eclipse, tetapi hanya jika sang pilot lebih dulu membunuh pemburu hadiah [[character/11]], yang disewa untuk menyingkirkannya.", false],
		[37, "", "Setelah Raoul tewas, Fenko menyediakan Eclipse dengan harga tinggi. Ia membelinya dari [[character/9]], yang tampaknya menjual meriam itu demi keuntungan tanpa tahu bahwa meriam itu akan jatuh ke tangan musuh-musuhnya.", false],
		[38, "", "Sang pilot membeli senjata itu dan membawanya kembali ke [[station/14]].", false],
		[39, "", "[[character/2]] memilih tidak bertanya bagaimana meriam itu didapat. Ia lega mendengar bahwa tidak ada orang tak bersalah yang tewas karenanya. Ketika sang pilot berkelakar bahwa rencana itu sama saja dengan menaklukkan seluruh planet, ia menolak gagasan itu dengan tegas.", false],
		[42, "Eclipse dalam tugas", "Setelah [[goods/36]] tiba di Fiir, [[world/abel|Profesor Abel]] menghubungkan meriam itu dengan prototipe generator, dan Eclipse siap dipasang di kapal selam sang pilot sendiri. Pemberontak mengingatkan bahwa sumber dayanya masih sekadar prototipe. Perintah untuk sang pilot adalah menguji senjata itu melawan geng bajak laut di dekat [[station/17]].", false],
		[43, "", "Uji coba berjalan cukup baik sampai para bajak laut memanggil bala bantuan. Segera sesudahnya meriam itu menghadapi ujian sesungguhnya, ketika kolonis menyerang Fiir; Jack hampir tidak percaya bahwa sang pilot membawa Eclipse.", false],
		[45, "", "Setelah mempertahankan Fiir, pemberontak merebut [[station/188]] dan mulai memasang Eclipse pada sebanyak mungkin kapal mereka sendiri, menjelang serangan-serangan terakhir.", false],
		[47, "", "Dalam pertempuran untuk [[station/18]] dan [[station/109]] meriam itu terbukti sangat menghancurkan, dan [[character/5]] memujinya habis-habisan.", false],
		[37, "Dalam game", "Pada bab-bab sekitar [[chapter/37]], Eclipse dalam peti dijual di Choral sebagai barang cerita. Harganya jauh lebih mahal daripada barang dagangan biasa mana pun dan tidak pernah tersedia di tempat lain.", false],
		[42, "", "Pada [[chapter/42]], [[equipment/42]] muncul di toko peralatan di [[station/14]] dan dapat dipasang tanpa biaya. Sebelum terpasang, papan kerja dan peta tertutup dan kapal tidak dapat berangkat. Hanya satu Eclipse yang dapat dipasang di sebuah kapal, dan senjata ini tidak dapat dijual sampai perang dimenangkan.", false],
		[42, "", "Sebagai senjata, Eclipse mengungguli semua yang dijual. Setiap tembakannya lebih keras daripada senjata lain mana pun dalam game, dengan jangkauan sekitar 240 m, dan menembak kira-kira sekali per detik. Senjata ini menembak bersama set senjata lainnya, sehingga dapat digabungkan dengan senjata lain yang terpasang.", false],
	],
	"world/history": [
		[1, "", "Kampanye ini mengikuti seorang pilot kapal selam muda yang datang ke sebuah planet samudra yang jauh untuk bekerja sebagai nelayan bagi [[world/colony|koloni]] manusia di sana. Para kolonis tinggal di stasiun-stasiun yang tersebar di kedalaman [[world/ocean|samudra]], dan koloni bergantung pada apa yang ditangkap, diperdagangkan, dan diangkut para pilotnya di antara stasiun-stasiun itu. Sang pilot memiliki kapal selam kecil dengan perlengkapan seadanya dan berbagi kapal itu dengan [[character/1]], komputer kapal yang tak pernah kehabisan nasihat maupun pendapat. Pemain memilih nama sang pilot; referensi ini cukup menyebut tokoh utamanya sang pilot.", false],
		[1, "", "Kisahnya terbagi dalam 48 bab. Cerita dimulai dengan rutinitas seorang nelayan pekerja: menangkap kehidupan laut, menjual hasil tangkapan, dan mengambil pekerjaan serabutan untuk menyambung hidup. Dari sana cerita meluas menjadi konflik tentang bagaimana laut planet ini dan makhluk-makhluknya harus diperlakukan, dan tentang siapa yang berhak memutuskannya. Sepanjang jalan sang pilot berurusan dengan pejabat stasiun, pedagang, [[faction/pirates]], dan penghuni kedalaman yang lebih aneh, dan pilihan seorang nelayan ternyata jauh lebih berarti daripada yang diduga siapa pun.", false],
		[1, "Babak I: Nelayan untuk koloni", "Kisah dibuka di tengah laut pada [[chapter/1]]. Sang pilot sudah menyesal pindah ke planet ini, tetapi [[character/1]] mengingatkan bahwa mereka di sini untuk menangkap ikan, dan tugas pertamanya sederhana: menangkap satu makhluk dengan harpun dan memasukkannya ke palka. Adegan-adegan pembuka sekaligus menjadi pengenalan cara menangkap kehidupan laut.", false],
		[2, "", "Setelah makhluk pertama tertangkap, [[character/1]] menunjukkan bagaimana autopilot dapat mengambil alih kemudi, dan pada [[chapter/2]] sang pilot mengatur haluan ke [[station/0]], stasiun kolonis tempat hasil tangkapan dijual.", false],
		[3, "", "Di [[station/0]] sang pilot berurusan dengan [[character/9]], pejabat koloni yang membeli hasil tangkapan. [[character/9]] membayar harga tetapnya yang biasa, mengejek palka kargo yang kecil, dan menceramahi si pendatang baru bahwa setiap orang harus berbuat bagi koloni. Ia juga menyindir bahwa pilot dengan senjata sungguhan bisa mendapat lebih banyak dengan memburu [[faction/pirates]]. Setelah ia pergi, [[character/1]] menyebutnya orang bodoh, tetapi menangkap isyaratnya dan mencatat bahwa [[equipment/0]] sedang dijual di hanggar. Pada [[chapter/3]] sang pilot membeli senjata itu dan memasangnya.", false],
		[4, "", "Untuk pertama kalinya bersenjata, sang pilot meninggalkan stasiun pada [[chapter/4]] untuk mencoba senjata baru itu, sementara [[character/1]] memperingatkan agar tidak menembaki ikan yang tidak berbahaya. Perairan sekitar ternyata bebas dari bajak laut, sehingga perburuan harus pindah ke tempat lain.", false],
		[5, "", "[[character/1]] menjelaskan cara kerja perjalanan jauh: kapal menempuh jarak yang sangat jauh melalui [[world/stream|jaringan S.T.R.E.A.M.]], selalu meninggalkan sebuah wilayah lewat titik keluarnya dan tiba di titik masuk wilayah berikutnya. Pada [[chapter/5]] seorang bajak laut muncul sendirian di dekat [[station/1]]. Setelah pelajaran singkat tentang beralih senjata, memakai tembak otomatis, dan membaca radar, sang pilot bertempur untuk pertama kalinya.", false],
		[6, "", "Bajak laut itu dihancurkan, dan [[character/1]] menunjukkan cara mengambil dengan harpun peti kargo yang ditinggalkan bangkai kapal sebelum peti itu tenggelam di luar jangkauan. Dengan senjata yang berfungsi dan sedikit barang rampasan, sang pilot kembali ke [[station/0]] pada [[chapter/6]].", false],
		[7, "", "Kembali di stasiun, [[character/9]] senang nasihatnya diikuti dan menawarkan apa yang ia sebut pekerjaan sungguhan. [[species/0|Nautilus]] memadati jalur konvoi di sekitar [[station/1]], dan keamanan stasiun ingin mereka disingkirkan. Sang pilot keberatan bahwa hewan-hewan itu hanya memakan tumbuhan yang menutupi lambung stasiun, dan bahwa palka kecil tidak mungkin mengangkut semuanya, tetapi [[character/9]] tidak peduli bagaimana mereka lenyap. Pada [[chapter/7]] sang pilot menyingkirkan mereka, dengan harpun atau senjata. Baik sang pilot maupun [[character/1]] tidak senang dengan pekerjaan ini, karena makhluk itu jumlahnya sedikit dan tidak berbahaya.", false],
		[8, "", "Pemusnahan itu membuat sang pilot terguncang. Sang pilot datang ke planet ini untuk menangkap ikan, bukan untuk membunuh hewan demi kenyamanan sebuah stasiun, dan [[character/1]] hanya bisa berharap bayarannya sepadan. Keduanya berlabuh di [[station/1]] untuk mengambil bayaran pada [[chapter/8]].", false],
		[9, "", "Pejabat kolonis di sana ([[character/6]]) memperlakukan sang pilot seperti pembasmi hama bayaran dan mengakui bahwa pekerjaan itu mungkin sia-sia, karena nautilus terus kembali. Bayarannya tetap 1.000 $, dengan pilihan terima atau tinggalkan. Pekerjaan berikutnya bergantung pada bukti kemampuan: tiga kontrak yang diselesaikan dari papan kerja stasiun. [[chapter/9]] mengirim sang pilot bekerja lepas, mengambil pengawalan, pengangkutan bangkai, dan pesanan ikan apa pun yang terjangkau.", false],
		[10, "", "Tiga pekerjaan itu memberi sang pilot pengakuan setengah hati dari sang pejabat dan sebuah tugas khusus. Makhluk aneh yang oleh kolonis disebut [[world/aquarians|Aquarian]], setengah manusia dan setengah ikan, telah menyerang kapsul pengangkut yang meluncurkan barang koloni ke orbit, tempat kapal kargo mengambilnya. Kapsul yang hilang atau rusak mencoreng nama stasiun di mata [[world/colony|otoritas perdagangan]], sehingga sang pilot dikirim ke [[station/2]] untuk mengusir para penyerang. [[character/9]] akan berada di sana untuk memimpin peluncuran berikutnya.", false],
		[10, "", "Pada [[chapter/10]] peluncuran sudah berlangsung ketika sang pilot tiba, dan para Aquarian memang sedang menyerang kapsul. [[character/9]] mengirim peringatan blak-blakan lewat radio: pekerjaan sang pilot dipertaruhkan jika lebih dari lima kapsul hilang.", false],
		[11, "", "Serangan berhasil dipukul mundur, tetapi meninggalkan pertanyaan. Sang pilot bertanya-tanya mengapa para Aquarian justru mengincar kapsul, dan [[character/1]] menduga mereka mungkin jauh lebih cerdas daripada anggapan kolonis. Makin gelisah dengan pekerjaan semacam ini, sang pilot berlabuh di [[station/2]] untuk melapor pada [[chapter/11]].", false],
		[12, "Babak II: Perlawanan", "Sambutan [[character/9]] menghabiskan kesabaran sang pilot terhadap koloni. Ia menyalahkan sang pilot atas kapsul yang rusak, membatalkan imbalan, dan pergi dengan marah sambil menggerutu bahwa dirinya ditakdirkan untuk hal yang lebih besar. [[character/1]] lalu mengungkapkan apa yang dirasakan keduanya: sang pilot bekerja seharian untuk koloni, berpenghasilan sangat kecil, dan tidak punya suara atas hasil tangkapan, yang begitu saja diambil dengan harga tetap. Sang pilot hanya ingin menabung cukup untuk tiket keluar dari planet ini, tetapi [[character/1]] punya gagasan lain.", false],
		[12, "", "Saat memindai gelombang radio, [[character/1]] menangkap tanda-tanda sebuah gerakan perlawanan yang memancarkan siaran dari [[station/3]]. Keputusannya diserahkan kepada sang pilot, yang tahu hal ini bisa berarti masalah serius tetapi tetap pergi. Mulai sekarang [[character/1]] menandai stasiun-stasiun gerakan itu dengan warna hijau di peta (lihat [[faction/rebels]]).", false],
		[12, "", "Pada [[chapter/12]] upaya mendekati [[station/3]] secara diam-diam langsung gagal. Penjaga stasiun menghentikan kapal dan mengancam akan menembak, dan sang pilot dengan terbata-bata menyebutkan nama, mengatakan bahwa perjalanan dimulai dari [[station/0]], dan meminta untuk bergabung. Setelah keheningan panjang, kapal diizinkan berlabuh.", false],
		[13, "", "Di dalam, [[character/4]] menginterogasi pendatang baru itu dengan serangkaian pertanyaan yang berbelit-belit. Sang pilot mengaku hampir tidak tahu apa-apa selain dukungan gerakan itu terhadap perdagangan bebas. Hal itu cocok dengan pengakuan [[character/4]] sendiri bahwa pemberontak baru beberapa hari lalu mulai menyandikan lalu lintas radio mereka. Karena kekurangan tenaga, [[character/4]] menerima sang pilot dengan masa percobaan. Gerakan itu berniat menyusup ke stasiun-stasiun kolonis, membujuk para pemimpinnya untuk berganti pihak, dan mengakhiri eksploitasi planet beserta penghuninya.", false],
		[13, "", "[[character/4]] tidak mau membagikan rencana kepada orang asing, jadi sang pilot harus lebih dulu membuktikan diri berguna. Pada [[chapter/13]] tugasnya adalah menjemput para simpatisan di [[station/4]] dan membawa mereka ke [[station/5]]. Dalam perjalanan sang pilot mengaku kepada [[character/1]] bahwa seluruh urusan ini masih misteri, tetapi setuju bahwa ini lebih baik daripada menerima perintah dari [[character/9]].", false],
		[14, "", "Kontak di [[station/4]] ternyata hanya satu penumpang, [[character/5]]. Ia hangat dan cekatan, jelas senang bertemu sang pilot, dan sang pilot pun jelas terpikat kepadanya. Ia tidak mau menjelaskan rencana gerakan itu, dengan alasan bahwa kerahasiaanlah yang membuat gerakan itu bertahan selama ini, lalu mengirim koordinat perjalanan. [[character/1]] mengamati keduanya dengan kesal yang terang-terangan, dan sang pilot menggodanya sebagai cemburu. Pada [[chapter/14]] sang pilot mengantar [[character/5]] ke [[station/5]] secepat dan seaman mungkin.", false],
		[15, "", "Di [[station/5]], [[character/5]] bersembunyi untuk membereskan beberapa urusan, tetapi lebih dulu ia menjelaskan mengapa pemberontak menjaga jarak dari kolonis. Mereka tidak menguras sumber daya laut. Mereka hanya mengambil apa yang dapat diberikan laut, mengolah hasil tangkapan menjadi barang, dan berhati-hati agar tidak menangkap ikan berlebihan, supaya keanekaragaman hayatinya tetap lestari. Untuk menunjukkan cara kerjanya, ia meminta sang pilot memproduksi lima ton barang di pabrik sebuah stasiun perlawanan ([[chapter/15]]). Ia menyarankan [[station/90]], tempat cumi-cumi dapat ditangkap dan [[goods/35]] dapat dibeli untuk membuat [[goods/22]].", false],
		[16, "", "Setelah sang pilot mempelajari cara kedua untuk mencari uang ini, [[character/5]] menghubungi dengan tugas baru. Gerakan itu membutuhkan laporan terbaru dari setiap stasiun untuk menemukan titik lemah dan menarik penduduk ke pihaknya, karena bujukan akan sama pentingnya dengan daya tembak. Ketika sang pilot bertanya apakah ini berarti revolusi, ia menolak berkata lebih banyak. Pada [[chapter/16]] sang pilot berkeliling ke stasiun-stasiun yang belum pernah dikunjungi, sambil mengumpulkan uang untuk meningkatkan kapal.", false],
		[17, "", "Sebuah pesan panjang dari [[character/4]], yang diringkas [[character/1]] menjadi satu baris, memanggil sang pilot kembali ke [[station/3]] pada [[chapter/17]]. Sementara itu wilayah pemberontak terus bertambah: [[station/6]], [[station/12]], [[station/106]], dan [[station/180]] telah beralih ke pihak gerakan itu.", false],
		[18, "Babak III: Sang pemimpin", "[[character/4]] menjelaskan bahwa diplomasi diam-diam telah memperluas wilayah pemberontak, sehingga sang pilot kini dapat berdagang di jauh lebih banyak stasiun. Saluran berita sudah membicarakan revolusi. Banyak pengambil keputusan telah bergabung tanpa satu tembakan pun, meski [[character/4]] memperkirakan pertumpahan darah cepat atau lambat akan terjadi. Langkah-langkah berikutnya diatur oleh pemimpin gerakan dari salah satu stasiun yang baru direbut, dan sang pilot harus menemukan pemimpin itu, atau tepatnya, ditemukan olehnya. [[character/4]] menandai stasiun-stasiun yang mungkin dan memperingatkan bahwa sebagian mungkin tak terjangkau tanpa zirah atau perisai yang lebih baik.", false],
		[18, "", "[[character/1]] tidak terkesan dengan cara gerakan itu diorganisasi, dan [[chapter/18]] menjadi pencarian dengan sedikit petunjuk selain keberuntungan.", false],
		[19, "", "Jejaknya berakhir di [[station/6]], tempat sang pilot bertemu [[character/2]], seorang perempuan yang lebih tua yang memimpin gerakan itu dan mulai sekarang akan memberi perintah. Sang pilot mengira pemimpinnya laki-laki, kekeliruan yang ditepisnya begitu saja. Tugas pertamanya adalah pengawalan. Sekawanan [[species/10]] harus dipandu ke perairan aman di dekat [[station/7]] sebelum kolonis dapat menangkap atau membunuh hewan-hewan itu, dan pertempuran kemungkinan besar terjadi. [[character/1]] menggerutu karena tidak ada yang menyebut soal bayaran, sementara sang pilot menduga [[character/2]] ingin tahu dulu apakah si pendatang baru dapat dipercaya.", false],
		[19, "", "Pada [[chapter/19]] sang pilot mendapati para Aquarian berenang di samping kawanan itu, dan [[character/1]] bertanya-tanya apakah mereka menjaga makhluk-makhluk laut. Tak lama kemudian kapal-kapal kolonis mendekat, dan sang pilot harus mencegat mereka tanpa mengenai hewan-hewan itu.", false],
		[20, "", "Kawanan itu selamat. [[character/2]] membayar imbalan sederhana sebesar 2.000 $ dan segera memanggil sang pilot kembali, sementara [[character/1]] mengeluh bahwa menjual hewan-hewan itu akan jauh lebih menguntungkan. Pada [[chapter/20]] sang pilot kembali ke [[station/6]].", false],
		[21, "", "Kali ini sang pilot bertanya terus terang apa sebenarnya tujuan gerakan itu. [[character/2]] menggambarkan sekelompok orang yang bersatu melawan kehancuran planet dan penghuninya. Kolonisasi berlangsung begitu cepat, dan alam dieksploitasi begitu kejam, sehingga tumbuhan dan hewan laut tidak lama lagi tak mampu pulih. Jika tidak ada yang berubah, planet ini akan berakhir terkuras seperti banyak dunia sebelumnya. Gerakan itu bermaksud mencegahnya dengan menarik para pengambil keputusan penting ke pihaknya, dan sang pilot berjanji untuk membantu.", false],
		[21, "", "Kekhawatiran [[character/2]] yang paling mendesak adalah [[faction/pirates]], yang memanfaatkan konflik untuk memangsa sasaran empuk. Selama ini gerakan itu hanya membela diri; kini gerakan itu akan langsung menyerang sebuah formasi bajak laut. Untuk menenangkan sang pilot yang gugup, ia menambahkan seorang pengawal, [[character/3]], salah satu pilot terbaiknya, meski [[character/1]] curiga bahwa sebenarnya sang pilotlah yang mengawal. Pada [[chapter/21]] keduanya bertemu di dekat [[station/8]]. [[character/3]] menyambut si pendatang baru yang terlambat dengan tidak sabar dan merendahkan, lalu menyuruh sang pilot tetap di belakangnya dan belajar.", false],
		[22, "", "Geng itu ditumpas habis. [[character/3]] memuji dengan setengah hati, tetapi ketika [[character/2]] memberi masing-masing 5.000 $, ia marah karena uangnya dibagi rata dan mengatakan kepada sang pilot bahwa si pendatang baru tidak berbuat apa-apa. Sang pilot dan [[character/1]] pergi sebelum amarahnya makin menjadi. Pada [[chapter/22]] mereka pergi ke [[station/9]] untuk menemui [[character/2]], yang perundingannya di sana berhasil: stasiun itu telah bergabung dengan gerakan bersama [[station/5]], [[station/37]], dan beberapa stasiun lain.", false],
		[23, "", "Sebelum [[character/2]] melanjutkan perjalanan, jalur pasokan ke [[station/37]] harus diamankan. [[character/9]] telah memasang ladang ranjau tepat di luar stasiun untuk memutusnya. [[character/2]] mengenalnya: dulu orang tak penting, ia naik dengan cepat berkat teman-teman di posisi strategis. Bersemangat menggagalkan rencananya, sang pilot berangkat untuk membersihkan ladang ranjau pada [[chapter/23]]. [[character/2]] memperingatkan bahwa bajak laut akan berkeliaran di sekitar, dan bahwa setiap ranjau baru dapat dihancurkan setelah sang pilot cukup dekat untuk memicu sensor geraknya.", false],
		[24, "", "Ladang ranjau telah dibersihkan, jalur itu kembali aman, dan [[character/2]] membayar 4.000 $ atas pekerjaan itu. Kembali di [[station/9]] pada [[chapter/24]], sang pilot mendapati wilayah pemberontak jauh lebih luas. Gelombang stasiun di seluruh samudra kini berdiri bersama gerakan itu, di antaranya [[station/14]], [[station/22]], dan [[station/25]].", false],
		[25, "", "Di stasiun itu sang pilot bertemu kembali dengan [[character/5]], dan percakapan mereka hangat tetapi canggung, sementara [[character/1]] memberi arahan yang tidak diminta. [[character/2]] memotong pertemuan itu. Serangkaian perundingan di [[station/10]] dapat menarik lebih banyak stasiun, dan sang pilot serta [[character/5]] harus mengawal dirinya dan [[character/3]] ke sana. Sang pilot enggan pergi bertugas bersama [[character/3]], tetapi [[character/2]] menjamin kemampuannya dan tidak memperkirakan ancaman yang lebih buruk daripada bajak laut.", false],
		[25, "", "Pada [[chapter/25]] rombongan tiba di [[station/10]] dan langsung merasa ada yang tidak beres. [[character/9]] sudah menunggu dengan pasukan kolonis dan memerintahkan mereka menyerang, dan [[character/2]] tidak mengerti bagaimana ia tahu mereka akan datang.", false],
		[26, "Babak IV: Pengkhianatan", "Selama pertempuran [[character/3]] menahan tembakannya, mengaku senjatanya rusak, lalu kabur sambil meminta maaf. Anggota rombongan lainnya selamat. [[character/2]] menduga ada sabotase, sementara [[character/5]] terang-terangan menuduh [[character/3]] berkhianat; [[character/2]] membelanya, dengan mengatakan bahwa ia selalu setia kepadanya. Sang pilot mengakui bahwa kejadian itu tampak mencurigakan, tetapi mendesak semua orang untuk pergi sebelum [[character/9]] mendatangkan lebih banyak kapal.", false],
		[26, "", "Rombongan itu berpencar. [[character/2]] bersembunyi, dan [[character/5]] menjalankan urusan gerakan di [[station/9]]. Sang pilot diminta menjadi petarung yang jauh lebih tangguh sebelum mereka bertemu lagi, karena kini jelas bahwa diplomasi saja mungkin tidak cukup untuk memenangkan perjuangan. Pada [[chapter/26]] sang pilot memburu bajak laut dan musuh lain untuk menambah jumlah kapal yang dihancurkan.", false],
		[27, "", "Setelah sang pilot menjadi lebih berbahaya, [[character/3]] menghubungi tanpa diduga. Ia menanyakan kabar [[character/2]] dan [[character/5]], mengaku telah mengumpulkan informasi penting selama ia pergi, dan meminta bertemu di dekat [[station/11]]. [[character/1]] yakin itu jebakan, dan sang pilot setuju, lalu tetap pergi ([[chapter/27]]).", false],
		[28, "", "Jebakan itu nyata. [[character/3]] menawan [[character/2]] dan menuntut sang pilot menyerah, sementara [[character/2]] mendesak sang pilot untuk tidak memedulikannya. Atas saran [[character/1]], sang pilot terus mengajak [[character/3]] bicara sementara komputer memindai kapalnya. [[character/3]] terang-terangan mengaku berganti pihak demi uang: [[character/2]] membayar buruk, dan [[character/9]] menawarkan hadiah buruan besar untuk dirinya dan sang pilot. Ketika sang pilot mengingatkannya pada cita-cita gerakan, [[character/3]] menjawab bahwa cita-cita tidak bisa mengisi perut.", false],
		[28, "", "Pemindaian menunjukkan kapal berkursi tunggal, jadi [[character/2]] pasti dikurung di ruang kargonya yang berzirah tebal. Sang pilot melepaskan tembakan. [[character/3]] ternyata cepat dan berbahaya, tetapi kapalnya hancur, dan sang pilot mengambil kontainer kargo dengan harpun sebelum tenggelam terlalu dalam. Pada [[chapter/28]] sang pilot membawanya ke [[station/12]], stasiun aman terdekat, berharap tebakan [[character/1]] tentang isinya benar.", false],
		[29, "", "Tebakan [[character/1]] benar. [[character/2]] keluar dalam keadaan terguncang tetapi tidak terluka, dan berterima kasih kepada sang pilot karena telah menyelamatkan nyawanya. Tidak ada waktu untuk beristirahat: sebelum diculik, ia sedang mengatur pengangkutan sekelompok ilmuwan andal ke [[station/14]], dan [[character/3]] mungkin sudah membocorkan detailnya. Ia belum mau menjelaskan mengapa para ilmuwan itu penting, dan mengirim sang pilot untuk mengawal konvoi mereka dengan selamat melintasi zona perbatasan ([[chapter/29]]). Di dekat [[station/13]] sang pilot mendapati konvoi itu sudah diserang habis-habisan dan meminta bantuan.", false],
		[30, "", "Konvoi berhasil lolos, dan para awaknya menganggap sang pilot sebagai penyelamat mereka. [[character/2]] membayar 5.000 $ dan mengatur pertemuan di [[station/14]], tempat ia berjanji menjelaskan langkah berikutnya ([[chapter/30]]).", false],
		[31, "Babak V: Tiga langkah", "Di [[station/14]], [[character/5]], [[character/4]], dan [[character/2]] sudah menunggu, dan [[character/2]] akhirnya membuka rencananya kepada sang pilot. Bentrokan dengan kolonis makin sering dan jumlah pemberontak masih kalah, jadi ia telah membawa [[world/abel|Profesor Abel]] dan timnya ke stasiun ini untuk membangun senjata yang dapat membalikkan keseimbangan. Proyek itu terdiri atas tiga langkah. Yang pertama adalah sumber daya, [[world/biotek|generator Biotek]], teknologi yang telah diteliti bertahun-tahun tanpa pernah menghasilkan prototipe yang berfungsi. Abel hampir menyelesaikannya ketika kolonis mencurinya, dan kini mereka berusaha menyelesaikannya sendiri.", false],
		[31, "", "[[character/2]] pergi menemui Abel, dan [[character/5]] melanjutkan pengarahan. Seorang informan melaporkan bahwa generator itu sedang dikirim ke arah Maarth dengan kapal kargo biasa agar tidak menarik perhatian, sehingga pemberontak punya kesempatan menyerang di dekat [[station/2]]. Tidak ada yang tahu kapal mana yang membawanya, jadi seluruh konvoi harus dihentikan dan setiap kontainer diambil, suka atau tidak. Pada [[chapter/31]] sang pilot, [[character/5]], dan [[character/4]] mencegat konvoi itu. Para awaknya memohon bahwa mereka hanya membawa makanan dan obat-obatan, dan [[character/4]] menjawab bahwa pemberontak justru sangat membutuhkan keduanya.", false],
		[32, "", "Setiap kontainer berhasil diambil, dan pada [[chapter/32]] tim membawa hasil rampasan itu kembali ke [[station/14]].", false],
		[33, "", "Abel membawa kargo itu ke laboratoriumnya untuk mengerjakan prototipe, dan [[character/2]] membagikan tugas baru. [[character/5]] harus berpatroli di luar stasiun untuk berjaga terhadap serangan mendadak, [[character/4]] dibutuhkan di hanggar, dan sang pilot mendapat langkah kedua. Generator itu membutuhkan senjata yang layak untuk dayanya, dan [[character/2]] telah memilih [[equipment/42]], [[world/eclipse|meriam pertahanan stasiun]] yang kebutuhan dayanya begitu besar sehingga sampai kini belum pernah dipasang di kapal mana pun.", false],
		[33, "", "Stasiun terdekat yang membuat meriam semacam itu, [[station/188]], berada di tangan kolonis, jadi [[character/2]] mengirim sang pilot ke stasiun pemberontak [[station/15]] sebagai gantinya. Senjata itu tidak dijual di mana pun, dan di situlah rencananya berakhir. Ia hanya menyerahkan 100.000 $ untuk suap apa pun yang mungkin diperlukan. Sang pilot menyebutnya rencana paling samar yang pernah didengar dan menerimanya dengan senang hati, dan [[chapter/33]] membawa sang pilot ke stasiun itu untuk melihat-lihat.", false],
		[34, "", "Tanpa kenalan dan tanpa rencana nyata, sang pilot mulai dengan melihat-lihat barang pedagang setempat. Pada [[chapter/34]] jejaknya mengarah ke muatan [[goods/37]], obat terlarang di stasiun itu.", false],
		[35, "", "Transaksi itu menarik perhatian [[character/8]], pedagang pasar gelap yang menyebut dirinya sebagai orang ketiga dan mengaku dapat memasok hampir apa saja. Ketika diminta [[equipment/42]], ia tercengang dan bertanya-tanya apakah sang pilot hendak memulai perang. Meski begitu, ia bersedia mencoba dengan imbalan sebuah bantuan: kematian [[character/11]], pemburu hadiah yang disewa otoritas keamanan untuk menyingkirkan [[character/8]]. Pada [[chapter/35]] sang pilot menemukan [[character/11]] berpatroli di dekat stasiun dengan pengawalnya sendiri. Ia menepis sang pilot sebagai sekadar nelayan.", false],
		[36, "", "Ketika pertempuran berbalik melawannya, [[character/11]] mencoba berkelit dengan kata-kata, tetapi kapalnya hancur. Sang pilot kembali ke [[station/15]] pada [[chapter/36]], berharap pedagang itu menepati janjinya.", false],
		[37, "", "[[character/8]] menepati janji. Ia telah menemukan sebuah [[equipment/42]] dan akan menjualnya, dengan harga yang membengkak karena suap yang katanya telah ia bayar. Ketika ditanya bagaimana ia mendapatkan meriam semacam itu, ia menyebut penjualnya: [[character/9]]. [[character/1]] menikmati ironi bahwa keserakahan [[character/9]] justru mempersenjatai musuh-musuh terburuknya. Pada [[chapter/37]] sang pilot membeli senjata itu dan membawanya ke kapal.", false],
		[38, "", "Dengan meriam di palka, langkah kedua selesai, dan pada [[chapter/38]] sang pilot kembali ke [[station/14]] untuk melihat perkembangan prototipe.", false],
		[39, "", "[[character/2]] lebih memilih tidak tahu bagaimana senjata itu didapat dan hanya berharap tidak ada darah yang tertumpah; jawaban hati-hati sang pilot adalah bahwa tidak ada orang tak bersalah yang tewas. Prototipe itu hampir selesai, tetapi masih kurang satu alat kecil yang tidak dapat dibuat di stasiun itu: [[goods/36]], yang menggandakan materi genetik partikel alga sehingga memicu reaksi yang menggerakkan generator. [[character/2]] mengakui bahwa ia hanya mengulang penjelasan Abel. Ketika sang pilot dengan sinis menyebut alat itu langkah ketiga menuju penaklukan seluruh planet, ia menolak gagasan itu dengan tegas.", false],
		[39, "", "Hanya [[station/16]] yang memiliki peralatan untuk membuat inkubator itu, jadi [[chapter/39]] mengirim sang pilot ke sana untuk langkah ketiga. [[character/1]] mengeluh bahwa sang pilot tampaknya menjalankan seluruh pemberontakan seorang diri.", false],
		[40, "", "Di stasiun itu menjadi jelas bahwa membuat inkubator sama sekali tidak sederhana, dan [[chapter/40]] berubah menjadi pekerjaan produksi yang berat.", false],
		[41, "", "Inkubator itu selesai, yang membuat [[character/1]] terang-terangan terkejut. Masih belum yakin bahwa semua ini hal yang benar, sang pilot membawanya ke [[station/14]] pada [[chapter/41]].", false],
		[42, "", "[[character/5]] menyambut sang pilot dan inkubator itu dengan gembira, sementara [[character/1]] mengumumkan bahwa ia lebih baik mematikan diri daripada ikut mendengarkan. Abel sudah menyiapkan segalanya, dan [[equipment/42]] akan segera tersedia di hanggar. [[character/2]] ingin senjata itu langsung diuji melawan bajak laut, dan [[character/5]] meneruskan koordinatnya dengan peringatan bahwa generator itu masih sekadar prototipe. [[character/1]], yang konon sedang dalam mode siaga, menegaskan bahwa ia mendengar setiap kata.", false],
		[42, "", "Pada [[chapter/42]] sang pilot memasang meriam itu dan menyerang sarang bajak laut di dekat [[station/17]]. Para bajak laut segera sadar apa yang mereka hadapi dan memanggil bala bantuan.", false],
		[43, "Babak VI: Perang untuk samudra", "Uji coba itu terpotong oleh panggilan darurat dari [[station/14]], yang disiarkan terbuka di saluran tanpa sandi. Sang pilot bergegas kembali pada [[chapter/43]] dan mendapati stasiun itu diserang mendadak oleh kolonis. Banyak dermaga terkena, terlalu sedikit kapal pemberontak yang dapat diluncurkan, dan [[character/2]] mengira akhir telah tiba. [[character/9]] memimpin serangan dan mengejek sang pilot yang kini menangkap ikan untuk pemberontak, sampai ia tahu bahwa [[equipment/42]] siap menembak.", false],
		[44, "", "Di tengah pertempuran para [[world/aquarians|Aquarian]] datang dan menerjang kolonis, bertempur di pihak pemberontak. Serangan itu runtuh, dan [[character/9]] kabur begitu melihat bahwa pertempuran sudah kalah. [[character/2]] menyebut penyelamatan itu sebuah keajaiban dan meminta sang pilot berlabuh, sambil menjanjikan seorang tamu istimewa ([[chapter/44]]).", false],
		[45, "", "[[character/2]] mengakui bahwa serangan itu membuat pemberontak tidak siap, karena tak seorang pun menyangka kolonis akan menyerang sedalam itu di perairan pemberontak, dan bahwa pertahanan itu bukan hanya jasa mereka. Tamu itu adalah utusan Aquarian yang sedikit memahami bahasa manusia. Melalui dia, para Aquarian menawarkan bantuan untuk mengakhiri kekuasaan kolonis. Setelah setiap stasiun direbut dan armada kolonis dikalahkan, semua pihak akan hidup selaras dengan alam.", false],
		[45, "", "Dengan bantuan Aquarian, [[character/2]] merencanakan dua serangan besar untuk merebut stasiun-stasiun yang tersisa di belahan utara dan selatan. [[station/188]] telah jatuh, dan pemberontak memasang [[equipment/42]] pada sebanyak mungkin kapal. Untuk memanfaatkan unsur kejutan selagi masih ada, ia menunjuk sang pilot memimpin serangan ke [[station/18]] dan mengirim [[character/5]] melawan [[station/109]]. Ketika sang pilot mengkhawatirkan [[character/5]], [[character/2]] menggoda perasaan sang pilot yang begitu kentara dan mengingatkan bahwa [[character/5]] sendiri adalah pilot yang cakap.", false],
		[45, "", "Pada [[chapter/45]] sang pilot tiba dan mendapati [[character/12]], pemimpin skuadron Atmos, menunggu perintah menyerang, sementara sekelompok Aquarian naik dari kedalaman. Setiap kapal kolonis harus dihancurkan, termasuk kapal barang.", false],
		[46, "", "Para pembela ditumpas habis. Sang pilot mengirim separuh skuadron [[character/12]] untuk berpatroli di sekitar stasiun dan berlabuh bersama sisanya pada [[chapter/46]]. Pada saat yang sama gelombang besar stasiun berganti pihak, dari [[station/1]] dan [[station/2]] hingga [[station/11]], [[station/18]], dan [[station/109]].", false],
		[47, "", "[[character/5]] menghubungi untuk melaporkan bahwa serangannya juga berhasil dan bahwa [[equipment/42]] terbukti sangat menghancurkan; sang pilot memberi pujian yang sama besarnya kepada para Aquarian. Seluruh stasiun di selatan kini dikuasai pemberontak. [[character/2]] telah mengabarkan apa yang mungkin menjadi tugas terakhir: [[station/0]], benteng besar terakhir kolonis sekaligus stasiun tempat kisah sang pilot bermula. Stasiun itu dijaga sangat ketat, dan [[character/2]] sudah dalam perjalanan untuk memimpin serangan sendiri. [[character/5]] menyusul, tertunda oleh bajak laut di jalurnya, dan pada [[chapter/47]] sang pilot bergabung dengan mereka untuk pertempuran terakhir.", false],
		[47, "", "[[character/9]] memimpin pertahanan dan menyombongkan diri bahwa ia akan senang menghancurkan kapal sang pilot, kata-kata yang dikenali sang pilot sebagai gema dari ucapan terakhir [[character/3]]. Begitu tahu siapa yang membunuh [[character/3]], [[character/9]] mencoba mengguncang sang pilot dengan mengaku sebagai ayah sang pilot, dan [[character/3]] sebagai saudaranya. Sang pilot, yang tidak punya saudara laki-laki dan masih ingat betul wajah sang ayah, langsung menepis kebohongan itu.", false],
		[48, "", "Armada kolonis berguguran satu per satu hingga hanya [[character/9]] yang tersisa. Ia cepat dan sulit dikenai, tetapi atas saran [[character/1]] sang pilot menghindari serangannya dan menyerang dari belakang. [[character/9]] melarikan diri dengan kapsul penyelamat dan, yang membuat [[character/5]] tak percaya, tampaknya membawa serta seluruh stasiun. Sebelum pergi ia mencemooh bahwa tidak ada yang berharga di kedalaman dan bahwa ia memang tidak pernah peduli pada ikan.", false],
		[48, "", "Dengan perginya [[character/9]], perang pun berakhir, dan pada [[chapter/48]] [[station/0]] serta benteng-benteng terakhir bergabung dengan gerakan itu. Sang pilot menegaskan bahwa kemenangan ini milik semua orang. [[character/1]] menuntut bagiannya atas pujian itu dan dijanjikan peningkatan memori begitu sang pilot kembali ke daratan, yang dengan kesal ia nyatakan tidak ia butuhkan. [[character/2]] berterima kasih kepada mereka semua dan mengakui bahwa luka planet ini butuh waktu lama untuk pulih, tetapi ia yakin mereka juga sanggup menanganinya. [[character/5]] mengajak sang pilot merayakannya dengan [[goods/21]], dan sang pilot menerima dengan senang hati.", false],
		[48, "Tema", "Konflik utamanya adalah tentang bagaimana laut seharusnya dimanfaatkan. Koloni memperlakukannya sebagai sumber daya untuk dipanen dan dikirim ke orbit: koloni membeli hasil tangkapan dengan harga tetap dan memusnahkan satwa liar yang menghalangi. Gerakan itu memperjuangkan agar hanya diambil apa yang dapat diberikan laut, keanekaragaman hayatinya dilindungi, dan perdagangan berlangsung bebas. Pekerjaan-pekerjaan awal sang pilot, pemusnahan nautilus dan pertahanan kapsul, memperlihatkan cara kerja kolonial dari dalam. Rasa tidak nyaman sang pilot yang makin besar terhadap pekerjaan itulah yang membuat peralihannya ke perlawanan terasa meyakinkan.", false],
		[48, "", "Para Aquarian menempuh alur yang sama. Mula-mula mereka tampil sebagai hama yang menyerang kapsul koloni, dan sang pilot dibayar untuk mengusir mereka. Kemudian mereka terlihat menjaga makhluk-makhluk laut, dan di [[station/14]] mereka membalikkan pertempuran yang sudah kalah. Jika dilihat kembali, serangan-serangan awal mereka tampak seperti perlawanan mereka sendiri terhadap penjarahan samudra, meski game ini sebagian besar membiarkan motif mereka untuk ditebak.", false],
		[48, "", "Uang dan kesetiaan mewarnai seluruh cerita. [[character/3]] mengkhianati gerakan demi hadiah buruan, dan [[character/9]] menjual senjata yang kelak mematahkan serangannya sendiri ke [[station/14]]. Sang pilot awalnya hanya menginginkan uang untuk tiket pulang dan berakhir sebagai salah satu komandan gerakan, sementara keluhan [[character/1]] tentang bayaran yang kecil menjadi lelucon berulang alih-alih motif.", false],
		[48, "", "Gerakan itu merebut sebagian besar wilayah awalnya lewat bujukan, dan penyergapan di [[station/10]] menandai titik ketika bujukan tidak lagi cukup. Kampanye lalu menutup lingkarannya di [[station/0]], stasiun tempat [[character/9]] dulu membayar hasil tangkapan sang pilot dengan harga tetap. Setelah bab terakhir, sang pilot tetap bebas menangkap ikan, berdagang, dan mengambil kontrak di samudra yang kini berpihak pada pemberontak.", false],
	],
	"world/ocean": [
		[1, "", "Samudra adalah latar DEEP: sebuah planet yang dunia layak huninya terletak jauh di bawah gelombang. Para pemukimnya tinggal di stasiun bertekanan ribuan meter di bawah permukaan, dan kapal selam adalah satu-satunya cara untuk berpindah di antara stasiun-stasiun itu. Semua yang dimakan, dijual, dan dibuat koloni berasal dari air, mulai dari ikan dan alga hingga barang yang dibuat darinya. Artikel ini menggambarkan samudra sebagai sebuah tempat: kedalamannya, cahayanya, satwanya, dan cara kehidupan itu bereaksi terhadap orang-orang yang memburunya.", false],
		[1, "", "Sang pilot tiba di sini sebagai pendatang baru dengan kapal selam penangkap ikan yang kecil dan komputer kapal [[character/1]], dan tak lama kemudian berharap tidak pernah datang. Tentang orang-orang yang menjalankan stasiun, lihat [[world/colony]]; tentang perjalanan di antara stasiun, lihat [[world/stream]].", false],
		[1, "Kedalaman dan tekanan", "Kedalaman adalah ciri utama samudra ini. Tidak ada dasar laut yang menghentikan penyelaman: kapal selam dapat terus tenggelam sampai air meremukkannya. Yang menjaga kapal tetap utuh adalah rentang kedalaman aman yang ditentukan oleh peralatannya. Perisai menentukan seberapa tinggi kapal boleh naik, dan zirah seberapa dalam kapal boleh turun. Lambung tanpa keduanya hanya aman di lapisan air yang sempit, sekitar 22.000 sampai 23.000 m.", false],
		[1, "", "Di luar rentangnya, kapal terimpit oleh tekanan. Setelah beberapa detik masa tenggang, air mulai mengikis perlindungannya, satu lapis demi satu lapis lalu lambungnya sendiri, dan kerusakannya makin besar makin jauh kapal menyimpang melewati 15.000 m ke atas atau 30.000 m ke bawah. Penyimpangan singkat masih bisa dilalui; yang lama tidak. Angka untuk setiap peralatan tercantum di halamannya masing-masing, dan [[guide/depth]] menjelaskan aturannya secara lengkap.", false],
		[1, "Letak stasiun", "Dua ratus stasiun di [[chart]] tertambat pada kedalaman tetap, hampir semuanya antara 15.000 dan 30.000 m. Lebih dari separuhnya, 109 stasiun, berada antara 20.000 dan 25.000 m, rentang yang dapat dicapai [[ship/0]] awal. Sekitar lima puluh terletak lebih dangkal dan sekitar empat puluh lima lebih dalam. Yang paling ekstrem adalah [[station/28]], yang tertinggi di 13.500 m, dan [[station/81]], yang terdalam di 32.250 m.", false],
		[1, "", "Kedalaman tidak mengikuti geografi. Stasiun dangkal dan dalam bersebelahan di seluruh peta, sehingga tetangga di peta bisa terpisah ribuan meter secara vertikal. [[station/14]], di dekat tengah peta, mudah dijangkau dari [[station/25]] di 17.700 m maupun dari [[station/81]] jauh di bawahnya. Pilot yang merencanakan rute harus membaca kedalaman setiap stasiun, bukan hanya jaraknya. [[station/0]], tempat karier sang pilot dimulai, terletak di barat laut pada 22.500 m.", false],
		[1, "Cahaya dan air", "Tidak ada cahaya siang yang mencapai stasiun. Di luar lambungnya yang diterangi lampu sorot, airnya gelap, dan kapal selam melaju dengan kerucut cahaya lampu depannya sendiri, yang tertelan air dalam beberapa puluh meter. Partikel halus melayang dan hanyut di dalam berkas cahaya, dan di beberapa tempat bercak-bercak samar plankton bercahaya berpendar dalam kegelapan. Naik di atas 15.000 m, menuju permukaan yang jauh, dicatat sebagai pencapaian tersendiri, [[medal/21]].", false],
		[1, "", "Warna air tidak sama di mana-mana. Setiap wilayah mendapat semburat samar dari plankton dan alga yang tumbuh subur di sana, paling kuat di dekat stasiun tempat alga itu paling betah. Arus lambat mengaduk partikel yang melayang, tetapi itu hanya bagian dari pemandangan: arus tidak pernah membelokkan kapal selam dari haluannya atau menghanyutkan hasil tangkapan.", false],
		[1, "Kehidupan laut", "Samudra ini menjadi rumah bagi tiga belas jenis hewan dan lima jenis alga. Mulai dari tangkapan kecil yang mudah seperti [[species/2|ubur-ubur]], [[species/0|nautilus]], dan [[species/4|kawanan ikan]] hingga perenang kuat seperti [[species/7]] dan [[species/8]]. Keanehan laut yang lebih dalam antara lain [[species/5]], [[species/1]], [[species/6]], [[species/9]], dan [[species/11]] yang berzirah. [[species/3]] dan [[species/10]] yang dapat berganti warna dihargai karena kulit dan catnya.", false],
		[1, "", "Hewan terbesar adalah [[species/12]], yang beratnya bisa sekitar 30 t, lebih dari seluruh palka kapal selam kecil. Hewan yang lebih berat dan tangguh melawan lebih lama di harpun dan umumnya lebih mahal, tetapi tidak ada spesies yang bernilai sama di semua tempat. Setiap halaman spesies mencantumkan stasiun yang perairannya menjadi tempat hidupnya dan barang yang dibuat darinya.", false],
		[1, "", "Setiap stasiun memiliki campuran satwanya sendiri, biasanya lima atau enam spesies. Sekitar dua puluh hewan berenang di perairan sebuah stasiun pada satu waktu, diambil dari campuran setempat itu. Seorang nelayan segera tahu stasiun mana yang harus dikunjungi untuk tangkapan apa, dan peta dapat menunjukkan tempat hidup setiap spesies yang sudah pernah ditangkap. Lihat [[guide/fishing]].", false],
		[1, "Dasar laut dan alga", "Kelima alga, [[species/17|hijau]], [[species/16|merah]], [[species/15|cokelat]], [[species/14|biru]], dan [[species/13|emas]] yang berharga, adalah tumbuhan samudra ini. Alga tumbuh menetap di tempatnya alih-alih berenang, masing-masing beratnya tetap 2 t, dan hampir langsung menyerah di harpun. Nilainya terletak pada apa yang dapat dibuat darinya: [[goods/21]] membutuhkan alga hijau, [[goods/27]] alga emas dan merah, dan [[goods/28]] sedikit dari kelimanya.", false],
		[7, "", "Alga juga tumbuh di permukaan luar stasiun itu sendiri, bersama organisme kecil lainnya. Alga menjadi makanan kesukaan nautilus, itulah sebabnya hewan-hewan itu berkumpul dalam jumlah besar di sekitar stasiun.", false],
		[1, "Bagaimana dunia hayati bereaksi", "Hewan tidak sekadar menunggu untuk ditangkap. Makhluk yang terluka, oleh tembakan atau peluru nyasar, melesat kabur, dan makhluk yang terkena harpun meronta sampai lelah. Hewan yang langsung terbunuh hilang sebagai tangkapan: bangkainya mengapung ke atas dan hanya dapat diangkut sebagai [[goods/18]], yang nilainya hanya sebagian kecil dari hewan hidup. Pilot yang menginginkan tangkapan bersih menjauhkan senjatanya dari ikan.", false],
		[1, "", "Dalam permainan, perairan tidak pernah habis ditangkap. Ketika sang pilot pindah tempat, satwa yang ditinggalkan akan tergantikan, sehingga tempat memancing yang baik tetap baik. Perebutan atas kehidupan laut justru muncul di papan kerja, tempat sebagian sponsor membayar agar suatu spesies diburu dan sebagian lain membayar agar sekawanan hewan dilindungi dari para pemburu. Lihat [[contract/7]] dan [[contract/6]].", false],
		[4, "", "Sejak sang pilot memiliki senjata, [[character/1]] memperingatkan agar tidak menembaki ikan yang justru ingin mereka tangkap.", false],
		[7, "", "Koloni menganggap satwa yang menghalangi sebagai gangguan yang harus disingkirkan. Pada [[chapter/7]] sang pilot dikirim untuk menyingkirkan nautilus dari perairan [[station/1]], tempat hewan-hewan itu katanya menghalangi jalur konvoi.", false],
		[9, "", "Pemusnahan itu hampir sia-sia. Pejabat yang membayarnya mengakui bahwa hewan-hewan itu terus kembali, berapa pun yang disingkirkan.", false],
		[15, "", "[[faction/rebels]] memandang laut secara berbeda. Mereka hanya memanen apa yang dapat diberikan laut, mengolah hasil tangkapan menjadi barang, dan berhati-hati agar tidak menangkap ikan berlebihan, demi menjaga keanekaragaman hayati samudra.", false],
		[19, "", "Pada [[chapter/19]] sang pilot menjaga sekawanan [[species/10|cumi-cumi warna]] di dekat [[station/7]] dari pemburu kolonis. Para Aquarian berenang di samping hewan-hewan itu, tampaknya untuk menjaganya; lihat [[world/aquarians]].", false],
		[21, "", "Menurut pemimpin pemberontak [[character/2]], kolonisasi yang cepat menguras samudra lebih cepat daripada kemampuan tumbuhan dan hewannya untuk pulih. Jika terus berlanjut, ia memperingatkan, planet ini akan berakhir terkuras, seperti dunia-dunia lain sebelumnya.", false],
		[48, "", "Setelah pemerintahan kolonial lenyap di akhir perang, pemberontak memperkirakan samudra butuh waktu lama untuk pulih, tetapi mereka bertekad mengawalnya sampai tuntas.", false],
		[1, "Bahaya di kedalaman", "Selain tekanan, samudra juga menyimpan bahaya dari manusia. [[faction/pirates]] memangsa kapal yang sendirian di perairan terbuka, dan di bab-bab selanjutnya sebagian menunggu di dekat stasiun. Ladang ranjau, puing yang hanyut, dan konvoi bersenjata muncul dalam kontrak dan cerita. Tentang siapa yang menguasai bagian samudra yang mana, lihat [[world/colony]] dan [[guide/allegiance]].", false],
	],
	"world/stream": [
		[1, "", "Jaringan S.T.R.E.A.M. adalah sistem gerbang transit yang menghubungkan stasiun-stasiun koloni. Setiap stasiun memiliki gerbang pada jarak tertentu di luarnya, dan kapal selam yang memasukinya hampir seketika keluar di gerbang stasiun lain. Tanpa jaringan ini, menyeberangi [[chart]] berarti pelayaran panjang menembus perairan terbuka yang gelap. Dengan jaringan ini, seorang pilot dapat bekerja di seluruh samudra. Jaringan ini adalah bagian penting permainan sekaligus unsur tetap latarnya; tentang kontrolnya, lihat [[guide/navigation]].", false],
		[1, "Gerbang", "Setiap stasiun memiliki gerbangnya di perairan terbuka, jauh dari dermaga. Kapal meninggalkan area stasiun melalui gerbangnya dan tiba di gerbang tujuan, lalu dari sana melaju masuk untuk berlabuh. Gerbang dibuka dari jarak dekat: sang pilot mengarahkan kapal ke zona aktivasinya dan membuka peta gerbang, yang mencantumkan setiap stasiun dalam jangkauan.", false],
		[1, "", "Perjalanannya sendiri nyaris seketika. Kapal muncul di gerbang tujuan dengan kerusakan yang tidak berubah, jadi kapal selam yang babak belur tetap babak belur saat tiba. Satwa setempat, patroli, dan pertemuan apa pun yang menunggu di tempat tujuan sudah ada di dalam air.", false],
		[1, "Jangkauan dan mesin", "Gerbang tidak menjangkau seluruh samudra. Dari stasiun mana pun, jangkauannya kira-kira seperenam lebar peta. Mesin yang lebih baik memperluas jangkauan sebanding dengan nilainya, sehingga mesin bernilai +30% menjangkau sekitar tiga puluh persen lebih jauh. Stasiun di luar jangkauan memerlukan beberapa lompatan, atau pelayaran panjang dengan autopilot, yang jauh lebih lambat bahkan dengan percepatan waktu.", false],
		[1, "", "Pelayaran di perairan terbuka tetap berguna untuk perjalanan singkat. Autopilot melaju dari area satu stasiun ke area berikutnya, dan selama itu percepatan waktu dapat berjalan hingga enam belas kali kecepatan normal, lalu kembali normal saat bahaya muncul.", false],
		[1, "", "Jaringan ini tidak memperhitungkan kedalaman. Setelah sebuah peringatan, gerbang akan tetap mengantarkan kapal ke stasiun yang berada di luar rentang kedalaman amannya, dan tekanan mulai mengikis perlindungannya begitu kapal tiba. Periksa kedalaman tujuan di halaman stasiunnya sebelum berangkat. Lihat [[guide/depth]].", false],
		[1, "Gerbang dan pertemuan", "Gerbang tertutup selama pertempuran berlangsung. Jika ada pertemuan misi yang aktif di perairan sebuah stasiun, gerbang maupun dermaga tidak dapat digunakan sampai pertemuan itu selesai. Pilot tidak bisa begitu saja lolos dari penyergapan melalui jaringan, dan setiap kontrak harus diperjuangkan sampai tuntas atau gagal.", false],
		[1, "", "Kedatangan melalui gerbang juga menjadi awal masalah. Memasuki area stasiun memicu pertemuan apa pun yang menunggu di sana, mulai dari penjahat buronan hingga konvoi yang harus dilindungi. Kapal patroli berkeliling melewati gerbang, dan di bab-bab selanjutnya bajak laut mungkin menunggu di dekat stasiun.", false],
		[1, "Nama", "Nama jaringan ini selalu ditulis sebagai singkatan, S.T.R.E.A.M., tetapi game tidak pernah menjelaskan kepanjangan huruf-hurufnya. Sang pilot dan [[character/1]] memperlakukan gerbang sebagai bagian biasa kehidupan sehari-hari, seperti jalan raya atau rel kereta.", false],
		[1, "Peran bagi koloni", "Jaringan inilah yang menyatukan koloni. Jaringan ini mengubah dua ratus stasiun yang tersebar menjadi satu ekonomi yang berjalan: hasil tangkapan dapat dijual jauh dari tempat ditangkapnya, dan sebuah kontrak dapat membawa pilot melintasi seluruh peta. Setiap kedatangan di stasiun baru dihitung untuk [[medal/13]], dan labuh pertama di setiap stasiun dihitung untuk [[medal/6]].", false],
		[5, "Dalam cerita", "Sang pilot diperkenalkan dengan gerbang sejak awal, ketika perburuan bajak laut pertama membawanya keluar dari [[station/0]]. Sejak itu hampir setiap perjalanan dalam cerita melewatinya, dan autopilot dapat membawa kapal ke gerbang setempat bila diminta.", false],
		[12, "", "Gerbang tidak mengenal batas politik. Ketika sang pilot pertama kali berlayar menuju perlawanan di [[station/3]], kapal tiba di perairan yang oleh pemberontak disebut netral dan langsung dihentikan penjaga stasiun.", false],
		[21, "", "Operasi pemberontak memanfaatkan gerbang. Dalam misi melawan geng bajak laut di dekat [[station/8]], [[character/3]] menunggu sang pilot di dekat gerbang stasiun sebelum memimpin serangan.", false],
		[45, "", "Dalam serangan ke [[station/18]], skuadron [[character/12]] menunggu di posisi dekat gerbang, sehingga serangan dapat dimulai begitu sang pilot tiba.", false],
	],
}
