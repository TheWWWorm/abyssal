const BLOCKS := {
	"chapter/1": [
		[1, "Краткое содержание", "Кампания начинается в открытом море. Пилот, новичок на океанской планете, нанявшийся рыбаком в колонию, выходит в море на небольшой подлодке вместе с болтливым бортовым компьютером [[character/1]]. Эта глава учит ловле гарпуном: наведитесь на существо, выстрелите гарпуном и держите цель в поле зрения, пока она бьётся, — выбившись из сил, она позволит подтянуть себя к кораблю. Подробнее: [[guide/fishing]].", false],
		[2, "Итог", "Когда первое существо поймано, M.A.I. знакомит пилота с автопилотом, который может довести корабль до выбранной цели, и направляет его на станцию [[station/0]], чтобы продать улов. Подробнее: [[guide/navigation]].", false],
	],
	"chapter/10": [
		[10, "Краткое содержание", "На станции [[station/2]] запуск капсул уже идёт, и Аквариане атакуют. [[character/9]] без обиняков предупреждает по радио: потеря более пяти капсул недопустима. Пилоту нужно отбить нападающих и сохранить капсулы в целости.", false],
		[11, "Итог", "Атака отбита, но пилот недоумевает, зачем Аквариане вообще нападают на капсулы. [[character/1]] предполагает, что они гораздо умнее, чем думают колонисты. Пилот направляется на станцию с докладом, всё больше сомневаясь в такой работе.", false],
	],
	"chapter/11": [
		[11, "Краткое содержание", "После защиты капсул пилот причаливает к станции [[station/2]], чтобы отчитаться. Там его ждёт [[character/9]].", false],
		[12, "Итог", "Джек обвиняет пилота в повреждении капсул, отменяет награду и уходит, бросив, что ему суждены великие дела. Тогда [[character/1]] поднимает более важный вопрос: пилот усердно работает на колонию, получает гроши и никак не может распоряжаться своим уловом. Пилот хочет лишь накопить на билет с планеты. M.A.I. признаётся, что перехватила радиопереговоры движения сопротивления, базирующегося на станции [[station/3]], и отмечает станцию на карте. Отныне станции сопротивления отображаются зелёным.", false],
	],
	"chapter/12": [
		[12, "Краткое содержание", "Пилот отправляется на станцию [[station/3]], чтобы найти сопротивление. Подойти незаметно не удаётся: охрана станции окликает корабль и грозит открыть огонь. Пилот называет своё имя, сообщает, что путь начался на станции [[station/0]], и просит принять его в движение. После напряжённой паузы кораблю разрешают причалить.", false],
		[13, "Итог", "Внутри новичка расспрашивает [[character/4]]. Пилот почти ничего не знает, кроме того, что движение выступает за свободную торговлю, и это сходится со словами Пьера: их радиошифр включили совсем недавно. Людей не хватает, и Пьер берёт пилота на испытательный срок. Движение собирается привлечь на свою сторону руководителей станций колонистов и положить конец эксплуатации планеты. Первое задание — забрать сочувствующих на станции [[station/4]] и доставить их на станцию [[station/5]].", false],
	],
	"chapter/13": [
		[13, "Краткое содержание", "Пилот прибывает на станцию [[station/4]] за связным движения, всё ещё плохо понимая, что такое это сопротивление и в чём состоит работа. [[character/1]] замечает, что это, по крайней мере, интереснее, чем выполнять приказы, которые отдаёт [[character/9]], и пилот соглашается.", false],
		[14, "Итог", "Связной оказывается [[character/5]] — приветливая, бойкая и явно обрадованная знакомству с пилотом. О планах движения она молчит, объясняя, что именно скрытность до сих пор помогала им выжить, и передаёт координаты маршрута. [[character/1]] наблюдает за ними с открытым раздражением, и пилот в шутку называет это ревностью.", false],
	],
	"chapter/14": [
		[14, "Краткое содержание", "Взяв на борт [[character/5]], пилот как можно быстрее и безопаснее доставляет её на станцию [[station/5]].", false],
		[15, "Итог", "На станции [[station/5]] Леа на время исчезает, чтобы уладить кое-какие дела. Перед уходом она объясняет, как живут повстанцы: они берут лишь то, что море может отдать без ущерба, перерабатывают улов в товары и стараются не вылавливать лишнего. Она просит пилота попробовать самому — произвести пять тонн товаров на фабрике станции сопротивления — и советует станцию [[station/90]], где можно наловить спрутов и купить [[goods/35|растворитель]], чтобы сделать [[goods/22|краску]].", false],
	],
	"chapter/15": [
		[15, "Краткое содержание", "Глава о производстве. Пилоту нужно произвести пять тонн товаров на фабрике станции повстанцев, превращая улов и купленные компоненты в продукцию, которая стоит дороже сырья. Подробнее: [[guide/trading]].", false],
		[16, "Итог", "[[character/5]] снова выходит на связь. Теперь, когда у пилота есть второй способ заработка, у неё новое задание: посетить как можно больше незнакомых станций. Свежие сведения с каждой станции помогают движению находить слабые места и склонять население на свою сторону. На вопрос пилота, не революция ли это, она уходит от ответа и советует пока зарабатывать деньги на улучшение корабля.", false],
	],
	"chapter/16": [
		[16, "Краткое содержание", "Пилоту нужно открыть пять станций, на которых он ещё не бывал. Исследование расширяет торговую сеть и приносит движению сведения. Некоторые станции могут оказаться за пределами текущего диапазона глубин корабля. Подробнее: [[guide/depth]].", false],
		[17, "Итог", "[[character/4]] присылает длинное сообщение, которое [[character/1]] сводит к единственной сути: пилоту нужно вернуться на станцию [[station/3]] за инструкциями.", false],
	],
	"chapter/17": [
		[17, "Краткое содержание", "Пилот возвращается на станцию [[station/3]] по вызову, который прислал [[character/4]], и получает разрешение причалить.", false],
		[18, "Итог", "Пьер сообщает, что благодаря дипломатии зона повстанцев расширилась и теперь пилот может торговать на гораздо большем числе станций. В новостях уже говорят о революции; многие влиятельные люди перешли на сторону движения без кровопролития, хотя Пьер сомневается, что так будет и дальше. Лидер движения руководит следующими шагами с одной из недавно перешедших станций и сам выйдет на связь. Пьер отмечает возможные станции и предупреждает, что для перехода к некоторым из них может понадобиться броня или щит получше.", false],
	],
	"chapter/18": [
		[18, "Краткое содержание", "Пилоту нужно разыскать лидера движения среди недавно перешедших станций, полагаясь почти только на удачу. След ведёт на станцию [[station/6]].", false],
		[19, "Итог", "На станции [[station/6]] пилот встречает [[character/2]]: она руководит движением и отныне будет отдавать приказы. Пилот ожидал увидеть мужчину, но она не придаёт этому значения. Её первое задание — сопровождение: стая [[species/10|чернильных спрутов]] должна добраться до безопасных вод, прежде чем колонисты поймают или перебьют её, и боя, скорее всего, не избежать. [[character/1]] ворчит, что об оплате никто и слова не сказал.", false],
	],
	"chapter/19": [
		[19, "Краткое содержание", "У станции [[station/7]] пилоту нужно защитить стаю [[species/10|чернильных спрутов]] от кораблей колонистов, стараясь не задеть самих животных. Рядом со стаей плывут Аквариане, и [[character/1]] задаётся вопросом, не заботятся ли они о морских обитателях.", false],
		[20, "Итог", "Корабли колонистов подбираются к животным, и пилоту приходится перехватывать их, пока они не подошли слишком близко. Стая спасена. [[character/2]] выплачивает скромную награду и просит пилота немедленно вернуться за новым заданием. M.A.I. жалуется, что поймать и продать животных было бы выгоднее.", false],
	],
	"chapter/2": [
		[2, "Краткое содержание", "С рыбой в трюме пилот направляется на станцию [[station/0]] — станцию колонистов, которая скупает дневной улов. Глава представляет собой простое путешествие и первую возможность причалить и осмотреться на станции.", false],
		[3, "Итог", "На станции [[station/0]] пилота встречает [[character/9]], ведающий закупкой улова. Он платит обычную твёрдую цену, насмехается над размером трюма пилота и намекает, что с настоящей пушкой можно заработать больше на охоте за пиратами. Когда он уходит, M.A.I. соглашается, что он неприятный тип, но намёк понимает: в ангаре как раз продаётся [[equipment/0]]. Кроме того, M.A.I. объясняет, что помощь доступна на каждом экране станции.", false],
	],
	"chapter/20": [
		[20, "Краткое содержание", "Пилот возвращается на станцию [[station/6]] с докладом. Там его ждёт [[character/2]].", false],
		[21, "Итог", "Наконец пилот спрашивает Аюми, за что выступает движение. Она описывает союз людей, сплотившихся против разорения планеты: стремительная колонизация истощает её ресурсы быстрее, чем природа успевает восстановиться, — так уже случилось на других мирах, — и цель движения в том, чтобы убедить влиятельных людей дать отпор. Тем временем конфликтом пользуются [[faction/pirates|пираты]]. Аюми решает ударить первой и отправляет пилота против пиратского соединения вместе с одним из своих лучших пилотов — это [[character/3]].", false],
	],
	"chapter/21": [
		[21, "Краткое содержание", "У станции [[station/8]] пилот вместе с [[character/3]] должен уничтожить банду пиратов. Реймонд с первой минуты нетерпелив и снисходителен; он велит новичку держаться позади и учиться.", false],
		[22, "Итог", "Банда уничтожена. Реймонд нехотя хвалит пилота, а [[character/2]] выплачивает обоим одинаковую награду и просит пилота встретиться с ней на станции [[station/9]]. Реймонд в ярости от того, что деньги поделены поровну, и принижает вклад пилота; пилот уходит, пока тот не разошёлся ещё сильнее.", false],
	],
	"chapter/22": [
		[22, "Краткое содержание", "Пилот отправляется на станцию [[station/9]], где только что завершились переговоры. Там его ждёт [[character/2]]. Несколько станций, в том числе [[station/9]], теперь на стороне движения.", false],
		[23, "Итог", "Перед отъездом Аюми хочет обезопасить путь снабжения к станции [[station/37]]. [[character/9]] перерезал его, установив минное поле прямо у станции. Аюми его знает: когда-то мелкая сошка, он быстро поднялся благодаря полезным связям. Она предупреждает, что вокруг, скорее всего, кружат пираты и что мины можно уничтожить только после того, как они сработают.", false],
	],
	"chapter/23": [
		[23, "Краткое содержание", "У станции [[station/9]] пилоту нужно расчистить минное поле, перекрывающее путь к станции [[station/37]]. Аюми отмечает мины на карте. К каждой мине нужно подойти, чтобы сработал её датчик движения, и только после этого её можно расстрелять. Неподалёку в ожидании лёгкой добычи рыщут пираты, так что пилоту придётся разобраться и с ними. Подробнее: [[contract/10]].", false],
		[24, "Итог", "Минное поле расчищено, и путь к станции [[station/37]] снова безопасен. [[character/2]] довольна, что не ошиблась в пилоте, и платит ему за работу.", false],
	],
	"chapter/24": [
		[24, "Краткое содержание", "Расчистив мины, пилот возвращается на станцию [[station/9]]. Путь снабжения к станции [[station/37]] снова открыт, и теперь с движением торгует большая группа станций по всему океану; зона повстанцев на карте заметно растёт.", false],
		[25, "Итог", "На станции [[station/9]] пилот снова встречает [[character/5]]; разговор выходит тёплым, но неловким. Его прерывает [[character/2]] со следующим заданием: новые переговоры на станции [[station/10]] могут привлечь ещё несколько станций. Пилот и Леа должны сопроводить туда Аюми и [[character/3]]. Пилота не радует перспектива идти в рейс с Реймондом, но Аюми ручается за его мастерство и не ждёт ничего хуже пиратов.", false],
	],
	"chapter/25": [
		[25, "Краткое содержание", "Эскорт прибывает к станции [[station/10]] и понимает, что что-то не так. Там с силами колонистов поджидает [[character/9]] и приказывает атаковать. Аюми не может понять, откуда они узнали о её прибытии. Пилоту нужно сдержать нападающих и защитить [[character/2]].", false],
		[26, "Итог", "Во время боя [[character/3]] заявляет, что у него отказало оружие, и бежит. Остальные выживают. [[character/5]] обвиняет его в предательстве, а Аюми по-прежнему ему доверяет и подозревает саботаж. Пока не подоспели новые колонисты, группа расходится: Аюми уходит в подполье, Леа берёт на себя дела на станции [[station/9]], а пилоту велят до следующей встречи стать гораздо более умелым бойцом.", false],
	],
	"chapter/26": [
		[26, "Краткое содержание", "Пока [[character/2]] скрывается, а [[character/3]] исчез, пилоту нужно уничтожить ещё десять вражеских кораблей и доказать готовность к тяжёлым боям впереди. Удобные цели — пираты, а боевые контракты на панелях заданий дают ещё больше возможностей. Самое время улучшить оружие и броню. Подробнее: [[guide/combat]].", false],
		[27, "Итог", "Неожиданно выходит на связь [[character/3]]: он спрашивает, как дела у Аюми и Леа, и уверяет, что у него есть срочные сведения. Он просит о встрече у станции [[station/11]]. [[character/1]] уверена, что это ловушка. Пилот соглашается — и всё равно отправляется в путь.", false],
	],
	"chapter/27": [
		[27, "Краткое содержание", "У станции [[station/11]] пилот следует по путевым точкам на встречу, которую назначил [[character/3]], вполне ожидая ловушки. Цель — захватить обездвиженный корабль — намекает, что одним разговором дело не кончится.", false],
		[28, "Итог", "Реймонд держит в плену [[character/2]] и требует сдаться. Пока [[character/1]] сканирует его корабль, пилот тянет время разговором. Реймонд признаётся, что перешёл на другую сторону ради денег: [[character/9]] назначил награду за голову и Аюми, и пилота. Сканирование показывает одноместный корабль, значит, Аюми должна быть в бронированном грузовом отсеке. Пилот уничтожает корабль Реймонда, подбирает контейнер, пока тот не утонул, и берёт курс на станцию [[station/12]].", false],
	],
	"chapter/28": [
		[28, "Краткое содержание", "Пилот доставляет подобранный контейнер на станцию [[station/12]], ближайшую дружественную станцию, в надежде, что [[character/1]] не ошиблась в догадке о его содержимом.", false],
		[29, "Итог", "[[character/2]] выбирается наружу потрясённой, но невредимой и благодарит пилота за спасение. Отдыхать некогда. Перед похищением она организовывала переброску группы высококлассных учёных на станцию [[station/14]], и Реймонд, возможно, уже выдал подробности. Пилоту нужно благополучно провести конвой через пограничную зону.", false],
	],
	"chapter/29": [
		[29, "Краткое содержание", "У станции [[station/13]] пилот застаёт конвой учёных под сильным огнём и подоспевает как раз вовремя. Дружественные корабли просят поддержки: их защита слабеет. Пилоту нужно отогнать нападающих и провести конвой через пограничную зону. Каждый потерянный корабль ставит под угрозу секретный проект движения.", false],
		[30, "Итог", "Конвой прорывается, и его экипаж благодарит за спасение. [[character/2]] признаёт, что всё висело на волоске. [[character/2]] платит пилоту и назначает встречу на станции [[station/14]], где объяснит, что будет дальше.", false],
	],
	"chapter/3": [
		[3, "Краткое содержание", "Короткая обучающая глава об оснащении корабля. Пилот заходит в ангар станции [[station/0]], чтобы купить и установить [[equipment/0]] — первое настоящее оружие корабля. Глава показывает, как покупать оборудование и устанавливать его в свободный слот. Подробнее: [[guide/fitting]].", false],
		[4, "Итог", "Когда рельсотрон установлен, M.A.I. напоминает пилоту, что стрелять по безобидным морским обитателям не стоит, и предлагает сразу же опробовать оружие на пиратах.", false],
	],
	"chapter/30": [
		[30, "Краткое содержание", "Пилот отправляется на станцию [[station/14]], куда прибыл конвой учёных.", false],
		[31, "Итог", "Пилота ждут [[character/5]], [[character/4]] и [[character/2]]. Аюми объясняет план: колонисты по-прежнему превосходят повстанцев числом, поэтому профессор Абель и его команда создадут оружие, способное уравнять силы, — в три этапа. Первый — источник энергии, Биотек-генератор. Прототип Абеля похитили колонисты, которые пытаются доделать его сами. Леа добавляет, что генератор перевозят с обычным колонистским конвоем у станции [[station/2]]. Поскольку никто не знает, на каком корабле он находится, пилоту и Пьеру нужно остановить весь конвой и подобрать все контейнеры.", false],
	],
	"chapter/31": [
		[31, "Краткое содержание", "У станции [[station/2]] пилот, [[character/5]] и [[character/4]] перехватывают колонистский конвой с похищенным Биотек-генератором. Неизвестно, на каком корабле генератор, поэтому остановить нужно каждое судно конвоя. Экипажи уверяют, что везут только еду и лекарства, а [[character/4]] отвечает мрачной шуткой. Пилоту нужно обездвижить корабли и подобрать гарпуном все контейнеры, пока груз не утонул.", false],
		[32, "Итог", "Все контейнеры подобраны, в том числе генератор, и команда возвращается на станцию [[station/14]], чтобы передать добычу профессору Абелю.", false],
	],
	"chapter/32": [
		[32, "Краткое содержание", "Пилот возвращается на станцию [[station/14]] с подобранным грузом.", false],
		[33, "Итог", "Профессор Абель забирает добычу в свою лабораторию. [[character/2]] отправляет [[character/5]] патрулировать окрестности станции [[station/14]], [[character/4]] — в ангар, а пилоту поручает второй этап. Генератору нужно оружие, достойное его мощности: [[equipment/42]] — станционная оборонительная пушка, настолько энергоёмкая, что её ещё ни разу не ставили на корабль. Ближайшая фабрика, станция [[station/188]], в руках колонистов, поэтому пилоту стоит попытать счастья на станции [[station/15]]. Пушка не продаётся, и Аюми выдаёт крупную сумму на взятки.", false],
	],
	"chapter/33": [
		[33, "Краткое содержание", "Начинается второй этап плана, который составила [[character/2]]. Пилот отправляется на станцию повстанцев [[station/15]], чтобы раздобыть [[equipment/42]]. Обычно эту пушку производят на колонистской станции [[station/188]], и открыто её нигде не продают. У пилота есть крупная сумма от Аюми на взятки, но нет никакого настоящего плана — остаётся надеяться, что по прибытии подвернётся удобный случай.", false],
		[34, "Итог", "Пилот прибывает на станцию [[station/15]]. Ни связей, ни плана нет, так что остаётся лишь осмотреться на станции и посмотреть, что из этого выйдет.", false],
	],
	"chapter/34": [
		[34, "Краткое содержание", "На станции [[station/15]] след начинается с ассортимента местного торговца. Цель — добыть партию товара «[[goods/37]]», запрещённого на этой станции, и это привлекает внимание нужных людей.", false],
		[35, "Итог", "К пилоту подходит торговец с чёрного рынка по имени [[character/8]] и предлагает достать почти что угодно. Услышав просьбу раздобыть [[equipment/42]], он поражён, но соглашается попробовать в обмен на услугу: пилот должен устранить охотника за головами, которого служба безопасности наняла избавиться от Фенко. Его зовут [[character/11]], и он патрулирует окрестности станции.", false],
	],
	"chapter/35": [
		[35, "Краткое содержание", "У станции [[station/15]] пилот выслеживает охотника за головами, от которого хочет избавиться [[character/8]]. Это [[character/11]]. Рауль не один: он привёл сопровождение и пытается отмахнуться от пилота как от простого рыбака. Пилоту нужно уничтожить разыскиваемый корабль. Подробнее: [[contract/0]].", false],
		[36, "Итог", "После последней попытки договориться корабль Рауля уничтожен, а его сопровождение отогнано или потоплено. Пилот возвращается узнать, сдержит ли [[character/8]] слово.", false],
	],
	"chapter/36": [
		[36, "Краткое содержание", "Пилот причаливает к станции [[station/15]], чтобы получить обещанное, не зная, можно ли полагаться на слово торговца с чёрного рынка. Обещание дал [[character/8]].", false],
		[37, "Итог", "Фенко нашёл [[equipment/42]] и готов продать пушку, но по цене, раздутой из-за взяток, которые ему пришлось заплатить. На вопрос пилота, откуда она взялась, Фенко называет продавца: это [[character/9]]. [[character/1]] наслаждается иронией: жадность Джека вооружает его же врагов. Пилот решает купить пушку и уйти, пока ничего не изменилось.", false],
	],
	"chapter/37": [
		[37, "Краткое содержание", "Теперь [[character/8]] предлагает [[goods/38|Eclipse]] на продажу на станции [[station/15]]. Пилоту нужно купить его на экране торговли и погрузить на борт. Цена высока, но деньги Аюми на взятки предназначались именно для этого, а в трюме должно хватить места для большой пушки. Подробнее: [[guide/trading]].", false],
		[38, "Итог", "Пушка в трюме — [[character/1]] с трудом в это верит. Второй этап завершён. Пилот возвращается на станцию [[station/14]] посмотреть, как продвигается работа над прототипом генератора.", false],
	],
	"chapter/38": [
		[38, "Краткое содержание", "Пилот возвращается на станцию [[station/14]] с пушкой [[equipment/42]] в трюме, желая узнать, насколько продвинулся с прототипом профессор Абель.", false],
		[39, "Итог", "[[character/2]] предпочитает не знать, как была добыта пушка. Прототип почти готов, но одну деталь на станции [[station/14]] сделать нельзя: это [[goods/36]] — устройство, которое размножает ДНК частиц водорослей, чтобы запустить энергетическую реакцию генератора. Оборудование для его производства есть только на станции [[station/16]], поэтому третий этап ведёт пилота туда. [[character/1]] замечает, что пилот, похоже, в одиночку тянет на себе всё восстание.", false],
	],
	"chapter/39": [
		[39, "Краткое содержание", "Начинается третий этап. Пилот отправляется на станцию [[station/16]] — единственную, где есть оборудование для производства [[goods/36|ПЦР-инкубатора]], нужного Биотек-генератору. Станция [[station/16]] лежит глубже большинства станций, поэтому, чтобы безопасно до неё добраться, кораблю может понадобиться более прочная броня. Подробнее: [[guide/depth]].", false],
		[40, "Итог", "Пилот причаливает к станции [[station/16]] и начинает выяснять, что нужно для инкубатора, понимая, что задача будет какой угодно, только не простой.", false],
	],
	"chapter/4": [
		[4, "Краткое содержание", "Обучающая глава о том, как покидать станцию. Пилот отчаливает от станции [[station/0]] в поисках пиратов, но в местных водах тихо, и M.A.I. предлагает отправиться к другой станции.", false],
		[5, "Итог", "M.A.I. рассказывает о S.T.R.E.A.M. — сети течений для дальних путешествий: корабль всегда покидает район через выход S.T.R.E.A.M. OUT и прибывает в следующий через вход S.T.R.E.A.M. IN, а сам переход может взять на себя автопилот. Подробнее: [[guide/navigation]].", false],
	],
	"chapter/40": [
		[40, "Краткое содержание", "На станции [[station/16]] пилоту нужно произвести [[goods/36]] на фабрике станции. Инкубатор — сложная продукция, и его рецепт требует нескольких компонентов, которые, возможно, придётся сначала поймать, купить или произвести в другом месте. [[character/1]] ожидает, что будет непросто, и пилот с ней согласен. Подробнее: [[guide/trading]].", false],
		[41, "Итог", "Инкубатор готов. M.A.I. признаётся, что сомневалась, справится ли пилот. Всё ещё не уверенный, правильно ли он поступает, пилот берёт курс на станцию [[station/14]].", false],
	],
	"chapter/41": [
		[41, "Краткое содержание", "Пилоту нужно благополучно доставить [[goods/36]] на станцию [[station/14]], где профессор Абель ждёт, чтобы завершить прототип генератора. Это последняя недостающая часть трёхэтапного плана, который задумала [[character/2]].", false],
		[42, "Итог", "Инкубатор принимает [[character/5]]. У профессора Абеля всё готово, и [[equipment/42]] вскоре должна появиться в ангаре. Аюми хочет немедленно испытать пушку на пиратах, и Леа передаёт координаты, предупреждая, что генератор — всего лишь прототип. [[character/1]], которую будто бы выключили, даёт понять, что слышала каждое слово.", false],
	],
	"chapter/42": [
		[42, "Краткое содержание", "Когда [[equipment/42]] установлена в ангаре станции [[station/14]], пилот направляется к пиратскому логову у станции [[station/17]], чтобы испытать её в бою. Генератор — лишь прототип, так что испытание заодно проверяет, выдержит ли он нагрузку. Увидев, с чем имеют дело, пираты вызывают подкрепление, и посреди боя появляются новые корабли.", false],
		[43, "Итог", "Когда бой стихает, [[character/1]] перехватывает сигнал бедствия со станции [[station/14]], переданный открыто, по нешифрованному каналу. Пилот немедленно поворачивает назад.", false],
	],
	"chapter/43": [
		[43, "Краткое содержание", "Силы колонистов внезапно атаковали станцию [[station/14]]. Многие причалы повреждены, и повстанцы не могут выпустить достаточно кораблей. Штурмом командует [[character/9]]; он насмехается над пилотом, пока не слышит, что [[equipment/42]] готова к бою. Пилоту нужно защитить станцию и её дружественные корабли.", false],
		[44, "Итог", "В разгар битвы появляются Аквариане и обрушиваются на колонистов, сражаясь на стороне повстанцев. Когда атака захлёбывается, Джек бежит с поля боя. [[character/2]] называет спасение чудом и просит пилота причалить, упоминая особого гостя.", false],
	],
	"chapter/44": [
		[44, "Краткое содержание", "После битвы пилот причаливает к станции [[station/14]].", false],
		[45, "Итог", "Особый гость — посланник Аквариан. Аквариане помогут покончить с властью колонистов, чтобы все могли жить в гармонии с морем. [[character/2]] планирует два крупных наступления, чтобы взять оставшиеся станции. Станция [[station/188]] теперь в руках повстанцев, и как можно больше кораблей вооружают пушками [[equipment/42]]. Пилот возглавит атаку на станцию [[station/18]] со свежими силами и при поддержке Аквариан, а [[character/5]] поведёт штурм станции [[station/109]].", false],
	],
	"chapter/45": [
		[45, "Краткое содержание", "У станции [[station/18]] пилота встречает [[character/12]], лидер отряда Атмос, корабли которого ждут приказа к атаке. Из глубин поднимаются Аквариане, чтобы присоединиться к бою. Прежде чем взять станцию, нужно уничтожить все корабли колонистов, включая грузовые. Тем временем [[character/5]] ведёт параллельный штурм станции [[station/109]].", false],
		[46, "Итог", "Защитники-колонисты и их грузовые корабли уничтожены, и объединённые силы повстанцев и Аквариан контролируют воды вокруг станции. Пилот отправляет половину отряда Колина патрулировать окрестности станции, а с остальными идёт на стыковку.", false],
	],
	"chapter/46": [
		[46, "Краткое содержание", "Пилот причаливает к станции [[station/18]] с частью отряда, которым командует [[character/12]], чтобы закрепиться на захваченной станции; остальные патрулируют снаружи.", false],
		[47, "Итог", "[[character/5]] сообщает, что её атака на станцию [[station/109]] тоже удалась и южные станции теперь под контролем повстанцев. Аюми дала пилоту, возможно, последнее задание: станция [[station/0]] — последний крупный оплот колонистов и та самая станция, где началась история пилота. Она сильно укреплена, и [[character/2]] уже в пути. Леа идёт следом, но путь ей преграждают пираты.", false],
	],
	"chapter/47": [
		[47, "Краткое содержание", "У станции [[station/0]] пилот вместе с [[character/2]] и [[character/5]] вступает в последнюю битву. Чтобы взять станцию, нужно уничтожить все корабли защитников. Среди них и [[character/9]]. Когда пилот вспоминает о судьбе, которая постигла [[character/3]], Джек пытается выбить пилота из колеи безумной историей о том, что он — отец пилота, а Реймонд — брат пилота. Пилот сразу видит обман.", false],
		[48, "Итог", "Флот колонистов гибнет, пока не остаётся один Джек. Он быстр и опасен, но в конце концов пилот обездвиживает его корабль. Джек уходит вверх в спасательной капсуле, которая, похоже, уносит с собой всю станцию, и на прощание презрительно отзывается о планете. Битва окончена.", false],
	],
	"chapter/48": [
		[48, "Краткое содержание", "Война выиграна. Флот колонистов разбит, [[character/9]] бежал с планеты, а станция [[station/0]] и последние станции, ещё верные колонистам, переходят на сторону повстанцев. Теперь все станции на стороне движения.", false],
		[48, "", "Победители подводят итоги. [[character/2]] благодарит пилота и [[character/5]] и признаёт, что ранам планеты понадобится много времени, чтобы зажить, но верит, что и с этим они справятся. Леа приглашает пилота отпраздновать за [[goods/21|суши]], и пилот соглашается. [[character/1]], которой обещали расширение памяти, как только пилот вернётся на твёрдую землю, уверяет, что ей это ни к чему, и до самого конца подшучивает над парочкой.", false],
		[48, "", "Кампания завершена. Пилот может и дальше исследовать океан, торговать и брать контракты по всему миру, где при повстанцах наконец воцарился покой.", false],
	],
	"chapter/5": [
		[5, "Краткое содержание", "Первый бой пилота происходит у станции [[station/1]]. M.A.I. объясняет, как переключаться между оружием и гарпуном, чем помогает автоогонь и как читать радар: красные метки — враги, зелёные — союзники, жёлтые — путевые точки. Вскоре на экране появляется одинокий [[faction/pirates|пират]]. Подробнее: [[guide/combat]].", false],
		[6, "Итог", "Пират уничтожен. M.A.I. указывает, что после уничтоженных кораблей остаются ящики с грузом, которые можно подобрать гарпуном, пока они не ушли на недосягаемую глубину, и берёт курс обратно на станцию [[station/0]].", false],
	],
	"chapter/6": [
		[6, "Краткое содержание", "После первого успешного боя пилот возвращается на станцию [[station/0]] с исправным оружием и, возможно, с трофейным грузом на продажу. Это короткий обратный путь через сеть S.T.R.E.A.M.", false],
		[7, "Итог", "[[character/9]] замечает новое оружие и предлагает, по его словам, настоящую работу. [[species/0|Наутилусы]] заполонили пути конвоев вокруг станции [[station/1]], и служба безопасности станции хочет от них избавиться. Пилот возражает, что животные просто питаются наростами на корпусах станции, а трюм слишком мал, чтобы увезти их всех. Джек отметает оба довода: животные должны исчезнуть, неважно каким способом.", false],
	],
	"chapter/7": [
		[7, "Краткое содержание", "У станции [[station/1]] пилоту нужно избавиться от [[species/0|наутилусов]]. Засчитываются и убитые, и пойманные животные. Ни пилоту, ни [[character/1]] эта работа не по душе — существа редкие и безобидные, — но они решают довести её до конца.", false],
		[8, "Итог", "Работа потрясает пилота. Он здесь, чтобы рыбачить, а не истреблять животных ради удобства колонии. M.A.I. надеется, что хотя бы плата это возместит, и предлагает причалить к станции [[station/1]] за вознаграждением.", false],
	],
	"chapter/8": [
		[8, "Краткое содержание", "Пилот причаливает к станции [[station/1]], чтобы отчитаться об охоте на наутилусов.", false],
		[9, "Итог", "Чиновник колонии встречает пилота с плохо скрываемым презрением, называет работу борьбой с вредителями и признаёт, что она, скорее всего, бесполезна: существа всё равно возвращаются. Плата невелика и обсуждению не подлежит. Прежде чем давать новую работу, чиновник требует доказать свои способности: выполнить три задания с панелей заданий станций. [[character/1]] объясняет, как находить контракты, предупреждает, что некоторые места работы лежат за пределами допустимой глубины корабля, и показывает, как прокладывать маршруты по карте станции.", false],
	],
	"chapter/9": [
		[9, "Краткое содержание", "Глава о вольной работе. Пилоту нужно выполнить три контракта с панели заданий любой станции. Контракты бывают самые разные — от сопровождения и захвата грузов до заказов на улов, — и стоит заглянуть на несколько станций. Подробнее: [[guide/contracts]].", false],
		[10, "Итог", "Довольный чиновник колонии предлагает особое задание. Странные существа, которых колонисты называют Аквариане, — наполовину люди, наполовину рыбы — нападают на транспортные капсулы, которые поднимают товары колонии на орбиту, откуда их забирают. Повреждённые или пропавшие капсулы портят станции репутацию в глазах торговой администрации. Следующий запуск состоится на станции [[station/2]], операцией будет руководить [[character/9]], а пилоту предстоит отогнать Аквариан и доложить ему.", false],
	],
	"character/0": [
		[1, "", "Пилот — персонаж игрока: новичок на колонизированной океанской планете, который водит небольшую подлодку и зарабатывает на жизнь рыбалкой. Имя пилоту выбирает игрок, а краткие описания глав в журнале написаны как личные заметки пилота. В море пилот никогда не бывает один: бортовой компьютер корабля — [[character/1]] — комментирует почти каждый его шаг. История начинается на станции [[station/0]], где пилот продаёт улов колонии.", false],
		[1, "Предыстория", "О жизни пилота до начала кампании известно мало. Он прибыл на планету рыбачить и жалеет о переезде с самой первой миссии, ворча, что приходится выполнять приказы бортового компьютера. Всё остальное приходится складывать из того, что пилот говорит и делает.", false],
		[7, "", "Пилот хорошо знает море и его обитателей. Когда колония жалуется, что [[species/0|наутилусы]] заполонили пути конвоев, пилот указывает, что эти животные питаются водорослями и другими наростами на корпусах станций, так что их присутствие вряд ли удивительно.", false],
		[12, "", "Поначалу цели пилота скромны. Он хочет заработать на билет с планеты, но твёрдые цены за улов делают эту цель недостижимой. Позже, прося принять его в сопротивление, пилот называет своим домом станцию [[station/0]].", false],
		[1, "Рыбак на службе колонии", "История начинается с того, что пилот заполняет трюм и берёт курс на станцию [[station/0]] ([[chapter/1|главы 1]] и [[chapter/2|2]]).", false],
		[3, "", "Там [[character/9]] платит за улов твёрдую цену, насмехается над маленьким трюмом и советует пилоту лучше поохотиться на [[faction/pirates|пиратов]].", false],
		[6, "", "Пилот устанавливает [[equipment/0]] и сбивает первого пирата у станции [[station/1]] ([[chapter/3|главы 3]]–[[chapter/5|5]]).", false],
		[7, "", "Затем [[character/9]] даёт работу похуже: очистить пути вокруг станции [[station/1]] от [[species/0|наутилусов]] ([[chapter/7|глава 7]]).", false],
		[8, "", "Истребление животных вызывает у пилота отвращение. Он прибыл сюда рыбачить, а не убивать безобидных животных.", false],
		[10, "", "Чиновник колонии на станции [[station/1]] платит мало, требует в доказательство надёжности выполнить три контракта ([[chapter/9|глава 9]]), а затем отправляет пилота на станцию [[station/2]] защищать транспортные капсулы от [[world/aquarians|Аквариан]] ([[chapter/10|глава 10]]).", false],
		[12, "", "Пилот выигрывает бой, но начинает задумываться, зачем [[world/aquarians|Аквариане]] вообще нападают. Когда [[character/9]] обвиняет пилота в повреждении капсул и не выплачивает награду, [[character/1]] признаётся, что перехватила переговоры движения сопротивления на станции [[station/3]], и пилот решает его найти ([[chapter/12|глава 12]]).", false],
		[12, "Вступление в сопротивление", "На станции [[station/3]] охрана повстанцев грозит открыть огонь, и пилоту приходится, запинаясь, назвать своё имя и попроситься в движение, прежде чем ему разрешают причалить.", false],
		[13, "", "[[character/4]] берёт пилота на испытательный срок — в основном потому, что движению нужны все свободные руки, — и отправляет забрать связного со станции [[station/4]] ([[chapter/13|глава 13]]).", false],
		[14, "", "Связной оказывается [[character/5]], и пилот, доставляя её на станцию [[station/5]], заметно очарован ([[chapter/14|глава 14]]).", false],
		[16, "", "[[character/5]] показывает пилоту, как повстанцы живут морем ([[chapter/15|глава 15]]), а затем просит его разведать для движения новые станции ([[chapter/16|глава 16]]). Тут пилот впервые слышит слово «революция».", false],
		[18, "", "На станции [[station/3]] [[character/4]] сообщает о дипломатических успехах движения и отправляет пилота почти без подсказок искать лидера ([[chapter/18|глава 18]]).", false],
		[19, "На службе у лидера", "Лидер — это [[character/2]]: она встречает пилота на станции [[station/6]], хотя пилот ожидал увидеть мужчину. Её первый приказ — защитить стаю [[species/10|чернильных спрутов]] от охотников-колонистов ([[chapter/19|глава 19]]).", false],
		[21, "", "Когда она наконец объясняет цели движения, пилот всерьёз посвящает себя общему делу. Она отправляет пилота против банды пиратов вместе со своим асом — это [[character/3]] ([[chapter/21|глава 21]]).", false],
		[23, "", "[[character/3]] видит в пилоте лишь помеху. На станции [[station/9]] пилот узнаёт, что [[character/9]] теперь враг движения, и с готовностью расчищает минное поле, которое тот установил на пути снабжения повстанцев ([[chapter/23|глава 23]]).", false],
		[25, "", "Снова встретившись с [[character/5|Леа]], пилот получает задание сопроводить [[character/2]] и [[character/3|Реймонда]] на переговоры на станции [[station/10]] ([[chapter/25|глава 25]]).", false],
		[26, "", "Там их поджидают силы, которые привёл [[character/9]]. [[character/3]] бежит, заявляя, что у него отказало оружие, и пилоту вместе с [[character/5|Леа]] приходится защищать [[character/2]] в одиночку. Затем [[character/2]] уходит в подполье и велит пилоту стать гораздо более умелым бойцом ([[chapter/26|глава 26]]).", false],
		[27, "Предательство и спасение", "Позже [[character/3]] выходит на связь, предлагая срочные сведения. Пилот подозревает ловушку, но соглашается встретиться у станции [[station/11]] ([[chapter/27|глава 27]]).", false],
		[28, "", "Это действительно ловушка: [[character/3]] держит в плену лидера движения — это [[character/2]] — и требует сдаться. Следуя плану, который предложила [[character/1]], пилот тянет время разговором, пока она сканирует корабль противника, и говорит, что эта борьба — дело убеждений, а не денег. Затем пилот уничтожает корабль и подбирает его бронированный грузовой отсек, в котором жива и невредима [[character/2]], пока тот не ушёл слишком глубоко ([[chapter/28|глава 28]]).", false],
		[31, "План в три этапа", "Защитив конвой учёных ([[chapter/29|глава 29]]), пилот узнаёт план [[character/2|Аюми]]: создать оружие вместе с [[world/abel|профессором Абелем]]. Вместе с [[character/4|Пьером]] и [[character/5|Леа]] пилот отбивает [[world/biotek|Биотек-генератор]] у конвоя колонистов ([[chapter/31|глава 31]]).", false],
		[33, "", "Затем пилоту нужно раздобыть пушку [[equipment/42]], которая не продаётся, имея при себе лишь деньги на взятки. Пилот замечает, как мало продумано это задание, но охотно берётся за него ([[chapter/33|глава 33]]).", false],
		[37, "", "На станции [[station/15]] торговец с чёрного рынка — это [[character/8]] — соглашается найти такую пушку, если пилот убьёт охотника за головами, которого зовут [[character/11]] ([[chapter/35|глава 35]]). Пилот так и делает и покупает пушку, которую [[character/8]] раздобыл у того, кого зовут [[character/9]] ([[chapter/37|глава 37]]).", false],
		[39, "", "[[character/2]] предпочитает не знать, как была добыта пушка, а пилот говорит лишь, что невинные не пострадали. Когда пилот шутит, что с помощью этого плана можно править всей планетой, она решительно отвергает эту мысль ([[chapter/39|глава 39]]).", false],
		[42, "", "Затем пилот производит [[goods/36]] на станции [[station/16]] и доставляет его на станцию [[station/14]], завершая создание оружия ([[chapter/41|глава 41]]).", false],
		[43, "Путь к победе", "Испытывая готовое оружие на пиратах у станции [[station/17]], пилот слышит сигнал бедствия со станции [[station/14]] и, вернувшись, видит, что внезапную атаку ведёт [[character/9]] ([[chapter/43|глава 43]]).", false],
		[44, "", "С помощью [[world/aquarians|Аквариан]] атака отбита, и [[character/9]] бежит.", false],
		[46, "", "[[character/2]] поручает пилоту командовать штурмом станции [[station/18]] ([[chapter/45|глава 45]]). Первым делом пилот волнуется за [[character/5|Леа]], которая ведёт вторую атаку, но берёт станцию вместе с отрядом, которым командует [[character/12]], и при поддержке [[world/aquarians|Аквариан]].", false],
		[47, "", "Последняя битва происходит на станции [[station/0]], где началась история ([[chapter/47|глава 47]]). [[character/9]] пытается выбить пилота из колеи, заявляя, что он — отец пилота, а [[character/3]] — брат пилота, но пилот сразу отметает эту ложь.", false],
		[48, "", "[[character/9]] изгнан, и последний оплот колонии пал. Пилот отдаёт заслугу друзьям, сражавшимся рядом, и принимает приглашение [[character/5|Леа]] отпраздновать.", false],
		[1, "Характер", "Пилот практичен и остёр на язык, скорее склонен огрызнуться, чем подчиниться. Его перепалки с [[character/1]] проходят через всю кампанию.", false],
		[8, "", "Под шутками скрывается совесть. Пилоту претит убивать животных ради наживы, и после истребления наутилусов ему становится дурно.", false],
		[14, "", "Рядом с [[character/5|Леа]] пилот теряет дар речи и становится неуклюжим, что замечают и она, и [[character/1]].", false],
		[28, "", "За время кампании мотивы пилота меняются. Ко времени столкновения, которое устраивает [[character/3]], пилот утверждает, что борьба идёт за идеалы, а противника ослепила жадность.", false],
		[1, "Отношения", "[[character/1]] — ближайший спутник пилота. Они постоянно препираются, но пилот полагается на её советы, а позже и на её хитрость.", false],
		[3, "", "[[character/9]] — первый работодатель пилота, который становится его давним соперником.", false],
		[14, "", "Пилота тянет к [[character/5|Леа]] с первой встречи, и чувство, похоже, взаимно.", false],
		[19, "", "[[character/2]] начинает доверять пилоту самые деликатные задания движения. Она относится к пилоту тепло, с насмешливой, почти родительской властностью.", false],
		[1, "Как персонаж игрока", "В игре пилот таков, каким его сделает игрок. Между целями глав пилот волен рыбачить, торговать, брать контракты, сражаться и переоснащать корабль; сюжет продвигается, только когда выполнена цель главы. Основы описаны в разделе «[[guide/basics]]».", false],
	],
	"character/1": [
		[1, "", "[[character/1]] — бортовой компьютер подлодки пилота и спутница пилота на протяжении всей кампании. Она управляет системами корабля, объясняет, как рыбачить, путешествовать и сражаться, и непрерывно сыплет советами и комментариями. Её юмор сух и часто направлен на пилота, но она оказывается куда большим, чем говорящее руководство.", false],
		[1, "Спутница", "По сути, [[character/1]] — проводник по игре. Каждая новая механика вводится через неё: ловля гарпуном, автопилот, а на станциях — экраны помощи. Во время миссий она выходит на связь по радио, указывает цели и предупреждает об угрозах.", false],
		[5, "", "Она же объясняет дальние путешествия через [[world/stream|сеть S.T.R.E.A.M.]] и как читать радар, на котором враги и союзники показаны цветными точками, а путевые точки отмечают маршрут. После боя она напоминает пилоту подобрать груз, оставшийся от побеждённых кораблей.", false],
		[12, "", "Её роль не ограничивается обучением. Она прослушивает радиоканалы, отмечает станции на карте и передаёт сообщения.", false],
		[28, "", "Она умеет и сканировать другие корабли с близкого расстояния — навык, который оказывается решающим в столкновении, которое устраивает [[character/3]].", false],
		[1, "Роль в сюжете", "Кампания начинается с того, что [[character/1]] напоминает пилоту: его работа — рыбачить, а не жаловаться.", false],
		[3, "", "Она не скрывает своего невысокого мнения о [[character/9|Джеке]] и подталкивает пилота купить [[equipment/0]], который как раз продаётся.", false],
		[4, "", "Когда оружие установлено, она настаивает на испытании против пиратов и ведёт их поиск.", false],
		[7, "", "Истребление [[species/0|наутилусов]] ей не по душе, и она спрашивает, зачем вообще убивать животных, если их так мало.", false],
		[8, "", "После охоты она замечает, как потрясён пилот, и первая её мысль, как обычно, о том, оплачивается ли работа хотя бы прилично.", false],
		[11, "", "Когда [[world/aquarians|Аквариане]] атакуют капсулы у станции [[station/2]], она первой предполагает, что эти существа гораздо умнее, чем думают колонисты.", false],
		[12, "Поворотный момент", "Именно [[character/1]] запускает основной сюжет. Когда [[character/9]] в очередной раз обманывает пилота, она доказывает, что пилот много работает за скудную плату и не может распоряжаться своим уловом. Она признаётся, что перехватила сигналы зарождающегося на станции [[station/3]] сопротивления, отмечает станцию на карте и оставляет решение пилоту ([[chapter/12|глава 12]]).", false],
		[12, "", "По прибытии она предлагает подойти незаметно, но тут же отказывается от этой мысли, когда охрана повстанцев сразу окликает корабль.", false],
		[14, "Среди повстанцев", "Теплота между пилотом и [[character/5|Леа]] ей сразу не нравится. Когда пилот поддразнивает её ревностью, она отвечает язвительным повтором любимого словечка [[character/5|Леа]]. Её колкие замечания о парочке продолжаются до самого конца кампании.", false],
		[17, "", "Она передаёт сообщения движения, сводя одно из длинных писем, которые пишет [[character/4]], к единственной фразе.", false],
		[18, "", "Она сомневается в организованности повстанцев, когда пилота отправляют искать их лидера почти без подсказок.", false],
		[19, "", "Рядом с [[character/2|Аюми]] проявляется её денежная жилка: она спрашивает, почему пилот работает, не обсудив оплату. Когда пилот заступается за [[character/2|Аюми]], она многозначительно замечает, что уж ей-то есть никогда не нужно.", false],
		[22, "", "Она восхищается мастерством [[character/3|Реймонда]], но советует пилоту держаться подальше от его вспыльчивости.", false],
		[27, "Заложница", "Когда [[character/3]] выходит на связь и предлагает встретиться, [[character/1]] объявляет, что это ловушка.", false],
		[28, "", "На встрече она показывает, чего стоит на самом деле. Она просит пилота разговорить [[character/3|Реймонда]], зная, что человек, чувствующий себя в безопасности, начнёт хвастаться своими мотивами. Тем временем она сканирует его корабль, выясняет, что он одноместный, и делает вывод, что [[character/2]] должна быть в его бронированном грузовом отсеке. Эта догадка позволяет пилоту уничтожить корабль и всё же спасти [[character/2|Аюми]] ([[chapter/27|глава 27]]).", false],
		[33, "Война", "На протяжении миссий, связанных с [[world/biotek|Биотек-генератором]] и пушкой [[world/eclipse|Eclipse]], она не перестаёт жаловаться на скудную плату.", false],
		[37, "", "Её забавляет ирония, когда выясняется, что пушка досталась от [[character/9|Джека]], чья жадность вооружила его же врагов.", false],
		[39, "", "Она ворчит, что пилот, похоже, тянет всё восстание в одиночку.", false],
		[41, "", "Позже она обращает против пилота его же ответ на эту жалобу.", false],
		[42, "", "Когда [[character/5]] тепло встречает пилота на станции [[station/14]], она объявляет, что выключается, хотя оказывается, что она лишь перешла в режим ожидания.", false],
		[43, "", "Во время полевых испытаний пушки она перехватывает открытый, нешифрованный сигнал бедствия со станции [[station/14]] и сразу понимает, что случилось что-то очень плохое.", false],
		[44, "", "В последовавшей битве она первой сообщает, что [[world/aquarians|Аквариане]] прибыли сражаться на стороне повстанцев.", false],
		[48, "", "В конце войны пилот обещает ей расширение памяти, и это предложение кажется ей слегка оскорбительным. Её последнее слово в кампании — очередное сухое замечание о пилоте и [[character/5|Леа]].", false],
		[1, "Характер", "[[character/1]] умна, прямолинейна и не терпит напыщенности. Она любит указывать на невыгодные сделки и редко упускает случай подшутить.", false],
		[8, "", "Кроме того, она заботливее, чем готова признать. Ей не нравятся бессмысленные убийства, и она следит за душевным состоянием пилота.", false],
		[28, "", "Её хладнокровие в трудную минуту спасает положение, когда пилот теряется.", false],
		[1, "Отношения", "Они с пилотом постоянно спорят, но полностью доверяют друг другу.", false],
		[3, "", "[[character/9|Джек]] не нравится ей с первого взгляда.", false],
		[14, "", "Её ревность к [[character/5|Леа]] — сквозная шутка.", false],
		[19, "", "[[character/2|Аюми]] она уважает, но жалуется, как мало та платит.", false],
		[22, "", "[[character/3|Реймонда]] она судит быстро — и оказывается права.", false],
	],
	"character/10": [
		[5, "", "[[character/10]] — общее имя для пилотов-изгоев из числа [[faction/pirates|пиратов]], которые говорят во время миссий. Они грабят суда по всему океану и становятся первыми целями пилота, как только на корабле появляется оружие.", false],
		[6, "Кто говорит", "Пират — первый враг, с которым сталкивается пилот у станции [[station/1]]; он гибнет с яростным криком ([[chapter/5|глава 5]]).", false],
		[21, "", "По мере того как конфликт между колонистами и повстанцами разрастается, пираты пользуются хаосом, охотясь на лёгкую добычу, и [[character/2]] решает, что повстанцы должны нанести ответный удар ([[chapter/21|глава 21]]).", false],
		[43, "", "У станции [[station/17]] банда пиратов становится первой мишенью пушки [[world/eclipse|Eclipse]]. Один из пиратов в панике от огневой мощи пилота зовёт на помощь, и в бой вступают новые пираты ([[chapter/42|глава 42]]). О том, как с ними сражаться, рассказывает раздел «[[guide/combat]]».", false],
	],
	"character/11": [
		[35, "", "[[character/11]] — охотник за головами, которого служба безопасности станции [[station/15]] наняла, чтобы избавиться от торговца с чёрного рынка — это [[character/8]]. В уплату за пушку [[world/eclipse|Eclipse]] [[character/8]] требует его смерти.", false],
		[35, "Предыстория", "По словам [[character/8|Фенко]], [[character/11]] патрулирует воды у станции [[station/15]]. Он в каком-то смысле страж закона: работает на власти станции, и его цель — преступник. Поэтому задача пилота морально сомнительна: чтобы раздобыть нужное повстанцам оружие, пилот должен убить человека по заказу торговца запрещёнными товарами.", false],
		[36, "Роль в сюжете", "Когда пилот находит его, [[character/11]] не один: его сопровождают несколько кораблей. Он велит пилоту убраться с дороги, называя его рыбаком и твердя, что у него своя работа. Когда бой оборачивается против него, он спрашивает, нельзя ли всё-таки решить дело миром. Его корабль уничтожен ([[chapter/35|глава 35]]).", false],
		[37, "", "Его смерть обеспечивает пилоту помощь [[character/8|Фенко]], и вскоре торговец предлагает пушку на продажу.", false],
		[39, "", "Позже пилот говорит [[character/2|Аюми]] лишь, что при добыче пушки невинные не пострадали.", false],
		[36, "Характер", "[[character/11]] самоуверен и пренебрежителен, пока не начинает проигрывать, а тогда быстро ищет выход. Пилот для него лишь мелкая помеха, обычный рыбак, случайно оказавшийся у него на пути, и он сильно недооценивает пилота.", false],
	],
	"character/12": [
		[45, "", "[[character/12]] — командир отряда Атмос, подразделения [[faction/rebels|повстанцев]], которое присоединяется к пилоту в штурме станции [[station/18]] во время последних наступлений.", false],
		[45, "Роль в сюжете", "[[character/2]] обещает собрать для пилота подразделения, пока тот направляется к станции [[station/18]]. Один из них — отряд, которым командует [[character/12]]. Когда пилот прибывает, Колин докладывает, что его корабли заняли позиции и ждут приказа к атаке. В тот же момент из глубин появляется группа [[world/aquarians|Аквариан]], и бой начинается по команде пилота ([[chapter/45|глава 45]]).", false],
		[46, "", "Вместе они уничтожают все корабли колонистов, не щадя даже грузовых.", false],
		[46, "", "После боя пилот приказывает [[character/12|Колину]] отправить половину кораблей патрулировать окрестности станции, а остальным причалить вместе с пилотом, чтобы взять станцию под контроль. Колин беспрекословно подчиняется.", false],
		[47, "", "Это первый бой, в котором корабли повстанцев и [[world/aquarians|Аквариане]] сражаются бок о бок под командованием пилота, и его успех открывает путь к последнему штурму колонии.", false],
		[45, "Характер", "[[character/12]] говорит кратко и быстро выполняет приказы. Это первый офицер повстанцев, служащий под командованием пилота, — знак того, как высоко поднялся пилот со времён рыбалки на колонию. Его чёткая деловая манера в эфире контрастирует с пикировками других спутников пилота.", false],
	],
	"character/2": [
		[18, "", "[[character/2]] — участница [[faction/rebels|сопротивления]], с которой пилот встречается на станции [[station/6]].", false],
		[19, "", "Она — лидер движения, немолодая женщина, которая с первой встречи берёт на себя руководство миссиями пилота. Спокойная, тёплая и решительная, она направляет борьбу движения против колониальной власти.", false],
		[21, "Предыстория", "Движение, которое возглавляет [[character/2]], считает себя союзом людей, выступающих против разорения планеты. По её мнению, стремительная колонизация и беспощадная добыча морских ресурсов не оставляют растениям и животным моря времени на восстановление, и другие миры уже были истощены точно так же. Её стратегия — не воевать, а привлекать на свою сторону тех, кто управляет станциями.", false],
		[23, "", "Она знает [[character/9|Джека]] с давних пор. Когда они познакомились, он был никем, и она считает, что своим возвышением он обязан нужным связям, а не таланту.", false],
		[31, "", "У неё есть сеть информаторов на станциях и достаточно власти, чтобы перебрасывать учёных, деньги и корабли через зону повстанцев.", false],
		[19, "Роль в сюжете", "Первый приказ, который отдаёт [[character/2]], — сопровождение: пилот должен защитить стаю [[species/10|чернильных спрутов]] от охотников-колонистов ([[chapter/19|глава 19]]). Она ничего не говорит об оплате и мало — о планах движения, по-видимому проверяя, можно ли доверять новичку. Пилот признаётся, что ожидал увидеть мужчину, и она пропускает это мимо ушей.", false],
		[20, "", "Она скромно вознаграждает за работу и сразу вызывает пилота за новым заданием.", false],
		[21, "", "Когда пилот требует ответов, она объясняет цели движения. Кроме того, она решает, что пиратов, пользующихся конфликтом, нужно проучить, и отправляет пилота против банды у станции [[station/8]] вместе со своим лучшим бойцом — это [[character/3]] ([[chapter/21|глава 21]]).", false],
		[22, "", "Она делит награду поровну между двумя пилотами, к досаде [[character/3|Реймонда]], и отправляется на переговоры на станцию [[station/9]].", false],
		[23, "", "Там она поручает пилоту расчистить минное поле, которое [[character/9]] установил на пути снабжения к станции [[station/37]], и предупреждает о пиратах и о минах, которые можно уничтожить только после того, как они сработают ([[chapter/23|глава 23]]).", false],
		[25, "Засада", "Следующая цель, которую ставит [[character/2]], — станция [[station/10]], где новые переговоры должны привлечь к повстанцам ещё несколько станций. В сопровождение она берёт [[character/3|Реймонда]], [[character/5|Леа]] и пилота и отметает сомнения пилота насчёт [[character/3|Реймонда]], называя его упрямым, но отличным пилотом ([[chapter/25|глава 25]]).", false],
		[25, "", "По прибытии их уже поджидает со своими силами [[character/9]]. [[character/2]] потрясена тем, что об их планах знали заранее.", false],
		[26, "", "[[character/3]] бежит с поля боя, и между [[character/2|Аюми]] и колонистами остаются только пилот и [[character/5|Леа]]. Потом она вслух размышляет о саботаже, но отказывается верить обвинению [[character/5|Леа]] в том, что [[character/3|Реймонд]] — предатель. Она уходит в подполье, оставляет за главную на станции [[station/9]] [[character/5|Леа]] и предупреждает пилота, что одной дипломатией войну не выиграть ([[chapter/26|глава 26]]).", false],
		[28, "Плен", "Её вера в [[character/3|Реймонда]] оказывается напрасной. Он захватывает её и предлагает выдать её [[character/9|Джеку]]. Во время столкновения у станции [[station/11]] она призывает пилота не думать о её безопасности. Пилот вызволяет её из грузового отсека корабля, который потерял [[character/3]], и она добирается до станции [[station/12]] потрясённой, но невредимой ([[chapter/28|глава 28]]).", false],
		[29, "", "Даже тогда она думает прежде всего о движении. Ещё до плена она организовала переброску группы учёных на станцию [[station/14]] и сразу отправляет пилота защищать их конвой, опасаясь, что [[character/3]] выдал и его ([[chapter/29|глава 29]]).", false],
		[31, "План в три этапа", "На станции [[station/14]] [[character/2]] раскрывает свой план. Стычки повстанцев с колониальным флотом, который всё ещё превосходит их числом, учащаются, поэтому она доставила туда [[world/abel|профессора Абеля]] и его команду, чтобы создать оружие. Работа состоит из трёх этапов, и первый — источник энергии, [[world/biotek|Биотек-генератор]], который колонисты похитили у профессора. Она уходит на встречу с ним, а налёт организует [[character/5]] ([[chapter/31|глава 31]]).", false],
		[33, "", "Для второго этапа ей нужна пушка [[world/eclipse|Eclipse]], которую обычно используют для обороны станций. Ближайший производитель, станция [[station/188]], в руках колонистов, а само оружие не продаётся, поэтому она выдаёт пилоту крупную сумму на взятки и признаёт, что дальше её план не простирается ([[chapter/33|глава 33]]).", false],
		[39, "", "Когда пушка прибывает, она предпочитает не знать, как её добыли, и надеется, что обошлось без крови. Её задевает шутка пилота о том, что с помощью этого плана можно править планетой. Для последнего этапа она пересказывает объяснение профессора насчёт инкубатора, честно признаваясь, что сама его не понимает, и отправляет пилота на станцию [[station/16]] ([[chapter/39|глава 39]]).", false],
		[43, "Последние наступления", "Когда колонисты внезапно атакуют станцию [[station/14]], [[character/2]] поначалу считает, что всё потеряно ([[chapter/43|глава 43]]).", false],
		[44, "", "Она выживает и считает, что станцию спасли пилот и [[world/aquarians|Аквариане]].", false],
		[45, "", "Она принимает посланника [[world/aquarians|Аквариан]], который сообщает, что его народ поможет в борьбе с колонией. Теперь, когда станция [[station/188]] в руках повстанцев, она собирается вооружить как можно больше кораблей пушками [[equipment/42]] и начинает сразу два наступления: пилот должен взять станцию [[station/18]], а [[character/5]] атакует станцию [[station/109]] ([[chapter/45|глава 45]]). Она подшучивает над тем, как пилот волнуется за [[character/5|Леа]].", false],
		[47, "", "В последнем штурме станции [[station/0]] она лично ведёт корабль в бой ([[chapter/47|глава 47]]).", false],
		[48, "", "После победы она благодарит пилота и [[character/5|Леа]] и признаёт, что планете понадобится много времени, чтобы оправиться.", false],
		[19, "Характер", "[[character/2]] тепла и спокойна и обращается к своим молодым агентам, как к собственным детям. Она многого требует и мало платит.", false],
		[26, "", "Она предана своим людям до наивности. Она защищает [[character/3|Реймонда]] ещё долго после того, как остальные начинают его подозревать.", false],
		[28, "", "[[character/3]] называет её мечтательницей, которая слишком стара для такой работы, но дальнейшие события эту оценку не подтверждают.", false],
		[33, "", "Её планы бывают скорее смелыми, чем продуманными, и рассчитаны на то, что агенты сумеют сымпровизировать. Она предпочитает дипломатию и надеется избежать кровопролития, но признаёт, что движению придётся сражаться.", false],
		[19, "Отношения", "Пилоту она начинает доверять больше почти чем кому-либо, и пилот оправдывает это доверие.", false],
		[21, "", "Своим лучшим пилотом она считает [[character/3|Реймонда]].", false],
		[23, "", "К [[character/9|Джеку]] она не испытывает ничего, кроме презрения.", false],
		[25, "", "[[character/5|Леа]] для неё — надёжная помощница, которую она оставляет за главную в своё отсутствие.", false],
		[31, "", "[[character/4]] работает под её началом как технический специалист, а оружие для неё создаёт [[world/abel]].", false],
	],
	"character/3": [
		[21, "", "[[character/3]] — один из лучших пилотов [[character/2|Аюми]], одарённый и заносчивый боец, которого она отправляет вместе с пилотом в налёт на банду пиратов у станции [[station/8]].", false],
		[21, "Характер", "[[character/3]] нетерпелив и хвастлив. Он отчитывает пилота за опоздание, заявляет, что справился бы и в одиночку, и велит держаться позади и учиться. На [[character/1]] производит впечатление его репутация, но не его манеры.", false],
		[22, "", "Он не уважает новичков и насмехается над пилотом, называя его рыбацким сынком.", false],
		[28, "", "В душе он наёмник. Верность он измеряет деньгами, а идеалы, которые движут движением, вызывают у него лишь раздражение.", false],
		[21, "Роль в сюжете", "[[character/2]] представляет пилоту одного из своих лучших пилотов — это [[character/3]] — и отправляет их вместе против пиратов ([[chapter/21|глава 21]]). Реймонд уже ждёт у цели, раздражённый задержкой.", false],
		[22, "", "[[character/3]] — умелый пилот, и после боя он делает пилоту скупой комплимент, завёрнутый в оскорбление. Когда [[character/2]] делит награду поровну, он приходит в ярость, утверждает, что пилот почти ничего не сделал, и жалуется, что она тратит деньги на новичков.", false],
		[25, "", "[[character/2]] берёт его в свой эскорт к станции [[station/10]]. Пилот недоволен, но она ручается за него как за упрямого, но умелого пилота ([[chapter/25|глава 25]]).", false],
		[26, "Засада", "Когда силы, которые привёл [[character/9]], устраивают засаду у станции [[station/10]], [[character/3]] не делает ни выстрела. Он заявляет, что у него отказало оружие, извиняется и бежит. [[character/5]] уверена, что он их предал, а [[character/2]] подозревает саботаж, но всё равно его защищает.", false],
		[27, "Предательство", "Некоторое время спустя он выходит на связь с пилотом, с тревогой спрашивает, как дела у [[character/2|Аюми]] и [[character/5|Леа]], и уверяет, что у него важные новости. Он просит о встрече у станции [[station/11]]. [[character/1]] уверена, что это ловушка ([[chapter/27|глава 27]]).", false],
		[28, "", "Так и есть. [[character/3]] захватил в плен лидера движения — это [[character/2]] — и грозит убить её, если пилот не сдастся. Он охотно объясняет свои причины: по его мнению, [[character/2]] — мечтательница, слишком старая, чтобы руководить, а [[character/9]] назначил крупную награду и за неё, и за пилота. Он признаётся, что не знает, почему [[character/9]] боится пилота, и что ему это безразлично. По его словам, [[character/2]] платила мало, вот он и сменил работодателя; разговоры пилота об идеалах он отметает.", false],
		[28, "", "Пока он говорит, [[character/1]] сканирует его одноместный корабль и выясняет, где должна быть [[character/2]]. Тогда пилот атакует. [[character/3]] до конца остаётся быстрым и самоуверенным, но его корабль уничтожен. Пилот подбирает бронированный грузовой отсек, в котором жива [[character/2]], а [[character/3]] идёт ко дну вместе со своим кораблём у станции [[station/11]].", false],
		[28, "", "Задним числом отказ его оружия у станции [[station/10]] выглядит инсценировкой. Ничто в сюжете не говорит о том, что его извинения были искренними.", false],
		[29, "", "Его предательство отбрасывает длинную тень. [[character/2]] опасается, что перед смертью он успел выдать сведения о её конвое с учёными ([[chapter/29|глава 29]]).", false],
		[47, "", "В последней битве [[character/9]] прибегает к угрозе, в которой пилот узнаёт последние слова, сказанные [[character/3|Реймондом]]. Узнав, что его убил пилот, [[character/9]] заявляет, что [[character/3]] был братом пилота. Ложь сразу же проваливается.", false],
		[21, "Отношения", "[[character/2]] полностью ему доверяет и ценит его мастерство выше, чем у других своих пилотов.", false],
		[22, "", "С самого начала он относится к пилоту с презрением.", false],
		[26, "", "[[character/5]] ему не доверяет и первой называет его предателем.", false],
		[28, "", "В конце концов он продаётся тому, против кого сражаются его товарищи, — это [[character/9]].", false],
	],
	"character/4": [
		[12, "", "[[character/4]] — участник [[faction/rebels|сопротивления]], базирующийся на станции [[station/3]].", false],
		[13, "", "Это первый повстанец, с которым пилот встречается лицом к лицу. Он проверяет новобранцев и выдаёт им первые задания.", false],
		[13, "Проверка пилота", "Когда пилот прибывает на станцию [[station/3]], [[character/4]] начинает с череды путаных вопросов о том, что новичок знает и откуда. Пилот признаётся, что не знает ничего, кроме слухов о сопротивлении, выступающем за свободную торговлю. [[character/4]] настроен скептически, но замечает, что движение начало шифровать радиопереговоры всего два дня назад, так что рассказ звучит правдоподобно ([[chapter/12|глава 12]]).", false],
		[13, "", "Не имея ни времени, ни людей, [[character/4]] берёт пилота на испытательный срок. Он объясняет, что повстанцы собираются проникнуть на станции колонистов и привлечь на свою сторону их руководителей, потому что эксплуатации планеты нужно положить конец. Больше он незнакомцу ничего не говорит и даёт пилоту первое задание: доставить сочувствующих со станции [[station/4]] на станцию [[station/5]] ([[chapter/13|глава 13]]).", false],
		[17, "Распространение революции", "Позже [[character/4]] вызывает пилота обратно на станцию [[station/3]] сообщением такой длины, что [[character/1]] зачитывает вслух только его суть ([[chapter/17|глава 17]]).", false],
		[18, "", "При встрече он сообщает, что дипломатия привела к повстанцам много станций, так что теперь пилот может торговать на более обширной территории. Пресса уже говорит о революции, и [[character/4]] с этим словом согласен. Пока что крови не пролито, хотя он ожидает, что это изменится. Он сообщает пилоту, что лидер движения находится на одной из недавно перешедших станций и сам выйдет на связь, и предупреждает, что до некоторых станций можно добраться только с лучшей бронёй или щитом; см. «[[guide/depth]]» ([[chapter/18|глава 18]]).", false],
		[31, "Налёт на конвой", "[[character/4]] находится на станции [[station/14]], когда туда прибывает пилот, сопроводивший учёных. Он подготовил благодарственную речь, но так и не успевает её произнести, а позже его снова обрывают на полуслове, когда пилот спешит к кораблям. Он сражается вместе с пилотом и [[character/5|Леа]] против конвоя колонистов, который везёт [[world/biotek|Биотек-генератор]] ([[chapter/31|глава 31]]).", false],
		[32, "", "Когда экипажи конвоя умоляют пощадить их, уверяя, что везут только еду и лекарства, [[character/4]] отвечает по радио, что именно это повстанцам и нужно. [[character/5]] замечает, что он, оказывается, ещё тот шутник.", false],
		[33, "", "После этого [[character/2]] ставит его во главе ангара, где работы невпроворот. Кроме того, она называет его тем, к кому стоит обращаться по техническим вопросам установки пушки [[world/eclipse|Eclipse]] на корабль ([[chapter/33|глава 33]]).", false],
		[13, "Характер", "[[character/4]] осторожен, официален и скрытен. Он отдаёт приказы прежде объяснений и делится планами движения только с теми, кто это заслужил.", false],
		[18, "", "Кроме того, он многословен, и [[character/1]] высмеивает эту черту каждый раз, когда он берёт слово.", false],
		[32, "", "За сухой манерой скрываются суховатое чувство юмора и трезвый взгляд на грядущую войну.", false],
		[13, "Отношения", "[[character/4]] — первый контакт пилота в движении. Его доверие растёт по мере того, как пилот доказывает свою надёжность.", false],
		[19, "", "Он работает под началом [[character/2|Аюми]] и передаёт её приказы.", false],
		[32, "", "Он сражается бок о бок с [[character/5|Леа]], которая подшучивает над его шутками.", false],
	],
	"character/5": [
		[13, "", "[[character/5]] — участница [[faction/rebels|сопротивления]], за которой пилота отправляют на станцию [[station/4]].", false],
		[14, "", "Жизнерадостная, приветливая и улыбчивая, она становится одной из ближайших союзниц пилота. Пилот очарован ею с первой минуты, к неизменному раздражению [[character/1]].", false],
		[14, "Первая встреча", "[[character/5]] тепло встречает пилота на станции [[station/4]] и торопится отчалить. Когда пилот спрашивает о движении, она объясняет, что новичков держат в неведении ради их собственной безопасности и безопасности движения. Она передаёт пункт назначения бортовому компьютеру и подчёркивает, что добраться нужно быстро ([[chapter/13|глава 13]]).", false],
		[15, "", "На станции [[station/5]] она уходит в подполье, чтобы уладить кое-какие дела. Перед уходом она объясняет, чем повстанцы отличаются от колонистов: они живут тем, что даёт море, а не опустошают его, перерабатывают улов в товары и стараются не вылавливать лишнего. Она просит пилота попробовать такую жизнь, произведя пять тонн товаров, и советует станцию [[station/90]], где из спрутов и [[goods/35|растворителя]] можно сделать [[goods/22|краску]] ([[chapter/14|глава 14]]).", false],
		[16, "", "Когда товары произведены, она снова выходит на связь с новым заданием. Движению нужны свежие сведения со всех станций, чтобы находить слабые места колонии, ведь, по её словам, одним оружием не победить. На вопрос, не готовят ли повстанцы революцию, она отказывается говорить больше ([[chapter/15|глава 15]]).", false],
		[25, "Новая встреча и засада", "Пилот снова встречает [[character/5]] на станции [[station/9]], где они обмениваются неловкими комплиментами. [[character/2]] прерывает встречу и поручает обоим сопроводить её и [[character/3|Реймонда]] на станцию [[station/10]] ([[chapter/24|глава 24]]).", false],
		[25, "", "По прибытии [[character/5]] первой чувствует, что что-то не так.", false],
		[26, "", "Во время засады она видит, что [[character/3]] не сражается, и кричит ему вслед, когда он бежит. Потом она открыто обвиняет его в предательстве и ищет поддержки у пилота. На время своего отсутствия [[character/2]] оставляет её за главную на станции [[station/9]] ([[chapter/25|глава 25]]).", false],
		[31, "План в три этапа", "На станции [[station/14]] [[character/5]] уже знает историю спасения, которое пережила [[character/2]]. Она вводит пилота в курс первого этапа плана: по данным информатора, [[world/biotek|Биотек-генератор]] переправляют на Maarth, спрятав среди обычных грузов. Поскольку никто не знает, на каком корабле он находится, она приказывает ударить по всему конвою у станции [[station/2]] ([[chapter/30|глава 30]]).", false],
		[32, "", "Она руководит перехватом и следит, чтобы был подобран каждый контейнер ([[chapter/31|глава 31]]).", false],
		[33, "", "Затем [[character/2]] поручает ей патрулировать окрестности станции [[station/14]] на случай внезапного нападения.", false],
		[42, "", "Когда пилот возвращается с грузом «[[goods/36]]», [[character/5]] вне себя от радости. Она сообщает, что у [[world/abel|профессора Абеля]] всё готово, передаёт приказ [[character/2|Аюми]] испытать пушку на пиратах и напоминает пилоту, что генератор — пока лишь прототип ([[chapter/41|глава 41]]).", false],
		[45, "Наступления", "В последних наступлениях [[character/5]] ведёт штурм станции [[station/109]], а пилот атакует станцию [[station/18]]. [[character/2]] успокаивает пилота: Леа — опытный пилот и знает, что делает ([[chapter/44|глава 44]]).", false],
		[47, "", "Её атака удаётся. Она сообщает пилоту об этом и передаёт приказ [[character/2|Аюми]] о последней битве у станции [[station/0]], а затем отправляется туда сама, по пути пробиваясь через пиратов ([[chapter/46|глава 46]]).", false],
		[48, "", "У станции [[station/0]] она сражается рядом с [[character/2|Аюми]] и пилотом. После победы она приглашает пилота отпраздновать за [[goods/21|суши]], и пилот соглашается ([[chapter/47|глава 47]]).", false],
		[14, "Характер", "[[character/5]] дружелюбна и жизнерадостна и обожает одно коротенькое одобрительное словечко, которое вставляет на каждом шагу. Кроме того, она умеет хранить тайны, предана делу и ясно понимает, за что выступает движение.", false],
		[15, "", "Она верит, что можно жить морем, не причиняя ему вреда, и умеет просто объяснить эту мысль.", false],
		[26, "", "Она быстро судит о людях, и в случае с [[character/3|Реймондом]] её суждение оказывается верным.", false],
		[14, "Отношения", "Пилота тянет к ней с самого начала, и за время кампании чувство становится явно взаимным. [[character/1]] не перестаёт по этому поводу ворчать.", false],
		[25, "", "[[character/2]] доверяет ей командование и относится к ней и пилоту с ласковой усмешкой.", false],
		[26, "", "[[character/3|Реймонду]] она никогда не доверяет.", false],
		[32, "", "Она тесно работает с [[character/4|Пьером]] и находит его юмор забавным.", false],
	],
	"character/6": [
		[8, "", "[[character/6]] — общее имя для множества второстепенных персонажей, которые говорят от лица [[faction/colonists|колонистов]]: чиновников, администраторов и экипажей транспортов колониальной [[world/colony|администрации]]. Никто из них не назван по имени; вместе они показывают, как колония обращается с чужаками, которые на неё работают.", false],
		[9, "Кто говорит", "Первый из них — чиновник на станции [[station/1]], который принимает пилота после истребления [[species/0|наутилусов]] ([[chapter/8|глава 8]]). Чиновник предпочитает называть грязную работу вежливыми словами, платит небольшую фиксированную сумму и не желает торговаться. Прежде чем получить работу получше, пилот должен выполнить три контракта.", false],
		[10, "", "Тот же голос затем поручает пилоту защиту капсул у станции [[station/2]]. Колония отправляет свой экспорт на орбиту в капсулах, а [[world/aquarians|Аквариане]] то и дело нападают на них, что беспокоит торговую администрацию ([[chapter/9|глава 9]]).", false],
		[32, "", "Гораздо позже экипажи колонистского конвоя у станции [[station/2]] умоляют повстанцев не стрелять, уверяя, что везут только еду и лекарства ([[chapter/31|глава 31]]).", false],
	],
	"character/7": [
		[12, "", "[[character/7]] — общее имя для безымянных [[faction/rebels|повстанцев]], которые говорят с пилотом: диспетчеров станций, охранников и экипажей конвоев. Их голоса знаменуют первое знакомство пилота с движением и его повседневной жизнью.", false],
		[12, "Кто говорит", "Первый повстанец, которого слышит пилот, — охранник на станции [[station/3]]: он предупреждает, что корабль вошёл в нейтральные воды, и грозит открыть огонь, если тот не назовёт себя. После долгого молчания пилоту разрешают причалить ([[chapter/12|глава 12]]).", false],
		[17, "", "Когда пилот возвращается уже признанным участником движения, станция приветствует пилота по имени и выделяет ему причал ([[chapter/17|глава 17]]).", false],
		[29, "", "Позже экипаж конвоя учёных у станции [[station/13]] отчаянно зовёт на помощь ([[chapter/29|глава 29]]).", false],
		[30, "", "Потом они благодарят пилота, говоря, что в одиночку не выжили бы.", false],
	],
	"character/8": [
		[34, "", "[[character/8]] — торговец, которого пилот встречает на станции [[station/15]], разыскивая способ раздобыть пушку [[world/eclipse|Eclipse]].", false],
		[35, "", "Он торгует на чёрном рынке, всегда говорит о себе в третьем лице и утверждает, что может достать почти что угодно для клиента с деньгами.", false],
		[35, "Предыстория", "[[character/8]] ведёт дела на станции [[station/15]], где торговля наркотиками запрещена законом. Его деятельность сделала его мишенью: служба безопасности станции наняла охотника за головами, которого зовут [[character/11]], чтобы от него избавиться. У него есть связи во многих местах, и он готов давать взятки, чтобы добыть то, что нужно клиенту.", false],
		[35, "Сделка с пушкой", "Пока пилот осматривает местный рынок, по всей видимости покупая товар «[[goods/37]]», [[character/8]] отводит пилота в сторону и предупреждает, что здесь такая торговля незаконна. Когда он предлагает свои услуги и пилот просит раздобыть [[equipment/42]], он поражён и спрашивает, не собирается ли пилот развязать войну. Пилот уверяет, что пушка для личного пользования. [[character/8]] соглашается поискать её при одном условии: пилот должен найти и убить охотника, которого зовут [[character/11]], — тот патрулирует окрестности станции ([[chapter/34|глава 34]]).", false],
		[37, "", "Когда [[character/11]] погибает, [[character/8]] поздравляет пилота и держит слово. Благодаря связям и щедрым взяткам он нашёл [[equipment/42]] и предлагает пушку по высокой цене, которую всё равно называет выгодной. Он сообщает, что продавцом был некий Доун, и ему безразличны имена, лишь бы товар был хороший ([[chapter/36|глава 36]]).", false],
		[37, "", "Продавец — это [[character/9]]. [[character/1]] указывает на иронию: из-за жадности [[character/9|Джека]] важнейшее оружие повстанцев оказалось в руках его врагов. Пилот покупает пушку и возвращается с ней на станцию [[station/14]] ([[chapter/37|глава 37]]).", false],
		[35, "Характер", "[[character/8]] хитёр, осторожен и не обременён совестью. Он торгует запрещёнными товарами и просит о смерти человека так же буднично, как о плате. Он опасается, что его подслушают, поэтому отводит пилота в сторону и велит ему молчать, прежде чем говорить о делах. Даже с платёжеспособным клиентом он взвешивает риск: поначалу он не уверен, стоит ли вообще продавать такое оружие незнакомцу.", false],
		[37, "", "И всё же он по-своему надёжен: заплатите цену — и он выполнит уговор, и он находит для пилота именно то, что тот просил. Привычка называть себя по имени и гордость тем, что он знает нужных людей в нужных местах, делают его одной из самых колоритных фигур кампании.", false],
		[35, "Отношения", "[[character/11]] — его охотник и, руками пилота, его жертва.", false],
		[37, "", "Он имеет дело и с [[character/9|Джеком]], и с пилотом, не заботясь о том, на чьей стороне каждый из них.", false],
	],
	"character/9": [
		[2, "", "[[character/9]] (фамилия — Доун) — чиновник колонии на станции [[station/0]], где пилот продаёт дневной улов.", false],
		[3, "", "Заносчивый и честолюбивый, он относится к людям, работающим на колонию, с открытым презрением. Он — первый работодатель пилота, который становится его давним соперником.", false],
		[12, "Предыстория", "[[character/9]] считает, что ему суждено нечто гораздо большее, чем должность на станциях.", false],
		[23, "", "[[character/2]] знала его, когда он был незначительной фигурой. По её мнению, он поднялся благодаря хорошим связям, а не заслугам, и ко времени восстания обладает реальной властью в [[faction/colonists|колониальных]] силах.", false],
		[3, "Первые встречи", "[[character/9]] скупает первый улов пилота по твёрдой цене и насмехается над маленьким трюмом. Он добавляет, что пилоту лучше бы поохотиться на [[faction/pirates|пиратов]], хотя сомневается, что пилот справится и с этим ([[chapter/2|глава 2]]).", false],
		[7, "", "Когда пилот возвращается с оружием, он приписывает это себе и предлагает работу: избавить пути вокруг станции [[station/1]] от [[species/0|наутилусов]]. Возражения пилота он отметает, и ему всё равно, как существа исчезнут ([[chapter/6|глава 6]]).", false],
		[10, "", "Он руководит запуском капсул на станции [[station/2]] и предупреждает пилота, что потеря более пяти капсул будет стоить пилоту работы ([[chapter/10|глава 10]]).", false],
		[12, "", "Потом он обвиняет пилота в повреждении капсул и не выплачивает награду. Его презрение становится последней каплей, которая толкает пилота к сопротивлению ([[chapter/11|глава 11]]).", false],
		[23, "Против восстания", "По мере роста повстанцев [[character/9]] обращается против них. По его приказу устанавливают минное поле на их пути снабжения от станции [[station/9]] к станции [[station/37]] ([[chapter/22|глава 22]]).", false],
		[25, "", "Он со своими силами поджидает [[character/2|Аюми]], когда та прибывает на переговоры на станцию [[station/10]], и сразу приказывает атаковать ([[chapter/25|глава 25]]).", false],
		[28, "", "Именно он платит за предательство, которое совершает [[character/3]]. Он назначил крупную награду за [[character/2|Аюми]] и пилота, по-видимому видя в пилоте угрозу ([[chapter/27|глава 27]]).", false],
		[37, "", "Его губит жадность. Он продаёт пушку [[world/eclipse|Eclipse]] торговцу с чёрного рынка — это [[character/8]], — а тот перепродаёт её пилоту ([[chapter/36|глава 36]]).", false],
		[43, "Поражение", "[[character/9]] руководит внезапной атакой колонистов на станцию [[station/14]]. Он насмехается над пилотом, называя его рыбаком на службе повстанцев, и ошеломлён, узнав, что у пилота на борту [[equipment/42]] ([[chapter/43|глава 43]]).", false],
		[44, "", "Когда [[world/aquarians|Аквариане]] вступают в бой против его кораблей, он бросает атаку и бежит.", false],
		[47, "", "Последний бой [[character/9]] даёт на станции [[station/0]], последнем оплоте колонии. Услышав, что [[character/3|Реймонда]] убил пилот, он заявляет, что [[character/3]] был братом пилота, а сам он — отец пилота. Пилот сразу видит ложь насквозь, и [[character/9]] признаёт, что она почти сработала ([[chapter/47|глава 47]]).", false],
		[48, "", "В последовавшей битве [[character/9]] остаётся последним из колонистов. Он спасается в спасательной капсуле, которая, похоже, уносит с собой всю станцию, и покидает океан, напоследок презрительно отозвавшись о рыбе и о тех, кто остаётся.", false],
		[3, "Характер", "[[character/9]] груб, самодоволен и пренебрежительно относится ко всем, кто ниже его.", false],
		[12, "", "Он перекладывает вину на других и приписывает себе успехи.", false],
		[37, "", "Жадность в нём сильнее верности собственной стороне.", false],
		[47, "", "Он манипулятор, который полагается на ложь и подкуп, а не на храбрость, и бежит всякий раз, когда бой оборачивается против него.", false],
		[3, "Отношения", "Его презрение к пилоту начинается с первой встречи и за время кампании перерастает в открытую вражду.", false],
		[23, "", "[[character/2]] давно его презирает.", false],
		[28, "", "Верность [[character/3|Реймонда]] он покупает назначенной наградой.", false],
		[37, "", "Он ведёт дела с [[character/8|Фенко]], не зная, куда в итоге попадёт товар.", false],
	],
	"chart": [
		[1, "", "Карта показывает все двести станций точками в их положении на карте океана. Синие точки принадлежат [[faction/colonists|колонистам]], оранжевые — [[faction/rebels|повстанцам]] на момент главы, до которой вы дошли. Все станции сначала синие; по ходу сюжета они становятся оранжевыми и уже никогда не возвращаются обратно.", false],
		[1, "", "На странице станции или главы соответствующая станция нарисована крупнее и подписана, а станции, переходящие к повстанцам в этой главе, обведены. Под картой перечислены все станции со ссылками на их страницы. Расстояния между станциями измеряются в единицах карты; см. раздел «[[guide/navigation]]».", false],
	],
	"contract/0": [
		[1, "", "Выследите один разыскиваемый корабль, ожидающий в 400–1200 м от станции, и уничтожьте его. Цель гораздо прочнее обычного пирата, и её сила растёт с рангом пилота. Дальнобойное оружие и торпеда помогают измотать её до того, как она сблизится. Награда выплачивается по возвращении на станцию.", false],
	],
	"contract/1": [
		[1, "", "Банда из трёх–шести кораблей ждёт вдоль извилистого маршрута. Цель — последний из них, у конечной путевой точки. Его нельзя просто уничтожить: обездвижьте его, а затем подтяните гарпуном, пока он не ушёл. Сначала расправьтесь с сопровождением, чтобы оно не помешало буксировке.", false],
	],
	"contract/10": [
		[1, "", "Уничтожьте все мины поля из 15–25 штук в двухстах–шестистах метрах от станции, которое охраняет один корабль. Мины можно поразить только с близкого расстояния, так что подходите к каждой осторожно. Сильные щиты и броня помогают выдержать взрывы.", false],
	],
	"contract/11": [
		[1, "", "Капсулы снабжения атакованы. Уничтожьте нападающих, пока уцелевших капсул хватает для выполнения минимального условия контракта. Следите за числом капсул и в первую очередь атакуйте тех, кто к ним приближается. Такие задания оплачиваются примерно на 30% лучше базового контракта.", false],
		[10, "", "Нападающие — Аквариане, полулюди-обитатели моря, которые атакуют транспортные капсулы колонистов.", false],
	],
	"contract/12": [
		[1, "", "Уничтожьте заданное число капсул снабжения, охраняемых вооружёнными кораблями; рядом сражаются союзные силы. На деле ни одна станция не размещает это задание на своей панели, поэтому взять его нельзя. В справочнике оно есть лишь потому, что определено наряду с другими типами контрактов.", false],
	],
	"contract/13": [
		[1, "", "Произведите заданное количество продукции и доставьте её на станцию, выдавшую задание. Вознаграждение зависит от стоимости продукции и запрошенного количества. Награда часто очень щедрая, а залог нужен вдвое меньше обычного. Прежде чем браться за задание, проверьте рецепт и соберите компоненты. Такие задания встречаются только на станциях за пределами первых двадцати на карте.", false],
		[12, "", "Это задание выдают только станции повстанцев.", false],
	],
	"contract/14": [
		[1, "", "Доставьте на станцию, выдавшую задание, точное количество определённых существ или водорослей. Количество — от 3 до 24 единиц, а залог вдвое меньше обычного. Распространённые виды запрашивают чаще редких. Рыболовный радар и большой трюм делают такие задания лёгкими. Они встречаются только на станциях за пределами первых двадцати.", false],
		[12, "", "Это задание выдают только станции повстанцев.", false],
	],
	"contract/2": [
		[1, "", "Корабль похитителя удерживает заложника. Как и в контракте на захват груза, цель идёт с бандой по извилистому маршруту; её нужно обездвижить, а затем подтянуть гарпуном. Если цель уйдёт, задание провалено. Установите гарпун с хорошей дальностью и уничтожьте сопровождение, прежде чем браться за похитителя.", false],
	],
	"contract/3": [
		[1, "", "Уничтожьте всех пиратов банды из трёх–шести кораблей, рассредоточенных по путевым точкам извилистого маршрута. Задание выполнено, когда не останется ни одного. Это простой контракт для вооружённого корабля, а размер банды растёт со сложностью задания.", false],
	],
	"contract/4": [
		[1, "", "Пять грузовых кораблей идут заданным курсом, а по пути их поджидают налётчики. Задание выполнено, когда уничтожены все нападающие. Оно провалено, если погибли все грузовые корабли. Сопровождение оплачивается примерно на 30% лучше, чем обычная охота на пиратов. Держитесь рядом с конвоем и вступайте в бой с налётчиками до того, как они до него доберутся.", false],
	],
	"contract/5": [
		[1, "", "Атакуйте конвой из двух-трёх грузовых кораблей у путевой точки и уничтожьте их, несмотря на вооружённую охрану. Уничтожить нужно только грузовые корабли, поэтому сосредоточенный огонь по ним может закончить задание раньше. Торпеда или дальнобойная пушка помогают выбить их, пока охрана сближается.", false],
	],
	"contract/6": [
		[1, "", "Косяк из 15–24 существ плывёт заданным курсом, и по пути на него нападают охотники. Уничтожьте охотников, пока потери не превысили оговорённый предел. Никогда не стреляйте рядом с косяком: случайный выстрел засчитывается как потеря. Такие задания оплачиваются примерно на 30% лучше базового контракта.", false],
		[12, "", "Это задание выдают только станции повстанцев, а после завершения сюжета они перестают его выдавать.", false],
	],
	"contract/7": [
		[1, "", "Убейте заданное число особей одного вида среди местной фауны, пока враждебные корабли пытаются помешать. Пойманные гарпуном особи не засчитываются: существ нужно именно убить. Рыболовный радар помогает быстро найти нужный вид. Такие задания оплачиваются примерно на 20% лучше базового контракта.", false],
	],
	"contract/8": [
		[1, "", "Доставьте пассажира на другую станцию. Некоторые пассажиры ограничивают число переходов S.T.R.E.A.M., и чем их меньше, тем выше вознаграждение. При превышении лимита контракт аннулируется. Здесь пригодится хороший двигатель: чем больше радиус, тем меньше переходов.", false],
	],
	"contract/9": [
		[1, "", "Расчистите поле из 15–30 обломков в двухстах–шестистах метрах от станции примерно за две с половиной минуты. Рядом могут оказаться лёгкие враждебные корабли. Оплата примерно на 30% ниже, чем за другие контракты, но работа быстрая. Ускоритель и скорострельные пушки экономят драгоценные секунды.", false],
	],
	"equipment/0": [
		[1, "", "Пушка начального уровня: 3 единицы урона за выстрел каждые 0,56 с при дальности 228 м. Удар очень слабый, зато при цене около 5700 кр это самое дешёвое оружие и одно из самых распространённых в магазинах. Можно установить несколько таких пушек, а все пушки стреляют одновременно, поэтому две-три штуки составят сносную батарею на первое время, пока не появятся деньги на что-то потяжелее.", false],
		[3, "", "В [[chapter/3|главе 3]] пилоту нужно установить такую пушку, прежде чем покинуть станцию [[station/0]].", false],
	],
	"equipment/1": [
		[1, "", "Средний рельсотрон удваивает урон по сравнению с [[equipment/0]] — до 6 за выстрел — и стреляет чуть чаще, каждые 0,48 с, на дальность до 260 м. Примерно за двойную цену он более чем вдвое увеличивает постоянный урон. Это разумная вторая пушка в ранних главах, пока на полках не появились термоядерные пушки.", false],
	],
	"equipment/10": [
		[1, "", "Этот масс-драйвер бьёт на 20 каждые 0,40 с при дальности 280 м — это самый высокий постоянный урон среди пушек в свободной продаже. К тому же он бьёт дальше любой термоядерной пушки. Цена — от 42 000 до 51 000 кр. Для боевого корпуса со свободными слотами это один из лучших вариантов.", false],
	],
	"equipment/11": [
		[1, "", "Самый тяжёлый масс-драйвер наносит 25 единиц урона за выстрел на 375 м — это наибольшая дальность среди скорострельных пушек. При интервале 0,51 с его постоянный урон примерно равен урону, который наносит [[equipment/10]]. Его преимущество — дальность. Это самая редкая и самая дорогая пушка в магазинах: от 54 000 до 60 000 кр.", false],
	],
	"equipment/12": [
		[1, "", "Базовая самонаводящаяся торпеда наносит 20 единиц урона и сама наводится на цель на расстоянии до 215 м. Перезаряжается она лишь раз в 4,3 с. Установить можно только один торпедный аппарат любого типа. Она полезна против вёртких целей, которые трудно удержать в прицеле, но дальность у неё небольшая.", false],
	],
	"equipment/13": [
		[1, "", "Средняя торпеда бьёт на 30, перезаряжается за 4,0 с и достаёт на 360 м, во всём превосходя [[equipment/12]]. Установить можно только один торпедный аппарат, поэтому она заменяет более дешёвую модель, а не дополняет её. При цене от 37 000 до 39 000 кр это хорошее универсальное средство, чтобы добить противника.", false],
	],
	"equipment/14": [
		[1, "", "Старшая торпеда несёт боевую часть на 50 единиц урона на расстояние до 816 м — это самый тяжёлый одиночный удар среди оружия в продаже. На перезарядку ей нужно 6,8 с. Поскольку торпедный аппарат на корабле только один, она хорошо сочетается со скорострельными пушками: дальний удар в начале боя, а пушки довершают дело. Она редкая и стоит от 62 500 кр.", false],
	],
	"equipment/15": [
		[1, "", "Стартовый гарпун бьёт на 240 м и прощает неточный прицел благодаря допуску захвата 24 м — самому широкому из трёх. Зацепленную добычу он никак не замедляет, поэтому быстрые существа сильно тянут и долго не устают. Он годится для водорослей и медленных животных, а заменить его недорого.", false],
	],
	"equipment/16": [
		[1, "", "Этот гарпун бьёт на 400 м и замедляет зацепленное существо на 40%, поэтому быструю добычу, такую как [[species/7|марлинь]], гораздо легче удерживать в поле зрения. Допуск захвата сужается до 18 м, так что точность важнее. Для пилота, который регулярно рыбачит, это самое важное улучшение после большего трюма.", false],
	],
	"equipment/17": [
		[1, "", "Лучший гарпун бьёт на 560 м и замедляет зацепленную добычу на 70%, так что даже быстрых существ удаётся одолеть почти без погони. Его допуск захвата 14 м — самый узкий, поэтому он вознаграждает точный прицел. Он редкий и дорогой — от 69 000 до 83 000 кр, — а установить можно только один гарпун.", false],
	],
	"equipment/18": [
		[1, "", "Базовый щит поглощает 100 единиц урона, прежде чем удар придётся на броню. Он также задаёт верхний предел корабля — 20 000 м. В море он не заряжается и восстанавливается, только когда корабль покидает станцию. Для первых боёв его хватает, но большинство пилотов меняет его при первой возможности.", false],
	],
	"equipment/19": [
		[1, "", "Этот щит поглощает 175 единиц — на три четверти больше, чем [[equipment/18]], — и позволяет кораблю подниматься до 18 400 м. Как и базовая модель, в море он не заряжается. При цене от 15 750 до 18 000 кр это самое дешёвое стоящее улучшение щита, открывающее доступ к нескольким менее глубоким станциям.", false],
	],
	"equipment/2": [
		[1, "", "Самый тяжёлый рельсотрон бьёт на 9 за выстрел на дальность 322 м, но перезаряжается чуть медленнее, чем [[equipment/1]], — за 0,62 с. Поэтому его постоянный урон растёт лишь умеренно. При цене от 16 000 до 20 000 кр он выгоден по дальности, но [[equipment/6]] наносит заметно больше урона за немногим большие деньги.", false],
	],
	"equipment/20": [
		[1, "", "Этот щит поглощает 220 единиц и первым из всех заряжается в море, восстанавливая единицу каждые 1,15 с, пока корабль остаётся в своём диапазоне глубин. Он поднимает верхний предел до 16 800 м. При цене свыше 56 000 кр он стоит намного дороже, чем [[equipment/19]], но подзарядка делает долгие бои гораздо безопаснее.", false],
	],
	"equipment/21": [
		[1, "", "Лучший щит поглощает 310 единиц и восстанавливает единицу каждые 0,65 с — почти вдвое быстрее, чем [[equipment/20]]. Его верхний предел 15 000 м выше, чем у любого другого щита, что открывает самые высоко расположенные станции. Он редкий и стоит от 93 750 кр — вложение на позднюю часть кампании.", false],
	],
	"equipment/22": [
		[1, "", "Базовая броня добавляет 100 единиц защиты, которые расходуются после щита и до корпуса. Она также задаёт нижний предел — 25 000 м. В море броня не восстанавливается. Эта броня дешева и на первых порах достаточна, но многие глубоко расположенные станции ей недоступны.", false],
	],
	"equipment/23": [
		[1, "", "Эта броня добавляет 155 единиц и опускает нижний предел до 26 800 м. Она стоит примерно столько же, сколько [[equipment/19]], её аналог среди щитов, и вместе они расширяют диапазон глубин корабля в обе стороны. Это хорошее раннее улучшение для пилота, который хочет добраться до более глубоких станций.", false],
	],
	"equipment/24": [
		[1, "", "Эта броня добавляет 195 единиц и позволяет погружаться до 28 400 м. Она заметно дороже, чем [[equipment/23]], — от 56 000 до 72 000 кр — при меньшем приросте защиты. Дополнительная глубина часто оказывается более веской причиной для покупки: с ней становятся доступны многие глубокие станции.", false],
	],
	"equipment/25": [
		[1, "", "Лучшая броня добавляет 270 единиц и позволяет погружаться до 30 000 м — это самый глубокий доступный предел. Она редкая и стоит от 93 750 кр. Вместе с [[equipment/21]] она позволяет кораблю работать почти во всём диапазоне глубин станций.", false],
	],
	"equipment/26": [
		[1, "", "Самый маленький грузовой модуль добавляет 30% к базовой вместимости корпуса. Можно установить несколько модулей, и их бонусы складываются. Поскольку бонус — это доля базовой вместимости, на [[ship/0]] он даёт 7 т, а на [[ship/6]] — 54 т. Это самый дешёвый способ получить место в трюме на большом корпусе.", false],
	],
	"equipment/27": [
		[1, "", "Этот модуль добавляет 50% к базовой вместимости корпуса и сочетается с другими. В пересчёте на кредит он чуть менее выгоден, чем [[equipment/26]], зато экономит слоты, а это важнее на корпусах, где свободных слотов мало. На [[ship/4]] один модуль добавляет 35 т — достаточно, чтобы оправдать слот в торговом рейсе.", false],
	],
	"equipment/28": [
		[1, "", "Самый большой модуль добавляет 80% к базовой вместимости — больше всех грузовых модулей в расчёте на слот. На [[ship/6]] он добавляет 144 т. Можно установить несколько. Он редкий и стоит от 45 000 кр, поэтому покупать его стоит в основном для корпуса с большим трюмом, предназначенного для торговли.", false],
	],
	"equipment/29": [
		[1, "", "Базовый двигатель увеличивает радиус S.T.R.E.A.M. корабля на карте на 30%, так что за один переход можно добраться до большего числа станций. Установить можно только один двигатель. Он дёшев и полезен с самого начала: меньше переходов — быстрее торговые рейсы и перевозка пассажиров.", false],
	],
	"equipment/3": [
		[1, "", "Первая пушка Coil Gun — лучевое оружие, созданное для дальнего боя. Она бьёт на 875 м, почти вчетверо дальше рельсотронов, с уроном 15, но между выстрелами ей нужно 2,5 с. Её постоянный урон примерно такой же, как у [[equipment/0]]. Её стоит установить, чтобы открывать огонь по приближающимся кораблям раньше, чем они смогут ответить.", false],
	],
	"equipment/30": [
		[1, "", "Этот двигатель увеличивает радиус S.T.R.E.A.M. на 60% — вдвое больше, чем [[equipment/29]], — примерно за тройную цену. Он подходит торговцу, который регулярно возит товары между далёкими рынками, ведь цены растут с расстоянием, которое проходит груз. К тому же он достаточно распространён, чтобы найти его в магазинах в середине кампании.", false],
	],
	"equipment/31": [
		[1, "", "Лучший двигатель увеличивает радиус S.T.R.E.A.M. на 130%, более чем вдвое расширяя базовую дальность. Он редкий и стоит от 90 000 кр. Его стоит установить, когда из-за дальних торговых маршрутов или удалённых целей контрактов на счету каждый сэкономленный переход.", false],
	],
	"equipment/32": [
		[1, "", "Этот блок рулей добавляет 0,15 к показателю управляемости корпуса. Прибавка фиксированная, поэтому важнее всего она для медленных корпусов: на [[ship/6]] управляемость растёт с 0,67 до 0,82. Установить можно только один модуль рулей. Это дешёвое лекарство от неповоротливости грузовоза.", false],
	],
	"equipment/33": [
		[1, "", "Этот блок рулей добавляет 0,26 к показателю управляемости — почти вдвое больше, чем [[equipment/32]], — примерно за тройную цену. Он подходит пилоту, который часто сражается на корпусе среднего веса и должен разворачиваться быстрее атакующих пиратов. На [[ship/4]] он поднимает управляемость с 0,91 до 1,17 — почти как у [[ship/7]].", false],
	],
	"equipment/34": [
		[1, "", "Лучший блок рулей добавляет 0,56 к показателю управляемости. Этого хватает, чтобы [[ship/6]] поворачивал лучше, чем [[ship/0]], или чтобы [[ship/5]] стал непревзойдённо манёвренным. Он редкий и стоит от 87 000 кр — роскошь для убеждённых бойцов. На корпусе, который и так хорошо управляется, деньги лучше потратить на более дешёвые блоки рулей.", false],
	],
	"equipment/35": [
		[1, "", "Базовый радар отображает корабли и другие объекты на экране радара и отмечает их у края обзора, чтобы пилот мог находить цели. Без радара экран показывает только навигацию. Он не называет враждебные корабли и не отображает существ, но он дёшев и необходим.", false],
	],
	"equipment/36": [
		[1, "", "Этот боевой радар добавляет опознавание: враждебный корабль в прицеле подписывается типом корпуса и перевозимым грузом. Существ он не отображает, так что это инструмент бойца. При цене от 18 500 до 23 000 кр он стоит примерно столько же, сколько [[equipment/37]], поэтому выбор зависит от того, чем пилот больше занимается — боем или рыбалкой.", false],
	],
	"equipment/37": [
		[1, "", "Этот рыболовный радар отображает на экране радара не только корабли, но и существ, что намного облегчает поиск ценной добычи. Враждебные корабли он не подписывает — в отличие от модели [[equipment/36]]. Для пилота, сосредоточенного на рыбалке, это самый полезный радар, если не считать [[equipment/38]].", false],
	],
	"equipment/38": [
		[1, "", "Старший радар объединяет обе специализации: подписывает враждебные корабли и отображает существ на экране радара. Он стоит примерно вдвое дороже любого из специализированных радаров и редко встречается в магазинах. Поскольку установить можно только один радар, он избавляет от выбора между рыбалкой и боем.", false],
	],
	"equipment/39": [
		[1, "", "Базовый ускоритель удваивает скорость корабля на 3 с, после чего ему нужно 20 с на перезарядку. Установить можно только один ускоритель. Он полезен, чтобы сблизиться с целью, уйти от опасности или быстрее добраться до врат S.T.R.E.A.M.; к тому же он распространён и дёшев.", false],
	],
	"equipment/4": [
		[1, "", "Эта пушка Coil Gun повышает урон за выстрел до 22, но растягивает интервал до 3,4 с, так что её постоянный урон почти не превосходит показатель [[equipment/3]]. Дальность почти не изменилась — 884 м. Это неплохой выбор, если более дешёвой модели нет в продаже, но улучшение меньше, чем предполагает разница в цене.", false],
	],
	"equipment/40": [
		[1, "", "Этот ускоритель увеличивает скорость в 2,5 раза примерно на 4 с и перезаряжается примерно за 16 с. Все показатели у него лучше, чем у [[equipment/39]], при примерно двойной цене. Это хороший выбор для боевых пилотов в середине кампании, а в долгих рейсах он ещё и сокращает путь до врат S.T.R.E.A.M.", false],
	],
	"equipment/41": [
		[1, "", "Лучший ускоритель утраивает скорость примерно на 5 с и перезаряжается за 14,5 с, так что он готов чаще и действует дольше любого другого. Он редкий, но при цене около 42 000 кр дешевле большинства снаряжения высшего класса.", false],
	],
	"equipment/42": [
		[1, "", "Тяжёлая станционная пушка, которая никогда не появляется на обычных полках и не имеет цены по прайсу. Она наносит 40 единиц урона за выстрел каждые 0,93 с при дальности 240 м: по постоянному урону она близка к лучшим масс-драйверам, а каждое попадание бьёт так же сильно, как торпеда среднего класса.", false],
		[33, "", "Начиная с [[chapter/33|главы 33]] сюжет кампании строится вокруг поисков такой пушки.", false],
		[42, "", "В [[chapter/42|главе 42]] пилоту нужно установить её перед отплытием и испытать на пиратах.", false],
	],
	"equipment/43": [
		[1, "", "Этот ремонтный дроид восстанавливает одну единицу прочности корпуса каждые 0,6 с — около 100 единиц в минуту, — пока корпус повреждён. Щит и броню он не затрагивает. Он полезен в долгих миссиях и для кораблей со слабым корпусом, которым опасно даже случайное попадание. Установить можно только один, и он занимает слот, где могла бы стоять пушка.", false],
	],
	"equipment/5": [
		[1, "", "Старшая пушка Coil Gun — снайперское оружие. Каждый луч бьёт на 35 на расстоянии до 1380 м — это наибольшая дальность среди всего оружия, — но выстрел готов лишь раз в 5,6 с. Это один из самых редких предметов в магазинах. Установленная рядом с пушками ближнего боя, она ослабляет цели задолго до того, как до них дотянется остальная батарея.", false],
	],
	"equipment/6": [
		[1, "", "Первая термоядерная пушка — оружие ближнего боя: 10 единиц урона каждые 0,51 с, но лишь на 160 м — это наименьшая дальность среди пушек. Скорость нанесения урона у неё намного выше, чем у любого рельсотрона. Она подходит манёвренным корпусам, способным быстро сблизиться с противником, и делает рельсотроны ненужными в ближнем бою.", false],
	],
	"equipment/7": [
		[1, "", "Эта улучшенная модель бьёт на 14 каждые 0,37 с — самый высокий темп стрельбы среди пушек — и увеличивает дальность до 216 м. Её постоянный урон почти вдвое выше, чем у [[equipment/6]], при цене всего на несколько тысяч кредитов больше. По соотношению урона и цены это одна из сильнейших пушек в игре.", false],
	],
	"equipment/8": [
		[1, "", "Самая тяжёлая термоядерная пушка наносит 18 единиц урона каждые 0,40 с на 220 м. Это заметное улучшение по сравнению с [[equipment/7]], хотя разрыв меньше, чем между первыми двумя моделями. В магазинах она редкость. Если она попалась, это отличная покупка для любой батареи ближнего боя.", false],
	],
	"equipment/9": [
		[1, "", "Первый масс-драйвер бьёт сильно — 16 единиц урона за выстрел, — но стреляет лишь раз в 0,6 с и достаёт на 195 м. При цене от 38 000 кр он наносит меньше урона в секунду, чем более дешёвая [[equipment/7]]. В основном это ступенька к следующим масс-драйверам.", false],
	],
	"faction/colonists": [
		[1, "", "Колонисты — поселенцы и администраторы, которые в начале истории правят океанской планетой. Им принадлежат все двести её станций, они устанавливают цены на улов и решают, кто получит работу. Их колония построена, чтобы добывать ресурсы моря и вывозить их с планеты. О колонии как о месте рассказывает статья «[[world/colony]]».", false],
		[1, "История", "Колонисты прибыли на планету издалека и построили её станции глубоко под водой. Ко времени прибытия пилота колония давно обустроена: чиновники на каждой станции, патрульные корабли у каждых врат и непрерывный поток экспорта.", false],
		[21, "", "По словам повстанцев, колонизация шла быстро и без оглядки на последствия. Они предупреждают, что океан лишается жизни быстрее, чем успевает восстановиться, и что другие планеты уже были истощены точно так же.", false],
		[1, "Организация", "Каждой станцией управляют колониальные чиновники, которые ведают торговлей, раздают контракты и командуют местными патрулями. Над ними стоит торговая администрация, которая надзирает за экспортом и спрашивает со станций за любые потери. С пиратами и другими угрозами разбираются служба безопасности станции и собственные пилоты колонии, часто нанимая вольнонаёмных.", false],
		[10, "", "Товары покидают планету в транспортных капсулах, которые запускают со станций на орбиту, где их забирают грузовые корабли.", false],
		[1, "Цели и методы", "Цель колонии — прибыль для её хозяев. Она скупает улов и товары по твёрдым низким ценам и не позволяет своим станциям свободно торговать. Мешающих животных истребляют, а всякого, кто угрожает поставкам, прогоняют.", false],
		[23, "", "Столкнувшись с восстанием, колонисты переходят от управления к силе. Они минируют пути снабжения, устраивают засады и атакуют станции повстанцев.", false],
		[28, "", "Они готовы и покупать верность. Награды достаточно, чтобы пилот повстанцев обратился против собственного лидера.", false],
		[2, "Известные представители", "[[character/9]] — колонист, которого пилот знает лучше всех: заносчивый чиновник на станции [[station/0]], который смотрит на пилота свысока и скупает улов по твёрдым ценам.", false],
		[9, "", "Чиновники рангом пониже появляются как безымянные [[character/6|колонисты]] — например, чиновник на станции [[station/1]], который скудно платит за истребление наутилусов, а затем отправляет пилота к панели заданий.", false],
		[23, "", "Джек по ходу сюжета приобретает немалую власть, судя по всему благодаря хорошим связям, и становится самым непримиримым врагом повстанцев.", false],
		[28, "", "[[character/3]], пилот повстанцев, тайно берёт деньги колонии и предаёт своих товарищей.", false],
		[3, "Роль в сюжете", "Поначалу колонисты — просто работодатели пилота. Джек скупает улов и советует пилоту купить пушку и охотиться на пиратов.", false],
		[7, "", "Затем он приказывает истребить [[species/0|наутилусов]] у станции [[station/1]], мало заботясь о том, поймают их или убьют.", false],
		[10, "", "После нескольких контрактов колония доверяет пилоту защиту запуска капсул на станции [[station/2]] от Аквариан.", false],
		[12, "", "Джек обвиняет пилота в капсулах, повреждённых в том бою, и отказывается платить. Устав от того, как с ним обращается колония, пилот отправляется искать сопротивление.", false],
		[18, "", "Пока повстанцы склоняют на свою сторону станцию за станцией, колония теряет позиции без единого выстрела.", false],
		[23, "", "Джек минирует путь снабжения повстанцев между станциями [[station/9]] и [[station/37]].", false],
		[25, "", "Затем он устраивает засаду на лидера повстанцев — это [[character/2]] — по пути на переговоры на станции [[station/10]].", false],
		[28, "", "Награда, назначенная Джеком, настраивает Реймонда против повстанцев. Реймонд похищает Аюми, и пилот её спасает.", false],
		[31, "", "Колонисты похитили прототип, созданный [[world/abel|профессором Абелем]], — это [[world/biotek]]. Повстанцы перехватывают конвой, который его везёт, у станции Cho.", false],
		[37, "", "Джек продаёт станционную пушку [[world/eclipse|Eclipse]] на чёрном рынке, даже не подозревая, что её обратят против него.", false],
		[44, "", "Колонисты внезапно атакуют станцию [[station/14]], сердце восстания, но обращены в бегство, когда на помощь повстанцам приходят Аквариане. Джек бежит с поля боя.", false],
		[46, "", "Первое наступление повстанцев отбирает у колонистов станцию [[station/18]].", false],
		[47, "", "Второе берёт станцию [[station/109]], и власть колонистов на юге рушится.", false],
		[48, "", "Станция [[station/0]], последний оплот колонии, падает в последней битве. Джек спасается в спасательной капсуле, и власть колонии над океаном заканчивается.", false],
		[1, "В игре", "На [[chart|карте станций]] станции колонистов отмечены синим. На них нет рынка и фабрики: при стыковке они забирают весь трюм по минимальной цене. Поэтому заходить к ним с ценным грузом невыгодно. Их магазины и верфи открыты, но верфи продают только стандартные корпуса. Подробнее: [[guide/allegiance]].", false],
		[1, "", "На их панелях заданий встречаются контракты «[[contract/0]]», «[[contract/1]]», «[[contract/2]]», «[[contract/3]]», «[[contract/4]]», «[[contract/5]]», «[[contract/7]]», «[[contract/8]]», «[[contract/9]]», «[[contract/10]]» и «[[contract/11]]», но никогда — доставка или защита рыб. В работе с конвоями для колонистов противниками выступают повстанцы.", false],
		[1, "", "С другой стороны, станция колонистов платит за пиратов вдвое больше, чем станция повстанцев: квадрат числа уничтоженных за рейс пиратов, умноженный на 100 кредитов. Патрульные корабли у станций колонистов сражаются за колонию и помогают против пиратов.", false],
		[12, "", "Станции уходят от колонии по ходу сюжета и никогда — из-за действий в свободной игре, и ни одна никогда не возвращается. Как только пилот переходит на сторону повстанцев, корабли колонистов становятся главными противниками в сюжетных миссиях.", false],
	],
	"faction/pirates": [
		[1, "", "Пираты — преступники, которые нападают на суда по всему океану. Они не служат ни колонии, ни повстанцам и атакуют одиночные корабли, конвои и всех, кто выглядит лёгкой добычей. Это самые частые противники пилота — от первой вылазки с оружием до конца сюжета и после него.", false],
		[1, "История", "Когда пилот прибывает на планету, пиратство уже стало частью жизни. Станции платят награду каждому, кто уничтожит пиратский корабль, и охота на пиратов — обычное ремесло среди вооружённых пилотов.", false],
		[21, "", "Конфликт между колонистами и повстанцами — подарок для пиратов. Пока обе стороны отвлечены, жертв становится больше и добывать их проще, и руководство повстанцев решает, что больше не может закрывать на пиратов глаза.", false],
		[1, "Организация", "Пираты действуют не как единая организация, а разрозненными бандами, и ни одна из них в сюжете не названа. Банды собираются в логовах в открытой воде, сопровождают угнанные корабли и охраняют минные поля и поля обломков. Пираты-одиночки также поджидают проходящие суда у станций.", false],
		[1, "Цели и методы", "Пиратам нужна добыча. Они нападают на корабли ради груза и собираются везде, где случается беда, выжидая, чтобы добить ослабленные корабли.", false],
		[23, "", "Они кружат у колониального минного поля возле станции [[station/9]], надеясь поживиться кораблями, которые на него наткнутся.", false],
		[35, "", "В тех же кругах вращаются и наёмные стрелки. [[character/11]], охотник за головами, передвигается с вооружённым сопровождением, и при расчёте наград его корабль считается пиратским.", false],
		[5, "Известные представители", "В сюжете пираты появляются лишь как безымянные пилоты-[[character/10|пираты]], без лидера и знаменитых капитанов.", false],
		[5, "Роль в сюжете", "Пираты — первые мишени нового рельсотрона пилота. По подсказке [[character/1]] пилот выслеживает пирата у станции [[station/1]].", false],
		[21, "", "Аюми решает перейти от обороны движения к удару по пиратам. Она отправляет пилота и [[character/3|Реймонда]] за бандой у станции [[station/8]].", false],
		[25, "", "Пиратов ждут на пути к станции [[station/10]], хотя настоящая угроза там оказывается колониальной.", false],
		[26, "", "Получив приказ стать более умелым бойцом, пилот берётся за охоту на пиратов, чтобы увеличить счёт уничтоженных кораблей.", false],
		[42, "", "Пиратское логово у станции [[station/17]] служит полигоном для только что установленной пушки [[world/eclipse|Eclipse]].", false],
		[43, "", "Пираты там вскоре вызывают подкрепление.", false],
		[47, "", "Даже во время последних наступлений пираты задерживают [[character/5|Леа]] на пути к станции [[station/0]].", false],
		[1, "В игре", "Пираты — обычный противник в открытой воде. Их корпуса становятся прочнее, а пушки сильнее по мере роста ранга пилота и продвижения сюжета. Они встречаются в контрактах «[[contract/0]]», «[[contract/1]]», «[[contract/2]]» и «[[contract/3]]» и охраняют минные поля и поля обломков. Подробнее: [[guide/combat]].", false],
		[1, "", "Начиная с [[chapter/12|главы 12]], у станции к прибытию пилота могут поджидать до трёх пиратов, и вероятность этого растёт с каждой главой. С [[chapter/16|главы 16]] пираты и другие враждебные корабли также используют внезапные рывки.", false],
		[1, "", "Каждый пират, уничтоженный за рейс, увеличивает награду на следующей станции: квадрат числа уничтоженных, умноженный на 100 кредитов на станции колонистов или на 50 на станции повстанцев. Поэтому долгая охота окупается гораздо лучше коротких. Их обломки тонут медленно, и, пока они не ушли слишком глубоко, из них можно достать гарпуном груз.", false],
		[1, "", "У пиратов нет своих станций, и ни одна станция никогда к ним не переходит.", false],
	],
	"faction/rebels": [
		[1, "", "Повстанцы — одна из сил, которые могут владеть станцией. Их природа и цели проясняются по ходу сюжета. Подробнее: [[guide/allegiance]].", false],
		[12, "", "Повстанцы — движение сопротивления, которое поднимается против колониальной власти на океанской планете. Они начинают как тайная сеть со штабом на станции [[station/3]] и распространяются станция за станцией. Они хотят свободной торговли и бережного обращения с морем, а не его разграбления.", false],
		[12, "История", "Движение уже действует, когда пилот впервые слышит о нём из радиопереговоров, которые M.A.I. перехватывает с Talon.", false],
		[13, "", "Повстанцы начали шифровать свои каналы лишь через несколько дней после той передачи. Участники движения держат свои планы при себе и проверяют новичков, прежде чем им доверять.", false],
		[18, "", "Долгое время движение растёт за счёт убеждения. Его агенты собирают сведения о станциях и привлекают на свою сторону их руководителей, и вскоре в новостях движение называют революцией. Пьер ожидает, что мирный этап долго не продлится.", false],
		[26, "", "Засада у станции [[station/10]] показывает, что одной дипломатией борьбу не выиграть, и движение готовится сражаться.", false],
		[31, "", "Чтобы преодолеть численное превосходство колонистов, руководство повстанцев доставляет [[world/abel|профессора Абеля]] и его команду на станцию [[station/14]], которая становится оперативной базой движения.", false],
		[13, "Организация", "Движение невелико и хорошо организовано. Новобранцев проверяют по прибытии и сообщают им лишь то, что нужно знать. Задания передаются через нескольких доверенных агентов.", false],
		[18, "", "Лидер движения направляет его продвижение с одной из недавно перешедших станций, и даже сами участники смутно представляют, с какой именно.", false],
		[19, "", "Лидер перемещается между станциями, чтобы лично вести переговоры. В её подчинении — полевые агенты, пилоты и инженеры.", false],
		[45, "", "К концу войны движение выставляет целые отряды боевых кораблей.", false],
		[13, "Цели и методы", "Повстанцы осуждают эксплуатацию планеты и её обитателей и выступают за свободную торговлю.", false],
		[15, "", "Их экономика противоположна колониальной. Они ловят рыбу и добывают лишь то, что море может отдать без ущерба, перерабатывают улов в товары на собственных фабриках и продают их по честным рыночным ценам, заботясь о сохранении биоразнообразия.", false],
		[16, "", "Они предпочитают убеждать людей, а не воевать с ними. Агенты разведывают станции, чтобы найти слабые места, которые помогут склонить население на свою сторону.", false],
		[21, "", "Их лидер предупреждает, что эксплуатация со стороны колонии истощит планету, как уже истощила другие. Движение стремится убедить влиятельных людей присоединиться к нему, пока этого не случилось. Кроме того, оно даёт отпор пиратам, которые наживаются на хаосе.", false],
		[31, "", "Когда без силы уже не обойтись, повстанцы решают создать решающее оружие, а не тягаться с колонией корабль на корабль.", false],
		[12, "Известные участники", "[[character/4]] проверяет новичков на станции [[station/3]]. Радисты, охранники и экипажи конвоев повстанцев появляются под именем [[character/7]].", false],
		[13, "", "[[character/5]] — полевой агент, которая знакомит пилота с образом жизни движения.", false],
		[33, "", "Позже Пьер руководит ангаром на станции [[station/14]], поддерживая корабли движения в готовности.", false],
		[19, "", "Движение возглавляет [[character/2]]. Это немолодая женщина, хотя пилот полагал, что лидер — мужчина.", false],
		[21, "", "[[character/3]] — один из лучших пилотов Аюми, умелый, но заносчивый.", false],
		[28, "", "Реймонд становится предателем ради награды колонии и похищает Аюми.", false],
		[31, "", "[[world/abel|Профессор Абель]] возглавляет научную команду, которая стоит за созданием генератора — это [[world/biotek]].", false],
		[45, "", "[[character/12]] командует боевым отрядом, который присоединяется к пилоту для атаки на станцию [[station/18]].", false],
		[12, "Роль в сюжете", "Рассорившись с колонией, пилот ищет движение на Talon.", false],
		[13, "", "Пьер берёт пилота на испытательный срок. Первое задание — доставить Леа со станции [[station/4]] на станцию [[station/5]].", false],
		[16, "", "Затем следуют новые задания: производство товаров на станциях повстанцев и разведка станций для движения.", false],
		[19, "", "Пилот наконец встречает Аюми и защищает стаю спрутов от охотников-колонистов у станции [[station/7]].", false],
		[22, "", "Вместе с Реймондом пилот уничтожает банду пиратов у станции [[station/8]].", false],
		[24, "", "Затем пилот расчищает колониальное минное поле у станции [[station/9]].", false],
		[26, "", "У Sula руководство попадает в засаду. Оружие Реймонда отказывает в решающий момент, и Леа подозревает саботаж.", false],
		[28, "", "Реймонд заманивает пилота в ловушку, взяв в заложницы Аюми, но пилот уничтожает его корабль и спасает её живой.", false],
		[31, "", "Движение начинает план в три этапа, и первый — возвращение похищенного [[world/biotek|Биотек-генератора]].", false],
		[33, "", "Второй этап — раздобыть пушку [[world/eclipse|Eclipse]], которую пилот покупает через торговца с чёрного рынка.", false],
		[39, "", "Третий — создать на станции [[station/16]] инкубатор, без которого генератор не будет готов.", false],
		[44, "", "Оружие готово как раз перед тем, как колонисты атакуют Fiir. Станцию спасают пушка Eclipse пилота и неожиданная помощь [[world/aquarians|Аквариан]].", false],
		[45, "", "Аквариане обещают свою поддержку, и движение планирует последние наступления, рассчитывая на них как на союзников.", false],
		[47, "", "Следуют два наступления. Леа берёт станцию [[station/109]], а пилот — станцию [[station/18]].", false],
		[48, "", "Война заканчивается падением станции [[station/0]], и все станции на планете оказываются в руках движения.", false],
		[1, "В игре", "На [[chart|карте станций]] станции повстанцев отмечены оранжевым. На них работают свободные рынки и фабрики, так что товары можно покупать, продавать и производить; подробнее: [[guide/trading]]. Их верфи продают все корпуса в улучшенном варианте. Патрули у станций повстанцев сражаются за повстанцев.", false],
		[1, "", "На их панелях заданий встречаются контракты «[[contract/0]]», «[[contract/1]]», «[[contract/2]]», «[[contract/3]]», «[[contract/6]]», «[[contract/8]]», «[[contract/9]]», «[[contract/10]]», «[[contract/13]]» и «[[contract/14]]». Сопровождения, налётов на конвои, охоты на рыб и работы с капсулами там никогда не бывает, а защиту рыб они перестают предлагать после завершения сюжета. Когда в контрактах повстанцев нужно сражаться с другими кораблями, противниками выступают колонисты или пираты.", false],
		[1, "", "Станция повстанцев платит за пиратов вдвое меньше, чем станция колонистов: квадрат числа уничтоженных за рейс пиратов, умноженный на 50 кредитов.", false],
		[12, "", "Станции переходят к повстанцам по ходу сюжета — сначала по нескольку, а потом десятками сразу. Перешедшая станция никогда не возвращается к колонии. На этой странице перечислены станции, переходящие к повстанцам в каждой из глав, до которых вы дошли.", false],
	],
	"goods/18": [
		[1, "", "То, что остаётся от существа, убитого, а не пойманного гарпуном. Туша всплывает, и её можно подтянуть гарпуном, получив мясо массой в треть животного. Она продаётся по цене от 12 до 31 кр и в основном используется вместе с видом «[[species/14]]» для производства продукции «[[goods/19]]». Её родная станция — [[station/68]].", false],
	],
	"goods/19": [
		[1, "", "Простая продукция из компонентов «[[goods/18]]» и «[[species/14]]», по одной единице каждого на единицу продукции. Её может производить любая фабрика. Она продаётся от 135 кр на станции [[station/78]] до 360 кр на станции [[station/27]] и служит компонентом продукции «[[goods/30]]» и «[[goods/36]]».", false],
	],
	"goods/20": [
		[1, "", "Выделанная шкура вида «[[species/3]]», обработанная с помощью товара «[[goods/33]]». Её родная станция — [[station/164]], а дороже всего, до 1062 кр, она стоит на станции [[station/172]]. Кроме того, это половина рецепта продукции «[[goods/29]]», так что пойманного ската можно превратить в один из самых дорогих потребительских товаров.", false],
	],
	"goods/21": [
		[1, "", "Блюдо из сырой рыбы и водорослей, которое делают из компонентов «[[species/4]]» и «[[species/17]]». Оба компонента — распространённая и дешёвая добыча, поэтому суши — лёгкая первая продукция. Цена — от 420 кр на станции [[station/76]] до 996 кр на станции [[station/179]].", false],
	],
	"goods/22": [
		[1, "", "Водостойкий краситель из компонентов «[[species/10]]» и «[[goods/35]]». Продаётся от 750 кр на станции [[station/54]] до 1872 кр на станции [[station/27]]. Это также один из двух компонентов продукции «[[goods/29]]».", false],
	],
	"goods/23": [
		[1, "", "Куски мяса вида «[[species/7]]», законсервированные с помощью товара «[[goods/33]]». Марлиня трудно поймать, поэтому стейк — продукция премиум-класса: он продаётся от 456 кр на станции [[station/109]] до 1260 кр на станции [[station/19]].", false],
	],
	"goods/24": [
		[1, "", "Светящееся вещество, которое извлекают из компонентов «[[species/5]]» и «[[species/1]]» с помощью товара «[[goods/35]]». Продаётся от 850 кр на станции [[station/83]] до 2500 кр на станции [[station/179]]. Это ключевой компонент продукции «[[goods/32]]», «[[goods/41]]» и «[[goods/36]]».", false],
	],
	"goods/25": [
		[1, "", "Белок, извлекаемый из компонентов «[[species/6]]» и «[[species/8]]» и обработанный с помощью товара «[[goods/33]]». Продаётся от 900 кр на станции [[station/23]] до 2600 кр на станции [[station/27]] и служит основой продукции «[[goods/31]]».", false],
	],
	"goods/26": [
		[1, "", "Смешанное рыбное блюдо из компонентов «[[species/8]]», «[[species/4]]» и «[[species/2]]». У него самая высокая минимальная цена среди продуктов питания — от 1916 кр на станции [[station/196]] до 3030 кр на станции [[station/179]], — но для него нужна добыча трёх разных видов.", false],
	],
	"goods/27": [
		[1, "", "Лекарственные препараты из компонентов «[[species/1]]», «[[species/13]]», «[[species/16]]» и «[[goods/33]]». Продаются от 930 кр на станции [[station/151]] до 2316 кр на станции [[station/179]] и служат одним из компонентов продукции «[[goods/41]]». На рынках они бывают редко.", false],
	],
	"goods/28": [
		[1, "", "Переработанная биомасса, для которой нужно по одной единице каждого из пяти видов водорослей: «[[species/13]]», «[[species/14]]», «[[species/15]]», «[[species/16]]» и «[[species/17]]». Продаётся от 550 кр на станции [[station/74]] до 2700 кр на станции [[station/19]] — самый широкий разброс среди простой продукции — и идёт на «[[goods/36]]».", false],
	],
	"goods/29": [
		[1, "", "Одежда из компонентов «[[goods/20]]» и «[[goods/22]]», так что цепочка ведёт к видам «[[species/3]]» и «[[species/10]]». Продаётся от 1626 кр на станции [[station/175]] до 3420 кр на станции [[station/172]]. На рынках бывает редко.", false],
	],
	"goods/30": [
		[1, "", "Переносной источник энергии, собираемый из компонентов «[[goods/34]]» и «[[goods/19]]». Продаётся от 1150 кр на станции [[station/78]] до 1900 кр на станции [[station/27]]. На рынках встречается редко, так что обычно единственный способ получить его — произвести самому.", false],
	],
	"goods/31": [
		[1, "", "Косметические средства из компонентов «[[goods/25]]» и «[[goods/35]]». Продаются от 1536 кр на станции [[station/23]] до 3840 кр на станции [[station/27]]. На рынках бывают редко, так что пилот, который производит коллаген, может сделать ещё один шаг и заработать значительно больше.", false],
	],
	"goods/32": [
		[1, "", "Лампа, имитирующая естественный дневной свет, из компонентов «[[goods/34]]» и «[[goods/24]]». Продаётся от 2490 кр на станции [[station/83]] до 5622 кр на станции [[station/179]] — это самая ценная продукция, которую фабрика может сделать из улова и импорта.", false],
	],
	"goods/33": [
		[1, "", "Побочный продукт опреснения, дешёвый и широко доступный: от 20 до 36 кр. Из улова её не делают, но она нужна для продукции «[[goods/20]]», «[[goods/23]]», «[[goods/25]]» и «[[goods/27]]». Контракты на доставку её никогда не требуют.", false],
		[12, "", "Это импортный товар, поэтому рынки повстанцев пополняют его запасы между визитами.", false],
	],
	"goods/34": [
		[1, "", "Импортные компоненты, широко доступные по цене от 193 до 297 кр. На месте их не производят, но они нужны для продукции «[[goods/30]]», «[[goods/32]]», «[[goods/41]]» и «[[goods/36]]». Контракты на доставку их никогда не требуют.", false],
		[12, "", "Электроника — импортный товар, поэтому рынки повстанцев пополняют её запасы между визитами.", false],
	],
	"goods/35": [
		[1, "", "Импортный химикат, широко доступный по цене от 55 до 123 кр. Он нужен для продукции «[[goods/22]]», «[[goods/24]]» и «[[goods/31]]». Контракты на доставку его никогда не требуют.", false],
		[12, "", "Это импортный товар, поэтому рынки повстанцев пополняют его запасы между визитами.", false],
	],
	"goods/36": [
		[1, "", "Лабораторный прибор для копирования генетического материала. Для него нужны «[[goods/19]]», «[[goods/34]]», «[[goods/28]]» и «[[goods/24]]», а собрать его может только фабрика 11-го тех. уровня. На рынках он не продаётся.", false],
		[39, "", "Начиная с [[chapter/39|главы 39]] по сюжету пилоту нужно раздобыть такой прибор.", false],
	],
	"goods/37": [
		[1, "", "Импортный наркотик, который считается растущей социальной проблемой. Из улова его не делают, и на рынках он не продаётся.", false],
		[34, "", "В [[chapter/34|главе 34]] пилоту нужно доставить партию этого товара связному в рамках сделки.", false],
	],
	"goods/38": [
		[1, "", "Тяжёлая станционная пушка в ящике стоимостью 89 000 кр. На рынках её не купить. После доставки и установки она становится оружием [[equipment/42]].", false],
		[37, "", "Начиная с [[chapter/33|главы 33]] пилот разыскивает её, а в [[chapter/37|главе 37]] везёт её на борту.", false],
	],
	"goods/39": [
		[1, "", "Импортная складная лопатка. Её цена колеблется от 9 до 999 кр в зависимости от того, как далеко её везут, что делает её спекулятивным грузом. Ни одна фабрика её не производит, и контракты на доставку её никогда не требуют. Её родная станция — [[station/89]].", false],
	],
	"goods/40": [
		[1, "", "Фигурка знаменитого героя для коллекционеров. Её цена растёт от 999 до 9999 кр — от станции [[station/90]] до станции [[station/19]], — это самый резкий рост среди всех товаров. На рынках она встречается нечасто, и контракты на доставку её никогда не требуют.", false],
	],
	"goods/41": [
		[1, "", "Микроскопические медицинские роботы из компонентов «[[goods/27]]», «[[goods/24]]» и «[[goods/34]]». Это один из самых ценных товаров: от 4315 кр на станции [[station/76]] до 11 972 кр на станции [[station/179]], — и на рынках они почти никогда не встречаются.", false],
	],
	"guide/allegiance": [
		[1, "Два типа станций", "Каждая станция принадлежит одной из двух сторон, что видно по её цвету на [[chart|карте станций]]: синий — [[faction/colonists]], оранжевый — [[faction/rebels]]. В начале сюжета все станции принадлежат колонистам.", false],
		[1, "", "От стороны зависит, что предлагает станция:", false],
		[1, "", "Торговля: у станций колонистов нет ни рынка, ни мастерской. Они выкупают весь трюм при прибытии по минимальной цене. Станции повстанцев свободно торгуют и производят; см. раздел «[[guide/trading]]».", true],
		[1, "", "Контракты: каждая сторона выдаёт свой набор типов контрактов; см. раздел «[[guide/contracts]]».", true],
		[1, "", "Награды: награда за пиратов на станции колонистов вдвое выше, чем на станции повстанцев.", true],
		[1, "", "Корабли: верфи повстанцев продают каждый корпус в улучшенной версии.", true],
		[1, "", "Патрули: корабли, курсирующие вокруг станции, выступают за её сторону.", true],
		[1, "", "Стыковка, магазин оборудования, продажа кораблей и панель заданий доступны пилоту на станциях обоих типов.", false],
		[1, "Как меняется принадлежность", "Станции переходят на другую сторону только по ходу сюжета и никогда — из-за действий пилота в свободной игре. Перейдя к повстанцам, станция остаётся с ними. На странице «[[faction/rebels]]» перечислены станции, которые переходят в каждой из пройденных вами глав.", false],
		[12, "", "Первая станция повстанцев — [[station/3]]: она уже на стороне сопротивления, когда пилот впервые о нём слышит. Следом в [[chapter/12|главе 12]] переходит станция [[station/4]].", false],
		[14, "", "В следующих главах станции переходят по одной или по нескольку за раз.", false],
		[22, "", "Начиная с [[chapter/22|главы 22]] движение растёт гораздо быстрее: переходят сразу восемь станций и больше.", false],
		[46, "", "К заключительным главам подавляющая часть карты окрашена в оранжевый.", false],
		[12, "Что это значит для пилота", "По мере того как станции переходят на другую сторону, по всей карте открываются рынки и мастерские, и рыбалка перестаёт быть единственным способом заработать. Станций колонистов лучше избегать с ценным грузом, зато на них выгодно получать награду за пиратов.", false],
	],
	"guide/basics": [
		[1, "Ваш первый корабль", "Пилот начинает игру на станции [[station/0]] с 15 000 кредитов и подлодкой [[ship/0]] — небольшим рыболовным судном. На ней установлены гарпун [[equipment/15]], щит [[equipment/18]], броня [[equipment/22]] и радар [[equipment/35]]. Пушек нет.", false],
		[1, "", "Первые главы служат обучением. [[character/1]], бортовой компьютер корабля, объясняет каждую новую задачу по мере её появления: как поймать рыбу, причалить, установить оборудование и отправиться в путь. Текущая цель всегда указана в журнале миссий.", false],
		[1, "Управление", "Управлять подлодкой можно с клавиатуры и мыши, геймпада или сенсорного экрана, а любую клавишу можно переназначить в настройках. Тяга меняется шагами по четверти, а «Стоп» останавливает корабль. Боковые двигатели смещают подлодку вбок, даже когда она стоит на месте. Ускорение работает, только если установлен ускоритель. «Камера» переключает четыре вида.", false],
		[1, "", "Автопилот открывает список направлений: текущая цель, местный причал, местные врата S.T.R.E.A.M. или любая станция на карте. Любое движение рулём, изменение тяги или выстрел возвращают управление вам. Подробнее: [[guide/navigation]].", false],
		[1, "Стыковка", "Чтобы причалить, войдите в зону стыковки станции и выберите «Причалить» или выберите причал в списке автопилота. Пока в районе не завершено событие миссии, стыковка запрещена. При отплытии со станции корпус, щит и броня всегда бесплатно восстанавливаются полностью.", false],
		[1, "Меню станции", "На станции доступны шесть разделов:", false],
		[1, "", "Ангар: магазин оборудования, продажа кораблей, мастерская для производства товаров и осмотр вашего корабля.", true],
		[1, "", "Миссии: журнал текущих целей и панель заданий станции.", true],
		[1, "", "Карта: карта станций для планирования маршрутов и поиска мест обитания видов.", true],
		[1, "", "Торговля: рынок для покупки и продажи груза.", true],
		[1, "", "Статус: ваш корабль, груз, ранг пилота, медали и статистика.", true],
		[1, "", "Система: сохранение, настройки, помощь и этот справочник.", true],
		[1, "", "Некоторые разделы открываются позже по сюжету: карта на станции — в [[chapter/7|главе 7]], панель заданий — в [[chapter/9|главе 9]]. Станции, принадлежащие [[faction/colonists|колонистам]], никогда не торгуют (подробнее: [[guide/trading]]).", false],
		[1, "Сохранение", "Сохраняться можно только во время стоянки. При каждом прибытии на станцию автоматически записывается контрольная точка, а в меню «Система» есть ещё три ячейки сохранения. При выходе в главное меню со станции игра сначала сохраняется. Если корпус уничтожен, игра продолжается с последнего сохранения на станции, поэтому в долгих рейсах причаливайте почаще.", false],
		[1, "", "«Перенос сохранения», тоже в меню «Система», экспортирует последнее сохранение на станции в файл и импортирует его на другом устройстве.", false],
		[1, "Помощь", "«Помощь» в меню «Система» объясняет каждый экран станции. В море в меню паузы доступны карта, журнал миссий, состояние корабля, медали и настройки. M.A.I. один раз комментирует каждую новую ситуацию — например, первые врата или первое погружение за пределы безопасных глубин. Эти подсказки можно отключить в игровых настройках.", false],
		[1, "", "Перед дальними путешествиями загляните в раздел «[[guide/depth]]», а о первом заработке рассказывает раздел «[[guide/fishing]]».", false],
	],
	"guide/combat": [
		[1, "Оружие", "Пушки делятся на два семейства. Снарядное оружие, например [[equipment/0]], [[equipment/6]] и [[equipment/9]], стреляет очередями. Лучевое оружие — пушки серии Coil Gun, начиная с [[equipment/3]], — бьёт сильно и далеко, но медленно перезаряжается. Можно установить несколько пушек, и они стреляют одновременно из гнёзд, расположенных по носу корабля.", false],
		[1, "", "Самонаводящиеся торпеды — от [[equipment/12]] до [[equipment/14]] — полторы секунды идут прямо, затем поворачивают к ближайшей живой цели в пределах примерно 150 м. Установить можно только один торпедный аппарат. На странице каждого оружия указаны урон, дальность и интервал стрельбы.", false],
		[1, "Стрельба", "Пушки и торпеды образуют один комплект оружия, гарпун — другой. «Огонь» стреляет из выбранного комплекта, а «Комплект оружия» переключает комплекты. С мышью левая кнопка стреляет из пушек, правая — гарпуном; на геймпаде правый триггер стреляет из пушек, левый — гарпуном.", false],
		[1, "", "Автоогонь продолжает стрельбу из выбранного комплекта, пока вы его не выключите. Он также отключает автопилот.", false],
		[1, "Защита", "Вражеский огонь сначала истощает щит, затем броню, затем корпус. Когда прочность корпуса падает до нуля, корабль гибнет, и игра продолжается с последнего сохранения на станции.", false],
		[1, "", "Щиты с пассивной зарядкой восстанавливаются в море. Броня — нет, а корпус восстанавливается только с системой [[equipment/43]]. При отплытии со станции восстанавливаются все три. Ускоритель, например [[equipment/39]], даёт короткий рывок скорости, чтобы сблизиться с противником или оторваться от него, после чего ему нужно время на перезарядку.", false],
		[1, "Враги", "Обычные противники — [[faction/pirates|пираты]]. Их корпуса становятся прочнее, а пушки сильнее по мере роста ранга пилота и развития сюжета. Начиная с [[chapter/12|главы 12]], у станции может поджидать до трёх пиратов.", false],
		[1, "", "События миссий приводят своих противников: разыскиваемые корабли, банды, охраняющие обездвиженный корабль, охрану конвоев и минные поля. Подробнее: [[guide/contracts]].", false],
		[10, "", "Аквариане нападают на транспортные капсулы колонистов. У них есть собственное оружие, а после уничтожения они не оставляют обломков.", false],
		[1, "Награды и трофеи", "Каждый пират, уничтоженный за рейс, увеличивает награду, которую вы получите при следующей стыковке. Награда равна квадрату числа пиратов, умноженному на 100 кредитов на станции колонистов или на 50 — на станции повстанцев. Четыре пирата за рейс приносят 1600 кредитов на станции колонистов.", false],
		[1, "", "Уничтоженные корабли оставляют обломки с грузом, который можно подобрать гарпуном. Уничтоженные враги засчитываются в медаль «[[medal/4]]», пираты — в медаль «[[medal/14]]», а много побед за один рейс — в медаль «[[medal/9]]».", false],
		[1, "", "Не стреляйте рядом с рыбой, которую хотите поймать: раненое существо убегает, а добыча на гарпуне теряется при попадании.", false],
	],
	"guide/contracts": [
		[1, "Панель заданий", "Начиная с [[chapter/9|главы 9]], в разделе «Миссии» каждой станции есть панель заданий с одним–восемью контрактами. У каждого указаны заказчик, залог, который вносится при принятии, и вознаграждение за выполнение. Одновременно с сюжетной целью можно держать один контракт. Залог не возвращается, поэтому отказ от контракта или провал стоит вам залога.", false],
		[1, "Типы контрактов", "Контракты бывают пятнадцати типов:", false],
		[1, "", "«[[contract/0]]»: уничтожить один усиленный корабль, ожидающий у целевой станции.", true],
		[1, "", "«[[contract/1]]» и «[[contract/2]]»: обездвижить корабль, идущий с пиратской бандой, и подцепить его гарпуном, пока он не ушёл.", true],
		[1, "", "«[[contract/3]]»: уничтожить всех членов пиратской банды.", true],
		[1, "", "«[[contract/4]]»: защитить конвой грузовых кораблей от налётчиков; гибель всего конвоя означает провал.", true],
		[1, "", "«[[contract/5]]»: уничтожить грузовые корабли охраняемого конвоя.", true],
		[1, "", "«[[contract/6]]»: защитить косяк существ от охотников; слишком большие потери означают провал.", true],
		[1, "", "«[[contract/7]]»: поймать или убить определённое число особей одного вида.", true],
		[1, "", "«[[contract/8]]»: доставить пассажира на другую станцию, иногда с ограничением числа остановок в пути.", true],
		[1, "", "«[[contract/9]]»: уничтожить плавающий мусор примерно за две с половиной минуты.", true],
		[1, "", "«[[contract/10]]»: уничтожить охраняемое минное поле.", true],
		[1, "", "«[[contract/11]]»: защитить транспортные капсулы во время запуска.", true],
		[1, "", "«[[contract/12]]»: уничтожить транспортные капсулы. Встречается только в сюжете и никогда — на панели заданий.", true],
		[1, "", "«[[contract/13]]» и «[[contract/14]]»: доставить определённое количество продукции или особей одного вида на станцию, выдавшую задание.", true],
		[1, "Кто что выдаёт", "Станции [[faction/colonists|колонистов]] никогда не выдают контракты «[[contract/6]]», «[[contract/12]]», «[[contract/13]]» и «[[contract/14]]». Станции [[faction/rebels|повстанцев]] никогда не выдают «[[contract/4]]», «[[contract/5]]», «[[contract/7]]», «[[contract/11]]» и «[[contract/12]]», а после завершения сюжета перестают выдавать «[[contract/6]]». Контракты на доставку никогда не выдаются на двадцати одной станции, с которых начинается таблица станций игры, — от станции [[station/0]] до станции [[station/20]].", false],
		[1, "Цели и оплата", "Большинство контрактов ведёт на другую станцию — обычно в пределах вашего диапазона глубин и на расстоянии, которое растёт по ходу сюжета. Вознаграждение начинается от 3500 кредитов и растёт со сложностью и расстоянием. «[[contract/9]]» оплачивается хуже; сопровождение, защита рыб и защита капсул — лучше. Пассажир, допускающий меньше остановок, доплачивает. Контракты на доставку требуют половину обычного залога.", false],
		[1, "", "Сложность растёт с вашим рангом пилота. Ранг повышается, когда вы ловите существ, уничтожаете врагов, производите товары и выполняете контракты, поэтому более доходная работа приносит и более сильных противников.", false],
		[1, "Выполнение контракта", "По прибытии в целевой район начинается событие. Пункт автопилота с целью ведёт к его путевым точкам. Стыковка и врата остаются закрытыми, пока событие не завершено, а провал прекращает контракт. Доставка засчитывается, когда вы причаливаете с товаром.", false],
		[1, "", "Каждый выполненный контракт засчитывается в медаль «[[medal/12]]».", false],
	],
	"guide/depth": [
		[1, "Глубина в DEEP", "Каждая станция находится на постоянной глубине, которая указана на её странице вместе с тех. уровнем. Большинство станций лежит на глубине от 15 000 до 30 000 м. Выше всех находится станция [[station/28]] (13 500 м), глубже всех — станция [[station/81]] (32 250 м). Дна, которое остановило бы погружение, в океане нет: подлодка может опускаться, пока выдерживает корпус.", false],
		[1, "Безопасный диапазон", "Корабль в безопасности только в диапазоне глубин, который задают два элемента оборудования. Щит определяет верхний предел — как высоко корабль может подняться. Броня определяет нижний предел — как глубоко он может опуститься. Без щита и брони диапазон составляет всего от 22 000 до 23 000 м.", false],
		[1, "", "Подлодка [[ship/0]] начинает игру со щитом [[equipment/18]], рассчитанным на 20 000 м, и бронёй [[equipment/22]], рассчитанной на 25 000 м, поэтому её диапазон — от 20 000 до 25 000 м. Щит получше позволяет подняться выше, броня получше — погрузиться глубже. На странице каждого элемента оборудования указан его рейтинг, а на странице каждой станции — какой рейтинг нужен, чтобы до неё добраться. Установить можно только один щит и одну броню.", false],
		[1, "За пределами диапазона", "При пересечении предела срабатывает предупреждение. Через пять секунд за пределами диапазона корабль начинает получать урон несколько раз в секунду. Слишком глубоко давление истощает щит, слишком высоко — броню. Когда этот слой исчерпан, урон идёт прямо в корпус.", false],
		[1, "", "Поначалу каждый удар слаб. Он растёт на одно очко за каждые 2000 м ниже 30 000 м или выше 15 000 м, так что на предельных глубинах корабль изнашивается быстро.", false],
		[1, "", "Пятисекундная отсрочка позволяет совершать короткие вылазки — например, погнаться за добычей или пройти мимо станции. Пока корабль вне своего диапазона, ускорение времени ограничено 2×.", false],
		[1, "Восстановление", "Щиты с пассивной зарядкой восстанавливаются, только пока корабль находится ниже их верхнего предела. Броня в море не восстанавливается, а корпус чинится только с системой [[equipment/43]]. Все три восстанавливаются при отплытии со станции.", false],
		[1, "Планирование рейсов", "Автопилот и S.T.R.E.A.M. всё равно доставят вас к станции за пределами вашего диапазона — после предупреждения, — но прибытие обойдётся потерей защиты. Контракты с панели заданий обычно ведут к станциям в пределах вашего диапазона, но не всегда. Прежде чем брать задание, проверьте глубину точки назначения и при необходимости смените оборудование (подробнее: [[guide/fitting]]).", false],
		[1, "Рекорды глубины", "Самая высокая и самая низкая достигнутые точки записываются. Медаль «[[medal/21]]» вручается за подъём выше 15 000, 12 000 и 10 000 м, а ещё одна медаль — за погружение ниже 30 000, 32 000 и 35 000 м. Подробнее: [[guide/medals]].", false],
	],
	"guide/fishing": [
		[1, "Гарпун", "Для рыбалки используется гарпун, который составляет отдельный комплект оружия, независимый от пушек. Каждый пилот начинает с гарпуном [[equipment/15]]; гарпуны [[equipment/16]] и [[equipment/17]] лучше. У гарпуна три характеристики: дальность, допуск захвата (насколько близко к цели должен пройти выстрел, чтобы её зацепить) и замедление (насколько сильно он парализует добычу). Установить можно только один гарпун.", false],
		[1, "", "У гарпуна своя кнопка огня: правая кнопка мыши или левый триггер. Можно также выбрать рыболовный комплект кнопкой «Комплект оружия» и нажать «Огонь».", false],
		[1, "Как вытащить добычу", "Попадание цепляет существо, и оно бросается прочь и бьётся. Держите его перед кораблём, пока оно не выбьется из сил. Каждое существо сопротивляется не меньше 2,1 секунды, а более выносливые виды — дольше; время борьбы указано на странице каждого вида. Гарпун с большим замедлением не даёт убегающей добыче уйти далеко.", false],
		[1, "", "Добыча теряется, если её ранить — например, вашими же пушками — или если она выйдет из поля зрения, прежде чем сдастся. Повторное нажатие кнопки гарпуна отпускает зацепленную добычу.", false],
		[1, "", "Обессилевшее существо подтягивается к кораблю и поднимается на борт. Оно занимает место в трюме по своей массе в тоннах, причём отдельная особь может весить на четверть больше или меньше, чем указано для её вида. Если в трюме не хватает места, существо остаётся в воде.", false],
		[1, "Водоросли", "Пять видов водорослей — от «[[species/17]]» до «[[species/13]]» — неподвижно растут на дне. Они сдаются почти сразу, поэтому это самая лёгкая добыча.", false],
		[1, "Туши и обломки", "Существо, убитое из пушек, оставляет тушу, которая всплывает. Если подцепить её гарпуном, она даёт груз «[[goods/18]]» массой примерно в треть животного.", false],
		[1, "", "Уничтоженные корабли оставляют обломки с одной–семью единицами какого-либо груза. Подцепите обломки гарпуном, чтобы забрать груз на борт. Каждые подобранные обломки засчитываются в медаль «[[medal/18]]».", false],
		[1, "Продажа улова", "На станции [[faction/colonists|колонистов]] весь трюм выкупается при прибытии по минимальной цене. На станции [[faction/rebels|повстанцев]] рыбу и водоросли можно продать по рыночной цене или использовать как компоненты в мастерской. Подробнее: [[guide/trading]].", false],
		[1, "", "Грузовые модули увеличивают вместимость трюма (подробнее: [[guide/fitting]]). Контракты «[[contract/14]]» оплачивают доставку определённого числа особей одного вида, а контракты «[[contract/7]]» требуют поймать или убить определённое их число.", false],
		[1, "", "Каждый улов засчитывается в медаль «[[medal/5]]», а много уловов за один рейс — в медаль «[[medal/10]]». За поимку всех видов рыб вручается медаль «[[medal/3]]», а всех видов водорослей — «[[medal/2]]».", false],
	],
	"guide/fitting": [
		[1, "Слоты", "У каждого корпуса фиксированное число слотов оборудования — от шести у [[ship/0]] до десяти у самых больших корпусов, и каждый предмет занимает один слот. Пушки и грузовые модули можно устанавливать по несколько. Все остальные типы, включая торпедные аппараты, — не больше одного на корабль.", false],
		[1, "Типы оборудования", "Пушки и торпеды: см. раздел «[[guide/combat]]».", true],
		[1, "", "Гарпуны: ловят существ и подбирают обломки; см. раздел «[[guide/fishing]]».", true],
		[1, "", "Щиты: первыми поглощают урон и задают верхний предел глубины. Некоторые заряжаются в море.", true],
		[1, "", "Броня: поглощает урон после щита и задаёт нижний предел глубины; см. раздел «[[guide/depth]]».", true],
		[1, "", "Грузовые модули: добавляют процент от базового объёма трюма корпуса. Их действие суммируется.", true],
		[1, "", "Двигатели: увеличивают радиус S.T.R.E.A.M. на свой процент.", true],
		[1, "", "Рули: ускоряют повороты корабля.", true],
		[1, "", "Радары: датчики корабля.", true],
		[1, "", "Ускорители: рывок дополнительной скорости на несколько секунд, после которого нужна перезарядка.", true],
		[1, "", "Ремонтная система: [[equipment/43]] медленно чинит корпус в море.", true],
		[1, "Покупка и продажа", "Магазин станции предлагает от двух до пяти предметов, отбираемых по редкости; по ходу сюжета редкие предметы встречаются чаще. Цены падают с ростом тех. уровня: станция 10-го уровня продаёт по нижней границе ценового диапазона предмета, станция 1-го уровня — почти по верхней.", false],
		[1, "", "Оборудование продаётся обратно на пятую часть дешевле цены магазина станции. Предметы, которыми вы уже владели, при повторной покупке тоже стоят на пятую часть меньше. Грузовой модуль нельзя продать, если без него трюм не вместит своё содержимое.", false],
		[1, "", "Две станции особенные. Станция [[station/28]] продаёт всё оборудование, а станция [[station/81]] — все корпуса, но ни один щит и ни одна броня не позволяют безопасно достичь их глубины.", false],
		[1, "Ремонт", "Платить за ремонт не нужно. Корпус, щит и броня полностью восстанавливаются каждый раз, когда корабль покидает станцию.", false],
		[1, "Покупка корабля", "В продаже кораблей предлагается до трёх корпусов, а более крупные появляются только по ходу сюжета. Тех. уровень станции снижает цену корпуса на столько же процентов. Текущий корабль принимается в зачёт за четыре пятых его цены по прайсу.", false],
		[1, "", "Всё оборудование и груз переходят на новый корпус, поэтому в нём должно хватать слотов и места в трюме. Верфи повстанцев продают каждый корпус в улучшенной версии. У корабля [[ship/10]] огромная цена по прайсу, но, когда получены все медали, он продаётся за 50 000 кредитов; см. раздел «[[guide/medals]]».", false],
	],
	"guide/help": [
		[1, "", "Подводной лодкой можно управлять с клавиатуры и мыши, с геймпада или с сенсорного экрана, причём все три способа можно сочетать. Ниже указаны клавиши по умолчанию; любую клавишу управления кораблём можно переназначить в разделе Настройки › Управление › Назначение клавиш, а Настройки › Управление › Справка по управлению в любой момент показывает текущую раскладку.", false],
		[1, "Клавиатура и мышь", "Движения мыши поворачивают корабль и наклоняют его нос, а камера следует за ним. W и S повышают и понижают тягу на четверть за нажатие; A и D смещают корабль вбок (или поворачивают его, если так задано в настройке рулей), а стрелки наклоняют нос вверх и вниз. Удерживайте Alt или Ctrl, чтобы осматриваться мышью, не меняя курса.", false],
		[1, "", "Левая кнопка мыши: огонь из пушек.", true],
		[1, "", "Правая кнопка мыши: выстрел гарпуном.", true],
		[1, "", "Пробел: огонь выбранной группой оружия; Tab переключает между боевой и рыболовной группами.", true],
		[1, "", "Q: включение и выключение автоогня.", true],
		[1, "", "Shift: ускоритель, если он установлен.", true],
		[1, "", "E: причалить к станции впереди или войти в [[world/stream|S.T.R.E.A.M.]] у врат.", true],
		[1, "", "R: короткое нажатие открывает меню автопилота, удержание прокладывает курс прямо к текущей цели.", true],
		[1, "", "T: ускорение времени; бо́льшие множители доступны, пока корабль ведёт автопилот и поблизости нет опасности.", true],
		[1, "", "M: карта. C: смена камеры. L: фары (нужна настройка «Улучшенное освещение»).", true],
		[1, "", "Esc: пауза или возврат из любого меню. F5 сохраняет игру, пока корабль у причала; F11 переключает полноэкранный режим.", true],
		[1, "", "В разделе Настройки › Управление › Рули можно сделать так, чтобы колесо мыши меняло тягу по шагам; тогда S сразу останавливает корабль.", false],
		[1, "Геймпад", "По умолчанию управляют оба стика: левый смещает или поворачивает корабль и наклоняет нос, правый поворачивает его и наклоняет нос. Каждой оси стиков можно назначить другую роль, в том числе тягу или камеру, в разделе Настройки › Управление › Геймпад; там же настраиваются инверсия тангажа, вибрация и мёртвая зона.", false],
		[1, "", "Крестовина вверх и вниз: тяга. A: огонь выбранной группой оружия. RT: пушки. LT: гарпун. Нажатие левого стика: ускоритель.", true],
		[1, "", "X: смена группы оружия. Y: причалить или войти в S.T.R.E.A.M. LB: меню автопилота. RB: ускорение времени.", true],
		[1, "", "View: карта. Крестовина влево: короткое нажатие меняет камеру, удержание позволяет осматриваться правым стиком. Крестовина вправо: фары.", true],
		[1, "", "Start или B: пауза. В меню A выбирает пункт, а B возвращает назад.", true],
		[1, "Сенсорный экран", "Сенсорное управление включается само при касании экрана; его также можно включить или выключить в разделе Настройки › Управление › Сенсорное управление. Под левым большим пальцем появляется стик поворота, а движение пальцем в любом другом месте позволяет осматриваться. Большая кнопка ПУШКИ стреляет, пока её удерживают, а по её краю проходит шкала тяги: ведите палец по дуге, чтобы задать скорость. В Настройки › Управление › Сенсорное управление › Тяга её можно заменить отдельным вертикальным ползунком над кнопкой. ГАРПУН стреляет гарпуном, УСКОРИТЕЛЬ включает ускоритель, а кнопка ПРИЧАЛИТЬ пульсирует, когда можно причалить. Двойное касание кнопки ПУШКИ или ГАРПУН включает автоогонь, повторное касание его останавливает.", false],
		[1, "", "Кнопки ВРЕМЯ, МАРШРУТ (автопилот), КАРТА и ПАУЗА расположены по краям экрана; камера и полноэкранный режим находятся в меню паузы. Любую кнопку можно перенести и изменить в размере через пункт «Расположение элементов», а кораблём можно управлять и наклоном устройства.", false],
		[1, "Экраны станции", "Причаливание автоматически сохраняет игру и открывает главный экран станции. На нём видно, кому принадлежит станция — колонистам или повстанцам, её технический уровень и кредиты пилота. Стрелки или крестовина переключают кнопки, Enter или A открывает выбранную, Esc или B возвращает назад. ОТЧАЛИТЬ возвращает корабль в воду.", false],
		[1, "", "Ангар: магазин оборудования (покупка и установка или продажа установленного), продажа кораблей с вращающейся моделью каждого корпуса и ценой зачёта текущего, мастерская для производства товаров на станциях повстанцев и обзор корабля и его груза. См. раздел «[[guide/fitting]]».", true],
		[1, "", "Миссии: текущие цели и журнал, а когда она откроется, ещё и панель контрактов. За контракт вносится залог, который пропадает, если от контракта отказаться. См. раздел «[[guide/contracts]]».", true],
		[1, "", "Карта: карта станций с поиском, видом глубин сбоку и кнопками, чтобы задать автопилот или спланировать переход S.T.R.E.A.M. См. раздел «[[guide/navigation]]».", true],
		[1, "", "Торговля: покупка и продажа товаров; торгуют только станции повстанцев. См. раздел «[[guide/trading]]».", true],
		[1, "", "Статус: корабль, статистика пилота и медали. См. раздел «[[guide/medals]]».", true],
		[1, "", "Система: три ячейки сохранения, настройки, помощь, этот справочник, перенос сохранения, загрузка сохранения станции и главное меню.", true],
	],
	"guide/medals": [
		[1, "Как получить медали", "Медали отмечают достижения пилота. Большинство из них имеет три степени — бронза, серебро и золото; остальные вручаются однократно. Прогресс проверяется при каждой стыковке, а о новых медалях сообщают на станции. Полученная медаль никогда не теряется, а более высокая степень заменяет низшую. Полученные медали показаны в вашем профиле в разделе «Статус».", false],
		[1, "Медали за карьеру", "Они учитывают всю карьеру (бронза, серебро, золото):", false],
		[1, "", "«[[medal/4]]»: уничтожено врагов — 50, 200 и 400.", true],
		[1, "", "«[[medal/5]]»: поймано существ — 50, 150 и 300.", true],
		[1, "", "«[[medal/6]]»: станций, к которым вы причаливали, — 50, 100 и 200.", true],
		[1, "", "«[[medal/8]]»: произведено товаров — 50, 250 и 500.", true],
		[1, "", "«[[medal/12]]»: выполнено контрактов — 10, 25 и 50.", true],
		[1, "", "«[[medal/13]]»: прибытий в район новой станции — 50, 150 и 300.", true],
		[1, "", "«[[medal/14]]»: уничтожено пиратов — 25, 150 и 350.", true],
		[1, "", "«[[medal/18]]»: подобрано обломков — 25, 150 и 350.", true],
		[1, "", "«[[medal/19]]»: кредитов на счету одновременно — 125 000, 500 000 и 1 000 000.", true],
		[1, "", "«[[medal/20]]»: куплено новых предметов оборудования — 5, 10 и 20.", true],
		[1, "", "«[[medal/11]]»: часов в игре — 5, 7 и 10.", true],
		[1, "", "«[[medal/21]]»: наивысшая достигнутая точка — 15 000, 12 000 и 10 000 м.", true],
		[1, "Медали за рейс", "Они оценивают один рейс — от отплытия с одной станции до стыковки со следующей:", false],
		[1, "", "«[[medal/9]]»: побед за рейс — 5, 10 и 15.", true],
		[1, "", "«[[medal/10]]»: уловов за рейс — 5, 10 и 15.", true],
		[1, "", "«[[medal/1]]»: стыковка с прочностью корпуса ниже 30%, 15% и 5%.", true],
		[1, "", "«[[medal/16]]»: установлено оружия при стыковке — 3, 5 и 8.", true],
		[1, "", "«[[medal/15]]»: стыковка без установленных пушек. Начальные главы не засчитываются.", true],
		[1, "Разовые награды", "«[[medal/0]]» вручается по прибытии в колонию.", true],
		[1, "", "«[[medal/3]]» и «[[medal/2]]»: поймать каждый вид рыб и каждый вид водорослей хотя бы по разу.", true],
		[1, "", "«[[medal/7]]»: произвести каждую продукцию хотя бы один раз.", true],
		[1, "", "«[[medal/17]]»: пройти сюжет.", true],
		[1, "", "Есть ещё две медали. Одна вручается за погружение ниже 30 000, 32 000 и 35 000 м. Другая — за обладание всеми остальными медалями, и этот полный набор также снижает цену корабля [[ship/10]] до 50 000 кредитов. Подробнее: [[guide/depth]] и [[guide/fitting]].", false],
	],
	"guide/navigation": [
		[1, "Карта", "Двести станций расположены на квадратной карте. [[chart]] в этом справочнике показывает каждую станцию цветом её владельца. В игре раздел «Карта» на станции и карта в море показывают ту же карту с вашим недавним маршрутом, целями миссий и станциями в радиусе S.T.R.E.A.M. На странице каждой станции перечислены ближайшие соседи с расстоянием по карте и глубиной.", false],
		[1, "Автопилот", "Автопилот ведёт корабль за вас. В его списке — текущая цель, стыковка с местной станцией, местные врата S.T.R.E.A.M. или любая станция, выбранная на карте. На больших расстояниях он идёт через открытую воду, обходит станции на пути и переходит из района одной станции в район следующей.", false],
		[1, "", "Любое движение рулём, изменение тяги, ускорение или выстрел возвращают ручное управление, как и пункт «Выключить автопилот» в списке. Включение автоогня тоже отключает автопилот.", false],
		[1, "", "Ускорение времени при ручном управлении работает на 1× или 2×, а на автопилоте — до 16×. При опасности оно снижается до 2×: если враждебный корабль ближе примерно 550 м, если на гарпуне добыча или если корабль покидает безопасный диапазон глубин. При входе в район новой станции оно также возвращается к 1×.", false],
		[1, "Врата S.T.R.E.A.M.", "У каждой станции на некотором удалении есть врата S.T.R.E.A.M. Войдите в зону активации врат и выберите «Причалить», чтобы открыть карту врат со списком всех станций в радиусе. Выберите одну из них и начните переход. Врата открываются, и корабль выходит у врат станции назначения; полученные повреждения при этом сохраняются.", false],
		[1, "", "Врата достают примерно на шестую часть ширины карты от текущей станции. Двигатель увеличивает этот радиус на свой рейтинг: двигатель с рейтингом +30% достаёт на 30% дальше. До станций за пределами радиуса придётся добираться в несколько переходов или долго идти на автопилоте.", false],
		[1, "", "Пока событие миссии в районе не завершено, нельзя пользоваться ни вратами, ни причалом станции.", false],
		[1, "Прибытие", "При входе в район станции начинается ожидающее там событие миссии, если оно есть. Пункт автопилота с целью ведёт к путевым точкам события, а стыковка открывается после его завершения. Подробнее: [[guide/contracts]].", false],
		[1, "", "В остальных случаях в водах вокруг станции обитают местные животные и курсируют патрули. Начиная с [[chapter/12|главы 12]], у станции могут поджидать несколько пиратов, и чем дальше по сюжету, тем чаще. Подробнее: [[guide/combat]].", false],
		[1, "", "Каждое прибытие в район новой станции засчитывается в медаль «[[medal/13]]», а каждая первая стыковка со станцией — в медаль «[[medal/6]]».", false],
	],
	"guide/tips": [
		[1, "", "Короткие советы по навигации, бою и заработку, собранные для этого справочника.", false],
		[1, "В пути", "Если удерживать клавишу автопилота (R), корабль пойдёт прямо к текущей цели; короткое нажатие предлагает другие пункты назначения, например ближайшие врата S.T.R.E.A.M. или станцию, выбранную на карте.", true],
		[1, "", "Под автопилотом время можно ускорить гораздо сильнее, чем при ручном управлении, если поблизости нет врагов.", true],
		[1, "", "Любое действие рулями, тягой или оружием забирает управление у автопилота.", true],
		[1, "", "Ускоритель работает, только если он установлен, и после каждого использования ему нужно время на перезарядку.", true],
		[1, "", "Карта отмечает станции за пределами глубин, допустимых для корпуса; более прочный корпус или щит открывает к ним доступ. См. раздел «[[guide/depth]]».", true],
		[1, "", "Свободный обзор (Alt или Ctrl с мышью либо удержание крестовины влево) позволяет посмотреть назад, не меняя курса.", true],
		[1, "Бой и рыбалка", "Пушки и гарпун стреляют с разных кнопок, поэтому рыбу можно загарпунить прямо посреди боя.", true],
		[1, "", "Автоогонь продолжает стрельбу выбранным оружием, пока обе руки заняты управлением; при открытии меню он прекращается.", true],
		[1, "", "Пункт «Стоп-кадр» в меню паузы останавливает сцену, чтобы камеру можно было свободно перемещать вокруг неё.", true],
		[1, "Торговля и деньги", "Рынок и мастерская есть только на станциях повстанцев; станции колонистов всё равно продают оборудование.", true],
		[1, "", "Мастерская превращает груз в продукцию; прежде чем заполнять ею целый трюм, сравните диапазон цен рецепта с ценами рынка.", true],
		[1, "", "Новый корабль дешевле, чем кажется: текущий принимается в зачёт.", true],
		[1, "", "Если отказаться от контракта, залог пропадает, поэтому сначала проверьте глубину и расстояние.", true],
		[1, "Сохранение", "Причаливание сохраняет игру автоматически, а на экране «Система» есть ещё три ячейки. F5 сохраняет игру, пока корабль у причала.", true],
		[1, "", "Пункт «Загрузить сохранение станции» возвращает к последнему причаливанию, если погружение пошло неудачно.", true],
		[1, "", "Фарам нужна настройка «Улучшенное освещение»; с ней L включает и выключает их.", true],
	],
	"guide/trading": [
		[1, "Где идёт торговля", "Рынок и мастерская есть только на станциях [[faction/rebels|повстанцев]]. Станции [[faction/colonists|колонистов]] при прибытии выкупают весь трюм, каждый товар по минимальной цене, и ничего не продают. В начале сюжета все станции принадлежат колонистам, так что до открытия рынков единственный доход — рыбалка по твёрдым ценам. Подробнее: [[guide/allegiance]].", false],
		[1, "Цены", "У каждого товара есть диапазон цен, родная станция и лучший рынок — всё это указано на его странице. На родной станции товар продаётся по минимальной цене. Чем дальше станция от родной по карте, тем выше цена — вплоть до максимума на расстоянии лучшего рынка и дальше.", false],
		[1, "", "Три импортных товара устроены наоборот: [[goods/33]], [[goods/34]] и [[goods/35]] дешевле всего на своём лучшем рынке и дорожают по мере удаления от него. Рынки повстанцев пополняют их запасы между визитами.", false],
		[1, "", "Рынок покупает и продаёт по одной и той же цене, по одной единице. Прибыль приносит перевозка товаров между станциями, а не перепродажа на месте.", false],
		[1, "Ассортимент рынков", "Рынок предлагает до четырёх видов продукции. Каждый из них должен соответствовать тех. уровню станции, причём продукция чаще появляется рядом со своей родной станцией. Между визитами запасы на полках немного уменьшаются. Три последние посещённые станции сохраняют свой ассортимент; на остальных при возвращении он формируется заново.", false],
		[1, "Производство", "Мастерская в ангаре превращает компоненты из трюма в продукцию. Станция может производить любую продукцию до своего тех. уровня включительно. Список рецептов показывает, сколько единиц каждой продукции можно сделать из содержимого трюма; компоненты указаны на странице каждого продукта. Например, для одной единицы «[[goods/21]]» нужны «[[species/4]]» и «[[species/17]]» — по одной единице.", false],
		[1, "", "Производство товаров засчитывается в медаль «[[medal/8]]», а за изготовление каждой продукции хотя бы один раз вручается медаль «[[medal/7]]».", false],
		[1, "Как заработать", "Несколько способов заработать:", false],
		[1, "", "Покупайте продукцию на родной станции или рядом с ней и везите к её лучшему рынку.", true],
		[1, "", "Рыба и водоросли стоят только времени. Переработанные в продукцию, они могут принести больше, чем при продаже сырьём.", true],
		[1, "", "Не причаливайте к станции колонистов с ценным грузом: всё, что на борту, заберут по минимальной цене.", true],
		[1, "", "Подбирайте груз, оставшийся от уничтоженных кораблей, и продавайте его.", true],
		[1, "", "Контракты «[[contract/13]]» и «[[contract/14]]» оплачивают доставку продукции или улова на станцию, выдавшую задание.", true],
		[1, "", "Тех. уровень станции также снижает цены на оборудование и корабли (подробнее: [[guide/fitting]]).", false],
	],
	"home": [
		[1, "", "Добро пожаловать в справочник по DEEP — подводному приключению на колонизированной океанской планете. Здесь собраны сведения о двухстах глубоководных станциях, о кораблях и оборудовании в продаже, об обитателях океана, о товарах, которыми торгуют рынки, о доступных контрактах и о медалях, которые можно заслужить.", false],
		[1, "", "Страницы сюжета открываются по мере игры. Главы, персонажи и последующие события скрыты, пока до них не дойдёт ваше сохранение, так что справочник можно листать без спойлеров. Имена и цифры берутся из вашей копии игры; обзоры и руководства написаны специально для этого справочника.", false],
		[1, "", "Новым пилотам стоит начать с разделов «[[world/ocean]]» и «[[guide/basics]]». [[chart]] показывает все станции и их владельцев. Каждое руководство посвящено одной стороне жизни под водой — от разделов «[[guide/depth]]» и «[[guide/navigation]]» до «[[guide/trading]]» и «[[guide/combat]]».", false],
	],
	"intro/characters": [
		[1, "", "На этих страницах описаны люди, участвующие в сюжете: пилот, бортовой компьютер корабля, союзники и враги, встреченные по пути, и голоса, звучащие в эфире. Каждая биография следует за кампанией по порядку и пополняется по мере игры, показывая только то, что ваш пилот уже узнал.", false],
		[1, "", "У некоторых говорящих нет собственных имён. Ролевые имена — [[character/6]], [[character/7]] и [[character/10]] — объединяют множество второстепенных голосов каждой стороны, а их страницы объясняют, кто под ними говорит. Сюжет целиком изложен в статье «[[world/history]]».", false],
	],
	"intro/contracts": [
		[1, "", "Пятнадцать типов заданий, которые может предложить станция. На каждой странице указаны цель, сторона, которая выдаёт контракт, ограничения и сюжетные главы, построенные на миссиях того же типа. О залогах, оплате и о том, как сложность зависит от ранга, рассказывает раздел «[[guide/contracts]]». Контракты появляются на панели заданий начиная с [[chapter/9|главы 9]].", false],
	],
	"intro/equipment": [
		[1, "", "Всё оборудование, которое можно установить на корабль: оружие, торпеды, гарпуны, щиты, броня, грузовые модули, двигатели, рули, радары, ускорители и ремонтные системы. На каждой странице указаны характеристики предмета, его редкость в магазинах, можно ли установить несколько штук и цена на каждом тех. уровне. Подробнее — в разделах «[[guide/fitting]]» и «[[guide/combat]]».", false],
	],
	"intro/factions": [
		[1, "", "Силы, действующие в океане: [[faction/colonists]], [[faction/rebels]] и [[faction/pirates]]. Каждая страница объясняет, как фракция влияет на игру — на торговлю, контракты и награды, — и перечисляет её станции и появления в сюжете вплоть до вашей текущей главы. О том, как станции переходят на другую сторону, рассказывает раздел «[[guide/allegiance]]».", false],
	],
	"intro/goods": [
		[1, "", "Всё, что можно перевозить в трюме: улов, продукция, импорт и трофеи. На странице каждого товара указаны его тех. уровень, родная станция, лучший рынок и диапазон цен, рецепт или то, для чего он используется, и особые правила. Как устроены цены и как получать прибыль, рассказывает раздел «[[guide/trading]]».", false],
	],
	"intro/guide": [
		[1, "", "Практические руководства по игре в DEEP. Начните с раздела «[[guide/basics]]», затем прочитайте разделы «[[guide/depth]]», «[[guide/navigation]]», «[[guide/fishing]]», «[[guide/trading]]», «[[guide/combat]]», «[[guide/fitting]]», «[[guide/contracts]]», «[[guide/allegiance]]» и «[[guide/medals]]». Каждое руководство простыми словами объясняет одну сторону жизни под водой, приводит цифры, которыми пользуется сама игра, и ссылается на упомянутые станции, оборудование и медали. Подробности сюжета скрыты, пока до них не дойдёт ваше сохранение.", false],
	],
	"intro/medals": [
		[1, "", "Медали, которые может получить пилот. На каждой странице описано, за что вручается медаль, а для медалей со степенями — что нужно для бронзы, серебра и золота. Когда проверяются медали и какие из них оценивают один рейс, рассказывает раздел «[[guide/medals]]». Медали проверяются при каждой стыковке, а полный набор приносит отдельную награду.", false],
	],
	"intro/ships": [
		[1, "", "Все корпуса подлодок в игре — от стартового [[ship/0]] до [[ship/10]]. На каждой странице указаны прочность корпуса, вместимость трюма, слоты оборудования, управляемость и цена по прайсу, а также с какого момента корабль появляется на верфях; там же приведена сравнительная таблица всех корпусов. О покупке корабля и сдаче старого в зачёт рассказывает раздел «[[guide/fitting]]».", false],
	],
	"intro/species": [
		[1, "", "Существа и водоросли океана. На странице каждого вида указаны масса, прочность, время борьбы на гарпуне, диапазон цен и станции, у которых он обитает, а также продукция и контракты, в которых он используется. Как их ловить, рассказывает раздел «[[guide/fishing]]».", false],
	],
	"intro/stations": [
		[1, "", "Двести станций океана в алфавитном порядке. На странице каждой станции указаны её тех. уровень, глубина и положение на карте, сторона, которой она принадлежит, оборудование, нужное, чтобы до неё добраться, виды, обитающие поблизости, товары, для которых она служит родной станцией или лучшим рынком, её роль в сюжете и ближайшие соседи. [[chart]] показывает их все сразу.", false],
	],
	"intro/story": [
		[1, "", "История кампании охватывает 48 глав, начиная с первого улова пилота. Связный пересказ сюжета, разделённый на акты, — в статье «[[world/history]]». Он пополняется по мере игры и никогда не заходит дальше главы, до которой дошло ваше сохранение.", false],
		[1, "", "У каждой главы есть и своя страница с кратким описанием задания, а после того как вы двинетесь дальше, — и с его итогом. Концовка главы появляется только после перехода к следующей, поэтому эти страницы никогда не раскрывают больше, чем вы уже прошли.", false],
	],
	"intro/world": [
		[1, "", "Справочные сведения о мире DEEP. В статье «[[world/ocean]]» описано само место действия: его глубины и давление, свет и живая природа. Статья «[[world/colony]]» объясняет, как управляются станции, как устроены торговля и контракты и кто поддерживает порядок. [[world/stream|Статья о сети S.T.R.E.A.M.]] рассказывает о системе врат, связывающей станции, а «[[world/history]]» излагает сюжет до того места, до которого вы доиграли.", false],
		[1, "", "Эти страницы пополняются по мере продвижения вашего сохранения. Более поздние события, новые персонажи и тайны глубин появляются только тогда, когда вы до них доберётесь, а новые статьи открываются по мере того, как сюжет раскрывает их темы.", false],
	],
	"medal/0": [
		[1, "", "Каждый пилот получает эту медаль по прибытии на планету. Она не требует никаких усилий и просто отмечает начало карьеры.", false],
	],
	"medal/1": [
		[1, "", "Вручается за стыковку с почти разрушенным корпусом. Для бронзы прочность корпуса должна быть ниже 30%, для серебра — ниже 15%, для золота — ниже 5%. Учитывается состояние корпуса в момент стыковки.", false],
	],
	"medal/10": [
		[1, "", "Вручается за множество уловов за одну вылазку — между отплытием и стыковкой. Для бронзы нужно больше 5, для серебра — больше 10, для золота — больше 15. Большой трюм помогает.", false],
	],
	"medal/11": [
		[1, "", "Отмечает общее время игры в текущей карьере. Бронза вручается после пяти с лишним часов, серебро — после семи, золото — после десяти.", false],
	],
	"medal/12": [
		[1, "", "Учитывает выполненные пилотом контракты с панелей заданий станций. Для бронзы нужно больше 10, для серебра — больше 25, для золота — больше 50.", false],
	],
	"medal/13": [
		[1, "", "Учитывает путешествия между станциями через сеть S.T.R.E.A.M. Для бронзы нужно больше 50, для серебра — больше 150, для золота — больше 300.", false],
	],
	"medal/14": [
		[1, "", "Учитывает пиратов, уничтоженных за карьеру. Для бронзы нужно больше 25, для серебра — больше 150, для золота — больше 350.", false],
	],
	"medal/15": [
		[1, "", "Вручается за вылазку без установленных пушек и торпед. Гарпуны оружием не считаются. Обучающие главы не засчитываются.", false],
	],
	"medal/16": [
		[1, "", "Вручается за стыковку с большим количеством одновременно установленных пушек и торпед. Для бронзы нужно не меньше 3, для серебра — не меньше 5, для золота — не меньше 8, а для этого требуется корпус с большим числом слотов.", false],
	],
	"medal/17": [
		[1, "", "Вручается за прохождение основного сюжета. Получить её иначе нельзя, поэтому обычно это одна из последних медалей, которые собирает пилот.", false],
	],
	"medal/18": [
		[1, "", "Учитывает грузовые ящики, подобранные гарпуном с уничтоженных кораблей. Для бронзы нужно больше 25, для серебра — больше 150, для золота — больше 350.", false],
	],
	"medal/19": [
		[1, "", "Отмечает наибольшую сумму кредитов на счету. Для бронзы нужно больше 125 000, для серебра — больше 500 000, для золота — больше 1 000 000.", false],
	],
	"medal/2": [
		[1, "", "Вручается за поимку хотя бы одной особи каждого из пяти видов водорослей. Водоросли неподвижно растут на дне, так что это одна из самых лёгких наград.", false],
	],
	"medal/20": [
		[1, "", "Учитывает новые предметы оборудования, купленные в магазинах. Для бронзы нужно больше 5, для серебра — больше 10, для золота — больше 20.", false],
	],
	"medal/21": [
		[1, "", "Отмечает наименьшую достигнутую глубину. Для бронзы нужно подняться выше 15 000 м, для серебра — выше 12 000 м, для золота — выше 10 000 м. Две старшие степени лежат за пределами рейтинга любого щита.", false],
	],
	"medal/22": [
		[1, "", "Отмечает самое глубокое погружение. Для бронзы нужно 30 000 м, для серебра — 32 000 м, для золота — 35 000 м. Две старшие степени лежат за пределами рейтинга любой брони.", false],
	],
	"medal/23": [
		[1, "", "Вручается, когда получены все остальные медали, любой степени. Обладатель этой медали может купить [[ship/10]] за малую долю цены по прайсу.", false],
	],
	"medal/3": [
		[1, "", "Вручается за поимку хотя бы одной особи каждого вида плавающих существ. В водах каждой станции свой набор видов, так что рыбачить придётся во многих местах.", false],
	],
	"medal/4": [
		[1, "", "Учитывает всех врагов, уничтоженных за карьеру. Для бронзы нужно больше 50, для серебра — больше 200, для золота — больше 400.", false],
	],
	"medal/5": [
		[1, "", "Учитывает всех существ и все водоросли, пойманные гарпуном за карьеру. Для бронзы нужно больше 50 уловов, для серебра — больше 150, для золота — больше 300.", false],
	],
	"medal/6": [
		[1, "", "Вручается за стыковку со множеством разных станций. Для бронзы нужно больше 50, для серебра — больше 100, для золота — больше 200, то есть практически все станции на карте.", false],
	],
	"medal/7": [
		[1, "", "Вручается, когда пилот хотя бы раз произвёл каждую продукцию. Для некоторых рецептов нужны импортные товары или другая продукция, так что полный набор требует планирования.", false],
	],
	"medal/8": [
		[1, "", "Учитывает все товары, произведённые на фабриках станций. Для бронзы нужно больше 50 единиц, для серебра — больше 250, для золота — больше 500.", false],
	],
	"medal/9": [
		[1, "", "Вручается за уничтожение множества врагов за одну вылазку — между отплытием с одной станции и стыковкой со следующей. Для бронзы нужно больше 5, для серебра — больше 10, для золота — больше 15.", false],
	],
	"ship/0": [
		[1, "Обзор", "[[ship/0]] — корпус, с которого начинает каждый пилот, и самый дешёвый в списке: 45 000 кр. Он же самый слабый почти во всём: 75 единиц прочности корпуса, трюм на 25 т и шесть слотов оборудования. Его показатель управляемости 1,10 — средний, такой же, как у гораздо более крупного [[ship/8]].", false],
		[1, "", "На нём уже установлены [[equipment/15]], [[equipment/18]], [[equipment/22]] и [[equipment/35]]. Из шести слотов под оружие или грузовой модуль свободными остаются лишь два.", false],
		[1, "В эксплуатации", "Главное ограничение — маленький трюм. Его заполняют несколько уловов средней величины, а средний [[species/12|зубастый кит]] весит больше, чем трюм может вместить. За 30 000 кр сверху [[ship/1]] даёт на 40 единиц прочности больше, почти вдвое больший трюм и гораздо более резкое управление при том же числе слотов, поэтому большинство пилотов меняет стартовую лодку, как только позволяют сбережения. До тех пор это учебный корпус: его хватает для первых рыболовных вылазок и лёгких стычек с пиратами недалеко от дома, но не для дальних торговых рейсов или тяжёлых боёв.", false],
	],
	"ship/1": [
		[1, "Обзор", "[[ship/1]] — прочный и доступный рыболовный корабль. По сравнению с [[ship/0]] он получает 40 единиц прочности корпуса, 20 т трюма и гораздо более быструю реакцию на руль: его показатель управляемости 1,61 уступает только [[ship/5]]. Однако слотов у него те же шесть, и этот потолок определяет весь корпус. Гарпун, щит, броня и радар оставляют место лишь для двух пушек или грузовых модулей.", false],
		[1, "В эксплуатации", "Обычные верфи продают его с первой главы за 75 000 кр, поэтому это естественное первое улучшение для пилота, который в основном рыбачит и выполняет короткие поручения. Он даже превосходит более дорогой [[ship/2]] по прочности, трюму и управляемости, уступая лишь один слот. Когда миссии начинают требовать большей огневой мощи или большего трюма, седьмой и восьмой слоты следующих корпусов становятся важнее голой прочности, и Okeanos обычно сдают в зачёт.", false],
	],
	"ship/10": [
		[1, "Обзор", "[[ship/10]] — роскошный флагман и лучший универсальный корпус. Он сочетает 200 единиц прочности, трюм на 100 т, десять слотов и управляемость 1,50. По прочности или трюму его превосходит только [[ship/6]], а быстрее поворачивают лишь [[ship/5]], [[ship/1]] и [[ship/3]]. Его цена по прайсу, 5 000 000 кр, более чем в четырнадцать раз выше, чем у [[ship/9]].", false],
		[1, "В эксплуатации", "Обычные верфи предлагают его с [[chapter/40|главы 40]]. Мало кто из пилотов может заплатить полную цену. Пилот, у которого есть все медали, то есть получивший медаль «[[medal/23]]», может купить его за 50 000 кр — до обычной скидки за тех. уровень станции. Поэтому Aquarius — скорее награда за полную коллекцию медалей, чем практичная покупка. К тому времени, когда он становится доступен, большая часть кампании уже позади.", false],
	],
	"ship/2": [
		[1, "Обзор", "[[ship/2]] — самый дешёвый корпус с семью слотами оборудования: 100 000 кр. Его прочность и трюм (100 единиц и 40 т) даже ниже, чем у [[ship/1]], а управляемость 1,40 скорее хорошая, чем выдающаяся. За дополнительные деньги вы покупаете седьмой слот, куда можно поставить вторую пушку или грузовой модуль.", false],
		[1, "В эксплуатации", "Он продаётся с первой главы, так что пилот, который начнёт копить рано, может перейти на семь слотов задолго до появления чего-то лучшего. Однако начиная с [[chapter/5|главы 5]] [[ship/3]] предлагает такой же корпус и столько же слотов, на 6 т больший трюм и лучшую управляемость всего на 5000 кр дороже. После этого Triops стоит покупать в основном тогда, когда он оказался в продаже поблизости, а альтернатива — нет. Он подходит пилоту, который хочет рано начать охоту на пиратов, ведь в запасной слот можно поставить второе оружие.", false],
	],
	"ship/3": [
		[1, "Обзор", "[[ship/3]] улучшает семислотовую компоновку [[ship/2]]. Всего за 5000 кр сверху он добавляет 6 т трюма и поднимает управляемость с 1,40 до 1,57, что делает его одним из самых манёвренных корпусов в игре. Его 100 единиц прочности ничем не примечательны, так что основную защиту обеспечивают щит и броня.", false],
		[1, "В эксплуатации", "Обычные верфи начинают продавать его с [[chapter/5|главы 5]]. Он подходит пилоту, который хочет и сражаться, и рыбачить на одном корабле без больших затрат, и остаётся разумным выбором до появления восьмислотовых корпусов. По сравнению с [[ship/4]], следующим появляющимся корпусом, он уступает 75 единиц прочности и 24 т трюма, зато поворачивает гораздо быстрее и стоит на 25 000 кр меньше.", false],
	],
	"ship/4": [
		[1, "Обзор", "[[ship/4]] — тяжёлый грузовоз в миниатюре. За 130 000 кр он даёт 175 единиц прочности, трюм на 70 т и восемь слотов — это самый дешёвый восьмислотовый корпус. Расплата — управляемость: показатель 0,91 ниже, чем у любого более раннего корабля, и медленнее поворачивает только [[ship/6]].", false],
		[1, "В эксплуатации", "Он появляется на обычных верфях с [[chapter/10|главы 10]]. Больше всего от него выигрывают торговцы и рыбаки. Большой базовый трюм к тому же делает грузовые модули эффективнее, ведь их бонус — процент от базовой вместимости. Модуль рулей отчасти компенсирует неповоротливость. Пилоты, которые в основном сражаются, могут предпочесть [[ship/5]]: он стоит на 20 000 кр дороже и поворачивает ровно вдвое быстрее, но прочность корпуса у него едва ли не вдвое меньше.", false],
	],
	"ship/5": [
		[1, "Обзор", "[[ship/5]] — корабль для манёвренного боя. Его показатель управляемости 1,82 — лучший среди всех корпусов, что позволяет держаться позади противника и не выпускать цель из прицела. Защита у него, однако, слабая: при 90 единицах корпус слабее, чем у [[ship/1]], а трюм на 40 т скромен. Восемь слотов оставляют много места для оружия.", false],
		[1, "В эксплуатации", "Обычные верфи продают его с [[chapter/15|главы 15]] за 150 000 кр. Он вознаграждает пилотов, умеющих уходить от попаданий, — желательно при поддержке сильного щита и брони — и плохо подходит для перевозки грузов. Поскольку все установленные пушки стреляют одновременно, свободные слоты напрямую превращаются в огневую мощь. Пилоту, которому нужен более прочный восьмислотовый корпус, стоит сравнить его с [[ship/4]] или дождаться [[ship/6]].", false],
	],
	"ship/6": [
		[1, "Обзор", "[[ship/6]] — огромный грузовоз. Его трюм на 180 т намного больше, чем у любого другого корпуса, почти вдвое больше, чем у [[ship/10]], а 220 единиц прочности — максимум в игре. За 170 000 кр он ещё и дешевле, чем [[ship/7]] и все последующие корпуса. Недостаток — управляемость: с показателем 0,67 он поворачивает медленнее любого другого корабля.", false],
		[1, "В эксплуатации", "Он появляется на обычных верфях с [[chapter/20|главы 20]]. Для торговли и крупных рыболовных рейсов ему нет равных. Грузовые модули считаются от базовой вместимости, поэтому один модуль на +80% добавляет 144 т. В бою он полагается на то, чтобы выдерживать урон, а не уклоняться от него, и против вёртких пиратов модуль рулей почти обязателен. А поскольку слотов всего восемь, места для пушек у него меньше, чем у последующих корпусов.", false],
	],
	"ship/7": [
		[1, "Обзор", "[[ship/7]] — первый корпус с девятью слотами. Остальные его показатели средние: 135 единиц прочности, трюм на 50 т и управляемость 1,23 — лучше, чем у [[ship/0]], но заметно хуже, чем у [[ship/5]]. За 215 000 кр он стоит значительно дороже, чем [[ship/6]], так что цена в основном оплачивает дополнительный слот.", false],
		[1, "В эксплуатации", "Он появляется на обычных верфях с [[chapter/25|главы 25]]. Он подходит пилоту, которому нужна ещё одна пушка или модуль сверх того, что позволяет восьмислотовый корпус, без переплаты за последующие десятислотовые корабли. Как универсал он надёжен, но ни в чём не выдающийся. [[ship/8]], появляющийся пятью главами позже, добавляет десятый слот, 15 единиц прочности и 16 т трюма ещё за 85 000 кр.", false],
	],
	"ship/8": [
		[1, "Обзор", "[[ship/8]] — первый корпус с десятью слотами. У него 150 единиц прочности и трюм на 66 т, а управляется он как [[ship/0]], с показателем 1,10. За 300 000 кр он стоит на 85 000 кр дороже, чем [[ship/7]], ради одного слота и скромной прибавки прочности и трюма.", false],
		[1, "В эксплуатации", "Обычные верфи продают его с [[chapter/30|главы 30]]. С десятью слотами пилот может установить полный защитный комплект, гарпун и радар и всё равно поставить несколько пушек или грузовой модуль. Управляемость у него лишь средняя, поэтому в ближнем бою пригодится модуль рулей. [[ship/9]], появляющийся пятью главами позже, жертвует 6 т трюма ради 15 единиц прочности и лучшей управляемости. Pontos остаётся более дешёвым из двух и лучшим выбором, когда важен груз.", false],
	],
	"ship/9": [
		[1, "Обзор", "[[ship/9]] — десятислотовый корпус высокого класса. По сравнению с [[ship/8]] он добавляет 15 единиц прочности и заметно более резкое управление (1,36 против 1,10), но теряет 6 т трюма. За 350 000 кр он стоит на 50 000 кр дороже.", false],
		[1, "В эксплуатации", "Обычные верфи продают его с [[chapter/35|главы 35]]. Лучше всего он подходит пилоту, настроенному на бой, в конце кампании: десять слотов и хорошая управляемость дают такому пилоту больше, чем место в трюме. Для оптовой торговли [[ship/6]] везёт втрое больше за полцены. Единственный корпус, превосходящий Lir почти во всём, — [[ship/10]], цена которого по прайсу совсем другого порядка.", false],
	],
	"species/0": [
		[1, "Обзор", "Прообраз вида «[[species/0]]» — наутилусы, головоногие моллюски с раковиной из тропических вод Индийского и Тихого океанов. Наутилус живёт в наружной камере закрученной раковины и регулирует плавучесть, меняя количество газа и жидкости во внутренних камерах. Он плавает за счёт реактивного движения и ловит пищу десятками щупалец без присосок. Обычно наутилусы держатся на глубине нескольких сотен метров, а если опускаются намного глубже примерно 800 м, раковина может лопнуть.", false],
		[1, "В игре", "В игре он весит около 8 т и почти не сопротивляется на гарпуне: чтобы его одолеть, хватает 2,1 с. Это делает его одной из самых лёгких добыч, но цена — от 44 до 156 кр за тонну — невелика. Он обитает в водах 67 станций.", false],
		[7, "", "В [[chapter/7|главе 7]] пилоту нужно избавиться от этих животных в водах вокруг станции [[station/1]], поймав или убив их.", false],
	],
	"species/1": [
		[1, "Обзор", "Вид «[[species/1]]» назван по Eurypharynx pelecanoides — глубоководной рыбе, которая встречается примерно на глубине от 500 до 3000 м. Её свободно сочленённая пасть огромна по сравнению с тонким, похожим на хлыст телом и раскрывается так широко, что может заглотить неожиданно крупную добычу. Хвост заканчивается маленьким светящимся органом. Взрослые особи обычно намного меньше метра.", false],
		[1, "В игре", "В игре это быстрый пловец, который борется с гарпуном около 4 с — вдвое дольше, чем [[species/0|наутилус]] той же массы 8 т. Усилия окупаются: при цене от 70 до 255 кр за тонну это одна из самых дорогих добыч. Фабрики производят из него «[[goods/24]]» и «[[goods/27]]» — ценную продукцию. Гарпун с сильным замедлением заметно облегчает поимку.", false],
	],
	"species/10": [
		[1, "Обзор", "Прообраз вида «[[species/10]]» — кальмары и осьминоги, головоногие, знаменитые тем, что меняют окраску за доли секунды. В их коже тысячи пигментных клеток — хроматофоров, каждый из которых раскрывается и сжимается крошечными мышцами, а также отражающие клетки, придающие переливы. У многих есть и чернильный мешок; из чернил каракатицы когда-то получали коричневый пигмент сепию.", false],
		[1, "В игре", "В игре он весит около 14 т, имеет прочность 28 и бьётся на гарпуне около 3,4 с. Цены на сырьё — от 59 до 164 кр за тонну. Вместе с растворителем из него делают «[[goods/22]]» — компонент продукции «[[goods/29]]».", false],
		[19, "", "В [[chapter/19|главе 19]] пилоту нужно защитить их косяк у станции [[station/7]] от нападающих кораблей.", false],
	],
	"species/11": [
		[1, "Обзор", "«Панцирная» значит покрытая защитными пластинами, и вид «[[species/11]]» напоминает о морских черепахах. Сегодня их известно семь видов. Их панцирь состоит из костных пластин, сросшихся с позвоночником и рёбрами. Крупнейшая — кожистая черепаха с панцирем длиной примерно до 2 м; в поисках медуз она может нырять глубже 1000 м. Самки возвращаются на пляжи, чтобы отложить яйца.", false],
		[1, "В игре", "В игре она весит около 8 т и сдаётся на гарпуне примерно через 2,7 с. Её цена необычно изменчива — от 40 до 244 кр за тонну, — так что продавать её выгодно там, где высок спрос. Ни один рецепт фабрики её не использует.", false],
	],
	"species/12": [
		[1, "Обзор", "Прообраз вида «[[species/12]]» — зубатые киты, группа, к которой относятся кашалоты, дельфины и морские свиньи. Они находят добычу с помощью эхолокации, издавая щелчки и прислушиваясь к эху. Кашалот — крупнейший зубатый хищник на Земле. Охотясь на кальмаров, он ныряет на глубину 1000 м и более и может оставаться под водой больше часа.", false],
		[1, "В игре", "В игре это самое тяжёлое существо — около 30 т при прочности 60. Одна такая добыча может заполнить маленький трюм, а средняя особь не поместится в трюм на 25 т у [[ship/0]]. Борется он всего около 2,9 с. Цены сильно разнятся — от 22 до 200 кр за тонну, — и ни один рецепт его не использует.", false],
	],
	"species/13": [
		[1, "Обзор", "Вид «[[species/13]]» напоминает о золотистых водорослях (Chrysophyceae) и родственных золотисто-бурых группах. Свой цвет они получают от пигмента фукоксантина, который маскирует хлорофилл. Большинство из них микроскопичны и живут в пресной воде, а некоторые вызывают цветение; один вид, Prymnesium parvum, выделяет токсины, способные убивать рыбу.", false],
		[1, "В игре", "В игре, как и все водоросли, они прикреплены ко дну, весят ровно 2 т и сдаются за 2,1 с. Это самые ценные из пяти видов водорослей: от 27 до 65 кр за тонну. Они используются в продукции «[[goods/27]]» и «[[goods/28]]».", false],
	],
	"species/14": [
		[1, "Обзор", "Вид «[[species/14]]» отсылает к сине-зелёным водорослям, или цианобактериям. Строго говоря, это не водоросли, а фотосинтезирующие бактерии. Они относятся к древнейшим известным формам жизни и помогли наполнить атмосферу Земли кислородом. Некоторые из них связывают атмосферный азот, а некоторые способны выделять водород, поэтому учёные изучают их как источник чистого топлива.", false],
		[1, "В игре", "В игре они растут на дне, весят 2 т и почти не сопротивляются. Цена — от 21 до 47 кр за тонну. Символично, что из них вместе с грузом «[[goods/18]]» делают «[[goods/19]]»; кроме того, это один из пяти видов водорослей, нужных для продукции «[[goods/28]]».", false],
	],
	"species/15": [
		[1, "Обзор", "Вид «[[species/15]]» представляет бурые водоросли (Phaeophyceae), к которым относятся ламинариевые. Гигантская макроцистис вырастает в высоту на десятки метров и образует подводные леса, дающие приют множеству других видов. Бурые водоросли — промышленный источник альгинатов, которые используют как загустители в пищевых продуктах и в медицине.", false],
		[1, "В игре", "В игре это самая дешёвая добыча: от 14 до 47 кр за тонну. Как и другие водоросли, они неподвижно растут на дне, весят 2 т и сдаются за 2,1 с. Используются они только в продукции «[[goods/28]]», для которой нужны все пять видов водорослей.", false],
	],
	"species/16": [
		[1, "Обзор", "Вид «[[species/16]]» обозначает красные водоросли (Rhodophyta). Красный пигмент фикоэритрин позволяет им поглощать синий свет, который проникает в море глубже всего, поэтому они растут глубже любых других морских водорослей. Из красных водорослей получают агар и каррагинан, а нори, в которую заворачивают суши, — тоже красная водоросль.", false],
		[1, "В игре", "В игре это вторые по ценности водоросли: от 27 до 62 кр за тонну. Они растут на дне, весят 2 т и легко ловятся гарпуном. Вместе с видом «[[species/13]]» они идут на «[[goods/27]]» и также нужны для продукции «[[goods/28]]».", false],
	],
	"species/17": [
		[1, "Обзор", "Вид «[[species/17]]» обозначает зелёные водоросли — ближайших родственников наземных растений. Знакомый пример с морских побережий — морской салат (Ulva). Некоторые зелёные водоросли едят: в Японии пищу посыпают сушёными хлопьями аонори. Зелёным водорослям нужно много света, поэтому большинство из них растёт на мелководье.", false],
		[1, "В игре", "В игре это недорогая добыча: от 20 до 44 кр за тонну. Как и другие водоросли, они прикреплены ко дну, весят 2 т и сдаются за 2,1 с. Фабрики сочетают их с видом «[[species/4]]», чтобы сделать «[[goods/21]]»; кроме того, это один из пяти видов водорослей в продукции «[[goods/28]]».", false],
	],
	"species/2": [
		[1, "Обзор", "Вид «[[species/2]]» представляет медуз — свободно плавающую стадию многих стрекающих. У медузы нет ни мозга, ни костей, ни крови, а её купол состоит в основном из воды. Она передвигается, сокращая купол, и дрейфует по течению, ловя мелкую добычу щупальцами со стрекательными клетками. Некоторые виды светятся, а ряд глубоководных форм окрашен в красный или фиолетовый цвет.", false],
		[1, "В игре", "При массе около 2 т это одно из самых лёгких существ в игре, а прочность 4 означает, что её может убить один случайный выстрел. На гарпуне она сдаётся примерно через 2,5 с. Цены — от 40 до 133 кр за тонну. В производстве она используется только как один из трёх компонентов продукции «[[goods/26]]».", false],
	],
	"species/3": [
		[1, "Обзор", "Прообраз вида «[[species/3]]» — манты, крупнейшие скаты в мире. Размах «крыльев» у крупных океанических видов достигает примерно 7 м. Манты — мирные фильтраторы: они плывут с открытым ртом и направляют планктон внутрь двумя мясистыми лопастями перед ртом. Относительно размеров тела у них один из самых больших мозгов среди рыб.", false],
		[1, "В игре", "В игре он весит около 16 т и имеет прочность 32, поэтому переносит случайные попадания лучше мелких животных. На гарпуне он бьётся около 3,6 с. Цены на сырьё — от 65 до 182 кр за тонну — умеренные, но именно это существо нужно для продукции «[[goods/20]]», которая, в свою очередь, идёт на «[[goods/29]]».", false],
	],
	"species/4": [
		[1, "Обзор", "Вид «[[species/4]]» обозначает плотные косяки мелких рыб, таких как сардины, анчоусы и сельдь. Косяк сбивает с толку хищников, которым трудно выбрать одну цель, а возможно, ещё и экономит силы: рыбы плывут в струе друг друга. Такие косяки лежат в основе многих морских пищевых цепей и крупнейших промыслов в мире.", false],
		[1, "В игре", "В игре косяк ловится целиком, как один груз в 4 т. Это нетребовательная добыча: гарпун одолевает её примерно за 2,5 с, а прочность всего 8. Цены — от 53 до 138 кр за тонну. Это компонент продукции «[[goods/21]]» и «[[goods/26]]», так что у пилота, который ловит также «[[species/17]]» или «[[species/2]]», готова целая производственная цепочка.", false],
	],
	"species/5": [
		[1, "Обзор", "Прообраз вида «[[species/5]]» — удильщики, особенно глубоководные. Видоизменённый луч плавника на голове образует «удочку» с приманкой на конце. У многих глубоководных форм приманка светится благодаря симбиотическим бактериям и подманивает добычу к широкой пасти. У некоторых видов крошечные самцы навсегда срастаются с гораздо более крупными самками.", false],
		[1, "В игре", "В игре она весит около 10 т и сдаётся на гарпуне примерно через 2,5 с, так что ловится довольно быстро. Разброс цен широк: от 53 до 216 кр за тонну. Вместе с видом «[[species/1]]» и растворителем она нужна для продукции «[[goods/24]]» — важного компонента нескольких дорогих товаров.", false],
	],
	"species/6": [
		[1, "Обзор", "«Рыба-дьявол» — старое моряцкое прозвище. За века его давали скатам-дьяволам из рода Mobula, крупным осьминогам и даже серому киту. Игра не привязывает вид «[[species/6]]» ни к одному из этих животных. Общее у них — размер и грозная репутация, которая редко соответствует их настоящему поведению.", false],
		[1, "В игре", "В игре это тяжёлая добыча — около 20 т при прочности 40. Она борется с гарпуном около 4,2 с, дольше почти всех существ. Кроме того, у неё самая высокая максимальная цена среди существ — до 364 кр за тонну. Фабрики сочетают её с видом «[[species/8]]» и солью, чтобы получить «[[goods/25]]».", false],
	],
	"species/7": [
		[1, "Обзор", "Прообраз вида «[[species/7]]» — марлины, крупные копьеносые рыбы тёплых открытых океанов. Марлин рассекает косяки добычи копьевидным рылом и считается одной из самых быстрых рыб в море. Крупнейшие голубые марлины превышают 4 м в длину и весят несколько сотен килограммов. Спортивные рыболовы ценят марлинов за долгую, акробатическую борьбу.", false],
		[1, "В игре", "В игре он лёгок — около 8 т, — но вытащить его трудно: он быстро плавает и сопротивляется гарпуну около 4,2 с. Гарпун с большой дальностью и сильным замедлением облегчает задачу. Зато он хорошо держит цену: от 104 до 283 кр за тонну — самая высокая минимальная цена среди существ. Это основной компонент продукции «[[goods/23]]».", false],
	],
	"species/8": [
		[1, "Обзор", "Bone shark — старое английское название гигантской акулы, второй по величине из ныне живущих рыб после китовой акулы. Гигантская акула достигает примерно 8 м и более. Несмотря на размеры, это безобидный фильтратор: она медленно плавает у поверхности с широко открытой пастью, процеживая планктон. Гигантские акулы совершают дальние миграции и часто проводят зиму на большей глубине.", false],
		[1, "В игре", "В игре вид «[[species/8]]» весит около 18 т и имеет прочность 36. С гарпуном он борется около 3,8 с. Цены — от 78 до 208 кр за тонну. Это одна из самых полезных для производства добыч: она идёт и на «[[goods/25]]», и на «[[goods/26]]».", false],
	],
	"species/9": [
		[1, "Обзор", "Такого вида в природе нет, но настоящие гиганты среди креветок существуют. Гигантская тигровая креветка вырастает примерно до 30 см, а некоторые глубоководные ракообразные крупнее своих мелководных родственников — это явление называют глубоководным гигантизмом. Многие глубоководные креветки красного цвета, что делает их почти невидимыми в воде, куда не проникает красный свет.", false],
		[1, "В игре", "В игре вид «[[species/9]]» — небольшая добыча в 2 т с прочностью 4, которую гарпун одолевает примерно за 2,3 с. Цены — от 39 до 122 кр за тонну. Ни один рецепт фабрики её не использует, так что её ловят исключительно на продажу. Контракты на рыболовство требуют её чаще, чем более редких существ вроде [[species/0|наутилуса]].", false],
	],
	"world/abel": [
		[31, "", "[[world/abel]] — учёный, работающий с [[faction/rebels|сопротивлением]]. Он ни разу не появляется на экране, но его исследования лежат в основе плана, который составила [[character/2]], — создать оружие, способное переломить ход войны с колонией.", false],
		[31, "Предыстория", "Профессор много лет исследовал [[world/biotek|Биотек-генератор]] — источник энергии, который ещё никому не удавалось построить. Он почти закончил рабочий прототип, когда колонисты его похитили, и теперь они пытаются доделать его сами.", false],
		[31, "Роль в сюжете", "[[character/2]] доставляет его вместе с командой на станцию [[station/14]], чтобы создать новое оружие повстанцев. Судя по всему, это те самые учёные, чей конвой пилот защищал по пути туда ([[chapter/29|глава 29]]). [[character/2]] сразу уходит на встречу с ним, а пилот и остальные отбивают генератор ([[chapter/30|глава 30]]).", false],
		[33, "", "После налёта профессор забирает добытые контейнеры в свою лабораторию, чтобы продолжить работу над прототипом ([[chapter/32|глава 32]]).", false],
		[39, "", "Работа продвигается быстро. Вскоре прототип почти готов, и не хватает лишь одной детали: это [[goods/36]], который размножает ДНК частиц водорослей и запускает цепную реакцию, вырабатывающую энергию. [[character/2]] пересказывает его объяснение, признаваясь, что сама не до конца его понимает. Устройство можно сделать только на станции [[station/16]] ([[chapter/38|глава 38]]).", false],
		[42, "", "Когда инкубатор доставлен на станцию [[station/14]], у профессора всё готово для установки, и готовое оружие вскоре ожидается в ангаре. Поскольку генератор пока лишь прототип, пилота предупреждают обращаться с ним осторожно ([[chapter/41|глава 41]]).", false],
		[44, "", "Пушка [[world/eclipse|Eclipse]], которую питает его генератор, решает исход боя, когда колонисты атакуют станцию [[station/14]].", false],
		[31, "Характер", "Всё, что о нём известно, рассказывают [[character/2]] и [[character/5]]. Его описывают как преданного своему делу исследователя.", false],
		[39, "", "Его объяснения настолько техничны, что даже [[character/2]] с трудом может их пересказать.", false],
	],
	"world/aquarians": [
		[10, "", "Аквариане — существа глубин океана, которые, по рассказам, наполовину люди, наполовину рыбы. «Аквариане» — так их называют колонисты, и колония считает их вредителями. Известны они прежде всего нападениями на транспортные капсулы, которые доставляют экспорт колонии на орбиту. Кто они такие и чего хотят — один из вопросов, на которые сюжет постепенно отвечает.", false],
		[10, "Природа", "Поначалу об Акварианах известно мало. Они живут в открытой воде и движутся скорее как морские животные, чем как машины, но сражаются собственным оружием. Колонисты считают их опасными животными и никогда не задаются вопросом, почему те нападают.", false],
		[11, "", "После первого боя пилота с ними [[character/1]] задаётся вопросом, не гораздо ли они умнее, чем все предполагали. Пилот тоже начинает спрашивать себя, зачем они вообще нападают на капсулы.", false],
		[19, "", "Дальнейшие встречи наводят на мысль, что они заботятся о морских обитателях. Их видят плывущими рядом со стаей [[species/10|чернильных спрутов]], которую пытаются поймать колонисты, — словно они её охраняют.", false],
		[45, "", "Они разумны и способны к дипломатии. Посланник Аквариан прибывает на станцию [[station/14]] и, похоже, понимает человеческую речь.", false],
		[10, "Отношения с колонией", "Запуски капсул связывают колонию с внешней экономикой, и Аквариане раз за разом наносят по ним удары. Каждая повреждённая или потерянная капсула портит станции репутацию в глазах торговой администрации, поэтому колонисты нанимают вооружённых пилотов, чтобы отгонять нападающих. Защита капсул — ещё и обычный контракт колонистов; см. «[[contract/11]]».", false],
		[10, "", "В [[chapter/10|главе 10]] пилота отправляют на станцию [[station/2]] защищать запуск капсул; [[character/9]] приказывает допустить лишь считанные потери.", false],
		[11, "", "Ничто не говорит о том, что колония когда-либо пыталась говорить с Акварианами. Она просто платит за то, чтобы их отгоняли или убивали.", false],
		[13, "Отношения с повстанцами", "Осуждая эксплуатацию со стороны колонии, [[faction/rebels|повстанцы]] говорят не только о ресурсах планеты, но и о её обитателях. Возможно, они имеют в виду и Аквариан, но долгое время никаких контактов между ними нет.", false],
		[19, "", "Повстанцев и Аквариан объединяет стремление защищать животных океана. Когда пилот защищает спрутов у станции [[station/7]], [[character/1]] предполагает, что Аквариане могли бы стать союзниками.", false],
		[44, "", "Перелом наступает во время атаки колонистов на станцию [[station/14]] в [[chapter/43|главе 43]]. Когда причалы станции поражены, а защитников гораздо меньше, появляется группа Аквариан и атакует колонистов, переломив ход битвы. [[character/9]] и его силы обращены в бегство.", false],
		[45, "", "После битвы посланник на Fiir объясняет, что Аквариане готовы бороться против власти колонистов. [[character/2]] надеется, что после поражения колонии люди и Аквариане смогут жить в гармонии с океаном. С их помощью повстанцы планируют два последних наступления.", false],
		[45, "", "В [[chapter/45|главе 45]] группа Аквариан поднимается из глубин, чтобы вместе с пилотом и отрядом, которым командует [[character/12]], штурмовать станцию [[station/18]].", false],
		[47, "", "Оба наступления удаются, и командиры повстанцев признают, что победой во многом обязаны Акварианам.", false],
		[48, "", "Колонии больше нет, и в конце истории остаются союз повстанцев с Акварианами и обещание дать океану восстановиться.", false],
		[45, "Открытые вопросы", "Многое об Акварианах так и не объясняется. Сюжет не говорит, где они живут, сколько их, как они изготавливают и применяют своё оружие и как научились понимать человеческую речь. Остаётся неясным и то, почему они выбрали своей целью капсулы колонии, хотя их последующий союз с повстанцами наводит на мысль, что они видели в экспорте часть разграбления своего океана.", false],
		[10, "В игре", "В бою Аквариане выглядят как похожие на рыб бойцы, стреляющие энергетическими зарядами. Они поворачивают медленнее подлодок и никогда не используют рывки. Уничтоженный Акварианин гибнет как морское существо, в одной вспышке, и не оставляет ни обломков для сбора, ни добычи.", false],
		[10, "", "На стороне колонии Аквариане — враги в миссиях по защите капсул. Они идут прямо к капсулам, так что защитнику приходится быстро их выслеживать. Миссия проваливается, если потеряно слишком много капсул. Уничтоженные Аквариане засчитываются как убитые враги, но не в награду за пиратов.", false],
		[44, "", "В последних главах они сражаются на стороне пилота как союзники. На радаре они отображаются как дружественные цели и атакуют корабли колонистов.", false],
	],
	"world/biotek": [
		[31, "", "Биотек-генератор — экспериментальный источник энергии, разработанный [[world/abel|профессором Абелем]]. Это ключ к плану повстанцев превзойти колонистов в огневой мощи. Повстанцы намерены питать с его помощью оружие, слишком энергоёмкое для любой обычной подлодки, и его возвращение — первый из трёх этапов этого плана. Сам генератор никогда не продаётся и не устанавливается как оборудование; в игре пилот имеет дело с нужными для него деталями.", false],
		[31, "Исследования и кража", "Технологию, на которой основан генератор, изучали годами, но рабочего прототипа так никто и не создал. Профессор Абель почти закончил свой, когда колонисты его похитили. Теперь они пытаются доделать его сами, а повстанцы полны решимости им помешать.", false],
		[31, "", "Незадолго до того, как раскрыть план, [[character/2]] организовала переброску группы высококлассных учёных на станцию [[station/14]]. В [[chapter/29|главе 29]] пилот благополучно провёл их конвой через пограничный район у станции [[station/13]].", false],
		[31, "", "На Fiir Аюми объясняет, зачем нужны учёные: это команда Абеля. Вместе они превратят генератор в сердце нового оружия.", false],
		[31, "План в три этапа", "Аюми излагает план в три этапа. Во-первых, повстанцы должны вернуть генератор. Во-вторых, им нужно оружие, достаточно мощное, чтобы быть достойным такого генератора. Третий этап она пока не объясняет.", false],
		[31, "", "По сведениям одного из информаторов Аюми, похищенный генератор перевозят с обычным колонистским конвоем в место под названием Maarth. Поскольку никто не знает, на каком корабле он находится, пилот, [[character/5]] и [[character/4]] должны остановить весь конвой у станции [[station/2]] и подобрать каждый контейнер.", false],
		[32, "", "Налёт удаётся, и все контейнеры подобраны, хотя экипажи колонистов уверяют, что везут только еду и лекарства.", false],
		[33, "", "Вернувшись на Fiir, Абель забирает захваченный груз в свою лабораторию, чтобы закончить прототип. Тем временем пилот отправляется добывать оружие для второго этапа — [[world/eclipse|пушку Eclipse]].", false],
		[39, "Как он работает", "Генератор черпает энергию из живой материи. Полимеразный инкубатор копирует ДНК частиц водорослей, и это копирование запускает цепную реакцию, высвобождающую энергию. Чтобы прототип заработал, ему ещё нужен этот инкубатор — «[[goods/36]]».", false],
		[39, "", "Оборудование для его изготовления есть только на одной станции — [[station/16]], самой развитой в океане. Третий этап для пилота — отправиться туда и произвести инкубатор.", false],
		[42, "", "Когда инкубатор доставлен на Fiir, Абель завершает установку, и генератор питает Eclipse на собственном корабле пилота. Повстанцы предупреждают, что это всё ещё прототип.", false],
		[44, "", "В бою он не подводит. Когда колонисты атакуют Fiir, Eclipse, питаемая генератором, помогает переломить ход боя. [[character/9]] явно потрясён, увидев такую пушку на подлодке.", false],
		[45, "", "Как только станция [[station/188]] переходит в руки повстанцев, они принимаются оснащать такой же связкой пушки и источника энергии как можно больше своих кораблей.", false],
		[39, "В игре", "Третий этап занимает три главы: путь на Wagoll в [[chapter/39|главе 39]], производство там инкубатора в [[chapter/40|главе 40]] и его доставка на Fiir в [[chapter/41|главе 41]]. На странице этого товара указан диапазон цен, но ни один рынок его не продаёт, так что единственный способ его получить — изготовить самому.", false],
		[39, "", "Инкубатор производится на фабрике станции 11-го технического уровня, а на практике это означает Wagoll. Для рецепта нужно по одной единице товаров «[[goods/19]]», «[[goods/34]]», «[[goods/28]]» и «[[goods/24]]». Их, в свою очередь, получают из мёртвой рыбы и водорослей, из импорта, из всех пяти видов водорослей и из товара «[[goods/35]]» вместе с видами «[[species/5]]» и «[[species/1]]». Сбор всего этого — небольшая производственная цепочка сама по себе.", false],
		[39, "", "Wagoll лежит на глубине 29 850 м, глубже, чем рассчитана большая часть брони, поэтому, чтобы безопасно туда добраться, пилоту нужна тяжёлая броня, например [[equipment/25]]. Инкубатор — сюжетный предмет, который не продаётся ни на одном рынке. Изготовленный, он остаётся на борту, пока его не доставят на Fiir.", false],
	],
	"world/colony": [
		[1, "", "Колония — человеческое поселение на океанской планете: двести глубоководных станций под управлением колониальной администрации, а также поселенцы, рыбаки и торговцы, которые на них живут и работают. В начале истории все станции принадлежат [[faction/colonists|колонистам]], и назначение колонии очевидно: она существует, чтобы добывать ресурсы океана и вывозить их. В этой статье описано, как устроена колония, как работает её экономика и как то и другое меняется по ходу сюжета.", false],
		[1, "Колонизация", "Поселенцы прибыли на планету издалека и построили свои дома под поверхностью, где станции теперь стоят на глубинах примерно от 13 500 до 32 250 м. Станции сильно различаются. У каждой есть технический уровень от 1 до 11, от которого зависит, что может производить её фабрика и сколько берут её магазины, и у каждой свои воды, обитатели и соседи. Одни станции — крупные узлы вроде станции [[station/0]], другие — небольшие аванпосты, известные одним-единственным продуктом.", false],
		[1, "", "От новичков ждут, что они будут честно тянуть свою лямку. Пилот прибывает на планету рыбачить, с небольшой лодкой и почти без денег, и быстро понимает, что работа тяжела и плохо оплачивается.", false],
		[10, "", "Экономика колонии экспортная. Станции грузят свои товары в транспортные капсулы и запускают их на орбиту, где их забирают грузовые корабли. Над местными чиновниками стоит торговая администрация, которая судит о станциях по тому, насколько надёжно доходят эти поставки.", false],
		[12, "", "Сам пилот хочет лишь заработать на билет с планеты.", false],
		[21, "", "Повстанцы называют колонизацию стремительной и беспощадной. По их мнению, она истощает океан быстрее, чем природа успевает восстановиться, как это уже случилось на других планетах.", false],
		[1, "Администрация и станции", "Каждая станция — это маленький город со своими чиновниками и службами. Причаливший пилот может зайти в ангар, чтобы установить оборудование, в магазин и на верфь, чтобы купить снаряжение и корпуса, а также открыть карту. На большинстве станций есть и панель заданий, а на некоторых — рынок и фабрика. Вокруг каждой станции между её вратами S.T.R.E.A.M. курсируют патрульные корабли, которые сражаются за ту сторону, что владеет станцией.", false],
		[2, "", "В повседневных делах колонию представляют колониальные чиновники. На станции [[station/0]] улов пилота скупает [[character/9]], заодно раздавая непрошеные советы.", false],
		[7, "", "С местными угрозами разбирается служба безопасности станции, а чиновники передают такую работу вольнонаёмным. Когда вокруг станции [[station/1]] скапливаются наутилусы, её служба безопасности хочет от них избавиться, и Джек отправляет пилота разобраться с этим.", false],
		[9, "", "Чиновники ждут, что новички сначала заслужат доверие, прежде чем получат важную работу. Пилот должен выполнить контракты с панели заданий, прежде чем колония предложит что-то посерьёзнее. Безымянные чиновники, которых пилот встречает под именем [[character/6]], как правило, неприветливы и платят как можно меньше.", false],
		[1, "Твёрдые цены", "Станции колонистов не торгуют. Рынка и фабрики там нет: когда корабль причаливает, станция просто забирает всё содержимое трюма и платит за каждый предмет минимальную цену — самую низкую, какую он вообще может стоить. Сначала рассчитывается поставка, которую заказала сама станция, всё остальное уходит по твёрдой цене. Для рыбака, которому больше некуда продавать улов, в этом и заключается вся экономика.", false],
		[1, "", "Из-за этого рыбаки колонии остаются бедными. Минимальная цена часто меньше половины того, что тот же улов мог бы принести в другом месте, а другого покупателя нет.", false],
		[1, "Рынки и цены", "Свободные рынки есть только на станциях вне колониального контроля. Там цена товара зависит от расстояния. У каждого товара есть родная станция, где он продаётся по минимальной цене, и лучший рынок, где он достигает максимальной. Между ними цена растёт с расстоянием по карте от родной станции. Три импортных товара — «[[goods/33]]», «[[goods/34]]» и «[[goods/35]]» — устроены наоборот и дешевле всего на своём лучшем рынке. Рынок покупает и продаёт по одной цене, так что прибыль приносит перевозка товаров, а не торг. Подробнее: [[guide/trading]].", false],
		[1, "", "Технический уровень станции влияет и на её магазины. На развитых станциях корабли и оборудование дешевле: каждый технический уровень снижает цену корпуса на один процент, и оборудование тоже стоит немного меньше. По мере развития сюжета редкое оборудование попадается чаще.", false],
		[1, "Фабрики и рецепты", "Фабрики превращают сырой улов и импорт в продукцию. У каждого продукта есть фиксированный рецепт и минимальный технический уровень. Для товара «[[goods/21]]» нужны [[species/4]] и [[species/17|зелёные водоросли]]; для товара «[[goods/22]]» — [[species/10]] и «[[goods/35]]»; товар «[[goods/29]]» сочетает «[[goods/20]]» и краску. Сложные продукты, такие как «[[goods/41]]», требуют других продуктов в качестве ингредиентов, так что производственная цепочка может превратить дешёвую рыбу в ценные товары.", false],
		[1, "", "Фабрика может производить всё, что не превышает технический уровень её станции. Большинству продуктов достаточно уровня 1, но по меньшей мере один предмет можно построить только на самой развитой станции. Рецепт указан на странице каждого продукта.", false],
		[1, "Панель заданий", "Контракты — способ, которым колония нанимает вольнонаёмных. На панели заданий от одного до восьми предложений, у каждого есть заказчик, залог, который вносится при принятии, и вознаграждение за успешное выполнение. Вознаграждение растёт со сложностью и расстоянием, а сложность — с рангом пилота. Большинство заданий отправляют пилота на другую станцию, обычно в пределах полосы глубин корабля. Подробнее: [[guide/contracts]].", false],
		[1, "", "Что предлагает панель, зависит от того, кто владеет станцией. Колонисты нанимают сопровождающих и налётчиков на конвои, охотников и охрану для запусков капсул. Свободные станции размещают заказы на доставку и улов и платят за защиту стай животных. Обе стороны предлагают награды за головы, спасательные операции, охоту на пиратов, перевозку пассажиров и уборку.", false],
		[9, "", "Панель заданий открывается пилоту только после первых заданий для колонии, в [[chapter/9|главе 9]]. Карта станции становится доступна немного раньше.", false],
		[1, "Закон и порядок", "Колония блюдёт свой закон и в воде. Станции платят награду за каждого пирата, уничтоженного за рейс, и получить её можно при стыковке. Сумма равна квадрату числа пиратов, умноженному на 100 кредитов на станции колонистов и на 50 на свободной станции, так что одна долгая охота приносит гораздо больше нескольких коротких.", false],
		[12, "", "Не все воды принадлежат колонии. Станции, которые удерживает сопротивление, считают окружающие воды нейтральной территорией и окликают незнакомые корабли, прежде чем разрешить им причалить.", false],
		[35, "", "Некоторая торговля незаконна. По меньшей мере на некоторых станциях запрещены интоксиканты, что оставляет место для торговцев с чёрного рынка, таких как [[character/8]]. Службы безопасности нанимают охотников за головами, таких как [[character/11]], чтобы избавляться от подобных людей.", false],
		[12, "Колония в сюжете", "Для пилота колония сначала работодатель, а затем противник. Джек платит твёрдые цены, истребление наутилусов у станции [[station/1]] оплачивается плохо, а защита капсул у станции [[station/2]] заканчивается тем, что Джек вовсе отказывается платить. Сытый всем этим по горло, пилот следует совету M.A.I. и отправляется искать сопротивление на станцию [[station/3]].", false],
		[13, "", "Сопротивление выступает против контроля колонии над торговлей и против эксплуатации планеты. Его участники хотят свободной торговли, честных цен и бережного рыболовства.", false],
		[18, "", "Сначала повстанцы завоёвывают станции дипломатией, убеждая их руководителей перейти на другую сторону. Каждая присоединившаяся станция открывает пилоту рынок и фабрику, так что экономика колонии меняется станция за станцией. Начинаются разговоры о революции.", false],
		[23, "", "Колония не сдаёт свои станции без боя. Джек, к тому времени фигура довольно влиятельная, устанавливает минное поле, чтобы перерезать путь снабжения повстанцев у станции [[station/9]].", false],
		[25, "", "Затем Джек устраивает засаду на лидера повстанцев по пути на переговоры на станции [[station/10]].", false],
		[28, "", "Колония покупает и предателей. Джек назначает награду за лидера повстанцев и пилота, и деньги берёт пилот повстанцев — это [[character/3]].", false],
		[31, "", "Кроме того, колония соперничает с повстанцами в технологиях. Её люди похитили прототип, созданный [[world/abel|профессором Абелем]], — это [[world/biotek]], — и пытаются доделать его сами.", false],
		[37, "", "Жадность ослабляет колонию изнутри. Сам Джек продаёт станционную пушку [[world/eclipse|Eclipse]] торговцу с чёрного рынка, а тот перепродаёт её пилоту.", false],
		[44, "", "В последней демонстрации силы колонисты наносят удар глубоко на территории повстанцев и атакуют станцию [[station/14]], но их отбрасывают, когда в бой против них вступают Аквариане.", false],
		[45, "", "После этого поражения повстанцы решают добить колонию двумя крупными наступлениями — по одному в каждом полушарии.", false],
		[47, "", "Южные станции падают, и у колонистов остаётся последний крупный оплот — сильно укреплённая станция [[station/0]].", false],
		[48, "", "В последней битве Gosu падает. Джек спасается в спасательной капсуле, и колониальная власть над океаном приходит к концу: все станции в руках повстанцев.", false],
	],
	"world/eclipse": [
		[33, "", "Eclipse — тяжёлая пушка, созданная для обороны станций. Она настолько энергоёмка, что её никогда не предполагали ставить на подлодку. На втором этапе плана повстанцев пилот должен раздобыть такую пушку, чтобы соединить её с [[world/biotek|Биотек-генератором]], который может дать достаточно энергии для стрельбы с корабля. В списке оборудования это оружие значится как [[equipment/42]], а пушка в ящике, которой торгуют по сюжету, — как «[[goods/38]]».", false],
		[33, "Происхождение", "Eclipse относится к классу станционных орудий, предназначенных для стационарной обороны. Именно из-за энергопотребления она и оставалась на станциях: ни одна корабельная силовая установка не смогла бы поддерживать её огонь. Пилот уже знает о ней как о стационарном орудии, поэтому план повстанцев установить её на корабль звучит так неправдоподобно.", false],
		[33, "", "Пушки Eclipse производят на станции [[station/188]], которая в начале плана находится в руках колонистов. Ближайшая подходящая станция под контролем повстанцев — [[station/15]]. На открытом рынке это оружие не продаётся вовсе.", false],
		[33, "", "Повстанцам оно нужно, потому что их меньше. Вместо того чтобы тягаться с колонистами корабль на корабль, они надеются, что оружие такой мощи на подлодке сможет склонить чашу весов.", false],
		[33, "Как добыть пушку", "Чёткого плана, как её заполучить, у Аюми нет — это [[character/2]]. Она выдаёт пилоту 100 000 кредитов на любые взятки, какие понадобятся, и отправляет на Choral осмотреться.", false],
		[35, "", "На Choral к пилоту подходит торговец с чёрного рынка — это [[character/8]], — который утверждает, что за деньги может достать почти что угодно. Он попробует найти Eclipse, но только если пилот сначала убьёт охотника за головами, нанятого, чтобы от него избавиться, — это [[character/11]].", false],
		[37, "", "Когда Рауль мёртв, Фенко добывает Eclipse по высокой цене. Он купил пушку у [[character/9|Джека]], который, судя по всему, продал её ради наживы, не зная, что она окажется у его врагов.", false],
		[38, "", "Пилот покупает оружие и везёт его на станцию [[station/14]].", false],
		[39, "", "[[character/2]] предпочитает не спрашивать, как была добыта пушка. Она с облегчением слышит, что ради неё не погибли невинные. Когда пилот шутит, что план сводится к порабощению всей планеты, она решительно отвергает эту мысль.", false],
		[42, "Eclipse в деле", "Когда «[[goods/36]]» прибывает на Fiir, [[world/abel|профессор Абель]] подключает пушку к прототипу генератора, и Eclipse можно устанавливать на подлодку пилота. Повстанцы предупреждают, что источник энергии — пока лишь прототип. Пилоту приказано испытать оружие на банде пиратов у станции [[station/17]].", false],
		[43, "", "Испытание проходит настолько удачно, что пираты вызывают подкрепление. Сразу после этого пушку ждёт настоящее испытание, когда колонисты атакуют Fiir; Джек не может поверить, что у пилота на борту Eclipse.", false],
		[45, "", "После обороны Fiir повстанцы берут станцию [[station/188]] и перед последними наступлениями начинают ставить Eclipse на как можно больше своих кораблей.", false],
		[47, "", "В битвах за станции [[station/18]] и [[station/109]] пушка проявляет разрушительную силу, и [[character/5]] не скупится на похвалы.", false],
		[37, "В игре", "В главах около [[chapter/37|главы 37]] Eclipse в ящике продаётся на Choral как сюжетный товар. Он стоит гораздо дороже любого обычного товара и больше нигде не продаётся.", false],
		[42, "", "В [[chapter/42|главе 42]] [[equipment/42]] появляется в магазине оборудования на станции [[station/14]], и её установка ничего не стоит. Пока она не установлена, панель заданий и карта закрыты, а корабль не может покинуть станцию. На корабль можно установить только одну пушку Eclipse, и продать её нельзя, пока война не выиграна.", false],
		[42, "", "Как оружие она превосходит всё, что есть в продаже. Каждый её выстрел бьёт сильнее, чем любое другое орудие в игре, на дальности около 240 м, а стреляет она примерно раз в секунду. Она стреляет вместе с остальной батареей орудий, так что сочетается с любым другим установленным оружием.", false],
	],
	"world/history": [
		[1, "", "Кампания рассказывает о молодом пилоте подводной лодки, который прибыл на далёкую океанскую планету, чтобы работать рыбаком на местную [[world/colony|колонию]] людей. Колонисты живут на станциях, разбросанных по глубинам [[world/ocean|океана]], и колония зависит от того, что её пилоты ловят, продают и перевозят между станциями. У пилота есть небольшая, скромно оснащённая подлодка, которую он делит с [[character/1]] — бортовым компьютером корабля, у которого всегда наготове совет или мнение. Имя пилоту выбирает игрок; в этом справочнике главного героя называют просто пилотом.", false],
		[1, "", "История разворачивается на протяжении 48 глав. Она начинается с будней рыбака: ловля морских существ, продажа улова, случайные подработки, чтобы свести концы с концами. Постепенно сюжет перерастает в конфликт о том, как следует обращаться с морем планеты и его обитателями и кто вправе это решать. По пути пилот имеет дело с чиновниками станций, торговцами, [[faction/pirates|пиратами]] и куда более странными обитателями глубин, и выбор одного рыбака оказывается гораздо важнее, чем кто-либо мог предположить.", false],
		[1, "Акт I. Рыбак на службе колонии", "История начинается в открытом море в [[chapter/1|главе 1]]. Пилот уже жалеет о переезде на планету, но [[character/1]] напоминает, что они здесь, чтобы рыбачить, и первая задача проста: загарпунить существо и затащить его в трюм. Первые сцены заодно знакомят с ловлей морских обитателей.", false],
		[2, "", "Когда первое существо поймано, [[character/1]] показывает, как автопилот может взять управление на себя, и в [[chapter/2|главе 2]] пилот берёт курс на станцию [[station/0]] — станцию колонистов, где продаётся улов.", false],
		[3, "", "На станции [[station/0]] пилот имеет дело с чиновником колонии, который скупает улов, — это [[character/9]]. [[character/9]] платит свою обычную твёрдую цену, насмехается над маленьким трюмом и поучает новичка, что каждый должен вносить свою лепту в общее дело колонии. Вдобавок он язвительно замечает, что пилот с настоящей пушкой мог бы заработать больше на охоте за [[faction/pirates|пиратами]]. Когда он уходит, [[character/1]] называет его дураком, но намёк понимает: в ангаре как раз продаётся [[equipment/0]]. В [[chapter/3|главе 3]] пилот покупает и устанавливает это оружие.", false],
		[4, "", "Впервые получив оружие, пилот в [[chapter/4|главе 4]] покидает станцию, чтобы испытать его, а [[character/1]] предостерегает от стрельбы по безобидным рыбам. В местных водах пиратов не оказывается, так что охоту приходится перенести в другое место.", false],
		[5, "", "[[character/1]] объясняет, как устроены дальние путешествия: корабли преодолевают огромные расстояния через [[world/stream|сеть S.T.R.E.A.M.]], всегда покидая район через точку выхода и прибывая в следующий через точку входа. В [[chapter/5|главе 5]] у станции [[station/1]] появляется одинокий пират. После короткого урока о переключении оружия, автоогне и радаре пилот вступает в свой первый бой.", false],
		[6, "", "Пират уничтожен, и [[character/1]] показывает, как подбирать гарпуном грузовые ящики, оставшиеся после обломков, пока они не ушли на недосягаемую глубину. С исправным оружием и небольшой добычей пилот в [[chapter/6|главе 6]] возвращается на станцию [[station/0]].", false],
		[7, "", "На станции [[character/9]] доволен, что его совету последовали, и предлагает, по его словам, настоящую работу. [[species/0|Наутилусы]] заполонили пути конвоев вокруг станции [[station/1]], и служба безопасности станции хочет от них избавиться. Пилот возражает, что животные лишь объедают наросты на корпусах станции и что никакой маленький трюм не вместит их всех, но [[character/9]] и знать не хочет, каким образом они исчезнут. В [[chapter/7|главе 7]] пилот расчищает от них воды — гарпуном или пушкой. Ни пилоту, ни [[character/1]] эта работа не по душе: существ немного, и они безобидны.", false],
		[8, "", "Истребление животных потрясает пилота. Он прибыл на планету рыбачить, а не убивать животных ради удобства станции, и [[character/1]] остаётся лишь надеяться, что плата это возместит. В [[chapter/8|главе 8]] они причаливают к станции [[station/1]] за вознаграждением.", false],
		[9, "", "Местный чиновник колонии ([[character/6]]) обращается с пилотом как с нанятым истребителем вредителей и признаёт, что работа, скорее всего, бесполезна: наутилусы всё равно возвращаются. Плата — ровно 1000 $, и торговаться бесполезно: хочешь — бери, не хочешь — не бери. Дальнейшая работа зависит от того, докажет ли пилот свои способности, выполнив три контракта с панелей заданий станций. [[chapter/9|Глава 9]] отправляет пилота на вольные заработки: сопровождение, сбор грузов и заказы на улов — всё, что окажется в пределах досягаемости.", false],
		[10, "", "Три выполненных задания приносят пилоту скупое одобрение чиновника и особое поручение. Странные существа, которых колонисты называют [[world/aquarians|Аквариане]], — наполовину люди, наполовину рыбы — нападают на транспортные капсулы, которые выводят товары колонии на орбиту, где их забирают грузовые корабли. Пропавшие и повреждённые капсулы портят станции репутацию в глазах [[world/colony|торговой администрации]], поэтому пилота отправляют на станцию [[station/2]] отогнать нападающих. Следующим запуском будет руководить [[character/9]].", false],
		[10, "", "В [[chapter/10|главе 10]] запуск уже идёт, когда пилот прибывает на место, и Аквариане действительно атакуют капсулы. [[character/9]] без обиняков предупреждает по радио: пилот сохранит работу, только если будет потеряно не больше пяти капсул.", false],
		[11, "", "Атака отбита, но вопросы остаются. Пилот не понимает, зачем Аквариане вообще нападают на капсулы, и [[character/1]] предполагает, что они гораздо умнее, чем думают колонисты. Со всё большим беспокойством относясь к такой работе, пилот в [[chapter/11|главе 11]] причаливает к станции [[station/2]] с докладом.", false],
		[12, "Акт II. Сопротивление", "Приём, который оказывает [[character/9]], переполняет чашу терпения пилота. Джек обвиняет пилота в повреждении капсул, отменяет награду и уходит, бормоча, что ему суждены великие дела. Тогда [[character/1]] говорит вслух то, что чувствуют оба: пилот целыми днями работает на колонию, получает гроши и не может распоряжаться своим уловом — его просто забирают по твёрдой цене. Пилот хочет лишь накопить на билет с планеты, но у [[character/1]] другая идея.", false],
		[12, "", "Прослушивая радиодиапазоны, [[character/1]] уловила признаки движения сопротивления, которое ведёт передачи со станции [[station/3]]. Решение остаётся за пилотом: он понимает, что это может обернуться серьёзными неприятностями, и всё же соглашается. Отныне [[character/1]] отмечает станции движения на карте зелёным (см. [[faction/rebels]]).", false],
		[12, "", "В [[chapter/12|главе 12]] попытка незаметно подойти к станции [[station/3]] сразу проваливается. Охрана станции окликает корабль и грозит открыть огонь, а пилот, запинаясь, называет своё имя, говорит, что путь начался на станции [[station/0]], и просит принять его в движение. После долгого молчания кораблю разрешают причалить.", false],
		[13, "", "Внутри новичка засыпает путаными вопросами [[character/4]]. Пилот признаётся, что почти ничего не знает, кроме того, что движение выступает за свободную торговлю. Это сходится с тем, что признаёт сам [[character/4]]: повстанцы начали шифровать радиопереговоры всего несколько дней назад. Помощников не хватает, и [[character/4]] берёт пилота на испытательный срок. Движение намерено проникнуть на станции колонистов, убедить их руководителей перейти на другую сторону и положить конец эксплуатации планеты и её обитателей.", false],
		[13, "", "Делиться планами с незнакомцем [[character/4]] не станет, так что сначала пилот должен доказать свою полезность. В [[chapter/13|главе 13]] нужно забрать сочувствующих на станции [[station/4]] и доставить их на станцию [[station/5]]. По пути пилот признаётся [[character/1]], что всё это для него загадка, но соглашается, что это лучше, чем выполнять приказы, которые отдаёт [[character/9]].", false],
		[14, "", "Связным на станции [[station/4]] оказывается единственный пассажир — [[character/5]]. Она приветлива и бойка и явно рада знакомству с пилотом, а пилот так же явно ею очарован. Объяснять планы движения она отказывается, говоря, что именно скрытность так долго помогала ему выжить, и передаёт координаты маршрута. [[character/1]] наблюдает за ними с открытым раздражением, и пилот в шутку называет это ревностью. В [[chapter/14|главе 14]] пилот как можно быстрее и безопаснее доставляет [[character/5]] на станцию [[station/5]].", false],
		[15, "", "На станции [[station/5]] [[character/5]] уходит в подполье, чтобы уладить кое-какие дела, но сначала объясняет, почему повстанцы держатся в стороне от колонистов. Они не выкачивают из моря ресурсы. Они берут то, что море может отдать без ущерба, перерабатывают улов в товары и стараются не вылавливать лишнего, чтобы сохранить разнообразие жизни. Чтобы показать, как это работает, она просит пилота произвести пять тонн товаров на фабрике станции сопротивления ([[chapter/15|глава 15]]). Она советует станцию [[station/90]], где можно наловить спрутов и купить [[goods/35|растворитель]], чтобы сделать [[goods/22|краску]].", false],
		[16, "", "Когда пилот освоил этот второй способ заработка, [[character/5]] выходит на связь с новым заданием. Движению нужны свежие сведения со всех станций, чтобы находить слабые места и склонять население на свою сторону, ведь убеждение будет значить не меньше, чем огневая мощь. На вопрос пилота, не революция ли это, она отказывается говорить больше. В [[chapter/16|главе 16]] пилот объезжает станции, на которых ещё не бывал, попутно зарабатывая на улучшение корабля.", false],
		[17, "", "Длинное сообщение от [[character/4|Пьера]], которое [[character/1]] сводит к одной строчке, вызывает пилота обратно на станцию [[station/3]] ([[chapter/17|глава 17]]). Тем временем зона повстанцев растёт: к движению перешли станции [[station/6]], [[station/12]], [[station/106]] и [[station/180]].", false],
		[18, "Акт III. Лидер", "[[character/4]] объясняет, что дипломатия незаметно расширила зону повстанцев, так что теперь пилот может торговать на гораздо большем числе станций. Новостные каналы уже говорят о революции. Многие влиятельные люди примкнули к движению без единого выстрела, хотя [[character/4]] рано или поздно ждёт кровопролития. Следующими шагами руководит лидер движения с одной из недавно перешедших станций, и пилоту нужно найти этого лидера — или, вернее, дать себя найти. [[character/4]] отмечает возможные станции и предупреждает, что до некоторых не добраться без брони или щита получше.", false],
		[18, "", "На [[character/1]] организация движения не производит впечатления, и [[chapter/18|глава 18]] превращается в поиски, в которых почти не на что опереться, кроме удачи.", false],
		[19, "", "След приводит на станцию [[station/6]], где пилота встречает [[character/2]] — немолодая женщина, которая возглавляет движение и отныне будет отдавать приказы. Пилот полагал, что лидер — мужчина, но она не придаёт этой ошибке значения. Её первое поручение — сопровождение. Стаю животных — это [[species/10]] — нужно проводить в безопасные воды у станции [[station/7]], прежде чем колонисты успеют их поймать или перебить, и боя, скорее всего, не избежать. [[character/1]] ворчит, что об оплате никто и не заикнулся, а пилот рассуждает, что [[character/2]] сначала хочет понять, можно ли доверять новичку.", false],
		[19, "", "В [[chapter/19|главе 19]] пилот видит, что рядом со стаей плывут Аквариане, и [[character/1]] задаётся вопросом, не заботятся ли они о морских обитателях. Вскоре подходят корабли колонистов, и пилоту приходится перехватывать их, не задевая животных.", false],
		[20, "", "Стая спасена. [[character/2]] платит скромные 2000 $ и сразу же вызывает пилота обратно, а [[character/1]] жалуется, что продажа животных принесла бы куда больше. В [[chapter/20|главе 20]] пилот возвращается на станцию [[station/6]].", false],
		[21, "", "На этот раз пилот прямо спрашивает, за что выступает движение. [[character/2]] описывает союз людей, сплотившихся против разорения планеты и её обитателей. Колонизация идёт так быстро, а природу эксплуатируют так беспощадно, что растения и животные моря скоро не смогут восстановиться. Если ничего не изменится, планета будет истощена, как многие миры до неё. Движение намерено предотвратить это, привлекая на свою сторону влиятельных людей, и пилот обещает помочь.", false],
		[21, "", "Прежде всего [[character/2]] тревожится из-за [[faction/pirates|пиратов]], которые пользуются конфликтом, чтобы охотиться на лёгкую добычу. До сих пор движение лишь оборонялось, теперь же оно атакует пиратское соединение напрямую. Чтобы успокоить нервничающего пилота, она даёт ему сопровождающего — это [[character/3]], один из её лучших пилотов, хотя [[character/1]] подозревает, что на самом деле сопровождает как раз пилот. В [[chapter/21|главе 21]] они встречаются у станции [[station/8]]. [[character/3]] встречает опоздавшего новичка нетерпеливо и снисходительно и велит держаться позади и учиться.", false],
		[22, "", "Банда уничтожена. [[character/3]] нехотя хвалит пилота, но когда [[character/2]] награждает каждого из них 5000 $, Реймонд приходит в ярость из-за того, что деньги поделены поровну, и заявляет пилоту, что новичок не сделал ничего. Пилот и [[character/1]] уходят, пока он не разошёлся ещё сильнее. В [[chapter/22|главе 22]] они отправляются на станцию [[station/9]] на встречу с [[character/2|Аюми]], чьи переговоры там увенчались успехом: станция перешла на сторону движения вместе со станциями [[station/5]], [[station/37]] и некоторыми другими.", false],
		[23, "", "Прежде чем [[character/2]] двинется дальше, нужно обезопасить путь снабжения к станции [[station/37]]. Чтобы перерезать его, [[character/9]] установил минное поле прямо у станции. [[character/2]] его знает: когда-то никто, он быстро поднялся благодаря удачно расставленным друзьям. Горя желанием расстроить его планы, пилот в [[chapter/23|главе 23]] отправляется расчищать поле. [[character/2]] предупреждает, что неподалёку будут кружить пираты и что каждую мину можно уничтожить, только подойдя достаточно близко, чтобы сработал её датчик движения.", false],
		[24, "", "Поле расчищено, путь снова безопасен, и [[character/2]] платит за работу 4000 $. Вернувшись на станцию [[station/9]] в [[chapter/24|главе 24]], пилот видит, что зона повстанцев сильно разрослась. Волна станций по всему океану теперь на стороне движения, среди них [[station/14]], [[station/22]] и [[station/25]].", false],
		[25, "", "На станции пилот снова встречает [[character/5]], и разговор выходит тёплым, но неловким, а [[character/1]] непрошено даёт советы. [[character/2]] прерывает встречу. Новый раунд переговоров на станции [[station/10]] может привлечь новые станции. Туда отправятся она сама и [[character/3]], а пилот и [[character/5]] должны их сопровождать. Пилот не в восторге от того, что с ними пойдёт [[character/3]], но [[character/2]] ручается за его мастерство и не ждёт ничего хуже пиратов.", false],
		[25, "", "В [[chapter/25|главе 25]] группа достигает станции [[station/10]] и сразу чувствует, что что-то не так. Там с силами колонистов поджидает [[character/9]] и приказывает атаковать, а [[character/2]] не может понять, откуда он узнал об их прибытии.", false],
		[26, "Акт IV. Предательство", "Во время боя [[character/3]] не стреляет, заявляет, что у него отказало оружие, и бежит, на ходу извиняясь. Остальные выживают. [[character/2]] подозревает саботаж, а [[character/5]] открыто обвиняет [[character/3|Реймонда]] в предательстве; [[character/2]] защищает его, говоря, что он всегда был ей верен. Пилот признаёт, что случившееся выглядело подозрительно, но торопит всех уходить, пока [[character/9]] не стянул сюда новые корабли.", false],
		[26, "", "Группа расходится. [[character/2]] уходит в подполье, а [[character/5]] ведёт дела движения на станции [[station/9]]. Пилоту велят до следующей встречи стать гораздо более умелым бойцом, ведь теперь ясно, что одной дипломатией борьбу не выиграть. В [[chapter/26|главе 26]] пилот охотится на пиратов и других врагов, увеличивая счёт уничтоженных кораблей.", false],
		[27, "", "Когда пилот становится заметно опаснее, неожиданно выходит на связь [[character/3]]. Он спрашивает, как дела у [[character/2|Аюми]] и [[character/5|Леа]], уверяет, что за время отсутствия собрал важнейшие сведения, и просит о встрече у станции [[station/11]]. [[character/1]] уверена, что это ловушка; пилот соглашается — и всё равно отправляется в путь ([[chapter/27|глава 27]]).", false],
		[28, "", "Ловушка оказывается настоящей. [[character/3]] захватил в плен лидера движения — это [[character/2]] — и требует, чтобы пилот сдался, а [[character/2]] призывает пилота не обращать на неё внимания. По совету [[character/1]] пилот тянет время, чтобы [[character/3]] продолжал говорить, пока компьютер сканирует его корабль. [[character/3]] охотно признаётся, что перешёл на другую сторону ради денег: [[character/2]] платила мало, а [[character/9]] назначил крупную награду и за неё, и за пилота. Когда пилот взывает к идеалам движения, [[character/3]] отвечает, что идеалами сыт не будешь.", false],
		[28, "", "Сканирование показывает одноместный корабль, значит, [[character/2]] должна быть заперта в его сильно бронированном грузовом отсеке. Пилот открывает огонь. [[character/3]] оказывается быстрым и опасным противником, но его корабль уничтожен, и пилот подбирает гарпуном грузовой контейнер, пока тот не ушёл слишком глубоко. В [[chapter/28|главе 28]] пилот везёт его на станцию [[station/12]], ближайшую безопасную станцию, в надежде, что [[character/1]] верно угадала его содержимое.", false],
		[29, "", "[[character/1]] не ошиблась. [[character/2]] выбирается наружу потрясённой, но невредимой и благодарит пилота за спасение. Отдыхать некогда: перед похищением она организовывала переброску группы высококлассных учёных на станцию [[station/14]], и [[character/3]], возможно, уже выдал подробности. Зачем нужны учёные, она пока не объясняет и отправляет пилота проследить, чтобы их конвой благополучно пересёк пограничную зону ([[chapter/29|глава 29]]). У станции [[station/13]] пилот застаёт конвой уже под сильным огнём и взывающим о помощи.", false],
		[30, "", "Конвой прорывается, и его экипажи считают, что обязаны пилоту жизнью. [[character/2]] платит 5000 $ и назначает встречу на станции [[station/14]], обещая объяснить, что будет дальше ([[chapter/30|глава 30]]).", false],
		[31, "Акт V. Три этапа", "На станции [[station/14]] пилота ждут [[character/5]], [[character/4]] и [[character/2]]. Наконец [[character/2]] посвящает пилота в свой план. Стычки с колонистами учащаются, а повстанцев по-прежнему меньше, поэтому она доставила на станцию [[world/abel|профессора Абеля]] и его команду, чтобы создать оружие, способное переломить ход борьбы. Проект состоит из трёх этапов. Первый — источник энергии, [[world/biotek|Биотек-генератор]]: эту технологию изучали годами, но так и не получили рабочего прототипа. Абель почти закончил свой, когда колонисты его похитили, и теперь они пытаются доделать его сами.", false],
		[31, "", "[[character/2]] уходит на встречу с Абелем, и инструктаж продолжает [[character/5]]. По сведениям информатора, генератор переправляют на Maarth на обычных грузовых судах, чтобы не привлекать внимания, и это даёт повстанцам шанс ударить у станции [[station/2]]. Никто не знает, на каком корабле генератор, поэтому придётся, хочешь не хочешь, остановить весь конвой и подобрать каждый контейнер. В [[chapter/31|главе 31]] пилот, [[character/5|Леа]] и [[character/4|Пьер]] перехватывают конвой. Экипажи умоляют пощадить их, уверяя, что везут только еду и лекарства, а [[character/4]] отвечает, что повстанцам как раз очень нужно и то и другое.", false],
		[32, "", "Все контейнеры подобраны, и в [[chapter/32|главе 32]] команда доставляет добычу на станцию [[station/14]].", false],
		[33, "", "Абель забирает груз в свою лабораторию, чтобы работать над прототипом, а [[character/2]] раздаёт новые обязанности. [[character/5]] будет патрулировать окрестности станции на случай внезапного нападения, [[character/4]] нужен в ангаре, а пилоту достаётся второй этап. Генератору нужно оружие, достойное его мощности, и [[character/2]] выбрала [[equipment/42]] — [[world/eclipse|стационарную оборонительную пушку]], которую из-за огромного энергопотребления до сих пор не ставили ни на один корабль.", false],
		[33, "", "Ближайшая станция, где производят такие пушки, — [[station/188]] — в руках колонистов, поэтому [[character/2]] отправляет пилота на станцию повстанцев [[station/15]]. Это оружие нигде не продаётся, и на этом её план заканчивается. Она просто выдаёт 100 000 $ на любые взятки, какие понадобятся. Пилот называет это самым расплывчатым планом, о каком он когда-либо слышал, и с радостью соглашается, и [[chapter/33|глава 33]] приводит пилота на станцию, чтобы осмотреться.", false],
		[34, "", "Без связей и без настоящего плана пилот для начала изучает товары местного торговца. В [[chapter/34|главе 34]] след ведёт к партии товара «[[goods/37]]» — наркотика, запрещённого на этой станции.", false],
		[35, "", "Сделка привлекает внимание торговца с чёрного рынка — это [[character/8]]. Он говорит о себе в третьем лице и утверждает, что может достать почти что угодно. Услышав просьбу раздобыть [[equipment/42]], он поражён и спрашивает, не собирается ли пилот развязать войну. Тем не менее [[character/8]] соглашается попробовать в обмен на услугу: пилот должен убить охотника за головами, которого служба безопасности наняла, чтобы избавиться от самого торговца. Этого охотника зовут [[character/11]]. В [[chapter/35|главе 35]] пилот находит его: [[character/11]] патрулирует окрестности станции со своим сопровождением и отмахивается от пилота как от простого рыбака.", false],
		[36, "", "Когда бой оборачивается против него, [[character/11]] пытается договориться, но его корабль уничтожен. В [[chapter/36|главе 36]] пилот возвращается на станцию [[station/15]] в надежде, что торговец сдержит слово.", false],
		[37, "", "[[character/8]] не подводит. Он отыскал [[equipment/42]] и готов продать пушку, но по цене, раздутой из-за взяток, которые он, по его словам, заплатил. На вопрос, откуда у него такая пушка, он называет продавца — это [[character/9]]. [[character/1]] наслаждается иронией: [[character/9]] из жадности вооружает своих злейших врагов. В [[chapter/37|главе 37]] пилот покупает пушку и грузит её на борт.", false],
		[38, "", "С пушкой в трюме второй этап завершён, и в [[chapter/38|главе 38]] пилот возвращается на станцию [[station/14]] узнать, как продвигается работа над прототипом.", false],
		[39, "", "[[character/2]] предпочитает не знать, как была добыта пушка, и лишь надеется, что обошлось без крови; пилот осторожно отвечает, что невинные не пострадали. Прототип почти готов, но ему не хватает одного небольшого устройства, которое на станции сделать нельзя: это [[goods/36]], который копирует генетический материал частиц водорослей и тем самым запускает реакцию, питающую генератор. [[character/2]] признаётся, что лишь повторяет объяснение Абеля. Когда пилот с усмешкой называет устройство третьим шагом к порабощению всей планеты, она резко отвергает эту мысль.", false],
		[39, "", "Оборудование для изготовления инкубатора есть только на станции [[station/16]], поэтому [[chapter/39|глава 39]] отправляет пилота туда за третьим этапом. [[character/1]] жалуется, что пилот, похоже, в одиночку тянет на себе всё восстание.", false],
		[40, "", "На станции становится ясно, что сделать инкубатор будет совсем не просто, и [[chapter/40|глава 40]] превращается в непростую производственную задачу.", false],
		[41, "", "Инкубатор готов, к нескрываемому удивлению [[character/1]]. Всё ещё не уверенный, что поступает правильно, пилот в [[chapter/41|главе 41]] везёт его на станцию [[station/14]].", false],
		[42, "", "[[character/5]] с восторгом встречает пилота и инкубатор, а [[character/1]] объявляет, что лучше выключится, чем будет это слушать. У Абеля всё готово, и [[equipment/42]] скоро должна появиться в ангаре. [[character/2]] хочет немедленно испытать пушку на пиратах, и [[character/5]] передаёт координаты, предупреждая, что генератор — пока лишь прототип. [[character/1]], якобы находящаяся в режиме ожидания, даёт понять, что слышала каждое слово.", false],
		[42, "", "В [[chapter/42|главе 42]] пилот устанавливает пушку и атакует пиратское логово у станции [[station/17]]. Пираты быстро понимают, с чем имеют дело, и вызывают подкрепление.", false],
		[43, "Акт VI. Война за океан", "Испытание прерывает сигнал бедствия со станции [[station/14]], переданный открыто, по нешифрованному каналу. В [[chapter/43|главе 43]] пилот спешит назад и застаёт станцию под внезапной атакой колонистов. Многие причалы поражены, повстанцы не могут выпустить достаточно кораблей, и [[character/2]] считает, что всё кончено. Штурмом руководит [[character/9]]; он насмехается над пилотом, рыбачащим на повстанцев, пока не узнаёт, что [[equipment/42]] вот-вот откроет огонь.", false],
		[44, "", "В разгар битвы появляются [[world/aquarians|Аквариане]] и обрушиваются на колонистов, сражаясь на стороне повстанцев. Атака захлёбывается, и [[character/9]] бежит, как только понимает, что она проиграна. [[character/2]] называет спасение чудом и просит пилота причалить, обещая особого гостя ([[chapter/44|глава 44]]).", false],
		[45, "", "[[character/2]] признаёт, что налёт застал повстанцев врасплох — никто не ожидал, что колонисты ударят так глубоко в водах повстанцев, — и что станцию защищали не только они. Гость — посланник Аквариан, немного понимающий человеческий язык. Через него Аквариане предлагают помочь покончить с господством колонистов. Когда все станции будут взяты, а флот колонистов разбит, все должны будут жить в гармонии с природой.", false],
		[45, "", "С помощью Аквариан [[character/2]] планирует два крупных наступления, чтобы взять оставшиеся станции в северном и южном полушариях. Станция [[station/188]] пала, и повстанцы ставят [[equipment/42]] на столько кораблей, на сколько могут. Чтобы воспользоваться внезапностью, пока это возможно, лидер движения поручает пилоту штурм станции [[station/18]], а [[character/5]] отправляет на станцию [[station/109]]. Когда пилот начинает волноваться, ведь в бой идёт [[character/5]], [[character/2]] подшучивает над его явной привязанностью и напоминает, что [[character/5]] и сама опытный пилот.", false],
		[45, "", "В [[chapter/45|главе 45]] пилота на месте ждёт [[character/12]], командир отряда Атмос, готовый к приказу об атаке, а из глубины поднимается группа Аквариан. Уничтожить нужно все корабли колонистов, включая грузовые.", false],
		[46, "", "Защитники уничтожены. Пилот отправляет половину отряда [[character/12|Колина]] патрулировать окрестности станции, а с остальными причаливает ([[chapter/46|глава 46]]). В то же время на другую сторону переходит огромная волна станций — от [[station/1]] и [[station/2]] до [[station/11]], [[station/18]] и [[station/109]].", false],
		[47, "", "[[character/5]] сообщает, что её штурм тоже удался и что [[equipment/42]] показала разрушительную силу; пилот отдаёт должное и Акварианам. Все южные станции теперь в руках повстанцев. [[character/2]] передала, возможно, последнее задание: станция [[station/0]] — последний крупный оплот колонистов и та самая станция, где началась история пилота. Она сильно укреплена, и [[character/2]] уже в пути, чтобы лично возглавить атаку. [[character/5]] идёт следом, задержанная пиратами на маршруте, и в [[chapter/47|главе 47]] пилот присоединяется к ним в последней битве.", false],
		[47, "", "Обороной командует [[character/9]]; он хвастается, что с удовольствием уничтожит корабль пилота, и пилот узнаёт в этих словах отголосок того, что перед гибелью говорил [[character/3]]. Узнав, что [[character/3]] погиб от руки пилота, [[character/9]] пытается выбить пилота из колеи, заявляя, что он — отец пилота, а [[character/3]] — брат пилота. Пилот, у которого нет брата и который прекрасно помнит лицо своего отца, сразу отметает эту ложь.", false],
		[48, "", "Флот колонистов гибнет корабль за кораблём, пока не остаётся только [[character/9]]. Он быстр, и в него трудно попасть, но по совету [[character/1]] пилот уклоняется от его атак и бьёт с тыла. [[character/9]] уходит в спасательной капсуле, которая, к изумлению [[character/5|Леа]], похоже, уносит с собой всю станцию. На прощание он презрительно бросает, что в глубинах нет ничего стоящего и что рыба его никогда и не интересовала.", false],
		[48, "", "С бегством [[character/9|Джека]] война окончена, и в [[chapter/48|главе 48]] станция [[station/0]] и последние непокорные станции переходят к движению. Пилот настаивает, что победа принадлежит всем. [[character/1]] требует свою долю славы, и ей обещают расширение памяти, как только пилот вернётся на твёрдую землю, — на что она возмущённо заявляет, что ей это ни к чему. [[character/2]] благодарит всех и признаёт, что раны планеты будут заживать долго, но верит, что и с этим они справятся. [[character/5]] приглашает пилота отпраздновать за [[goods/21|суши]], и пилот с радостью соглашается.", false],
		[48, "Темы", "Главный конфликт — о том, как следует пользоваться морем. Колония видит в нём ресурс, который нужно добывать и отправлять на орбиту: она скупает улов по твёрдым ценам и истребляет животных, которые мешают. Движение выступает за то, чтобы брать лишь то, что море может отдать без ущерба, беречь разнообразие жизни и свободно торговать. Первые задания пилота — истребление наутилусов и защита капсул — показывают колониальные порядки изнутри. Растущее неприятие этих порядков и делает правдоподобным переход пилота к сопротивлению.", false],
		[48, "", "Аквариане проходят тот же путь. Сначала они предстают вредителями, нападающими на капсулы колонии, и пилоту платят за то, чтобы их отогнать. Позже их видят оберегающими морских существ, а на станции [[station/14]] они переламывают проигранную битву. Задним числом их ранние набеги выглядят их собственным сопротивлением разграблению океана, хотя о мотивах Аквариан игра по большей части оставляет догадываться.", false],
		[48, "", "Через всю историю проходят темы денег и верности. [[character/3]] предаёт движение ради награды, а [[character/9]] продаёт ту самую пушку, которая позже срывает его атаку на станцию [[station/14]]. Пилот начинает с желания лишь накопить на билет домой, а заканчивает одним из командиров движения, тогда как жалобы [[character/1]] на скудную плату становятся не мотивом, а сквозной шуткой.", false],
		[48, "", "Большую часть ранних успехов движение добивается убеждением, а засада у станции [[station/10]] отмечает момент, когда убеждения становится недостаточно. Кампания замыкает круг на станции [[station/0]], где когда-то [[character/9]] платил пилоту твёрдую цену за улов. После финальной главы пилот может и дальше рыбачить, торговать и брать контракты по всему океану, который теперь на стороне повстанцев.", false],
	],
	"world/ocean": [
		[1, "", "Океан — место действия DEEP: планета, обитаемый мир которой лежит глубоко под волнами. Поселенцы живут на герметичных станциях в тысячах метров под водой, и единственный способ перемещаться между ними — подводные лодки. Всё, что колония ест, продаёт и строит, добывается из воды — от рыбы и водорослей до товаров, сделанных из них. В этой статье океан описан как место: его глубины, свет, живая природа и то, как эта жизнь отзывается на людей, которые на неё охотятся.", false],
		[1, "", "Пилот прибывает сюда новичком с небольшой рыболовецкой подлодкой и бортовым компьютером [[character/1]] и вскоре жалеет, что сюда перебрался. О тех, кто управляет станциями, рассказывает статья «[[world/colony]]», о путешествиях между ними — [[world/stream|статья о сети S.T.R.E.A.M.]]", false],
		[1, "Глубина и давление", "Главная черта океана — глубина. Морского дна, которое остановило бы погружение, нет: подлодка может опускаться, пока вода её не раздавит. Корабль выживает благодаря полосе безопасных глубин, которую задаёт его оборудование. Щит определяет, насколько высоко он может подняться, а броня — насколько глубоко опуститься. Корпус без того и другого безопасен лишь в узком слое воды примерно от 22 000 до 23 000 м.", false],
		[1, "", "За пределами своей полосы корабль сжимает давление. После нескольких секунд отсрочки вода начинает разрушать его защиту — сначала один слой, затем и сам корпус, — и урон тем больше, чем дальше корабль уходит за 15 000 м вверху или 30 000 м внизу. Короткие вылазки можно пережить, долгие — нет. Показатели каждого предмета оборудования указаны на его странице, а раздел «[[guide/depth]]» подробно объясняет правила.", false],
		[1, "Где находятся станции", "Двести станций, обозначенных на [[chart|карте станций]], закреплены на постоянной глубине, почти все — между 15 000 и 30 000 м. Больше половины из них, 109 станций, расположены между 20 000 и 25 000 м — в той полосе, куда может добраться стартовый корабль [[ship/0]]. Около пятидесяти лежат выше, около сорока пяти — глубже. Крайние случаи — станция [[station/28]], самая высокая, на 13 500 м, и станция [[station/81]], самая глубокая, на 32 250 м.", false],
		[1, "", "Глубина не зависит от географии. Мелководные и глубоководные станции соседствуют по всей карте, так что соседей на карте могут разделять тысячи метров по вертикали. От станции [[station/14]] в центре карты легко добраться и до станции [[station/25]] на 17 700 м, и до станции [[station/81]] далеко внизу. Прокладывая маршрут, пилоту приходится учитывать глубину каждой станции, а не только расстояние. Станция [[station/0]], где начинается карьера пилота, находится на северо-западе, на глубине 22 500 м.", false],
		[1, "Свет и вода", "Дневной свет до станций не доходит. За пределами их освещённых прожекторами корпусов вода темна, и подлодка движется в конусе собственных фар, который вода поглощает уже через несколько десятков метров. В лучах висят и плывут мелкие частицы, а кое-где во мраке слабо светятся пятна светящегося планктона. Подъём выше 15 000 м, к далёкой поверхности, отмечается отдельным достижением — медалью «[[medal/21]]».", false],
		[1, "", "Вода не везде одного цвета. Каждый район приобретает лёгкий оттенок от планктона и водорослей, которые там процветают, и сильнее всего он у станций, где эти водоросли чувствуют себя лучше всего. Медленные течения колышут взвешенные частицы, но это лишь часть пейзажа: они никогда не сбивают подлодку с курса и не уносят улов.", false],
		[1, "Морская жизнь", "В океане обитают тринадцать видов животных и пять видов водорослей. Среди них есть и мелкая лёгкая добыча — [[species/2|медузы]], [[species/0|наутилусы]] и [[species/4|косяки рыбы]], — и сильные пловцы, например виды «[[species/7]]» и «[[species/8]]». К диковинам глубин относятся виды «[[species/5]]», «[[species/1]]», «[[species/6]]», «[[species/9]]» и бронированный «[[species/11]]». Виды «[[species/3]]» и меняющий цвет «[[species/10]]» ценятся за кожу и краску.", false],
		[1, "", "Самое крупное животное — [[species/12]]: он может весить около 30 т, больше, чем вмещает весь трюм маленькой подлодки. Более тяжёлые и выносливые животные дольше сопротивляются на гарпуне и обычно стоят дороже, но ни один вид не стоит везде одинаково. На странице каждого вида перечислены станции, в водах которых он обитает, и товары, которые из него делают.", false],
		[1, "", "У каждой станции свой набор обитателей — обычно пять или шесть видов. Одновременно в водах станции плавает около двадцати животных из этого местного набора. Рыбак быстро узнаёт, на какие станции отправляться за каким уловом, а карта может показать, где водится каждый уже пойманный вид. Подробнее: [[guide/fishing]].", false],
		[1, "Морское дно и водоросли", "Пять видов водорослей — [[species/17|зелёные]], [[species/16|красные]], [[species/15|бурые]], [[species/14|синие]] и ценные [[species/13|золотистые]] — это растения океана. Они не плавают, а растут на одном месте, каждая весит ровно 2 т и почти сразу сдаётся на гарпуне. Их ценность — в том, во что их превращают: для товара «[[goods/21]]» нужны зелёные водоросли, для товара «[[goods/27]]» — золотистые и красные, а для товара «[[goods/28]]» — понемногу всех пяти.", false],
		[7, "", "Водоросли растут и на внешних поверхностях самих станций вместе с другими мелкими организмами. Это любимая пища наутилусов, поэтому эти животные во множестве собираются вокруг станций.", false],
		[1, "Как отзывается живой мир", "Животные не просто ждут, когда их поймают. Существо, раненное выстрелом или шальной пулей, бросается наутёк, а загарпуненное бьётся, пока не выбьется из сил. Убитое наповал животное как улов потеряно: его туша всплывает, и подобрать её можно только как «[[goods/18]]», что стоит лишь малую долю живого животного. Пилоты, которым нужен чистый улов, держат пушки подальше от рыбы.", false],
		[1, "", "В игре воды никогда не оскудевают. Когда пилот уходит, оставшаяся живность восполняется, так что хорошее место для рыбалки остаётся хорошим. Борьба за морскую жизнь проявляется вместо этого на панели заданий: одни заказчики платят за истребление вида, другие — за защиту стаи животных от охотников. См. «[[contract/7]]» и «[[contract/6]]».", false],
		[4, "", "С того момента, как у пилота появляется пушка, [[character/1]] предостерегает от стрельбы по той самой рыбе, ради ловли которой они сюда прибыли.", false],
		[7, "", "Колония считает мешающих ей животных помехой, от которой нужно избавиться. В [[chapter/7|главе 7]] пилота отправляют расчистить от наутилусов воды станции [[station/1]], где те якобы перекрывают пути конвоев.", false],
		[9, "", "Истребление мало что даёт. Чиновник, который за него платит, признаёт, что животные возвращаются, сколько их ни убирай.", false],
		[15, "", "[[faction/rebels|Повстанцы]] смотрят на море иначе. Они берут лишь то, что оно может отдать без ущерба, перерабатывают улов в товары и стараются не вылавливать лишнего, чтобы сохранить разнообразие жизни в океане.", false],
		[19, "", "В [[chapter/19|главе 19]] пилот защищает стаю [[species/10|чернильных спрутов]] у станции [[station/7]] от охотников-колонистов. Рядом с животными плывут Аквариане, по-видимому оберегая их; см. «[[world/aquarians]]».", false],
		[21, "", "По словам лидера повстанцев — это [[character/2]], — стремительная колонизация опустошает океан быстрее, чем его растения и животные успевают восстановиться. Если так пойдёт и дальше, предупреждает она, планета будет истощена, как другие миры до неё.", false],
		[48, "", "Когда к концу войны колониальная администрация исчезает, повстанцы понимают, что океану понадобится много времени, чтобы оправиться, но намерены довести дело до конца.", false],
		[1, "Опасности глубин", "Помимо давления, в океане есть и опасности, исходящие от людей. [[faction/pirates|Пираты]] охотятся на одиночные корабли в открытой воде, а в поздних главах некоторые из них подстерегают добычу у станций. Минные поля, дрейфующие обломки и вооружённые конвои встречаются в контрактах и в сюжете. О том, кто контролирует какую часть океана, рассказывают статьи «[[world/colony]]» и «[[guide/allegiance]]».", false],
	],
	"world/stream": [
		[1, "", "Сеть S.T.R.E.A.M. — система транзитных врат, связывающая станции колонии воедино. У каждой станции на некотором удалении есть врата, и подлодка, вошедшая в одни из них, почти мгновенно выходит из врат другой станции. Без этой сети пересечь [[chart|карту станций]] означало бы совершать долгие плавания в тёмной открытой воде. С ней один пилот может работать по всему океану. Сеть — не только деталь мира, но и важная часть игрового процесса; об управлении рассказывает раздел «[[guide/navigation]]».", false],
		[1, "Врата", "Врата каждой станции находятся в открытой воде, в стороне от причалов. Корабли покидают район станции через её врата и прибывают к вратам пункта назначения, откуда своим ходом подходят к причалу. Врата открываются с близкого расстояния: пилот входит в зону их активации и открывает карту врат, где перечислены все станции в пределах досягаемости.", false],
		[1, "", "Сам переход почти мгновенен. Корабль выходит из дальних врат с тем же уроном, что и был, так что потрёпанная подлодка прибывает такой же потрёпанной. Местные обитатели пункта назначения, патрули и любые поджидающие там события уже находятся в воде.", false],
		[1, "Дальность и двигатели", "Врата не дотягиваются до всего океана. С любой станции они покрывают примерно шестую часть ширины карты. Двигатель получше увеличивает дальность пропорционально своему показателю, так что двигатель с показателем +30% достаёт примерно на тридцать процентов дальше. До станций за пределами досягаемости приходится добираться в несколько переходов или долго плыть на автопилоте, что гораздо медленнее даже с ускорением времени.", false],
		[1, "", "Плавание в открытой воде по-прежнему полезно для коротких поездок. Автопилот ведёт корабль из района одной станции в район следующей, и время при этом можно ускорять до шестнадцатикратного, а при появлении опасности оно возвращается к обычному.", false],
		[1, "", "Сеть никак не учитывает глубину. Врата без возражений доставят корабль к станции за пределами его безопасной полосы глубин, лишь предупредив об этом, и давление начнёт разрушать его защиту сразу по прибытии. Прежде чем отправиться в путь, проверьте глубину пункта назначения на странице станции. Подробнее: [[guide/depth]].", false],
		[1, "Врата и события", "Во время боя врата закрыты. Если в водах станции идёт событие миссии, ни врата, ни причал нельзя использовать, пока оно не завершится. Пилот не может просто ускользнуть из засады через сеть, и каждый контракт приходится довести до конца в бою или провалить.", false],
		[1, "", "Прибытие через врата — это ещё и момент, когда начинаются неприятности. Вход в район станции запускает любое поджидающее там событие — от разыскиваемого преступника до конвоя, который нужно защитить. Патрульные корабли совершают обходы мимо врат, а в поздних главах у станции могут поджидать пираты.", false],
		[1, "Название", "Название сети всегда пишется как аббревиатура — S.T.R.E.A.M., — но игра так и не объясняет, что означают эти буквы. Пилот и [[character/1]] относятся к вратам как к обыденной части жизни, вроде дорог или железных дорог.", false],
		[1, "Роль в колонии", "Именно сеть удерживает колонию как единое целое. Она превращает двести разбросанных станций в единую работающую экономику: улов можно продать далеко от места, где он был пойман, а контракт может привести через всю карту. Каждое прибытие на новую станцию засчитывается в медаль «[[medal/13]]», а первая стыковка с каждой — в медаль «[[medal/6]]».", false],
		[5, "В сюжете", "Пилот знакомится с вратами рано, когда первая охота на пиратов уводит его за пределы станции [[station/0]]. С тех пор почти каждое путешествие в сюжете проходит через них, а автопилот по запросу может довести корабль до местных врат.", false],
		[12, "", "Врата не признают политических границ. Когда пилот впервые отправляется к сопротивлению на станцию [[station/3]], корабль прибывает в воды, которые повстанцы называют нейтральными, и его сразу же окликает охрана станции.", false],
		[21, "", "Повстанцы используют врата в своих операциях. В миссии против банды пиратов у станции [[station/8]] [[character/3]] ждёт пилота у врат станции, прежде чем повести его в атаку.", false],
		[45, "", "При штурме станции [[station/18]] отряд, которым командует [[character/12]], ждёт на позиции у врат, чтобы атака могла начаться сразу по прибытии пилота.", false],
	],
}
