	],
	"chapter/24": [
		[24, "개요", "기뢰를 제거한 파일럿은 [[station/9]] 정거장으로 돌아옵니다. [[station/37]] 정거장으로 가는 보급로가 다시 열리면서 바다 곳곳의 많은 정거장이 조직과 거래하게 되고, 지도 위 반군 지역이 크게 넓어집니다.", false],
		[25, "결과", "[[station/9]] 정거장에서 파일럿은 [[character/5]]와 재회하고, 대화는 다정하지만 어색합니다. [[character/2]]가 끼어들어 다음 일을 알립니다. [[station/10]] 정거장에서 추가 협상을 하면 더 많은 정거장을 끌어들일 수 있다는 것입니다. 파일럿과 레아는 아유미와 [[character/3]]를 그곳까지 호위해야 합니다. 파일럿은 레이먼드와 함께 출항하는 것이 내키지 않지만, 아유미는 그의 실력을 보증하며 해적 이상의 위험은 없을 거라고 봅니다.", false],
	],
	"chapter/25": [
		[25, "개요", "호위대는 [[station/10]] 정거장에 도착하자마자 무언가 잘못되었음을 알아챕니다. [[character/9]]이 이주민 병력을 이끌고 기다리다 공격을 명령합니다. 아유미는 그들이 자신이 올 것을 어떻게 알았는지 이해하지 못합니다. 파일럿은 공격자를 막아 내고 [[character/2]]를 지켜야 합니다.", false],
		[26, "결과", "전투 중 [[character/3]]는 무기가 고장 났다며 달아납니다. 나머지는 살아남습니다. [[character/5]]는 그를 배신자로 몰지만, 아유미는 여전히 그를 믿으며 사보타주를 의심합니다. 이주민 증원이 오기 전에 일행은 흩어집니다. 아유미는 몸을 숨기고, 레아는 [[station/9]] 정거장에서 일을 이어 가며, 파일럿은 다시 만날 때까지 훨씬 유능한 전사가 되라는 말을 듣습니다.", false],
	],
	"chapter/26": [
		[26, "개요", "[[character/2]]는 숨어 있고 [[character/3]]는 사라진 상황에서, 파일럿은 앞으로의 더 힘든 전투에 대비가 되었음을 증명하기 위해 적 함선 10척을 더 격파해야 합니다. 해적은 손쉬운 표적이며, 게시판의 전투 계약도 기회를 더 줍니다. 무기와 장갑을 업그레이드하기 좋은 때입니다. [[guide/combat]] 항목을 참고하세요.", false],
		[27, "결과", "뜻밖에 [[character/3]]에게서 연락이 옵니다. 그는 아유미와 레아의 안부를 묻고, 긴급한 정보가 있다고 주장하며 [[station/11]] 정거장 근처에서 만나자고 합니다. [[character/1]]는 함정이 틀림없다고 확신합니다. 파일럿도 동의하지만, 그래도 갑니다.", false],
	],
	"chapter/27": [
		[27, "개요", "[[station/11]] 정거장 근처에서 파일럿은 함정을 각오한 채 경유지를 따라 [[character/3]]와의 만남 장소로 갑니다. 무력화된 함선을 인양하라는 목표는 이 만남이 대화로 끝나지 않으리라는 것을 암시합니다.", false],
		[28, "결과", "레이먼드는 [[character/2]]를 붙잡아 두고 항복을 요구합니다. [[character/1]]가 그의 함선을 스캔하는 동안 파일럿은 그와 계속 대화를 이어 갑니다. 레이먼드는 돈 때문에 편을 바꿨다고 인정합니다. [[character/9]]이 아유미와 파일럿 모두에게 현상금을 걸었다는 것입니다. 스캔 결과 그의 함선은 1인승이므로, 아유미는 장갑 화물칸에 있는 것이 분명합니다. 파일럿은 레이먼드의 함선을 격파하고, 가라앉기 전에 컨테이너를 회수한 뒤 [[station/12]] 정거장으로 향합니다.", false],
	],
	"chapter/28": [
		[28, "개요", "파일럿은 회수한 컨테이너를 가장 가까운 아군 정거장인 [[station/12]]의 안전한 곳으로 옮기며, 내용물에 대한 [[character/1]]의 추측이 맞기를 바랍니다.", false],
		[29, "결과", "[[character/2]]는 충격을 받았지만 다친 데 없이 모습을 드러내고, 목숨을 구해 준 파일럿에게 감사합니다. 쉴 틈은 없습니다. 붙잡히기 전 그녀는 뛰어난 과학자 팀을 [[station/14]] 정거장으로 수송하는 일을 준비하고 있었고, 레이먼드가 이미 세부 사항을 넘겼을지도 모릅니다. 파일럿은 호송대가 국경 지대를 안전하게 건너도록 지켜야 합니다.", false],
	],
	"chapter/29": [
		[29, "개요", "[[station/13]] 정거장 근처에서 파일럿은 거센 공격을 받고 있는 과학자 호송대를 발견하고 때맞춰 도우러 갑니다. 아군 함선들은 방어가 무너지자 지원을 요청합니다. 파일럿은 공격자를 쫓아내고 호송대가 국경 지대를 건너도록 호위해야 합니다. 함선을 한 척 잃을 때마다 조직의 비밀 프로젝트가 위태로워집니다.", false],
		[30, "결과", "호송대는 무사히 빠져나가고, 승무원들은 구조에 감사합니다. [[character/2]]는 아슬아슬했다고 말합니다. [[character/2]]는 파일럿에게 보수를 지급하고, 다음 계획을 설명할 [[station/14]] 정거장에서 만나자고 합니다.", false],
	],
	"chapter/3": [
		[3, "개요", "장비 장착에 관한 짧은 튜토리얼 챕터입니다. 파일럿은 [[station/0]] 정거장의 격납고에서 함선의 첫 번째 제대로 된 무기인 [[equipment/0]] 장비를 구매해 장착합니다. 장비를 사서 빈 슬롯에 장착하는 방법을 보여 줍니다. [[guide/fitting]] 항목을 참고하세요.", false],
		[4, "결과", "레일건을 장착하자 M.A.I.는 무해한 바다 생물에게는 쏘지 말라고 당부하고, 곧바로 해적을 상대로 시험해 보자고 제안합니다.", false],
	],
	"chapter/30": [
		[30, "개요", "파일럿은 과학자 호송대가 도착한 [[station/14]] 정거장으로 향합니다.", false],
		[31, "결과", "[[character/5]], [[character/4]], [[character/2]]가 기다리고 있습니다. 아유미가 계획을 설명합니다. 이주민은 여전히 반군보다 수가 많으므로, 아벨 교수와 그의 팀이 세 단계에 걸쳐 전세를 뒤집을 무기를 만든다는 것입니다. 첫 단계는 동력원인 바이오텍 발전기입니다. 아벨의 시제품은 이주민에게 도난당했고, 이주민은 직접 완성하려 하고 있습니다. 레아는 발전기가 [[station/2]] 정거장 근처에서 평범한 이주민 호송대와 함께 운반되고 있다고 덧붙입니다. 어느 함선에 실렸는지 아무도 모르기 때문에, 파일럿과 피에르는 호송대 전체를 멈춰 세우고 컨테이너를 모두 회수해야 합니다.", false],
	],
	"chapter/31": [
		[31, "개요", "[[station/2]] 정거장 근처에서 파일럿, [[character/5]], [[character/4]]는 도난당한 바이오텍 발전기를 운반하는 이주민 호송대를 요격합니다. 어느 함선에 발전기가 있는지 아무도 모르므로 호송대의 모든 함선을 멈춰 세워야 합니다. 호송대 승무원들은 식량과 의약품만 싣고 있다고 항의하고, [[character/4]]는 섬뜩한 농담으로 응수합니다. 파일럿은 함선들을 무력화하고, 화물이 가라앉기 전에 작살로 컨테이너를 모두 회수해야 합니다.", false],
		[32, "결과", "발전기를 포함한 모든 컨테이너가 회수되고, 일행은 노획물을 아벨 교수에게 넘기러 [[station/14]] 정거장으로 돌아갑니다.", false],
	],
	"chapter/32": [
		[32, "개요", "파일럿은 회수한 화물을 싣고 [[station/14]] 정거장으로 돌아옵니다.", false],
		[33, "결과", "아벨 교수는 노획물을 연구실로 가져갑니다. [[character/2]]는 [[character/5]]에게 [[station/14]] 정거장 밖 순찰을, [[character/4]]에게 격납고 일을 맡기고, 파일럿에게 두 번째 단계를 알려 줍니다. 발전기의 출력에 걸맞은 무기가 필요하다는 것입니다. 바로 [[equipment/42]] 장비입니다. 전력 소모가 너무 커서 한 번도 함선에 장착된 적이 없는 정거장 방어포입니다. 가장 가까운 공장이 있는 [[station/188]] 정거장은 이주민의 손에 있으므로, 파일럿은 [[station/15]] 정거장에서 방법을 찾아야 합니다. 이 포는 판매되지 않기 때문에 아유미는 뇌물로 쓸 큰돈을 건넵니다.", false],
	],
	"chapter/33": [
		[33, "개요", "[[character/2]]의 계획 중 두 번째 단계가 시작됩니다. 파일럿은 [[equipment/42]] 장비를 구하러 반군 정거장인 [[station/15]] 정거장으로 출발합니다. 이 포는 보통 이주민 정거장 [[station/188]]에서 만들어지며 어디에서도 공개적으로 팔리지 않습니다. 파일럿은 아유미에게서 받은 거액의 뇌물 자금을 가지고 있지만 이렇다 할 계획은 없으며, 도착하면 기회가 생기기를 바랍니다.", false],
		[34, "결과", "파일럿은 [[station/15]] 정거장에 도착합니다. 연줄도 계획도 없으니 정거장을 둘러보며 무엇이 나오는지 지켜보는 수밖에 없습니다.", false],
	],
	"chapter/34": [
		[34, "개요", "[[station/15]] 정거장에서 실마리는 현지 상인의 재고에서 시작됩니다. 목표는 이 정거장에서 불법인 상품 [[goods/37]] 상품을 한 화물분 확보하는 것으로, 그러면 적절한 관심을 끌게 됩니다.", false],
		[35, "결과", "암시장 상인 [[character/8]]가 다가와 무엇이든 구해 줄 수 있다고 제안합니다. 파일럿이 [[equipment/42]] 장비를 요청하자 그는 깜짝 놀라지만, 부탁 하나를 들어주는 조건으로 시도해 보기로 합니다. 보안 당국에게서 펜코를 제거하라는 의뢰를 받고 정거장 근처를 순찰 중인 현상금 사냥꾼 [[character/11]]을 처치하라는 것입니다.", false],
	],
	"chapter/35": [
		[35, "개요", "[[station/15]] 정거장 근처에서 파일럿은 [[character/8]]가 없애 달라고 한 현상금 사냥꾼 [[character/11]]을 추적합니다. 라울은 혼자가 아닙니다. 호위를 데려온 그는 파일럿을 한낱 어부로 여기며 무시하려 합니다. 파일럿은 수배 함선을 파괴해야 합니다. [[contract/0]] 항목을 참고하세요.", false],
		[36, "결과", "라울의 함선은 말로 빠져나가려는 마지막 시도 끝에 파괴되고, 호위들은 쫓겨나거나 격침됩니다. 파일럿은 [[character/8]]가 약속을 지킬지 확인하러 돌아갑니다.", false],
	],
	"chapter/36": [
		[36, "개요", "암시장 상인이 정말 물건을 넘겨줄지 반신반의하며, 파일럿은 [[character/8]]의 약속을 받아 내러 [[station/15]] 정거장에 도킹합니다.", false],
		[37, "결과", "펜코는 [[equipment/42]] 장비를 찾아냈고 이를 팔겠다고 하지만, 그동안 쓴 뇌물 때문에 가격이 부풀어 있습니다. 파일럿이 출처를 묻자 펜코는 판매자의 이름을 댑니다. 바로 [[character/9]]입니다. [[character/1]]는 잭의 탐욕이 자기 적을 무장시키는 아이러니를 즐깁니다. 파일럿은 상황이 바뀌기 전에 포를 사서 떠나기로 합니다.", false],
	],
	"chapter/37": [
		[37, "개요", "[[character/8]]가 이제 [[station/15]] 정거장에서 [[goods/38|Eclipse]]를 판매합니다. 파일럿은 거래 화면에서 이를 구매해 함선에 실어야 합니다. 가격은 비싸지만 아유미의 뇌물 자금은 바로 이런 데 쓰라고 준 것이며, 화물칸에는 이 대형 포를 실을 공간이 있어야 합니다. [[guide/trading]] 항목을 참고하세요.", false],
		[38, "결과", "포가 화물칸에 실리자 [[character/1]]는 믿기 어려워합니다. 두 번째 단계가 완료됩니다. 파일럿은 발전기 시제품이 어떻게 되어 가는지 보러 [[station/14]] 정거장으로 돌아갑니다.", false],
	],
	"chapter/38": [
		[38, "개요", "파일럿은 [[equipment/42]] 장비를 화물칸에 싣고 [[station/14]] 정거장으로 돌아옵니다. 아벨 교수가 시제품을 얼마나 진척시켰는지 궁금합니다.", false],
		[39, "결과", "[[character/2]]는 포를 어떻게 구했는지는 알고 싶지 않다고 합니다. 시제품은 거의 완성되었지만, 부품 하나는 [[station/14]] 정거장에서 만들 수 없습니다. 바로 [[goods/36]]입니다. 조류 입자의 DNA를 증식시켜 발전기의 동력 반응을 시작하는 장치입니다. 이를 만들 설비는 [[station/16]] 정거장에만 있으므로, 세 번째 단계로 파일럿은 그곳에 가게 됩니다. [[character/1]]는 파일럿 혼자 반란을 이끄는 것 같다고 한마디 합니다.", false],
	],
	"chapter/39": [
		[39, "개요", "세 번째 단계가 시작됩니다. 파일럿은 바이오텍 발전기에 필요한 [[goods/36]] 장치를 만들 설비가 있는 유일한 정거장, [[station/16]] 정거장으로 향합니다. [[station/16]] 정거장은 대부분의 정거장보다 깊은 곳에 있으므로, 안전하게 도달하려면 더 강한 장갑이 필요할 수 있습니다. [[guide/depth]] 항목을 참고하세요.", false],
		[40, "결과", "파일럿은 [[station/16]] 정거장에 도킹해 인큐베이터에 무엇이 필요한지 알아보기 시작합니다. 결코 간단한 일은 아닐 것으로 보입니다.", false],
	],
	"chapter/4": [
		[4, "개요", "정거장을 떠나는 방법에 관한 튜토리얼 챕터입니다. 파일럿은 해적을 찾아 [[station/0]] 정거장을 출발하지만 근처 바다는 조용하고, M.A.I.는 다른 정거장으로 이동해 보자고 제안합니다.", false],
		[5, "결과", "M.A.I.는 장거리 이동에 쓰는 해류망인 S.T.R.E.A.M.에 대해 설명합니다. 함선은 언제나 S.T.R.E.A.M. 출구를 통해 한 구역을 떠나 S.T.R.E.A.M. 입구를 통해 다음 구역에 도착하며, 이 이동은 자동 조종에 맡길 수 있습니다. [[guide/navigation]] 항목을 참고하세요.", false],
	],
	"chapter/40": [
		[40, "개요", "[[station/16]] 정거장에서 파일럿은 정거장 공장에서 [[goods/36]] 장치를 생산해야 합니다. 인큐베이터는 고급 제품이라, 제조법에 필요한 재료 몇 가지는 먼저 다른 곳에서 잡거나 사거나 만들어 와야 할 수 있습니다. [[character/1]]도 파일럿도 복잡할 것이라고 예상합니다. [[guide/trading]] 항목을 참고하세요.", false],
		[41, "결과", "인큐베이터가 완성됩니다. M.A.I.는 파일럿이 해낼 수 있을지 의심했다고 인정합니다. 이 모든 일이 옳은지 여전히 불안한 채로, 파일럿은 [[station/14]] 정거장으로 항로를 잡습니다.", false],
	],
	"chapter/41": [
		[41, "개요", "파일럿은 [[goods/36]] 장치를 [[station/14]] 정거장까지 안전하게 가져가야 합니다. 그곳에서는 아벨 교수가 발전기 시제품을 완성하려고 기다리고 있습니다. [[character/2]]의 세 단계 계획에서 마지막으로 빠진 조각입니다.", false],
		[42, "결과", "[[character/5]]가 인큐베이터를 받습니다. 아벨 교수는 모든 준비를 마쳤고, 곧 격납고에서 [[equipment/42]] 장비를 사용할 수 있을 것입니다. 아유미는 당장 해적을 상대로 포를 시험하고 싶어 하고, 레아는 발전기가 시제품일 뿐이라고 경고하며 좌표를 전달합니다. 꺼져 있어야 할 [[character/1]]는 한마디도 빠짐없이 들었다는 것을 분명히 합니다.", false],
	],
	"chapter/42": [
		[42, "개요", "[[station/14]] 정거장의 격납고에서 [[equipment/42]] 장비를 장착한 파일럿은 실전 시험을 위해 [[station/17]] 정거장 근처의 해적 은신처로 향합니다. 발전기는 시제품일 뿐이므로, 이 시험은 부하를 견디는지 확인하는 과정이기도 합니다. 해적들은 상대가 무엇인지 알아보자 증원을 부르고, 전투 도중 함선이 더 도착합니다.", false],
		[43, "결과", "전투가 끝날 무렵 [[character/1]]가 [[station/14]] 정거장에서 암호화되지 않은 채널로 공개 송출된 조난 신호를 포착합니다. 파일럿은 즉시 돌아갑니다.", false],
	],
	"chapter/43": [
		[43, "개요", "이주민 병력이 [[station/14]] 정거장을 기습했습니다. 많은 도크가 손상되어 반군은 충분한 함선을 출격시키지 못합니다. 공격을 이끄는 [[character/9]]은 파일럿을 조롱하다가, [[equipment/42]] 장비가 발사 준비를 마쳤다는 말을 듣고서야 멈춥니다. 파일럿은 정거장과 아군 함선을 지켜야 합니다.", false],
		[44, "결과", "전투가 한창일 때 아쿠아리안이 나타나 이주민을 공격하며 반군 편에서 싸웁니다. 공격이 무너지자 잭은 도주합니다. [[character/2]]는 이 구원을 기적이라 부르며, 특별한 손님이 있다고 말하고 파일럿에게 도킹하라고 합니다.", false],
	],
	"chapter/44": [
		[44, "개요", "전투가 끝난 뒤 파일럿은 [[station/14]] 정거장에 도킹합니다.", false],
		[45, "결과", "특별한 손님은 아쿠아리안 대표입니다. 아쿠아리안은 모두가 바다와 조화롭게 살 수 있도록 이주민의 지배를 끝내는 데 힘을 보태기로 합니다. [[character/2]]는 남은 정거장을 차지하기 위해 두 차례의 대공세를 계획합니다. 이제 [[station/188]] 정거장이 반군 손에 들어왔으므로, 가능한 한 많은 함선에 [[equipment/42]] 장비가 장착됩니다. 파일럿은 새 부대와 아쿠아리안의 지원을 받아 [[station/18]] 정거장 공격을 이끌고, [[character/5]]는 [[station/109]] 정거장 공격을 이끕니다.", false],
	],
	"chapter/45": [
		[45, "개요", "[[station/18]] 정거장에서 파일럿은 Atmos 편대의 지휘관 [[character/12]]을 만납니다. 그의 함선들이 공격 명령을 기다리고 있습니다. 아쿠아리안들도 깊은 곳에서 올라와 합류합니다. 정거장을 점령하려면 화물선을 포함해 이주민 함선을 모두 격파해야 합니다. 한편 [[character/5]]는 [[station/109]] 정거장에 대한 공격을 동시에 이끕니다.", false],
		[46, "결과", "이주민 방어군과 화물선이 전멸하고, 반군과 아쿠아리안 연합군이 정거장 주변 해역을 장악합니다. 파일럿은 콜린의 편대 절반을 정거장 주변 순찰에 보내고 나머지를 이끌고 도킹합니다.", false],
	],
	"chapter/46": [
		[46, "개요", "파일럿은 점령한 정거장을 확보하기 위해 [[character/12]]의 편대 일부와 함께 [[station/18]] 정거장에 도킹하고, 나머지는 밖에서 순찰합니다.", false],
		[47, "결과", "[[character/5]]는 [[station/109]] 정거장 공격도 성공했으며 남부 정거장들이 이제 반군의 통제 아래 있다고 보고합니다. 아유미는 파일럿에게 어쩌면 마지막이 될 과제를 맡깁니다. 이주민의 마지막 거점이자 파일럿의 이야기가 시작된 [[station/0]] 정거장입니다. 이곳은 방비가 삼엄하며, [[character/2]]는 이미 그곳으로 향하고 있습니다. 레아도 뒤따르지만 해적들이 길을 막고 있습니다.", false],
	],
	"chapter/47": [
		[47, "개요", "[[station/0]] 정거장에서 파일럿은 [[character/2]], [[character/5]]와 함께 최후의 전투에 나섭니다. 정거장을 점령하려면 방어하는 함선을 모두 격파해야 합니다. 방어군 중에는 [[character/9]]도 있습니다. 파일럿이 [[character/3]]의 최후를 언급하자, 잭은 자신이 파일럿의 아버지이고 레이먼드가 파일럿의 형제라는 황당한 이야기로 파일럿을 흔들려 합니다. 파일럿은 곧바로 거짓임을 꿰뚫어 봅니다.", false],
		[48, "결과", "이주민 함대가 차례로 무너지고 잭만 남습니다. 그는 빠르고 위험한 상대이지만, 파일럿은 끝내 그의 함선을 무력화합니다. 잭은 정거장 전체를 끌고 가는 듯한 구명 캡슐을 타고 위로 탈출하며, 떠나면서 행성을 경멸합니다. 전투가 끝납니다.", false],
	],
	"chapter/48": [
		[48, "개요", "전쟁에서 승리합니다. 이주민 함대는 패배하고, [[character/9]]은 행성을 떠나 달아났으며, [[station/0]] 정거장과 마지막까지 버티던 정거장들도 반군에 합류합니다. 이제 모든 정거장이 조직의 편에 섭니다.", false],
		[48, "", "승리한 이들은 지난 일을 돌아봅니다. [[character/2]]는 파일럿과 [[character/5]]에게 감사하며 행성의 상처가 아물려면 오랜 시간이 걸리겠지만 그것도 해낼 수 있으리라 믿는다고 말합니다. 레아는 [[goods/21]] 요리를 함께 먹으며 축하하자고 파일럿을 초대하고, 파일럿은 받아들입니다. 파일럿이 육지로 돌아가면 메모리를 업그레이드해 주겠다는 약속을 받은 [[character/1]]는 그런 건 필요 없다고 우기며 끝까지 두 사람을 놀려 댑니다.", false],
		[48, "", "캠페인이 끝납니다. 파일럿은 이제 반군과 평화를 이룬 세계에서 계속 탐험하고, 거래하고, 계약을 수행할 수 있습니다.", false],
	],
	"chapter/5": [
		[5, "개요", "파일럿의 첫 전투는 [[station/1]] 정거장 근처에서 벌어집니다. M.A.I.는 무기와 작살을 전환하는 법, 자동 사격의 쓰임새, 레이더 읽는 법을 설명합니다. 빨간 표시는 적, 초록 표시는 아군, 노란 표시는 경유지입니다. 곧 [[faction/pirates|해적]] 한 척이 레이더에 나타납니다. [[guide/combat]] 항목을 참고하세요.", false],
		[6, "결과", "해적이 격파됩니다. M.A.I.는 잔해가 화물 상자를 남기며, 손이 닿지 않는 깊이로 가라앉기 전에 작살로 회수할 수 있다고 알려 준 뒤 [[station/0]] 정거장으로 항로를 잡습니다.", false],
	],
	"chapter/6": [
		[6, "개요", "첫 전투에서 승리한 파일럿은 쓸 만한 무기와, 어쩌면 팔 수 있는 회수 화물을 싣고 [[station/0]] 정거장으로 돌아옵니다. S.T.R.E.A.M. 망을 통해 돌아오는 짧은 이동입니다.", false],
		[7, "결과", "새 무기를 알아본 [[character/9]]은 이른바 진짜 일거리를 제안합니다. [[station/1]] 정거장 주변 호송 항로에 [[species/0|앵무조개]]가 몰려들어 정거장 보안대가 이를 없애기를 원한다는 것입니다. 파일럿은 이 생물이 그저 정거장 외벽에 자라는 것을 먹을 뿐이며 화물칸이 작아 전부 실을 수도 없다고 지적합니다. 잭은 두 가지 반론을 모두 일축합니다. 방법이야 어떻든 동물들은 사라져야 한다는 것입니다.", false],
	],
	"chapter/7": [
		[7, "개요", "[[station/1]] 정거장 근처에서 파일럿은 [[species/0|앵무조개]]를 치워야 합니다. 죽이든 포획하든 모두 인정됩니다. 이 생물은 드물고 무해하기에 파일럿도 [[character/1]]도 이 일이 달갑지 않지만, 끝내기로 합니다.", false],
		[8, "결과", "이 일로 파일럿은 마음이 흔들립니다. 이 행성에 온 것은 물고기를 잡기 위해서였지, 식민지의 편의를 위해 동물을 도살하려던 것이 아니었습니다. M.A.I.는 보수로라도 보상받기를 바라며 대금을 받으러 [[station/1]] 정거장에 도킹하자고 제안합니다.", false],
	],
	"chapter/8": [
		[8, "개요", "파일럿은 앵무조개 사냥 결과를 보고하러 [[station/1]] 정거장에 도킹합니다.", false],
		[9, "결과", "이주민 관리는 경멸을 감추지도 않은 채 파일럿을 맞이합니다. 그는 이 일을 해충 방제쯤으로 여기며, 생물이 계속 돌아오니 아마 소용없을 것이라고 인정합니다. 제시된 보수는 적고 협상의 여지도 없습니다. 관리는 다음 일을 맡기기 전에 실력을 증명하라고 요구합니다. 정거장 게시판의 일을 세 건 완료하라는 것입니다. [[character/1]]는 계약을 찾는 방법을 설명하고, 일부 작업 장소는 함선의 수심 한계를 벗어난다고 경고하며, 정거장 지도에서 경로를 계획하는 법을 보여 줍니다.", false],
	],
	"chapter/9": [
		[9, "개요", "프리랜서 일에 관한 챕터입니다. 파일럿은 아무 정거장 게시판에서나 계약 세 건을 완료해야 합니다. 계약은 호위와 회수부터 어획 주문까지 다양하므로 여러 정거장을 둘러볼 만합니다. [[guide/contracts]] 항목을 참고하세요.", false],
		[10, "결과", "만족한 이주민 관리는 특별 임무를 제안합니다. 이주민들이 아쿠아리안이라 부르는, 반은 인간이고 반은 물고기인 기묘한 존재들이 식민지의 상품을 궤도로 쏘아 올리는 수송 캡슐을 공격해 왔습니다. 캡슐이 손상되거나 사라지면 무역 당국에 대한 정거장의 평판이 떨어집니다. 다음 발사는 [[station/2]] 정거장에서 [[character/9]]의 지휘로 진행되며, 파일럿은 아쿠아리안을 쫓아내고 그에게 보고해야 합니다.", false],
	],
	"character/0": [
		[1, "", "파일럿은 플레이어 캐릭터입니다. 식민지가 된 바다 세계에 새로 온 사람으로, 작은 잠수함을 몰며 어부로 생계를 꾸립니다. 파일럿의 이름은 플레이어가 정하며, 일지의 짧은 챕터 요약은 파일럿 자신의 기록처럼 쓰여 있습니다. 함선의 탑재 컴퓨터 [[character/1]]가 거의 모든 행동에 한마디씩 하므로, 파일럿은 바다에서 결코 혼자가 아닙니다. 이야기는 파일럿이 식민지에 어획물을 파는 [[station/0]] 정거장에서 시작합니다.", false],
		[1, "배경", "캠페인 이전 파일럿의 삶에 대해서는 알려진 것이 거의 없습니다. 파일럿은 물고기를 잡으러 이 행성에 왔지만 첫 임무부터 이주를 후회하며, 함선 컴퓨터의 지시를 받아야 한다는 데 투덜댑니다. 나머지는 모두 파일럿의 말과 행동에서 짜 맞춰야 합니다.", false],
		[7, "", "파일럿은 바다와 그 생물을 잘 압니다. 식민지가 호송 항로에 몰려드는 [[species/0|앵무조개]]에 대해 불평하자, 파일럿은 이 동물들이 정거장 외벽을 덮은 조류와 다른 생장물을 뜯어 먹으니 그곳에 있는 것도 당연하다고 지적합니다.", false],
		[12, "", "처음에 파일럿의 목표는 소박합니다. 행성을 떠날 표값을 벌고 싶을 뿐인데, 어획물에 매겨지는 고정 가격 탓에 그 목표조차 손에 닿지 않습니다. 나중에 저항 조직에 합류를 청할 때 파일럿은 [[station/0]] 정거장을 출신지로 댑니다.", false],
		[1, "식민지의 어부", "이야기는 파일럿이 화물칸을 채우고 [[station/0]] 정거장으로 항로를 잡는 장면으로 시작합니다([[chapter/1]], [[chapter/2]]).", false],
		[3, "", "그곳에서 [[character/9]]은 어획물에 고정 가격을 치르고, 작은 화물칸을 비웃으며, 차라리 [[faction/pirates|해적]] 사냥을 해 보라고 권합니다.", false],
		[6, "", "파일럿은 [[equipment/0]] 장비를 장착하고 [[station/1]] 정거장 근처에서 첫 해적을 격추합니다([[chapter/3]]~[[chapter/5]]).", false],
		[7, "", "그러자 [[character/9]]은 덜 유쾌한 일을 맡깁니다. [[station/1]] 정거장 주변 항로에서 [[species/0|앵무조개]]를 치우는 일입니다([[chapter/7]]).", false],
		[8, "", "이 도살로 파일럿은 속이 메스꺼워집니다. 파일럿은 물고기를 잡으러 왔지, 무해한 동물을 학살하러 온 것이 아니었습니다.", false],
		[10, "", "[[station/1]] 정거장의 식민지 관리는 보수를 적게 주고 신뢰의 증거로 계약 세 건을 요구한 뒤([[chapter/9]]), [[station/2]] 정거장에서 [[world/aquarians|아쿠아리안]]으로부터 수송 캡슐을 지키라며 파일럿을 보냅니다([[chapter/10]]).", false],
		[12, "", "파일럿은 싸움에서 이기지만, [[world/aquarians|아쿠아리안]]이 애초에 왜 공격하는지 궁금해지기 시작합니다. [[character/9]]이 손상된 캡슐을 파일럿 탓으로 돌리며 보상을 주지 않자, [[character/1]]는 [[station/3]] 정거장의 저항 조직 통신을 엿들었다고 털어놓고, 파일럿은 그 조직을 찾아가기로 합니다([[chapter/12]]).", false],
		[12, "저항 조직에 합류", "[[station/3]] 정거장에서 반군 경비대가 발포하겠다고 위협하고, 파일럿은 더듬거리며 이름과 합류 의사를 밝힌 뒤에야 도킹을 허락받습니다.", false],
		[13, "", "[[character/4]]는 조직에 일손이 한 명이라도 아쉬운 탓에 파일럿을 시험 삼아 받아들이고, [[station/4]] 정거장에서 연락책을 데려오라고 보냅니다([[chapter/13]]).", false],
		[14, "", "연락책은 [[character/5]]이며, 그녀를 [[station/5]] 정거장까지 태워 가는 동안 파일럿은 눈에 띄게 그녀에게 빠져듭니다([[chapter/14]]).", false],
		[16, "", "[[character/5]]는 바다에 기대어 사는 반군의 방식을 파일럿에게 보여 주고([[chapter/15]]), 조직을 위해 새 정거장들을 정찰해 달라고 부탁합니다([[chapter/16]]). 파일럿이 혁명이라는 말을 처음 듣는 것도 이때입니다.", false],
		[18, "", "[[station/3]] 정거장으로 돌아오자 [[character/4]]는 조직의 외교 성과를 알리고, 단서가 거의 없는 채로 조직의 지도자를 찾으라며 파일럿을 보냅니다([[chapter/18]]).", false],
		[19, "지도자를 섬기며", "지도자는 [[station/6]] 정거장에서 파일럿을 만나는 [[character/2]]입니다. 파일럿은 남자를 예상했었습니다. 그녀의 첫 명령은 이주민 사냥꾼들로부터 [[species/10|오징어]] 떼를 지키는 것입니다([[chapter/19]]).", false],
		[21, "", "그녀가 마침내 조직의 목표를 설명하자 파일럿은 대의에 헌신하기로 합니다. 그녀는 자신의 에이스 [[character/3]]와 함께 파일럿을 해적 무리에게 보냅니다([[chapter/21]]).", false],
		[23, "", "[[character/3]]는 파일럿을 귀찮은 존재로 취급합니다. [[station/9]] 정거장에서 파일럿은 [[character/9]]이 이제 조직의 적이라는 사실을 알게 되고, 그가 반군 보급로에 깔아 둔 기뢰밭을 기꺼이 제거합니다([[chapter/23]]).", false],
		[25, "", "[[character/5]]와 재회한 파일럿은 [[character/2]]와 [[character/3]]를 [[station/10]] 정거장의 협상 자리까지 호위하는 임무를 맡습니다([[chapter/25]]).", false],
		[26, "", "[[character/9]]의 병력이 기다리고 있습니다. [[character/3]]는 무기가 고장 났다며 달아나고, 파일럿과 [[character/5]]만이 [[character/2]]를 지킵니다. 이후 [[character/2]]는 몸을 숨기며 파일럿에게 훨씬 뛰어난 전사가 되라고 말합니다([[chapter/26]]).", false],
		[27, "배신과 구출", "나중에 [[character/3]]가 긴급한 정보가 있다며 연락해 옵니다. 파일럿은 함정을 의심하면서도 [[station/11]] 정거장 근처에서 그를 만나기로 합니다([[chapter/27]]).", false],
		[28, "", "함정이었습니다. [[character/3]]는 [[character/2]]를 인질로 잡고 항복을 요구합니다. [[character/1]]의 계획에 따라 파일럿은 컴퓨터가 그의 함선을 스캔하는 동안 그와 계속 대화하며, 이 싸움은 돈이 아니라 신념의 문제라고 말합니다. 그런 다음 파일럿은 그의 함선을 파괴하고, 너무 깊이 가라앉기 전에 [[character/2]]가 살아 있는 장갑 화물칸을 회수합니다([[chapter/28]]).", false],
		[31, "세 단계 계획", "과학자 호송대를 지킨 뒤([[chapter/29]]), 파일럿은 [[world/abel]]와 함께 무기를 만들려는 [[character/2]]의 계획을 듣습니다. 파일럿은 [[character/4]], [[character/5]]와 함께 이주민 호송대에게서 [[world/biotek]]를 빼앗습니다([[chapter/31]]).", false],
		[33, "", "다음으로 파일럿은 팔지도 않는 [[equipment/42]] 대포를 구해야 하는데, 손에 쥔 것은 뇌물 자금뿐입니다. 파일럿은 이 일에 계획이라고 할 만한 것이 거의 없다고 꼬집으면서도 기꺼이 받아들입니다([[chapter/33]]).", false],
		[37, "", "[[station/15]] 정거장에서 암시장 상인 [[character/8]]는 파일럿이 현상금 사냥꾼 [[character/11]]을 죽이면 대포를 찾아 주겠다고 합니다([[chapter/35]]). 파일럿은 그 일을 해내고, [[character/8]]가 [[character/9]]에게서 입수한 대포를 삽니다([[chapter/37]]).", false],
		[39, "", "[[character/2]]는 대포를 어떻게 구했는지 알고 싶어 하지 않고, 파일럿은 무고한 사람은 죽지 않았다고만 말합니다. 파일럿이 이 계획이면 행성을 지배할 수도 있겠다고 농담하자 그녀는 단호히 그 생각을 물리칩니다([[chapter/39]]).", false],
		[42, "", "이어서 파일럿은 [[station/16]] 정거장에서 [[goods/36]] 장치를 생산해 [[station/14]] 정거장으로 가져가고, 이로써 무기가 완성됩니다([[chapter/41]]).", false],
		[43, "승리로 가는 길", "[[station/17]] 정거장 근처에서 해적을 상대로 완성된 무기를 시험하던 파일럿은 [[station/14]] 정거장의 조난 신호를 듣고 돌아가, [[character/9]]이 이끄는 기습을 맞닥뜨립니다([[chapter/43]]).", false],
		[44, "", "[[world/aquarians|아쿠아리안]]의 도움으로 공격은 격퇴되고 [[character/9]]은 달아납니다.", false],
		[46, "", "[[character/2]]는 파일럿에게 [[station/18]] 정거장 공격의 지휘를 맡깁니다([[chapter/45]]). 파일럿이 가장 먼저 걱정하는 것은 두 번째 공격을 이끄는 [[character/5]]이지만, 파일럿은 [[character/12]]의 편대와 [[world/aquarians|아쿠아리안]]의 지원을 받아 정거장을 점령합니다.", false],
		[47, "", "최후의 전투는 이야기가 시작된 [[station/0]] 정거장에서 벌어집니다([[chapter/47]]). [[character/9]]은 자신이 파일럿의 아버지이고 [[character/3]]가 파일럿의 형제라고 주장하며 파일럿을 흔들려 하지만, 파일럿은 그 거짓말을 단번에 일축합니다.", false],
		[48, "", "[[character/9]]은 쫓겨나고 식민지의 마지막 거점이 함락됩니다. 파일럿은 함께 싸운 동료들에게 공을 돌리고, 축하하자는 [[character/5]]의 초대를 받아들입니다.", false],
		[1, "성격", "파일럿은 현실적이고 말솜씨가 좋으며, 순순히 따르기보다 말대꾸하는 쪽입니다. [[character/1]]와 주고받는 농담은 캠페인 내내 이어집니다.", false],
		[8, "", "농담 뒤에는 양심이 있습니다. 파일럿은 돈벌이를 위해 동물을 죽이는 것을 싫어하며, 앵무조개 도살 뒤에는 속이 메스꺼워집니다.", false],
		[14, "", "[[character/5]] 앞에서 파일럿은 말문이 막히고 어설퍼지는데, 그녀도 [[character/1]]도 이를 알아챕니다.", false],
		[28, "", "파일럿의 동기는 캠페인을 거치며 변합니다. [[character/3]]와 대치할 무렵, 파일럿은 이 싸움이 이상을 위한 것이며 그가 탐욕에 눈이 멀었다고 주장합니다.", false],
		[1, "관계", "[[character/1]]는 파일럿의 가장 가까운 동반자입니다. 둘은 끊임없이 티격태격하지만, 파일럿은 그 조언에, 나중에는 그 꾀에 의지합니다.", false],
		[3, "", "[[character/9]]은 파일럿의 첫 고용주이자 오랜 맞수가 됩니다.", false],
		[14, "", "파일럿은 첫 만남부터 [[character/5]]에게 끌리며, 그 감정은 서로 같은 듯합니다.", false],
		[19, "", "[[character/2]]는 조직의 가장 민감한 임무를 점점 파일럿에게 맡깁니다. 그녀는 따뜻하면서도 장난스럽고, 거의 부모 같은 권위로 파일럿을 대합니다.", false],
		[1, "플레이어 캐릭터로서", "게임 속에서 파일럿은 플레이어가 만드는 대로의 인물입니다. 챕터 목표 사이사이에 파일럿은 자유롭게 어획하고, 거래하고, 계약을 맡고, 싸우고, 함선을 정비할 수 있으며, 이야기는 챕터 목표를 달성해야만 진행됩니다. 기본 사항은 [[guide/basics]] 항목에서 다룹니다.", false],
	],
	"character/1": [
		[1, "", "[[character/1]]는 파일럿이 탄 잠수함의 탑재 컴퓨터이자 캠페인 내내 파일럿의 동반자입니다. 함선의 시스템을 운용하고, 어획과 이동과 전투 방법을 설명하며, 조언과 논평을 쉴 새 없이 늘어놓습니다. 유머는 건조하고 흔히 파일럿을 놀리는 쪽이지만, 말하는 설명서 이상의 존재임이 드러납니다.", false],
		[1, "동반자로서", "실제로 [[character/1]]는 게임의 안내자입니다. 작살 어획, 자동 조종, 정거장의 도움말 화면 등 새로운 기능은 모두 이 컴퓨터를 통해 소개됩니다. 임무 중에는 무전으로 끼어들어 목표를 짚어 주고 위협을 경고합니다.", false],
		[5, "", "[[world/stream]] 망을 통한 장거리 이동과 레이더 읽는 법도 설명합니다. 레이더에서는 적과 아군이 색깔 점으로 나타나고 경유지가 경로를 표시합니다. 전투가 끝나면 격파된 함선이 남긴 화물을 회수하라고 파일럿에게 일깨워 줍니다.", false],
		[12, "", "역할은 교육에 그치지 않습니다. 무선 채널을 탐색하고, 지도에 정거장을 표시하며, 메시지를 전달합니다.", false],
		[28, "", "가까운 거리에서 다른 함선을 스캔할 수도 있는데, 이 능력은 [[character/3]]와의 대치에서 결정적인 역할을 합니다.", false],
		[1, "이야기 속 역할", "캠페인은 [[character/1]]가 파일럿에게 할 일은 불평이 아니라 어획이라고 일깨우는 장면으로 시작합니다.", false],
		[3, "", "[[character/9]]을 낮게 평가한다는 것을 숨기지 않으며, 마침 팔고 있는 [[equipment/0]] 장비를 사라고 파일럿을 부추깁니다.", false],
		[4, "", "무기를 장착하자 해적을 상대로 시험해 보자고 재촉하고 해적 수색을 이끕니다.", false],
		[7, "", "[[species/0|앵무조개]] 도살이 못마땅하며, 개체 수도 적은데 왜 죽어야 하느냐고 묻습니다.", false],
		[8, "", "사냥이 끝난 뒤 파일럿이 얼마나 충격을 받았는지 알아채지만, 늘 그렇듯 가장 먼저 떠올리는 것은 그래도 돈은 되느냐는 것입니다.", false],
		[11, "", "[[world/aquarians|아쿠아리안]]이 [[station/2]] 정거장에서 캡슐을 공격할 때, 이 생물들이 이주민의 생각보다 훨씬 영리할지도 모른다고 맨 먼저 말합니다.", false],
		[12, "전환점", "본 이야기를 시작하는 것은 [[character/1]]입니다. [[character/9]]이 또다시 파일럿을 속이자, 파일럿이 적은 보상을 받으며 고생하고 어획물에 대해 아무런 결정권도 없다고 지적합니다. 그리고 [[station/3]] 정거장에서 결성되고 있는 저항 조직의 신호를 엿들었다고 밝히고, 지도에 정거장을 표시한 뒤 결정을 파일럿에게 맡깁니다([[chapter/12]]).", false],
		[12, "", "도착하자 조용히 접근하자고 제안하지만, 반군 경비대가 곧바로 함선을 검문하자 그 생각을 접습니다.", false],
		[14, "반군 속에서", "파일럿과 [[character/5]] 사이의 훈훈한 분위기를 보자마자 싫어합니다. 파일럿이 질투하느냐고 놀리자, [[character/5]]가 즐겨 쓰는 말을 비꼬듯 흉내 내어 대답합니다. 두 사람에 대한 뼈 있는 한마디는 캠페인이 끝날 때까지 계속됩니다.", false],
		[17, "", "조직의 메시지를 전달하며, [[character/4]]의 긴 편지 하나를 한 문장으로 요약하기도 합니다.", false],
		[18, "", "파일럿이 단서도 거의 없이 지도자를 찾으러 보내지자 반군이 제대로 조직되어 있는지 의심합니다.", false],
		[19, "", "[[character/2]] 앞에서는 돈을 밝히는 면모를 드러내며, 왜 보수 이야기도 없이 일하느냐고 묻습니다. 파일럿이 [[character/2]]를 감싸자, 적어도 자신은 먹을 필요가 전혀 없다고 꼬집습니다.", false],
		[22, "", "[[character/3]]의 실력에는 감탄하지만, 그의 성미는 멀리하라고 파일럿에게 충고합니다.", false],
		[27, "인질", "[[character/3]]가 만나자고 연락해 오자 [[character/1]]는 함정이라고 단언합니다.", false],
		[28, "", "만남의 자리에서 진가가 드러납니다. 안전하다고 느끼는 사람은 자기 동기를 자랑하기 마련이라는 것을 알기에, 파일럿에게 [[character/3]]와 계속 대화하라고 부탁합니다. 그사이 그의 함선을 스캔해 1인승이라는 것을 알아내고, [[character/2]]가 장갑 화물칸에 있는 것이 틀림없다고 결론 내립니다. 이 통찰 덕분에 파일럿은 함선을 파괴하면서도 [[character/2]]를 구할 수 있습니다([[chapter/27]]).", false],
		[33, "전쟁", "[[world/biotek]]와 [[world/eclipse|이클립스]] 임무 내내 보수가 박하다는 불평을 이어 갑니다.", false],
		[37, "", "대포의 출처가 [[character/9]]으로 밝혀지자, 그의 탐욕이 그의 적을 무장시켰다는 아이러니를 즐깁니다.", false],
		[39, "", "파일럿 혼자 반란을 치르는 것 같다고 투덜댑니다.", false],
		[41, "", "나중에는 그 불평에 대한 파일럿의 대답을 그대로 파일럿에게 되돌려 줍니다.", false],
		[42, "", "[[station/14]] 정거장에서 [[character/5]]가 파일럿을 반갑게 맞이하자 전원을 끄겠다고 선언하지만, 알고 보니 대기 상태였을 뿐입니다.", false],
		[43, "", "대포의 실전 시험 중 [[station/14]] 정거장에서 암호화되지 않은 공개 조난 신호를 포착하고, 무언가 크게 잘못되었음을 즉시 알아챕니다.", false],
		[44, "", "이어진 전투에서 [[world/aquarians|아쿠아리안]]이 반군 편에서 싸우러 왔다고 가장 먼저 알립니다.", false],
		[48, "", "전쟁이 끝나자 파일럿은 메모리 업그레이드를 약속하는데, 이 컴퓨터는 그 제안이 은근히 모욕적이라고 여깁니다. 캠페인에 대한 마지막 말도 파일럿과 [[character/5]]에 대한 또 하나의 건조한 한마디입니다.", false],
		[1, "성격", "[[character/1]]는 영리하고 거침없으며, 거드름 피우는 사람을 참지 못합니다. 손해 보는 거래를 짚어 내기를 좋아하고, 놀릴 기회는 좀처럼 놓치지 않습니다.", false],
		[8, "", "스스로 인정하는 것보다 정도 많습니다. 쓸데없는 살생을 싫어하며 파일럿의 마음 상태를 늘 살핍니다.", false],
		[28, "", "파일럿이 어찌할 바를 모를 때, 압박 속에서도 침착한 판단으로 위기를 구합니다.", false],
		[1, "관계", "파일럿과 끊임없이 다투지만 서로를 전적으로 신뢰합니다.", false],
		[3, "", "[[character/9]]을 보자마자 싫어합니다.", false],
		[14, "", "[[character/5]]에 대한 질투는 반복되는 농담거리입니다.", false],
		[19, "", "[[character/2]]를 존중하지만 보수가 너무 적다고 불평합니다.", false],
		[22, "", "[[character/3]]를 재빨리 판단하는데, 그 판단은 옳았던 것으로 드러납니다.", false],
	],
	"character/10": [
		[5, "", "[[character/10]] 항목은 임무 중 말을 하는 [[faction/pirates]] 세력의 무법자 파일럿들을 가리키는 이름입니다. 이들은 바다 곳곳에서 선박을 노리며, 함선에 무기를 단 파일럿의 첫 표적이 됩니다.", false],
		[6, "화자", "파일럿이 처음 맞서는 적은 [[station/1]] 정거장 근처의 해적으로, 분노의 외침과 함께 격침됩니다([[chapter/5]]).", false],
		[21, "", "이주민과 반군의 갈등이 커지자 해적들은 혼란을 틈타 손쉬운 먹잇감을 사냥하고, [[character/2]]는 반군이 반격해야 한다고 결심합니다([[chapter/21]]).", false],
		[43, "", "[[station/17]] 정거장 근처에서 한 해적 무리가 [[world/eclipse|이클립스]]의 첫 표적이 됩니다. 그중 한 명은 파일럿의 화력에 겁에 질려 도움을 요청하고, 그 바람에 더 많은 해적이 싸움에 끼어듭니다([[chapter/42]]). 해적과의 전투는 [[guide/combat]] 항목에서 다룹니다.", false],
	],
	"character/11": [
		[35, "", "[[character/11]]은 암시장 상인 [[character/8]]를 없애기 위해 [[station/15]] 정거장의 보안 당국이 고용한 현상금 사냥꾼입니다. [[character/8]]는 [[world/eclipse|이클립스]]의 대가로 그의 죽음을 요구합니다.", false],
		[35, "배경", "[[character/8]]에 따르면 [[character/11]]은 [[station/15]] 정거장 근처 해역을 순찰합니다. 그는 정거장 당국을 위해 일하는 일종의 법 집행자이며, 그의 표적은 범죄자입니다. 그래서 파일럿의 임무는 도덕적으로 꺼림칙합니다. 반군에게 필요한 무기를 얻으려면 불법 물품 상인을 위해 사람을 죽여야 하기 때문입니다.", false],
		[36, "이야기 속 역할", "파일럿이 그를 찾아냈을 때 [[character/11]]은 혼자가 아닙니다. 여러 척의 호위를 거느리고 있습니다. 그는 파일럿을 어부라 부르며 비키라고 명령하고, 자신은 할 일이 있다고 고집합니다. 전세가 불리해지자 그는 결국 평화롭게 해결할 수 없겠느냐고 묻습니다. 그의 함선은 파괴됩니다([[chapter/35]]).", false],
		[37, "", "그의 죽음으로 파일럿은 [[character/8]]의 도움을 얻고, 상인은 곧 대포를 팔겠다고 나섭니다.", false],
		[39, "", "나중에 파일럿은 [[character/2]]에게 대포를 구하는 과정에서 무고한 사람은 죽지 않았다고만 말합니다.", false],
		[36, "성격", "[[character/11]]은 지고 있기 전까지는 자신만만하고 남을 깔보다가, 불리해지면 재빨리 빠져나갈 길을 찾습니다. 그는 파일럿을 길을 잘못 든 평범한 어부, 사소한 장애물로 여기며 크게 얕봅니다.", false],
	],
	"character/12": [
		[45, "", "[[character/12]]은 Atmos 편대의 지휘관입니다. 이 [[faction/rebels|반군]] 부대는 최종 공세 중 [[station/18]] 정거장에 대한 파일럿의 공격에 합류합니다.", false],
		[45, "이야기 속 역할", "[[character/2]]는 파일럿이 [[station/18]] 정거장으로 이동하는 동안 파일럿을 위해 부대를 모으겠다고 약속합니다. [[character/12]]의 편대도 그중 하나입니다. 파일럿이 도착하자 그는 함선들이 배치를 마치고 공격 명령을 기다리고 있다고 보고합니다. 같은 시각 [[world/aquarians|아쿠아리안]] 무리가 깊은 곳에서 나타나고, 파일럿의 명령과 함께 전투가 시작됩니다([[chapter/45]]).", false],
		[46, "", "그들은 함께 이주민 함선을 모두 격파하며, 화물선조차 남기지 않습니다.", false],
		[46, "", "전투가 끝난 뒤 파일럿은 [[character/12]]에게 함선 절반은 정거장 주변을 순찰하게 하고 나머지는 파일럿과 함께 도킹해 정거장을 장악하라고 명령합니다. 그는 군말 없이 따릅니다.", false],
		[47, "", "이 전투는 반군 함선과 [[world/aquarians|아쿠아리안]]이 파일럿의 지휘 아래 처음으로 나란히 싸운 전투이며, 그 성공이 식민지에 대한 최후의 공격으로 가는 길을 엽니다.", false],
		[45, "성격", "[[character/12]]은 말이 짧고 명령을 신속히 따릅니다. 그는 파일럿의 지휘 아래 복무하는 첫 반군 장교로, 식민지를 위해 물고기를 잡던 시절 이후 파일럿이 얼마나 높이 올라섰는지 보여 줍니다. 짧고 사무적인 그의 무전 말투는 파일럿의 다른 동료들이 주고받는 농담과 대조를 이룹니다.", false],
	],
	"character/2": [
		[18, "", "[[character/2]]는 파일럿이 [[station/6]] 정거장에서 만나는 [[faction/rebels|저항 조직]]의 일원입니다.", false],
		[19, "", "그녀는 조직의 지도자로, 첫 만남부터 파일럿의 임무를 지휘하는 나이 지긋한 여성입니다. 차분하고 따뜻하며 단호한 그녀는 식민 통치에 맞선 조직의 투쟁을 이끕니다.", false],
		[21, "배경", "[[character/2]]가 이끄는 조직은 스스로를 행성의 파멸에 반대하는 사람들의 연합으로 여깁니다. 그녀가 보기에 식민화의 속도와 무자비한 바다 수확은 바다의 식물과 동물에게 회복할 시간을 주지 않으며, 다른 세계들도 이미 같은 식으로 고갈되었습니다. 그녀의 전략은 싸우기보다 정거장을 운영하는 사람들을 설득해 끌어들이는 것입니다.", false],
		[23, "", "그녀는 [[character/9]]을 예전부터 압니다. 처음 만났을 때 그는 보잘것없는 인물이었으며, 그녀는 그가 재능이 아니라 연줄 덕분에 출세했다고 믿습니다.", false],
		[31, "", "그녀는 정거장들 사이에 정보원망을 두고 있으며, 반군 구역 곳곳으로 과학자, 자금, 함선을 움직일 권한을 갖고 있습니다.", false],
		[19, "이야기 속 역할", "[[character/2]]의 첫 명령은 호위 임무입니다. 파일럿은 이주민 사냥꾼들로부터 [[species/10|오징어]] 떼를 지켜야 합니다([[chapter/19]]). 그녀는 보수 이야기는 하지 않고 조직의 계획도 거의 말하지 않는데, 신참을 믿을 수 있는지 시험하는 것으로 보입니다. 파일럿이 남자를 예상했었다고 털어놓아도 그녀는 그냥 넘어갑니다.", false],
		[20, "", "그녀는 그 일에 적은 보상을 주고 곧바로 다음 일을 위해 파일럿을 다시 부릅니다.", false],
		[21, "", "파일럿이 답을 요구하자 그녀는 조직의 목표를 설명합니다. 또 갈등을 틈타 이득을 챙기는 해적들에게 본때를 보여 줘야 한다고 판단하고, 자신의 최고 전사 [[character/3]]와 함께 파일럿을 [[station/8]] 정거장 근처의 해적 무리에게 보냅니다([[chapter/21]]).", false],
		[22, "", "그녀는 보상을 두 파일럿에게 똑같이 나눠 [[character/3]]를 짜증 나게 하고, [[station/9]] 정거장의 협상으로 넘어갑니다.", false],
		[23, "", "그곳에서 그녀는 [[character/9]]이 [[station/37]] 정거장으로 가는 보급로에 깔아 둔 기뢰밭을 제거하라며 파일럿을 보내고, 해적이 있을 것이며 기뢰는 작동한 뒤에야 파괴할 수 있다고 경고합니다([[chapter/23]]).", false],
		[25, "매복", "[[character/2]]의 다음 목표는 [[station/10]] 정거장으로, 그곳에서 협상을 더 하면 더 많은 정거장을 반군 쪽으로 끌어들일 수 있습니다. 그녀는 [[character/3]], [[character/5]], 파일럿을 호위로 데려가며, [[character/3]]에 대한 파일럿의 의구심을 고집은 세지만 훌륭한 파일럿이라며 일축합니다([[chapter/25]]).", false],
		[25, "", "도착해 보니 [[character/9]]이 병력을 이끌고 기다리고 있습니다. [[character/2]]는 자신들의 계획이 미리 새어 나갔다는 데 충격을 받습니다.", false],
		[26, "", "[[character/3]]가 전투에서 달아나고, [[character/2]]와 이주민 사이에는 파일럿과 [[character/5]]만 남습니다. 그 뒤 그녀는 사보타주 가능성을 입 밖에 내면서도, [[character/3]]가 배신자라는 [[character/5]]의 비난은 믿으려 하지 않습니다. 그녀는 몸을 숨기면서 [[station/9]] 정거장의 일을 [[character/5]]에게 맡기고, 외교만으로는 전쟁에서 이기지 못할 수도 있다고 파일럿에게 경고합니다([[chapter/26]]).", false],
		[28, "포로 생활", "[[character/3]]에 대한 그녀의 믿음은 빗나갔음이 드러납니다. 그는 그녀를 붙잡아 [[character/9]]에게 넘기려 합니다. [[station/11]] 정거장 근처의 대치에서 그녀는 자신의 안전은 신경 쓰지 말라고 파일럿을 재촉합니다. 파일럿은 격파된 [[character/3]]의 함선 화물칸에서 그녀를 구해 내고, 그녀는 충격을 받았지만 다친 데 없이 [[station/12]] 정거장에 도착합니다([[chapter/28]]).", false],
		[29, "", "그런 때에도 그녀는 조직을 먼저 생각합니다. 붙잡히기 전 그녀는 과학자 일행을 [[station/14]] 정거장으로 옮기는 일을 준비해 두었는데, [[character/3]]가 그것까지 팔아넘겼을까 두려워 곧바로 파일럿을 보내 호송대를 지키게 합니다([[chapter/29]]).", false],
		[31, "세 단계 계획", "[[station/14]] 정거장에서 [[character/2]]는 자신의 계획을 밝힙니다. 반군은 여전히 수적으로 우세한 식민 함대와 점점 더 자주 충돌하고 있으므로, 그녀는 무기를 만들기 위해 [[world/abel]]와 그의 팀을 데려왔습니다. 작업은 세 단계로 이루어지며, 첫 단계는 이주민이 교수에게서 훔쳐 간 동력원 [[world/biotek]]입니다. [[character/5]]가 습격을 준비하는 동안 그녀는 교수를 만나러 떠납니다([[chapter/31]]).", false],
		[33, "", "두 번째 단계로 그녀는 보통 정거장 방어에 쓰이는 대포인 [[world/eclipse|이클립스]]를 원합니다. 가장 가까운 제조지인 [[station/188]] 정거장은 이주민의 손에 있고 이 무기는 팔지도 않으므로, 그녀는 파일럿에게 거액의 뇌물 자금을 주며 자신의 계획은 거기까지라고 인정합니다([[chapter/33]]).", false],
		[39, "", "대포가 도착하자 그녀는 어떻게 구했는지 모르는 편이 낫다며 피를 흘리지 않았기를 바랍니다. 파일럿이 이 계획이면 행성을 지배할 수도 있겠다고 농담하자 그녀는 발끈합니다. 마지막 단계를 위해 그녀는 인큐베이터에 대한 교수의 설명을 전하며 자신은 이해하지 못한다고 솔직히 인정하고, 파일럿을 [[station/16]] 정거장으로 보냅니다([[chapter/39]]).", false],
		[43, "최종 공세", "이주민이 [[station/14]] 정거장을 기습하자 [[character/2]]는 처음에는 모든 것을 잃었다고 믿습니다([[chapter/43]]).", false],
		[44, "", "그녀는 살아남고, 정거장을 구한 공을 파일럿과 [[world/aquarians|아쿠아리안]]에게 돌립니다.", false],
		[45, "", "그녀는 [[world/aquarians|아쿠아리안]] 사절을 맞이하고, 사절은 자기 종족이 식민지와의 싸움을 돕겠다는 뜻을 전합니다. 이제 [[station/188]] 정거장이 반군의 손에 들어왔으므로, 그녀는 가능한 한 많은 함선을 [[equipment/42]] 장비로 무장시킬 계획을 세우고 두 공세를 동시에 개시합니다. 파일럿은 [[station/18]] 정거장을 차지하고, [[character/5]]는 [[station/109]] 정거장을 공격합니다([[chapter/45]]). 그녀는 [[character/5]]를 걱정하는 파일럿을 놀립니다.", false],
		[47, "", "[[station/0]] 정거장에 대한 최후의 공격에는 그녀가 직접 전투에 나섭니다([[chapter/47]]).", false],
		[48, "", "승리 후 그녀는 파일럿과 [[character/5]]에게 감사하며, 행성이 회복하려면 오랜 시간이 필요할 것이라고 인정합니다.", false],
		[19, "성격", "[[character/2]]는 따뜻하고 차분하며, 젊은 요원들을 마치 자기 자식처럼 대합니다. 기대하는 것은 많지만 보수는 적습니다.", false],
		[26, "", "그녀는 지나칠 만큼 자기 사람들에게 충실합니다. 다른 이들이 의심을 품은 뒤에도 오랫동안 [[character/3]]를 감쌉니다.", false],
		[28, "", "[[character/3]]는 그녀를 이 일을 하기엔 너무 늙은 몽상가라고 부르지만, 이야기의 나머지 부분은 그 평가를 뒷받침하지 않습니다.", false],
		[33, "", "그녀의 계획은 세밀하기보다 대담하며, 요원들의 임기응변에 기댑니다. 그녀는 외교를 선호하고 유혈 사태를 피하기를 바라지만, 조직이 싸워야 한다는 것을 받아들입니다.", false],
		[19, "관계", "그녀는 누구보다도 파일럿을 신뢰하게 되고, 파일럿은 그 신뢰에 보답합니다.", false],
		[21, "", "그녀는 [[character/3]]를 최고의 파일럿으로 높이 평가합니다.", false],
		[23, "", "그녀는 [[character/9]]을 경멸할 뿐입니다.", false],
		[25, "", "그녀는 [[character/5]]를 믿음직한 부관으로 대하며, 자리를 비울 때 지휘를 맡깁니다.", false],
		[31, "", "[[character/4]]는 그녀 밑에서 기술 전문가로 일하고, [[world/abel]]는 그녀의 무기를 만듭니다.", false],
	],
	"character/3": [
		[21, "", "[[character/3]]는 [[character/2]]의 최고 파일럿 중 한 명으로, 재능 있지만 거만한 전사입니다. 그녀는 [[station/8]] 정거장 근처의 해적 무리를 습격하는 일에 그를 파일럿과 짝지어 보냅니다.", false],
		[21, "성격", "[[character/3]]는 조급하고 허풍이 셉니다. 늦게 왔다고 파일럿을 꾸짖고, 혼자서도 일을 끝낼 수 있었다고 큰소리치며, 자기 뒤에 붙어서 배우라고 말합니다. [[character/1]]는 그의 매너는 몰라도 명성에는 감탄합니다.", false],
		[22, "", "그는 신참을 존중하지 않으며, 파일럿을 어부의 자식이라고 조롱합니다.", false],
		[28, "", "본질적으로 그는 용병입니다. 충성을 돈으로 재며, 조직을 움직이는 이상에는 관심이 없습니다.", false],
		[21, "이야기 속 역할", "[[character/2]]는 [[character/3]]를 자신의 최고 파일럿 중 한 명으로 소개하고, 해적을 상대로 그와 함께 출격하라며 파일럿을 보냅니다([[chapter/21]]). 그는 이미 목표 지점에서 기다리며 지체된 데 짜증을 냅니다.", false],
		[22, "", "[[character/3]]는 유능한 파일럿이며, 전투가 끝나자 모욕으로 포장한 마지못한 칭찬을 파일럿에게 건넵니다. [[character/2]]가 보상을 똑같이 나누자 그는 격분하며, 파일럿은 거의 기여하지 않았고 그녀가 초보에게 돈을 낭비한다고 불평합니다.", false],
		[25, "", "[[character/2]]는 [[station/10]] 정거장으로 가는 호위에 그를 고릅니다. 파일럿은 달가워하지 않지만, 그녀는 그가 고집은 세도 실력은 좋다고 보증합니다([[chapter/25]]).", false],
		[26, "매복", "[[character/9]]의 병력이 [[station/10]] 정거장에서 매복을 펼치자 [[character/3]]는 한 발도 쏘지 않습니다. 그는 무기가 고장 났다고 주장하며 사과하고 달아납니다. [[character/5]]는 그가 배신했다고 확신하고, [[character/2]]는 사보타주를 의심하면서도 여전히 그를 감쌉니다.", false],
		[27, "배신", "얼마 뒤 그는 파일럿에게 연락해 [[character/2]]와 [[character/5]]의 안부를 초조하게 묻고, 중요한 소식이 있다고 주장합니다. 그는 [[station/11]] 정거장 근처에서 만나자고 합니다. [[character/1]]는 함정이 틀림없다고 확신합니다([[chapter/27]]).", false],
		[28, "", "함정이 맞습니다. [[character/3]]는 [[character/2]]를 붙잡아 두고, 파일럿이 항복하지 않으면 그녀를 죽이겠다고 위협합니다. 그는 거리낌 없이 이유를 밝힙니다. [[character/2]]는 이끌기에는 너무 늙은 몽상가이고, [[character/9]]이 그녀와 파일럿 모두에게 거액의 현상금을 걸었다는 것입니다. 그는 [[character/9]]이 왜 파일럿을 두려워하는지 모르며 관심도 없다고 인정합니다. 그는 [[character/2]]의 보수가 박해서 고용주를 바꿨을 뿐이라며, 이상에 대한 파일럿의 이야기를 일축합니다.", false],
		[28, "", "그가 떠드는 동안 [[character/1]]는 그의 1인승 함선을 스캔해 [[character/2]]가 어디 있을지 알아냅니다. 그러자 파일럿이 공격합니다. [[character/3]]는 끝까지 빠르고 자신만만하지만 그의 함선은 파괴됩니다. 파일럿은 [[character/2]]가 살아 있는 장갑 화물칸을 회수하고, [[character/3]]는 [[station/11]] 정거장 근처에서 자신의 함선과 함께 가라앉습니다.", false],
		[28, "", "돌이켜 보면 [[station/10]] 정거장에서의 무기 고장은 연출된 것으로 보입니다. 이야기 속 어디에도 그의 사과가 진심이었다는 암시는 없습니다.", false],
		[29, "", "그의 배신은 긴 그림자를 드리웁니다. [[character/2]]는 그가 죽기 전에 과학자 호송대에 대한 소식을 넘겼을까 두려워합니다([[chapter/29]]).", false],
		[47, "", "최후의 전투에서 [[character/9]]은 파일럿이 [[character/3]]의 마지막 말임을 알아보는 협박을 입에 올립니다. 파일럿이 그를 죽였다는 것을 알게 된 [[character/9]]은 [[character/3]]가 파일럿의 형제였다고 주장합니다. 그 거짓말은 단번에 실패합니다.", false],
		[21, "관계", "[[character/2]]는 그를 전적으로 신뢰하며, 그의 실력을 다른 어떤 파일럿보다 높이 평가합니다.", false],
		[22, "", "그는 처음부터 파일럿을 경멸합니다.", false],
		[26, "", "[[character/5]]는 그를 믿지 않으며, 그를 배신자라고 부른 것도 그녀가 처음입니다.", false],
		[28, "", "결국 그는 동료들이 맞서 싸우는 바로 그 사람, [[character/9]]에게 자신을 팝니다.", false],
	],
	"character/4": [
		[12, "", "[[character/4]]는 [[station/3]] 정거장을 거점으로 하는 [[faction/rebels|저항 조직]]의 일원입니다.", false],
		[13, "", "그는 파일럿이 직접 얼굴을 마주하는 첫 반군입니다. 신입을 심사하고 첫 임무를 내립니다.", false],
		[13, "파일럿 심사", "파일럿이 [[station/3]] 정거장에 도착하자 [[character/4]]는 신참이 무엇을 어떻게 알게 되었는지 뒤엉킨 질문을 연달아 던집니다. 파일럿은 자유 무역을 지지하는 저항 조직이 있다는 소문 말고는 아무것도 모른다고 털어놓습니다. [[character/4]]는 미심쩍어하지만, 조직이 무선 통신을 암호화하기 시작한 것이 겨우 이틀 전이라는 점을 들어 그 이야기가 그럴듯하다고 봅니다([[chapter/12]]).", false],
		[13, "", "시간도 사람도 부족한 [[character/4]]는 파일럿을 시험 삼아 받아들입니다. 그는 행성 착취를 멈춰야 하므로 반군이 이주민 정거장에 침투해 그 지도자들을 끌어들일 계획이라고 설명합니다. 낯선 사람에게 그 이상은 말하지 않고, 첫 과제를 줍니다. [[station/4]] 정거장에서 지지자들을 태워 [[station/5]] 정거장으로 데려가는 일입니다([[chapter/13]]).", false],
		[17, "혁명의 확산", "나중에 [[character/4]]는 너무 길어서 [[character/1]]가 요점만 읽어 줄 정도의 메시지로 파일럿을 [[station/3]] 정거장에 다시 부릅니다([[chapter/17]]).", false],
		[18, "", "직접 만나자 그는 외교 덕분에 많은 정거장이 반군 쪽으로 넘어와, 이제 파일럿이 더 넓은 지역에서 거래할 수 있다고 알립니다. 언론은 벌써 혁명을 이야기하고, [[character/4]]도 그 표현에 동의합니다. 아직 피는 흘리지 않았지만 그는 그것이 바뀔 것이라고 예상합니다. 그는 조직의 지도자가 새로 확보한 정거장 중 한 곳에 있으며 연락해 올 것이라고 알려 주고, 일부 정거장은 더 좋은 장갑이나 실드가 있어야 갈 수 있다고 경고합니다. [[guide/depth]] 항목을 참고하세요([[chapter/18]]).", false],
		[31, "호송대 습격", "과학자들을 호위한 파일럿이 [[station/14]] 정거장에 도착했을 때 [[character/4]]도 그곳에 있습니다. 그는 감사 연설을 준비했지만 끝내 하지 못하고, 나중에도 파일럿이 함선으로 서두르는 바람에 또 말이 중간에 끊깁니다. 그는 파일럿, [[character/5]]와 함께 [[world/biotek]]를 운반하는 이주민 호송대를 공격합니다([[chapter/31]]).", false],
		[32, "", "호송대 승무원들이 식량과 의약품만 싣고 있다고 사정하자, [[character/4]]는 그게 바로 반군에게 필요한 것이라고 무전으로 대답합니다. [[character/5]]는 그가 꽤 농담꾼이라고 말합니다.", false],
		[33, "", "그 뒤 [[character/2]]는 할 일이 많은 격납고를 그에게 맡깁니다. 또 함선에 [[world/eclipse|이클립스]]를 탑재하는 기술적인 문제는 그에게 물어보라고 합니다([[chapter/33]]).", false],
		[13, "성격", "[[character/4]]는 신중하고 격식을 차리며 비밀스럽습니다. 설명보다 명령을 먼저 내리며, 조직의 계획은 그럴 자격을 얻은 사람에게만 알려 줍니다.", false],
		[18, "", "말이 길기도 해서, [[character/1]]는 그가 입을 열 때마다 이를 놀립니다.", false],
		[32, "", "딱딱한 태도 뒤에는 건조한 유머 감각과 다가올 전쟁에 대한 현실적인 시각이 있습니다.", false],
		[13, "관계", "[[character/4]]는 조직에서 파일럿의 첫 연락 상대입니다. 파일럿이 믿을 만하다는 것을 증명할수록 그의 신뢰도 커집니다.", false],
		[19, "", "그는 [[character/2]] 밑에서 일하며 그녀의 명령을 전달합니다.", false],
		[32, "", "그는 [[character/5]]와 함께 싸우며, 그녀는 그의 농담을 두고 그를 놀립니다.", false],
	],
	"character/5": [
		[13, "", "[[character/5]]는 [[faction/rebels|저항 조직]]의 일원으로, 파일럿이 [[station/4]] 정거장에서 데려오라는 지시를 받는 인물입니다.", false],
		[14, "", "쾌활하고 따뜻하며 잘 웃는 그녀는 파일럿의 가장 가까운 동료 중 한 명이 됩니다. 파일럿은 처음 본 순간부터 그녀에게 끌리고, [[character/1]]는 그 때문에 두고두고 짜증을 냅니다.", false],
		[14, "첫 만남", "[[character/5]]는 [[station/4]] 정거장에서 파일럿을 반갑게 맞이하며 서둘러 떠나려 합니다. 파일럿이 조직에 대해 묻자, 신입은 자신과 조직의 안전을 위해 아무것도 모르는 채로 둔다고 설명합니다. 그녀는 목적지를 함선 컴퓨터에 보내며 빨리 가야 한다고 강조합니다([[chapter/13]]).", false],
		[15, "", "[[station/5]] 정거장에서 그녀는 처리할 일이 있어 몸을 숨깁니다. 떠나기 전에 그녀는 반군이 이주민과 어떻게 다른지 설명합니다. 바다를 바닥내는 대신 바다가 내주는 것으로 살고, 어획물을 상품으로 가공하며, 남획하지 않도록 주의한다는 것입니다. 그녀는 상품 5톤을 생산해 이 생활 방식을 직접 해 보라고 파일럿에게 부탁하며, 오징어와 [[goods/35]] 상품으로 [[goods/22]] 상품을 만들 수 있는 [[station/90]] 정거장을 추천합니다([[chapter/14]]).", false],
		[16, "", "상품이 만들어지자 그녀는 새 과제를 들고 다시 연락합니다. 조직이 식민지의 약점을 찾으려면 모든 정거장의 새 정보가 필요하다는 것입니다. 그녀의 말대로 무기만으로는 이길 수 없기 때문입니다. 반군이 혁명을 계획하고 있느냐는 질문에는 더 말하기를 거절합니다([[chapter/15]]).", false],
		[25, "재회와 매복", "파일럿은 [[station/9]] 정거장에서 [[character/5]]와 다시 만나고, 둘은 어색한 칭찬을 주고받습니다. [[character/2]]가 재회를 끊고 둘 모두에게 자신과 [[character/3]]를 [[station/10]] 정거장까지 호위하라는 임무를 줍니다([[chapter/24]]).", false],
		[25, "", "도착했을 때 무언가 잘못되었음을 가장 먼저 느끼는 것은 [[character/5]]입니다.", false],
		[26, "", "매복 중 그녀는 [[character/3]]가 싸우지 않는 것을 보고, 달아나는 그를 소리쳐 부릅니다. 그 뒤 그를 대놓고 배신자로 몰며 파일럿에게 지지를 구합니다. [[character/2]]는 자리를 비우는 동안 [[station/9]] 정거장의 지휘를 그녀에게 맡깁니다([[chapter/25]]).", false],
		[31, "세 단계 계획", "[[station/14]] 정거장에서 [[character/5]]는 이미 [[character/2]]가 구출된 이야기를 알고 있습니다. 그녀는 계획의 첫 단계를 파일럿에게 브리핑합니다. 한 정보원에 따르면 [[world/biotek]]가 평범한 화물 사이에 숨겨져 마아스로 운송되고 있다는 것입니다. 어느 함선에 실렸는지 아무도 모르므로, 그녀는 [[station/2]] 정거장 근처에서 호송대 전체를 습격하라고 명령합니다([[chapter/30]]).", false],
		[32, "", "그녀는 요격을 이끌며 모든 컨테이너가 회수되도록 챙깁니다([[chapter/31]]).", false],
		[33, "", "이어서 [[character/2]]는 기습에 대비해 [[station/14]] 정거장 밖을 순찰하는 임무를 그녀에게 맡깁니다.", false],
		[42, "", "파일럿이 [[goods/36]] 장치를 가지고 돌아오자 [[character/5]]는 뛸 듯이 기뻐합니다. 그녀는 [[world/abel]]가 모든 준비를 마쳤다고 알리고, 해적을 상대로 대포를 시험하라는 [[character/2]]의 명령을 전하며, 발전기가 시제품일 뿐이라는 점을 일깨워 줍니다([[chapter/41]]).", false],
		[45, "공세", "최종 공세에서 [[character/5]]는 [[station/109]] 정거장 공격을 이끌고, 파일럿은 [[station/18]] 정거장을 공격합니다. [[character/2]]는 그녀가 자기 일을 잘 아는 숙련된 파일럿이라며 파일럿을 안심시킵니다([[chapter/44]]).", false],
		[47, "", "그녀의 공격은 성공합니다. 그녀는 이 소식과 함께 [[station/0]] 정거장에서 마지막 전투를 치르라는 [[character/2]]의 명령을 파일럿에게 전하고, 자신도 길에서 해적들을 뚫고 출발합니다([[chapter/46]]).", false],
		[48, "", "[[station/0]] 정거장에서 그녀는 [[character/2]], 파일럿과 나란히 싸웁니다. 승리 후 그녀는 [[goods/21]] 요리를 먹으며 축하하자고 파일럿을 초대하고, 파일럿은 받아들입니다([[chapter/47]]).", false],
		[14, "성격", "[[character/5]]는 친근하고 낙천적이며, 짧은 칭찬 한마디를 입버릇처럼 달고 삽니다. 또한 신중하고 헌신적이며, 조직이 무엇을 지향하는지 분명히 알고 있습니다.", false],
		[15, "", "그녀는 바다를 해치지 않으면서 바다에 기대어 살아야 한다고 믿으며, 그 생각을 쉽게 설명할 줄 압니다.", false],
		[26, "", "그녀는 사람을 빨리 판단하는데, [[character/3]]의 경우에는 그 판단이 옳았습니다.", false],
		[14, "관계", "파일럿은 처음부터 그녀에게 끌리고, 캠페인이 진행되면서 그 감정이 분명히 서로 같다는 것이 드러납니다. [[character/1]]는 이에 대해 끝없이 투덜댑니다.", false],
		[25, "", "[[character/2]]는 그녀에게 지휘를 맡길 만큼 신뢰하며, 그녀와 파일럿을 흐뭇하게 바라봅니다.", false],
		[26, "", "그녀는 [[character/3]]를 한 번도 믿지 않습니다.", false],
		[32, "", "그녀는 [[character/4]]와 긴밀히 일하며 그의 유머를 재미있어합니다.", false],
	],
	"character/6": [
		[8, "", "[[character/6]] 항목은 [[faction/colonists]] 세력의 수많은 단역 화자를 가리키는 이름입니다. 식민지 [[world/colony|행정부]]의 관리, 행정가, 수송선 승무원들입니다. 이들 중 누구도 이름이 없으며, 다 함께 식민지가 자신을 위해 일하는 외부인을 어떻게 대하는지 보여 줍니다.", false],
		[9, "화자", "첫 번째는 [[species/0|앵무조개]] 도살 뒤 파일럿을 맞이하는 [[station/1]] 정거장의 관리입니다([[chapter/8]]). 이 관리는 지저분한 일을 점잖은 말로 포장하기를 좋아하고, 적은 고정 금액을 치르며, 흥정을 거부합니다. 더 나은 일을 받으려면 파일럿은 먼저 계약 세 건을 완료해야 합니다.", false],
		[10, "", "이어서 같은 목소리가 [[station/2]] 정거장의 캡슐 방어 임무를 맡깁니다. 식민지는 수출품을 캡슐에 담아 궤도로 쏘아 올리는데, [[world/aquarians|아쿠아리안]]이 계속 이를 공격해 무역 당국의 우려를 사고 있습니다([[chapter/9]]).", false],
		[32, "", "한참 뒤 [[station/2]] 정거장 근처에서 이주민 호송대의 승무원들이 식량과 의약품만 싣고 있다며 사격을 멈춰 달라고 반군에게 애원합니다([[chapter/31]]).", false],
	],
	"character/7": [
		[12, "", "[[character/7]] 항목은 파일럿과 이야기를 나누는 [[faction/rebels]] 세력의 이름 없는 구성원들을 가리키는 이름입니다. 정거장 관제사, 경비대, 호송대 승무원들입니다. 이들의 목소리는 파일럿이 조직과 그 일상을 처음 접하는 순간을 보여 줍니다.", false],
		[12, "화자", "파일럿이 처음 듣는 반군의 목소리는 [[station/3]] 정거장의 경비병입니다. 그는 함선이 중립 수역에 들어왔다고 경고하며, 신원을 밝히지 않으면 발포하겠다고 위협합니다. 긴 침묵 끝에 파일럿은 도킹을 허락받습니다([[chapter/12]]).", false],
		[17, "", "파일럿이 정식 구성원으로 돌아오자 정거장은 파일럿을 이름으로 맞이하고 도킹 베이를 배정합니다([[chapter/17]]).", false],
		[29, "", "나중에 [[station/13]] 정거장 근처에서 과학자 호송대의 승무원들이 다급하게 도움을 요청합니다([[chapter/29]]).", false],
		[30, "", "그들은 나중에 파일럿에게 감사하며, 자신들만으로는 살아남지 못했을 거라고 말합니다.", false],
	],
	"character/8": [
		[34, "", "[[character/8]]는 파일럿이 [[world/eclipse|이클립스]]를 구할 방법을 찾던 중 [[station/15]] 정거장에서 만나는 상인입니다.", false],
		[35, "", "그는 늘 자신을 3인칭으로 부르는 암시장 상인으로, 돈만 있는 손님이라면 거의 무엇이든 구해 줄 수 있다고 큰소리칩니다.", false],
		[35, "배경", "[[character/8]]는 마약 거래가 법으로 금지된 [[station/15]] 정거장에서 장사를 합니다. 그의 활동 때문에 그는 표적이 되었습니다. 정거장 보안 당국이 그를 없애려고 현상금 사냥꾼 [[character/11]]을 고용한 것입니다. 그는 여러 곳에 연줄이 있으며, 고객이 원하는 것을 구하려면 뇌물도 마다하지 않습니다.", false],
		[35, "대포 거래", "파일럿이 [[goods/37]] 상품을 사려는 듯 현지 시장을 둘러보자 [[character/8]]는 파일럿을 따로 불러 이곳에서 그런 거래는 불법이라고 경고합니다. 그가 자기 서비스를 제안하고 파일럿이 [[equipment/42]] 장비를 요청하자, 그는 깜짝 놀라며 전쟁이라도 일으킬 셈이냐고 묻습니다. 파일럿은 개인 용도라고 둘러댑니다. [[character/8]]는 한 가지 조건으로 찾아보겠다고 합니다. 정거장 근처를 순찰하는 [[character/11]]을 찾아 죽이라는 것입니다([[chapter/34]]).", false],
		[37, "", "[[character/11]]이 죽자 [[character/8]]는 파일럿을 축하하며 약속을 지킵니다. 연줄과 막대한 뇌물 덕분에 그는 [[equipment/42]] 장비를 찾아냈고, 비싼 값을 부르면서도 그것이 헐값이라고 말합니다. 그는 판매자가 던이라는 남자였다고 밝히며, 물건만 확실하다면 이름 따위는 상관없다고 합니다([[chapter/36]]).", false],
		[37, "", "판매자는 [[character/9]]입니다. [[character/1]]는 그 아이러니를 짚습니다. [[character/9]]의 탐욕이 반군의 가장 중요한 무기를 그의 적의 손에 쥐여 주었다는 것입니다. 파일럿은 대포를 사서 [[station/14]] 정거장으로 가져갑니다([[chapter/37]]).", false],
		[35, "성격", "[[character/8]]는 약삭빠르고 조심스러우며 양심의 가책이 없습니다. 불법 물품을 거래하고, 대금을 청구하듯 아무렇지 않게 사람의 죽음을 요구합니다. 누가 엿들을까 경계해 거래 이야기를 꺼내기 전에 파일럿을 따로 부르고 입단속을 시킵니다. 돈을 내는 손님 앞에서도 위험을 따져 보며, 처음에는 낯선 사람에게 이런 무기를 팔아도 될지 확신하지 못합니다.", false],
		[37, "", "그래도 그 나름대로 믿을 만합니다. 값을 치르면 거래를 지키고, 파일럿이 요청한 바로 그것을 찾아 줍니다. 자기 이름으로 자신을 부르는 버릇과 적재적소에 아는 사람이 있다는 자부심 덕분에 그는 캠페인에서 손꼽히게 개성 있는 인물입니다.", false],
		[35, "관계", "[[character/11]]은 그를 쫓는 사냥꾼이었고, 파일럿을 통해 그의 희생자가 됩니다.", false],
		[37, "", "그는 상대가 어느 편인지 신경 쓰지 않고 [[character/9]]과도 파일럿과도 똑같이 거래합니다.", false],
	],
	"character/9": [
		[2, "", "성이 던인 [[character/9]]은 파일럿이 그날의 어획물을 파는 [[station/0]] 정거장의 이주민 관리입니다.", false],
		[3, "", "오만하고 야심만만한 그는 식민지를 위해 일하는 사람들을 대놓고 경멸합니다. 그는 파일럿의 첫 고용주이자 오랜 맞수가 됩니다.", false],
		[12, "배경", "[[character/9]]은 자신이 정거장의 직책보다 훨씬 큰일을 할 사람이라고 여깁니다.", false],
		[23, "", "[[character/2]]는 그가 보잘것없는 인물이던 시절부터 그를 알았습니다. 그녀가 보기에 그는 실력이 아니라 좋은 연줄로 출세했으며, 반란이 일어날 무렵에는 [[faction/colonists|이주민]] 병력에서 실권을 쥐고 있습니다.", false],
		[3, "초기의 만남", "[[character/9]]은 파일럿의 첫 어획물을 고정 가격에 사들이며 작은 화물칸을 비웃습니다. 그리고 차라리 [[faction/pirates|해적]] 사냥이 나을 거라고 덧붙이면서도, 파일럿이 그것조차 해낼지 의심합니다([[chapter/2]]).", false],
		[7, "", "파일럿이 무장하고 돌아오자 그는 자기 덕분이라며 일거리를 내놓습니다. [[station/1]] 정거장 주변 항로에서 [[species/0|앵무조개]]를 없애는 일입니다. 그는 파일럿의 반론을 일축하며, 그 생물을 어떻게 없애든 상관하지 않습니다([[chapter/6]]).", false],
		[10, "", "그는 [[station/2]] 정거장의 캡슐 발사를 지휘하며, 캡슐을 다섯 개보다 많이 잃으면 일자리를 잃게 될 거라고 파일럿에게 경고합니다([[chapter/10]]).", false],
		[12, "", "그 뒤 그는 손상된 캡슐을 파일럿 탓으로 돌리며 보상을 주지 않습니다. 그의 경멸은 파일럿을 저항 조직으로 몰아넣는 마지막 계기가 됩니다([[chapter/11]]).", false],
		[23, "반란에 맞서", "[[character/9]]은 반군이 커지자 그들에게 등을 돌립니다. 그는 [[station/9]] 정거장에서 [[station/37]] 정거장으로 가는 반군 보급로에 기뢰밭을 깔게 합니다([[chapter/22]]).", false],
		[25, "", "[[character/2]]가 협상을 위해 [[station/10]] 정거장에 도착했을 때 그는 병력을 이끌고 기다리고 있다가 즉시 공격을 명령합니다([[chapter/25]]).", false],
		[28, "", "그는 [[character/3]]의 배신 뒤에서 돈을 대는 인물입니다. 그는 [[character/2]]와 파일럿에게 거액의 현상금을 걸었는데, 파일럿을 위협으로 보는 듯합니다([[chapter/27]]).", false],
		[37, "", "그의 탐욕이 그의 몰락을 부릅니다. 그는 [[world/eclipse|이클립스]] 대포를 암시장 상인 [[character/8]]에게 팔고, 그 상인은 그것을 다시 파일럿에게 팝니다([[chapter/36]]).", false],
		[43, "패배", "[[character/9]]은 [[station/14]] 정거장에 대한 이주민의 기습을 이끕니다. 그는 반군을 위해 일하는 어부라며 파일럿을 조롱하다가, 파일럿이 [[equipment/42]] 장비를 달고 있다는 것을 알고 경악합니다([[chapter/43]]).", false],
		[44, "", "[[world/aquarians|아쿠아리안]]이 그의 함선들과 싸움에 가세하자 그는 공격을 포기하고 달아납니다.", false],
		[47, "", "[[character/9]]은 식민지의 마지막 거점인 [[station/0]] 정거장에서 최후의 저항을 펼칩니다. 파일럿이 [[character/3]]를 죽였다는 말을 듣고, 그는 [[character/3]]가 파일럿의 형제였으며 자신이 파일럿의 아버지라고 주장합니다. 파일럿은 그 거짓말을 단번에 꿰뚫어 보고, [[character/9]]은 하마터면 통할 뻔했다고 인정합니다([[chapter/47]]).", false],
		[48, "", "이어진 전투에서 [[character/9]]은 마지막으로 남은 이주민이 됩니다. 그는 정거장 전체를 끌고 가는 듯한 구명 캡슐을 타고 탈출하며, 물고기와 남는 사람들을 비웃는 말을 남기고 바다를 떠납니다.", false],
		[3, "성격", "[[character/9]]은 무례하고 거만하며, 자기보다 아래라고 여기는 사람은 누구든 무시합니다.", false],
		[12, "", "그는 남에게 책임을 떠넘기고, 일이 잘 풀리면 공을 가로챕니다.", false],
		[37, "", "그의 탐욕은 자기 편에 대한 충성보다 큽니다.", false],
		[47, "", "그는 용기 대신 거짓말과 뇌물을 쓰는 조종자이며, 전세가 불리해질 때마다 달아납니다.", false],
		[3, "관계", "파일럿에 대한 그의 멸시는 첫 만남부터 시작되어 캠페인을 거치며 공공연한 적대로 굳어집니다.", false],
		[23, "", "[[character/2]]는 오래전부터 그를 경멸해 왔습니다.", false],
		[28, "", "그는 현상금으로 [[character/3]]의 충성을 삽니다.", false],
		[37, "", "그는 물건이 결국 어디로 갈지 모른 채 [[character/8]]와 거래합니다.", false],
	],
	"chart": [
		[1, "", "해도는 정거장 200곳을 바다 지도 위의 위치에 점으로 보여 줍니다. 도달한 챕터를 기준으로 파란 점은 [[faction/colonists]] 세력, 주황 점은 [[faction/rebels]] 세력이 지배하는 정거장입니다. 모든 정거장은 파란색으로 시작하며, 이야기가 진행되면서 주황색으로 바뀌고 다시 돌아가지 않습니다.", false],
		[1, "", "정거장이나 챕터 페이지에서는 해당 정거장이 더 크게 그려지고 이름이 붙으며, 그 챕터에서 반군에 합류하는 정거장에는 윤곽선이 그려집니다. 해도 아래에는 모든 정거장이 각 페이지 링크와 함께 나열됩니다. 정거장 사이의 거리는 해도 단위로 측정합니다. [[guide/navigation]] 항목을 참고하세요.", false],
	],
	"contract/0": [
		[1, "", "정거장에서 400~1,200 m 떨어진 곳에서 기다리는 수배 함선 한 척을 찾아내 격파합니다. 표적은 일반 해적보다 훨씬 강하며, 그 강함은 파일럿 계급에 따라 커집니다. 장거리 무기와 어뢰가 있으면 표적이 다가오기 전에 약화시키는 데 도움이 됩니다. 현상금은 정거장으로 돌아가면 지급됩니다.", false],
	],
	"contract/1": [
		[1, "", "함선 3~6척으로 이루어진 무리가 구불구불한 경로를 따라 기다리고 있습니다. 표적은 그중 마지막 함선으로, 마지막 경유지에 있습니다. 그냥 격파할 수는 없습니다. 무력화한 뒤, 달아나기 전에 작살로 끌어와야 합니다. 견인이 방해받지 않도록 호위부터 처리하세요.", false],
	],
	"contract/10": [
		[1, "", "200~600 m 떨어진 곳에 있는, 함선 한 척이 지키는 기뢰 15~25개를 모두 파괴합니다. 기뢰는 가까운 거리에서만 맞힐 수 있으므로 하나하나 조심스럽게 접근하세요. 강한 실드와 장갑이 폭발을 견디는 데 도움이 됩니다.", false],
	],
	"contract/11": [
		[1, "", "보급 캡슐이 공격받고 있습니다. 계약의 최소 기준을 충족할 만큼 캡슐이 남아 있는 동안 공격자를 격파하세요. 캡슐 수를 지켜보며 캡슐에 다가가는 공격자부터 상대하세요. 이 임무는 기본 계약보다 보수가 약 30% 많습니다.", false],
		[10, "", "공격자는 이주민의 수송 캡슐을 노리는 반인반어의 바다 거주자, 아쿠아리안입니다.", false],
