const BLOCKS := {
	"chapter/1": [
		[1, "Synopsis", "La campagne s'ouvre en mer. Le pilote, nouveau venu sur la planète océanique engagé comme pêcheur pour la colonie, navigue dans un petit sous-marin avec [[character/1]], l'ordinateur de bord bavard. Ce chapitre enseigne la pêche au harpon : on aligne une créature, on tire le harpon, puis on garde la cible en vue pendant qu'elle se débat, jusqu'à ce qu'elle s'épuise et puisse être ramenée. Voir [[guide/fishing]].", false],
		[2, "Dénouement", "Une fois la première créature capturée, M.A.I. présente le pilote auto, qui peut conduire le vaisseau vers une cible choisie, et oriente le pilote vers [[station/0]] pour vendre la prise. Voir [[guide/navigation]].", false],
	],
	"chapter/10": [
		[10, "Synopsis", "À [[station/2]], le lancement des capsules a déjà commencé et les Aquariens attaquent. [[character/9]] lance un avertissement sec par radio : perdre plus de cinq capsules est inacceptable. Le pilote doit repousser les assaillants et préserver les capsules.", false],
		[11, "Dénouement", "L'attaque est repoussée, mais le pilote se demande pourquoi les Aquariens s'en prennent aux capsules. [[character/1]] suggère qu'ils sont peut-être bien plus intelligents que ne le pensent les colons. Le pilote se rend à la station pour faire son rapport, de moins en moins sûr de ce métier.", false],
	],
	"chapter/11": [
		[11, "Synopsis", "Le pilote s'amarre à [[station/2]] pour rendre compte à [[character/9]] de la défense des capsules.", false],
		[12, "Dénouement", "Jack tient le pilote pour responsable des capsules endommagées, annule la récompense et s'en va en affirmant être promis à un plus grand destin. [[character/1]] soulève alors une question plus large : le pilote travaille dur pour la colonie, gagne peu et n'a aucun droit de regard sur ses prises. Le pilote ne veut qu'assez d'argent pour un billet qui l'emmène hors de la planète. M.A.I. révèle avoir capté des communications radio d'un mouvement de résistance basé à [[station/3]] et marque la station sur la carte. Désormais, les stations de la résistance apparaissent en vert.", false],
	],
	"chapter/12": [
		[12, "Synopsis", "Le pilote se rend à [[station/3]] pour trouver la résistance. Une approche discrète échoue aussitôt : les gardes de la station interpellent le vaisseau et menacent d'ouvrir le feu. Le pilote se présente, explique être parti de [[station/0]] et demande à rejoindre le mouvement. Après un silence tendu, le vaisseau est autorisé à s'amarrer.", false],
		[13, "Dénouement", "À l'intérieur, [[character/4]] interroge le nouveau venu. Le pilote ne sait presque rien, hormis le soutien du mouvement au libre-échange, ce qui concorde avec l'explication de Pierre : leur chiffrement radio vient tout juste d'être activé. Manquant de bras, Pierre accepte le pilote à l'essai. Le mouvement compte rallier les dirigeants des stations colons et mettre fin à l'exploitation de la planète. La première tâche consiste à récupérer des sympathisants à [[station/4]] et à les conduire à [[station/5]].", false],
	],
	"chapter/13": [
		[13, "Synopsis", "Le pilote arrive à [[station/4]] pour récupérer le contact du mouvement, toujours sans idée précise de ce qu'est la résistance ni de ce qu'implique la mission. [[character/1]] fait remarquer que c'est au moins plus intéressant que de recevoir des ordres de [[character/9]], et le pilote en convient.", false],
		[14, "Dénouement", "Le contact est [[character/5]], chaleureuse, vive et visiblement ravie de rencontrer le pilote. Elle garde pour elle les projets du mouvement, expliquant que le secret leur a permis de survivre jusqu'ici, et envoie les coordonnées du trajet. [[character/1]] observe le duo avec un agacement manifeste, que le pilote met sur le compte de la jalousie.", false],
	],
	"chapter/14": [
		[14, "Synopsis", "Avec [[character/5]] à bord, le pilote doit la conduire à [[station/5]] aussi vite et sûrement que possible.", false],
		[15, "Dénouement", "À [[station/5]], Leah se met à l'abri pour régler quelques affaires. Avant de partir, elle explique comment travaillent les rebelles : ils ne prélèvent que ce que la mer peut céder, transforment leurs prises en marchandises et veillent à ne pas surpêcher. Elle propose au pilote d'essayer et de produire cinq tonnes de marchandises à l'usine d'une station de la résistance, en suggérant [[station/90]], où l'on peut pêcher des calmars et acheter des [[goods/35]] pour fabriquer des [[goods/22]].", false],
	],
	"chapter/15": [
		[15, "Synopsis", "Un chapitre consacré à la production. Le pilote doit produire cinq tonnes de marchandises à l'usine d'une station rebelle, en combinant prises et ingrédients achetés pour obtenir des produits qui valent plus que la matière première. Voir [[guide/trading]].", false],
		[16, "Dénouement", "[[character/5]] rappelle. Maintenant que le pilote dispose d'une seconde source de revenus, elle lui confie une nouvelle tâche : visiter le plus possible de stations inconnues. Le mouvement se sert de rapports récents sur chaque station pour repérer les points faibles et rallier la population à sa cause. Quand le pilote demande s'il s'agit d'une révolution, elle refuse d'en dire plus et lui conseille de gagner en attendant de quoi améliorer son vaisseau.", false],
	],
	"chapter/16": [
		[16, "Synopsis", "Le pilote doit découvrir cinq stations jamais visitées. L'exploration élargit le réseau commercial et recueille des informations pour le mouvement. Certaines stations peuvent se trouver hors de la portée en profondeur actuelle du vaisseau. Voir [[guide/depth]].", false],
		[17, "Dénouement", "[[character/4]] envoie un long message, que [[character/1]] résume en un seul point : le pilote doit retourner à [[station/3]] pour un briefing.", false],
	],
	"chapter/17": [
		[17, "Synopsis", "Le pilote retourne à [[station/3]] à la demande de [[character/4]] et reçoit l'autorisation de s'amarrer.", false],
		[18, "Dénouement", "Pierre annonce que la diplomatie a agrandi la zone rebelle : le pilote peut désormais commercer dans bien plus de stations. Les nouvelles parlent déjà de révolution, et de nombreux décideurs se sont ralliés sans effusion de sang, même si Pierre doute que cela dure. La dirigeante du mouvement oriente la suite des opérations depuis l'une des stations nouvellement gagnées et prendra contact. Pierre marque les stations possibles et prévient que pour atteindre certaines d'entre elles, un meilleur blindage ou de meilleurs boucliers pourraient être nécessaires.", false],
	],
	"chapter/18": [
		[18, "Synopsis", "Le pilote doit retrouver la tête du mouvement parmi les stations nouvellement gagnées, sans autre piste que la chance. La piste mène à [[station/6]].", false],
		[19, "Dénouement", "À [[station/6]], le pilote rencontre [[character/2]], qui dirige le mouvement et donnera désormais les ordres. Le pilote s'attendait à un homme, remarque qu'elle écarte d'un revers de main. Sa première mission est une escorte : un banc de [[species/10|pieuvres]] doit gagner des eaux sûres avant que les colons ne les capturent ou ne les tuent, et un combat est probable. [[character/1]] grommelle que personne n'a parlé de paiement.", false],
	],
	"chapter/19": [
		[19, "Synopsis", "Près de la station [[station/7]], le pilote doit protéger un banc de [[species/10]] contre des vaisseaux colons, en prenant soin de ne pas toucher les animaux. Des Aquariens nagent aux côtés du banc, et [[character/1]] se demande s'ils veillent sur les créatures de la mer.", false],
		[20, "Dénouement", "Des vaisseaux colons se rapprochent des animaux, et le pilote doit les intercepter avant qu'ils ne soient trop près. Le banc survit. [[character/2]] verse une modeste récompense et demande au pilote de revenir immédiatement pour une nouvelle mission. M.A.I. se plaint qu'attraper et vendre les animaux aurait mieux payé.", false],
	],
	"chapter/2": [
		[2, "Synopsis", "La cale pleine de poissons, le pilote met le cap sur [[station/0]], la station colon qui achète la pêche du jour. Ce chapitre est un simple trajet et une première occasion de s'amarrer et de découvrir une station.", false],
		[3, "Dénouement", "À [[station/0]], le pilote rencontre [[character/9]], responsable des achats de poisson. Il paie son habituel prix fixe, se moque de la taille de la cale du pilote et laisse entendre qu'avec une vraie arme, on gagnerait davantage à chasser les pirates. Une fois qu'il est parti, M.A.I. reconnaît qu'il est désagréable, mais retient l'idée : le [[equipment/0]] est justement en vente au hangar. M.A.I. explique aussi qu'une aide est disponible sur chaque écran de la station.", false],
	],
	"chapter/20": [
		[20, "Synopsis", "Le pilote retourne à [[station/6]] pour rendre compte à [[character/2]].", false],
		[21, "Dénouement", "Le pilote demande enfin à Ayumi ce que défend le mouvement. Elle décrit un groupe uni contre la ruine de la planète : la colonisation rapide épuise ses ressources plus vite que la nature ne peut se rétablir, comme cela s'est déjà produit sur d'autres mondes, et le but est de convaincre des personnes influentes de résister. Pendant ce temps, les [[faction/pirates]] profitent du conflit. Ayumi décide de frapper la première et envoie le pilote contre une formation pirate aux côtés de [[character/3]], l'un de ses meilleurs pilotes.", false],
	],
	"chapter/21": [
		[21, "Synopsis", "Près de [[station/8]], le pilote rejoint [[character/3]] pour anéantir une bande de pirates. Dès le premier instant, Raymond se montre impatient et condescendant, et ordonne au nouveau venu de rester derrière lui pour apprendre.", false],
		[22, "Dénouement", "La bande est détruite. Raymond concède quelques éloges du bout des lèvres, et [[character/2]] verse à chacun la même récompense avant de donner rendez-vous au pilote à [[station/9]]. Raymond est furieux que l'argent soit partagé à parts égales et minimise la contribution du pilote, qui s'éclipse avant que son humeur n'empire.", false],
	],
	"chapter/22": [
		[22, "Synopsis", "Le pilote se rend à [[station/9]] pour retrouver [[character/2]], dont les négociations sur place viennent de s'achever. Plusieurs stations, dont [[station/9]], se rangent désormais aux côtés du mouvement.", false],
		[23, "Dénouement", "Avant de partir, Ayumi veut sécuriser la route de ravitaillement vers [[station/37]]. [[character/9]] a posé un champ de mines juste devant la station pour la couper. Ayumi le connaît : autrefois personnage mineur, il a gravi les échelons grâce à des relations utiles. Elle prévient que des pirates rôdent sans doute dans la zone et que les mines ne peuvent être détruites qu'une fois déclenchées.", false],
	],
	"chapter/23": [
		[23, "Synopsis", "Devant [[station/9]], le pilote doit déblayer le champ de mines qui bloque la route vers [[station/37]]. Ayumi marque les mines sur la carte. Il faut s'approcher de chaque mine pour déclencher son détecteur de mouvement, et ce n'est qu'ensuite qu'on peut l'abattre. Des pirates rôdent à proximité dans l'attente d'une proie facile ; le pilote doit donc aussi s'en occuper. Voir [[contract/10]].", false],
		[24, "Dénouement", "Le champ de mines est déblayé et la route vers [[station/37]] est de nouveau sûre. [[character/2]] se réjouit que sa confiance ait été justifiée et rémunère le pilote pour ce travail.", false],
	],
	"chapter/24": [
		[24, "Synopsis", "Le pilote retourne à [[station/9]] après le déminage. La route de ravitaillement vers [[station/37]] étant rouverte, un vaste ensemble de stations à travers l'océan commerce désormais avec le mouvement, et la zone rebelle s'étend nettement sur la carte.", false],
		[25, "Dénouement", "À [[station/9]], le pilote retrouve [[character/5]], et la conversation est chaleureuse mais maladroite. [[character/2]] l'interrompt avec la mission suivante : de nouvelles négociations à [[station/10]] pourraient rallier d'autres stations. Le pilote et Leah doivent y escorter Ayumi et [[character/3]]. Le pilote n'est guère enthousiaste à l'idée de prendre la mer avec Raymond, mais Ayumi se porte garante de son talent et ne s'attend à rien de pire que des pirates.", false],
	],
	"chapter/25": [
		[25, "Synopsis", "L'escorte arrive à [[station/10]] et constate que quelque chose cloche. [[character/9]] attend avec des forces colons et leur ordonne d'attaquer. Ayumi ne comprend pas comment ils savaient qu'elle venait. Le pilote doit tenir les assaillants en respect et garder [[character/2]] en vie.", false],
		[26, "Dénouement", "Pendant le combat, [[character/3]] prétend que ses armes sont en panne et prend la fuite. Les autres survivent. [[character/5]] l'accuse de trahison, tandis qu'Ayumi lui fait encore confiance et soupçonne un sabotage. Avant l'arrivée d'autres colons, le groupe se disperse : Ayumi se cache, Leah fait tourner les affaires à [[station/9]], et le pilote reçoit pour consigne de devenir un combattant bien plus aguerri avant leurs retrouvailles.", false],
	],
	"chapter/26": [
		[26, "Synopsis", "Avec [[character/2]] cachée et [[character/3]] disparu, le pilote doit détruire dix vaisseaux ennemis de plus pour prouver qu'il est prêt pour les batailles plus rudes à venir. Les pirates sont des cibles commodes, et les contrats de combat des tableaux en offrent davantage. C'est le bon moment pour améliorer armes et blindage. Voir [[guide/combat]].", false],
		[27, "Dénouement", "[[character/3]] appelle à l'improviste, demande des nouvelles d'Ayumi et de Leah et affirme détenir des informations urgentes. Il propose un rendez-vous près de [[station/11]]. [[character/1]] est certain qu'il s'agit d'un piège. Le pilote en convient, et y va quand même.", false],
	],
	"chapter/27": [
		[27, "Synopsis", "Près de [[station/11]], le pilote suit les points de passage jusqu'au rendez-vous avec [[character/3]], en s'attendant pleinement à un piège. L'objectif, récupérer un vaisseau hors d'état de fonctionner, laisse deviner que la rencontre ne se limitera pas à une conversation.", false],
		[28, "Dénouement", "Raymond retient [[character/2]] prisonnière et exige la reddition du pilote. Pendant que [[character/1]] scanne son vaisseau, le pilote le fait parler. Raymond avoue avoir changé de camp pour l'argent : [[character/9]] a mis à prix la tête d'Ayumi et celle du pilote. Le scan révèle un vaisseau monoplace, Ayumi doit donc se trouver dans la soute blindée. Le pilote détruit le vaisseau de Raymond et récupère le conteneur avant qu'il ne coule, puis met le cap sur [[station/12]].", false],
	],
	"chapter/28": [
		[28, "Synopsis", "Le pilote transporte le conteneur récupéré jusqu'à [[station/12]], la station alliée la plus proche, en espérant que [[character/1]] a deviné juste quant à son contenu.", false],
		[29, "Dénouement", "[[character/2]] en sort secouée mais indemne, et remercie le pilote de lui avoir sauvé la vie. Pas le temps de se reposer. Avant sa capture, elle organisait le transport d'une équipe de scientifiques de haut niveau vers [[station/14]], et Raymond a peut-être déjà transmis les détails. Le pilote doit faire traverser la zone frontalière au convoi sans encombre.", false],
	],
	"chapter/29": [
		[29, "Synopsis", "Près de [[station/13]], le pilote trouve le convoi des scientifiques sous un feu nourri, juste à temps pour intervenir. Les vaisseaux alliés appellent à l'aide tandis que leurs défenses cèdent. Le pilote doit chasser les assaillants et escorter le convoi à travers la zone frontalière. Chaque vaisseau perdu met en péril le projet secret du mouvement.", false],
		[30, "Dénouement", "Le convoi passe, et son équipage remercie le pilote de l'avoir sauvé. [[character/2]] reconnaît que c'était juste. [[character/2]] rémunère le pilote et lui donne rendez-vous à [[station/14]], où elle expliquera la suite.", false],
	],
	"chapter/3": [
		[3, "Synopsis", "Un court chapitre d'initiation à l'équipement. Le pilote se rend au hangar de [[station/0]] pour acheter et installer le [[equipment/0]], la première véritable arme du vaisseau. Il montre comment acheter un équipement et le monter dans un emplacement libre. Voir [[guide/fitting]].", false],
		[4, "Dénouement", "Le canon électromagnétique une fois monté, M.A.I. rappelle au pilote de ne pas tirer sur la faune inoffensive et propose un essai immédiat contre les pirates.", false],
	],
	"chapter/30": [
		[30, "Synopsis", "Le pilote se rend à [[station/14]], où le convoi des scientifiques est arrivé.", false],
		[31, "Dénouement", "[[character/5]], [[character/4]] et [[character/2]] l'attendent. Ayumi expose le plan : les colons restent plus nombreux que les rebelles, si bien que le professeur Abel et son équipe vont construire une arme pour rétablir l'équilibre, en trois étapes. La première est une source d'énergie, le générateur Biotek. Le prototype d'Abel a été volé par les colons, qui tentent de l'achever eux-mêmes. Leah ajoute que le générateur voyage avec un convoi colon ordinaire près de [[station/2]]. Comme personne ne sait quel vaisseau le transporte, le pilote et Pierre doivent arrêter tout le convoi et récupérer chaque conteneur.", false],
	],
	"chapter/31": [
		[31, "Synopsis", "Près de [[station/2]], le pilote, [[character/5]] et [[character/4]] interceptent le convoi colon qui transporte le générateur Biotek volé. Personne ne sait quel vaisseau le détient, il faut donc arrêter tous les bâtiments du convoi. Les équipages protestent qu'ils ne transportent que des vivres et des médicaments, et [[character/4]] répond par une plaisanterie sinistre. Le pilote doit neutraliser les vaisseaux et récupérer chaque conteneur au harpon avant que la cargaison ne coule.", false],
		[32, "Dénouement", "Tous les conteneurs sont récupérés, le générateur avec eux, et l'équipe retourne à [[station/14]] pour remettre le butin au professeur Abel.", false],
	],
	"chapter/32": [
		[32, "Synopsis", "Le pilote retourne à [[station/14]] avec la cargaison récupérée.", false],
		[33, "Dénouement", "Le professeur Abel emporte le butin dans son laboratoire. [[character/2]] envoie [[character/5]] patrouiller autour de [[station/14]] et [[character/4]] au hangar, puis confie au pilote la deuxième étape. Le générateur a besoin d'une arme à la hauteur de sa puissance : le canon [[equipment/42]], un canon de défense de station si gourmand en énergie qu'il n'a jamais été monté sur un vaisseau. L'usine la plus proche, [[station/188]], est aux mains des colons ; le pilote devrait donc tenter sa chance à [[station/15]]. Le canon n'est pas en vente, alors Ayumi remet une grosse somme destinée aux pots-de-vin.", false],
	],
	"chapter/33": [
		[33, "Synopsis", "La deuxième étape du plan conçu par [[character/2]] commence. Le pilote part pour [[station/15]], une station rebelle, afin d'obtenir un canon [[equipment/42]]. Ce canon est normalement fabriqué à la station colon [[station/188]] et ne se vend ouvertement nulle part. Le pilote emporte une grosse caisse noire confiée par Ayumi, mais n'a pas de véritable plan et espère qu'une occasion se présentera sur place.", false],
		[34, "Dénouement", "Le pilote arrive à [[station/15]]. Sans contacts ni plan, la seule option est de faire le tour de la station et de voir ce qui se présente.", false],
	],
	"chapter/34": [
		[34, "Synopsis", "À [[station/15]], la piste commence par le stock du marchand local. L'objectif est d'obtenir une cargaison de la marchandise [[goods/37]], illégale dans cette station, ce qui attire le bon type d'attention.", false],
		[35, "Dénouement", "Un trafiquant du marché noir, [[character/8]], aborde le pilote et propose de lui fournir presque n'importe quoi. Quand le pilote demande un canon [[equipment/42]], il est stupéfait, mais accepte d'essayer en échange d'un service : éliminer [[character/11]], un chasseur de primes payé par les autorités de sécurité pour se débarrasser de Fenko, et qui patrouille près de la station.", false],
	],
	"chapter/35": [
		[35, "Synopsis", "Près de [[station/15]], le pilote traque [[character/11]], le chasseur de primes dont [[character/8]] veut se débarrasser. Raoul n'est pas seul : il a amené une escorte et tente d'écarter le pilote comme un simple pêcheur. Le pilote doit détruire le vaisseau recherché. Voir [[contract/0]].", false],
		[36, "Dénouement", "Le vaisseau de Raoul est détruit après une dernière tentative de négociation, et son escorte est mise en fuite ou coulée. Le pilote revient voir si [[character/8]] tiendra parole.", false],
	],
	"chapter/36": [
		[36, "Synopsis", "Le pilote s'amarre à [[station/15]] pour réclamer ce que [[character/8]] a promis, sans savoir si l'on peut compter sur un trafiquant du marché noir.", false],
		[37, "Dénouement", "Fenko a trouvé un canon [[equipment/42]] et accepte de le vendre, à un prix gonflé par les pots-de-vin qu'il a versés. Quand le pilote demande d'où il vient, Fenko nomme le vendeur : [[character/9]]. [[character/1]] savoure l'ironie de voir la cupidité de Jack armer ses propres ennemis. Le pilote décide d'acheter le canon et de partir avant que quoi que ce soit ne change.", false],
	],
	"chapter/37": [
		[37, "Synopsis", "[[character/8]] propose désormais l'[[goods/38|Eclipse]] à la vente à [[station/15]]. Le pilote doit l'acheter depuis l'écran de commerce et le charger à bord. Le prix est élevé, mais la caisse noire d'Ayumi était justement prévue pour cela, et la cale doit avoir assez de place pour ce gros canon. Voir [[guide/trading]].", false],
		[38, "Dénouement", "Le canon est dans la cale, ce que [[character/1]] a du mal à croire. La deuxième étape est accomplie. Le pilote retourne à [[station/14]] pour voir où en est le prototype du générateur.", false],
	],
	"chapter/38": [
		[38, "Synopsis", "Le pilote retourne à [[station/14]] avec le canon [[equipment/42]] dans la cale, impatient de voir où en est le professeur Abel avec le prototype.", false],
		[39, "Dénouement", "[[character/2]] préfère ne pas savoir comment le canon a été obtenu. Le prototype est presque terminé, mais une pièce ne peut pas être fabriquée à [[station/14]] : un [[goods/36]], un appareil qui multiplie l'ADN de particules d'algues pour amorcer la réaction énergétique du générateur. Seule [[station/16]] dispose de l'équipement nécessaire ; la troisième étape y envoie donc le pilote. [[character/1]] fait remarquer que le pilote semble mener la rébellion à lui seul.", false],
	],
	"chapter/39": [
		[39, "Synopsis", "La troisième étape commence. Le pilote se rend à [[station/16]], la seule station équipée pour fabriquer le [[goods/36]] dont le générateur Biotek a besoin. [[station/16]] se trouve plus profond que la plupart des stations, et le vaisseau peut avoir besoin d'un blindage plus résistant pour l'atteindre sans danger. Voir [[guide/depth]].", false],
		[40, "Dénouement", "Le pilote s'amarre à [[station/16]] et commence à déterminer ce qu'exige l'incubateur, en s'attendant à tout sauf à une tâche simple.", false],
	],
	"chapter/4": [
		[4, "Synopsis", "Un chapitre d'initiation au départ d'une station. Le pilote quitte [[station/0]] à la recherche de pirates, mais les eaux locales sont calmes ; M.A.I. propose donc de pousser jusqu'à une autre station.", false],
		[5, "Dénouement", "M.A.I. explique les S.T.R.E.A.M.S, le réseau de courants utilisé pour les longs trajets : un vaisseau quitte toujours un secteur par une sortie de courant et arrive dans le suivant par une entrée de courant, et le pilote auto peut se charger du voyage. Voir [[guide/navigation]].", false],
	],
	"chapter/40": [
		[40, "Synopsis", "À [[station/16]], le pilote doit produire un [[goods/36]] à l'usine de la station. L'incubateur est un produit avancé, et sa recette demande plusieurs ingrédients qu'il faudra peut-être d'abord pêcher, acheter ou fabriquer ailleurs. [[character/1]] s'attend à ce que ce soit compliqué, et le pilote aussi. Voir [[guide/trading]].", false],
		[41, "Dénouement", "L'incubateur est terminé. M.A.I. avoue avoir douté que le pilote y parvienne. Toujours incertain d'agir comme il le faut, le pilote met le cap sur [[station/14]].", false],
	],
	"chapter/41": [
		[41, "Synopsis", "Le pilote doit livrer le [[goods/36]] sans encombre à [[station/14]], où le professeur Abel attend pour achever le prototype du générateur. C'est la dernière pièce manquante du plan en trois étapes conçu par [[character/2]].", false],
		[42, "Dénouement", "[[character/5]] réceptionne l'incubateur. Le professeur Abel a tout préparé, et le canon [[equipment/42]] devrait bientôt être disponible au hangar. Ayumi veut tester le canon sans attendre contre des pirates, et Leah transmet les coordonnées en rappelant que le générateur n'est qu'un prototype. [[character/1]], censé être éteint, fait savoir qu'il a tout entendu.", false],
	],
	"chapter/42": [
		[42, "Synopsis", "Le [[equipment/42]] installé au hangar de [[station/14]], le pilote se dirige vers un repaire de pirates près de [[station/17]] pour l'essayer au combat. Le générateur n'étant qu'un prototype, l'essai vérifie aussi qu'il tient sous la charge. Les pirates appellent des renforts dès qu'ils voient à quoi ils ont affaire, et d'autres vaisseaux arrivent en plein combat.", false],
		[43, "Dénouement", "À la fin du combat, [[character/1]] capte un appel de détresse de [[station/14]], émis en clair sur un canal non chiffré. Le pilote fait aussitôt demi-tour.", false],
	],
	"chapter/43": [
		[43, "Synopsis", "Les forces colons lancent une attaque surprise contre [[station/14]]. De nombreux quais sont endommagés et les rebelles ne peuvent pas faire sortir assez de vaisseaux. [[character/9]] mène l'assaut et nargue le pilote, jusqu'à ce qu'il apprenne que le canon [[equipment/42]] est prêt à tirer. Le pilote doit défendre la station et ses vaisseaux alliés.", false],
		[44, "Dénouement", "Au cœur de la bataille, les Aquariens arrivent et se retournent contre les colons, combattant aux côtés des rebelles. Jack déserte quand l'attaque s'effondre. [[character/2]] qualifie ce sauvetage de miracle et demande au pilote de s'amarrer, en évoquant un invité spécial.", false],
	],
	"chapter/44": [
		[44, "Synopsis", "Le pilote s'amarre à [[station/14]] après la bataille.", false],
		[45, "Dénouement", "L'invité spécial est un délégué aquarien. Les Aquariens vont aider à mettre fin au règne des colons, pour que tous puissent vivre en harmonie avec la mer. [[character/2]] prévoit deux grandes offensives pour prendre les stations restantes. [[station/188]] étant désormais aux mains des rebelles, le plus de vaisseaux possible sont équipés du canon [[equipment/42]]. Le pilote mènera l'attaque contre [[station/18]], avec des unités fraîches et le soutien des Aquariens, tandis que [[character/5]] dirigera l'assaut contre [[station/109]].", false],
	],
	"chapter/45": [
		[45, "Synopsis", "À [[station/18]], le pilote retrouve [[character/12]], chef de l'escadron Atmos, dont les vaisseaux attendent l'ordre d'attaquer. Des Aquariens remontent des profondeurs pour se joindre à eux. Tous les vaisseaux colons doivent être détruits, cargos compris, avant que la station puisse être prise. Pendant ce temps, [[character/5]] mène un assaut parallèle contre [[station/109]].", false],
		[46, "Dénouement", "Les défenseurs colons et leurs cargos sont anéantis, et les forces rebelles et aquariennes réunies tiennent les eaux autour de la station. Le pilote envoie la moitié de l'escadron de Colin patrouiller autour de la station et emmène le reste s'amarrer.", false],
	],
	"chapter/46": [
		[46, "Synopsis", "Le pilote s'amarre à [[station/18]] avec une partie de l'escadron de [[character/12]] pour sécuriser la station conquise, tandis que le reste patrouille à l'extérieur.", false],
		[47, "Dénouement", "[[character/5]] annonce que son attaque contre [[station/109]] a elle aussi réussi, et les stations du sud sont désormais sous contrôle rebelle. Ayumi a confié au pilote ce qui pourrait être la dernière mission : [[station/0]], le dernier grand bastion des colons et la station où l'histoire du pilote a commencé. Elle est lourdement fortifiée, et [[character/2]] est déjà en route. Leah suit, mais des pirates lui barrent le passage.", false],
	],
	"chapter/47": [
		[47, "Synopsis", "À [[station/0]], le pilote rejoint [[character/2]] et [[character/5]] pour la bataille finale. Tous les vaisseaux défenseurs doivent être détruits avant que la station puisse être prise. [[character/9]] fait partie des défenseurs. Quand le pilote évoque le sort de [[character/3]], Jack tente de le déstabiliser avec une histoire extravagante : il serait le père du pilote, et Raymond son frère. Le pilote n'est pas dupe un seul instant.", false],
		[48, "Dénouement", "La flotte colon tombe jusqu'à ce qu'il ne reste plus que Jack. Il se montre rapide et dangereux, mais le pilote finit par neutraliser son vaisseau. Jack s'échappe vers le haut dans une capsule de sauvetage qui semble emporter toute la station avec elle, en méprisant la planète au moment de partir. La bataille est terminée.", false],
	],
	"chapter/48": [
		[48, "Synopsis", "La guerre est gagnée. La flotte colon est vaincue, [[character/9]] a fui la planète, et [[station/0]] ainsi que les derniers bastions rejoignent la cause rebelle. Toutes les stations sont désormais du côté du mouvement.", false],
		[48, "", "Les vainqueurs font le bilan. [[character/2]] remercie le pilote et [[character/5]] et admet qu'il faudra longtemps pour que les blessures de la planète guérissent, mais elle est convaincue qu'ils y parviendront aussi. Leah invite le pilote à fêter cela autour d'un [[goods/21]], et le pilote accepte. [[character/1]], à qui l'on promet une extension de mémoire dès que le pilote sera de retour sur la terre ferme, affirme n'en avoir aucun besoin et continue de taquiner le couple jusqu'au bout.", false],
		[48, "", "La campagne est terminée. Le pilote peut continuer à naviguer, commercer et accepter des contrats dans un monde désormais en paix sous les rebelles.", false],
	],
	"chapter/5": [
		[5, "Synopsis", "Le premier combat du pilote a lieu près de [[station/1]]. M.A.I. explique comment passer des armes au harpon, en quoi le tir automatique aide et comment lire le radar : les marques rouges sont hostiles, les vertes alliées et les jaunes indiquent des points de passage. Un [[faction/pirates|pirate]] isolé apparaît bientôt à l'écran. Voir [[guide/combat]].", false],
		[6, "Dénouement", "Le pirate est détruit. M.A.I. signale que les épaves laissent des caisses de cargaison, que le harpon peut récupérer avant qu'elles ne coulent hors de portée, puis met le cap sur [[station/0]].", false],
	],
	"chapter/6": [
		[6, "Synopsis", "Le pilote revient à [[station/0]] après son premier combat victorieux, avec une arme qui fonctionne et peut-être quelques marchandises récupérées à vendre. Le trajet est un court retour par le réseau de courants.", false],
		[7, "Dénouement", "[[character/9]] remarque la nouvelle arme et propose ce qu'il appelle du vrai travail. Des [[species/0|nautiles]] encombrent les routes des convois autour de [[station/1]], et la sécurité de la station veut s'en débarrasser. Le pilote objecte que ces créatures se nourrissent simplement des dépôts sur les coques des stations et que la cale est trop petite pour toutes les emporter. Jack balaie les deux objections : les animaux doivent disparaître, par n'importe quel moyen.", false],
	],
	"chapter/7": [
		[7, "Synopsis", "Près de [[station/1]], le pilote doit éliminer les [[species/0|nautiles]]. Les tuer ou les capturer compte de la même façon. Ni le pilote ni [[character/1]] ne sont à l'aise avec cette tâche, car ces créatures sont rares et inoffensives, mais ils acceptent de s'en acquitter.", false],
		[8, "Dénouement", "Le travail laisse le pilote ébranlé. Il est venu sur la planète pour pêcher, pas pour massacrer des animaux au profit de la colonie. M.A.I. espère qu'au moins la paie compensera et suggère de s'amarrer à [[station/1]] pour l'encaisser.", false],
	],
	"chapter/8": [
		[8, "Synopsis", "Le pilote s'amarre à [[station/1]] pour rendre compte de la chasse aux nautiles.", false],
		[9, "Dénouement", "Un fonctionnaire colon reçoit le pilote avec un mépris à peine voilé, traite la mission comme une simple dératisation et admet qu'elle est sans doute inutile, puisque les créatures reviennent sans cesse. La paie proposée est maigre et non négociable. Avant tout autre travail, le fonctionnaire exige une preuve de compétence : trois contrats remplis depuis les tableaux des stations. [[character/1]] explique comment trouver des contrats, prévient que certains lieux de mission se trouvent au-delà des limites de profondeur du vaisseau et montre comment planifier un itinéraire depuis la carte des stations.", false],
	],
	"chapter/9": [
		[9, "Synopsis", "Un chapitre consacré au travail indépendant. Le pilote doit remplir trois contrats pris sur le tableau de n'importe quelle station. Les contrats vont de l'escorte et du renflouage aux commandes de pêche, et il est utile de consulter plusieurs stations. Voir [[guide/contracts]].", false],
		[10, "Dénouement", "Satisfait, le fonctionnaire colon propose une mission spéciale. D'étranges êtres que les colons appellent Aquariens, mi-humains mi-poissons, attaquent les capsules de transport qui envoient les marchandises de la colonie en orbite pour y être collectées. Les capsules endommagées ou perdues nuisent à la réputation de la station auprès des autorités commerciales. Le prochain lancement a lieu à [[station/2]], où [[character/9]] dirigera l'opération ; le pilote doit repousser les Aquariens puis lui faire son rapport.", false],
	],
	"character/0": [
		[1, "", "Le pilote est le personnage joué : un nouveau venu sur un monde océanique colonisé, qui pilote un petit sous-marin et gagne sa vie comme pêcheur. Le joueur choisit son nom, et les courts résumés de chapitre du journal sont rédigés comme ses propres notes. Le pilote n'est jamais seul en mer, car l'ordinateur de bord, [[character/1]], commente presque chacun de ses gestes. L'histoire commence à [[station/0]], où le pilote vend sa pêche à la colonie.", false],
		[1, "Contexte", "On sait peu de choses de la vie du pilote avant la campagne. Venu sur la planète pour pêcher, le pilote regrette ce choix dès la toute première mission et rechigne à recevoir des ordres d'un ordinateur de bord. Tout le reste se devine à travers ses paroles et ses actes.", false],
		[7, "", "Le pilote connaît bien la mer et ses créatures. Quand la colonie se plaint des [[species/0|nautiles]] qui encombrent les routes des convois, le pilote fait remarquer que ces animaux broutent les algues et les autres organismes qui recouvrent les coques des stations : leur présence n'a donc rien de surprenant.", false],
		[12, "", "Au départ, les ambitions du pilote sont modestes : gagner assez pour un billet hors de la planète, un objectif que les prix fixes payés pour la pêche maintiennent hors d'atteinte. Plus tard, en demandant à rejoindre la résistance, le pilote déclare venir de [[station/0]].", false],
		[1, "Pêcheur pour la colonie", "L'histoire s'ouvre alors que le pilote remplit sa cale et met le cap sur [[station/0]] ([[chapter/1]], [[chapter/2]]).", false],
		[3, "", "Là, [[character/9]] paie la pêche au tarif fixe, raille la petite cale et suggère au pilote de plutôt chasser les [[faction/pirates|pirates]].", false],
		[6, "", "Le pilote installe un [[equipment/0]] et abat un premier pirate près de [[station/1]] ([[chapter/3]] à [[chapter/5]]).", false],
		[7, "", "[[character/9]] confie ensuite une tâche moins plaisante : débarrasser des [[species/0|nautiles]] les routes autour de [[station/1]] ([[chapter/7]]).", false],
		[8, "", "Cette battue écœure le pilote, venu pour pêcher et non pour massacrer des animaux inoffensifs.", false],
		[10, "", "Le fonctionnaire colonial de [[station/1]] paie peu, exige trois contrats comme preuve de fiabilité ([[chapter/9]]), puis envoie le pilote défendre des capsules de transport contre les [[world/aquarians|Aquariens]] à [[station/2]] ([[chapter/10]]).", false],
		[12, "", "Le pilote remporte le combat, mais commence à se demander pourquoi les [[world/aquarians|Aquariens]] attaquent. Quand [[character/9]] rend le pilote responsable des capsules endommagées et retient la récompense, [[character/1]] révèle avoir intercepté les communications d'un mouvement de résistance à [[station/3]], et le pilote décide de le trouver ([[chapter/12]]).", false],
		[12, "Rejoindre la résistance", "À [[station/3]], les gardes rebelles menacent d'ouvrir le feu, et le pilote doit bredouiller un nom et son désir de rejoindre le mouvement avant d'être autorisé à s'amarrer.", false],
		[13, "", "[[character/4]] accepte le pilote à l'essai, surtout parce que le mouvement a besoin de tous les bras disponibles, et l'envoie chercher un contact à [[station/4]] ([[chapter/13]]).", false],
		[14, "", "Ce contact est [[character/5]], et le pilote est visiblement sous le charme en la conduisant à [[station/5]] ([[chapter/14]]).", false],
		[16, "", "[[character/5]] montre au pilote comment les rebelles vivent de la mer ([[chapter/15]]), puis lui demande de reconnaître de nouvelles stations pour le mouvement ([[chapter/16]]). C'est la première fois que le pilote entend le mot « révolution ».", false],
		[18, "", "De retour à [[station/3]], [[character/4]] fait état des succès diplomatiques du mouvement et envoie le pilote trouver sa tête, presque sans indices ([[chapter/18]]).", false],
		[19, "Au service de la dirigeante", "La dirigeante est [[character/2]], qui reçoit le pilote à [[station/6]] ; le pilote s'attendait à un homme. Son premier ordre : protéger un banc de [[species/10|pieuvres]] contre des chasseurs colons ([[chapter/19]]).", false],
		[21, "", "Quand elle explique enfin les buts du mouvement, le pilote s'engage pour la cause. Elle l'envoie avec son as, [[character/3]], contre une bande de pirates ([[chapter/21]]).", false],
		[23, "", "[[character/3]] traite le pilote comme un gêneur. À [[station/9]], le pilote apprend que [[character/9]] est désormais un ennemi du mouvement et déblaie avec entrain le champ de mines qu'il a posé en travers d'une route de ravitaillement rebelle ([[chapter/23]]).", false],
		[25, "", "Après ses retrouvailles avec [[character/5]], le pilote est chargé d'escorter [[character/2]] et [[character/3]] jusqu'aux négociations de [[station/10]] ([[chapter/25]]).", false],
		[26, "", "Les forces de [[character/9]] les attendent. [[character/3]] s'enfuit en prétendant que ses armes sont en panne, et le pilote et [[character/5]] protègent seuls [[character/2]]. [[character/2]] se cache ensuite et demande au pilote de devenir un bien meilleur combattant ([[chapter/26]]).", false],
		[27, "Trahison et sauvetage", "Plus tard, [[character/3]] appelle en promettant des informations urgentes. Le pilote soupçonne un piège, mais accepte de le retrouver près de [[station/11]] ([[chapter/27]]).", false],
		[28, "", "C'est bien un piège : [[character/3]] retient [[character/2]] prisonnière et exige une reddition. Suivant le plan de [[character/1]], le pilote le fait parler pendant que l'ordinateur scanne son vaisseau, et lui lance que ce combat est une affaire de conviction, pas d'argent. Le pilote détruit ensuite son vaisseau et récupère sa soute blindée, avec [[character/2]] vivante à l'intérieur, avant qu'elle ne coule trop profond ([[chapter/28]]).", false],
		[31, "Le plan en trois étapes", "Après avoir protégé un convoi de scientifiques ([[chapter/29]]), le pilote découvre le plan de [[character/2]] : construire une arme avec [[world/abel]]. Avec [[character/4]] et [[character/5]], le pilote s'empare du [[world/biotek]] transporté par un convoi colon ([[chapter/31]]).", false],
		[33, "", "Il faut ensuite obtenir un canon [[equipment/42]] qui n'est pas à vendre, avec pour seule ressource une caisse destinée aux pots-de-vin. Le pilote relève le peu de préparation derrière cette mission, mais l'accepte de bon cœur ([[chapter/33]]).", false],
		[37, "", "À [[station/15]], le trafiquant du marché noir [[character/8]] accepte d'en trouver un si le pilote tue le chasseur de primes [[character/11]] ([[chapter/35]]). Le pilote s'exécute et achète un canon que [[character/8]] a obtenu auprès de [[character/9]] ([[chapter/37]]).", false],
		[39, "", "[[character/2]] préfère ne pas savoir comment le canon a été trouvé, et le pilote se contente de dire qu'aucun innocent n'est mort. Quand le pilote plaisante en disant que le plan pourrait servir à régner sur la planète, elle rejette fermement l'idée ([[chapter/39]]).", false],
		[42, "", "Le pilote produit ensuite le [[goods/36]] à [[station/16]] et l'apporte à [[station/14]], ce qui complète l'arme ([[chapter/41]]).", false],
		[43, "Le chemin de la victoire", "Alors qu'il essaie l'arme terminée contre des pirates près de [[station/17]], le pilote capte un appel de détresse de [[station/14]] et rentre pour trouver [[character/9]] à la tête d'une attaque surprise ([[chapter/43]]).", false],
		[44, "", "Avec l'aide des [[world/aquarians|Aquariens]], l'attaque est brisée et [[character/9]] s'enfuit.", false],
		[46, "", "[[character/2]] confie au pilote le commandement de l'assaut contre [[station/18]] ([[chapter/45]]). Le premier souci du pilote est [[character/5]], qui mène une seconde attaque, mais le pilote prend la station avec l'escadron de [[character/12]] et le soutien des [[world/aquarians|Aquariens]].", false],
		[47, "", "La bataille finale a lieu à [[station/0]], là où l'histoire a commencé ([[chapter/47]]). [[character/9]] tente de déstabiliser le pilote en prétendant être son père, et [[character/3]] son frère, mais le pilote balaie aussitôt le mensonge.", false],
		[48, "", "[[character/9]] est chassé et le dernier bastion de la colonie tombe. Le pilote attribue le mérite aux amis qui ont combattu à ses côtés et accepte l'invitation de [[character/5]] à fêter la victoire.", false],
		[1, "Personnalité", "Le pilote est pragmatique et a la langue bien pendue, plus enclin à répliquer qu'à obéir. Ses joutes verbales avec [[character/1]] parcourent toute la campagne.", false],
		[8, "", "Sous les plaisanteries se cache une conscience. Le pilote n'aime pas tuer des animaux pour le profit et se sent mal après la battue aux nautiles.", false],
		[14, "", "En présence de [[character/5]], le pilote perd ses moyens et devient maladroit, ce que remarquent aussi bien elle que [[character/1]].", false],
		[28, "", "Les motivations du pilote évoluent au fil de la campagne. Lors de la confrontation avec [[character/3]], le pilote soutient que la lutte est une affaire d'idéaux et que la cupidité l'a aveuglé.", false],
		[1, "Relations", "[[character/1]] est le compagnon le plus proche du pilote. Tous deux se chamaillent sans cesse, mais le pilote compte sur ses conseils et, plus tard, sur sa ruse.", false],
		[3, "", "[[character/9]] est le premier employeur du pilote et devient son rival durable.", false],
		[14, "", "Le pilote est attiré par [[character/5]] dès leur première rencontre, et le sentiment semble réciproque.", false],
		[19, "", "[[character/2]] en vient à confier au pilote les missions les plus délicates du mouvement. Elle le traite avec chaleur et une autorité taquine, presque parentale.", false],
		[1, "En tant que personnage joué", "En jeu, le pilote est ce que le joueur en fait. Entre deux objectifs de chapitre, le pilote est libre de pêcher, de commercer, d'accepter des contrats, de combattre et de rééquiper son vaisseau ; l'histoire n'avance que lorsqu'un objectif de chapitre est atteint. Les bases sont présentées dans [[guide/basics]].", false],
	],
	"character/1": [
		[1, "", "[[character/1]] est l'ordinateur de bord du sous-marin du pilote et son compagnon tout au long de la campagne. Il gère les systèmes du vaisseau, explique comment pêcher, voyager et combattre, et prodigue un flot continu de conseils et de commentaires. Son humour est pince-sans-rire et souvent aux dépens du pilote, mais il se révèle bien plus qu'un manuel qui parle.", false],
		[1, "En tant que compagnon", "Dans la pratique, [[character/1]] est le guide du jeu. Chaque nouvelle mécanique passe par lui : la pêche au harpon, le pilote auto et, dans les stations, les écrans d'aide. Il intervient à la radio pendant les missions, signale les cibles et avertit des menaces.", false],
		[5, "", "Il explique aussi les longs trajets par le réseau [[world/stream]] et la lecture du radar, où ennemis et alliés apparaissent comme des points de couleur et où les points de passage balisent l'itinéraire. Après un combat, il rappelle au pilote de récupérer le fret que laissent les vaisseaux vaincus.", false],
		[12, "", "Son rôle dépasse l'instruction. Il surveille les canaux radio, marque des stations sur la carte et transmet les messages.", false],
		[28, "", "Il sait aussi scanner d'autres vaisseaux à courte portée, une capacité qui s'avère décisive lors de la confrontation avec [[character/3]].", false],
		[1, "Rôle dans l'histoire", "La campagne s'ouvre sur [[character/1]] rappelant au pilote que son travail est de pêcher, pas de se plaindre.", false],
		[3, "", "Il ne cache pas sa piètre opinion de [[character/9]] et pousse le pilote à acheter le [[equipment/0]] proposé à la vente.", false],
		[4, "", "Une fois l'arme installée, il insiste pour l'essayer contre des pirates et mène leur recherche.", false],
		[7, "", "La battue aux [[species/0|nautiles]] lui déplaît, et il demande pourquoi ces animaux devraient mourir, alors qu'ils sont si peu nombreux.", false],
		[8, "", "Après la chasse, il remarque combien le pilote est ébranlé, et sa première pensée va, comme d'habitude, à savoir si le travail paie au moins.", false],
		[11, "", "Quand les [[world/aquarians|Aquariens]] attaquent les capsules à [[station/2]], il est le premier à suggérer que ces créatures sont peut-être bien plus intelligentes que ne le pensent les colons.", false],
		[12, "Le tournant", "C'est [[character/1]] qui lance l'histoire principale. Après que [[character/9]] a floué le pilote une fois de trop, il fait valoir que le pilote travaille dur pour une maigre récompense et n'a aucun droit de regard sur sa pêche. Il révèle avoir intercepté les signaux d'une résistance qui s'organise à [[station/3]], marque la station sur la carte et laisse la décision au pilote ([[chapter/12]]).", false],
		[12, "", "À l'arrivée, il suggère une approche discrète, idée qu'il abandonne aussitôt que les gardes rebelles interpellent le vaisseau.", false],
		[14, "Parmi les rebelles", "Il prend immédiatement en grippe la complicité entre le pilote et [[character/5]]. Quand le pilote le taquine sur sa jalousie, il répond en reprenant ironiquement l'expression favorite de [[character/5]]. Ses piques sur le duo se poursuivent jusqu'à la fin de la campagne.", false],
		[17, "", "Il relaie les messages du mouvement et résume en une seule phrase l'une des longues lettres de [[character/4]].", false],
		[18, "", "Il doute que les rebelles soient bien organisés quand le pilote est envoyé trouver leur tête presque sans indices.", false],
		[19, "", "Face à [[character/2]], il montre son côté intéressé en demandant pourquoi le pilote travaille sans discuter de la paie. Quand le pilote défend [[character/2]], il fait remarquer avec insistance que lui, au moins, n'a jamais besoin de manger.", false],
		[22, "", "Il admire le talent de [[character/3]], mais conseille au pilote de se tenir à l'écart de son caractère emporté.", false],
		[27, "L'otage", "Quand [[character/3]] appelle pour proposer un rendez-vous, [[character/1]] déclare qu'il s'agit d'un piège.", false],
		[28, "", "Lors de la rencontre, il montre sa vraie valeur. Il demande au pilote de faire parler [[character/3]], sachant qu'un homme qui se croit en sécurité se vantera de ses motifs. Pendant ce temps, il scanne son vaisseau, découvre qu'il n'a qu'une place et en conclut que [[character/2]] doit se trouver dans la soute blindée. Cette déduction permet au pilote de détruire le vaisseau tout en sauvant [[character/2]] ([[chapter/27]]).", false],
		[33, "La guerre", "Pendant les missions du [[world/biotek]] et de l'[[world/eclipse|Eclipse]], il continue de se plaindre de la maigre paie.", false],
		[37, "", "Il savoure l'ironie quand le canon se révèle provenir de [[character/9]], dont la cupidité a armé ses propres ennemis.", false],
		[39, "", "Il grommelle que le pilote semble mener la rébellion à lui seul.", false],
		[41, "", "Plus tard, il retourne contre le pilote la réponse que celui-ci avait faite à cette plainte.", false],
		[42, "", "Quand [[character/5]] accueille chaleureusement le pilote à [[station/14]], il annonce qu'il s'éteint, mais il s'avère qu'il était seulement en veille.", false],
		[43, "", "Pendant l'essai du canon, il capte un appel de détresse de [[station/14]], émis en clair et sans chiffrement, et comprend aussitôt que quelque chose va très mal.", false],
		[44, "", "Dans la bataille qui suit, il est le premier à signaler que les [[world/aquarians|Aquariens]] sont arrivés pour combattre aux côtés des rebelles.", false],
		[48, "", "À la fin de la guerre, le pilote lui promet une extension de mémoire, une offre qu'il trouve vaguement insultante. Son dernier mot sur la campagne est un nouveau commentaire pince-sans-rire sur le pilote et [[character/5]].", false],
		[1, "Personnalité", "[[character/1]] est malin, franc et impatient avec les gens pompeux. Il aime signaler les mauvaises affaires et manque rarement une occasion de taquiner.", false],
		[8, "", "Il est aussi plus attentionné qu'il ne l'admet. Il désapprouve les tueries inutiles et garde un œil sur l'état d'esprit du pilote.", false],
		[28, "", "Son calme sous la pression sauve la situation quand le pilote ne sait plus quoi faire.", false],
		[1, "Relations", "Le pilote et lui se disputent sans cesse, mais se font entièrement confiance.", false],
		[3, "", "Il déteste [[character/9]] au premier coup d'œil.", false],
		[14, "", "Sa jalousie envers [[character/5]] est une plaisanterie récurrente.", false],
		[19, "", "Il respecte [[character/2]], mais se plaint du peu qu'elle paie.", false],
		[22, "", "Il juge vite [[character/3]], et l'avenir lui donne raison.", false],
	],
	"character/10": [
		[5, "", "[[character/10]] est le nom donné aux pilotes hors-la-loi des [[faction/pirates]] qui prennent la parole pendant les missions. Ils s'attaquent au trafic maritime dans tout l'océan et sont les premières cibles du pilote dès que son vaisseau porte une arme.", false],
		[6, "Qui parle", "Un pirate est le premier ennemi qu'affronte le pilote, près de [[station/1]], et il sombre dans un cri de rage ([[chapter/5]]).", false],
		[21, "", "À mesure que le conflit entre colons et rebelles s'intensifie, les pirates profitent du chaos pour chasser des proies faciles, et [[character/2]] décide que les rebelles doivent riposter ([[chapter/21]]).", false],
		[43, "", "Près de [[station/17]], une bande de pirates devient la première cible de l'[[world/eclipse|Eclipse]]. L'un d'eux panique devant la puissance de feu du pilote et appelle à l'aide, entraînant d'autres pirates dans le combat ([[chapter/42]]). Le combat contre eux est décrit dans [[guide/combat]].", false],
	],
	"character/11": [
		[35, "", "[[character/11]] est un chasseur de primes engagé par l'administration de la sécurité de [[station/15]] pour se débarrasser du trafiquant du marché noir [[character/8]]. [[character/8]] exige sa mort comme prix d'un [[world/eclipse|Eclipse]].", false],
		[35, "Contexte", "Selon [[character/8]], [[character/11]] patrouille dans les eaux proches de [[station/15]]. C'est en quelque sorte un représentant de la loi, au service des autorités de la station, et sa cible est un criminel. La tâche du pilote pose donc un problème moral : pour obtenir l'arme dont les rebelles ont besoin, le pilote doit tuer un homme pour le compte d'un trafiquant.", false],
		[36, "Rôle dans l'histoire", "Quand le pilote le trouve, [[character/11]] n'est pas seul : il voyage avec plusieurs vaisseaux d'escorte. Il ordonne au pilote de dégager, le traite de pêcheur et insiste sur le fait qu'il a un travail à faire. Quand le combat tourne en sa défaveur, il demande si l'on ne pourrait pas finalement régler cela à l'amiable. Son vaisseau est détruit ([[chapter/35]]).", false],
		[37, "", "Sa mort vaut au pilote l'aide de [[character/8]], et le trafiquant propose bientôt le canon à la vente.", false],
		[39, "", "Plus tard, le pilote dit seulement à [[character/2]] qu'aucun innocent n'est mort pour obtenir le canon.", false],
		[36, "Personnalité", "[[character/11]] est sûr de lui et dédaigneux jusqu'à ce qu'il perde, puis prompt à chercher une échappatoire. Il voit dans le pilote un obstacle mineur, un simple pêcheur égaré sur son chemin, et le sous-estime gravement.", false],
	],
	"character/12": [
		[45, "", "[[character/12]] est le chef de l'escadron Atmos, une unité [[faction/rebels|rebelle]] qui se joint à l'assaut du pilote contre [[station/18]] lors des offensives finales.", false],
		[45, "Rôle dans l'histoire", "[[character/2]] promet de rassembler des unités pour le pilote pendant que celui-ci se rend à [[station/18]]. L'escadron de [[character/12]] en fait partie. À l'arrivée du pilote, il annonce que ses vaisseaux sont en position et attendent l'ordre d'attaquer. Au même moment, un groupe d'[[world/aquarians|Aquariens]] surgit des profondeurs, et la bataille commence sur l'ordre du pilote ([[chapter/45]]).", false],
		[46, "", "Ensemble, ils détruisent tous les vaisseaux colons, sans épargner même les cargos.", false],
		[46, "", "Après la bataille, le pilote ordonne à [[character/12]] d'envoyer la moitié de ses vaisseaux patrouiller autour de la station pendant que le reste s'amarre avec le pilote pour en prendre le contrôle. Il obéit sans discuter.", false],
		[47, "", "C'est la première bataille où vaisseaux rebelles et [[world/aquarians|Aquariens]] combattent côte à côte sous le commandement du pilote, et son succès ouvre la voie à l'assaut final contre la colonie.", false],
		[45, "Personnalité", "[[character/12]] parle peu et exécute les ordres sans tarder. C'est le premier officier rebelle à servir sous le commandement du pilote, signe du chemin parcouru depuis l'époque où le pilote pêchait pour la colonie. Son ton radio sec et efficace tranche avec les badinages des autres compagnons du pilote.", false],
	],
	"character/2": [
		[18, "", "[[character/2]] est un membre de la [[faction/rebels|résistance]] que le pilote rencontre à [[station/6]].", false],
		[19, "", "Elle dirige le mouvement : une femme d'âge mûr qui prend en main les missions du pilote dès leur première rencontre. Calme, chaleureuse et déterminée, elle conduit la lutte du mouvement contre le pouvoir colonial.", false],
		[21, "Contexte", "Le mouvement que dirige [[character/2]] se voit comme une union de personnes opposées à la ruine de la planète. Selon elle, la rapidité de la colonisation et l'exploitation impitoyable de la mer ne laissent pas à ses plantes et à ses animaux le temps de se rétablir, et d'autres mondes ont déjà été épuisés de la même manière. Sa stratégie consiste à rallier ceux qui dirigent les stations plutôt qu'à les combattre.", false],
		[23, "", "Elle connaît [[character/9]] depuis longtemps. Ce n'était personne quand elle l'a rencontré, et elle estime qu'il doit son ascension à de bonnes relations plutôt qu'à un quelconque talent.", false],
		[31, "", "Elle dispose d'un réseau d'informateurs dans les stations et de l'autorité nécessaire pour déplacer scientifiques, argent et vaisseaux à travers la zone rebelle.", false],
		[19, "Rôle dans l'histoire", "Le premier ordre de [[character/2]] est une mission d'escorte : le pilote doit protéger un banc de [[species/10|pieuvres]] contre des chasseurs colons ([[chapter/19]]). Elle ne dit rien de la paie et peu de chose des projets du mouvement, mettant apparemment à l'épreuve la fiabilité du nouveau venu. Le pilote avoue s'être attendu à un homme, ce qu'elle laisse passer.", false],
		[20, "", "Elle récompense modestement la mission et rappelle aussitôt le pilote pour de nouvelles tâches.", false],
		[21, "", "Quand le pilote réclame des réponses, elle explique les buts du mouvement. Elle décide aussi qu'il faut donner une leçon aux pirates qui profitent du conflit, et envoie le pilote avec son meilleur combattant, [[character/3]], contre une bande près de [[station/8]] ([[chapter/21]]).", false],
		[22, "", "Elle partage la récompense à parts égales entre les deux pilotes, au grand dam de [[character/3]], puis part négocier à [[station/9]].", false],
		[23, "", "Là, elle envoie le pilote déminer le champ posé par [[character/9]] en travers de la route de ravitaillement vers [[station/37]], en le prévenant des pirates et des mines qui ne peuvent être détruites qu'une fois déclenchées ([[chapter/23]]).", false],
		[25, "L'embuscade", "L'objectif suivant de [[character/2]] est [[station/10]], où de nouvelles négociations devraient rallier d'autres stations aux rebelles. Elle prend pour escorte [[character/3]], [[character/5]] et le pilote, et balaie les doutes du pilote sur [[character/3]] en le qualifiant de têtu mais excellent pilote ([[chapter/25]]).", false],
		[25, "", "À leur arrivée, [[character/9]] les attend avec ses forces. [[character/2]] est sidérée que leurs plans aient été connus à l'avance.", false],
		[26, "", "[[character/3]] fuit le combat, et seuls le pilote et [[character/5]] s'interposent entre [[character/2]] et les colons. Ensuite, elle évoque à voix haute un sabotage, mais refuse de croire [[character/5]] quand celle-ci accuse [[character/3]] de trahison. Elle se cache, confie à [[character/5]] la responsabilité de [[station/9]] et prévient le pilote que la diplomatie seule ne gagnera peut-être pas la guerre ([[chapter/26]]).", false],
		[28, "Captivité", "Sa confiance en [[character/3]] se révèle mal placée. Il la capture pour la livrer à [[character/9]]. Lors de la confrontation près de [[station/11]], elle presse le pilote de ne pas se soucier de sa sécurité. Le pilote la délivre de la soute du vaisseau détruit de [[character/3]], et elle atteint [[station/12]] secouée mais indemne ([[chapter/28]]).", false],
		[29, "", "Même alors, elle pense d'abord au mouvement. Avant sa capture, elle avait organisé le transfert d'un groupe de scientifiques vers [[station/14]], et elle envoie aussitôt le pilote protéger leur convoi, craignant que [[character/3]] l'ait trahi lui aussi ([[chapter/29]]).", false],
		[31, "Le plan en trois étapes", "À [[station/14]], [[character/2]] dévoile son plan. Les rebelles subissent de plus en plus d'affrontements avec une flotte coloniale qui les surpasse toujours en nombre ; elle a donc fait venir [[world/abel]] et son équipe pour construire une arme. Le travail compte trois étapes, la première étant une source d'énergie, le [[world/biotek]], que les colons ont volé au professeur. Elle part le rejoindre pendant que [[character/5]] organise le raid ([[chapter/31]]).", false],
		[33, "", "Pour la deuxième étape, elle veut un [[world/eclipse|Eclipse]], un canon normalement destiné à la défense des stations. Le fabricant le plus proche, [[station/188]], est aux mains des colons et l'arme n'est pas à vendre ; elle remet donc au pilote une grosse somme pour les pots-de-vin et reconnaît que son plan ne va pas plus loin ([[chapter/33]]).", false],
		[39, "", "Quand le canon arrive, elle préfère ne pas savoir comment il a été obtenu et espère qu'aucun sang n'a coulé. Elle est piquée au vif quand le pilote plaisante en disant que le plan pourrait servir à régner sur la planète. Pour la dernière étape, elle transmet l'explication du professeur sur l'incubateur, en admettant franchement ne pas la comprendre, et envoie le pilote à [[station/16]] ([[chapter/39]]).", false],
		[43, "Offensives finales", "Quand les colons lancent une attaque surprise contre [[station/14]], [[character/2]] croit d'abord que tout est perdu ([[chapter/43]]).", false],
		[44, "", "Elle survit, et attribue au pilote et aux [[world/aquarians|Aquariens]] le salut de la station.", false],
		[45, "", "Elle accueille un émissaire [[world/aquarians|aquarien]], venu annoncer que son peuple aidera à combattre la colonie. [[station/188]] étant désormais aux mains des rebelles, elle prévoit d'équiper du [[equipment/42]] autant de vaisseaux que possible et lance deux offensives à la fois : le pilote doit prendre [[station/18]], tandis que [[character/5]] attaque [[station/109]] ([[chapter/45]]). Elle taquine le pilote, inquiet pour [[character/5]].", false],
		[47, "", "Pour l'assaut final contre [[station/0]], elle part elle-même au combat ([[chapter/47]]).", false],
		[48, "", "Après la victoire, elle remercie le pilote et [[character/5]], et admet que la planète aura besoin de beaucoup de temps pour guérir.", false],
		[19, "Personnalité", "[[character/2]] est chaleureuse et calme, et elle s'adresse à ses jeunes agents comme à ses propres enfants. Elle exige beaucoup et paie peu.", false],
		[26, "", "Elle est loyale envers les siens jusqu'à l'excès. Elle défend [[character/3]] bien après que les autres ont commencé à se méfier.", false],
		[28, "", "[[character/3]] la traite de rêveuse trop vieille pour ce rôle, un jugement que la suite de l'histoire dément.", false],
		[33, "", "Ses plans sont parfois plus audacieux que détaillés, et comptent sur l'improvisation de ses agents. Elle préfère la diplomatie et espère éviter les effusions de sang, mais accepte que le mouvement doive se battre.", false],
		[19, "Relations", "Elle en vient à faire confiance au pilote plus qu'à presque quiconque, et le pilote lui rend cette confiance.", false],
		[21, "", "Elle considère [[character/3]] comme son meilleur pilote.", false],
		[23, "", "Elle n'a que du mépris pour [[character/9]].", false],
		[25, "", "Elle traite [[character/5]] comme une lieutenante de confiance et lui confie les commandes en son absence.", false],
		[31, "", "[[character/4]] travaille sous ses ordres comme expert technique, et [[world/abel]] construit son arme.", false],
	],
	"character/3": [
		[21, "", "[[character/3]] est l'un des meilleurs pilotes de [[character/2]], un combattant doué et arrogant qu'elle associe au pilote pour un raid contre une bande de pirates près de [[station/8]].", false],
		[21, "Personnalité", "[[character/3]] est impatient et vantard. Il reproche au pilote son retard, prétend qu'il aurait pu finir le travail seul et ordonne au pilote de rester derrière lui pour apprendre. [[character/1]] est impressionné par sa réputation, sinon par ses manières.", false],
		[22, "", "Il n'a aucun respect pour les nouveaux venus et se moque du pilote en le traitant de fils de pêcheur.", false],
		[28, "", "Au fond, c'est un mercenaire. Il mesure la loyauté en argent et n'a aucune patience pour les idéaux qui animent le mouvement.", false],
		[21, "Rôle dans l'histoire", "[[character/2]] présente [[character/3]] comme l'un de ses meilleurs pilotes et envoie le pilote avec lui contre des pirates ([[chapter/21]]). Il attend déjà sur place, agacé par le retard.", false],
		[22, "", "[[character/3]] est un pilote compétent, et après la bataille il adresse au pilote un compliment réticent enrobé d'une insulte. Quand [[character/2]] partage la récompense à parts égales, il est furieux, affirme que le pilote n'a guère contribué et se plaint qu'elle gaspille l'argent pour des débutants.", false],
		[25, "", "[[character/2]] le choisit pour son escorte vers [[station/10]]. Le pilote n'est pas ravi, mais elle se porte garante de lui : têtu, mais compétent ([[chapter/25]]).", false],
		[26, "L'embuscade", "Quand les forces de [[character/9]] tendent leur embuscade à [[station/10]], [[character/3]] ne tire pas un seul coup. Il prétend que ses armes sont en panne, s'excuse et s'enfuit. [[character/5]] est convaincue qu'il les a trahis, tandis que [[character/2]] s'interroge sur un sabotage mais continue de le défendre.", false],
		[27, "Trahison", "Quelque temps plus tard, il appelle le pilote, demande avec inquiétude des nouvelles de [[character/2]] et de [[character/5]] et affirme avoir des nouvelles importantes. Il propose un rendez-vous près de [[station/11]]. [[character/1]] est sûr que c'est un piège ([[chapter/27]]).", false],
		[28, "", "C'en est un. [[character/3]] a capturé [[character/2]] et menace de la tuer si le pilote ne se rend pas. Il expose ses raisons sans se faire prier : il voit en [[character/2]] une rêveuse, trop vieille pour diriger, et [[character/9]] a mis une grosse prime sur sa tête comme sur celle du pilote. Il admet ignorer pourquoi [[character/9]] craint le pilote, et s'en moque. [[character/2]] payait mal, dit-il, alors il a changé d'employeur, et il balaie les discours du pilote sur les idéaux.", false],
		[28, "", "Pendant qu'il parle, [[character/1]] scanne son vaisseau monoplace et déduit où [[character/2]] doit se trouver. Le pilote passe alors à l'attaque. [[character/3]] reste rapide et sûr de lui jusqu'au bout, mais son vaisseau est détruit. Le pilote récupère la soute blindée avec [[character/2]] vivante à l'intérieur, et [[character/3]] sombre avec son vaisseau près de [[station/11]].", false],
		[28, "", "Avec le recul, la panne de ses armes à [[station/10]] semble mise en scène. Rien dans l'histoire ne laisse penser que ses excuses étaient sincères.", false],
		[29, "", "Sa trahison projette une ombre durable. [[character/2]] craint qu'il ait divulgué des informations sur son convoi de scientifiques avant de mourir ([[chapter/29]]).", false],
		[47, "", "Lors de la bataille finale, [[character/9]] emploie une menace que le pilote reconnaît comme les dernières paroles de [[character/3]]. En apprenant que le pilote l'a tué, [[character/9]] prétend que [[character/3]] était le frère du pilote. Le mensonge fait long feu.", false],
		[21, "Relations", "[[character/2]] lui fait entièrement confiance et place son talent au-dessus de celui de ses autres pilotes.", false],
		[22, "", "Il traite le pilote avec mépris dès le début.", false],
		[26, "", "[[character/5]] se méfie de lui et est la première à le traiter de traître.", false],
		[28, "", "Il finit par se vendre à [[character/9]], l'homme que combattent ses camarades.", false],
	],
	"character/4": [
		[12, "", "[[character/4]] est un membre de la [[faction/rebels|résistance]] basé à [[station/3]].", false],
		[13, "", "C'est le premier rebelle que le pilote rencontre en personne. Il examine les nouvelles recrues et leur confie leurs premières missions.", false],
		[13, "L'examen du pilote", "Quand le pilote arrive à [[station/3]], [[character/4]] commence par une série de questions alambiquées sur ce que sait le nouveau venu et comment il l'a appris. Le pilote avoue ne rien savoir de plus que la rumeur d'une résistance favorable au libre-échange. [[character/4]] est sceptique, mais il note que le mouvement n'a commencé à chiffrer ses communications radio que deux jours plus tôt, ce qui rend l'histoire plausible ([[chapter/12]]).", false],
		[13, "", "Pressé par le temps et à court de monde, [[character/4]] accepte le pilote à l'essai. Il explique que les rebelles comptent infiltrer les stations colons et rallier leurs dirigeants, car l'exploitation de la planète doit cesser. Il refuse d'en dire plus à un inconnu et confie au pilote une première tâche : conduire des sympathisants de [[station/4]] à [[station/5]] ([[chapter/13]]).", false],
		[17, "La révolution se propage", "Plus tard, [[character/4]] rappelle le pilote à [[station/3]] par un message si long que [[character/1]] n'en lit à voix haute que l'essentiel ([[chapter/17]]).", false],
		[18, "", "En personne, il annonce que la diplomatie a rallié de nombreuses stations aux rebelles, si bien que le pilote peut désormais commercer sur une zone plus vaste. La presse parle déjà de révolution, et [[character/4]] reprend le mot à son compte. Jusqu'ici, aucun sang n'a coulé, mais il s'attend à ce que cela change. Il indique au pilote que la tête du mouvement se trouve dans l'une des stations nouvellement gagnées et prendra contact, et prévient que certaines stations ne sont accessibles qu'avec un meilleur blindage ou de meilleurs boucliers ; voir [[guide/depth]] ([[chapter/18]]).", false],
		[31, "Le raid sur le convoi", "[[character/4]] se trouve à [[station/14]] quand le pilote arrive après avoir escorté les scientifiques. Il a préparé un discours de remerciement, mais n'a jamais l'occasion de le prononcer, et plus tard il est de nouveau coupé en pleine phrase quand le pilote se précipite vers les vaisseaux. Il combat aux côtés du pilote et de [[character/5]] contre le convoi colon qui transporte le [[world/biotek]] ([[chapter/31]]).", false],
		[32, "", "Quand les équipages du convoi protestent qu'ils ne transportent que des vivres et des médicaments, [[character/4]] répond à la radio que c'est exactement ce dont les rebelles ont besoin. [[character/5]] fait remarquer qu'il sait être un sacré plaisantin.", false],
		[33, "", "Ensuite, [[character/2]] lui confie la direction du hangar, où le travail ne manque pas. Elle le désigne aussi comme l'interlocuteur pour les questions techniques liées au montage d'un [[world/eclipse|Eclipse]] sur un vaisseau ([[chapter/33]]).", false],
		[13, "Personnalité", "[[character/4]] est prudent, formel et secret. Il donne ses ordres avant ses explications et ne partage les projets du mouvement qu'avec ceux qui l'ont mérité.", false],
		[18, "", "Il est aussi prolixe, un trait dont [[character/1]] se moque chaque fois qu'il prend la parole.", false],
		[32, "", "Derrière ses manières raides se cachent un humour pince-sans-rire et une vision réaliste de la guerre à venir.", false],
		[13, "Relations", "[[character/4]] est le premier contact du pilote au sein du mouvement. Sa confiance grandit à mesure que le pilote fait ses preuves.", false],
		[19, "", "Il travaille sous les ordres de [[character/2]], dont il relaie les instructions.", false],
		[32, "", "Il combat aux côtés de [[character/5]], qui le taquine sur ses plaisanteries.", false],
	],
	"character/5": [
		[13, "", "[[character/5]] est un membre de la [[faction/rebels|résistance]] que le pilote est envoyé chercher à [[station/4]].", false],
		[14, "", "Enjouée, chaleureuse et souriante, elle devient l'une des plus proches alliées du pilote. Le pilote est sous son charme dès le premier instant, au grand agacement de [[character/1]].", false],
		[14, "Première rencontre", "[[character/5]] accueille chaleureusement le pilote à [[station/4]] et est pressée de partir. Quand le pilote l'interroge sur le mouvement, elle explique que les recrues sont tenues dans l'ignorance, pour leur propre sécurité comme pour celle du mouvement. Elle transmet sa destination à l'ordinateur de bord et insiste pour que le trajet soit rapide ([[chapter/13]]).", false],
		[15, "", "À [[station/5]], elle se met à l'abri pour régler quelques affaires. Avant de partir, elle explique ce qui distingue les rebelles des colons : ils vivent de ce que la mer offre au lieu de la dépouiller, transforment leurs prises en marchandises et veillent à ne pas surpêcher. Elle demande au pilote d'essayer ce mode de vie en produisant cinq tonnes de marchandises, et suggère [[station/90]], où calmars et [[goods/35]] peuvent être transformés en [[goods/22]] ([[chapter/14]]).", false],
		[16, "", "Une fois les marchandises produites, elle rappelle avec une nouvelle tâche. Le mouvement a besoin d'informations récentes sur chaque station pour repérer les points faibles de la colonie, car, comme elle le dit, les armes seules ne suffiront pas. Quand on lui demande si les rebelles préparent une révolution, elle refuse d'en dire plus ([[chapter/15]]).", false],
		[25, "Retrouvailles et embuscade", "Le pilote retrouve [[character/5]] à [[station/9]], où tous deux échangent des compliments maladroits. [[character/2]] écourte les retrouvailles et les charge de l'escorter avec [[character/3]] jusqu'à [[station/10]] ([[chapter/24]]).", false],
		[25, "", "[[character/5]] est la première à sentir que quelque chose cloche à leur arrivée.", false],
		[26, "", "Pendant l'embuscade, elle voit que [[character/3]] ne se bat pas et l'interpelle alors qu'il s'enfuit. Ensuite, elle l'accuse ouvertement de trahison et cherche le soutien du pilote. [[character/2]] lui confie la responsabilité de [[station/9]] pendant son absence ([[chapter/25]]).", false],
		[31, "Le plan en trois étapes", "À [[station/14]], [[character/5]] connaît déjà l'histoire du sauvetage de [[character/2]]. Elle informe le pilote de la première étape du plan : selon un informateur, le [[world/biotek]] est acheminé vers Maarth, caché parmi du fret ordinaire. Comme personne ne sait quel vaisseau le transporte, elle ordonne d'attaquer tout le convoi près de [[station/2]] ([[chapter/30]]).", false],
		[32, "", "Elle mène l'interception et veille à ce que chaque conteneur soit récupéré ([[chapter/31]]).", false],
		[33, "", "[[character/2]] la charge ensuite de patrouiller autour de [[station/14]] contre les attaques surprises.", false],
		[42, "", "Quand le pilote revient avec le [[goods/36]], [[character/5]] est aux anges. Elle annonce que [[world/abel]] a tout préparé, transmet l'ordre de [[character/2]] de tester le canon contre des pirates et rappelle au pilote que le générateur n'est qu'un prototype ([[chapter/41]]).", false],
		[45, "Les offensives", "Lors des offensives finales, [[character/5]] mène l'assaut contre [[station/109]] pendant que le pilote attaque [[station/18]]. [[character/2]] rassure le pilote : c'est une pilote chevronnée qui sait ce qu'elle fait ([[chapter/44]]).", false],
		[47, "", "Son attaque réussit. Elle appelle le pilote pour lui annoncer la nouvelle et lui transmettre les ordres de [[character/2]] pour une dernière bataille à [[station/0]], puis s'y rend elle-même en se frayant un chemin à travers les pirates ([[chapter/46]]).", false],
		[48, "", "À [[station/0]], elle combat aux côtés de [[character/2]] et du pilote. Après la victoire, elle invite le pilote à fêter cela autour d'un [[goods/21]], et le pilote accepte ([[chapter/47]]).", false],
		[14, "Personnalité", "[[character/5]] est aimable et optimiste, et affectionne une courte formule d'approbation qu'elle place à tout bout de champ. Elle est aussi discrète et engagée, avec une idée claire de ce que défend le mouvement.", false],
		[15, "", "Elle croit qu'on peut vivre de la mer sans lui nuire, et sait expliquer simplement cette idée.", false],
		[26, "", "Elle juge vite les gens, et dans le cas de [[character/3]], elle voit juste.", false],
		[14, "Relations", "Le pilote est attiré par elle dès le début, et au fil de la campagne le sentiment devient clairement réciproque. [[character/1]] ne cesse d'en grommeler.", false],
		[25, "", "[[character/2]] lui confie des commandements et les traite, elle et le pilote, avec un amusement affectueux.", false],
		[26, "", "Elle ne fait jamais confiance à [[character/3]].", false],
		[32, "", "Elle travaille en étroite collaboration avec [[character/4]] et s'amuse de son humour.", false],
	],
	"character/6": [
		[8, "", "[[character/6]] est le nom donné aux nombreux interlocuteurs secondaires du camp des [[faction/colonists]] : fonctionnaires, administrateurs et équipages de transport de l'[[world/colony|administration]] coloniale. Aucun d'eux n'est nommé ; ensemble, ils montrent comment la colonie traite les étrangers qui travaillent pour elle.", false],
		[9, "Qui parle", "Le premier est le fonctionnaire de [[station/1]] qui reçoit le pilote après la battue aux [[species/0|nautiles]] ([[chapter/8]]). Il préfère les euphémismes pour parler de sale besogne, verse une petite somme fixe et refuse de marchander. Le pilote doit remplir trois contrats avant qu'on lui propose un meilleur travail.", false],
		[10, "", "La même voix confie ensuite la défense des capsules à [[station/2]]. La colonie lance ses exportations en orbite dans des capsules, et les [[world/aquarians|Aquariens]] ne cessent de les attaquer, ce qui inquiète l'administration commerciale ([[chapter/9]]).", false],
		[32, "", "Bien plus tard, les équipages d'un convoi colon près de [[station/2]] supplient les rebelles de cesser le feu, affirmant ne transporter que des vivres et des médicaments ([[chapter/31]]).", false],
	],
	"character/7": [
		[12, "", "[[character/7]] est le nom donné aux membres anonymes des [[faction/rebels]] qui s'adressent au pilote : contrôleurs du trafic des stations, gardes et équipages de convoi. Leurs voix marquent le premier contact du pilote avec le mouvement et son quotidien.", false],
		[12, "Qui parle", "Le premier rebelle que le pilote entend est un garde de [[station/3]], qui l'avertit que le vaisseau est entré dans des eaux neutres et menace d'ouvrir le feu s'il ne s'identifie pas. Après un long silence, le pilote est autorisé à s'amarrer ([[chapter/12]]).", false],
		[17, "", "Quand le pilote revient en membre reconnu, la station l'accueille par son nom et lui attribue un quai ([[chapter/17]]).", false],
		[29, "", "Plus tard, l'équipage du convoi des scientifiques appelle désespérément à l'aide près de [[station/13]] ([[chapter/29]]).", false],
		[30, "", "Ils remercient ensuite le pilote, affirmant qu'ils n'auraient pas survécu seuls.", false],
	],
	"character/8": [
		[34, "", "[[character/8]] est un marchand que le pilote rencontre à [[station/15]] en cherchant un moyen d'obtenir un [[world/eclipse|Eclipse]].", false],
		[35, "", "C'est un trafiquant du marché noir qui parle toujours de lui-même à la troisième personne et prétend pouvoir fournir presque n'importe quoi à un client qui a de l'argent.", false],
		[35, "Contexte", "[[character/8]] fait des affaires à [[station/15]], où le commerce de drogues est interdit. Ses activités ont fait de lui une cible : l'administration de la sécurité de la station a engagé le chasseur de primes [[character/11]] pour se débarrasser de lui. Il a des contacts un peu partout et est prêt à verser des pots-de-vin pour obtenir ce que veut un client.", false],
		[35, "L'affaire du canon", "Pendant que le pilote parcourt le marché local, apparemment pour acheter des [[goods/37]], [[character/8]] le prend à part et le prévient que ce commerce est illégal ici. Quand il propose ses services et que le pilote demande un [[equipment/42]], il est stupéfait et demande si le pilote compte déclencher une guerre. Le pilote prétend que c'est pour un usage privé. [[character/8]] accepte d'en chercher un, à une condition : le pilote doit trouver et tuer [[character/11]], qui patrouille près de la station ([[chapter/34]]).", false],
		[37, "", "Après la mort de [[character/11]], [[character/8]] félicite le pilote et tient parole. Grâce à ses contacts et à force de pots-de-vin, il a trouvé un [[equipment/42]], qu'il propose à un prix exorbitant qu'il qualifie pourtant d'affaire. Il révèle que le vendeur était un certain Dawn, et que les noms lui importent peu tant que la marchandise est bonne ([[chapter/36]]).", false],
		[37, "", "Le vendeur est [[character/9]]. [[character/1]] souligne l'ironie : la cupidité de [[character/9]] a mis l'arme la plus importante des rebelles entre les mains de ses ennemis. Le pilote achète le canon et le rapporte à [[station/14]] ([[chapter/37]]).", false],
		[35, "Personnalité", "[[character/8]] est rusé, prudent et sans scrupules. Il vend des marchandises illégales et réclame la mort d'un homme aussi naturellement qu'un paiement. Il se méfie des oreilles indiscrètes : il prend le pilote à part et le fait taire avant toute discussion d'affaires. Même face à un client qui paie, il pèse les risques : au début, il n'est pas sûr de devoir vendre une telle arme à un inconnu.", false],
		[37, "", "Il est pourtant fiable à sa manière : il respecte le marché une fois le prix payé, et il trouve exactement ce que le pilote a demandé. Son habitude de parler de lui-même par son nom et sa fierté de connaître les bonnes personnes aux bons endroits en font l'une des figures les plus pittoresques de la campagne.", false],
		[35, "Relations", "[[character/11]] est son chasseur et, par l'intermédiaire du pilote, sa victime.", false],
		[37, "", "Il traite avec [[character/9]] comme avec le pilote, sans se soucier du camp de l'un ou de l'autre.", false],
	],
	"character/9": [
		[2, "", "[[character/9]], de son nom de famille Dawn, est un fonctionnaire colon de [[station/0]], où le pilote vend la pêche du jour.", false],
		[3, "", "Arrogant et ambitieux, il traite avec un mépris ouvert ceux qui travaillent pour la colonie. C'est le premier employeur du pilote, qui devient son rival durable.", false],
		[12, "Contexte", "[[character/9]] se croit promis à bien mieux que son poste dans les stations.", false],
		[23, "", "[[character/2]] l'a connu quand il n'était qu'un personnage insignifiant. Selon elle, il s'est élevé grâce à de bonnes relations plutôt qu'à son mérite, et au moment de la rébellion il détient un réel pouvoir au sein des forces [[faction/colonists|coloniales]].", false],
		[3, "Premières rencontres", "[[character/9]] achète la première pêche du pilote à prix fixe et se moque de la petite cale. Il ajoute que le pilote ferait mieux de chasser les [[faction/pirates|pirates]], tout en doutant que le pilote y parvienne ([[chapter/2]]).", false],
		[7, "", "Quand le pilote revient armé, il s'en attribue le mérite et propose un travail : débarrasser des [[species/0|nautiles]] les routes autour de [[station/1]]. Il balaie les objections du pilote et se moque de la manière dont les créatures seront éliminées ([[chapter/6]]).", false],
		[10, "", "Il dirige le lancement des capsules à [[station/2]] et prévient le pilote que perdre plus de cinq capsules lui coûtera son travail ([[chapter/10]]).", false],
		[12, "", "Ensuite, il rend le pilote responsable des capsules endommagées et retient la récompense. Son mépris est la goutte d'eau qui pousse le pilote vers la résistance ([[chapter/11]]).", false],
		[23, "Contre la rébellion", "[[character/9]] se retourne contre les rebelles à mesure qu'ils gagnent du terrain. Il fait poser un champ de mines en travers de leur route de ravitaillement entre [[station/9]] et [[station/37]] ([[chapter/22]]).", false],
		[25, "", "Il attend avec ses forces quand [[character/2]] arrive pour négocier à [[station/10]], et ordonne aussitôt l'attaque ([[chapter/25]]).", false],
		[28, "", "C'est lui qui finance la trahison de [[character/3]]. Il a offert une grosse prime pour [[character/2]] et pour le pilote, qu'il voit apparemment comme une menace ([[chapter/27]]).", false],
		[37, "", "Sa cupidité cause sa perte. Il vend un canon [[world/eclipse|Eclipse]] au trafiquant du marché noir [[character/8]], qui le revend à son tour au pilote ([[chapter/36]]).", false],
		[43, "Défaite", "[[character/9]] mène l'attaque surprise des colons contre [[station/14]]. Il se moque du pilote, qu'il traite de pêcheur au service des rebelles, et reste sidéré en apprenant que le pilote porte un [[equipment/42]] ([[chapter/43]]).", false],
		[44, "", "Quand les [[world/aquarians|Aquariens]] se joignent au combat contre ses vaisseaux, il abandonne l'attaque et prend la fuite.", false],
		[47, "", "[[character/9]] livre son dernier combat à [[station/0]], l'ultime bastion de la colonie. En apprenant que le pilote a tué [[character/3]], il prétend que [[character/3]] était le frère du pilote et que lui-même est son père. Le pilote met aussitôt le mensonge à nu, et [[character/9]] admet qu'il a failli marcher ([[chapter/47]]).", false],
		[48, "", "Dans la bataille qui suit, [[character/9]] est le dernier colon encore en lice. Il s'échappe dans une capsule de sauvetage qui semble emporter toute la station avec lui, et quitte l'océan sur une dernière pique méprisante envers les poissons et ceux qui restent.", false],
		[3, "Personnalité", "[[character/9]] est grossier, imbu de lui-même et dédaigneux envers tous ceux qu'il juge inférieurs.", false],
		[12, "", "Il rejette la faute sur les autres et s'attribue le mérite quand tout va bien.", false],
		[37, "", "Sa cupidité l'emporte sur sa loyauté envers son propre camp.", false],
		[47, "", "C'est un manipulateur qui use de mensonges et de pots-de-vin plutôt que de courage, et il s'enfuit chaque fois qu'une bataille tourne en sa défaveur.", false],
		[3, "Relations", "Son dédain pour le pilote naît dès leur première rencontre et se mue au fil de la campagne en hostilité ouverte.", false],
		[23, "", "[[character/2]] le méprise depuis longtemps.", false],
		[28, "", "Il achète la loyauté de [[character/3]] avec une prime.", false],
		[37, "", "Il fait affaire avec [[character/8]] sans savoir où finira la marchandise.", false],
	],
	"chart": [
		[1, "", "La carte montre les deux cents stations sous forme de points, à leur position sur la carte de l'océan. Les points bleus sont tenus par les [[faction/colonists]], les points orange par les [[faction/rebels]], au chapitre que vous avez atteint. Toutes les stations commencent en bleu ; elles passent à l'orange à mesure que l'histoire avance et ne reviennent jamais en arrière.", false],
		[1, "", "Sur une page de station ou de chapitre, la station concernée est dessinée en plus grand avec son nom, et les stations qui rejoignent les rebelles à ce chapitre sont entourées. Sous la carte, chaque station est listée avec un lien vers sa page. Les distances entre stations sont mesurées en unités de carte ; voir [[guide/navigation]].", false],
	],
	"contract/0": [
		[1, "", "Retrouver un vaisseau recherché qui attend seul à 400 à 1 200 m de la station, et le détruire. La cible est bien plus coriace qu'un pirate ordinaire, et sa puissance augmente avec le rang du pilote. Les armes à longue portée et une torpille aident à l'user avant qu'elle ne se rapproche. La prime est versée au retour dans une station.", false],
	],
	"contract/1": [
		[1, "", "Une bande de trois à six vaisseaux attend le long d'un itinéraire sinueux. La cible est le dernier d'entre eux, au dernier point de passage. On ne peut pas simplement la détruire : il faut la neutraliser, puis la remorquer au harpon avant qu'elle ne s'échappe. Éliminez d'abord l'escorte, pour que le remorquage ne soit pas interrompu.", false],
	],
	"contract/10": [
		[1, "", "Détruire toutes les mines d'un champ de 15 à 25, à deux à six cents mètres de la station, gardé par un seul vaisseau. Les mines ne peuvent être touchées qu'à courte portée : approchez-vous donc de chacune avec prudence. De bons boucliers et un bon blindage aident à encaisser les explosions.", false],
	],
	"contract/11": [
		[1, "", "Des capsules de ravitaillement sont attaquées. Détruisez les assaillants tant qu'il reste assez de capsules pour atteindre le minimum du contrat. Surveillez le compte des capsules et engagez d'abord les assaillants qui s'en approchent. Ces missions paient environ 30 % de plus qu'un contrat de base.", false],
		[10, "", "Les assaillants sont des Aquariens, les habitants mi-humains de la mer qui s'en prennent aux capsules de transport des colons.", false],
	],
	"contract/12": [
		[1, "", "Détruire un nombre fixé de capsules de ravitaillement gardées par des vaisseaux armés, avec des forces alliées combattant à vos côtés. En pratique, aucune station ne propose cette mission sur son tableau : elle ne peut donc pas être acceptée. Elle figure dans l'encyclopédie uniquement parce qu'elle est définie avec les autres types de contrats.", false],
	],
	"contract/13": [
		[1, "", "Produire une quantité fixée d'un produit et la livrer à la station qui a publié la mission. La rémunération dépend de la valeur du produit et de la quantité demandée. La récompense est souvent très généreuse, et la caution n'est que la moitié de l'habituelle. Vérifiez d'abord la recette et rassemblez les ingrédients avant d'accepter. Ces missions n'apparaissent que dans les stations au-delà des vingt premières de la carte.", false],
		[12, "", "Seules les stations rebelles proposent cette mission.", false],
	],
	"contract/14": [
		[1, "", "Livrer une quantité exacte d'une créature ou d'une algue donnée à la station qui a publié la mission. La quantité va de 3 à 24 unités, et la caution est la moitié de l'habituelle. Les espèces courantes sont demandées plus souvent que les rares. Un radar de pêche et une grande cale rendent ces missions faciles. Elles n'apparaissent que dans les stations au-delà des vingt premières.", false],
		[12, "", "Seules les stations rebelles proposent cette mission.", false],
	],
	"contract/2": [
		[1, "", "Le vaisseau d'un ravisseur détient un otage. Comme pour une mission de récupération, la cible navigue avec une bande le long d'un itinéraire sinueux et doit être neutralisée, puis remorquée au harpon. La mission échoue si la cible s'échappe. Installez un harpon à bonne portée et éliminez l'escorte avant de vous occuper du ravisseur.", false],
	],
	"contract/3": [
		[1, "", "Traquer tous les pirates d'une bande de trois à six vaisseaux, répartis sur les points de passage d'un itinéraire sinueux. La mission est accomplie quand il n'en reste plus aucun. C'est un contrat simple pour un vaisseau armé, et la taille de la bande augmente avec la difficulté de la mission.", false],
	],
	"contract/4": [
		[1, "", "Cinq cargos suivent un trajet fixé, et des pillards les attendent en chemin. La mission réussit quand tous les assaillants sont détruits. Elle échoue si tous les cargos sont perdus. Les escortes paient environ 30 % de plus qu'une simple chasse aux pirates. Restez près du convoi et engagez les pillards avant qu'ils ne l'atteignent.", false],
	],
	"contract/5": [
		[1, "", "Attaquer un convoi de deux ou trois cargos à un point de passage et les détruire, malgré leur garde armée. Seuls les cargos doivent être détruits : concentrer le feu sur eux peut donc terminer la mission plus tôt. Une torpille ou un canon à longue portée aide à les abattre pendant que la garde se rapproche.", false],
	],
	"contract/6": [
		[1, "", "Un banc de 15 à 24 créatures suit un trajet fixé, et des chasseurs l'attaquent en chemin. Détruisez les chasseurs avant que les pertes ne dépassent la limite convenue. Ne tirez jamais près du banc : un tir perdu compte comme une perte. Ces missions paient environ 30 % de plus qu'un contrat de base.", false],
		[12, "", "Seules les stations rebelles proposent cette mission, et elles cessent de le faire une fois l'histoire terminée.", false],
	],
	"contract/7": [
		[1, "", "Tuer un nombre fixé d'individus d'une espèce de la faune locale pendant que des vaisseaux hostiles tentent d'intervenir. Les prises harponnées ne comptent pas : les créatures doivent être tuées. Un radar de pêche aide à trouver rapidement la bonne espèce. Ces missions paient environ 20 % de plus qu'un contrat de base.", false],
	],
	"contract/8": [
		[1, "", "Conduire un passager à une autre station. Certains passagers fixent un nombre maximal de sauts S.T.R.E.A.M., et moins ils en autorisent, plus la rémunération est élevée. Le contrat expire si cette limite est dépassée. Un bon moteur aide ici, car une plus grande portée signifie moins de sauts.", false],
	],
	"contract/9": [
		[1, "", "Nettoyer un champ de 15 à 30 débris, à deux à six cents mètres de la station, en deux minutes et demie environ. Des vaisseaux hostiles légers peuvent être présents. La rémunération est inférieure d'environ 30 % à celle des autres contrats, mais la mission est rapide. Un booster et des canons à tir rapide font gagner de précieuses secondes.", false],
	],
	"equipment/0": [
		[1, "", "Le canon d'entrée de gamme : 3 points de dégâts par tir toutes les 0,56 s, avec une portée de 228 m. C'est très peu de puissance, mais à environ 5 700 cr, c'est l'arme la moins chère et l'une des plus courantes en boutique. On peut en installer plusieurs, et tous les canons tirent ensemble : deux ou trois d'entre eux forment donc une batterie utilisable en début de partie, en attendant de pouvoir s'offrir plus lourd.", false],
		[3, "", "Au [[chapter/3|chapitre 3]], le pilote doit en installer un avant de quitter [[station/0]].", false],
	],
	"equipment/1": [
		[1, "", "Le canon électromagnétique intermédiaire double les dégâts du modèle [[equipment/0]], à 6 par tir, et tire un peu plus vite, toutes les 0,48 s, jusqu'à 260 m. Pour environ le double du prix, il fait plus que doubler les dégâts soutenus. C'est un deuxième canon judicieux dans les premiers chapitres, avant l'arrivée des canons à fusion en boutique.", false],
	],
	"equipment/10": [
		[1, "", "Cet accélérateur de masse inflige 20 points toutes les 0,40 s avec une portée de 280 m, soit les dégâts soutenus les plus élevés de tous les canons en vente libre. Il porte aussi plus loin que tous les canons à fusion. Comptez de 42 000 à 51 000 cr. Pour une coque de combat avec des emplacements libres, c'est l'un des meilleurs choix de canon.", false],
	],
	"equipment/11": [
		[1, "", "L'accélérateur de masse le plus lourd inflige 25 points par tir à 375 m, la plus grande portée de toutes les armes à tir rapide. Avec un intervalle de 0,51 s, ses dégâts soutenus sont à peu près équivalents à ceux du modèle [[equipment/10]]. Son atout est la portée. C'est le canon le plus rare et le plus cher des boutiques, de 54 000 à 60 000 cr.", false],
	],
	"equipment/12": [
		[1, "", "La torpille à tête chercheuse de base inflige 20 points de dégâts et se dirige d'elle-même vers la cible, jusqu'à 215 m. Elle ne se recharge que toutes les 4,3 s. On ne peut installer qu'un seul lance-torpilles, quel qu'en soit le type. Elle est utile contre les cibles agiles difficiles à garder dans le viseur, mais sa portée est courte.", false],
	],
	"equipment/13": [
		[1, "", "La torpille intermédiaire inflige 30 points, se recharge en 4,0 s et porte à 360 m, surpassant le modèle [[equipment/12]] à tous égards. Comme on ne peut installer qu'un seul lance-torpilles, elle remplace le modèle moins cher plutôt qu'elle ne le complète. À 37 000 à 39 000 cr, c'est une bonne arme d'achèvement polyvalente.", false],
	],
	"equipment/14": [
		[1, "", "La meilleure torpille porte une ogive de 50 points de dégâts jusqu'à 816 m, le coup unique le plus lourd de toutes les armes en vente. Il lui faut 6,8 s pour se recharger. Occupant le seul emplacement de torpille du vaisseau, elle se marie bien avec des canons rapides : un coup à longue portée en début de combat, puis les canons terminent le travail. Elle est rare et coûte 62 500 cr ou plus.", false],
	],
	"equipment/15": [
		[1, "", "Le harpon de départ porte à 240 m et pardonne une visée approximative grâce à une tolérance de capture de 24 m, la plus large des trois. Il ne ralentit en rien une prise accrochée : les créatures rapides tirent fort et mettent longtemps à s'épuiser. Il suffit pour les algues et les animaux lents, et coûte peu à remplacer.", false],
	],
	"equipment/16": [
		[1, "", "Ce harpon porte à 400 m et ralentit de 40 % une créature accrochée, ce qui permet de garder bien plus facilement en vue des prises rapides comme [[species/7]]. La tolérance de capture se réduit à 18 m : la visée compte donc davantage. Pour un pilote qui pêche régulièrement, c'est l'amélioration la plus importante après une plus grande cale.", false],
	],
	"equipment/17": [
		[1, "", "Le meilleur harpon porte à 560 m et ralentit de 70 % une prise accrochée, si bien que même les créatures rapides sont maîtrisées sans longue poursuite. Sa tolérance de capture de 14 m est la plus étroite : il récompense une visée soignée. Il est rare et cher, de 69 000 à 83 000 cr, et on ne peut installer qu'un seul harpon.", false],
	],
	"equipment/18": [
		[1, "", "Le bouclier de base absorbe 100 points de dégâts avant que le blindage ne soit touché. Il fixe aussi la limite haute du vaisseau à 20 000 m. Il ne se recharge jamais en mission ; il n'est restauré que lorsque le vaisseau quitte une station. Il suffit pour les premiers combats, mais la plupart des pilotes le remplacent dès que possible.", false],
	],
	"equipment/19": [
		[1, "", "Ce bouclier absorbe 175 points, trois quarts de plus que le modèle [[equipment/18]], et permet de remonter jusqu'à 18 400 m. Comme le modèle de base, il ne se recharge pas en mission. À 15 750 à 18 000 cr, c'est l'amélioration de bouclier rentable la moins chère, et elle ouvre l'accès à plusieurs stations moins profondes.", false],
	],
	"equipment/2": [
		[1, "", "Le canon électromagnétique le plus lourd inflige 9 par tir à 322 m de portée, mais sa cadence est un peu plus lente que celle du modèle [[equipment/1]], à 0,62 s. Ses dégâts soutenus ne progressent donc que modestement. À 16 000 à 20 000 cr, il offre un bon rapport portée-prix, mais le modèle [[equipment/6]] inflige nettement plus de dégâts pour un peu plus d'argent.", false],
	],
	"equipment/20": [
		[1, "", "Ce bouclier absorbe 220 points et est le premier à se recharger en mission, regagnant un point toutes les 1,15 s tant que le vaisseau reste dans sa tranche de profondeur. Il relève la limite haute à 16 800 m. À plus de 56 000 cr, il coûte bien plus que le modèle [[equipment/19]], mais la recharge rend les longs combats beaucoup plus sûrs.", false],
	],
	"equipment/21": [
		[1, "", "Le meilleur bouclier absorbe 310 points et regagne un point toutes les 0,65 s, presque deux fois plus vite que le modèle [[equipment/20]]. Sa limite haute de 15 000 m monte plus haut que celle de tout autre bouclier, ce qui ouvre l'accès aux stations les moins profondes. Il est rare et coûte 93 750 cr ou plus : un investissement de fin de campagne.", false],
	],
	"equipment/22": [
		[1, "", "Le blindage de base ajoute 100 points de protection, entamés après l'épuisement du bouclier et avant que la coque ne soit touchée. Il fixe aussi la limite basse à 25 000 m. Le blindage ne se régénère pas en mission. Ce blindage est bon marché et suffisant au début, mais de nombreuses stations plus profondes restent hors de sa portée.", false],
	],
	"equipment/23": [
		[1, "", "Ce blindage ajoute 155 points et abaisse la limite basse à 26 800 m. Il coûte à peu près autant que le modèle [[equipment/19]], son équivalent côté bouclier, et ensemble, les deux élargissent la tranche de profondeur du vaisseau dans les deux sens. C'est une bonne première amélioration pour un pilote qui veut atteindre des stations plus profondes.", false],
	],
	"equipment/24": [
		[1, "", "Ce blindage ajoute 195 points et permet de plonger jusqu'à 28 400 m. Il est nettement plus cher que le modèle [[equipment/23]], de 56 000 à 72 000 cr, pour un gain de protection plus faible. La profondeur supplémentaire est souvent la meilleure raison de l'acheter, car elle met de nombreuses stations profondes à portée.", false],
	],
	"equipment/25": [
		[1, "", "Le meilleur blindage ajoute 270 points et permet de plonger jusqu'à 30 000 m, la limite la plus profonde disponible. Il est rare et coûte 93 750 cr ou plus. Associé au modèle [[equipment/21]], il permet à un vaisseau d'opérer sur presque toute la plage de profondeurs des stations.", false],
	],
	"equipment/26": [
		[1, "", "Le plus petit module de cargaison ajoute 30 % à la capacité de base de la coque. On peut installer plusieurs modules, et leurs bonus s'additionnent. Comme le bonus est une part de la capacité de base, il donne 7 t sur la coque [[ship/0]] mais 54 t sur la coque [[ship/6]]. C'est le moyen le moins cher de gagner de la place en cale sur une grande coque.", false],
	],
	"equipment/27": [
		[1, "", "Ce module ajoute 50 % à la capacité de base de la coque et se cumule avec d'autres. Par crédit, il est un peu moins efficace que le modèle [[equipment/26]], mais il économise des emplacements, qui comptent davantage sur les coques qui en ont peu à revendre. Sur la coque [[ship/4]], un seul module ajoute 35 t, de quoi justifier l'emplacement pour une tournée commerciale.", false],
	],
	"equipment/28": [
		[1, "", "Le plus grand module ajoute 80 % à la capacité de base, le plus fort apport par emplacement de tous les modules de cargaison. Sur la coque [[ship/6]], il ajoute 144 t. On peut en installer plusieurs. Il est rare et coûte 45 000 cr ou plus : il vaut donc surtout la peine pour une coque à grande cale dédiée au commerce.", false],
	],
	"equipment/29": [
		[1, "", "Le moteur de base étend de 30 % la portée S.T.R.E.A.M. du vaisseau sur la carte, ce qui permet d'atteindre davantage de stations en un seul saut. On ne peut installer qu'un seul moteur. Il est bon marché et utile dès le début, car moins de sauts signifie des tournées commerciales et des transports de passagers plus rapides.", false],
	],
	"equipment/3": [
		[1, "", "Le premier canon à bobine est une arme à rayon conçue pour la portée. Il atteint 875 m, près de quatre fois la portée des canons électromagnétiques, et inflige 15 points, mais il lui faut 2,5 s entre deux tirs. Ses dégâts soutenus sont à peu près ceux du modèle [[equipment/0]]. Il vaut la peine d'être installé pour ouvrir le feu sur des vaisseaux qui approchent avant qu'ils ne puissent riposter.", false],
	],
	"equipment/30": [
		[1, "", "Ce moteur étend la portée S.T.R.E.A.M. de 60 %, le double du bonus du modèle [[equipment/29]], pour environ trois fois le prix. Il convient à un marchand qui transporte régulièrement des marchandises entre des marchés éloignés, puisque les prix augmentent avec la distance parcourue par une cargaison. Il est aussi assez courant dans les boutiques de milieu de campagne.", false],
	],
	"equipment/31": [
		[1, "", "Le meilleur moteur étend la portée S.T.R.E.A.M. de 130 %, ce qui fait plus que doubler la portée de base. Il est rare et coûte 90 000 cr ou plus. Il vaut la peine d'être installé quand de longues routes commerciales ou des destinations de contrat lointaines rendent chaque saut économisé précieux.", false],
	],
	"equipment/32": [
		[1, "", "Ce propulseur ajoute 0,15 à la valeur de direction de la coque. Le gain est fixe : il compte donc surtout sur les coques lentes. Sur la coque [[ship/6]], il fait passer la direction de 0,67 à 0,82. On ne peut installer qu'un seul module de direction. C'est un remède bon marché pour un cargo pataud.", false],
	],
	"equipment/33": [
		[1, "", "Ce propulseur ajoute 0,26 à la valeur de direction, presque le double du gain du modèle [[equipment/32]], pour environ trois fois le prix. Il convient à un pilote qui combat souvent avec une coque de poids moyen et doit tourner plus court que les pirates qui l'attaquent. Sur la coque [[ship/4]], il fait passer la direction de 0,91 à 1,17, proche de la valeur de la coque [[ship/7]].", false],
	],
	"equipment/34": [
		[1, "", "Le meilleur propulseur ajoute 0,56 à la valeur de direction. C'est assez pour que la coque [[ship/6]] tourne mieux que la coque [[ship/0]], ou pour donner à la coque [[ship/5]] une agilité inégalée. Il est rare et coûte 87 000 cr ou plus, un luxe pour les combattants dévoués. Sur une coque déjà maniable, les propulseurs moins chers sont peut-être un meilleur usage de l'argent.", false],
	],
	"equipment/35": [
		[1, "", "Le radar de base affiche les vaisseaux et autres contacts sur l'écran radar et les signale au bord du champ de vision, pour que le pilote puisse trouver des cibles. Sans radar, l'écran n'affiche que la navigation. Il n'identifie pas les vaisseaux hostiles et n'affiche pas les créatures, mais il est bon marché et indispensable.", false],
	],
	"equipment/36": [
		[1, "", "Ce radar de combat ajoute l'identification : un vaisseau hostile dans le viseur est étiqueté avec son type de coque et la cargaison qu'il transporte. Il n'affiche pas les créatures : c'est un outil de combattant. À 18 500 à 23 000 cr, il coûte à peu près autant que le modèle [[equipment/37]] ; le choix dépend donc de ce que le pilote fait surtout, combattre ou pêcher.", false],
	],
	"equipment/37": [
		[1, "", "Ce radar de pêche affiche les créatures sur l'écran radar en plus des vaisseaux, ce qui facilite beaucoup la recherche de prises de valeur. Il n'étiquette pas les vaisseaux hostiles comme le fait le modèle [[equipment/36]]. Pour un pilote axé sur la pêche, c'est le radar le plus utile après le modèle [[equipment/38]].", false],
	],
	"equipment/38": [
		[1, "", "Le meilleur radar combine les deux spécialisations : il étiquette les vaisseaux hostiles et affiche les créatures sur l'écran radar. Il coûte environ deux fois plus que l'un ou l'autre des radars spécialisés et est rare en boutique. Comme on ne peut installer qu'un seul radar, il évite de devoir choisir entre la pêche et le combat.", false],
	],
	"equipment/39": [
		[1, "", "Le booster de base double la vitesse du vaisseau pendant 3 s, puis doit se recharger pendant 20 s. On ne peut installer qu'un seul booster. Il est utile pour rattraper une cible, échapper au danger ou atteindre plus vite la porte S.T.R.E.A.M., et il est courant et bon marché.", false],
	],
	"equipment/4": [
		[1, "", "Ce canon à bobine porte les dégâts par tir à 22, mais allonge l'intervalle à 3,4 s : ses dégâts soutenus progressent donc à peine par rapport au modèle [[equipment/3]]. La portée est presque inchangée, à 884 m. C'est un choix correct quand le modèle moins cher n'est pas en vente, mais l'amélioration est moindre que ne le laisse penser l'écart de prix.", false],
	],
	"equipment/40": [
		[1, "", "Ce booster multiplie la vitesse par 2,5 pendant environ 4 s et se recharge en environ 16 s. Toutes ses valeurs dépassent celles du modèle [[equipment/39]], pour environ le double du prix. C'est un bon choix de milieu de campagne pour les pilotes de combat, et il raccourcit aussi le trajet jusqu'à la porte S.T.R.E.A.M. lors des longs voyages.", false],
	],
	"equipment/41": [
		[1, "", "Le meilleur booster triple la vitesse pendant environ 5 s et se recharge en 14,5 s : il est donc prêt plus souvent et dure plus longtemps que tous les autres. Il est rare, mais à environ 42 000 cr, il coûte moins cher que la plupart des équipements haut de gamme.", false],
	],
	"equipment/42": [
		[1, "", "Un lourd canon de station qui n'apparaît jamais dans les rayons ordinaires et n'a pas de prix catalogue. Il inflige 40 points de dégâts par tir toutes les 0,93 s avec une portée de 240 m, ce qui lui donne des dégâts soutenus proches de ceux des meilleurs accélérateurs de masse, tandis que chaque coup frappe aussi fort qu'une torpille de milieu de gamme.", false],
		[33, "", "À partir du [[chapter/33|chapitre 33]], la campagne s'articule autour de la recherche de l'un de ces canons.", false],
		[42, "", "Au [[chapter/42|chapitre 42]], le pilote doit en monter un avant de partir et l'essayer contre des pirates.", false],
	],
	"equipment/43": [
		[1, "", "Ce droïde de réparation restaure un point de coque toutes les 0,6 s, soit environ 100 points par minute, tant que la coque est endommagée. Il ne touche ni au bouclier ni au blindage. Il est utile pour les longues missions et pour les vaisseaux à faible coque qui ne peuvent se permettre un tir perdu. On ne peut en installer qu'un, et il occupe un emplacement qui pourrait accueillir un canon.", false],
	],
	"equipment/5": [
		[1, "", "Le meilleur canon à bobine est une arme de tireur d'élite. Chaque rayon inflige 35 points jusqu'à 1 380 m, la plus grande portée de toutes les armes, mais un tir n'est prêt que toutes les 5,6 s. C'est l'un des articles les plus rares en boutique. Installé à côté de canons à courte portée, il affaiblit les cibles bien avant que le reste de la batterie ne puisse les atteindre.", false],
	],
	"equipment/6": [
		[1, "", "Le premier canon à fusion est une arme de corps à corps : 10 points de dégâts toutes les 0,51 s, mais seulement jusqu'à 160 m, la plus courte portée de tous les canons. Sa cadence de dégâts dépasse nettement celle de tous les canons électromagnétiques. Il convient aux coques agiles capables de se rapprocher vite, et rend les canons électromagnétiques obsolètes au combat rapproché.", false],
	],
	"equipment/7": [
		[1, "", "Cette amélioration inflige 14 points toutes les 0,37 s, la cadence de tir la plus rapide de tous les canons, et étend la portée à 216 m. Ses dégâts soutenus sont presque le double de ceux du modèle [[equipment/6]], pour seulement quelques milliers de crédits de plus. Par crédit dépensé, c'est l'un des canons les plus puissants du jeu.", false],
	],
	"equipment/8": [
		[1, "", "Le canon à fusion le plus lourd inflige 18 points de dégâts toutes les 0,40 s à 220 m. C'est une nette amélioration par rapport au modèle [[equipment/7]], même si l'écart est plus faible qu'entre les deux premiers modèles. Il est rare en boutique. Quand il s'en présente un, c'est un excellent achat pour toute batterie de courte portée.", false],
	],
	"equipment/9": [
		[1, "", "Le premier accélérateur de masse frappe fort, 16 points par tir, mais ne tire que toutes les 0,6 s et porte à 195 m. À 38 000 cr ou plus, il inflige moins de dégâts par seconde que le modèle [[equipment/7]], moins cher. C'est surtout une étape vers les accélérateurs de masse suivants.", false],
	],
	"faction/colonists": [
		[1, "", "Les colons sont les habitants et administrateurs qui gouvernent la planète océanique au début de l'histoire. Ils tiennent chacune de ses deux cents stations, fixent les prix de la pêche et décident qui obtient du travail. Leur colonie est conçue pour extraire les ressources de la mer et les expédier hors de la planète. Pour la colonie en tant que lieu, voir [[world/colony]].", false],
		[1, "Histoire", "Les colons sont venus d'ailleurs s'installer sur la planète et ont bâti ses stations loin sous la mer. À l'arrivée du pilote, la colonie est établie de longue date, avec des fonctionnaires dans chaque station, des patrouilleurs à chaque porte et un flux régulier d'exportations.", false],
		[21, "", "Selon les rebelles, la colonisation a été rapide et insouciante des conséquences. Ils avertissent que l'océan se vide de sa vie plus vite qu'il ne peut se rétablir, et que d'autres planètes ont déjà été épuisées de la même manière.", false],
		[1, "Organisation", "Chaque station est dirigée par des fonctionnaires coloniaux qui gèrent le commerce, distribuent les contrats et commandent les patrouilles locales. Au-dessus d'eux, une administration commerciale supervise les exportations et tient les stations pour responsables de toute perte. La sécurité des stations et les pilotes de la colonie s'occupent des pirates et des autres menaces, souvent en engageant des indépendants.", false],
		[10, "", "Les marchandises quittent la planète par capsule de transport, lancées depuis les stations vers l'orbite et récupérées là-haut par des cargos.", false],
		[1, "Objectifs et méthodes", "Le but de la colonie est le profit de ses maîtres. Elle achète prises et marchandises à bas prix fixes et ne laisse pas ses stations commercer librement. Les animaux gênants sont abattus, et quiconque menace les envois est repoussé.", false],
		[23, "", "Face à la rébellion, les colons passent de l'administration à la force. Ils minent les routes de ravitaillement, tendent des embuscades et attaquent les stations rebelles.", false],
		[28, "", "Ils sont aussi prêts à acheter des loyautés. Une prime suffit à retourner un pilote rebelle contre sa propre dirigeante.", false],
		[2, "Membres notables", "[[character/9]] est le colon que le pilote connaît le mieux : un fonctionnaire arrogant de [[station/0]] qui méprise le pilote et achète la pêche à prix fixe.", false],
		[9, "", "Les fonctionnaires subalternes apparaissent sous le nom anonyme de [[character/6|colons]], comme le fonctionnaire de [[station/1]] qui paie mal la battue aux nautiles avant de mettre le pilote au travail sur le tableau des contrats.", false],
		[23, "", "Jack accède à un pouvoir considérable au cours de l'histoire, apparemment grâce à de bonnes relations, et devient l'ennemi le plus acharné des rebelles.", false],
		[28, "", "[[character/3]], un pilote rebelle, accepte en secret l'argent de la colonie et trahit ses camarades.", false],
		[3, "Rôle dans l'histoire", "Au début, les colons sont simplement les employeurs du pilote. Jack achète la pêche et suggère au pilote d'acheter une arme pour chasser les pirates.", false],
		[7, "", "Il ordonne ensuite une battue aux [[species/0|nautiles]] à [[station/1]], sans se soucier qu'ils soient capturés ou tués.", false],
		[10, "", "Après quelques contrats, la colonie confie au pilote la défense d'un lancement de capsules à [[station/2]] contre les Aquariens.", false],
		[12, "", "Jack rend le pilote responsable des capsules endommagées lors de ce combat et refuse tout paiement. Las du traitement que lui réserve la colonie, le pilote part chercher la résistance.", false],
		[18, "", "Tandis que les rebelles gagnent station après station par la persuasion, la colonie perd du terrain sans qu'un coup de feu soit tiré.", false],
		[23, "", "Jack mine la route de ravitaillement rebelle entre [[station/9]] et [[station/37]].", false],
		[25, "", "Il tend ensuite une embuscade à la dirigeante rebelle [[character/2]], alors qu'elle se rend à des négociations à [[station/10]].", false],
		[28, "", "La prime de Jack retourne Raymond contre les rebelles. Raymond enlève Ayumi, et le pilote la délivre.", false],
		[31, "", "Les colons ont volé le prototype de [[world/biotek]] du [[world/abel|professeur Abel]]. Les rebelles interceptent près de Cho le convoi qui le transporte.", false],
		[37, "", "Jack vend un canon de station [[world/eclipse|Eclipse]] au marché noir, sans se douter un instant qu'il servira contre lui.", false],
		[44, "", "Les colons lancent une attaque surprise contre [[station/14]], le cœur de la rébellion, mais sont mis en déroute quand les Aquariens viennent en aide aux rebelles. Jack fuit la bataille.", false],
		[46, "", "La première offensive rebelle prend [[station/18]] aux colons.", false],
		[47, "", "La seconde prend [[station/109]], et l'emprise des colons sur le sud s'effondre.", false],
		[48, "", "[[station/0]], le dernier bastion colonial, tombe lors de la bataille finale. Jack s'échappe dans une capsule de sauvetage, et le règne de la colonie sur l'océan prend fin.", false],
		[1, "Dans le jeu", "Les stations colons apparaissent en bleu sur la [[chart]]. Elles n'ont ni marché ni usine : à l'amarrage, elles prennent toute la cale au prix plancher. Ce sont donc de mauvaises escales pour qui transporte une cargaison précieuse. Leurs boutiques et chantiers navals sont ouverts, mais leurs chantiers ne vendent que des coques standard. Voir [[guide/allegiance]].", false],
		[1, "", "Leurs tableaux proposent des contrats [[contract/0]], [[contract/1]], [[contract/2]], [[contract/3]], [[contract/4]], [[contract/5]], [[contract/7]], [[contract/8]], [[contract/9]], [[contract/10]] et [[contract/11]], mais jamais de livraisons ni de protection de poissons. Dans les missions de convoi pour les colons, les vaisseaux adverses sont rebelles.", false],
		[1, "", "En revanche, une station colon paie les pirates deux fois plus cher qu'une station rebelle : le carré du nombre de pirates détruits pendant le trajet, multiplié par 100 crédits. Les patrouilleurs autour des stations colons combattent pour la colonie et aident contre les pirates.", false],
		[12, "", "Les stations quittent la colonie au fil de l'histoire, jamais par une action menée en jeu libre, et aucune n'y revient jamais. Une fois que le pilote a rejoint les rebelles, les vaisseaux colons deviennent le principal ennemi des missions de l'histoire.", false],
	],
	"faction/pirates": [
		[1, "", "Les pirates sont des hors-la-loi qui s'attaquent au trafic dans tout l'océan. Ils ne servent ni la colonie ni les rebelles, et attaquent les vaisseaux isolés, les convois et quiconque a l'air d'une proie facile. Ce sont les adversaires les plus fréquents du pilote, de sa première sortie armée jusqu'à la fin de l'histoire et au-delà.", false],
		[1, "Histoire", "La piraterie fait déjà partie du quotidien à l'arrivée du pilote. Les stations versent des primes à quiconque détruit un vaisseau pirate, et la chasse aux pirates est un métier courant parmi les pilotes armés.", false],
		[21, "", "Le conflit entre colons et rebelles est une aubaine pour les pirates. Les deux camps ayant l'esprit ailleurs, ils trouvent des victimes plus nombreuses et plus faciles, et la direction rebelle décide qu'elle ne peut plus les ignorer.", false],
		[1, "Organisation", "Les pirates opèrent en bandes informelles plutôt qu'en une organisation unique, et aucun d'eux n'est jamais nommé dans l'histoire. Les bandes se rassemblent dans des repaires en eaux libres, escortent des vaisseaux volés et gardent des champs de mines et de débris. Des pirates isolés guettent aussi le trafic près des stations.", false],
		[1, "Objectifs et méthodes", "Les pirates veulent du butin. Ils attaquent les vaisseaux pour leur cargaison et se rassemblent partout où il y a du grabuge, à l'affût de vaisseaux affaiblis à achever.", false],
		[23, "", "Ils rôdent autour du champ de mines colonial près de [[station/9]], dans l'espoir d'achever les vaisseaux qui s'y font prendre.", false],
		[35, "", "Les mercenaires évoluent dans les mêmes milieux. Le chasseur de primes [[character/11]] voyage avec une escorte armée, et pour le calcul des primes son vaisseau compte comme un pirate.", false],
		[5, "Membres notables", "Les pirates n'apparaissent dans l'histoire que sous la forme de pilotes anonymes, les [[character/10|pirates]], sans chef ni capitaine célèbre.", false],
		[5, "Rôle dans l'histoire", "Les pirates sont les premières cibles du nouveau canon électromagnétique du pilote. Sur la suggestion de [[character/1]], le pilote traque un pirate près de [[station/1]].", false],
		[21, "", "Ayumi décide de ne plus se contenter de défendre le mouvement et de frapper les pirates. Elle envoie le pilote et [[character/3]] contre une bande près de [[station/8]].", false],
		[25, "", "On s'attend à des pirates sur la route de [[station/10]], mais la vraie menace s'y révèle coloniale.", false],
		[26, "", "Chargé de devenir un meilleur combattant, le pilote se tourne vers la chasse aux pirates pour augmenter son tableau de chasse.", false],
		[42, "", "Un repaire de pirates près de [[station/17]] sert de terrain d'essai à l'[[world/eclipse|Eclipse]] fraîchement installé.", false],
		[43, "", "Les pirates qui s'y trouvent ne tardent pas à appeler des renforts.", false],
		[47, "", "Même pendant les offensives finales, des pirates retardent [[character/5]] sur la route de [[station/0]].", false],
		[1, "Dans le jeu", "Les pirates sont l'ennemi habituel en eaux libres. Leurs coques deviennent plus résistantes et leurs canons plus puissants à mesure que le rang du pilote monte et que l'histoire avance. Ils apparaissent dans les contrats [[contract/0]], [[contract/1]], [[contract/2]] et [[contract/3]] et gardent des champs de mines et de débris. Voir [[guide/combat]].", false],
		[1, "", "À partir du [[chapter/12|chapitre 12]], jusqu'à trois pirates peuvent attendre près d'une station à l'arrivée du pilote, et la probabilité augmente à chaque chapitre. À partir du [[chapter/16|chapitre 16]], les pirates et autres vaisseaux hostiles utilisent aussi de brusques pointes de vitesse.", false],
		[1, "", "Chaque pirate détruit au cours d'un trajet augmente la prime versée à la station suivante : le carré du nombre de pirates détruits, multiplié par 100 crédits dans une station colon ou par 50 dans une station rebelle. Les longues chasses rapportent donc bien plus que les courtes. Leurs épaves coulent lentement et peuvent être harponnées pour leur cargaison avant de descendre trop profond.", false],
		[1, "", "Les pirates n'ont aucune station à eux, et aucune station ne passe jamais de leur côté.", false],
	],
	"faction/rebels": [
		[1, "", "Les rebelles sont l'une des puissances qui peuvent tenir une station. Leur nature et leurs buts se précisent au fil de l'histoire. Voir [[guide/allegiance]].", false],
		[12, "", "Les rebelles forment un mouvement de résistance qui se soulève contre le pouvoir colonial sur la planète océanique. Ils commencent comme un réseau secret basé à [[station/3]] et s'étendent station par station. Ils veulent le libre-échange et une mer exploitée avec soin plutôt que pillée.", false],
		[12, "Histoire", "Le mouvement est déjà actif quand le pilote en entend parler pour la première fois, grâce aux communications radio que M.A.I. capte depuis Talon.", false],
		[13, "", "Les rebelles n'ont commencé à chiffrer leurs canaux que quelques jours après cette émission. Leurs membres gardent leurs projets pour eux et mettent les nouveaux venus à l'épreuve avant de leur faire confiance.", false],
		[18, "", "Pendant longtemps, le mouvement grandit par la persuasion. Ses agents recueillent des renseignements sur les stations et rallient leurs dirigeants, et les informations ne tardent pas à parler de révolution. Pierre s'attend à ce que la phase pacifique ne dure pas.", false],
		[26, "", "L'embuscade de [[station/10]] montre que la diplomatie seule ne gagnera pas la lutte, et le mouvement se prépare à combattre.", false],
		[31, "", "Pour surmonter la supériorité numérique des colons, la direction rebelle fait venir le [[world/abel|professeur Abel]] et son équipe à [[station/14]], qui devient la base d'opérations du mouvement.", false],
		[13, "Organisation", "Le mouvement est réduit et étroitement organisé. Les recrues sont examinées à leur arrivée et n'apprennent que ce qu'elles ont besoin de savoir. Les missions transitent par quelques agents de confiance.", false],
		[18, "", "La tête du mouvement dirige sa progression depuis l'une des stations nouvellement gagnées, et même ses propres membres restent vagues sur l'endroit exact.", false],
		[19, "", "La dirigeante voyage de station en station pour négocier en personne. Sous ses ordres servent agents de terrain, pilotes et ingénieurs.", false],
		[45, "", "À la fin de la guerre, le mouvement aligne des escadrons entiers de vaisseaux de combat.", false],
		[13, "Objectifs et méthodes", "Les rebelles condamnent l'exploitation de la planète et de ses habitants, et défendent le libre-échange.", false],
		[15, "", "Leur économie est l'inverse de celle de la colonie. Ils ne pêchent et ne récoltent que ce que la mer peut céder, transforment leurs prises en marchandises dans leurs propres usines et les vendent à de justes prix de marché, en veillant à préserver la biodiversité.", false],
		[16, "", "Ils préfèrent convaincre les gens plutôt que les combattre. Des agents explorent les stations pour repérer les points faibles qui permettront de rallier leur population.", false],
		[21, "", "Leur dirigeante avertit que l'exploitation coloniale épuisera la planète comme elle en a épuisé d'autres. Le mouvement cherche à convaincre des personnes influentes de le rejoindre avant que cela n'arrive. Il porte aussi le combat contre les pirates qui profitent du chaos.", false],
		[31, "", "Quand la force devient inévitable, les rebelles entreprennent de construire une arme décisive plutôt que d'égaler la colonie vaisseau pour vaisseau.", false],
		[12, "Membres notables", "[[character/4]] examine les nouveaux venus à [[station/3]]. Les opérateurs radio, gardes et équipages de convoi rebelles apparaissent sous le nom de [[character/7]].", false],
		[13, "", "[[character/5]] est un agent de terrain qui initie le pilote au mode de vie du mouvement.", false],
		[33, "", "Plus tard, Pierre dirige le hangar de [[station/14]] et y tient les vaisseaux du mouvement prêts au combat.", false],
		[19, "", "[[character/2]] dirige le mouvement. C'est une femme d'âge mûr, même si le pilote avait supposé que la tête du mouvement était un homme.", false],
		[21, "", "[[character/3]] est l'un des meilleurs pilotes d'Ayumi, doué mais arrogant.", false],
		[28, "", "Raymond trahit pour une prime coloniale et enlève Ayumi.", false],
		[31, "", "Le [[world/abel|professeur Abel]] dirige l'équipe scientifique à l'origine du [[world/biotek]].", false],
		[45, "", "[[character/12]] commande un escadron de combat qui se joint au pilote pour l'attaque contre [[station/18]].", false],
		[12, "Rôle dans l'histoire", "Après sa rupture avec la colonie, le pilote part à la recherche du mouvement à Talon.", false],
		[13, "", "Pierre accepte le pilote à l'essai. La première tâche consiste à conduire Leah de [[station/4]] à [[station/5]].", false],
		[16, "", "D'autres tâches suivent : produire des marchandises dans des stations rebelles et explorer des stations pour le mouvement.", false],
		[19, "", "Le pilote rencontre enfin Ayumi et protège un banc de pieuvres contre des chasseurs colons près de [[station/7]].", false],
		[22, "", "Aux côtés de Raymond, le pilote détruit une bande de pirates près de [[station/8]].", false],
		[24, "", "Le pilote déblaie ensuite un champ de mines colonial près de [[station/9]].", false],
		[26, "", "À Sula, la direction du mouvement tombe dans une embuscade. Les armes de Raymond tombent en panne au moment décisif, et Leah soupçonne un sabotage.", false],
		[28, "", "Raymond attire le pilote dans un piège avec Ayumi pour otage, mais le pilote détruit son vaisseau et la récupère vivante.", false],
		[31, "", "Le mouvement lance un plan en trois étapes, à commencer par la récupération du [[world/biotek]] volé.", false],
		[33, "", "La deuxième étape consiste à obtenir un canon [[world/eclipse|Eclipse]], que le pilote achète par l'intermédiaire d'un trafiquant du marché noir.", false],
		[39, "", "La troisième consiste à construire à [[station/16]] l'incubateur qui complète le générateur.", false],
		[44, "", "L'arme est achevée juste avant que les colons n'attaquent Fiir. L'Eclipse du pilote et l'aide soudaine des [[world/aquarians|Aquariens]] sauvent la station.", false],
		[45, "", "Les Aquariens promettent leur soutien, et le mouvement prépare ses offensives finales avec eux pour alliés.", false],
		[47, "", "Deux offensives suivent. Leah prend [[station/109]] et le pilote prend [[station/18]].", false],
		[48, "", "La guerre s'achève avec la chute de [[station/0]], et le mouvement tient toutes les stations de la planète.", false],
		[1, "Dans le jeu", "Les stations rebelles apparaissent en orange sur la [[chart]]. Elles ont des marchés libres et des usines : on peut donc y acheter, vendre et fabriquer des marchandises ; voir [[guide/trading]]. Leurs chantiers navals vendent chaque coque dans sa version améliorée. Les patrouilles autour des stations rebelles combattent pour les rebelles.", false],
		[1, "", "Leurs tableaux proposent des contrats [[contract/0]], [[contract/1]], [[contract/2]], [[contract/3]], [[contract/6]], [[contract/8]], [[contract/9]], [[contract/10]], [[contract/13]] et [[contract/14]]. Elles ne publient jamais d'escortes, de raids sur des convois, de chasses aux poissons ni de missions de capsules, et cessent de publier des protections de poissons une fois l'histoire terminée. Quand des contrats rebelles impliquent de combattre d'autres vaisseaux, les adversaires sont des colons ou des pirates.", false],
		[1, "", "Une station rebelle paie les pirates moitié moins cher qu'une station colon : le carré du nombre de pirates détruits pendant le trajet, multiplié par 50 crédits.", false],
		[12, "", "Les stations rejoignent les rebelles au fil de l'histoire, quelques-unes à la fois au début, puis des dizaines d'un coup. Une station ralliée ne revient jamais à la colonie. Cette page liste les stations qui se rallient à chaque chapitre que vous avez atteint.", false],
	],
	"goods/18": [
		[1, "", "Ce qui reste d'une créature tuée au lieu d'être harponnée. Une carcasse remonte vers la surface et peut être ramenée au harpon pour un tiers de la masse de l'animal en viande. Elle se vend de 12 à 31 cr et sert surtout, avec [[species/14]], à fabriquer [[goods/19]]. Sa station d'origine est [[station/68]].", false],
	],
	"goods/19": [
		[1, "", "Un produit de base fabriqué à partir de [[goods/18]] et de [[species/14]], une unité de chaque par unité. N'importe quelle usine peut le fabriquer. Il se vend de 135 cr à [[station/78]] jusqu'à 360 cr à [[station/27]], et c'est un ingrédient de [[goods/30]] et de [[goods/36]].", false],
	],
	"goods/20": [
		[1, "", "Peau tannée de [[species/3]], traitée avec [[goods/33]]. Sa station d'origine est [[station/164]], et c'est à [[station/172]] qu'elle se vend le plus cher, jusqu'à 1 062 cr. Elle représente aussi la moitié de la recette de [[goods/29]] : une prise de manta peut ainsi devenir l'un des biens de consommation les plus chers.", false],
	],
	"goods/21": [
		[1, "", "Un plat de poisson cru et d'algues, fabriqué à partir de [[species/4]] et de [[species/17]]. Les deux ingrédients sont des prises courantes et bon marché, ce qui fait des sushis un premier produit facile. Il se vend de 420 cr à [[station/76]] jusqu'à 996 cr à [[station/179]].", false],
	],
	"goods/22": [
		[1, "", "Une teinture résistante à l'eau fabriquée à partir de [[species/10]] et de [[goods/35]]. Elle se vend de 750 cr à [[station/54]] jusqu'à 1 872 cr à [[station/27]]. C'est aussi l'un des deux ingrédients de [[goods/29]].", false],
	],
	"goods/23": [
		[1, "", "Des morceaux de [[species/7]], conservés avec [[goods/33]]. Comme le marlin est difficile à capturer, le steak est un produit haut de gamme : il se vend de 456 cr à [[station/109]] jusqu'à 1 260 cr à [[station/19]].", false],
	],
	"goods/24": [
		[1, "", "Un composé lumineux extrait des espèces [[species/5]] et [[species/1]] avec [[goods/35]]. Il se vend de 850 cr à [[station/83]] jusqu'à 2 500 cr à [[station/179]]. C'est un intrant clé de [[goods/32]], de [[goods/41]] et de [[goods/36]].", false],
	],
	"goods/25": [
		[1, "", "Une protéine extraite de [[species/6]] et de [[species/8]], traitée avec [[goods/33]]. Elle se vend de 900 cr à [[station/23]] jusqu'à 2 600 cr à [[station/27]], et c'est la base de [[goods/31]].", false],
	],
	"goods/26": [
		[1, "", "Un plat de poisson mixé, fabriqué à partir de [[species/8]], de [[species/4]] et de [[species/2]]. C'est l'aliment au prix plancher le plus élevé, de 1 916 cr à [[station/196]] jusqu'à 3 030 cr à [[station/179]], mais il demande trois prises différentes.", false],
	],
	"goods/27": [
		[1, "", "Des produits pharmaceutiques fabriqués à partir de [[species/1]], de [[species/13]], de [[species/16]] et de [[goods/33]]. Ils se vendent de 930 cr à [[station/151]] jusqu'à 2 316 cr à [[station/179]] et entrent dans la composition de [[goods/41]]. Les marchés en proposent rarement.", false],
	],
	"goods/28": [
		[1, "", "Une biomasse transformée qui exige une unité de chacune des cinq algues : [[species/13]], [[species/14]], [[species/15]], [[species/16]] et [[species/17]]. Elle se vend de 550 cr à [[station/74]] jusqu'à 2 700 cr à [[station/19]], l'écart le plus large de tous les produits de base, et elle entre dans [[goods/36]].", false],
	],
	"goods/29": [
		[1, "", "Des vêtements fabriqués à partir de [[goods/20]] et de [[goods/22]] : la chaîne remonte donc jusqu'à [[species/3]] et [[species/10]]. Ils se vendent de 1 626 cr à [[station/175]] jusqu'à 3 420 cr à [[station/172]]. Les marchés en proposent rarement.", false],
	],
	"goods/30": [
		[1, "", "Une source d'énergie portable assemblée à partir des marchandises [[goods/34]] et [[goods/19]]. Elle se vend de 1 150 cr à [[station/78]] jusqu'à 1 900 cr à [[station/27]]. On la trouve rarement sur les marchés : la fabriquer est donc généralement le seul moyen de l'obtenir.", false],
	],
	"goods/31": [
		[1, "", "Des produits de beauté fabriqués à partir de [[goods/25]] et de [[goods/35]]. Ils se vendent de 1 536 cr à [[station/23]] jusqu'à 3 840 cr à [[station/27]]. Les marchés en proposent rarement : un pilote qui fabrique du collagène peut donc aller une étape plus loin et gagner nettement plus.", false],
	],
	"goods/32": [
		[1, "", "Une lampe qui imite la lumière naturelle du jour, construite à partir des marchandises [[goods/34]] et [[goods/24]]. Elle se vend de 2 490 cr à [[station/83]] jusqu'à 5 622 cr à [[station/179]], ce qui en fait le produit le plus précieux qu'une usine puisse fabriquer à partir de prises et d'importations.", false],
	],
	"goods/33": [
		[1, "", "Un sous-produit du dessalement, bon marché et largement disponible, de 20 à 36 cr. Il n'est pas fabriqué à partir de prises, mais il est nécessaire pour [[goods/20]], [[goods/23]], [[goods/25]] et [[goods/27]]. Les contrats de livraison ne le demandent jamais.", false],
		[12, "", "Les marchés rebelles se réapprovisionnent entre deux visites, car il s'agit d'une importation.", false],
	],
	"goods/34": [
		[1, "", "Des composants importés, largement disponibles de 193 à 297 cr. Ils ne sont pas fabriqués sur place, mais ils sont nécessaires pour [[goods/30]], [[goods/32]], [[goods/41]] et [[goods/36]]. Les contrats de livraison ne les demandent jamais.", false],
		[12, "", "Les marchés rebelles se réapprovisionnent en électronique entre deux visites, car il s'agit d'une importation.", false],
	],
	"goods/35": [
		[1, "", "Un produit chimique importé, largement disponible de 55 à 123 cr. Il est nécessaire pour [[goods/22]], [[goods/24]] et [[goods/31]]. Les contrats de livraison ne le demandent jamais.", false],
		[12, "", "Les marchés rebelles se réapprovisionnent entre deux visites, car il s'agit d'une importation.", false],
	],
	"goods/36": [
		[1, "", "Un appareil de laboratoire servant à copier du matériel génétique. Il nécessite [[goods/19]], [[goods/34]], [[goods/28]] et [[goods/24]], et seule une usine de niveau technologique 11 peut l'assembler. Les marchés n'en proposent jamais.", false],
		[39, "", "À partir du [[chapter/39|chapitre 39]], la campagne exige que le pilote s'en procure un.", false],
	],
	"goods/37": [
		[1, "", "Une drogue importée, considérée comme un problème social croissant. Elle n'est pas fabriquée à partir de prises, et les marchés n'en proposent jamais.", false],
		[34, "", "Au [[chapter/34|chapitre 34]], le pilote doit livrer un lot à un contact dans le cadre d'un marché.", false],
	],
	"goods/38": [
		[1, "", "Un lourd canon de station en caisse, estimé à 89 000 cr. On ne peut pas l'acheter sur les marchés. Une fois livré et installé, il devient l'arme [[equipment/42]].", false],
		[37, "", "C'est l'objet de la quête du pilote à partir du [[chapter/33|chapitre 33]], et le pilote en transporte un au [[chapter/37|chapitre 37]].", false],
	],
	"goods/39": [
		[1, "", "Une pelle pliante importée. Son prix varie de 9 cr à 999 cr selon la distance parcourue, ce qui en fait une cargaison spéculative. Aucune usine ne la fabrique, et les contrats de livraison ne la demandent jamais. Sa station d'origine est [[station/89]].", false],
	],
	"goods/40": [
		[1, "", "Une figurine d'un héros célèbre, vendue aux collectionneurs. Son prix va de 999 cr jusqu'à 9 999 cr, entre les stations [[station/90]] et [[station/19]], la plus forte hausse de toutes les marchandises. Elle est peu courante sur les marchés, et les contrats de livraison ne la demandent jamais.", false],
	],
	"goods/41": [
		[1, "", "Des robots médicaux microscopiques fabriqués à partir des marchandises [[goods/27]], [[goods/24]] et [[goods/34]]. Ils comptent parmi les marchandises les plus précieuses, vendus de 4 315 cr à [[station/76]] jusqu'à 11 972 cr à [[station/179]], et les marchés n'en proposent presque jamais.", false],
	],
	"guide/allegiance": [
		[1, "Deux sortes de stations", "Chaque station est tenue par l'un des deux camps, indiqué par sa couleur sur la [[chart]] : bleu pour les [[faction/colonists]], orange pour les [[faction/rebels]]. Au début de l'histoire, toutes les stations sont colons.", false],
		[1, "", "Le camp d'une station change ce qu'elle propose :", false],
		[1, "", "Commerce : les stations colons n'ont ni marché ni atelier. Elles achètent toute la cale à l'arrivée au prix plancher. Les stations rebelles commercent et fabriquent librement ; voir [[guide/trading]].", true],
		[1, "", "Contrats : chaque camp propose sa propre sélection de types de contrats ; voir [[guide/contracts]].", true],
		[1, "", "Primes : une prime pour un pirate rapporte deux fois plus dans une station colon que dans une station rebelle.", true],
		[1, "", "Vaisseaux : les chantiers navals rebelles vendent chaque coque dans sa version améliorée.", true],
		[1, "", "Patrouilles : les vaisseaux qui tournent autour d'une station combattent pour son camp.", true],
		[1, "", "L'amarrage, l'équipementier, le concessionnaire et le tableau des contrats sont accessibles au pilote dans les deux sortes de stations.", false],
		[1, "Comment une station change de camp", "Les stations ne changent de camp qu'à mesure que l'histoire avance, jamais en fonction de ce que fait le pilote en jeu libre. Une fois qu'une station a rejoint les rebelles, elle reste avec eux. La page [[faction/rebels]] liste les stations qui se rallient à chaque chapitre que vous avez atteint.", false],
		[12, "", "La première station rebelle est [[station/3]], déjà acquise à la résistance quand le pilote en entend parler pour la première fois. La station [[station/4]] suit au [[chapter/12|chapitre 12]].", false],
		[14, "", "Au fil des chapitres suivants, les stations basculent une par une ou quelques-unes à la fois.", false],
		[22, "", "À partir du [[chapter/22|chapitre 22]], le mouvement s'étend bien plus vite, avec huit stations ou plus qui se rallient d'un coup.", false],
		[46, "", "Dans les derniers chapitres, la grande majorité de la carte est orange.", false],
		[12, "Ce que cela change pour le pilote", "À mesure que les stations changent de camp, marchés et ateliers ouvrent sur toute la carte, et la pêche cesse d'être le seul moyen de gagner sa vie. Les stations colons deviennent des lieux à éviter avec une cale de valeur, mais de bons endroits pour toucher une prime pour des pirates.", false],
	],
	"guide/basics": [
		[1, "Votre premier vaisseau", "Le pilote commence à [[station/0]] avec 15 000 crédits et le sous-marin [[ship/0]], un petit bateau de pêche. Il est livré avec le harpon [[equipment/15]], le bouclier [[equipment/18]], le blindage [[equipment/22]] et le radar [[equipment/35]]. Il ne porte aucun canon.", false],
		[1, "", "Les premiers chapitres forment une introduction guidée. [[character/1]], l'ordinateur de bord, explique chaque nouvelle tâche au moment où elle se présente : attraper un poisson, s'amarrer, installer de l'équipement et voyager. L'objectif en cours figure toujours dans le journal des missions.", false],
		[1, "Piloter", "Vous pouvez piloter le sous-marin au clavier et à la souris, à la manette ou avec les commandes tactiles, et chaque touche peut être réattribuée dans les Paramètres. La poussée varie par quarts, et Arrêter immobilise le vaisseau. Les propulseurs latéraux font glisser le sous-marin de côté, même à l'arrêt. Le boost ne fonctionne qu'avec un booster installé. Caméra fait défiler quatre vues.", false],
		[1, "", "Le pilote auto ouvre une liste de destinations : l'objectif en cours, le quai local, la porte S.T.R.E.A.M. locale ou n'importe quelle station de la carte. Diriger, accélérer ou utiliser les armes vous rend les commandes. Voir [[guide/navigation]].", false],
		[1, "S'amarrer", "Pour vous amarrer, entrez dans la zone d'amarrage de la station et utilisez Amarrer, ou choisissez le quai dans la liste du pilote auto. L'amarrage est verrouillé tant qu'une rencontre de mission dans la zone n'est pas terminée. Quitter une station remet toujours coque, bouclier et blindage à leur maximum, gratuitement.", false],
		[1, "Menus de station", "Une station où vous êtes amarré propose six services :", false],
		[1, "", "Hangar : l'équipementier, le concessionnaire, l'atelier de fabrication de marchandises et une vue de votre vaisseau.", true],
		[1, "", "Missions : le journal des objectifs en cours et le tableau des contrats de la station.", true],
		[1, "", "Carte : la carte des stations, pour planifier des itinéraires et savoir où vivent les espèces.", true],
		[1, "", "Commerce : le marché, pour acheter et vendre de la cargaison.", true],
		[1, "", "Statut : votre vaisseau, votre cargaison, votre rang de pilote, vos médailles et vos statistiques.", true],
		[1, "", "Système : sauvegarde, paramètres, aide et cette encyclopédie.", true],
		[1, "", "Certains services n'ouvrent que plus tard dans l'histoire. La Carte de la station ouvre au [[chapter/7|chapitre 7]] et le tableau des contrats au [[chapter/9|chapitre 9]]. Les stations tenues par les [[faction/colonists]] ne commercent jamais ; voir [[guide/trading]].", false],
		[1, "Sauvegarde", "Vous ne pouvez sauvegarder qu'à quai. Chaque arrivée dans une station crée un point de contrôle automatique, et le menu Système offre trois emplacements de sauvegarde supplémentaires. Revenir au menu principal depuis une station sauvegarde d'abord. Si la coque est détruite, la partie reprend à la dernière sauvegarde en station : amarrez-vous donc régulièrement lors des longs trajets.", false],
		[1, "", "Transférer la sauvegarde, également dans le menu Système, exporte votre dernière sauvegarde en station vers un fichier et l'importe sur un autre appareil.", false],
		[1, "Aide", "L'Aide du menu Système explique chaque écran de station. En mer, le menu pause donne accès à la carte, au journal des missions, à l'état du vaisseau, aux médailles et aux paramètres. M.A.I. commente une fois chaque nouvelle situation, comme la première porte ou la première plongée hors de la tranche de profondeur sûre. Ces conseils peuvent être désactivés dans les paramètres de jouabilité.", false],
		[1, "", "Lisez ensuite [[guide/depth]] avant de partir loin, et [[guide/fishing]] pour vos premiers revenus.", false],
	],
	"guide/combat": [
		[1, "Armes", "Les canons se répartissent en deux familles. Les armes à projectiles, comme les canons [[equipment/0]], [[equipment/6]] et [[equipment/9]], tirent des rafales. Les armes à rayon, les canons à bobine à partir du modèle [[equipment/3]], frappent fort à longue portée mais se rechargent lentement. On peut installer plusieurs canons, qui tirent ensemble depuis des affûts répartis sur la proue.", false],
		[1, "", "Les torpilles à tête chercheuse, de la torpille [[equipment/12]] à la torpille [[equipment/14]], filent en ligne droite pendant une seconde et demie, puis se tournent vers la cible vivante la plus proche dans un rayon d'environ 150 m. On ne peut installer qu'un seul lance-torpilles. Chaque page d'arme indique les dégâts, la portée et la cadence de tir.", false],
		[1, "Tirer", "Les canons et les torpilles forment un groupe d'armes, le harpon un autre. Tirer utilise le groupe sélectionné, et Groupe d'armes passe de l'un à l'autre. À la souris, le bouton gauche tire avec les canons et le droit avec le harpon ; à la manette, la gâchette droite tire avec les canons et la gauche avec le harpon.", false],
		[1, "", "Le tir auto maintient le groupe sélectionné en action jusqu'à ce que vous le désactiviez. Il met aussi fin au pilote auto.", false],
		[1, "Protection", "Les tirs reçus vident d'abord le bouclier, puis le blindage, puis la coque. Quand la coque tombe à zéro, le vaisseau est perdu et la partie reprend à la dernière sauvegarde en station.", false],
		[1, "", "Les boucliers à recharge passive se régénèrent en mer. Le blindage non, et la coque ne se répare qu'avec le système [[equipment/43]]. Quitter une station restaure les trois. Un booster comme le booster [[equipment/39]] donne une brève pointe de vitesse pour se rapprocher ou décrocher, puis doit se recharger.", false],
		[1, "Ennemis", "Les [[faction/pirates]] sont l'ennemi habituel. Leurs coques deviennent plus résistantes et leurs canons plus puissants à mesure que votre rang de pilote et l'histoire progressent. À partir du [[chapter/12|chapitre 12]], jusqu'à trois d'entre eux peuvent attendre près d'une station.", false],
		[1, "", "Les rencontres de mission amènent leurs propres adversaires : vaisseaux recherchés, bandes gardant un vaisseau hors d'état, gardes de convoi et champs de mines. Voir [[guide/contracts]].", false],
		[10, "", "Les Aquariens attaquent les capsules de transport des colons. Ils combattent avec leurs propres armes et ne laissent aucune épave quand ils sont détruits.", false],
		[1, "Primes et butin", "Chaque pirate détruit au cours d'un trajet augmente la prime versée à votre prochain amarrage. La prime vaut le nombre de pirates au carré, multiplié par 100 crédits dans une station colon ou par 50 dans une station rebelle. Quatre pirates en un trajet rapportent 1 600 crédits dans une station colon.", false],
		[1, "", "Les vaisseaux détruits laissent une épave dont la cargaison peut être récupérée au harpon. Les victoires comptent pour la médaille [[medal/4]], les pirates pour la médaille [[medal/14]], et de nombreuses victoires en un seul trajet pour la médaille [[medal/9]].", false],
		[1, "", "Tenez vos canons à l'écart des poissons que vous voulez attraper : une créature blessée s'enfuit, et une prise au bout du harpon est perdue si elle est touchée.", false],
	],
	"guide/contracts": [
		[1, "Le tableau des contrats", "À partir du [[chapter/9|chapitre 9]], le service Missions de chaque station propose un tableau de un à huit contrats. Chacun indique son commanditaire, une caution versée à l'acceptation et la rémunération versée en cas de succès. Vous pouvez détenir un contrat à la fois en plus de l'objectif de l'histoire. La caution n'est pas remboursée : abandonner ou échouer un contrat la fait perdre.", false],
		[1, "Types de contrats", "Il existe quinze types de contrats :", false],
		[1, "", "[[contract/0]] : détruire un vaisseau aguerri qui attend près de la station cible.", true],
		[1, "", "[[contract/1]] et [[contract/2]] : neutraliser un vaisseau qui voyage avec une bande de pirates, puis le harponner avant qu'il ne s'échappe.", true],
		[1, "", "[[contract/3]] : détruire tous les membres d'une bande de pirates.", true],
		[1, "", "[[contract/4]] : protéger un convoi de cargos contre des pillards ; perdre tout le convoi fait échouer la mission.", true],
		[1, "", "[[contract/5]] : détruire les cargos d'un convoi escorté.", true],
		[1, "", "[[contract/6]] : protéger un banc de créatures contre des chasseurs ; en perdre trop fait échouer la mission.", true],
		[1, "", "[[contract/7]] : capturer ou tuer un certain nombre d'individus d'une espèce.", true],
		[1, "", "[[contract/8]] : conduire un passager à une autre station, parfois avec un nombre d'escales limité en chemin.", true],
		[1, "", "[[contract/9]] : détruire des débris flottants en deux minutes et demie environ.", true],
		[1, "", "[[contract/10]] : détruire un champ de mines gardé.", true],
		[1, "", "[[contract/11]] : défendre des capsules de transport pendant un lancement.", true],
		[1, "", "[[contract/12]] : détruire des capsules de transport. Ce type n'apparaît que dans l'histoire, jamais sur un tableau des contrats.", true],
		[1, "", "[[contract/13]] et [[contract/14]] : livrer une quantité d'un produit, ou d'une espèce, à la station qui a publié la mission.", true],
		[1, "Qui propose quoi", "Les stations [[faction/colonists|colons]] ne proposent jamais les contrats [[contract/6]], [[contract/12]], [[contract/13]] ni [[contract/14]]. Les stations [[faction/rebels|rebelles]] ne proposent jamais les contrats [[contract/4]], [[contract/5]], [[contract/7]], [[contract/11]] ni [[contract/12]], et cessent de proposer [[contract/6]] une fois l'histoire terminée. Les contrats de livraison ne sont jamais proposés dans les vingt et une stations qui ouvrent la table des stations du jeu, de [[station/0]] à [[station/20]].", false],
		[1, "Destinations et rémunération", "La plupart des contrats mènent à une autre station, généralement située dans votre tranche de profondeur et à une distance qui augmente à mesure que l'histoire avance. La rémunération commence à 3 500 crédits et augmente avec la difficulté et la distance. Le contrat [[contract/9]] paie moins ; les escortes, la défense des poissons et la défense des capsules paient davantage. Un passager qui accepte moins d'escales paie un supplément. Les contrats de livraison demandent une caution réduite de moitié.", false],
		[1, "", "La difficulté dépend de votre rang de pilote. Le rang monte à mesure que vous capturez des créatures, détruisez des ennemis, fabriquez des marchandises et remplissez des contrats : les missions mieux payées amènent donc aussi des adversaires plus coriaces.", false],
		[1, "Remplir un contrat", "En arrivant dans la zone cible, la rencontre commence. L'option objectif du pilote auto mène à ses points de passage. L'amarrage et la porte restent verrouillés jusqu'à la résolution de la rencontre, et un échec met fin au contrat. Les livraisons sont réglées quand vous vous amarrez avec les marchandises.", false],
		[1, "", "Chaque contrat rempli compte pour la médaille [[medal/12]].", false],
	],
	"guide/depth": [
		[1, "La profondeur dans DEEP", "Chaque station se trouve à une profondeur fixe, indiquée avec son niveau technologique sur sa page. La plupart se situent entre 15 000 et 30 000 m. La station [[station/28]] est la plus haute, à 13 500 m, et la station [[station/81]] la plus profonde, à 32 250 m. L'océan n'a pas de fond pour arrêter une plongée : un sous-marin peut descendre aussi bas que sa coque le supporte.", false],
		[1, "La tranche sûre", "Un vaisseau n'est en sécurité que dans une tranche de profondeurs fixée par deux équipements. Le bouclier fixe la limite haute, le point le plus haut auquel le vaisseau peut remonter. Le blindage fixe la limite basse, le point le plus bas auquel il peut descendre. Sans l'un ni l'autre, la tranche ne va que de 22 000 à 23 000 m.", false],
		[1, "", "Le sous-marin [[ship/0]] démarre avec le bouclier [[equipment/18]], prévu pour 20 000 m, et le blindage [[equipment/22]], prévu pour 25 000 m : sa tranche va donc de 20 000 à 25 000 m. De meilleurs boucliers permettent de remonter plus haut, un meilleur blindage de plonger plus profond. Chaque page d'équipement indique sa valeur, et chaque page de station précise quelle valeur permet de l'atteindre. On ne peut installer qu'un seul bouclier et un seul blindage.", false],
		[1, "Hors de la tranche", "Franchir une limite déclenche une alerte. Après cinq secondes hors de la tranche, le vaisseau subit des dégâts plusieurs fois par seconde. Trop profond, la pression vide le bouclier ; trop haut, elle vide le blindage. Une fois cette couche épuisée, les dégâts touchent directement la coque.", false],
		[1, "", "Chaque coup est faible au début. Il augmente d'un point tous les 2 000 m au-dessous de 30 000 m ou au-dessus de 15 000 m : les profondeurs extrêmes usent donc vite un vaisseau.", false],
		[1, "", "Le répit de cinq secondes permet de brèves incursions, par exemple pour poursuivre une prise ou passer une station. L'accélération du temps est limitée à 2× tant que le vaisseau est hors de sa tranche.", false],
		[1, "Récupération", "Les boucliers à recharge passive ne se régénèrent que lorsque le vaisseau se trouve sous leur limite haute. Le blindage ne se rétablit pas en mer, et la coque ne se répare qu'avec le système [[equipment/43]]. Les trois sont restaurés quand le vaisseau quitte une station.", false],
		[1, "Préparer ses trajets", "Le pilote auto et le S.T.R.E.A.M. vous conduiront tout de même à une station hors de votre tranche, après un avertissement, mais l'arrivée coûte de la protection. Les contrats du tableau renvoient généralement à des stations situées dans votre tranche, mais pas toujours. Vérifiez la profondeur de la destination avant d'accepter une mission et changez d'équipement si nécessaire ; voir [[guide/fitting]].", false],
		[1, "Records de profondeur", "Les points le plus haut et le plus bas que vous atteignez sont enregistrés. La médaille [[medal/21]] récompense une remontée au-dessus de 15 000, 12 000 et 10 000 m, et une autre médaille récompense les plongées sous 30 000, 32 000 et 35 000 m. Voir [[guide/medals]].", false],
	],
	"guide/fishing": [
		[1, "Le harpon", "La pêche se pratique au harpon, qui forme son propre groupe d'armes, distinct des canons. Chaque pilote commence avec le harpon [[equipment/15]] ; les harpons [[equipment/16]] et [[equipment/17]] sont meilleurs. Un harpon a trois caractéristiques : la portée, la tolérance de capture (à quelle distance de la cible un tir doit passer pour l'accrocher) et le ralentissement (à quel point il paralyse la prise). On ne peut installer qu'un seul harpon.", false],
		[1, "", "Le harpon se tire avec sa propre commande : le bouton droit de la souris ou la gâchette gauche. Vous pouvez aussi sélectionner le groupe du harpon avec Groupe d'armes et utiliser Tirer.", false],
		[1, "Ramener une prise", "Un tir réussi accroche la créature, qui s'enfuit et se débat. Gardez-la devant le vaisseau jusqu'à ce qu'elle s'épuise. Toute créature lutte au moins 2,1 secondes, et les espèces plus robustes plus longtemps ; chaque page d'espèce indique la durée de la lutte. Un harpon au ralentissement plus élevé empêche une prise en fuite d'aller loin.", false],
		[1, "", "La prise est perdue si elle est blessée, par exemple par vos propres canons, ou si elle sort de votre champ de vision avant de céder. Appuyer de nouveau sur la commande du harpon relâche une prise accrochée.", false],
		[1, "", "Une fois maîtrisée, la créature est ramenée et hissée à bord. Elle occupe la cale selon sa masse en tonnes, et un individu peut peser un quart de plus ou de moins que la valeur de son espèce. Si la cale est trop pleine, la créature reste dans l'eau.", false],
		[1, "Algues", "Les cinq algues, depuis [[species/17]] jusqu'à [[species/13]], restent immobiles sur le fond marin. Elles cèdent presque aussitôt, ce qui en fait les prises les plus faciles.", false],
		[1, "Carcasses et épaves", "Une créature tuée par des tirs laisse une carcasse qui remonte vers la surface. Harponnée, elle donne des [[goods/18]] pesant environ un tiers de l'animal.", false],
		[1, "", "Les vaisseaux détruits laissent une épave contenant une à sept unités d'une cargaison. Harponnez l'épave pour embarquer la cargaison. Chaque épave récupérée compte pour la médaille [[medal/18]].", false],
		[1, "Vendre ses prises", "Dans une station [[faction/colonists|colon]], toute la cale est achetée à l'arrivée au prix plancher. Dans une station [[faction/rebels|rebelle]], poissons et algues peuvent être vendus au prix du marché ou servir d'ingrédients à l'atelier. Voir [[guide/trading]].", false],
		[1, "", "Les modules de cargaison augmentent la capacité de la cale ; voir [[guide/fitting]]. Les contrats [[contract/14]] paient la livraison d'un certain nombre d'individus d'une espèce, et les contrats [[contract/7]] demandent d'en capturer ou d'en tuer un certain nombre.", false],
		[1, "", "Chaque prise compte pour la médaille [[medal/5]], et de nombreuses prises en un seul trajet pour la médaille [[medal/10]]. Capturer toutes les espèces de poissons rapporte la médaille [[medal/3]], et toutes les algues la médaille [[medal/2]].", false],
	],
	"guide/fitting": [
		[1, "Emplacements", "Chaque coque possède un nombre fixe d'emplacements d'équipement, de six sur le sous-marin [[ship/0]] à dix sur les plus grandes coques, et chaque article occupe un emplacement. Les canons et les modules de cargaison peuvent être installés en plusieurs exemplaires. Tous les autres types, lance-torpilles compris, sont limités à un par vaisseau.", false],
		[1, "Types d'équipement", "Canons et torpilles : voir [[guide/combat]].", true],
		[1, "", "Harpons : capturent les créatures et récupèrent les épaves ; voir [[guide/fishing]].", true],
		[1, "", "Boucliers : absorbent les dégâts en premier et fixent la limite de profondeur haute. Certains se rechargent en mer.", true],
		[1, "", "Blindage : absorbe les dégâts après le bouclier et fixe la limite de profondeur basse ; voir [[guide/depth]].", true],
		[1, "", "Modules de cargaison : ajoutent un pourcentage de la capacité de cargaison de base de la coque. Ils se cumulent.", true],
		[1, "", "Moteurs : étendent la portée du S.T.R.E.A.M. de leur pourcentage.", true],
		[1, "", "Unités de direction : font tourner le vaisseau plus vite.", true],
		[1, "", "Radars : les capteurs du vaisseau.", true],
		[1, "", "Boosters : un surcroît de vitesse pendant quelques secondes, suivi d'une recharge.", true],
		[1, "", "Système de réparation : le modèle [[equipment/43]] répare lentement la coque en mer.", true],
		[1, "Achat et vente", "La boutique d'une station propose de deux à cinq articles, tirés selon leur rareté ; les articles rares apparaissent plus souvent à mesure que l'histoire avance. Les prix baissent avec le niveau technologique : une station de niveau 10 vend au bas de la fourchette de prix d'un article, une station de niveau 1 près du haut.", false],
		[1, "", "L'équipement se revend un cinquième moins cher que le prix de la boutique de la station. Les articles qui ont déjà eu un propriétaire sont aussi revendus un cinquième moins cher. Un module de cargaison ne peut pas être vendu si la cale ne pourrait plus contenir son chargement.", false],
		[1, "", "Deux stations sont particulières. La station [[station/28]] vend tout l'équipement et la station [[station/81]] toutes les coques, mais aucun bouclier ni blindage ne permet d'atteindre sans danger l'une ou l'autre de ces profondeurs.", false],
		[1, "Réparations", "Il n'y a pas de facture de réparation. Coque, bouclier et blindage sont remis au maximum chaque fois que le vaisseau quitte une station.", false],
		[1, "Acheter un vaisseau", "Le concessionnaire propose jusqu'à trois coques, et les plus grandes n'apparaissent qu'à mesure que l'histoire progresse. Le niveau technologique d'une station retranche autant de pour cent du prix d'une coque. Votre vaisseau actuel est repris aux quatre cinquièmes de son prix catalogue.", false],
		[1, "", "Tout l'équipement et toute la cargaison passent sur la nouvelle coque, qui doit donc avoir assez d'emplacements et de place en cale. Les chantiers navals rebelles vendent chaque coque dans sa version améliorée. Le sous-marin [[ship/10]] a un prix catalogue énorme, mais se vend 50 000 crédits une fois toutes les médailles obtenues ; voir [[guide/medals]].", false],
	],
	"guide/help": [
		[1, "", "Le sous-marin se pilote au clavier et à la souris, à la manette ou sur écran tactile, et les trois peuvent être combinés. Les touches ci-dessous sont celles par défaut ; chaque touche utilisée en mer peut être modifiée dans Paramètres › Commandes › Touches, et Paramètres › Commandes › Aide-mémoire des commandes affiche à tout moment la configuration actuelle.", false],
		[1, "Clavier et souris", "La souris fait tourner et cabrer le vaisseau, et la caméra le suit. W et S augmentent et réduisent la poussée d'un quart à chaque fois ; A et D déplacent le vaisseau latéralement (ou le font tourner, si le réglage de direction le prévoit), et les touches fléchées le font piquer ou cabrer. Maintenez Alt ou Ctrl pour regarder autour de vous à la souris sans diriger.", false],
		[1, "", "Clic gauche : tirer avec les canons.", true],
		[1, "", "Clic droit : tirer le harpon.", true],
		[1, "", "Espace : tirer avec le groupe d'armes sélectionné ; Tab bascule entre le groupe combat et le groupe pêche.", true],
		[1, "", "Q : activer ou désactiver le tir auto.", true],
		[1, "", "Shift : boost, si un booster est installé.", true],
		[1, "", "E : s'amarrer à la station droit devant, ou entrer dans le [[world/stream|S.T.R.E.A.M.]] à une porte.", true],
		[1, "", "R : appui bref pour le menu du pilote auto, appui long pour se diriger droit vers l'objectif en cours.", true],
		[1, "", "T : accélérer le temps ; des vitesses supérieures sont proposées tant que le pilote auto est aux commandes et qu'aucun danger n'est proche.", true],
		[1, "", "M : la carte. C : changer de caméra. L : phares (avec Éclairage amélioré).", true],
		[1, "", "Esc : pause, ou retour depuis n'importe quel menu. F5 sauvegarde à quai ; F11 bascule en plein écran.", true],
		[1, "", "Dans Paramètres › Commandes › Direction, la molette de la souris peut servir à régler la poussée par paliers ; S arrête alors immédiatement le vaisseau.", false],
		[1, "Manette", "Par défaut, les deux sticks dirigent : le stick gauche déplace latéralement ou fait tourner et cabrer, le stick droit fait tourner et cabrer. Chaque axe de stick peut recevoir un autre rôle, notamment la poussée ou la caméra, dans Paramètres › Commandes › Manette, où se règlent aussi l'inversion du tangage, la vibration et la zone morte.", false],
		[1, "", "Croix haut et bas : poussée. A : tirer avec le groupe d'armes sélectionné. RT : canons. LT : harpon. Clic du stick gauche : boost.", true],
		[1, "", "X : changer de groupe d'armes. Y : s'amarrer ou entrer dans le S.T.R.E.A.M. LB : menu du pilote auto. RB : accélérer le temps.", true],
		[1, "", "View : carte. Croix gauche : appui bref pour changer de caméra, maintenir pour regarder avec le stick droit. Croix droite : phares.", true],
		[1, "", "Start ou B : pause. Dans les menus, A sélectionne et B revient en arrière.", true],
		[1, "Tactile", "Les commandes tactiles s'activent d'elles-mêmes dès que l'écran est touché, ou peuvent être activées ou désactivées dans Paramètres › Commandes › Commandes tactiles. Un stick de direction apparaît sous le pouce gauche ; faire glisser le doigt ailleurs permet de regarder autour. Le grand bouton CANONS tire tant qu'il est maintenu et porte la poussée sur son pourtour : glissez le long de l'arc pour régler la vitesse. Paramètres › Commandes › Commandes tactiles › Poussée peut en faire plutôt un curseur vertical séparé au-dessus du bouton. GRAPPIN tire le harpon, BOOST active le boost, et un bouton AMARRER clignote quand l'amarrage est possible. Touchez deux fois CANONS ou GRAPPIN pour le tir auto, et touchez de nouveau pour l'arrêter.", false],
		[1, "", "TEMPS, ROUTE (le pilote auto), CARTE et PAUSE se trouvent sur les bords de l'écran ; la caméra et le plein écran sont dans le menu pause. Chaque bouton peut être déplacé et redimensionné avec Ajuster la disposition, et le vaisseau peut aussi être dirigé en inclinant l'appareil.", false],
		[1, "Écrans de station", "L'amarrage sauvegarde automatiquement la partie et ouvre l'accueil de la station, qui indique si elle appartient aux colons ou aux rebelles, son niveau technologique et les crédits du pilote. Les touches fléchées ou la croix passent d'un bouton à l'autre, Entrée ou A en ouvre un, et Esc ou B revient en arrière. PARTIR ramène dans l'eau.", false],
		[1, "", "Hangar : l'équipementier (acheter et installer, ou revendre ce qui est installé), le concessionnaire avec un modèle orientable de chaque coque et un prix de reprise pour la coque actuelle, l'atelier pour fabriquer des marchandises dans les stations rebelles, et une vue d'ensemble du vaisseau et de sa cargaison. Voir [[guide/fitting]].", true],
		[1, "", "Missions : les objectifs en cours et le journal, ainsi que le tableau des contrats une fois débloqué. Un contrat exige une caution, perdue s'il est abandonné. Voir [[guide/contracts]].", true],
		[1, "", "Carte : la carte des stations, avec recherche, vue latérale de la profondeur et boutons pour régler le pilote auto ou planifier un transfert S.T.R.E.A.M. Voir [[guide/navigation]].", true],
		[1, "", "Commerce : acheter et vendre des marchandises ; seules les stations rebelles font du commerce. Voir [[guide/trading]].", true],
		[1, "", "Statut : le vaisseau, les statistiques du pilote et les médailles. Voir [[guide/medals]].", true],
		[1, "", "Système : trois emplacements de sauvegarde, les paramètres, l'aide, cette référence, le transfert de sauvegarde, le rechargement du point de contrôle de la station et le menu principal.", true],
	],
	"guide/medals": [
		[1, "Obtenir des médailles", "Les médailles récompensent les exploits d'un pilote. La plupart existent en bronze, argent et or ; les autres sont des distinctions uniques. La progression est vérifiée à chaque amarrage, et les nouvelles médailles sont annoncées à la station. Une médaille obtenue n'est jamais perdue, et un grade supérieur remplace le précédent. Votre profil, dans Statut, affiche les médailles obtenues jusqu'ici.", false],
		[1, "Médailles de carrière", "Celles-ci comptent sur l'ensemble de la carrière (bronze, argent, or) :", false],
		[1, "", "[[medal/4]] : ennemis détruits, 50, 200 et 400.", true],
		[1, "", "[[medal/5]] : créatures capturées, 50, 150 et 300.", true],
		[1, "", "[[medal/6]] : stations où vous vous êtes amarré, 50, 100 et 200.", true],
		[1, "", "[[medal/8]] : marchandises fabriquées, 50, 250 et 500.", true],
		[1, "", "[[medal/12]] : contrats remplis, 10, 25 et 50.", true],
		[1, "", "[[medal/13]] : arrivées dans la zone d'une nouvelle station, 50, 150 et 300.", true],
		[1, "", "[[medal/14]] : pirates détruits, 25, 150 et 350.", true],
		[1, "", "[[medal/18]] : épaves récupérées, 25, 150 et 350.", true],
		[1, "", "[[medal/19]] : crédits détenus en même temps, 125 000, 500 000 et 1 000 000.", true],
		[1, "", "[[medal/20]] : nouveaux équipements achetés, 5, 10 et 20.", true],
		[1, "", "[[medal/11]] : heures de jeu, 5, 7 et 10.", true],
		[1, "", "[[medal/21]] : point le plus haut atteint, 15 000, 12 000 et 10 000 m.", true],
		[1, "Médailles d'un seul trajet", "Celles-ci jugent un seul trajet, du départ d'une station à l'amarrage à la suivante :", false],
		[1, "", "[[medal/9]] : victoires en un trajet, 5, 10 et 15.", true],
		[1, "", "[[medal/10]] : prises en un trajet, 5, 10 et 15.", true],
		[1, "", "[[medal/1]] : s'amarrer avec la coque sous 30 %, 15 % et 5 %.", true],
		[1, "", "[[medal/16]] : armes installées lors de l'amarrage, 3, 5 et 8.", true],
		[1, "", "[[medal/15]] : s'amarrer sans aucun canon installé. Les premiers chapitres ne comptent pas.", true],
		[1, "Distinctions", "La médaille [[medal/0]] est décernée à l'arrivée dans la colonie.", true],
		[1, "", "[[medal/3]] et [[medal/2]] : capturer au moins une fois chaque espèce de poisson et chaque algue.", true],
		[1, "", "[[medal/7]] : fabriquer chaque produit au moins une fois.", true],
		[1, "", "[[medal/17]] : terminer l'histoire.", true],
		[1, "", "Il existe encore deux médailles. L'une récompense les plongées sous 30 000, 32 000 et 35 000 m. L'autre est décernée pour la possession de toutes les autres médailles, et cette collection complète abaisse aussi le prix du sous-marin [[ship/10]] à 50 000 crédits. Voir [[guide/depth]] et [[guide/fitting]].", false],
	],
	"guide/navigation": [
		[1, "La carte", "Les deux cents stations sont disposées sur une carte carrée. La [[chart]] de cette encyclopédie les montre chacune à la couleur de son propriétaire. Dans le jeu, le service Carte de la station et la carte en mer affichent la même carte, avec votre itinéraire récent, les destinations de mission et les stations à portée du S.T.R.E.A.M. Chaque page de station indique ses voisines les plus proches, avec leur distance sur la carte et leur profondeur.", false],
		[1, "Pilote auto", "Le pilote auto conduit le vaisseau à votre place. Sa liste propose l'objectif en cours, l'amarrage à la station locale, la porte S.T.R.E.A.M. locale ou toute station choisie sur la carte. Sur de longues distances, il navigue en eau libre, contourne les stations sur sa route et passe de la zone d'une station à la suivante.", false],
		[1, "", "Toute commande de direction, de poussée, de boost ou d'arme rend le contrôle manuel, de même que l'option de désactivation dans la liste du pilote auto. Activer le tir auto met aussi fin au pilote auto.", false],
		[1, "", "L'accélération du temps fonctionne à 1× ou 2× en pilotage manuel et jusqu'à 16× sous pilote auto. Le danger la ramène à 2× : un vaisseau hostile à moins d'environ 550 m, une prise au bout du harpon ou une sortie de la tranche de profondeur sûre. Elle revient aussi à 1× à l'entrée dans la zone d'une nouvelle station.", false],
		[1, "Portes S.T.R.E.A.M.", "Chaque station possède une porte S.T.R.E.A.M. à une certaine distance. Entrez dans la zone d'activation de la porte et utilisez Amarrer pour ouvrir la carte de la porte, qui liste toutes les stations à portée. Choisissez-en une et lancez le transit. La porte s'ouvre et le vaisseau ressort à la porte de la station de destination, avec ses dégâts inchangés.", false],
		[1, "", "La portée d'une porte atteint environ un sixième de la largeur de la carte depuis la station actuelle. Un moteur étend cette portée selon sa valeur : un moteur à +30 % porte 30 % plus loin. Les stations hors de portée exigent plusieurs sauts, ou une longue croisière sous pilote auto.", false],
		[1, "", "Tant qu'une rencontre de mission dans la zone n'est pas terminée, ni la porte ni le quai de la station ne peuvent être utilisés.", false],
		[1, "Arrivée", "Entrer dans la zone d'une station déclenche toute rencontre de mission qui y attend. L'option objectif du pilote auto mène aux points de passage de la rencontre, et l'amarrage se déverrouille une fois celle-ci résolue. Voir [[guide/contracts]].", false],
		[1, "", "Sinon, les eaux autour d'une station abritent sa faune locale et ses vaisseaux de patrouille. À partir du [[chapter/12|chapitre 12]], quelques pirates peuvent s'y tenir en embuscade, de plus en plus souvent à mesure que l'histoire avance. Voir [[guide/combat]].", false],
		[1, "", "Chaque arrivée dans la zone d'une nouvelle station compte pour la médaille [[medal/13]], et chaque station où vous vous amarrez pour la première fois pour la médaille [[medal/6]].", false],
	],
	"guide/tips": [
		[1, "", "De courts conseils pour naviguer, combattre et gagner de l'argent, réunis pour cette référence.", false],
		[1, "En mer", "Maintenir la touche du pilote auto (R) mène tout droit à l'objectif en cours ; un appui bref propose d'autres destinations, comme la porte S.T.R.E.A.M. la plus proche ou une station choisie sur la carte.", true],
		[1, "", "Le temps peut être bien plus accéléré quand le pilote auto est aux commandes qu'en pilotage manuel, tant qu'aucun ennemi n'est proche.", true],
		[1, "", "Toute action de direction, de poussée ou de tir reprend les commandes au pilote auto.", true],
		[1, "", "Le boost ne fonctionne qu'avec un booster installé, et il lui faut du temps pour se recharger après chaque utilisation.", true],
		[1, "", "La carte signale les stations situées hors des limites de profondeur de la coque ; une coque ou un bouclier plus résistant les rend accessibles. Voir [[guide/depth]].", true],
		[1, "", "Le regard libre (Alt ou Ctrl avec la souris, ou croix gauche maintenue) permet de surveiller l'arrière du vaisseau sans changer de cap.", true],
		[1, "Combat et pêche", "Canons et harpon se tirent avec des boutons distincts : on peut donc harponner un poisson en plein combat.", true],
		[1, "", "Le tir auto maintient le feu des armes sélectionnées pendant que les deux mains dirigent ; il s'arrête à l'ouverture d'un menu.", true],
		[1, "", "L'Arrêt sur image du menu pause fige la scène pour que la caméra puisse s'y déplacer librement.", true],
		[1, "Commerce et argent", "Seules les stations rebelles ont un marché ou un atelier ; les stations des colons vendent tout de même de l'équipement.", true],
		[1, "", "L'atelier transforme la cargaison en produits ; comparez la fourchette de prix de la recette avec le marché avant de fabriquer une soute entière.", true],
		[1, "", "Un nouveau vaisseau coûte moins cher qu'il n'y paraît : l'actuel est repris en échange.", true],
		[1, "", "La caution d'un contrat est perdue s'il est abandonné ; vérifiez donc d'abord sa profondeur et sa distance.", true],
		[1, "Sauvegarde", "L'amarrage sauvegarde automatiquement, et l'écran Système offre trois emplacements supplémentaires. F5 sauvegarde à quai.", true],
		[1, "", "Recharger le point de contrôle ramène au dernier amarrage si une plongée tourne mal.", true],
		[1, "", "Les phares nécessitent le réglage Éclairage amélioré ; il permet ensuite d'allumer et d'éteindre les phares avec L.", true],
	],
	"guide/trading": [
		[1, "Où se fait le commerce", "Seules les stations [[faction/rebels|rebelles]] ont un marché et un atelier. Les stations [[faction/colonists|colons]] achètent toute la cale à l'arrivée, chaque article à son prix plancher, et ne vendent rien. Au début de l'histoire, toutes les stations sont colons : la pêche à prix fixe est donc le seul revenu jusqu'à l'ouverture des marchés. Voir [[guide/allegiance]].", false],
		[1, "Prix", "Chaque marchandise a une fourchette de prix, une station d'origine et un meilleur marché, tous indiqués sur sa page. Dans sa station d'origine, une marchandise se vend à son prix plancher. Plus une station est éloignée de la station d'origine sur la carte, plus le prix est élevé, jusqu'au plafond atteint à la distance du meilleur marché et au-delà.", false],
		[1, "", "Trois importations fonctionnent à l'inverse : [[goods/33]], [[goods/34]] et [[goods/35]] sont les moins chères à leur meilleur marché et plus chères à mesure qu'on s'en éloigne. Les marchés rebelles se réapprovisionnent entre deux visites.", false],
		[1, "", "Un marché achète et vend au même prix, une unité à la fois. Le profit vient du transport des marchandises entre stations, pas du comptoir.", false],
		[1, "Ce que proposent les marchés", "Un marché propose jusqu'à quatre produits. Chacun doit correspondre au niveau technologique de la station, et les produits apparaissent plus facilement près de leur station d'origine. Les rayons se vident un peu entre deux visites. Les trois stations visitées le plus récemment conservent leur stock ; ailleurs, les rayons sont tirés à nouveau à votre retour.", false],
		[1, "Fabrication", "L'atelier du hangar transforme les ingrédients de la cale en produits. Une station peut fabriquer tout produit jusqu'à son propre niveau technologique. La liste des recettes indique combien d'unités de chaque produit la cale permet de fabriquer ; chaque page de produit liste ses ingrédients. Par exemple, une unité de [[goods/21]] demande une unité de [[species/4]] et une unité de [[species/17]].", false],
		[1, "", "Fabriquer des marchandises compte pour la médaille [[medal/8]], et fabriquer chaque produit au moins une fois rapporte la médaille [[medal/7]].", false],
		[1, "Faire du profit", "Quelques façons de gagner de l'argent :", false],
		[1, "", "Achetez des produits dans leur station d'origine ou à proximité, et transportez-les vers leur meilleur marché.", true],
		[1, "", "Poissons et algues ne coûtent que du temps. Les transformer en produits peut rapporter plus que de les vendre bruts.", true],
		[1, "", "Ne vous amarrez pas à une station colon avec une cale de valeur : tout ce qui est à bord est pris au prix plancher.", true],
		[1, "", "Récupérez la cargaison laissée par les vaisseaux détruits et vendez-la.", true],
		[1, "", "Les contrats [[contract/13]] et [[contract/14]] paient la livraison d'un produit ou d'une prise à la station qui les a publiés.", true],
		[1, "", "Le niveau technologique d'une station réduit aussi ses prix d'équipement et de vaisseaux ; voir [[guide/fitting]].", false],
	],
	"home": [
		[1, "", "Bienvenue dans l'encyclopédie de DEEP, une aventure sous-marine sur un monde océanique colonisé. Vous pouvez y consulter les deux cents stations des grands fonds, les vaisseaux et équipements à acheter, les créatures qui peuplent l'eau, les marchandises échangées entre marchés, les contrats proposés et les médailles à gagner.", false],
		[1, "", "Les pages de l'histoire s'ouvrent au fil du jeu. Chapitres, personnages et événements ultérieurs restent masqués tant que votre sauvegarde ne les a pas atteints : vous pouvez donc parcourir l'encyclopédie sans divulgâcher. Les noms et les chiffres proviennent de votre propre exemplaire du jeu ; les présentations et les guides sont rédigés pour cette encyclopédie.", false],
		[1, "", "Les nouveaux pilotes commenceront par [[world/ocean]] et [[guide/basics]]. La [[chart]] montre toutes les stations et le camp qui les tient. Chaque guide explique un aspect de la vie sous la surface, de [[guide/depth]] et [[guide/navigation]] à [[guide/trading]] et [[guide/combat]].", false],
	],
	"intro/characters": [
		[1, "", "Ces pages décrivent les personnages de l'histoire : le pilote, l'ordinateur de bord, les alliés et ennemis rencontrés en chemin, et les voix entendues à la radio. Chaque biographie suit la campagne dans l'ordre et s'enrichit au fil de la partie, en ne montrant que ce que votre pilote a déjà appris.", false],
		[1, "", "Certains interlocuteurs n'ont pas de nom propre. Des noms de rôle comme [[character/6]], [[character/7]] et [[character/10]] désignent les nombreuses voix secondaires de chaque faction, et leurs pages expliquent qui parle sous ces noms. Pour l'histoire dans son ensemble, voir [[world/history]].", false],
	],
	"intro/contracts": [
		[1, "", "Les quinze types de missions qu'une station peut proposer. Chaque page précise l'objectif, le camp qui la propose, les éventuelles restrictions et les chapitres de l'histoire fondés sur le même type de mission. Voir [[guide/contracts]] pour les cautions, la rémunération et l'évolution de la difficulté selon votre rang. Les contrats apparaissent sur le tableau à partir du [[chapter/9|chapitre 9]].", false],
	],
	"intro/equipment": [
		[1, "", "Tout l'équipement qui peut être installé sur un vaisseau : armes, torpilles, harpons, boucliers, blindages, modules de cargaison, moteurs, direction, radars, boosters et systèmes de réparation. Chaque page indique les caractéristiques de l'article, sa rareté en boutique, s'il peut être installé en plusieurs exemplaires et son prix à chaque niveau technologique. Voir [[guide/fitting]] et [[guide/combat]].", false],
	],
	"intro/factions": [
		[1, "", "Les puissances de l'océan : les [[faction/colonists]], les [[faction/rebels]] et les [[faction/pirates]]. Chaque page explique l'influence de la faction sur le jeu, comme le commerce, les contrats et les primes, et liste ses stations et ses apparitions dans l'histoire jusqu'à votre chapitre actuel. Voir [[guide/allegiance]] pour savoir comment les stations changent de camp.", false],
	],
	"intro/goods": [
		[1, "", "Tout ce qui peut être transporté en cale : prises, produits, importations et objets récupérés. Chaque page indique le niveau technologique de la marchandise, sa station d'origine, son meilleur marché et sa fourchette de prix, sa recette ou ce dans quoi elle entre, ainsi que d'éventuelles règles particulières. Voir [[guide/trading]] pour comprendre les prix et réaliser des bénéfices.", false],
	],
	"intro/guide": [
		[1, "", "Des guides pratiques pour jouer à DEEP. Commencez par [[guide/basics]], puis lisez [[guide/depth]], [[guide/navigation]], [[guide/fishing]], [[guide/trading]], [[guide/combat]], [[guide/fitting]], [[guide/contracts]], [[guide/allegiance]] et [[guide/medals]]. Chaque guide explique simplement un aspect de la vie sous la surface, avec les chiffres utilisés par le jeu lui-même, et renvoie aux stations, équipements et médailles qu'il mentionne. Les détails de l'histoire restent masqués tant que votre sauvegarde ne les a pas atteints.", false],
	],
	"intro/medals": [
		[1, "", "Les médailles qu'un pilote peut gagner. Chaque page décrit ce que récompense la médaille et, pour les médailles à grades, ce qu'il faut pour le bronze, l'argent et l'or. Voir [[guide/medals]] pour savoir quand les médailles sont vérifiées et lesquelles jugent un seul trajet. Les médailles sont vérifiées à chaque amarrage, et une collection complète apporte sa propre récompense.", false],
	],
	"intro/ships": [
		[1, "", "Toutes les coques de sous-marin du jeu, de la coque de départ, [[ship/0]], jusqu'à la coque [[ship/10]]. Chaque page indique la résistance de la coque, la capacité de cargaison, les emplacements d'équipement, la direction et le prix catalogue, le moment où les chantiers navals commencent à la proposer, ainsi qu'un tableau comparatif de toutes les coques. Voir [[guide/fitting]] pour acheter un vaisseau et faire reprendre l'ancien.", false],
	],
	"intro/species": [
		[1, "", "Les créatures et les algues de l'océan. Chaque page indique la masse de l'espèce, sa résistance, la durée de sa lutte au bout du harpon, sa fourchette de prix et les stations où elle vit, ainsi que les produits et les contrats qui l'utilisent. Voir [[guide/fishing]] pour savoir comment les capturer.", false],
	],
	"intro/stations": [
		[1, "", "Les deux cents stations de l'océan, par ordre alphabétique. Chaque page indique le niveau technologique de la station, sa profondeur et sa position sur la carte, le camp qui la tient, l'équipement de profondeur nécessaire pour l'atteindre, les espèces présentes à proximité, les marchandises dont elle est la station d'origine ou le meilleur marché, son rôle dans l'histoire et ses voisines les plus proches. La [[chart]] les montre toutes à la fois.", false],
	],
	"intro/story": [
		[1, "", "L'histoire de la campagne s'étend sur 48 chapitres, depuis la première prise du pilote. Pour un récit continu de l'intrigue, découpé en actes, lisez [[world/history]]. Ce récit s'enrichit au fil de la partie et ne va jamais au-delà du chapitre atteint par votre sauvegarde.", false],
		[1, "", "Chaque chapitre a aussi sa propre page, avec un synopsis de la mission et, une fois le chapitre passé, son dénouement. La fin d'un chapitre n'apparaît que lorsque vous atteignez le suivant : ces pages ne révèlent donc jamais plus que ce que vous avez déjà joué.", false],
	],
	"intro/world": [
		[1, "", "Le contexte de l'univers de DEEP. [[world/ocean]] décrit le cadre lui-même : ses profondeurs et sa pression, sa lumière et sa faune. [[world/colony]] explique comment les stations sont gérées, comment fonctionnent le commerce et les contrats, et qui fait régner l'ordre. [[world/stream]] présente le réseau de portes qui relie les stations, et [[world/history]] raconte l'histoire jusqu'où vous avez joué.", false],
		[1, "", "Ces pages s'enrichissent à mesure que votre sauvegarde progresse. Les événements ultérieurs, les nouveaux personnages et les secrets des profondeurs n'apparaissent qu'une fois atteints, et d'autres articles s'ouvrent à mesure que l'histoire révèle les sujets qu'ils traitent.", false],
	],
	"medal/0": [
		[1, "", "Chaque pilote reçoit cette médaille à son arrivée sur la planète. Elle ne demande aucun effort et marque simplement le début de la carrière.", false],
	],
	"medal/1": [
		[1, "", "Décernée pour s'amarrer avec très peu de coque restante. Le bronze exige moins de 30 % de coque, l'argent moins de 15 % et l'or moins de 5 %. C'est l'état de la coque au moment de l'amarrage qui compte.", false],
	],
	"medal/10": [
		[1, "", "Décernée pour avoir ramené de nombreuses prises en une seule sortie, entre le départ et l'amarrage. Le bronze exige plus de 5 prises, l'argent plus de 10 et l'or plus de 15. Une grande cale aide.", false],
	],
	"medal/11": [
		[1, "", "Récompense le temps total passé à jouer la carrière en cours. Le bronze vient après plus de cinq heures, l'argent après sept et l'or après dix.", false],
	],
	"medal/12": [
		[1, "", "Compte les contrats des tableaux de station que le pilote a remplis. Le bronze exige plus de 10 contrats, l'argent plus de 25 et l'or plus de 50.", false],
	],
	"medal/13": [
		[1, "", "Compte les trajets effectués entre stations par le réseau S.T.R.E.A.M. Le bronze exige plus de 50 trajets, l'argent plus de 150 et l'or plus de 300.", false],
	],
	"medal/14": [
		[1, "", "Compte les pirates détruits au cours de la carrière. Le bronze exige plus de 25 pirates, l'argent plus de 150 et l'or plus de 350.", false],
	],
	"medal/15": [
		[1, "", "Décernée pour avoir effectué une sortie sans aucun canon ni torpille installés. Les harpons ne comptent pas comme des armes. Les chapitres d'initiation ne sont pas pris en compte.", false],
	],
	"medal/16": [
		[1, "", "Décernée pour s'être amarré avec de nombreux canons et torpilles installés en même temps. Le bronze exige au moins 3 armes, l'argent au moins 5 et l'or au moins 8, ce qui nécessite une coque dotée de nombreux emplacements.", false],
	],
	"medal/17": [
		[1, "", "Décernée pour avoir terminé l'histoire principale. Elle ne peut pas être obtenue autrement : c'est donc généralement l'une des dernières médailles qu'un pilote obtient.", false],
	],
	"medal/18": [
		[1, "", "Compte les caisses de cargaison récupérées au harpon sur des vaisseaux détruits. Le bronze exige plus de 25 caisses, l'argent plus de 150 et l'or plus de 350.", false],
	],
	"medal/19": [
		[1, "", "Récompense le plus haut solde de crédits atteint. Le bronze exige plus de 125 000 crédits, l'argent plus de 500 000 et l'or plus de 1 000 000.", false],
	],
	"medal/2": [
		[1, "", "Décernée pour avoir capturé au moins un spécimen de chacune des cinq espèces d'algues. Les algues restent immobiles sur le fond marin : c'est donc l'une des distinctions les plus faciles.", false],
	],
	"medal/20": [
		[1, "", "Compte les nouveaux équipements achetés en boutique. Le bronze exige plus de 5 achats, l'argent plus de 10 et l'or plus de 20.", false],
	],
	"medal/21": [
		[1, "", "Récompense la profondeur la plus faible atteinte. Le bronze exige de remonter au-dessus de 15 000 m, l'argent au-dessus de 12 000 m et l'or au-dessus de 10 000 m. Les deux niveaux supérieurs se situent au-delà de la limite nominale de tous les boucliers.", false],
	],
	"medal/22": [
		[1, "", "Récompense la plongée la plus profonde. Le bronze exige 30 000 m, l'argent 32 000 m et l'or 35 000 m. Les deux niveaux supérieurs se situent au-delà de la limite nominale de tous les blindages.", false],
	],
	"medal/23": [
		[1, "", "Décernée une fois toutes les autres médailles obtenues, quel que soit leur grade. La détenir permet au pilote d'acheter la coque [[ship/10]] pour une fraction de son prix catalogue.", false],
	],
	"medal/3": [
		[1, "", "Décernée pour avoir capturé au moins un spécimen de chaque espèce de créature nageuse. Les eaux de chaque station abritent un mélange d'espèces différent : il faut donc pêcher en de nombreux endroits.", false],
	],
	"medal/4": [
		[1, "", "Compte tous les ennemis détruits au cours de la carrière. Le bronze exige plus de 50 victoires, l'argent plus de 200 et l'or plus de 400.", false],
	],
	"medal/5": [
		[1, "", "Compte toutes les créatures et algues harponnées au cours de la carrière. Le bronze exige plus de 50 prises, l'argent plus de 150 et l'or plus de 300.", false],
	],
	"medal/6": [
		[1, "", "Décernée pour s'être amarré dans de nombreuses stations différentes. Le bronze exige plus de 50 stations, l'argent plus de 100 et l'or plus de 200, c'est-à-dire pratiquement toutes les stations de la carte.", false],
	],
	"medal/7": [
		[1, "", "Décernée une fois que le pilote a fabriqué chaque produit au moins une fois. Certaines recettes demandent des importations ou d'autres produits : la collection complète demande donc de l'organisation.", false],
	],
	"medal/8": [
		[1, "", "Compte toutes les marchandises fabriquées dans les usines des stations. Le bronze exige plus de 50 unités, l'argent plus de 250 et l'or plus de 500.", false],
	],
	"medal/9": [
		[1, "", "Décernée pour avoir détruit de nombreux ennemis en une seule sortie, entre le départ d'une station et l'amarrage à la suivante. Le bronze exige plus de 5 victoires, l'argent plus de 10 et l'or plus de 15.", false],
	],
	"ship/0": [
		[1, "Présentation", "[[ship/0]] est la coque avec laquelle chaque pilote commence, et la moins chère du catalogue à 45 000 cr. C'est aussi la plus faible à presque tous égards : 75 points de coque, une cale de 25 t et six emplacements d'équipement. Sa valeur de direction de 1,10 est moyenne, identique à celle de la coque [[ship/8]], pourtant bien plus grande.", false],
		[1, "", "Elle est livrée avec l'équipement suivant : [[equipment/15]], [[equipment/18]], [[equipment/22]] et [[equipment/35]]. Il ne reste donc que deux des six emplacements libres pour des armes ou un module de cargaison.", false],
		[1, "En service", "La petite cale est la vraie limite. Quelques prises moyennes suffisent à la remplir, et un spécimen moyen de [[species/12]] pèse plus qu'elle ne peut porter. Pour 30 000 cr de plus, [[ship/1]] offre 40 points de coque supplémentaires, presque deux fois plus de cargaison et une direction bien plus vive avec le même nombre d'emplacements ; la plupart des pilotes remplacent donc le bateau de départ dès que leurs économies le permettent. D'ici là, c'est une coque d'apprentissage : suffisante pour les premières sorties de pêche et les escarmouches légères contre les pirates près de la base, mais pas pour les longues routes commerciales ni les combats lourds.", false],
	],
	"ship/1": [
		[1, "Présentation", "[[ship/1]] est un bateau de pêche robuste et abordable. Par rapport à la coque [[ship/0]], il gagne 40 points de coque, 20 t de cargaison et une maniabilité bien supérieure : sa valeur de direction de 1,61 n'est dépassée que par celle de la coque [[ship/5]]. Il conserve toutefois les mêmes six emplacements, et ce plafond définit la coque. Un harpon, un bouclier, un blindage et un radar ne laissent de place que pour deux canons ou modules de cargaison.", false],
		[1, "En service", "Les chantiers ordinaires le vendent dès le premier chapitre à 75 000 cr, ce qui en fait la première amélioration naturelle pour un pilote qui pêche surtout et effectue de courtes missions. Il surpasse même la coque [[ship/2]], plus chère, en coque, en cargaison et en direction, et ne lui cède qu'un emplacement. Quand les missions exigent plus de puissance de feu ou une plus grande cale, les septième et huitième emplacements des coques ultérieures comptent davantage que la simple robustesse, et l'Okeanos est généralement revendu.", false],
	],
	"ship/10": [
		[1, "Présentation", "[[ship/10]] est le vaisseau amiral de luxe et la meilleure coque polyvalente. Elle réunit 200 points de coque, une cale de 100 t, dix emplacements et une direction de 1,50. Seule la coque [[ship/6]] la bat en coque ou en cargaison, et seules les coques [[ship/5]], [[ship/1]] et [[ship/3]] tournent plus vite. Son prix catalogue de 5 000 000 cr représente plus de quatorze fois celui de la coque [[ship/9]].", false],
		[1, "En service", "Les chantiers ordinaires la proposent à partir du [[chapter/40|chapitre 40]]. Peu de pilotes peuvent payer le prix catalogue. Un pilote qui détient toutes les médailles, complétant ainsi la médaille [[medal/23]], peut en revanche l'acheter pour 50 000 cr, avant la réduction habituelle liée au niveau technologique de la station. L'Aquarius est donc une récompense pour la collection complète de médailles plutôt qu'un achat pratique. Quand il devient disponible, une grande partie de la campagne est déjà derrière le pilote.", false],
	],
	"ship/2": [
		[1, "Présentation", "[[ship/2]] est la coque la moins chère à sept emplacements d'équipement, à 100 000 cr. Ses valeurs de coque et de cargaison (100 points et 40 t) sont en fait inférieures à celles de la coque [[ship/1]], et sa direction de 1,40 est bonne sans être remarquable. Le supplément paie le septième emplacement, qui peut accueillir un deuxième canon ou un module de cargaison.", false],
		[1, "En service", "Il est en vente dès le premier chapitre : un pilote qui économise tôt peut ainsi passer à sept emplacements bien avant que mieux n'apparaisse. À partir du [[chapter/5|chapitre 5]], cependant, la coque [[ship/3]] offre la même coque et le même nombre d'emplacements avec 6 t de cargaison en plus et une meilleure direction, pour seulement 5 000 cr de plus. Passé ce stade, le Triops vaut surtout la peine quand il est proposé à proximité et que l'autre ne l'est pas. Il convient à un pilote qui veut combattre les pirates tôt, puisque l'emplacement libre peut recevoir une deuxième arme.", false],
	],
	"ship/3": [
		[1, "Présentation", "[[ship/3]] affine la configuration à sept emplacements de la coque [[ship/2]]. Pour un supplément de seulement 5 000 cr, il ajoute 6 t de cale et fait passer la direction de 1,40 à 1,57, ce qui en fait l'une des coques les plus agiles du jeu. Ses 100 points de coque n'ont rien de remarquable : boucliers et blindage assurent l'essentiel de la protection.", false],
		[1, "En service", "Les chantiers ordinaires commencent à le proposer à partir du [[chapter/5|chapitre 5]]. Il convient à un pilote qui veut combattre et pêcher avec le même bateau sans grosse dépense, et reste une monture raisonnable jusqu'à l'arrivée des coques à huit emplacements. Par rapport à la coque [[ship/4]], la suivante à apparaître, il cède 75 points de coque et 24 t de cargaison en échange de virages bien plus vifs et d'un prix inférieur de 25 000 cr.", false],
	],
	"ship/4": [
		[1, "Présentation", "[[ship/4]] est un gros cargo en miniature. Il apporte 175 points de coque, une cale de 70 t et huit emplacements pour 130 000 cr, ce qui en fait la coque à huit emplacements la moins chère. Le prix à payer est la maniabilité : sa valeur de direction de 0,91 est inférieure à celle de tous les vaisseaux précédents, et seule la coque [[ship/6]] tourne plus lentement.", false],
		[1, "En service", "Il apparaît dans les chantiers ordinaires à partir du [[chapter/10|chapitre 10]]. Ce sont les marchands et les pêcheurs qui en tirent le plus. Sa grande cale de base rend aussi les modules de cargaison plus efficaces, car leur bonus est un pourcentage de la capacité de base. Un module de direction compense une partie de sa lourdeur. Les pilotes qui combattent surtout préféreront peut-être la coque [[ship/5]], qui coûte 20 000 cr de plus et tourne exactement deux fois plus vite, mais n'a qu'à peine la moitié de sa résistance.", false],
	],
	"ship/5": [
		[1, "Présentation", "[[ship/5]] est un chasseur taillé pour le combat tournoyant. Sa valeur de direction de 1,82 est la meilleure de toutes les coques, ce qui lui permet de rester derrière un adversaire et de garder une cible dans le viseur. Sa protection est cependant mince : avec 90 points, sa coque est plus faible que celle de la coque [[ship/1]], et sa cale de 40 t est modeste. Huit emplacements laissent beaucoup de place aux armes.", false],
		[1, "En service", "Les chantiers ordinaires le proposent à partir du [[chapter/15|chapitre 15]] pour 150 000 cr. Il récompense les pilotes capables d'éviter les tirs, idéalement soutenus par un bon bouclier et un bon blindage, et c'est un mauvais choix pour transporter des marchandises. Comme tous les canons installés tirent ensemble, chaque emplacement libre se traduit directement en puissance de feu. Un pilote qui veut une coque à huit emplacements plus robuste le comparera à la coque [[ship/4]] ou attendra la coque [[ship/6]].", false],
	],
	"ship/6": [
		[1, "Présentation", "[[ship/6]] est le grand vraquier. Sa cale de 180 t dépasse de loin celle de toute autre coque, presque le double de celle de la coque [[ship/10]], et ses 220 points de coque sont les plus élevés du jeu. À 170 000 cr, il est aussi moins cher que la coque [[ship/7]] et que toutes les coques suivantes. Son défaut est la maniabilité : avec une valeur de direction de 0,67, il tourne plus lentement que tout autre vaisseau.", false],
		[1, "En service", "Il arrive dans les chantiers ordinaires à partir du [[chapter/20|chapitre 20]]. Pour le commerce et les grandes sorties de pêche, il n'a pas de rival. Les modules de cargaison se calculent sur la capacité de base : un seul module à +80 % ajoute donc 144 t. Au combat, il compte sur sa capacité à encaisser plutôt qu'à esquiver, et un module de direction est presque indispensable face à des pirates agiles. Avec seulement huit emplacements, il a aussi moins de place pour les canons que les coques qui suivent.", false],
	],
	"ship/7": [
		[1, "Présentation", "[[ship/7]] est la première coque à neuf emplacements. Ses autres valeurs sont moyennes : 135 points de coque, une cale de 50 t et une direction de 1,23, meilleure que celle de la coque [[ship/0]] mais bien en deçà de celle de la coque [[ship/5]]. À 215 000 cr, il coûte nettement plus que la coque [[ship/6]] : le prix paie surtout l'emplacement supplémentaire.", false],
		[1, "En service", "Il apparaît dans les chantiers ordinaires à partir du [[chapter/25|chapitre 25]]. Il convient à un pilote qui veut un canon ou un module de plus que ne le permet une coque à huit emplacements, sans payer les vaisseaux à dix emplacements qui suivent. Comme polyvalent, il est solide mais n'excelle dans aucun domaine. La coque [[ship/8]], cinq chapitres plus tard, ajoute un dixième emplacement, 15 points de coque et 16 t de cargaison de plus pour 85 000 cr supplémentaires.", false],
	],
	"ship/8": [
		[1, "Présentation", "[[ship/8]] est la première coque à dix emplacements. Elle offre 150 points de coque et une cale de 66 t, et se dirige comme la coque [[ship/0]], avec une valeur de 1,10. À 300 000 cr, elle coûte 85 000 cr de plus que la coque [[ship/7]] pour un emplacement de plus et des gains modestes en coque et en cargaison.", false],
		[1, "En service", "Les chantiers ordinaires la proposent à partir du [[chapter/30|chapitre 30]]. Avec dix emplacements, un pilote peut installer un ensemble défensif complet, un harpon et un radar, et monter encore plusieurs canons ou un module de cargaison. Sa maniabilité n'est que moyenne ; un module de direction aide donc dans les combats rapprochés. La coque [[ship/9]], qui arrive cinq chapitres plus tard, cède 6 t de cale contre 15 points de coque de plus et une meilleure direction. Le Pontos reste le moins cher des deux et le meilleur choix quand la cargaison compte.", false],
	],
	"ship/9": [
		[1, "Présentation", "[[ship/9]] est une coque haut de gamme à dix emplacements. Par rapport à la coque [[ship/8]], elle ajoute 15 points de coque et une direction nettement plus vive (1,36 contre 1,10), mais perd 6 t de cargaison. À 350 000 cr, elle coûte 50 000 cr de plus.", false],
		[1, "En service", "Les chantiers ordinaires la proposent à partir du [[chapter/35|chapitre 35]]. Elle convient surtout à un pilote porté sur le combat en fin de campagne, qui gagne davantage à disposer de dix emplacements et d'une bonne maniabilité que d'espace en cale. Pour le commerce de vrac, la coque [[ship/6]] transporte trois fois plus pour la moitié du prix. La seule coque qui surpasse le Lir à la plupart des égards est la coque [[ship/10]], dont le prix catalogue joue dans une autre catégorie.", false],
	],
	"species/0": [
		[1, "Présentation", "[[species/0]] s'inspire des nautiles, des céphalopodes à coquille de l'Indo-Pacifique tropical. Le nautile vit dans la loge extérieure d'une coquille enroulée et règle sa flottabilité en ajustant le gaz et le liquide des loges intérieures. Il se déplace par propulsion à réaction et capture sa nourriture avec des dizaines de tentacules dépourvus de ventouses. Les nautiles restent généralement à quelques centaines de mètres de profondeur, et leur coquille peut imploser s'ils descendent nettement au-delà d'environ 800 m.", false],
		[1, "Dans le jeu", "Dans le jeu, il pèse environ 8 t et n'oppose presque aucune résistance au harpon : il ne faut que 2,1 s pour le maîtriser. C'est donc l'une des prises les plus faciles, mais son prix de 44 à 156 cr la tonne est bas. Il vit dans les eaux de 67 stations.", false],
		[7, "", "Au [[chapter/7|chapitre 7]], le pilote doit chasser ces animaux des eaux entourant [[station/1]], en les capturant ou en les tuant.", false],
	],
	"species/1": [
		[1, "Présentation", "[[species/1]] tire son nom d'Eurypharynx pelecanoides, un poisson des grands fonds que l'on trouve entre 500 et 3 000 m environ. Sa bouche, très lâchement articulée, est énorme par rapport à son corps mince en forme de fouet, et peut s'ouvrir assez grand pour engloutir des proies étonnamment grosses. Sa queue se termine par un petit organe lumineux. Les adultes mesurent généralement bien moins d'un mètre.", false],
		[1, "Dans le jeu", "Dans le jeu, c'est un nageur rapide qui résiste au harpon pendant environ 4 s, deux fois plus longtemps qu'un [[species/0]] de même masse, 8 t. L'effort paie : à 70 à 255 cr la tonne, c'est l'une des prises les mieux payées. Les usines l'utilisent pour [[goods/24]] et [[goods/27]], deux produits de valeur. Un harpon à fort ralentissement facilite beaucoup sa capture.", false],
	],
	"species/10": [
		[1, "Présentation", "[[species/10]] s'inspire des calmars et des pieuvres, des céphalopodes célèbres pour changer de couleur en une fraction de seconde. Leur peau contient des milliers de cellules pigmentaires appelées chromatophores, chacune ouverte ou fermée par de minuscules muscles, ainsi que des cellules réfléchissantes qui ajoutent des reflets chatoyants. Beaucoup possèdent aussi une poche à encre ; l'encre de seiche fut autrefois la source du pigment brun appelé sépia.", false],
		[1, "Dans le jeu", "Dans le jeu, il pèse environ 14 t, a une résistance de 28 et se débat au bout de la ligne pendant environ 3,4 s. Les prix bruts vont de 59 à 164 cr la tonne. Combiné à du solvant, il donne [[goods/22]], nécessaire pour [[goods/29]].", false],
		[19, "", "Au [[chapter/19|chapitre 19]], le pilote doit protéger un banc de ces animaux contre des vaisseaux qui l'attaquent près de la station [[station/7]].", false],
	],
	"species/11": [
		[1, "Présentation", "« Loricate » signifie couvert de plaques protectrices, et [[species/11]] évoque les tortues marines. Il en existe sept espèces aujourd'hui. Leur carapace est faite de plaques osseuses soudées à la colonne vertébrale et aux côtes. La tortue luth est la plus grande, avec une carapace pouvant atteindre environ 2 m de long, et elle peut plonger à plus de 1 000 m à la recherche de méduses. Les femelles reviennent sur les plages pour pondre.", false],
		[1, "Dans le jeu", "Dans le jeu, elle pèse environ 8 t et cède après environ 2,7 s au harpon. Son prix est inhabituellement variable, de 40 à 244 cr la tonne : il vaut donc mieux la vendre là où la demande est forte. Aucune recette d'usine ne l'utilise.", false],
	],
	"species/12": [
		[1, "Présentation", "[[species/12]] s'inspire des odontocètes, ou cétacés à dents, le groupe qui comprend les cachalots, les dauphins et les marsouins. Ils repèrent leurs proies par écholocation, en émettant des clics et en écoutant les échos. Le cachalot est le plus grand prédateur à dents de la Terre. Il plonge à 1 000 m ou plus pour chasser le calmar et peut rester sous l'eau plus d'une heure.", false],
		[1, "Dans le jeu", "Dans le jeu, c'est la créature la plus lourde, environ 30 t, avec une résistance de 60. Une seule prise peut remplir une petite cale, et un spécimen moyen ne tient pas dans la cale de 25 t de la coque [[ship/0]]. Il ne se débat qu'environ 2,9 s. Les prix varient beaucoup, de 22 à 200 cr la tonne, et aucune recette ne l'utilise.", false],
	],
	"species/13": [
		[1, "Présentation", "[[species/13]] évoque les algues dorées (Chrysophyceae) et les groupes brun doré apparentés. Leur couleur vient d'un pigment, la fucoxanthine, qui masque leur chlorophylle. La plupart sont microscopiques et vivent en eau douce, et certaines forment des proliférations ; une espèce, Prymnesium parvum, libère des toxines capables de tuer les poissons.", false],
		[1, "Dans le jeu", "Dans le jeu, comme toutes les algues, elle est fixée au fond marin, pèse toujours 2 t et se maîtrise en 2,1 s. C'est la plus précieuse des cinq algues, vendue de 27 à 65 cr la tonne. Elle entre dans [[goods/27]] et [[goods/28]].", false],
	],
	"species/14": [
		[1, "Présentation", "[[species/14]] rappelle les algues bleu-vert, ou cyanobactéries. Ce ne sont pas à proprement parler des algues, mais des bactéries photosynthétiques. Elles comptent parmi les plus anciennes formes de vie connues et ont contribué à remplir l'atmosphère terrestre d'oxygène. Certaines fixent l'azote de l'air, et certaines peuvent libérer de l'hydrogène, ce qui explique que des chercheurs les étudient comme source de carburant propre.", false],
		[1, "Dans le jeu", "Dans le jeu, elle pousse sur le fond marin, pèse 2 t et oppose peu de résistance. Elle se vend de 21 à 47 cr la tonne. Fort à propos, on la combine avec [[goods/18]] pour obtenir [[goods/19]], et c'est l'une des cinq algues nécessaires pour [[goods/28]].", false],
	],
	"species/15": [
		[1, "Présentation", "[[species/15]] représente les algues brunes (Phaeophyceae), qui comprennent les laminaires. Le varech géant peut atteindre plusieurs dizaines de mètres de haut et forme des forêts sous-marines qui abritent de nombreuses autres espèces. Les algues brunes sont une source commerciale d'alginates, utilisés pour épaissir les aliments et en médecine.", false],
		[1, "Dans le jeu", "Dans le jeu, c'est la prise la moins chère de toutes, de 14 à 47 cr la tonne. Comme les autres algues, elle reste immobile sur le fond marin, pèse 2 t et se maîtrise en 2,1 s. Sa seule utilisation est dans [[goods/28]], qui exige chacune des cinq algues.", false],
	],
	"species/16": [
		[1, "Présentation", "[[species/16]] renvoie aux algues rouges (Rhodophyta). Un pigment rouge, la phycoérythrine, leur permet d'absorber la lumière bleue, celle qui pénètre le plus loin dans la mer : elles poussent donc plus profond que toutes les autres algues. Les algues rouges nous donnent l'agar-agar et les carraghénanes, et le nori qui enveloppe les sushis est une algue rouge.", false],
		[1, "Dans le jeu", "Dans le jeu, c'est la deuxième algue la plus précieuse, valant de 27 à 62 cr la tonne. Elle se dresse sur le fond marin, pèse 2 t et se harponne facilement. Elle entre dans [[goods/27]] avec [[species/13]] et est aussi nécessaire pour [[goods/28]].", false],
	],
	"species/17": [
		[1, "Présentation", "[[species/17]] représente les algues vertes, les plus proches parentes des plantes terrestres. La laitue de mer (Ulva) en est un exemple familier sur les côtes. Certaines algues vertes se mangent ; au Japon, des paillettes séchées appelées aonori sont saupoudrées sur les plats. Les algues vertes ont besoin de beaucoup de lumière, et la plupart poussent donc en eau peu profonde.", false],
		[1, "Dans le jeu", "Dans le jeu, c'est une prise de faible valeur, de 20 à 44 cr la tonne. Comme les autres algues, elle est fixée au fond, pèse 2 t et se maîtrise en 2,1 s. Les usines la combinent avec [[species/4]] pour fabriquer [[goods/21]], et c'est l'une des cinq algues de [[goods/28]].", false],
	],
	"species/2": [
		[1, "Présentation", "[[species/2]] représente les méduses, le stade nageur libre de nombreux cnidaires. Une méduse n'a ni cerveau, ni os, ni sang, et son ombrelle est faite surtout d'eau. Elle se déplace en contractant son ombrelle et dérive avec le courant, capturant de petites proies grâce à des tentacules armés de cellules urticantes. Certaines espèces sont luminescentes, et plusieurs formes des grands fonds sont rouges ou violettes.", false],
		[1, "Dans le jeu", "Avec environ 2 t, c'est l'une des créatures les plus légères du jeu, et sa résistance de 4 signifie qu'un seul tir perdu peut la tuer. Au harpon, elle cède après environ 2,5 s. Les prix vont de 40 à 133 cr la tonne. Sa seule utilisation en fabrication est comme l'un des trois ingrédients de [[goods/26]].", false],
	],
	"species/3": [
		[1, "Présentation", "[[species/3]] s'inspire des raies manta, les plus grandes raies du monde. Les plus grandes espèces océaniques peuvent atteindre environ 7 m d'envergure. Les mantas sont de paisibles filtreurs : elles nagent la bouche ouverte et utilisent deux lobes charnus placés devant la bouche pour y diriger le plancton. Elles possèdent l'un des plus gros cerveaux, par rapport à la taille du corps, de tous les poissons.", false],
		[1, "Dans le jeu", "Dans le jeu, elle pèse environ 16 t et a une résistance de 32 : elle survit donc mieux aux tirs rasants que les petits animaux. Elle se débat au bout de la ligne pendant environ 3,6 s. Ses prix bruts de 65 à 182 cr la tonne sont modérés, mais c'est la créature nécessaire pour [[goods/20]], qui entre à son tour dans [[goods/29]].", false],
	],
	"species/4": [
		[1, "Présentation", "[[species/4]] désigne les bancs serrés que forment de petits poissons comme les sardines, les anchois et les harengs. Le banc désoriente les prédateurs, qui peinent à isoler une cible, et permet peut-être aussi d'économiser de l'énergie, chaque poisson nageant dans le sillage des autres. Ces bancs sont à la base de nombreuses chaînes alimentaires marines et des plus grandes pêcheries du monde.", false],
		[1, "Dans le jeu", "Dans le jeu, un banc se capture comme une seule charge de 4 t. C'est une prise peu exigeante : le harpon le maîtrise en environ 2,5 s, et sa résistance n'est que de 8. Les prix vont de 53 à 138 cr la tonne. C'est un ingrédient de [[goods/21]] et de [[goods/26]] : un pilote qui capture aussi [[species/17]] ou [[species/2]] dispose ainsi d'une chaîne d'approvisionnement toute prête.", false],
	],
	"species/5": [
		[1, "Présentation", "[[species/5]] renvoie aux baudroies, et en particulier aux espèces des grands fonds. Une épine modifiée sur la tête forme une canne terminée par un leurre. Chez de nombreuses formes abyssales, ce leurre brille grâce à une lumière produite par des bactéries symbiotiques, attirant les proies près d'une large bouche. Chez certaines espèces, les minuscules mâles fusionnent définitivement avec les femelles, bien plus grandes.", false],
		[1, "Dans le jeu", "Dans le jeu, elle pèse environ 10 t et cède au harpon après environ 2,5 s : c'est une prise assez rapide. Sa fourchette de prix, de 53 à 216 cr la tonne, est large. Avec [[species/1]] et du solvant, elle est nécessaire pour [[goods/24]], un intrant clé de plusieurs produits de grande valeur.", false],
	],
	"species/6": [
		[1, "Présentation", "« Devilfish » (poisson-diable) est un vieux nom de marin anglais. Au fil des siècles, il a désigné les mantes du genre Mobula, de grandes pieuvres et même la baleine grise. Le jeu ne rattache [[species/6]] à aucun de ces animaux en particulier. Ce qu'ils ont en commun, c'est une grande taille et une réputation effrayante qui correspond rarement à leur comportement réel.", false],
		[1, "Dans le jeu", "Dans le jeu, c'est une prise lourde d'environ 20 t, avec une résistance de 40. Elle résiste au harpon pendant environ 4,2 s, l'une des luttes les plus longues de toutes les créatures. Elle atteint aussi le prix plafond le plus élevé de toutes les créatures, jusqu'à 364 cr la tonne. Les usines l'associent à [[species/8]] et à du sel pour fabriquer [[goods/25]].", false],
	],
	"species/7": [
		[1, "Présentation", "[[species/7]] s'inspire des marlins, de grands poissons à rostre des océans chauds. Le marlin se sert de son rostre en forme de lance pour fendre les bancs de proies et compte parmi les poissons les plus rapides de la mer. Les plus grands makaires bleus dépassent 4 m de long et plusieurs centaines de kilos. Les pêcheurs sportifs les recherchent pour leurs longs combats acrobatiques.", false],
		[1, "Dans le jeu", "Dans le jeu, il est léger, environ 8 t, mais difficile à capturer : il nage vite et résiste au harpon pendant environ 4,2 s. Un harpon à longue portée et à fort ralentissement facilite la tâche. En contrepartie, il garde bien sa valeur et se vend de 104 à 283 cr la tonne, le prix plancher le plus élevé de toutes les créatures. C'est l'ingrédient principal de [[goods/23]].", false],
	],
	"species/8": [
		[1, "Présentation", "« Bone shark » est un ancien nom anglais du requin pèlerin, le deuxième plus grand poisson vivant après le requin-baleine. Le requin pèlerin peut atteindre environ 8 m, voire davantage. Malgré sa taille, c'est un filtreur inoffensif qui croise lentement près de la surface, son immense bouche ouverte pour filtrer le plancton. Il migre sur de longues distances et passe souvent l'hiver en eaux plus profondes.", false],
		[1, "Dans le jeu", "Dans le jeu, [[species/8]] pèse environ 18 t et a une résistance de 36. Il résiste au harpon pendant environ 3,8 s. Les prix vont de 78 à 208 cr la tonne. C'est l'une des prises les plus utiles pour la fabrication, puisqu'il entre à la fois dans [[goods/25]] et dans [[goods/26]].", false],
	],
	"species/9": [
		[1, "Présentation", "Aucun animal réel ne s'appelle crevette goliath, mais de vrais géants existent. La crevette géante tigrée peut atteindre environ 30 cm, et certains crustacés des grands fonds sont plus grands que leurs cousins des eaux peu profondes, un phénomène appelé gigantisme abyssal. Beaucoup de crevettes des grands fonds sont rouges, ce qui les rend presque invisibles dans une eau où la lumière rouge ne pénètre pas.", false],
		[1, "Dans le jeu", "Dans le jeu, [[species/9]] est une petite prise de 2 t, d'une résistance de 4, vite maîtrisée en environ 2,3 s. Les prix vont de 39 à 122 cr la tonne. Aucune recette d'usine ne l'utilise : on la capture uniquement pour la vendre. Les contrats de pêche la demandent plus souvent que des créatures plus rares comme [[species/0]].", false],
	],
	"world/abel": [
		[31, "", "[[world/abel]] est un scientifique qui travaille avec la [[faction/rebels|résistance]]. Il n'apparaît jamais à l'écran, mais ses recherches sont au cœur du plan de [[character/2]] : construire une arme capable de retourner la guerre contre la colonie.", false],
		[31, "Contexte", "Le professeur a consacré de nombreuses années au [[world/biotek]], une source d'énergie que personne n'avait réussi à construire. Il était sur le point d'achever un prototype fonctionnel quand les colons le lui ont volé, et ils tentent désormais de le terminer eux-mêmes.", false],
		[31, "Rôle dans l'histoire", "[[character/2]] le fait venir à [[station/14]] avec son équipe pour construire la nouvelle arme des rebelles. Ce sont manifestement les scientifiques dont le pilote a protégé le convoi en chemin ([[chapter/29]]). [[character/2]] part aussitôt le rejoindre pendant que le pilote et d'autres récupèrent le générateur ([[chapter/30]]).", false],
		[33, "", "Après le raid, le professeur emporte les conteneurs récupérés dans son laboratoire pour poursuivre le travail sur le prototype ([[chapter/32]]).", false],
		[39, "", "Ses travaux avancent vite. Le prototype est bientôt presque achevé, et il ne manque plus qu'une pièce : un [[goods/36]], qui multiplie l'ADN de particules d'algues pour lancer la réaction en chaîne qui produit l'énergie. [[character/2]] transmet son explication tout en reconnaissant ne pas la comprendre entièrement. L'appareil ne peut être fabriqué qu'à [[station/16]] ([[chapter/38]]).", false],
		[42, "", "Quand l'incubateur arrive à [[station/14]], il a tout préparé pour l'installer, et l'arme terminée est attendue au hangar sous peu. Le générateur n'étant encore qu'un prototype, le pilote est invité à la prudence ([[chapter/41]]).", false],
		[44, "", "L'[[world/eclipse|Eclipse]] alimenté par son générateur se révèle décisif lors de l'attaque des colons contre [[station/14]].", false],
		[31, "Personnalité", "Tout ce que l'on sait de lui vient de [[character/2]] et de [[character/5]]. Il est décrit comme un chercheur dévoué.", false],
		[39, "", "Ses explications sont si techniques que même [[character/2]] peine à les répéter.", false],
	],
	"world/aquarians": [
		[10, "", "Les Aquariens sont des êtres des grands fonds, que l'on dit mi-humains mi-poissons. « Aquariens » est le nom que leur donnent les colons, et la colonie les considère comme des nuisibles. Ils sont surtout connus pour attaquer les capsules de transport qui envoient les exportations de la colonie en orbite. Qui ils sont et ce qu'ils veulent, c'est l'une des questions auxquelles l'histoire répond peu à peu.", false],
		[10, "Nature", "Au début, on sait peu de choses des Aquariens. Ils vivent en eaux libres et se déplacent comme des animaux marins plutôt que comme des machines, et pourtant ils combattent avec leurs propres armes. Les colons les traitent comme des animaux dangereux et ne se demandent jamais pourquoi ils attaquent.", false],
		[11, "", "Après le premier combat du pilote contre eux, [[character/1]] se demande s'ils ne sont pas bien plus intelligents qu'on ne l'a supposé. Le pilote commence aussi à se demander pourquoi ils visent les capsules.", false],
		[19, "", "D'autres rencontres laissent penser qu'ils prennent soin de la faune de l'océan. On les voit nager aux côtés d'un banc de [[species/10|pieuvres]] que des colons tentent de capturer, comme pour le protéger.", false],
		[45, "", "Ils sont intelligents et capables de diplomatie. Un émissaire aquarien vient à [[station/14]] et semble comprendre un peu la langue des humains.", false],
		[10, "Relations avec la colonie", "Les lancements de capsules relient la colonie à l'économie extérieure, et les Aquariens les frappent sans relâche. Chaque capsule endommagée ou perdue nuit à l'image de la station auprès de l'administration commerciale ; les colons engagent donc des pilotes armés pour repousser les assaillants. La défense de capsules est aussi un contrat colon courant ; voir [[contract/11]].", false],
		[10, "", "Au [[chapter/10|chapitre 10]], le pilote est envoyé à [[station/2]] pour défendre un lancement de capsules, avec pour consigne de [[character/9]] de ne tolérer qu'une poignée de pertes.", false],
		[11, "", "Rien n'indique que la colonie ait jamais tenté de parler aux Aquariens. Elle se contente de payer pour qu'on les chasse ou qu'on les tue.", false],
		[13, "Relations avec les rebelles", "Quand les [[faction/rebels]] dénoncent l'exploitation menée par la colonie, ils parlent des habitants de la planète autant que de ses ressources. Les Aquariens sont peut-être de ceux qu'ils visent, mais pendant longtemps il n'existe aucun contact entre eux.", false],
		[19, "", "Rebelles et Aquariens partagent le souci de protéger les animaux de l'océan. Quand le pilote protège les pieuvres près de [[station/7]], [[character/1]] suggère que les Aquariens pourraient devenir des alliés.", false],
		[44, "", "Le tournant survient lors de l'attaque des colons contre [[station/14]] au [[chapter/43|chapitre 43]]. Alors que les quais de la station sont touchés et les défenseurs en infériorité numérique, un groupe d'Aquariens arrive et attaque les colons, renversant la bataille. [[character/9]] et ses forces sont mis en déroute.", false],
		[45, "", "Après la bataille, l'émissaire présent à Fiir explique que les Aquariens sont prêts à combattre la domination des colons. [[character/2]] espère qu'une fois la colonie vaincue, humains et Aquariens pourront vivre en harmonie avec l'océan. Avec leur aide, les rebelles préparent deux offensives finales.", false],
		[45, "", "Au [[chapter/45|chapitre 45]], un groupe d'Aquariens remonte des profondeurs pour se joindre au pilote et à l'escadron de [[character/12]] dans l'assaut contre [[station/18]].", false],
		[47, "", "Les deux offensives réussissent, et les commandants rebelles attribuent aux Aquariens une grande part de la victoire.", false],
		[48, "", "Une fois la colonie disparue, l'alliance entre les rebelles et les Aquariens tient toujours à la fin de l'histoire, avec la promesse de laisser l'océan se rétablir.", false],
		[45, "Questions ouvertes", "Bien des choses concernant les Aquariens ne sont jamais expliquées. L'histoire ne dit pas où ils vivent, combien ils sont, comment ils fabriquent ou utilisent leurs armes, ni comment ils en sont venus à comprendre la langue des humains. Elle laisse aussi ouverte la question de savoir pourquoi ils s'en prenaient spécialement aux capsules de la colonie, même si leur alliance ultérieure avec les rebelles suggère qu'ils voyaient dans les exportations une part du pillage de leur océan.", false],
		[10, "Dans le jeu", "Au combat, les Aquariens apparaissent comme des combattants pisciformes qui tirent des décharges d'énergie. Ils virent plus lentement que les sous-marins et n'utilisent jamais de pointes de vitesse. Un Aquarien détruit meurt comme une créature marine, en une seule explosion, et ne laisse ni épave à récupérer ni prise à capturer.", false],
		[10, "", "Dans le camp de la colonie, les Aquariens sont l'ennemi des missions de défense de capsules. Ils foncent droit sur les capsules, et le défenseur doit donc les traquer rapidement. La mission échoue si trop de capsules sont perdues. Détruire des Aquariens compte comme une victoire au combat, mais pas pour la prime aux pirates.", false],
		[44, "", "Dans les derniers chapitres, ils combattent aux côtés du pilote en tant qu'alliés. Ils apparaissent comme des contacts amis sur le radar et attaquent les vaisseaux colons.", false],
	],
	"world/biotek": [
		[31, "", "Le générateur Biotek est une source d'énergie expérimentale mise au point par le [[world/abel|professeur Abel]]. C'est la clé du plan des rebelles pour surclasser les colons en puissance de feu. Les rebelles comptent s'en servir pour alimenter une arme trop gourmande en énergie pour un sous-marin ordinaire, et sa récupération est la première des trois étapes de ce plan. Le générateur lui-même n'est jamais vendu ni installé comme équipement ; en jeu, le pilote manipule les pièces dont il a besoin.", false],
		[31, "Recherche et vol", "La technologie du générateur est étudiée depuis des années sans que personne n'ait produit de prototype fonctionnel. Le professeur Abel était sur le point d'en achever un quand les colons le lui ont volé. Ils tentent désormais de le terminer eux-mêmes, ce que les rebelles sont résolus à empêcher.", false],
		[31, "", "Peu avant de dévoiler le plan, [[character/2]] a organisé le voyage d'un groupe de scientifiques de très haut niveau vers [[station/14]]. Au [[chapter/29|chapitre 29]], le pilote a escorté leur convoi sans encombre à travers la région frontalière près de [[station/13]].", false],
		[31, "", "À Fiir, Ayumi explique le rôle des scientifiques : ce sont les membres de l'équipe d'Abel. Ensemble, ils vont faire du générateur le cœur d'une nouvelle arme.", false],
		[31, "Le plan en trois étapes", "Ayumi expose le plan en trois étapes. D'abord, les rebelles doivent récupérer le générateur. Ensuite, il leur faut une arme assez puissante pour mériter un tel générateur. Elle n'explique pas encore la troisième étape.", false],
		[31, "", "Selon l'un des informateurs d'Ayumi, le générateur volé voyage dans un convoi colon ordinaire, à destination d'un lieu appelé Maarth. Comme personne ne sait quel vaisseau le transporte, le pilote, [[character/5]] et [[character/4]] doivent arrêter tout le convoi près de [[station/2]] et récupérer chaque conteneur.", false],
		[32, "", "Le raid réussit et tous les conteneurs sont récupérés, même si les équipages colons protestent qu'ils ne transportent que des vivres et des médicaments.", false],
		[33, "", "De retour à Fiir, Abel emporte la cargaison saisie dans son laboratoire pour achever le prototype. Pendant ce temps, le pilote part chercher l'arme de la deuxième étape, l'[[world/eclipse|Eclipse]].", false],
		[39, "Fonctionnement", "Le générateur tire son énergie de la matière vivante. Un incubateur à polymérase copie l'ADN de particules d'algues, et cette copie déclenche une réaction en chaîne qui libère de l'énergie. Le prototype a encore besoin de cet incubateur, le [[goods/36]], pour fonctionner.", false],
		[39, "", "Une seule station dispose de l'équipement nécessaire pour le construire : [[station/16]], la plus avancée de l'océan. La troisième étape du pilote consiste à s'y rendre et à produire l'incubateur.", false],
		[42, "", "Une fois l'incubateur livré à Fiir, Abel achève l'installation, et le générateur alimente l'Eclipse monté sur le vaisseau du pilote. Les rebelles rappellent qu'il ne s'agit encore que d'un prototype.", false],
		[44, "", "Il tient bon au combat. Quand les colons attaquent Fiir, l'Eclipse, alimenté par le générateur, contribue à renverser la bataille. [[character/9]] est visiblement ébranlé de trouver ce canon sur un sous-marin.", false],
		[45, "", "Une fois [[station/188]] aux mains des rebelles, ceux-ci entreprennent d'équiper autant d'unités que possible du même couple canon et source d'énergie.", false],
		[39, "Dans le jeu", "La troisième étape s'étend sur trois chapitres : le voyage vers Wagoll au [[chapter/39|chapitre 39]], la production de l'incubateur sur place au [[chapter/40|chapitre 40]] et sa livraison à Fiir au [[chapter/41|chapitre 41]]. Sa page de marchandise indique une fourchette de prix, mais aucun marché ne le propose jamais : le seul moyen d'en obtenir un est de le fabriquer.", false],
		[39, "", "L'incubateur se fabrique à l'usine d'une station de niveau technologique 11, c'est-à-dire en pratique Wagoll. Sa recette demande une unité de chacun des produits suivants : [[goods/19]], [[goods/34]], [[goods/28]] et [[goods/24]]. Ceux-ci proviennent à leur tour de poissons morts et d'algues, d'importations, des cinq sortes d'algues, et de [[goods/35]] avec [[species/5]] et [[species/1]]. Les réunir constitue une petite chaîne de production à part entière.", false],
		[39, "", "Wagoll se trouve à 29 850 m, plus profond que la plupart des blindages ne le permettent : le pilote a donc besoin d'un blindage lourd comme le [[equipment/25]] pour l'atteindre sans danger. L'incubateur est un objet de l'histoire qu'aucun marché ne propose. Une fois fabriqué, il reste à bord jusqu'à sa livraison à Fiir.", false],
	],
	"world/colony": [
		[1, "", "La colonie est l'établissement humain de la planète océanique : deux cents stations sous-marines gérées par une administration coloniale, avec les colons, pêcheurs et marchands qui y vivent et y travaillent. Au début de l'histoire, toutes les stations appartiennent aux [[faction/colonists]], et la raison d'être de la colonie est claire : prélever les ressources de l'océan et les expédier ailleurs. Cet article présente l'organisation de la colonie, le fonctionnement de son économie et la manière dont l'une et l'autre évoluent au fil de l'histoire.", false],
		[1, "Colonisation", "Les colons sont venus d'ailleurs et ont bâti leurs foyers sous la surface, où les stations se dressent aujourd'hui à des profondeurs comprises entre 13 500 et 32 250 m environ. Les stations sont très diverses. Chacune a un niveau technologique de 1 à 11, qui détermine ce que son usine peut produire et les prix de ses boutiques, ainsi que ses propres eaux, sa faune et ses voisines. Certaines sont de grands carrefours comme [[station/0]] ; d'autres sont de petits avant-postes connus pour un seul produit.", false],
		[1, "", "On attend des nouveaux venus qu'ils fassent leur part. Le pilote vient sur la planète pour pêcher, avec un petit bateau et peu d'argent, et découvre vite que le travail est dur et mal payé.", false],
		[10, "", "La colonie vit de l'exportation. Ses stations chargent leurs marchandises dans des capsules de transport et les lancent en orbite, où des cargos les récupèrent. Au-dessus des fonctionnaires locaux se trouve une administration commerciale qui juge les stations sur la régularité de ces envois.", false],
		[12, "", "Le projet du pilote se résume à gagner assez pour un billet hors de la planète.", false],
		[21, "", "Les rebelles décrivent la colonisation comme rapide et impitoyable. Selon eux, elle vide l'océan plus vite que la nature ne peut se rétablir, comme cela s'est déjà produit sur d'autres planètes.", false],
		[1, "Administration et stations", "Chaque station est une petite ville avec ses propres fonctionnaires et services. Un pilote amarré peut se rendre au hangar pour installer de l'équipement, à la boutique et au chantier naval pour acheter du matériel et des coques, et consulter la carte. La plupart des stations ont aussi un tableau des contrats, et certaines un marché et une usine. Des patrouilleurs croisent autour de chaque station, entre ses portes S.T.R.E.A.M., et combattent pour le camp qui la tient.", false],
		[2, "", "Les fonctionnaires coloniaux représentent la colonie dans les affaires courantes. À [[station/0]], [[character/9]] achète la pêche du pilote et dispense des conseils que personne ne lui a demandés.", false],
		[7, "", "La sécurité des stations s'occupe des menaces locales, et les fonctionnaires confient ce genre de tâches à des indépendants. Quand des nautiles s'agglutinent autour de [[station/1]], son service de sécurité veut s'en débarrasser, et Jack envoie le pilote s'en charger.", false],
		[9, "", "Les fonctionnaires attendent des nouveaux venus qu'ils gagnent leur confiance avant de recevoir un travail important. Le pilote doit d'abord remplir des contrats du tableau avant que la colonie ne propose quoi que ce soit de plus conséquent. Les fonctionnaires anonymes, [[character/6]], que rencontre le pilote sont en général secs et paient aussi peu que possible.", false],
		[1, "Prix fixes", "Les stations colons ne font pas de commerce. Il n'y a ni marché ni usine : quand un vaisseau s'amarre, la station prend tout simplement le contenu de sa cale et paie chaque article au prix plancher, le plus bas qu'il puisse jamais atteindre. Une livraison commandée par la station elle-même est réglée en premier ; tout le reste part au tarif fixe. Pour un pêcheur qui n'a nulle part ailleurs où vendre, c'est là toute l'économie.", false],
		[1, "", "Ce système maintient les pêcheurs de la colonie dans la pauvreté. Le prix plancher est souvent inférieur à la moitié de ce que la même prise pourrait rapporter ailleurs, et il n'existe aucun autre acheteur.", false],
		[1, "Marchés et prix", "Les marchés libres n'existent que dans les stations qui échappent au contrôle colonial. Là, le prix d'une marchandise dépend de la distance. Chaque marchandise a une station d'origine, où elle se vend au prix plancher, et un meilleur marché, où elle atteint son prix plafond. Entre les deux, le prix augmente avec la distance sur la carte depuis l'origine. Trois importations, [[goods/33]], [[goods/34]] et [[goods/35]], fonctionnent à l'inverse et sont moins chères sur leur meilleur marché. Un marché achète et vend au même prix : le profit vient donc du transport des marchandises, pas du marchandage. Voir [[guide/trading]].", false],
		[1, "", "Le niveau technologique d'une station influe aussi sur ses boutiques. Vaisseaux et équipements sont moins chers dans les stations avancées : chaque niveau technologique retranche un pour cent au prix d'une coque, et l'équipement coûte aussi un peu moins cher. L'équipement plus rare apparaît plus souvent à mesure que l'histoire avance.", false],
		[1, "Usines et recettes", "Les usines transforment prises brutes et importations en produits. Chaque produit a une recette fixe et un niveau technologique minimal. [[goods/21]] demande un [[species/4]] et des [[species/17|algues vertes]] ; [[goods/22]] demande un [[species/10]] et du [[goods/35]] ; [[goods/29]] combine [[goods/20]] et de la peinture. Les produits avancés comme [[goods/41]] demandent d'autres produits comme ingrédients : une chaîne de production peut ainsi transformer du poisson bon marché en marchandises précieuses.", false],
		[1, "", "Une usine peut fabriquer tout ce qui ne dépasse pas le niveau technologique de sa station. La plupart des produits ne demandent que le niveau 1, mais au moins un article ne peut être fabriqué que dans la station la plus avancée de toutes. Chaque page de produit indique sa recette.", false],
		[1, "Le tableau des contrats", "Les contrats sont le moyen par lequel la colonie engage des indépendants. Un tableau des contrats présente entre une et huit offres, chacune avec un commanditaire, une caution due à l'acceptation et une rémunération versée en cas de succès. La rémunération augmente avec la difficulté et la distance, et la difficulté augmente avec le rang du pilote. La plupart des missions envoient le pilote vers une autre station, en général dans la tranche de profondeur du vaisseau. Voir [[guide/contracts]].", false],
		[1, "", "Les offres d'un tableau dépendent du camp qui tient la station. Les colons engagent des escortes de convoi, des pilleurs de convois, des chasseurs et des gardes pour leurs lancements de capsules. Les stations libres publient des commandes de livraison et de pêche et paient pour protéger des bancs d'animaux. Les deux camps publient des primes, des sauvetages, des chasses aux pirates, des transports de passagers et des missions de nettoyage.", false],
		[9, "", "Le tableau des contrats ne s'ouvre au pilote qu'après les premières missions pour la colonie, au [[chapter/9|chapitre 9]]. La carte des stations devient disponible un peu plus tôt.", false],
		[1, "Ordre public", "La colonie fait régner sa propre loi dans les eaux. Les stations versent une prime pour chaque pirate détruit au cours d'un trajet, encaissée à l'amarrage. La somme est égale au carré du nombre de pirates, multiplié par 100 crédits dans une station colon et par 50 dans une station libre : une longue chasse rapporte donc bien plus que plusieurs courtes.", false],
		[12, "", "Toutes les eaux n'appartiennent pas à la colonie. Les stations tenues par la résistance considèrent les eaux qui les entourent comme territoire neutre et interpellent les vaisseaux inconnus avant de les laisser s'amarrer.", false],
		[35, "", "Certains commerces sont illégaux. Les stupéfiants sont interdits dans certaines stations au moins, ce qui laisse le champ libre à des trafiquants du marché noir comme [[character/8]]. Les autorités de sécurité engagent des chasseurs de primes comme [[character/11]] pour éliminer ces individus.", false],
		[12, "La colonie dans l'histoire", "Pour le pilote, la colonie est d'abord un employeur, puis un adversaire. Jack paie à prix fixe, la battue aux nautiles à [[station/1]] paie mal, et la défense des capsules à [[station/2]] se termine par le refus de Jack de verser la moindre récompense. Excédé, le pilote suit le conseil de M.A.I. et part chercher la résistance à [[station/3]].", false],
		[13, "", "La résistance s'oppose au contrôle du commerce par la colonie et à son exploitation de la planète. Ses membres veulent le libre-échange, des prix justes et une mer pêchée avec soin.", false],
		[18, "", "Les rebelles gagnent d'abord des stations par la diplomatie, en persuadant leurs dirigeants de changer de camp. Chaque station ralliée ouvre au pilote un marché et une usine : l'économie de la colonie se transforme ainsi station par station. On commence à parler de révolution.", false],
		[23, "", "La colonie ne cède pas ses stations sans réagir. Jack, devenu un personnage assez influent, fait poser un champ de mines pour couper une route de ravitaillement rebelle près de [[station/9]].", false],
		[25, "", "Puis Jack tend une embuscade à la dirigeante rebelle alors qu'elle se rend à des négociations à [[station/10]].", false],
		[28, "", "La colonie achète aussi des traîtres. Jack met à prix la tête de la dirigeante rebelle et celle du pilote, et le pilote rebelle [[character/3]] accepte l'argent.", false],
		[31, "", "La colonie dispute aussi aux rebelles la course à la technologie. Ses hommes ont volé le prototype de [[world/biotek]] du [[world/abel|professeur Abel]] et tentent de l'achever eux-mêmes.", false],
		[37, "", "La cupidité affaiblit la colonie de l'intérieur. Jack en personne vend un canon de station, l'[[world/eclipse|Eclipse]], à un trafiquant du marché noir, qui le revend au pilote.", false],
		[44, "", "Dans une dernière démonstration de force, les colons frappent loin à l'intérieur du territoire rebelle et attaquent [[station/14]], mais sont repoussés quand les Aquariens se joignent au combat contre eux.", false],
		[45, "", "Après cette défaite, les rebelles entreprennent d'en finir avec la colonie par deux grandes offensives, une dans chaque hémisphère.", false],
		[47, "", "Les stations du sud tombent, et il ne reste aux colons que [[station/0]], lourdement fortifiée, comme dernier grand bastion.", false],
		[48, "", "Gosu tombe lors de la bataille finale. Jack s'échappe dans une capsule de sauvetage, et le règne colonial sur l'océan prend fin : toutes les stations sont aux mains des rebelles.", false],
	],
	"world/eclipse": [
		[33, "", "L'Eclipse est un canon lourd conçu pour la défense des stations. Il est si gourmand en énergie qu'il n'a jamais été prévu pour être monté sur un sous-marin. Dans la deuxième étape du plan des rebelles, le pilote doit s'en procurer un pour l'associer au [[world/biotek]], capable de fournir assez d'énergie pour le faire tirer depuis un vaisseau. L'arme correspond à [[equipment/42]] dans la liste des équipements, et le canon en caisse échangé dans l'histoire est [[goods/38]].", false],
		[33, "Origines", "L'Eclipse appartient à une catégorie de canons de station conçus pour les défenses fixes. Sa consommation d'énergie explique qu'il soit resté sur les stations : aucune centrale de sous-marin ne pourrait le maintenir en état de tir. Le pilote le connaît déjà comme arme fixe, ce qui rend si improbable le projet rebelle d'en embarquer un sur un vaisseau.", false],
		[33, "", "Les Eclipse sont fabriqués à [[station/188]], aux mains des colons au moment où le plan démarre. La station adéquate la plus proche sous contrôle rebelle est [[station/15]]. L'arme n'est pas du tout en vente sur le marché libre.", false],
		[33, "", "Les rebelles en ont besoin parce qu'ils sont en infériorité numérique. Plutôt que d'égaler les colons vaisseau pour vaisseau, ils espèrent qu'une arme de cette puissance, embarquée sur un sous-marin, fera pencher la balance.", false],
		[33, "Obtenir le canon", "[[character/2]] n'a pas de plan précis pour s'en procurer un. Elle remet au pilote 100 000 crédits pour les pots-de-vin qui s'avéreraient nécessaires et l'envoie à Choral pour voir ce qui s'y présente.", false],
		[35, "", "À Choral, le pilote est abordé par le trafiquant du marché noir [[character/8]], qui prétend pouvoir obtenir presque n'importe quoi, moyennant finance. Il veut bien essayer de trouver un Eclipse, mais seulement si le pilote tue d'abord le chasseur de primes [[character/11]], engagé pour se débarrasser de lui.", false],
		[37, "", "Une fois Raoul mort, Fenko présente un Eclipse à prix fort. Il l'a acheté à [[character/9]], qui a apparemment vendu le canon par appât du gain sans savoir qu'il finirait chez ses ennemis.", false],
		[38, "", "Le pilote achète l'arme et la rapporte à [[station/14]].", false],
		[39, "", "[[character/2]] choisit de ne pas demander comment le canon a été obtenu. Elle est soulagée d'apprendre qu'aucun innocent n'est mort pour lui. Quand le pilote plaisante en disant que le plan revient à asservir toute la planète, elle rejette fermement l'idée.", false],
		[42, "L'Eclipse en service", "Une fois le [[goods/36]] arrivé à Fiir, le [[world/abel|professeur Abel]] relie le canon au prototype du générateur, et l'Eclipse est prêt à être installé sur le sous-marin du pilote. Les rebelles rappellent que la source d'énergie n'est encore qu'un prototype. Le pilote a pour ordre de tester l'arme contre une bande de pirates près de [[station/17]].", false],
		[43, "", "L'essai se passe si bien que les pirates appellent des renforts. Aussitôt après, le canon affronte sa véritable épreuve quand les colons attaquent Fiir ; Jack n'en revient pas que le pilote porte un Eclipse.", false],
		[45, "", "Après la défense de Fiir, les rebelles prennent [[station/188]] et entreprennent d'équiper de l'Eclipse autant de leurs vaisseaux que possible, en vue des offensives finales.", false],
		[47, "", "Lors des batailles pour [[station/18]] et [[station/109]], le canon se révèle dévastateur, et [[character/5]] ne tarit pas d'éloges à son sujet.", false],
		[37, "Dans le jeu", "Dans les chapitres qui entourent [[chapter/37]], l'Eclipse en caisse est en vente à Choral comme marchandise de l'histoire. Il coûte bien plus cher que n'importe quelle marchandise ordinaire et n'est jamais proposé ailleurs.", false],
		[42, "", "Au [[chapter/42|chapitre 42]], le [[equipment/42]] apparaît dans la boutique d'équipement de [[station/14]] et s'installe gratuitement. Tant qu'il n'est pas installé, le tableau des contrats et la carte sont fermés et le vaisseau ne peut pas partir. On ne peut monter qu'un seul Eclipse par vaisseau, et il ne peut pas être revendu avant la fin de la guerre.", false],
		[42, "", "En tant qu'arme, il surclasse tout ce qui est en vente. Chaque tir frappe plus fort que n'importe quel autre canon du jeu, avec une portée d'environ 240 m, à raison d'environ un tir par seconde. Il tire avec le reste de la batterie de canons et se combine donc avec toutes les autres armes installées.", false],
	],
	"world/history": [
		[1, "", "La campagne suit un jeune pilote de sous-marin venu sur une lointaine planète océanique pour travailler comme pêcheur au service de sa [[world/colony|colonie]] humaine. Les colons vivent dans des stations dispersées dans les profondeurs de [[world/ocean|l'océan]], et la colonie dépend de ce que ses pilotes pêchent, vendent et transportent d'une station à l'autre. Le pilote possède un petit sous-marin modestement équipé, qu'il partage avec [[character/1]], l'ordinateur de bord, jamais à court de conseils ni d'avis. Le joueur choisit le nom du pilote ; cette encyclopédie appelle simplement le protagoniste « le pilote ».", false],
		[1, "", "L'histoire se déroule sur 48 chapitres. Elle commence par le quotidien d'un pêcheur : capturer la faune marine, vendre la prise et accepter des petits boulots pour joindre les deux bouts. Elle s'élargit ensuite en un conflit sur la manière de traiter la mer de la planète et ses créatures, et sur la question de savoir qui en décide. En chemin, le pilote a affaire à des fonctionnaires de station, des marchands, des [[faction/pirates]] et des habitants des profondeurs plus étranges encore, et les choix d'un simple pêcheur finissent par peser bien plus lourd que quiconque ne l'aurait cru.", false],
		[1, "Acte I : Pêcheur pour la colonie", "L'histoire s'ouvre en pleine mer au [[chapter/1|chapitre 1]]. Le pilote regrette déjà d'être venu sur la planète, mais [[character/1]] rappelle qu'ils sont là pour pêcher, et la première tâche consiste simplement à harponner une créature et à la hisser dans la cale. Ces premières scènes servent aussi d'initiation à la pêche.", false],
		[2, "", "Une fois la première créature capturée, [[character/1]] montre comment le pilote auto peut prendre les commandes, et au [[chapter/2|chapitre 2]] le pilote met le cap sur [[station/0]], la station colon où l'on vend la pêche.", false],
		[3, "", "À [[station/0]], le pilote a affaire à [[character/9]], le fonctionnaire de la colonie qui achète la pêche. [[character/9]] paie son habituel prix fixe, se moque de la petite cale et sermonne le nouveau venu : chacun doit apporter sa part à la colonie. Il ricane aussi qu'avec une vraie arme, un pilote gagnerait davantage à chasser les [[faction/pirates]]. Une fois qu'il est parti, [[character/1]] le traite d'imbécile mais retient l'idée, en notant que le [[equipment/0]] est en vente au hangar. Au [[chapter/3|chapitre 3]], le pilote achète l'arme et l'installe.", false],
		[4, "", "Armé pour la première fois, le pilote quitte la station au [[chapter/4|chapitre 4]] pour essayer sa nouvelle arme, tandis que [[character/1]] met en garde contre les tirs sur les poissons inoffensifs. Les eaux locales se révèlent vides de pirates : la chasse doit se poursuivre ailleurs.", false],
		[5, "", "[[character/1]] explique le fonctionnement des longs trajets : les vaisseaux franchissent de grandes distances grâce au [[world/stream|réseau S.T.R.E.A.M.]], en quittant toujours un secteur par son point de sortie pour arriver au point d'entrée du suivant. Au [[chapter/5|chapitre 5]], un pirate isolé apparaît près de [[station/1]]. Après une brève leçon sur le changement d'arme, le tir automatique et la lecture du radar, le pilote livre son premier combat.", false],
		[6, "", "Le pirate est détruit, et [[character/1]] montre comment harponner les caisses de cargaison que laissent les épaves avant qu'elles ne coulent hors de portée. Avec une arme qui fonctionne et un peu de butin, le pilote retourne à [[station/0]] au [[chapter/6|chapitre 6]].", false],
		[7, "", "De retour à la station, [[character/9]] se félicite qu'on ait suivi son conseil et propose ce qu'il appelle un vrai travail. Des [[species/0|nautiles]] encombrent les routes des convois autour de [[station/1]], et la sécurité de la station veut s'en débarrasser. Le pilote objecte que ces animaux se contentent de brouter les organismes qui recouvrent les coques des stations, et qu'aucune petite cale ne pourrait tous les emporter, mais peu importe à [[character/9]] comment ils disparaissent. Au [[chapter/7|chapitre 7]], le pilote les élimine, au harpon ou au canon. Ni le pilote ni [[character/1]] n'aiment ce travail, car ces créatures sont rares et inoffensives.", false],
		[8, "", "Cette battue laisse le pilote ébranlé. Le pilote est venu sur la planète pour pêcher, pas pour tuer des animaux au nom du confort d'une station, et [[character/1]] ne peut qu'espérer que la paie compensera. Tous deux s'amarrent à [[station/1]] pour encaisser au [[chapter/8|chapitre 8]].", false],
		[9, "", "Le fonctionnaire colon qui les reçoit ([[character/6]]) traite le pilote comme un simple dératiseur à gages et admet que la mission est sans doute inutile, puisque les nautiles reviennent sans cesse. La paie est un forfait de 1 000 $, à prendre ou à laisser. Tout autre travail dépend d'une preuve de compétence : trois contrats remplis depuis les tableaux des stations. Au [[chapter/9|chapitre 9]], le pilote part donc en indépendant et accepte les escortes, les opérations de renflouage et les commandes de pêche à sa portée.", false],
		[10, "", "Les trois missions valent au pilote l'approbation réticente du fonctionnaire et une mission spéciale. D'étranges êtres que les colons appellent [[world/aquarians|Aquariens]], mi-humains mi-poissons, attaquent les capsules de transport qui envoient les marchandises de la colonie en orbite, où des cargos les récupèrent. Les capsules perdues ou endommagées nuisent à l'image de la station auprès de l'[[world/colony|administration commerciale]], et le pilote est donc envoyé à [[station/2]] pour repousser les assaillants. [[character/9]] y dirigera le prochain lancement.", false],
		[10, "", "Au [[chapter/10|chapitre 10]], le lancement a déjà commencé à l'arrivée du pilote, et les Aquariens s'en prennent bel et bien aux capsules. [[character/9]] lance par radio un avertissement sec : le pilote garde son travail à condition de ne pas en perdre plus de cinq.", false],
		[11, "", "L'attaque est repoussée, mais elle laisse des questions. Le pilote se demande pourquoi les Aquariens visent les capsules, et [[character/1]] suggère qu'ils sont peut-être bien plus intelligents que ne le croient les colons. De plus en plus mal à l'aise avec ce genre de travail, le pilote s'amarre à [[station/2]] pour faire son rapport au [[chapter/11|chapitre 11]].", false],
		[12, "Acte II : La résistance", "L'accueil de [[character/9]] achève d'épuiser la patience du pilote envers la colonie. Il rend le pilote responsable des capsules endommagées, annule la récompense et s'en va furieux, en marmonnant qu'il est promis à un plus grand destin. [[character/1]] dit alors tout haut ce que tous deux ressentent : le pilote travaille du matin au soir pour la colonie, gagne très peu et n'a aucun droit de regard sur sa pêche, simplement prise à prix fixe. Le pilote veut seulement mettre assez de côté pour un billet qui l'emmène hors de la planète, mais [[character/1]] a une autre idée.", false],
		[12, "", "En balayant les fréquences radio, [[character/1]] a capté les signes d'un mouvement de résistance qui émet depuis [[station/3]]. Le choix revient au pilote, qui sait que cela pourrait attirer de graves ennuis, et qui y va quand même. Désormais, [[character/1]] marque en vert sur la carte les stations du mouvement (voir [[faction/rebels]]).", false],
		[12, "", "Au [[chapter/12|chapitre 12]], une approche discrète de [[station/3]] échoue aussitôt. Les gardes de la station interpellent le vaisseau et menacent d'ouvrir le feu ; le pilote bredouille un nom, explique être parti de [[station/0]] et demande à rejoindre le mouvement. Après un long silence, le vaisseau est autorisé à s'amarrer.", false],
		[13, "", "À l'intérieur, [[character/4]] soumet le nouveau venu à une série de questions alambiquées. Le pilote avoue ne presque rien savoir, hormis que le mouvement défend le libre-échange. Cela concorde avec ce qu'admet [[character/4]] lui-même : les rebelles n'ont commencé à chiffrer leurs communications radio qu'il y a quelques jours. Faute de bras, [[character/4]] accepte le pilote à l'essai. Le mouvement entend infiltrer les stations colons, convaincre leurs dirigeants de changer de camp et mettre fin à l'exploitation de la planète et de ses habitants.", false],
		[13, "", "[[character/4]] refuse de révéler ses plans à un inconnu ; le pilote doit donc d'abord se rendre utile. Au [[chapter/13|chapitre 13]], la mission consiste à récupérer des sympathisants à [[station/4]] et à les conduire à [[station/5]]. En route, le pilote avoue à [[character/1]] que toute cette affaire reste un mystère, mais reconnaît que c'est toujours mieux que de recevoir des ordres de [[character/9]].", false],
		[14, "", "Le contact à [[station/4]] est une seule passagère, [[character/5]]. Chaleureuse et vive, elle est visiblement ravie de rencontrer le pilote, et le pilote est tout aussi visiblement sous le charme. Elle refuse d'expliquer les projets du mouvement, en affirmant que le secret lui a permis de survivre jusqu'ici, et transmet les coordonnées du trajet. [[character/1]] observe le duo avec un agacement manifeste, que le pilote met en riant sur le compte de la jalousie. Au [[chapter/14|chapitre 14]], le pilote conduit [[character/5]] à [[station/5]] aussi vite et sûrement que possible.", false],
		[15, "", "À [[station/5]], [[character/5]] se met à l'abri pour régler quelques affaires, mais elle explique d'abord pourquoi les rebelles se tiennent à distance des colons. Eux ne dépouillent pas la mer de ses ressources. Ils prélèvent ce qu'elle peut céder, transforment leurs prises en marchandises et veillent à ne pas surpêcher, afin que la diversité de la vie marine se maintienne. Pour montrer comment cela fonctionne, elle demande au pilote de produire cinq tonnes de marchandises à l'usine d'une station de la résistance ([[chapter/15]]). Elle suggère [[station/90]], où l'on peut pêcher des calmars et acheter des [[goods/35]] pour fabriquer des [[goods/22]].", false],
		[16, "", "Une fois que le pilote maîtrise cette seconde façon de gagner de l'argent, [[character/5]] rappelle avec une nouvelle tâche. Le mouvement a besoin de rapports récents sur chaque station pour repérer les points faibles et rallier la population, car la persuasion comptera autant que la puissance de feu. Quand le pilote demande s'il s'agit d'une révolution, elle refuse d'en dire plus. Au [[chapter/16|chapitre 16]], le pilote visite des stations encore inconnues, tout en gagnant de quoi améliorer son vaisseau.", false],
		[17, "", "Un long message de [[character/4]], que [[character/1]] résume en une seule ligne, rappelle le pilote à [[station/3]] au [[chapter/17|chapitre 17]]. Pendant ce temps, la zone rebelle s'agrandit : [[station/6]], [[station/12]], [[station/106]] et [[station/180]] ont rejoint le mouvement.", false],
		[18, "Acte III : La dirigeante", "[[character/4]] explique que la diplomatie a discrètement élargi la zone rebelle : le pilote peut désormais commercer dans bien plus de stations. Les chaînes d'information parlent déjà de révolution. De nombreux décideurs se sont ralliés sans qu'un seul coup de feu soit tiré, même si [[character/4]] s'attend tôt ou tard à un bain de sang. Les prochaines étapes sont dirigées par la tête du mouvement depuis l'une des stations nouvellement gagnées, et le pilote doit la trouver, ou plutôt se faire trouver. [[character/4]] marque les stations possibles et prévient que certaines pourraient être hors de portée sans un meilleur blindage ou de meilleurs boucliers.", false],
		[18, "", "[[character/1]] n'est guère impressionné par l'organisation du mouvement, et le [[chapter/18|chapitre 18]] devient une recherche où la chance est presque le seul indice.", false],
		[19, "", "La piste s'arrête à [[station/6]], où le pilote rencontre [[character/2]], une femme d'âge mûr qui dirige le mouvement et donnera désormais les ordres. Le pilote avait supposé que la tête du mouvement était un homme, erreur qu'elle balaie d'un haussement d'épaules. Sa première mission est une escorte. Un banc de [[species/10]] doit être guidé vers des eaux sûres près de [[station/7]] avant que les colons ne puissent capturer ou tuer les animaux, et un combat est probable. [[character/1]] grommelle que personne n'a parlé de paiement, tandis que le pilote se dit que [[character/2]] veut d'abord savoir si l'on peut faire confiance au nouveau venu.", false],
		[19, "", "Au [[chapter/19|chapitre 19]], le pilote découvre des Aquariens qui nagent aux côtés du banc, et [[character/1]] se demande s'ils veillent sur les créatures de la mer. Des vaisseaux colons approchent bientôt, et le pilote doit les intercepter sans toucher les animaux.", false],
		[20, "", "Le banc survit. [[character/2]] verse la modeste somme de 2 000 $ et rappelle aussitôt le pilote, tandis que [[character/1]] se plaint que vendre les animaux aurait bien mieux payé. Au [[chapter/20|chapitre 20]], le pilote retourne à [[station/6]].", false],
		[21, "", "Cette fois, le pilote demande sans détour ce que défend le mouvement. [[character/2]] décrit un groupe de personnes unies contre la ruine de la planète et de ses habitants. La colonisation avance si vite, et la nature est exploitée avec si peu de scrupules, que les plantes et les animaux de la mer ne pourront bientôt plus se rétablir. Si rien ne change, la planète finira épuisée, comme bien d'autres mondes avant elle. Le mouvement entend l'empêcher en ralliant des décideurs importants à sa cause, et le pilote promet son aide.", false],
		[21, "", "Le souci immédiat de [[character/2]], ce sont les [[faction/pirates]], qui profitent du conflit pour s'en prendre à des cibles faciles. Jusqu'ici, le mouvement s'est contenté de se défendre ; désormais, il va attaquer directement une formation pirate. Pour rassurer le pilote nerveux, elle lui adjoint une escorte, [[character/3]], l'un de ses meilleurs pilotes, même si [[character/1]] soupçonne que c'est en réalité le pilote qui sert d'escorte. Au [[chapter/21|chapitre 21]], tous deux se retrouvent près de [[station/8]]. [[character/3]] accueille le retardataire avec impatience et condescendance, et lui ordonne de rester derrière lui pour apprendre.", false],
		[22, "", "La bande est anéantie. [[character/3]] concède quelques éloges du bout des lèvres, mais quand [[character/2]] récompense chacun d'eux de 5 000 $, il est furieux que l'argent soit partagé à parts égales et lance au pilote que le nouveau venu n'a servi à rien. Le pilote et [[character/1]] s'éclipsent avant que son humeur n'empire. Au [[chapter/22|chapitre 22]], ils se rendent à [[station/9]] pour retrouver [[character/2]], dont les négociations sur place ont abouti : la station a rejoint le mouvement, avec [[station/5]], [[station/37]] et plusieurs autres.", false],
		[23, "", "Avant que [[character/2]] ne reparte, la route de ravitaillement vers [[station/37]] doit être sécurisée. [[character/9]] a posé un champ de mines juste devant la station pour la couper. [[character/2]] le connaît : autrefois personnage insignifiant, il s'est vite élevé grâce à des amis bien placés. Ravi de contrarier ses plans, le pilote part déminer la zone au [[chapter/23|chapitre 23]]. [[character/2]] prévient que des pirates rôderont dans les parages, et que chaque mine ne peut être détruite qu'une fois que le pilote s'est assez approché pour déclencher son détecteur de mouvement.", false],
		[24, "", "Le champ est déminé, la route est de nouveau sûre, et [[character/2]] verse 4 000 $ pour ce travail. De retour à [[station/9]] au [[chapter/24|chapitre 24]], le pilote trouve la zone rebelle bien plus étendue. Une vague de stations à travers l'océan soutient désormais le mouvement, parmi lesquelles [[station/14]], [[station/22]] et [[station/25]].", false],
		[25, "", "À la station, le pilote retrouve [[character/5]] ; leur conversation est chaleureuse mais gauche, et [[character/1]] y glisse des conseils que personne ne lui a demandés. [[character/2]] écourte les retrouvailles. Une série de négociations à [[station/10]] pourrait rallier d'autres stations, et le pilote et [[character/5]] doivent l'y escorter avec [[character/3]]. Le pilote n'a guère envie de prendre la mer aux côtés de [[character/3]], mais [[character/2]] se porte garante de son talent et ne s'attend à rien de pire que des pirates.", false],
		[25, "", "Au [[chapter/25|chapitre 25]], le groupe atteint [[station/10]] et sent aussitôt que quelque chose cloche. [[character/9]] attend avec des forces colons et leur ordonne d'attaquer, et [[character/2]] ne comprend pas comment il savait qu'ils venaient.", false],
		[26, "Acte IV : Trahison", "Pendant le combat, [[character/3]] ne tire pas, prétend que ses armes sont en panne et prend la fuite en s'excusant. Le reste du groupe survit. [[character/2]] s'interroge sur un sabotage, tandis que [[character/5]] accuse ouvertement [[character/3]] de trahison ; [[character/2]] le défend, affirmant qu'il lui a toujours été fidèle. Le pilote reconnaît que l'épisode paraît suspect, mais presse tout le monde de partir avant que [[character/9]] ne fasse venir d'autres vaisseaux.", false],
		[26, "", "Le groupe se disperse. [[character/2]] se cache, et [[character/5]] fait tourner les affaires du mouvement à [[station/9]]. Le pilote reçoit pour consigne de devenir un bien meilleur combattant avant leurs retrouvailles, car il est désormais clair que la diplomatie seule ne suffira peut-être pas. Au [[chapter/26|chapitre 26]], le pilote chasse pirates et autres ennemis pour augmenter son tableau de chasse.", false],
		[27, "", "Une fois le pilote devenu plus redoutable, [[character/3]] appelle sans prévenir. Il demande des nouvelles de [[character/2]] et de [[character/5]], affirme avoir réuni des informations capitales pendant son absence et propose un rendez-vous près de [[station/11]]. [[character/1]] est certain qu'il s'agit d'un piège ; le pilote en convient, et y va quand même ([[chapter/27]]).", false],
		[28, "", "Le piège est bien réel. [[character/3]] retient [[character/2]] prisonnière et exige la reddition du pilote, tandis que [[character/2]] presse le pilote de ne pas tenir compte d'elle. Sur le conseil de [[character/1]], le pilote fait parler [[character/3]] pendant que l'ordinateur scanne son vaisseau. [[character/3]] avoue sans détour avoir changé de camp pour l'argent : [[character/2]] payait mal, et [[character/9]] offre une grosse prime pour elle comme pour le pilote. Quand le pilote invoque les idéaux du mouvement, [[character/3]] rétorque que les idéaux ne remplissent pas l'assiette.", false],
		[28, "", "Le scan révèle un vaisseau monoplace : [[character/2]] doit donc être enfermée dans sa soute lourdement blindée. Le pilote ouvre le feu. [[character/3]] se montre rapide et dangereux, mais son vaisseau est détruit, et le pilote harponne le conteneur avant qu'il ne coule trop profond. Au [[chapter/28|chapitre 28]], le pilote l'emporte à [[station/12]], la station sûre la plus proche, en espérant que [[character/1]] a deviné juste quant à son contenu.", false],
		[29, "", "[[character/1]] avait raison. [[character/2]] en sort secouée mais indemne, et remercie le pilote de lui avoir sauvé la vie. Pas le temps de se reposer : avant son enlèvement, elle organisait le transport d'une équipe de scientifiques de très haut niveau vers [[station/14]], et [[character/3]] a peut-être déjà transmis les détails. Elle refuse encore d'expliquer pourquoi ces scientifiques comptent tant, et charge le pilote de faire traverser la zone frontalière à leur convoi sans encombre ([[chapter/29]]). Près de [[station/13]], le pilote trouve le convoi déjà sous un feu nourri, qui appelle à l'aide.", false],
		[30, "", "Le convoi passe, et ses équipages attribuent leur survie au pilote. [[character/2]] verse 5 000 $ et donne rendez-vous à [[station/14]], où elle promet d'expliquer la suite ([[chapter/30]]).", false],
		[31, "Acte V : Trois étapes", "À [[station/14]], [[character/5]], [[character/4]] et [[character/2]] attendent, et [[character/2]] dévoile enfin son plan au pilote. Les affrontements avec les colons se multiplient et les rebelles restent moins nombreux ; elle a donc fait venir à la station le [[world/abel|professeur Abel]] et son équipe pour construire une arme capable de renverser l'équilibre. Le projet compte trois étapes. La première est une source d'énergie, [[world/biotek|le générateur Biotek]], une technologie étudiée depuis des années sans qu'aucun prototype fonctionnel n'ait jamais vu le jour. Abel était sur le point d'en achever un quand les colons le lui ont volé, et ils tentent désormais de le terminer eux-mêmes.", false],
		[31, "", "[[character/2]] part rejoindre Abel, et [[character/5]] prend le relais du briefing. Selon un informateur, le générateur est acheminé vers Maarth à bord de cargos ordinaires pour ne pas attirer l'attention, ce qui donne aux rebelles une occasion de frapper près de [[station/2]]. Personne ne sait quel vaisseau le transporte : il faut donc arrêter tout le convoi et récupérer chaque conteneur, que cela plaise ou non. Au [[chapter/31|chapitre 31]], le pilote, [[character/5]] et [[character/4]] interceptent le convoi. Ses équipages protestent qu'ils ne transportent que des vivres et des médicaments, et [[character/4]] répond que les rebelles en ont justement grand besoin.", false],
		[32, "", "Tous les conteneurs sont récupérés, et au [[chapter/32|chapitre 32]] l'équipe rapporte le butin à [[station/14]].", false],
		[33, "", "Abel emporte la cargaison dans son laboratoire pour travailler sur le prototype, et [[character/2]] distribue de nouvelles tâches. [[character/5]] doit patrouiller autour de la station contre les attaques surprises, [[character/4]] est attendu au hangar, et le pilote se voit confier la deuxième étape. Le générateur a besoin d'une arme à la hauteur de sa puissance, et [[character/2]] a choisi le [[equipment/42]], un [[world/eclipse|canon de défense fixe]] dont l'énorme consommation d'énergie l'a jusqu'ici tenu à l'écart de tout vaisseau.", false],
		[33, "", "La station la plus proche qui fabrique ces canons, [[station/188]], est aux mains des colons ; [[character/2]] envoie donc plutôt le pilote à la station rebelle [[station/15]]. L'arme n'est vendue nulle part, et c'est là que s'arrête son plan. Elle remet simplement 100 000 $ pour les pots-de-vin qui pourraient s'avérer nécessaires. Le pilote le qualifie de plan le plus vague jamais entendu et l'accepte de bon cœur, et le [[chapter/33|chapitre 33]] conduit le pilote à la station pour y jeter un œil.", false],
		[34, "", "Sans contacts ni véritable plan, le pilote commence par passer en revue les marchandises du marchand local. Au [[chapter/34|chapitre 34]], la piste mène à une cargaison de [[goods/37]], une drogue interdite dans cette station.", false],
		[35, "", "La transaction attire [[character/8]], un trafiquant du marché noir qui parle de lui-même à la troisième personne et prétend pouvoir fournir presque n'importe quoi. Quand on lui demande le [[equipment/42]], il est stupéfait et se demande si le pilote compte déclencher une guerre. Il accepte pourtant d'essayer en échange d'un service : la mort de [[character/11]], un chasseur de primes engagé par l'administration de la sécurité pour se débarrasser de [[character/8]]. Au [[chapter/35|chapitre 35]], le pilote trouve [[character/11]] en patrouille près de la station, avec sa propre escorte. Il congédie le pilote comme un simple pêcheur.", false],
		[36, "", "Quand le combat tourne à son désavantage, [[character/11]] tente de négocier, mais son vaisseau est détruit. Le pilote retourne à [[station/15]] au [[chapter/36|chapitre 36]], en espérant que le trafiquant tiendra parole.", false],
		[37, "", "[[character/8]] tient parole. Il a déniché un [[equipment/42]] et accepte de le vendre, à un prix gonflé par les pots-de-vin qu'il dit avoir versés. Quand on lui demande comment il s'est procuré un tel canon, il nomme le vendeur : [[character/9]]. [[character/1]] savoure l'ironie : la cupidité de [[character/9]] arme ses pires ennemis. Au [[chapter/37|chapitre 37]], le pilote achète le canon et le charge à bord.", false],
		[38, "", "Le canon dans la cale, la deuxième étape est accomplie, et au [[chapter/38|chapitre 38]] le pilote retourne à [[station/14]] pour voir où en est le prototype.", false],
		[39, "", "[[character/2]] préfère ne pas savoir comment le canon a été obtenu et espère seulement qu'aucun sang n'a coulé ; le pilote répond prudemment qu'aucun innocent n'est mort. Le prototype est presque terminé, mais il lui manque un petit appareil impossible à fabriquer à la station : un [[goods/36]], qui copie le matériel génétique de particules d'algues et déclenche ainsi la réaction qui alimente le générateur. [[character/2]] reconnaît ne faire que répéter l'explication d'Abel. Quand le pilote qualifie avec ironie cet appareil de troisième étape vers l'asservissement de toute la planète, elle rejette sèchement l'idée.", false],
		[39, "", "Seule [[station/16]] dispose de l'équipement nécessaire pour construire l'incubateur ; le [[chapter/39|chapitre 39]] y envoie donc le pilote pour la troisième étape. [[character/1]] se plaint que le pilote semble mener toute la rébellion à lui seul.", false],
		[40, "", "À la station, il apparaît vite que construire l'incubateur n'aura rien de simple, et le [[chapter/40|chapitre 40]] se transforme en un exigeant travail de production.", false],
		[41, "", "L'incubateur est terminé, à la surprise non dissimulée de [[character/1]]. Toujours pas certain d'agir comme il le faut, le pilote l'apporte à [[station/14]] au [[chapter/41|chapitre 41]].", false],
		[42, "", "[[character/5]] accueille le pilote et l'incubateur avec joie, tandis que [[character/1]] annonce qu'il s'éteint plutôt que d'écouter. Abel a tout préparé, et le [[equipment/42]] devrait bientôt être disponible au hangar. [[character/2]] veut tester le canon sans attendre contre des pirates, et [[character/5]] transmet les coordonnées en rappelant que le générateur n'est encore qu'un prototype. [[character/1]], censé être en veille, fait clairement comprendre qu'il n'a pas perdu un mot.", false],
		[42, "", "Au [[chapter/42|chapitre 42]], le pilote installe le canon et attaque un repaire de pirates près de [[station/17]]. Les pirates comprennent vite à quoi ils ont affaire et appellent des renforts.", false],
		[43, "Acte VI : La guerre de l'océan", "L'essai est interrompu par un appel de détresse de [[station/14]], émis en clair sur un canal non chiffré. Au [[chapter/43|chapitre 43]], le pilote rentre à toute allure et trouve la station sous une attaque surprise des colons. De nombreux quais ont été touchés, trop peu de vaisseaux rebelles peuvent appareiller, et [[character/2]] croit la fin arrivée. [[character/9]] mène l'assaut et se moque du pilote, qui pêche désormais pour le compte des rebelles, jusqu'à ce qu'il apprenne que le [[equipment/42]] est sur le point de tirer.", false],
		[44, "", "Au milieu de la bataille, les [[world/aquarians|Aquariens]] arrivent et se jettent sur les colons, combattant aux côtés des rebelles. L'attaque s'effondre, et [[character/9]] déserte dès qu'il la voit perdue. [[character/2]] qualifie ce sauvetage de miracle et demande au pilote de s'amarrer, en promettant un invité spécial ([[chapter/44]]).", false],
		[45, "", "[[character/2]] reconnaît que le raid a pris les rebelles au dépourvu, car personne ne s'attendait à ce que les colons frappent si loin à l'intérieur des eaux rebelles, et que la défense n'a pas été leur œuvre à eux seuls. L'invité est un délégué aquarien qui comprend un peu la langue des humains. Par sa voix, les Aquariens proposent d'aider à mettre fin à la domination des colons. Une fois toutes les stations prises et la flotte colon vaincue, tous devront vivre en harmonie avec la nature.", false],
		[45, "", "Avec l'aide des Aquariens, [[character/2]] prépare deux grandes offensives pour prendre les stations restantes des hémisphères nord et sud. [[station/188]] est tombée, et les rebelles équipent du [[equipment/42]] autant de vaisseaux que possible. Pour exploiter l'effet de surprise tant qu'il dure, elle confie au pilote l'assaut contre [[station/18]] et envoie [[character/5]] contre [[station/109]]. Quand le pilote s'inquiète pour [[character/5]], [[character/2]] se moque gentiment de son affection évidente et rappelle que [[character/5]] est elle-même une pilote chevronnée.", false],
		[45, "", "Au [[chapter/45|chapitre 45]], le pilote trouve à son arrivée [[character/12]], chef de l'escadron Atmos, qui attend l'ordre d'attaquer, tandis qu'un groupe d'Aquariens remonte des profondeurs. Tous les vaisseaux colons doivent être détruits, cargos compris.", false],
		[46, "", "Les défenseurs sont anéantis. Le pilote envoie la moitié de l'escadron de [[character/12]] patrouiller autour de la station et s'amarre avec le reste au [[chapter/46|chapitre 46]]. Au même moment, une immense vague de stations change de camp, de [[station/1]] et [[station/2]] jusqu'à [[station/11]], [[station/18]] et [[station/109]].", false],
		[47, "", "[[character/5]] appelle pour annoncer que son propre assaut a lui aussi réussi et que le [[equipment/42]] s'est montré dévastateur ; le pilote en attribue tout autant le mérite aux Aquariens. Toutes les stations du sud sont désormais aux mains des rebelles. [[character/2]] a fait savoir ce qui pourrait être la dernière mission : [[station/0]], le dernier grand bastion des colons et la station où l'histoire du pilote a commencé. Elle est lourdement fortifiée, et [[character/2]] est déjà en route pour mener l'attaque en personne. [[character/5]] suit, retardée par des pirates sur sa route, et au [[chapter/47|chapitre 47]] le pilote les rejoint pour la bataille finale.", false],
		[47, "", "[[character/9]] commande la défense et se vante de prendre plaisir à détruire le vaisseau du pilote, ce que le pilote reconnaît comme un écho des dernières paroles de [[character/3]]. En apprenant qui a tué [[character/3]], [[character/9]] tente de déstabiliser le pilote en prétendant être son père, et [[character/3]] son frère. Le pilote, qui n'a pas de frère et se souvient parfaitement du visage de son père, balaie aussitôt le mensonge.", false],
		[48, "", "La flotte colon tombe vaisseau après vaisseau, jusqu'à ce qu'il ne reste plus que [[character/9]]. Il est rapide et difficile à toucher, mais sur le conseil de [[character/1]], le pilote esquive ses attaques et frappe par derrière. [[character/9]] s'échappe dans une capsule de sauvetage et, à l'incrédulité de [[character/5]], semble emporter toute la station avec lui. Avant de partir, il lance avec mépris qu'il n'y a rien de valable dans les profondeurs et qu'il ne s'est de toute façon jamais soucié des poissons.", false],
		[48, "", "Après la fuite de [[character/9]], la guerre est terminée, et au [[chapter/48|chapitre 48]] [[station/0]] et les derniers bastions rejoignent le mouvement. Le pilote insiste : la victoire appartient à tous. [[character/1]] réclame sa part du mérite et se voit promettre une extension de mémoire dès que le pilote sera de retour sur la terre ferme, ce dont il affirme avec indignation n'avoir aucun besoin. [[character/2]] les remercie tous et admet que les blessures de la planète mettront longtemps à guérir, mais elle est convaincue qu'ils y parviendront aussi. [[character/5]] invite le pilote à fêter cela autour d'un [[goods/21]], et le pilote accepte avec plaisir.", false],
		[48, "Thèmes", "Le conflit central porte sur l'usage de la mer. La colonie la traite comme une ressource à récolter et à expédier en orbite : elle achète la pêche à prix fixe et abat la faune qui la gêne. Le mouvement plaide pour ne prélever que ce que la mer peut céder, protéger la diversité de sa vie et commercer librement. Les premières missions du pilote, la battue aux nautiles et la défense des capsules, montrent de l'intérieur la manière de faire coloniale. Le malaise croissant du pilote face à elles rend crédible son passage à la résistance.", false],
		[48, "", "Les Aquariens suivent la même trajectoire. Ils apparaissent d'abord comme des nuisibles qui attaquent les capsules de la colonie, et le pilote est payé pour les chasser. Plus tard, on les voit veiller sur les créatures marines, et à [[station/14]] ils renversent une bataille perdue. Avec le recul, leurs premiers raids ressemblent à une résistance de leur propre cru contre le pillage de l'océan, même si le jeu laisse leurs motivations en grande partie à deviner.", false],
		[48, "", "L'argent et la loyauté traversent toute l'histoire. [[character/3]] trahit le mouvement pour une prime, et [[character/9]] vend le canon même qui brisera plus tard son attaque contre [[station/14]]. Le pilote, qui ne voulait au départ que le prix d'un billet de retour, finit parmi les commandants du mouvement, tandis que les plaintes de [[character/1]] sur la maigre paie deviennent une plaisanterie récurrente plutôt qu'un mobile.", false],
		[48, "", "Le mouvement gagne l'essentiel de son terrain initial par la persuasion, et l'embuscade de [[station/10]] marque le moment où la persuasion ne suffit plus. La campagne referme ensuite la boucle à [[station/0]], la station où [[character/9]] payait autrefois la pêche du pilote à prix fixe. Après le dernier chapitre, le pilote reste libre de pêcher, de commercer et d'accepter des contrats dans un océan désormais acquis aux rebelles.", false],
	],
	"world/ocean": [
		[1, "", "L'océan est le cadre de DEEP : une planète dont le monde habitable se trouve loin sous les vagues. Ses colons vivent dans des stations pressurisées à des milliers de mètres de profondeur, et les sous-marins sont le seul moyen de circuler entre elles. Tout ce que la colonie mange, vend et fabrique sort de l'eau, des poissons et des algues jusqu'aux marchandises qu'on en tire. Cet article décrit l'océan en tant que lieu : ses profondeurs, sa lumière, sa faune et la manière dont cette vie réagit à ceux qui la chassent.", false],
		[1, "", "Le pilote y arrive en nouveau venu, avec un petit sous-marin de pêche et l'ordinateur de bord [[character/1]], et regrette bientôt d'être venu. Pour ceux qui dirigent les stations, voir [[world/colony]] ; pour les trajets entre elles, voir [[world/stream]].", false],
		[1, "Profondeur et pression", "La profondeur est le trait déterminant de l'océan. Aucun fond marin n'arrête une plongée : un sous-marin peut continuer à descendre jusqu'à ce que l'eau l'écrase. Ce qui maintient un vaisseau en vie, c'est une tranche de profondeur sûre fixée par son équipement. Le bouclier détermine jusqu'où il peut monter, et le blindage jusqu'où il peut descendre. Une coque dépourvue des deux n'est en sécurité que dans une mince tranche d'eau, entre 22 000 et 23 000 m environ.", false],
		[1, "", "Hors de sa tranche, un vaisseau subit la pression. Après quelques secondes de répit, l'eau commence à user sa protection, une couche après l'autre puis la coque elle-même, et les dégâts augmentent à mesure que le vaisseau s'éloigne au-dessus de 15 000 m ou au-dessous de 30 000 m. On survit à de brèves incursions, pas à de longues. Les valeurs de chaque équipement figurent sur sa propre page, et [[guide/depth]] explique les règles en détail.", false],
		[1, "Où se trouvent les stations", "Les deux cents stations de la [[chart]] sont ancrées à des profondeurs fixes, presque toutes entre 15 000 et 30 000 m. Plus de la moitié, 109 au total, se situent entre 20 000 et 25 000 m, la tranche que peut atteindre le [[ship/0]] de départ. Une cinquantaine se trouvent plus haut et environ quarante-cinq plus bas. Les extrêmes sont [[station/28]], la plus haute à 13 500 m, et [[station/81]], la plus profonde à 32 250 m.", false],
		[1, "", "La profondeur ne suit pas la géographie. Stations peu profondes et stations profondes se côtoient sur toute la carte, si bien que des voisines sur le plan peuvent être séparées de milliers de mètres à la verticale. [[station/14]], près du centre de la carte, se trouve à portée facile à la fois de [[station/25]], à 17 700 m, et de [[station/81]], loin en dessous. Pour planifier un itinéraire, un pilote doit lire la profondeur de chaque station, pas seulement sa distance. [[station/0]], où commence la carrière du pilote, se trouve au nord-ouest, à 22 500 m.", false],
		[1, "Lumière et eau", "La lumière du jour n'atteint pas les stations. Hors de leurs coques éclairées par des projecteurs, l'eau est sombre, et un sous-marin avance dans le cône de ses propres phares, que l'eau engloutit en quelques dizaines de mètres. De fines particules flottent et dérivent dans les faisceaux, et par endroits de pâles nappes de plancton lumineux luisent dans l'obscurité. Remonter au-dessus de 15 000 m, vers la lointaine surface, est récompensé par une distinction à part entière, [[medal/21]].", false],
		[1, "", "L'eau n'a pas partout la même couleur. Chaque région prend une légère teinte due au plancton et aux algues qui y prospèrent, plus marquée près des stations où ces algues se plaisent le plus. De lents courants agitent les particules en suspension, mais ils ne font que partie du décor : ils ne dévient jamais un sous-marin de sa route et n'emportent jamais une prise.", false],
		[1, "Vie marine", "L'océan abrite treize espèces animales et cinq espèces d'algues. Elles vont de prises petites et faciles, comme les [[species/2|méduses]], les [[species/0|nautiles]] et les [[species/4|bancs de poissons]], à de puissants nageurs comme [[species/7]] et [[species/8]]. Parmi les curiosités des grands fonds figurent [[species/5]], [[species/1]], [[species/6]], [[species/9]] et [[species/11]], cuirassé. [[species/3]] et [[species/10]], qui change de couleur, sont prisés pour le cuir et la peinture.", false],
		[1, "", "Le plus grand animal est [[species/12]], qui peut peser environ 30 t, plus que toute la cale d'un petit sous-marin. Les animaux plus lourds et plus résistants se débattent plus longtemps au bout du harpon et rapportent en général davantage, mais aucune espèce ne vaut le même prix partout. Chaque page d'espèce indique les stations dans les eaux desquelles elle vit et les marchandises qu'on en tire.", false],
		[1, "", "Chaque station a son propre mélange de faune, généralement cinq ou six espèces. Une vingtaine d'animaux nagent à tout moment dans les eaux d'une station, tirés de ce mélange local. Un pêcheur apprend vite quelles stations visiter pour quelle prise, et la carte peut indiquer où se trouve chaque espèce déjà capturée. Voir [[guide/fishing]].", false],
		[1, "Le fond marin et les algues", "Les cinq algues, [[species/17|verte]], [[species/16|rouge]], [[species/15|brune]], [[species/14|bleue]] et la précieuse [[species/13|dorée]], sont les plantes de l'océan. Elles poussent enracinées sur place au lieu de nager, pèsent chacune 2 t fixes et cèdent au harpon presque aussitôt. Leur valeur tient à ce qu'elles deviennent : [[goods/21]] demande des algues vertes, [[goods/27]] des dorées et des rouges, et [[goods/28]] un peu des cinq.", false],
		[7, "", "Les algues poussent aussi sur les surfaces extérieures des stations elles-mêmes, avec d'autres petits organismes. Elles sont l'une des nourritures préférées des nautiles, ce qui explique pourquoi ces animaux se rassemblent en nombre autour des stations.", false],
		[1, "Comment le monde vivant réagit", "Les animaux n'attendent pas sagement d'être capturés. Une créature blessée, par un tir ou une balle perdue, détale, et une créature harponnée se débat jusqu'à l'épuisement. Un animal tué sur le coup est perdu comme prise : sa carcasse remonte et ne peut être récupérée que sous forme de [[goods/18]], qui ne vaut qu'une fraction de l'animal vivant. Les pilotes qui veulent une prise intacte gardent leurs canons bien loin des poissons.", false],
		[1, "", "En jeu, les eaux ne s'épuisent jamais. Quand le pilote s'en va, la faune laissée derrière lui est renouvelée : un bon coin de pêche le reste. La lutte autour de la vie marine apparaît plutôt sur le tableau des contrats, où certains commanditaires paient pour faire traquer une espèce et d'autres pour faire protéger un banc d'animaux contre les chasseurs. Voir [[contract/7]] et [[contract/6]].", false],
		[4, "", "Dès que le pilote possède une arme, [[character/1]] met en garde contre les tirs sur les poissons mêmes qu'ils sont venus pêcher.", false],
		[7, "", "La colonie traite la faune qui la gêne comme une nuisance à éliminer. Au [[chapter/7|chapitre 7]], le pilote est envoyé chasser les nautiles des eaux de [[station/1]], où ils bloqueraient les routes des convois.", false],
		[9, "", "La battue ne sert pas à grand-chose. Le fonctionnaire qui la paie admet que les animaux reviennent sans cesse, quel que soit le nombre éliminé.", false],
		[15, "", "Les [[faction/rebels]] voient la mer autrement. Ils ne prélèvent que ce qu'elle peut céder, transforment leurs prises en marchandises et veillent à ne pas surpêcher, afin de préserver la diversité de la vie dans l'océan.", false],
		[19, "", "Au [[chapter/19|chapitre 19]], le pilote protège un banc de [[species/10|pieuvres]] près de [[station/7]] contre des chasseurs colons. Des Aquariens nagent aux côtés des animaux et semblent veiller sur eux ; voir [[world/aquarians]].", false],
		[21, "", "Selon la dirigeante rebelle [[character/2]], la colonisation rapide dépouille l'océan plus vite que ses plantes et ses animaux ne peuvent se rétablir. Si cela continue, prévient-elle, la planète finira épuisée, comme d'autres mondes avant elle.", false],
		[48, "", "L'administration coloniale disparue à la fin de la guerre, les rebelles s'attendent à ce que l'océan mette longtemps à guérir, mais ils comptent bien mener cette tâche à bout.", false],
		[1, "Dangers des profondeurs", "Outre la pression, l'océan recèle des dangers humains. Les [[faction/pirates]] s'attaquent aux vaisseaux isolés en eaux libres, et dans les chapitres plus avancés certains guettent près des stations. Champs de mines, débris à la dérive et convois armés apparaissent dans les contrats et dans l'histoire. Pour savoir qui contrôle quelle partie de l'océan, voir [[world/colony]] et [[guide/allegiance]].", false],
	],
	"world/stream": [
		[1, "", "Le réseau S.T.R.E.A.M. est le système de portes de transit qui relie les stations de la colonie. Chaque station possède une porte à quelque distance au large, et un sous-marin qui y entre ressort presque aussitôt par la porte d'une autre station. Sans le réseau, traverser la [[chart]] demanderait de longs voyages dans les eaux libres et sombres. Grâce à lui, un seul pilote peut travailler sur tout l'océan. Le réseau est un élément central du jeu autant qu'un pilier de l'univers ; pour les commandes, voir [[guide/navigation]].", false],
		[1, "Les portes", "La porte de chaque station se trouve en eaux libres, à l'écart des quais. Les vaisseaux quittent le secteur d'une station par sa porte et arrivent à la porte de leur destination, d'où ils rejoignent le quai. Une porte s'ouvre de près : le pilote entre dans sa zone d'activation et ouvre la carte des portes, qui liste toutes les stations à portée.", false],
		[1, "", "Le trajet lui-même est presque instantané. Le vaisseau ressort à l'autre porte avec ses dégâts inchangés : un sous-marin malmené l'est toujours à l'arrivée. La faune locale, les patrouilles et toute rencontre en attente sont déjà présentes dans les eaux de destination.", false],
		[1, "Portée et moteurs", "Une porte ne couvre pas tout l'océan. Depuis n'importe quelle station, elle atteint environ un sixième de la largeur de la carte. Un meilleur moteur étend la portée en proportion de sa valeur : un moteur à +30 % porte environ trente pour cent plus loin. Les stations hors de portée demandent plusieurs sauts, ou une longue traversée au pilote auto, bien plus lente même avec l'accélération du temps.", false],
		[1, "", "La navigation en eaux libres reste utile pour les courts trajets. Le pilote auto conduit le vaisseau du secteur d'une station au suivant, et l'accélération du temps peut alors atteindre seize fois la vitesse normale, avant de revenir à la normale en cas de danger.", false],
		[1, "", "Le réseau ne tient aucun compte de la profondeur. Une porte livrera sans broncher un vaisseau à une station située hors de sa tranche de profondeur sûre, après un avertissement, et la pression commence à user sa protection dès son arrivée. Vérifiez la profondeur d'une destination sur sa page de station avant de partir. Voir [[guide/depth]].", false],
		[1, "Portes et rencontres", "Les portes sont fermées pendant un combat. Si une rencontre de mission est active dans les eaux d'une station, ni la porte ni le quai ne peuvent être utilisés avant qu'elle soit résolue. Un pilote ne peut donc pas simplement fuir une embuscade par le réseau, et chaque contrat doit être mené à son terme ou échouer.", false],
		[1, "", "C'est aussi en franchissant une porte que les ennuis commencent. Entrer dans le secteur d'une station déclenche toute rencontre qui y attend, d'un criminel recherché à un convoi à protéger. Des patrouilleurs font leur ronde devant les portes, et dans les chapitres plus avancés des pirates peuvent guetter près de la station.", false],
		[1, "Nom", "Le nom du réseau s'écrit toujours sous forme d'abréviation, S.T.R.E.A.M., mais le jeu ne dit jamais ce que signifient les lettres. Le pilote et [[character/1]] considèrent les portes comme un élément ordinaire du quotidien, à la manière des routes ou des chemins de fer.", false],
		[1, "Rôle dans la colonie", "Le réseau est ce qui fait tenir la colonie. Il transforme deux cents stations dispersées en une seule économie : une prise peut être vendue loin de l'endroit où elle a été pêchée, et un contrat peut mener d'un bout à l'autre de la carte. Chaque arrivée dans une nouvelle station compte pour [[medal/13]], et le premier amarrage dans chacune compte pour [[medal/6]].", false],
		[5, "Dans l'histoire", "Le pilote découvre les portes très tôt, quand la première chasse aux pirates l'entraîne au-delà de [[station/0]]. Dès lors, presque chaque voyage de l'histoire passe par elles, et le pilote auto peut conduire le vaisseau jusqu'à la porte locale sur demande.", false],
		[12, "", "Les portes ignorent les frontières politiques. Quand le pilote se rend pour la première fois auprès de la résistance à [[station/3]], le vaisseau arrive dans des eaux que les rebelles disent neutres et se fait aussitôt interpeller par les gardes de la station.", false],
		[21, "", "Les opérations rebelles tirent parti des portes. Lors de la mission contre la bande de pirates près de [[station/8]], [[character/3]] attend le pilote près de la porte de la station avant de mener l'attaque.", false],
		[45, "", "Lors de l'assaut contre [[station/18]], l'escadron de [[character/12]] attend en position près de la porte, pour que l'attaque puisse commencer dès l'arrivée du pilote.", false],
	],
}
