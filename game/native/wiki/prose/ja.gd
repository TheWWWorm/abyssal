	"chapter/30": [
		[30, "あらすじ", "パイロットは、科学者の輸送船団が到着した[[station/14]]へ向かう。", false],
		[31, "結末", "[[character/5]]、[[character/4]]、[[character/2]]が待っている。アユミが計画を説明する。入植者は依然として反乱軍より数で勝っているため、アベル教授とそのチームが形勢を覆す兵器を三段階で作り上げるのだ。最初の段階は動力源であるバイオテック・ジェネレーターだ。アベルの試作機は入植者に盗まれ、彼らは自力で完成させようとしている。レアによれば、ジェネレーターは[[station/2]]の近くを航行する普通の入植者の輸送船団に紛れて運ばれている。どの艦船に積まれているかわからないため、パイロットとピエールは船団全体を止め、すべてのコンテナを回収しなければならない。", false],
	],
	"chapter/31": [
		[31, "あらすじ", "パイロット、[[character/5]]、[[character/4]]は[[station/2]]の近くで、盗まれたバイオテック・ジェネレーターを運ぶ入植者の輸送船団を迎え撃つ。どの艦船にジェネレーターが積まれているかわからないため、船団のすべての艦船を止めなければならない。船団の乗組員は食料と医薬品しか積んでいないと抗議し、[[character/4]]はブラックジョークで応じる。パイロットは積荷が沈む前に艦船を無力化し、ハープーンですべてのコンテナを回収しなければならない。", false],
		[32, "結末", "ジェネレーターを含むすべてのコンテナが回収され、チームは戦利品をアベル教授に引き渡すため[[station/14]]に戻る。", false],
	],
	"chapter/32": [
		[32, "あらすじ", "パイロットは回収した積荷を持って[[station/14]]に戻る。", false],
		[33, "結末", "アベル教授は戦利品を研究室へ運ぶ。[[character/2]]は[[character/5]]を[[station/14]]の外の哨戒に、[[character/4]]を格納庫に向かわせ、パイロットに第二段階を告げる。ジェネレーターには、その出力に見合う武器が必要だ。それが[[equipment/42]]、電力を食いすぎるため一度も艦船に搭載されたことのないステーション防衛砲である。最寄りの工場がある[[station/188]]は入植者の手にあるため、パイロットは[[station/15]]を当たることになる。この砲は売り物ではないため、アユミは賄賂用の大金を手渡す。", false],
	],
	"chapter/33": [
		[33, "あらすじ", "[[character/2]]の計画の第二段階が始まる。パイロットは[[equipment/42]]を手に入れるため、反乱軍のステーション[[station/15]]へ向かう。この砲は通常、入植者のステーション[[station/188]]で製造され、どこでも公には売られていない。パイロットはアユミから預かった多額の賄賂資金を携えているが、具体的な計画はなく、到着すれば何か機会が訪れることを期待している。", false],
		[34, "結末", "パイロットは[[station/15]]に到着する。伝手も計画もない以上、ステーションを見て回って何が出てくるか確かめるしかない。", false],
	],
	"chapter/34": [
		[34, "あらすじ", "[[station/15]]での手がかりは、地元の商人の在庫から始まる。目標は、このステーションでは違法な商品である[[goods/37]]を積荷として手に入れることだ。それが然るべき相手の注意を引く。", false],
		[35, "結末", "闇商人の[[character/8]]が近づいてきて、ほとんど何でも調達できると持ちかける。パイロットが[[equipment/42]]を求めると彼は驚愕するが、見返りを条件に手を尽くすと約束する。その見返りとは、[[character/11]]の排除だ。フェンコを始末するため治安当局に雇われた賞金稼ぎで、ステーションの近くを巡回している。", false],
	],
	"chapter/35": [
		[35, "あらすじ", "パイロットは[[station/15]]の近くで、[[character/8]]が排除を望む賞金稼ぎ[[character/11]]を追う。ラウルは単独ではなく護衛を連れており、パイロットをただの漁師だと軽くあしらおうとする。パイロットは手配中の艦船を撃破しなければならない。[[contract/0]]を参照。", false],
		[36, "結末", "ラウルは最後に口先で逃れようとするが、その艦船は撃破され、護衛も追い払われるか撃沈される。パイロットは[[character/8]]が約束を守るか確かめるために戻る。", false],
	],
	"chapter/36": [
		[36, "あらすじ", "パイロットは[[character/8]]の約束の品を受け取るため[[station/15]]にドッキングする。闇商人が本当に品物を用意しているかどうか、確信は持てない。", false],
		[37, "結末", "フェンコは[[equipment/42]]を見つけ出し、支払った賄賂の分だけ跳ね上がった値段で売ると言う。出どころを尋ねると、フェンコは売り手の名を明かす。[[character/9]]だ。[[character/1]]は、ジャックの強欲が自らの敵を武装させるという皮肉を面白がる。パイロットは状況が変わる前に砲を買って立ち去ることにする。", false],
	],
	"chapter/37": [
		[37, "あらすじ", "[[character/8]]は今や[[station/15]]で[[goods/38|Eclipse]]を売りに出している。パイロットは交易画面からそれを購入し、積み込まなければならない。値段は高いが、アユミの賄賂資金はまさにこのためのものだ。また、貨物室には大型の砲を積めるだけの空きが必要だ。[[guide/trading]]を参照。", false],
		[38, "結末", "砲が貨物室に収まり、[[character/1]]はほとんど信じられない様子だ。第二段階は完了した。パイロットは試作ジェネレーターの進み具合を確かめに[[station/14]]へ戻る。", false],
	],
	"chapter/38": [
		[38, "あらすじ", "パイロットは[[equipment/42]]を貨物室に積んで[[station/14]]に戻る。アベル教授が試作機をどこまで仕上げたのか、早く知りたいところだ。", false],
		[39, "結末", "[[character/2]]は砲の入手経路を知りたくないという。試作機はほぼ完成しているが、ひとつの部品だけは[[station/14]]では作れない。それが[[goods/36]]、藻類粒子のDNAを増幅してジェネレーターの発電反応を始動させる装置である。製造設備があるのは[[station/16]]だけなので、第三段階でパイロットはそこへ向かうことになる。[[character/1]]は、パイロットがひとりで反乱を切り盛りしているようだと評する。", false],
	],
	"chapter/39": [
		[39, "あらすじ", "第三段階が始まる。パイロットは、バイオテック・ジェネレーターに必要な[[goods/36]]を製造する設備を持つ唯一のステーション[[station/16]]へ向かう。[[station/16]]は大半のステーションより深い場所にあるため、安全にたどり着くにはより強力な装甲が必要になるかもしれない。[[guide/depth]]を参照。", false],
		[40, "結末", "パイロットは[[station/16]]にドッキングし、インキュベーターに何が必要かを調べ始める。簡単な仕事ではなさそうだ。", false],
	],
	"chapter/4": [
		[4, "あらすじ", "ステーションからの出航に関するチュートリアルの章。パイロットは海賊を探して[[station/0]]を出発するが、近くの海域は静かなため、M.A.I.は別のステーションへ移動することを提案する。", false],
		[5, "結末", "M.A.I.は長距離移動に使う海流網S.T.R.E.A.M.について説明する。艦船は必ずストリームの出口からセクターを離れ、次のセクターにはストリームの入口から到着する。この移動は自動操縦に任せられる。[[guide/navigation]]を参照。", false],
	],
	"chapter/40": [
		[40, "あらすじ", "パイロットは[[station/16]]のステーション工場で[[goods/36]]を生産しなければならない。インキュベーターは高度な製品で、そのレシピには、先に別の場所で獲るか、買うか、作る必要があるかもしれない材料がいくつも含まれる。[[character/1]]もパイロットも、厄介な仕事になると予想している。[[guide/trading]]を参照。", false],
		[41, "結末", "インキュベーターが完成する。M.A.I.は、パイロットにできるとは思っていなかったと認める。これが正しいことなのかという不安を抱えたまま、パイロットは[[station/14]]へ針路を取る。", false],
	],
	"chapter/41": [
		[41, "あらすじ", "パイロットは[[goods/36]]を、アベル教授が試作ジェネレーターの完成を待つ[[station/14]]まで無事に届けなければならない。これが[[character/2]]の三段階計画の最後に欠けていたピースである。", false],
		[42, "結末", "[[character/5]]がインキュベーターを受け取る。アベル教授の準備はすべて整っており、[[equipment/42]]はまもなく格納庫で入手できるはずだ。アユミはすぐに海賊相手に砲を試すことを望み、レアは試作品にすぎないジェネレーターへの注意を添えて座標を伝える。電源を切られていたはずの[[character/1]]は、一言残らず聞いていたことを隠さない。", false],
	],
	"chapter/42": [
		[42, "あらすじ", "[[station/14]]の格納庫で[[equipment/42]]を装着したパイロットは、実戦で試すため[[station/17]]近くの海賊の隠れ家へ向かう。ジェネレーターは試作品にすぎないため、この試験は負荷に耐えられるかの確認でもある。相手の正体を知った海賊は増援を呼び、戦闘の最中にさらに艦船が到着する。", false],
		[43, "結末", "戦闘が終わると、[[character/1]]が[[station/14]]からの救難信号を捉える。暗号化されていない回線で公然と発信されたものだ。パイロットはただちに引き返す。", false],
	],
	"chapter/43": [
		[43, "あらすじ", "入植者の部隊が[[station/14]]に奇襲をかけた。多くのドックが損傷し、反乱軍は十分な数の艦船を出撃させられない。[[character/9]]が攻撃を率いてパイロットを嘲るが、[[equipment/42]]の発射準備が整ったと聞いて態度を変える。パイロットはステーションと友軍艦を守らなければならない。", false],
		[44, "結末", "戦いの最中にアクアリアンが現れ、入植者に襲いかかり、反乱軍の側について戦う。攻撃が崩れると、ジャックは戦場を放棄する。[[character/2]]はこの救援を奇跡と呼び、特別な客がいると言ってパイロットにドッキングを求める。", false],
	],
	"chapter/44": [
		[44, "あらすじ", "戦いの後、パイロットは[[station/14]]にドッキングする。", false],
		[45, "結末", "特別な客とはアクアリアンの使節だった。アクアリアンは、誰もが海と調和して暮らせるよう、入植者の支配を終わらせる手助けをするという。[[character/2]]は残りのステーションを奪取するため、二つの大規模な攻勢を計画する。[[station/188]]が反乱軍の手に渡ったことで、できるだけ多くの艦船が[[equipment/42]]で武装されつつある。パイロットは新たな部隊とアクアリアンの支援を得て[[station/18]]への攻撃を率い、[[character/5]]は[[station/109]]への攻撃を率いる。", false],
	],
	"chapter/45": [
		[45, "あらすじ", "[[station/18]]でパイロットは、アトモス部隊の隊長[[character/12]]と合流する。部隊の艦船は攻撃命令を待っている。アクアリアンも深海から浮上して加わる。ステーションを奪取するには、輸送船を含むすべての入植者の艦船を撃破しなければならない。その間、[[character/5]]は[[station/109]]への攻撃を並行して率いる。", false],
		[46, "結末", "入植者の守備隊と輸送船は全滅し、反乱軍とアクアリアンの連合軍がステーション周辺の海域を制圧する。パイロットはコリンの部隊の半数をステーション周辺の哨戒に回し、残りを率いてドッキングする。", false],
	],
	"chapter/46": [
		[46, "あらすじ", "パイロットは[[character/12]]の部隊の一部と共に[[station/18]]にドッキングし、制圧したステーションを確保する。残りの部隊は外で哨戒にあたる。", false],
		[47, "結末", "[[character/5]]から、[[station/109]]への攻撃も成功し、南部のステーションが反乱軍の支配下に入ったとの報告が届く。アユミがパイロットに与えたのは、おそらく最後となる任務だ。標的は[[station/0]]、入植者に残された最後の大拠点であり、パイロットの物語が始まったステーションである。守りは堅く、[[character/2]]はすでに向かっている。レアも後を追うが、海賊に行く手を阻まれている。", false],
	],
	"chapter/47": [
		[47, "あらすじ", "[[station/0]]でパイロットは[[character/2]]、[[character/5]]と合流し、最後の戦いに臨む。ステーションを奪取するには、守備側の艦船をすべて撃破しなければならない。守備隊の中には[[character/9]]の姿もある。パイロットが[[character/3]]の末路を持ち出すと、ジャックは自分がパイロットの父親で、レイモンドはパイロットの兄弟だという突拍子もない話で動揺させようとする。パイロットはすぐにそれを見抜く。", false],
		[48, "結末", "入植者の艦隊は次々と沈み、ついにジャックだけが残る。彼は素早く手強いが、パイロットはついにその艦船を無力化する。ジャックは救命カプセルで上方へ脱出する。そのカプセルはステーションごと持ち去るかのような勢いで、彼は去り際に惑星をあざける。戦いは終わった。", false],
	],
	"chapter/48": [
		[48, "あらすじ", "戦争は勝利に終わる。入植者の艦隊は敗れ、[[character/9]]は惑星から逃亡し、[[station/0]]と最後まで抵抗していたステーションも反乱軍の大義に加わる。今やすべてのステーションが運動の側に立っている。", false],
		[48, "", "勝者たちは状況を振り返る。[[character/2]]はパイロットと[[character/5]]に感謝し、惑星の傷が癒えるには長い時間がかかると認めつつも、それもやり遂げられると信じている。レアはパイロットを[[goods/21]]での祝杯に誘い、パイロットは応じる。パイロットが陸に戻ったらメモリを増設すると約束された[[character/1]]は、そんなものは要らないと言い張り、最後まで二人をからかい続ける。", false],
		[48, "", "キャンペーンはこれで完了だ。反乱軍との和平が成った世界で、パイロットは引き続き探索し、交易し、契約を請け負うことができる。", false],
	],
	"chapter/5": [
		[5, "あらすじ", "パイロットの初陣は[[station/1]]の近くで行われる。M.A.I.は武器とハープーンの切り替え方、自動射撃の利点、レーダーの読み方を説明する。赤い印は敵、緑の印は友軍、黄色の印はウェイポイントだ。まもなく[[faction/pirates|海賊]]が一隻、レーダーに現れる。[[guide/combat]]を参照。", false],
		[6, "結末", "海賊は撃破される。M.A.I.は、残骸から積荷のコンテナが残ることと、手の届かない深さに沈む前ならハープーンで回収できることを指摘し、[[station/0]]への帰路を設定する。", false],
	],
	"chapter/6": [
		[6, "あらすじ", "初めての戦闘に勝利したパイロットは、使える武器と、場合によっては売却できる回収品を携えて[[station/0]]に戻る。ストリーム網を通る短い帰路である。", false],
		[7, "結末", "[[character/9]]は新しい武器に目を留め、彼の言う「本物の仕事」を持ちかける。[[station/1]]周辺の輸送航路に[[species/0|オウムガイ]]が群がっており、ステーションの警備部門が排除を求めているのだ。パイロットは、この生物はステーションの外壁に生えたものを食べているだけで、貨物室も小さすぎて全部は運べないと反論する。だがジャックはどちらの反論も退ける。手段は問わず、とにかく消えてもらわねばならないというのだ。", false],
	],
	"chapter/7": [
		[7, "あらすじ", "パイロットは[[station/1]]の近くで[[species/0|オウムガイ]]を排除しなければならない。倒しても捕獲しても数に入る。生物は数が少なく無害なため、パイロットも[[character/1]]もこの仕事には気が進まないが、やり遂げることにする。", false],
		[8, "結末", "この仕事はパイロットの心に重くのしかかる。この惑星には漁をしに来たのであって、植民地の都合で動物を殺すために来たのではない。M.A.I.は報酬がせめてもの埋め合わせになることを願い、報酬を受け取りに[[station/1]]へドッキングするよう勧める。", false],
	],
	"chapter/8": [
		[8, "あらすじ", "パイロットはオウムガイ狩りを報告するため[[station/1]]にドッキングする。", false],
		[9, "結末", "入植者の役人は軽蔑を隠そうともせずにパイロットを迎え、この仕事を害獣駆除扱いし、生物はまた戻ってくるのでおそらく無意味だと認める。提示された報酬はわずかで、交渉の余地もない。次の仕事を任せる前に、役人は実力の証明として、ステーションの掲示板の仕事を三件こなすことを求める。[[character/1]]は契約の探し方を説明し、仕事の現場によっては艦船の深度限界を超える場所があると警告し、ステーションのマップでルートを計画する方法を教える。", false],
	],
	"chapter/9": [
		[9, "あらすじ", "請負仕事に関する章。パイロットはいずれかのステーションの掲示板から契約を三件達成しなければならない。契約は護衛やサルベージから漁獲の注文までさまざまで、複数のステーションを見比べると得をする。[[guide/contracts]]を参照。", false],
		[10, "結末", "満足した入植者の役人は、特別な任務を持ちかける。入植者がアクアリアンと呼ぶ、半人半魚の謎の存在が、植民地の商品を軌道上へ打ち上げて回収させる輸送カプセルを襲っているのだ。カプセルの損傷や紛失は、交易当局からのステーションの評価を下げる。次の打ち上げは[[station/2]]で行われ、[[character/9]]が指揮を執る。パイロットはアクアリアンを追い払い、彼に報告することになる。", false],
	],
	"character/0": [
		[1, "", "パイロットはプレイヤーキャラクターである。植民地化された海洋世界にやって来た新参者で、小型潜水艇を操り、漁師として生計を立てている。名前はプレイヤーが決め、ミッション記録の短い章の要約はパイロット自身のメモとして書かれている。艦載コンピューター[[character/1]]がほぼすべての行動に口を出すので、海の上でパイロットが一人きりになることはない。物語は、パイロットが植民地に漁獲を売る[[station/0]]から始まる。", false],
		[1, "背景", "キャンペーン以前のパイロットの人生については、ほとんど語られない。パイロットは漁をするためにこの惑星へ来たが、最初のミッションから移住を後悔しており、艦船のコンピューターの指図を受けねばならないことをぼやいている。それ以外のことは、パイロットの言動からつなぎ合わせるしかない。", false],
		[7, "", "パイロットは海とその生き物をよく知っている。植民地が輸送航路に群がる[[species/0|オウムガイ]]に苦情を言うと、パイロットは、この動物はステーションの外壁を覆う藻類などを食べているのだから、そこにいるのは当然だと指摘する。", false],
		[12, "", "最初、パイロットの目標はささやかだ。惑星を出る切符代を稼ぎたいだけなのだが、漁獲に支払われる一律の価格では、その目標に手が届かない。後にレジスタンスへの参加を願い出たとき、パイロットは[[station/0]]を出身地として告げる。", false],
		[1, "植民地の漁師", "物語は、パイロットが貨物室を満たし、[[station/0]]へ針路を取るところから始まる（[[chapter/1]]、[[chapter/2]]）。", false],
		[3, "", "そこで[[character/9]]は漁獲に一律の値段を払い、小さな貨物室をあざ笑い、代わりに[[faction/pirates|海賊]]狩りをしてみてはどうかと勧める。", false],
		[6, "", "パイロットは[[equipment/0]]を装着し、[[station/1]]の近くで最初の海賊を撃墜する（[[chapter/3]]〜[[chapter/5]]）。", false],
		[7, "", "次に[[character/9]]が持ちかけるのは、もっと不快な仕事だ。[[station/1]]周辺の航路から[[species/0|オウムガイ]]を一掃するのである（[[chapter/7]]）。", false],
		[8, "", "この駆除にパイロットは嫌悪を覚える。漁をしに来たのであって、無害な動物を殺戮しに来たのではない。", false],
		[10, "", "[[station/1]]の植民地の役人はわずかな報酬しか払わず、信頼性の証明として契約三件を求め（[[chapter/9]]）、その後パイロットを[[station/2]]へ送って、[[world/aquarians|アクアリアン]]から輸送カプセルを守らせる（[[chapter/10]]）。", false],
		[12, "", "パイロットは戦いに勝つが、そもそもなぜ[[world/aquarians|アクアリアン]]が攻撃してくるのか疑問を抱き始める。[[character/9]]がカプセルの損傷をパイロットのせいにして報酬を出し渋ると、[[character/1]]は[[station/3]]のレジスタンス運動の通信を傍受していたことを明かし、パイロットはそれを探し出す決意をする（[[chapter/12]]）。", false],
		[12, "レジスタンスへの参加", "[[station/3]]で反乱軍の警備兵に発砲すると脅され、パイロットはしどろもどろに名前と参加の意思を告げて、ようやくドッキングを許される。", false],
		[13, "", "[[character/4]]がパイロットを見習いとして受け入れたのは、主に運動が一人でも多くの人手を必要としているからだ。彼はパイロットを[[station/4]]へ連絡員を迎えに行かせる（[[chapter/13]]）。", false],
		[14, "", "連絡員は[[character/5]]で、彼女を[[station/5]]まで運ぶ間、パイロットは見るからに心を奪われている（[[chapter/14]]）。", false],
		[16, "", "[[character/5]]はパイロットに反乱軍流の海との暮らし方を教え（[[chapter/15]]）、続いて運動のために新しいステーションを偵察するよう頼む（[[chapter/16]]）。パイロットが「革命」という言葉を耳にするのはこれが初めてだ。", false],
		[18, "", "[[station/3]]に戻ると、[[character/4]]は運動の外交上の成果を報告し、ほとんど手がかりのないまま、指導者を探すようパイロットを送り出す（[[chapter/18]]）。", false],
		[19, "指導者の下で", "指導者は[[character/2]]で、[[station/6]]でパイロットと対面する。パイロットは男性を予想していた。彼女の最初の命令は、[[species/10|イカ]]の群れを入植者の狩人から守ることだ（[[chapter/19]]）。", false],
		[21, "", "彼女がついに運動の目的を説明すると、パイロットは大義に身を捧げる。彼女はエースの[[character/3]]と共に、パイロットを海賊団の討伐に送り出す（[[chapter/21]]）。", false],
		[23, "", "[[character/3]]はパイロットを厄介者扱いする。[[station/9]]でパイロットは、[[character/9]]が今や運動の敵であることを知り、反乱軍の補給路に彼が敷設した機雷原の除去に意気込んで取りかかる（[[chapter/23]]）。", false],
		[25, "", "[[character/5]]と再会したパイロットは、[[station/10]]での会談に向かう[[character/2]]と[[character/3]]の護衛を任される（[[chapter/25]]）。", false],
		[26, "", "[[character/9]]の部隊が待ち構えている。[[character/3]]は武器が故障したと言って逃げ出し、パイロットと[[character/5]]だけで[[character/2]]を守る。その後[[character/2]]は身を隠し、はるかに腕の立つ戦士になるようパイロットに告げる（[[chapter/26]]）。", false],
		[27, "裏切りと救出", "その後、[[character/3]]から緊急の情報があるという連絡が入る。パイロットは罠を疑いつつも、[[station/11]]の近くで会うことに同意する（[[chapter/27]]）。", false],
		[28, "", "それは罠だった。[[character/3]]は[[character/2]]を捕らえており、降伏を要求する。[[character/1]]の作戦に従い、パイロットはM.A.I.が彼の艦船をスキャンする間、この戦いは金ではなく信念のためのものだと語りかけて話を引き延ばす。そしてパイロットは彼の艦船を撃破し、深く沈みすぎる前に装甲貨物室を回収する。中には[[character/2]]が生きていた（[[chapter/28]]）。", false],
		[31, "三段階の計画", "科学者の輸送船団を守った後（[[chapter/29]]）、パイロットは[[world/abel]]と共に兵器を作るという[[character/2]]の計画を知る。パイロットは[[character/4]]、[[character/5]]と共に、入植者の輸送船団から[[world/biotek]]を奪取する（[[chapter/31]]）。", false],
		[33, "", "次にパイロットは、売り物ではない[[equipment/42]]砲を、賄賂の資金だけを頼りに手に入れなければならない。パイロットはこの任務の裏にほとんど計画がないことを指摘しつつも、喜んで引き受ける（[[chapter/33]]）。", false],
		[37, "", "[[station/15]]で闇商人の[[character/8]]は、パイロットが賞金稼ぎの[[character/11]]を殺すなら砲を探すと約束する（[[chapter/35]]）。パイロットはそれを果たし、[[character/8]]が[[character/9]]から仕入れた砲を購入する（[[chapter/37]]）。", false],
		[39, "", "[[character/2]]は砲の入手方法を知りたがらず、パイロットは罪のない人は死んでいないとだけ答える。この計画は惑星を支配するのにも使えそうだとパイロットが冗談を言うと、彼女はその考えをきっぱりと否定する（[[chapter/39]]）。", false],
		[42, "", "その後パイロットは[[station/16]]で[[goods/36]]を生産し、[[station/14]]へ届けて兵器を完成させる（[[chapter/41]]）。", false],
		[43, "勝利への道", "完成した兵器を[[station/17]]の近くで海賊相手に試していたパイロットは、[[station/14]]からの救難信号を聞いて引き返し、[[character/9]]が奇襲を率いているのを目にする（[[chapter/43]]）。", false],
		[44, "", "[[world/aquarians|アクアリアン]]の助けで攻撃は打ち破られ、[[character/9]]は逃走する。", false],
		[46, "", "[[character/2]]はパイロットに[[station/18]]への攻撃の指揮を任せる（[[chapter/45]]）。パイロットがまず心配するのは、第二の攻撃を率いる[[character/5]]のことだが、パイロットは[[character/12]]の部隊と[[world/aquarians|アクアリアン]]の支援を得てステーションを奪取する。", false],
		[47, "", "最後の戦いは、物語が始まった[[station/0]]で行われる（[[chapter/47]]）。[[character/9]]は自分がパイロットの父親で、[[character/3]]がパイロットの兄弟だと主張して動揺させようとするが、パイロットはその嘘をすぐに退ける。", false],
		[48, "", "[[character/9]]は追い払われ、植民地の最後の拠点が陥落する。パイロットは共に戦った仲間たちに功績を譲り、[[character/5]]の祝杯の誘いを受ける。", false],
		[1, "人物像", "パイロットは現実的で口が達者で、従うより言い返すほうを好む。[[character/1]]との軽口の応酬は、キャンペーン全体を通じて続く。", false],
		[8, "", "冗談の裏で、パイロットには良心がある。利益のために動物を殺すことを嫌い、オウムガイの駆除の後には気分が悪くなる。", false],
		[14, "", "[[character/5]]の前ではパイロットは口ごもり、ぎこちなくなる。それには彼女も[[character/1]]も気づいている。", false],
		[28, "", "パイロットの動機はキャンペーンを通じて変わっていく。[[character/3]]と対決する頃には、パイロットはこの闘争は理想のためのものであり、彼は強欲に目がくらんでいると論じるようになる。", false],
		[1, "人間関係", "[[character/1]]はパイロットの最も身近な相棒である。二人は絶えず言い争うが、パイロットはM.A.I.の助言を、後にはその機転を頼りにしている。", false],
		[3, "", "[[character/9]]はパイロットの最初の雇い主であり、やがて長年の宿敵となる。", false],
		[14, "", "パイロットは初めて会ったときから[[character/5]]に惹かれており、その気持ちは互いのものであるようだ。", false],
		[19, "", "[[character/2]]は運動の最も繊細な任務をパイロットに任せるようになる。彼女はパイロットに、温かさと、からかうような、ほとんど親のような威厳をもって接する。", false],
		[1, "プレイヤーキャラクターとして", "ゲーム中のパイロットは、プレイヤー次第でどんな人物にもなる。章の目標の合間には、自由に漁をし、交易し、契約を請け負い、戦い、艦船を改装できる。ストーリーが先に進むのは章の目標を達成したときだけである。基本は[[guide/basics]]で解説している。", false],
	],
	"character/1": [
		[1, "", "[[character/1]]はパイロットの潜水艇の艦載コンピューターであり、キャンペーンを通じてパイロットの相棒である。艦船のシステムを管理し、漁、移動、戦闘の方法を説明し、絶え間なく助言や論評を口にする。そのユーモアは辛口で、パイロットをネタにすることも多いが、ただのしゃべる取扱説明書以上の存在であることが明らかになっていく。", false],
		[1, "相棒として", "実際には[[character/1]]がゲームのガイド役である。新しい仕組みはすべてM.A.I.を通じて紹介される。ハープーンでの漁、自動操縦、そしてステーションではヘルプ画面だ。ミッション中は無線で発言し、標的を示し、脅威を警告する。", false],
		[5, "", "また、[[world/stream]]ネットワークを使った長距離移動や、レーダーの読み方も説明する。レーダーでは敵と味方が色の付いた点で表示され、ウェイポイントがルートを示す。戦闘の後には、撃破した艦船が残した積荷を回収するようパイロットに念を押す。", false],
		[12, "", "その役割は指導にとどまらない。無線のチャンネルをスキャンし、マップにステーションを記し、メッセージを伝える。", false],
		[28, "", "近距離で他の艦船をスキャンすることもでき、この能力は[[character/3]]との対決で決定的な役割を果たす。", false],
		[1, "ストーリーでの役割", "キャンペーンは、仕事は漁であって愚痴をこぼすことではないと[[character/1]]がパイロットに言い聞かせるところから始まる。", false],
		[3, "", "M.A.I.は[[character/9]]を低く評価していることを隠さず、売りに出ている[[equipment/0]]を買うようパイロットを促す。", false],
		[4, "", "武器を装着すると、海賊を相手に試すよう勧め、その捜索を主導する。", false],
		[7, "", "[[species/0|オウムガイ]]の駆除には不満で、数がこれほど少ないのになぜ殺さなければならないのかと問う。", false],
		[8, "", "狩りの後、パイロットがひどく動揺していることに気づくが、例によってまず考えるのは、せめて報酬は良いのかということだ。", false],
		[11, "", "[[world/aquarians|アクアリアン]]が[[station/2]]でカプセルを襲ったとき、この生き物たちは入植者が考えるよりずっと賢いのかもしれないと最初に示唆したのはM.A.I.である。", false],
		[12, "転機", "[[character/1]]がメインストーリーの口火を切る。[[character/9]]がまたしてもパイロットを騙したとき、M.A.I.は、パイロットはわずかな見返りのために懸命に働き、漁獲について何の発言権もないと訴える。そして[[station/3]]で結成されつつあるレジスタンスの信号を傍受したことを明かし、マップにそのステーションを記して、判断をパイロットに委ねる（[[chapter/12]]）。", false],
		[12, "", "到着すると目立たずに近づくことを提案するが、反乱軍の警備兵がすぐに艦船を誰何したため、その案を取り下げる。", false],
		[14, "反乱軍の中で", "パイロットと[[character/5]]の間の温かい雰囲気を、M.A.I.は即座に嫌う。嫉妬しているとパイロットにからかわれると、[[character/5]]のお気に入りの言い回しを皮肉たっぷりに真似て返す。二人についての当てこすりは、キャンペーンの最後まで続く。", false],
		[17, "", "運動のメッセージを中継し、[[character/4]]の長い手紙のひとつを一文に要約する。", false],
		[18, "", "ほとんど手がかりのないまま指導者を探しに行かされると、反乱軍の組織力を疑う。", false],
		[19, "", "[[character/2]]に対しては金にうるさい面を見せ、なぜ報酬の話もせずに働くのかと問う。パイロットが[[character/2]]をかばうと、少なくとも自分は食べる必要がないと当てつけるように言う。", false],
		[22, "", "[[character/3]]の腕前には感心するが、彼の癇癪には近づかないようパイロットに忠告する。", false],
		[27, "人質", "[[character/3]]が会合を持ちかけてくると、[[character/1]]は罠だと断言する。", false],
		[28, "", "会合の場で、M.A.I.は真価を発揮する。安全だと感じている男は自分の動機を得意げに語るものだと見抜き、[[character/3]]に話を続けさせるようパイロットに頼む。その間に彼の艦船をスキャンして一人乗りであることを突き止め、[[character/2]]は装甲貨物室にいるに違いないと結論づける。この洞察のおかげで、パイロットは艦船を撃破しつつ[[character/2]]を救い出せる（[[chapter/27]]）。", false],
		[33, "戦争", "[[world/biotek]]と[[world/eclipse|Eclipse]]をめぐる任務の間も、安い報酬へのお決まりの不満を言い続ける。", false],
		[37, "", "砲の出どころが[[character/9]]だと判明すると、彼の強欲が自らの敵を武装させたという皮肉を楽しむ。", false],
		[39, "", "パイロットがたったひとりで反乱を戦っているようだとぼやく。", false],
		[41, "", "後に、その不満に対するパイロット自身の返事を、そっくりパイロットに返す。", false],
		[42, "", "[[station/14]]で[[character/5]]がパイロットを温かく迎えると、M.A.I.は自分の電源を切ると宣言するが、実はスタンバイ状態になっていただけだと判明する。", false],
		[43, "", "砲の実地試験中、[[station/14]]からの暗号化されていない公然の救難信号を受信し、何か深刻な事態が起きていることを即座に察知する。", false],
		[44, "", "続く戦闘では、[[world/aquarians|アクアリアン]]が反乱軍の側について戦うために到着したことを最初に報告する。", false],
		[48, "", "戦争が終わると、パイロットはM.A.I.にメモリの増設を約束するが、M.A.I.はその申し出をいささか侮辱的だと感じる。キャンペーンを締めくくる最後の一言も、パイロットと[[character/5]]についての辛口の論評である。", false],
		[1, "人物像", "[[character/1]]は賢く、遠慮のない物言いをし、尊大な相手には我慢がならない。損な取引を指摘するのが好きで、からかう機会はめったに逃さない。", false],
		[8, "", "本人が認める以上に思いやりもある。不必要な殺生を嫌い、パイロットの心の状態に気を配っている。", false],
		[28, "", "パイロットが途方に暮れたとき、重圧の中でも冷静なM.A.I.の思考が窮地を救う。", false],
		[1, "人間関係", "M.A.I.とパイロットは絶えず言い争うが、互いを完全に信頼している。", false],
		[3, "", "[[character/9]]のことは一目見て嫌う。", false],
		[14, "", "[[character/5]]への嫉妬はお決まりのジョークになっている。", false],
		[19, "", "[[character/2]]を尊敬しているが、報酬の少なさには不満を漏らす。", false],
		[22, "", "[[character/3]]にすぐさま見切りをつけ、その判断の正しさは後に証明される。", false],
	],
	"character/10": [
		[5, "", "[[character/10]]は、ミッション中に話す[[faction/pirates]]の無法者パイロットたちに使われる名前である。彼らは海のいたるところで船舶を襲い、艦船が武器を積んだパイロットにとって最初の標的となる。", false],
		[6, "話し手", "パイロットが最初に対峙する敵は[[station/1]]近くの海賊で、怒りの叫びと共に沈んでいく（[[chapter/5]]）。", false],
		[21, "", "入植者と反乱軍の対立が激しくなると、海賊はその混乱に乗じて手頃な獲物を狩るようになり、[[character/2]]は反乱軍が反撃しなければならないと決断する（[[chapter/21]]）。", false],
		[43, "", "[[station/17]]の近くで、ある海賊団が[[world/eclipse|Eclipse]]の最初の標的となる。そのうちの一人がパイロットの火力に慌てて救援を呼び、さらに多くの海賊が戦いに加わる（[[chapter/42]]）。海賊との戦い方は[[guide/combat]]で解説している。", false],
	],
	"character/11": [
		[35, "", "[[character/11]]は、闇商人[[character/8]]を始末するため[[station/15]]の治安当局に雇われた賞金稼ぎである。[[character/8]]は[[world/eclipse|Eclipse]]の代価として彼の死を求める。", false],
		[35, "背景", "[[character/8]]によれば、[[character/11]]は[[station/15]]近くの海域を巡回している。彼はステーション当局のために働く一種の法執行者であり、その標的は犯罪者だ。そのためパイロットの任務は道義的に後ろめたいものとなる。反乱軍に必要な兵器を手に入れるため、違法な品を扱う商人のために人を殺さなければならないのだ。", false],
		[36, "ストーリーでの役割", "パイロットが見つけたとき、[[character/11]]は単独ではなく、数隻の護衛を連れている。彼はパイロットを漁師と呼んで邪魔をするなと命じ、自分には仕事があると言い張る。戦況が不利になると、やはり穏便に済ませられないかと持ちかける。その艦船は撃破される（[[chapter/35]]）。", false],
		[37, "", "彼の死によってパイロットは[[character/8]]の協力を得て、闇商人はまもなく砲を売りに出す。", false],
		[39, "", "後にパイロットは[[character/2]]に、砲の入手で罪のない人は死んでいないとだけ伝える。", false],
		[36, "人物像", "[[character/11]]は、負けそうになるまでは自信満々で相手を見下し、負けが見えるとすぐに逃げ道を探す。パイロットを、邪魔に入り込んできたただの漁師、取るに足らない障害と見なし、ひどく見くびっている。", false],
	],
	"character/12": [
		[45, "", "[[character/12]]はアトモス部隊の隊長である。この[[faction/rebels|反乱軍]]の部隊は、最後の攻勢でパイロットの[[station/18]]攻撃に加わる。", false],
		[45, "ストーリーでの役割", "パイロットが[[station/18]]へ向かう間、[[character/2]]はパイロットのために部隊を集めると約束する。[[character/12]]の部隊はそのひとつだ。パイロットが到着すると、彼は艦船が配置につき、攻撃命令を待っていると報告する。同時に[[world/aquarians|アクアリアン]]の一団が深海から到着し、パイロットの号令で戦いが始まる（[[chapter/45]]）。", false],
		[46, "", "彼らは共に、輸送船さえ容赦せず、入植者の艦船をすべて撃破する。", false],
		[46, "", "戦闘の後、パイロットは[[character/12]]に、艦船の半数をステーション周辺の哨戒に回し、残りはパイロットと共にドッキングして制圧するよう命じる。彼は異を唱えずに了解する。", false],
		[47, "", "この戦いは、反乱軍の艦船と[[world/aquarians|アクアリアン]]がパイロットの指揮の下で肩を並べて戦った最初の戦いであり、その成功が植民地への最後の攻撃への道を開く。", false],
		[45, "人物像", "[[character/12]]は言葉少なで、命令に即座に従う。パイロットの指揮下に入った最初の反乱軍の士官であり、植民地のために漁をしていた頃からパイロットがどれほど出世したかを示している。きびきびとした事務的な無線での話しぶりは、パイロットの他の仲間たちの軽口とは対照的だ。", false],
	],
	"character/2": [
		[18, "", "[[character/2]]は、パイロットが[[station/6]]で出会う[[faction/rebels|レジスタンス]]の一員である。", false],
		[19, "", "運動の指導者である年配の女性で、最初に会ったときからパイロットの任務を取り仕切る。冷静で温かく、決然としており、植民地支配に対する運動の闘争を指揮している。", false],
		[21, "背景", "[[character/2]]が率いる運動は、自らを惑星の荒廃に反対する人々の連合と考えている。彼女の見方では、植民地化の速さと容赦ない海の収奪によって、海の植物や動物には回復する時間が残されておらず、他の世界もすでに同じようにして枯渇してしまった。彼女の戦略は、戦うことではなく、ステーションを運営する人々を味方につけることだ。", false],
		[23, "", "彼女は以前から[[character/9]]を知っている。初めて会った頃の彼は取るに足らない人物で、彼の出世は才能ではなく人脈のおかげだと彼女は考えている。", false],
		[31, "", "彼女はステーション各地に情報提供者の網を持ち、反乱軍の勢力圏全体で科学者、資金、艦船を動かす権限を持っている。", false],
		[19, "ストーリーでの役割", "[[character/2]]の最初の命令は護衛任務だ。パイロットは[[species/10|イカ]]の群れを入植者の狩人から守らなければならない（[[chapter/19]]）。彼女は報酬について何も言わず、運動の計画についてもほとんど語らない。新参者が信用できるかどうかを試しているらしい。パイロットは男性を予想していたと認めるが、彼女はそれを聞き流す。", false],
		[20, "", "彼女はこの仕事にささやかな報酬を支払い、さらなる仕事のためにすぐにパイロットを呼び戻す。", false],
		[21, "", "答えを求めるパイロットに、彼女は運動の目的を説明する。また、対立につけ込む海賊に思い知らせる必要があると判断し、最も優れた戦士[[character/3]]と共にパイロットを[[station/8]]近くの海賊団へ差し向ける（[[chapter/21]]）。", false],
		[22, "", "彼女は報酬を二人のパイロットに等分して[[character/3]]を苛立たせ、[[station/9]]での会談へと移る。", false],
		[23, "", "そこで彼女は、[[character/9]]が[[station/37]]への補給路に敷設した機雷原の除去にパイロットを送り出し、海賊と、作動させた後でなければ破壊できない機雷について警告する（[[chapter/23]]）。", false],
		[25, "待ち伏せ", "[[character/2]]の次の目標は[[station/10]]で、そこでさらに交渉すれば、より多くのステーションを反乱軍に引き入れられるはずだ。彼女は[[character/3]]、[[character/5]]、パイロットを護衛に連れて行き、[[character/3]]に対するパイロットの疑念を、頑固だが優れたパイロットだと言って一蹴する（[[chapter/25]]）。", false],
		[25, "", "到着すると、[[character/9]]が部隊を率いて待ち構えていた。[[character/2]]は、自分たちの計画が事前に知られていたことに衝撃を受ける。", false],
		[26, "", "[[character/3]]は戦いから逃げ出し、[[character/2]]と入植者の間に立ちはだかるのはパイロットと[[character/5]]だけとなる。その後彼女は破壊工作の可能性を口にするが、[[character/3]]は裏切り者だという[[character/5]]の非難は信じようとしない。彼女は身を隠し、[[station/9]]の指揮を[[character/5]]に任せ、外交だけでは戦争に勝てないかもしれないとパイロットに警告する（[[chapter/26]]）。", false],
		[28, "囚われの身", "[[character/3]]への信頼は見当違いだったことが明らかになる。彼は彼女を捕らえ、[[character/9]]に差し出そうとする。[[station/11]]付近での対決の間、彼女は自分の身の安全は気にするなとパイロットに訴える。パイロットは[[character/3]]の艦船の残骸の貨物室から彼女を救い出し、彼女は動揺しながらも無傷で[[station/12]]にたどり着く（[[chapter/28]]）。", false],
		[29, "", "それでも彼女がまず考えるのは運動のことだ。捕らわれる前、彼女は科学者の一団を[[station/14]]へ移す手配をしており、[[character/3]]がそれも敵に漏らしたのではないかと恐れて、すぐにパイロットをその輸送船団の護衛に送り出す（[[chapter/29]]）。", false],
		[31, "三段階の計画", "[[station/14]]で[[character/2]]は計画を明かす。反乱軍は依然として数で勝る植民地の艦隊とますます頻繁に衝突しており、彼女は兵器を作らせるため[[world/abel]]とそのチームを呼び寄せたのだ。作業は三段階からなり、第一段階は入植者が教授から盗んだ動力源[[world/biotek]]である。[[character/5]]が襲撃を準備する間、彼女は教授に会うために出発する（[[chapter/31]]）。", false],
		[33, "", "第二段階のために、彼女は通常ステーションの防衛に使われる砲[[world/eclipse|Eclipse]]を求める。最寄りの製造元[[station/188]]は入植者の手にあり、この兵器は売り物ではないため、彼女はパイロットに多額の賄賂資金を渡し、計画はそれ以上ないことを認める（[[chapter/33]]）。", false],
		[39, "", "砲が届くと、彼女は入手方法を知らないままでいることを選び、血が流れなかったことを願う。この計画は惑星の支配にも使えるとパイロットが冗談を言うと、彼女は傷つく。最後の段階については、インキュベーターに関する教授の説明を、自分では理解していないと率直に認めながら伝え、パイロットを[[station/16]]へ送る（[[chapter/39]]）。", false],
		[43, "最後の攻勢", "入植者が[[station/14]]に奇襲をかけると、[[character/2]]は当初、すべてが失われたと思い込む（[[chapter/43]]）。", false],
		[44, "", "彼女は生き延び、ステーションを救ったのはパイロットと[[world/aquarians|アクアリアン]]だと称える。", false],
		[45, "", "彼女は[[world/aquarians|アクアリアン]]の使節を迎え入れ、使節は自分の種族が植民地との戦いに協力するという知らせをもたらす。[[station/188]]が反乱軍の手に渡ったことで、彼女はできるだけ多くの艦船を[[equipment/42]]で武装させる計画を立て、二つの攻勢を同時に開始する。パイロットは[[station/18]]を奪取し、[[character/5]]は[[station/109]]を攻撃する（[[chapter/45]]）。[[character/5]]を心配するパイロットを、彼女はからかう。", false],
		[47, "", "[[station/0]]への最終攻撃では、彼女自ら出撃する（[[chapter/47]]）。", false],
		[48, "", "勝利の後、彼女はパイロットと[[character/5]]に感謝し、惑星が癒えるには長い時間が必要だと認める。", false],
		[19, "人物像", "[[character/2]]は温かく冷静で、若い部下たちにまるで自分の子どものように語りかける。多くを求めるが、報酬は少ない。", false],
		[26, "", "彼女は行き過ぎなほど部下に忠実である。他の者たちが疑いを抱いた後も長く[[character/3]]をかばい続ける。", false],
		[28, "", "[[character/3]]は彼女を、この仕事には年を取りすぎた夢想家と呼ぶが、物語のその後の展開はその評価を裏付けない。", false],
		[33, "", "彼女の計画は綿密というより大胆なこともあり、部下の臨機応変な対応に頼る。外交を好み、流血を避けたいと願っているが、運動が戦わねばならないことは受け入れている。", false],
		[19, "人間関係", "彼女はほとんど誰よりもパイロットを信頼するようになり、パイロットはその信頼に応える。", false],
		[21, "", "[[character/3]]を最も優れたパイロットとして高く評価している。", false],
		[23, "", "[[character/9]]に対しては軽蔑しか抱いていない。", false],
		[25, "", "[[character/5]]を信頼できる副官として扱い、不在の間は指揮を任せる。", false],
		[31, "", "[[character/4]]は技術の専門家として彼女の下で働き、[[world/abel]]は彼女のために兵器を作る。", false],
	],
	"character/3": [
		[21, "", "[[character/3]]は[[character/2]]配下で最も優れたパイロットのひとりで、才能はあるが傲慢な戦士である。彼女は[[station/8]]近くの海賊団への襲撃で、彼をパイロットと組ませる。", false],
		[21, "人物像", "[[character/3]]は短気で自慢好きだ。到着が遅いとパイロットを叱りつけ、自分ひとりで片付けられたと言い張り、自分の後ろについて学べと命じる。[[character/1]]は、彼の作法はともかく、その評判には感心している。", false],
		[22, "", "新参者に敬意を払わず、パイロットを漁師の子とあざける。", false],
		[28, "", "根は傭兵である。忠誠を金で測り、運動を動かす理想には我慢がならない。", false],
		[21, "ストーリーでの役割", "[[character/2]]は[[character/3]]を最も優れたパイロットのひとりとして紹介し、海賊を相手に彼と共に出撃するようパイロットを送り出す（[[chapter/21]]）。彼はすでに目標地点で待っており、遅れに苛立っている。", false],
		[22, "", "[[character/3]]は腕の立つパイロットで、戦闘の後、侮辱に包んだしぶしぶの賛辞をパイロットに贈る。[[character/2]]が報酬を等分すると激怒し、パイロットの貢献はわずかだったと言い張り、彼女は初心者に金を無駄遣いしていると不満を言う。", false],
		[25, "", "[[character/2]]は[[station/10]]への護衛に彼を選ぶ。パイロットは不満だが、彼女は頑固だが腕は確かだと彼を保証する（[[chapter/25]]）。", false],
		[26, "待ち伏せ", "[[character/9]]の部隊が[[station/10]]で待ち伏せを仕掛けると、[[character/3]]は一発も撃たない。武器が故障したと主張し、詫びて逃げ去る。[[character/5]]は彼が裏切ったと確信し、[[character/2]]は破壊工作を疑いながらも、なお彼をかばう。", false],
		[27, "裏切り", "しばらくして彼はパイロットに連絡し、[[character/2]]と[[character/5]]の様子を不安げに尋ね、重要な知らせがあると主張する。そして[[station/11]]の近くで会いたいという。[[character/1]]は罠だと確信している（[[chapter/27]]）。", false],
		[28, "", "その通りだった。[[character/3]]は[[character/2]]を捕らえており、パイロットが降伏しなければ彼女を殺すと脅す。彼は理由を隠さず語る。[[character/2]]は夢想家で、指導者を務めるには年を取りすぎていると考えており、さらに[[character/9]]が彼女とパイロットの両方に多額の賞金を懸けたのだ。なぜ[[character/9]]がパイロットを恐れるのかは知らないし、興味もないと認める。[[character/2]]の払いが悪かったから雇い主を替えたのだと言い、パイロットの理想の話を一蹴する。", false],
		[28, "", "彼が話している間に、[[character/1]]は彼の一人乗りの艦船をスキャンし、[[character/2]]の居場所を突き止める。そしてパイロットが攻撃する。[[character/3]]は最後まで素早く自信に満ちていたが、その艦船は撃破される。パイロットは[[character/2]]が生きたまま中にいる装甲貨物室を回収し、[[character/3]]は[[station/11]]の近くで艦船と運命を共にする。", false],
		[28, "", "振り返れば、[[station/10]]での武器の故障は仕組まれたものに見える。彼の謝罪が本心だったことを示すものは、物語の中に何もない。", false],
		[29, "", "彼の裏切りは長い影を落とす。[[character/2]]は、彼が死ぬ前に科学者の輸送船団の情報を漏らしたのではないかと恐れる（[[chapter/29]]）。", false],
		[47, "", "最後の戦いで、[[character/9]]はパイロットが[[character/3]]の最期の言葉だと気づく脅し文句を口にする。パイロットが彼を殺したと知ると、[[character/9]]は[[character/3]]がパイロットの兄弟だったと主張する。その嘘はすぐに見破られる。", false],
		[21, "人間関係", "[[character/2]]は彼を全面的に信頼し、その腕前を他のパイロットたちより高く評価している。", false],
		[22, "", "彼は最初からパイロットを軽蔑して扱う。", false],
		[26, "", "[[character/5]]は彼を信用せず、最初に裏切り者と呼ぶ。", false],
		[28, "", "結局、彼は仲間たちが戦っている相手である[[character/9]]に身を売る。", false],
	],
	"character/4": [
		[12, "", "[[character/4]]は[[station/3]]を拠点とする[[faction/rebels|レジスタンス]]の一員である。", false],
		[13, "", "パイロットが直接対面する最初の反乱軍のメンバーで、新入りを審査し、最初の任務を与える役目を担っている。", false],
		[13, "パイロットの審査", "パイロットが[[station/3]]に到着すると、[[character/4]]はまず、新参者が何をどうやって知ったのかについて、もつれた質問を次々と投げかける。パイロットは、自由貿易を掲げるレジスタンスがあるという噂以外は何も知らないと認める。[[character/4]]は懐疑的だが、運動が無線通信の暗号化を始めたのはわずか二日前なので、その話はもっともらしいと判断する（[[chapter/12]]）。", false],
		[13, "", "時間も人手も足りない[[character/4]]は、パイロットを見習いとして受け入れる。惑星の搾取を止めねばならないため、反乱軍は入植者のステーションに潜入して指導者たちを味方につけるつもりだと説明する。見知らぬ相手にそれ以上は語らず、パイロットに最初の任務を与える。支援者たちを[[station/4]]から[[station/5]]へ運ぶことだ（[[chapter/13]]）。", false],
		[17, "革命の拡大", "後に[[character/4]]は、あまりに長いために[[character/1]]が要点しか読み上げないメッセージで、パイロットを[[station/3]]に呼び戻す（[[chapter/17]]）。", false],
		[18, "", "対面した彼は、外交によって多くのステーションが反乱軍の側についたため、パイロットはより広い範囲で交易できるようになったと報告する。報道はすでに革命を語っており、[[character/4]]もその言葉に同意する。これまで血は流れていないが、それは変わるだろうと彼は見ている。運動の指導者は新たに味方についたステーションのひとつにいて、いずれ接触してくるとパイロットに伝え、より良い装甲やシールドがなければ到達できないステーションもあると警告する。[[guide/depth]]を参照（[[chapter/18]]）。", false],
		[31, "輸送船団の襲撃", "科学者たちを護衛したパイロットが[[station/14]]に到着すると、[[character/4]]がそこにいる。感謝のスピーチを用意していたが披露する機会はなく、後にもパイロットが艦船へ急ぐ間に話の途中で再び遮られる。彼はパイロット、[[character/5]]と共に、[[world/biotek]]を運ぶ入植者の輸送船団を迎え撃つ（[[chapter/31]]）。", false],
		[32, "", "輸送船団の乗組員たちが食料と医薬品しか積んでいないと訴えると、[[character/4]]は無線で、それこそ反乱軍に必要なものだと答える。[[character/5]]は、彼はなかなかの冗談好きだと評する。", false],
		[33, "", "その後[[character/2]]は彼に、やるべきことの多い格納庫を任せる。また、艦船に[[world/eclipse|Eclipse]]を搭載する技術面のことは彼に聞くようにと言う（[[chapter/33]]）。", false],
		[13, "人物像", "[[character/4]]は慎重で堅苦しく、秘密主義だ。説明より先に命令を出し、運動の計画は信頼に足る者にしか明かさない。", false],
		[18, "", "また話が長く、[[character/1]]は彼が口を開くたびにそれをからかう。", false],
		[32, "", "堅苦しい態度の裏には、乾いたユーモアのセンスと、来たるべき戦争への現実的な見方がある。", false],
		[13, "人間関係", "[[character/4]]は運動におけるパイロットの最初の窓口である。パイロットが頼りになることを示すにつれ、彼の信頼も増していく。", false],
		[19, "", "彼は[[character/2]]の下で働き、その命令を伝える。", false],
		[32, "", "[[character/5]]と共に戦い、冗談を言っては彼女にからかわれる。", false],
	],
	"character/5": [
		[13, "", "[[character/5]]は[[faction/rebels|レジスタンス]]の一員で、パイロットは彼女を[[station/4]]まで迎えに行くよう命じられる。", false],
		[14, "", "朗らかで温かく、よく笑う彼女は、パイロットの最も親しい仲間のひとりとなる。パイロットは最初の瞬間から彼女に惹かれ、[[character/1]]はそれをいつまでも苛立たしく思っている。", false],
		[14, "最初の出会い", "[[station/4]]で[[character/5]]はパイロットを温かく迎え、急いで出発したがる。パイロットが運動について尋ねると、新入りが事情を知らされないのは本人と運動の安全のためだと説明する。目的地を艦船のコンピューターに送り、移動は迅速でなければならないと強調する（[[chapter/13]]）。", false],
		[15, "", "[[station/5]]で彼女は用事を片付けるために身を隠す。去る前に、反乱軍が入植者とどう違うかを説明する。反乱軍は海から奪い尽くすのではなく、海が差し出すもので暮らし、漁獲を商品に加工し、獲りすぎないよう気を配る。彼女はパイロットに、商品を5トン生産してこの生き方を試すよう頼み、イカと[[goods/35]]から[[goods/22]]を作れる[[station/90]]を勧める（[[chapter/14]]）。", false],
		[16, "", "商品ができあがると、彼女は新しい任務を持って再び連絡してくる。植民地の弱点を見つけるため、運動はあらゆるステーションの新しい情報を必要としている。彼女の言葉を借りれば、武器だけでは勝てないからだ。反乱軍は革命を計画しているのかと聞かれると、彼女はそれ以上語るのを拒む（[[chapter/15]]）。", false],
		[25, "再会と待ち伏せ", "パイロットは[[station/9]]で[[character/5]]と再会し、二人はぎこちなく褒め言葉を交わす。[[character/2]]が再会を打ち切り、二人に自分と[[character/3]]を[[station/10]]まで護衛するよう命じる（[[chapter/24]]）。", false],
		[25, "", "到着したとき、何かがおかしいと最初に感じ取るのは[[character/5]]だ。", false],
		[26, "", "待ち伏せの最中、彼女は[[character/3]]が戦っていないことに気づき、逃げる彼に呼びかける。その後、彼を裏切り者だと面と向かって非難し、パイロットに支持を求める。[[character/2]]は不在の間、[[station/9]]の指揮を彼女に任せる（[[chapter/25]]）。", false],
		[31, "三段階の計画", "[[station/14]]の[[character/5]]は、[[character/2]]の救出の話をすでに知っている。彼女は計画の第一段階についてパイロットに説明する。情報提供者によれば、[[world/biotek]]は普通の貨物に紛れてMaarthへ輸送されている。どの艦船に積まれているか誰にもわからないため、彼女は[[station/2]]の近くで輸送船団全体を襲撃するよう命じる（[[chapter/30]]）。", false],
		[32, "", "彼女は迎撃を指揮し、すべてのコンテナを確実に回収する（[[chapter/31]]）。", false],
		[33, "", "その後[[character/2]]は彼女に、奇襲に備えて[[station/14]]の外を哨戒する任務を与える。", false],
		[42, "", "パイロットが[[goods/36]]を持って戻ると、[[character/5]]は大喜びする。[[world/abel]]の準備がすべて整ったことを伝え、海賊相手に砲を試せという[[character/2]]の命令を伝達し、ジェネレーターは試作品にすぎないとパイロットに念を押す（[[chapter/41]]）。", false],
		[45, "攻勢", "最後の攻勢では、パイロットが[[station/18]]を攻撃する間、[[character/5]]は[[station/109]]への攻撃を率いる。[[character/2]]は、彼女は自分のすべきことをわかっている腕の立つパイロットだと言ってパイロットを安心させる（[[chapter/44]]）。", false],
		[47, "", "彼女の攻撃は成功する。彼女はその知らせと、[[station/0]]での最後の戦いについての[[character/2]]の命令をパイロットに伝え、自らも途中で海賊を退けながら出発する（[[chapter/46]]）。", false],
		[48, "", "[[station/0]]で彼女は[[character/2]]、パイロットと並んで戦う。勝利の後、彼女は[[goods/21]]で祝おうとパイロットを誘い、パイロットはそれを受ける（[[chapter/47]]）。", false],
		[14, "人物像", "[[character/5]]は人なつこく前向きで、事あるごとに口にする短い褒め言葉がお気に入りだ。また口が堅く献身的で、運動が何を掲げているのかをはっきりと理解している。", false],
		[15, "", "海を傷つけずに海の恵みで暮らすことを信条とし、その考えを簡潔に説明するすべを心得ている。", false],
		[26, "", "人を判断するのが早く、[[character/3]]の場合、その判断は正しかった。", false],
		[14, "人間関係", "パイロットは最初から彼女に惹かれており、キャンペーンを通じて、その気持ちは明らかに互いのものとなっていく。[[character/1]]はそれについて不平を言うのをやめない。", false],
		[25, "", "[[character/2]]は彼女に指揮を任せ、彼女とパイロットを温かく面白がりながら見守る。", false],
		[26, "", "彼女は[[character/3]]を決して信用しない。", false],
		[32, "", "[[character/4]]と緊密に協力し、彼のユーモアを面白がっている。", false],
	],
	"character/6": [
		[8, "", "[[character/6]]は、[[faction/colonists]]側の多くの端役の話し手に使われる名前である。植民地の[[world/colony|行政]]に属する役人、管理者、輸送船の乗組員たちだ。誰も名前を持たないが、彼らは全体として、植民地が自らのために働く部外者をどう扱うかを示している。", false],
		[9, "話し手", "最初に登場するのは、[[species/0|オウムガイ]]の駆除の後にパイロットを迎える[[station/1]]の役人である（[[chapter/8]]）。この役人は汚れ仕事を丁寧な言葉で言い換えることを好み、わずかな固定額を支払い、交渉には応じない。より良い仕事を任される前に、パイロットは契約を三件達成しなければならない。", false],
		[10, "", "同じ声が次に、[[station/2]]でのカプセル防衛を割り当てる。植民地は輸出品をカプセルで軌道へ打ち上げているが、[[world/aquarians|アクアリアン]]がそれを襲い続けており、交易当局は頭を悩ませている（[[chapter/9]]）。", false],
		[32, "", "ずっと後、[[station/2]]近くの入植者の輸送船団の乗組員たちは、食料と医薬品しか積んでいないと言って、反乱軍に撃たないよう懇願する（[[chapter/31]]）。", false],
	],
	"character/7": [
		[12, "", "[[character/7]]は、パイロットに話しかける[[faction/rebels]]の名もなきメンバーたちに使われる名前である。ステーションの管制官、警備兵、輸送船団の乗組員たちだ。彼らの声は、パイロットが運動とその日常に初めて触れる瞬間を彩る。", false],
		[12, "話し手", "パイロットが最初に耳にする反乱軍の声は[[station/3]]の警備兵で、艦船が中立海域に入ったことを警告し、身元を明かさなければ発砲すると脅す。長い沈黙の後、パイロットはドッキングを許される（[[chapter/12]]）。", false],
		[17, "", "パイロットが正式なメンバーとして戻ると、ステーションは名前で出迎え、ドッキングベイを割り当てる（[[chapter/17]]）。", false],
		[29, "", "その後、[[station/13]]近くの科学者の輸送船団の乗組員が、必死に救援を求める（[[chapter/29]]）。", false],
		[30, "", "後で彼らは、自分たちだけでは生き延びられなかったと言ってパイロットに感謝する。", false],
	],
	"character/8": [
		[34, "", "[[character/8]]は、[[world/eclipse|Eclipse]]を手に入れる方法を探していたパイロットが[[station/15]]で出会う商人である。", false],
		[35, "", "自分のことを常に三人称で呼ぶ闇商人で、金を持った客にはほとんど何でも調達できると豪語する。", false],
		[35, "背景", "[[character/8]]は、薬物の取引が法律で禁じられている[[station/15]]で商売をしている。その活動のせいで彼は標的となっており、ステーションの治安当局は彼を始末するため賞金稼ぎの[[character/11]]を雇っている。彼は各地に伝手を持ち、客の望むものを手に入れるためなら賄賂も惜しまない。", false],
		[35, "砲の取引", "パイロットが地元の市場を見て回り、[[goods/37]]を買っているように見えたとき、[[character/8]]はパイロットを脇へ呼び、ここではそうした取引は違法だと警告する。彼が自分のサービスを持ちかけ、パイロットが[[equipment/42]]を求めると、彼は驚愕し、戦争でも始めるつもりかと尋ねる。パイロットは個人で使うのだと言い張る。[[character/8]]は探すことに同意するが、条件がひとつある。ステーションの近くを巡回している[[character/11]]を見つけ出して殺すことだ（[[chapter/34]]）。", false],
		[37, "", "[[character/11]]の死後、[[character/8]]はパイロットを祝福し、約束を守る。伝手と大量の賄賂のおかげで[[equipment/42]]を見つけ出しており、法外な値段で売りに出すが、それでもお買い得だと言う。売り手はドーンという名の男だったと明かし、品物が確かなら名前などどうでもいいと言う（[[chapter/36]]）。", false],
		[37, "", "売り手は[[character/9]]だった。[[character/1]]は皮肉を指摘する。[[character/9]]の強欲が、反乱軍の最も重要な兵器を彼の敵の手に渡したのだ。パイロットは砲を買い、それを持って[[station/14]]に戻る（[[chapter/37]]）。", false],
		[35, "人物像", "[[character/8]]は抜け目なく慎重で、良心の呵責を持たない。違法な品を扱い、人の死を支払いと同じくらい気軽に要求する。立ち聞きを警戒し、商談の前にはパイロットを脇へ呼んで声を潜めさせる。金を払う客が相手でもリスクを天秤にかけ、最初はそんな武器を見知らぬ相手に売るべきかどうか確信が持てずにいる。", false],
		[37, "", "それでも彼なりに信用できる。代金が支払われれば取引を守り、パイロットが求めたものを過不足なく見つけ出す。自分を名前で呼ぶ癖と、しかるべき場所にしかるべき知り合いがいるという自負によって、彼はキャンペーンの中でも個性的な人物のひとりとなっている。", false],
		[35, "人間関係", "[[character/11]]は彼を追う狩人であり、パイロットの手によって彼の犠牲者となる。", false],
		[37, "", "彼は[[character/9]]ともパイロットとも、どちらがどの陣営にいるかを気にせず取引する。", false],
	],
	"character/9": [
		[2, "", "[[character/9]]（姓はドーン）は、パイロットがその日の漁獲を売る[[station/0]]の入植者の役人である。", false],
		[3, "", "傲慢で野心的な彼は、植民地のために働く人々をあからさまに軽蔑している。パイロットの最初の雇い主であり、やがて長年の宿敵となる。", false],
		[12, "背景", "[[character/9]]は、自分はステーションでの地位よりはるかに大きなことを成す運命にあると考えている。", false],
		[23, "", "[[character/2]]は、彼が取るに足らない人物だった頃を知っている。彼女の見方では、彼は実力ではなく良い人脈によって出世した。反乱が起きる頃には、[[faction/colonists|植民地]]の軍勢で実権を握っている。", false],
		[3, "序盤の出会い", "[[character/9]]はパイロットの最初の漁獲を固定価格で買い取り、小さな貨物室をあざ笑う。さらに、[[faction/pirates|海賊]]狩りをしたほうがましだろうが、それすら無理だろうと付け加える（[[chapter/2]]）。", false],
		[7, "", "パイロットが武装して戻ると、彼は手柄を自分のものにして仕事を持ちかける。[[station/1]]周辺の航路から[[species/0|オウムガイ]]を一掃することだ。パイロットの反論を退け、生き物をどう排除するかは気にしない（[[chapter/6]]）。", false],
		[10, "", "彼は[[station/2]]でのカプセル打ち上げを指揮し、カプセルを五つより多く失えば仕事を失うとパイロットに警告する（[[chapter/10]]）。", false],
		[12, "", "その後、カプセルの損傷をパイロットのせいにして報酬を出し渋る。その軽蔑が決定打となり、パイロットはレジスタンスへと向かう（[[chapter/11]]）。", false],
		[23, "反乱との対決", "反乱軍が勢力を伸ばすと、[[character/9]]は彼らと敵対する。[[station/9]]から[[station/37]]への補給路に機雷原を敷設させる（[[chapter/22]]）。", false],
		[25, "", "[[character/2]]が[[station/10]]での会談に到着すると、彼は部隊を率いて待ち構えており、即座に攻撃を命じる（[[chapter/25]]）。", false],
		[28, "", "彼は[[character/3]]の裏切りの黒幕として金を出している。パイロットを脅威と見なしているらしく、[[character/2]]とパイロットに多額の賞金を懸けている（[[chapter/27]]）。", false],
		[37, "", "強欲が彼の命取りとなる。彼は[[world/eclipse|Eclipse]]砲を闇商人の[[character/8]]に売り、それが巡り巡ってパイロットの手に渡る（[[chapter/36]]）。", false],
		[43, "敗北", "[[character/9]]は入植者による[[station/14]]への奇襲を率いる。彼はパイロットを反乱軍の漁師とあざけるが、パイロットが[[equipment/42]]を積んでいると知って愕然とする（[[chapter/43]]）。", false],
		[44, "", "[[world/aquarians|アクアリアン]]が彼の艦船との戦いに加わると、彼は攻撃を放棄して逃げ去る。", false],
		[47, "", "[[character/9]]は、植民地の最後の拠点[[station/0]]で最後の抵抗を試みる。パイロットが[[character/3]]を殺したと聞くと、[[character/3]]はパイロットの兄弟で、自分はパイロットの父親だと主張する。パイロットはすぐに嘘を見抜き、[[character/9]]はもう少しでうまくいくところだったと認める（[[chapter/47]]）。", false],
		[48, "", "続く戦いで、[[character/9]]は最後に残った入植者となる。彼は救命カプセルで脱出し、どうやらステーションごと持ち去って、魚と残る者たちへの捨て台詞を残して海を後にする。", false],
		[3, "人物像", "[[character/9]]は無礼で尊大、自分より下の者を見下す。", false],
		[12, "", "責任を他人に押しつけ、うまくいったときは手柄を自分のものにする。", false],
		[37, "", "彼の強欲は、自陣営への忠誠を上回る。", false],
		[47, "", "勇気ではなく嘘と賄賂を用いる策略家で、戦況が不利になるたびに逃げ出す。", false],
		[3, "人間関係", "パイロットへの軽蔑は最初の出会いから始まり、キャンペーンを通じてあからさまな敵意へと固まっていく。", false],
		[23, "", "[[character/2]]は長年彼を軽蔑している。", false],
		[28, "", "彼は賞金で[[character/3]]の忠誠を買う。", false],
		[37, "", "彼は品物の行き先を知らないまま[[character/8]]と取引する。", false],
	],
	"chart": [
		[1, "", "海図には、200のステーションすべてが海のマップ上の位置に点で表示される。到達した章の時点で、青い点は[[faction/colonists]]が、オレンジの点は[[faction/rebels]]が支配している。すべてのステーションは最初は青で、ストーリーが進むにつれてオレンジに変わり、青に戻ることはない。", false],
		[1, "", "ステーションや章のページでは、該当するステーションが大きく描かれてラベルが付き、その章で反乱軍に加わるステーションは輪郭で強調される。海図の下には、すべてのステーションがページへのリンク付きで一覧表示される。ステーション間の距離は海図上の単位で測られる。[[guide/navigation]]を参照。", false],
	],
	"contract/0": [
		[1, "", "ステーションから400〜1,200 mの地点で待つ手配中の艦船1隻を追跡し、撃破する。標的は普通の海賊よりはるかに頑丈で、その強さはパイロットのランクに応じて上がる。接近される前に長射程の武器や魚雷で削っておくと有利である。賞金はステーションに戻ったときに支払われる。", false],
	],
	"contract/1": [
		[1, "", "3〜6隻の一団が曲がりくねったルート沿いで待ち構えている。標的はその最後の1隻で、最終ウェイポイントにいる。単に撃破するのではなく、無力化してから逃げられる前にハープーンで引き寄せなければならない。牽引を邪魔されないよう、先に護衛を片付けておくこと。", false],
	],
	"contract/10": [
		[1, "", "200〜600 m離れた地点にある15〜25個の機雷からなる機雷原を、1隻の艦船が守っている。そのすべての機雷を破壊する。機雷は近距離でしか撃てないので、1つずつ慎重に接近すること。強力なシールドと装甲が爆発の衝撃を吸収してくれる。", false],
	],
	"contract/11": [
		[1, "", "補給カプセルが攻撃を受けている。契約の最低数を満たすだけのカプセルが残っているうちに攻撃者を撃破する。カプセルの残数に注意し、カプセルに迫っている攻撃者から優先して交戦すること。この仕事の報酬は基本的な契約より約30%高い。", false],
		[10, "", "攻撃者はアクアリアンである。入植者の輸送カプセルを狙う、半人半魚の海の住人だ。", false],
	],
	"contract/12": [
		[1, "", "友軍と共に戦いながら、武装した艦船に守られた補給カプセルを決められた数だけ破壊する。実際にはこの仕事を掲示板に出すステーションはないため、受けることはできない。他の契約の種類と並んで定義されているため、リファレンスに載っているにすぎない。", false],
	],
	"contract/13": [
		[1, "", "決められた量の製品を作り、仕事を掲示したステーションに届ける。報酬は製品の価値と要求量によって決まる。報酬は非常に気前が良いことが多く、保証金も通常の半分で済む。受ける前にレシピを確認し、材料を揃えておくこと。この仕事は、海図上の最初の20を超えるステーションでのみ現れる。", false],
		[12, "", "この仕事を掲示するのは反乱軍のステーションだけである。", false],
	],
	"contract/14": [
		[1, "", "指定された生物または藻類を正確な量だけ、掲示したステーションに届ける。量は3〜24個で、保証金は通常の半分である。ありふれた種は希少な種より頻繁に求められる。漁業用レーダーと大きな貨物室があれば簡単にこなせる。この仕事は、最初の20を超えるステーションでのみ現れる。", false],
		[12, "", "この仕事を掲示するのは反乱軍のステーションだけである。", false],
	],
	"contract/2": [
		[1, "", "誘拐犯の艦船が人質を捕らえている。回収の仕事と同様に、標的は一団と共に曲がりくねったルートを進んでおり、無力化してからハープーンで引き寄せなければならない。標的に逃げられると失敗となる。射程の長いハープーンを装着し、誘拐犯に取りかかる前に護衛を倒しておくこと。", false],
	],
	"contract/3": [
		[1, "", "曲がりくねったルートのウェイポイントに散らばる、3〜6隻の海賊団を1隻残らず追い詰める。全滅させれば完了である。武装した艦船にとっては単純明快な契約で、海賊団の規模は仕事の難易度に応じて大きくなる。", false],
	],
	"contract/4": [
		[1, "", "5隻の輸送船が決められた航路を進み、その途中で襲撃者が待ち伏せしている。攻撃者をすべて撃破すれば成功となる。輸送船がすべて失われると失敗となる。護衛の報酬は単純な海賊狩りより約30%高い。輸送船団の近くにとどまり、襲撃者が船団に届く前に交戦すること。", false],
	],
	"contract/5": [
		[1, "", "ウェイポイントで2〜3隻の輸送船からなる輸送船団を襲撃し、武装した護衛をかいくぐって撃破する。撃破が必要なのは輸送船だけなので、そこに火力を集中すれば早く片付く。護衛が迫ってくる間に、魚雷や長射程の機銃で輸送船を狙い撃つとよい。", false],
	],
	"contract/6": [
		[1, "", "15〜24匹の生物の群れが決められた航路を泳ぎ、その途中で狩人に襲われる。損失が取り決めた上限を超える前に狩人を撃破すること。群れの近くでは決して撃たないこと。流れ弾も損失に数えられる。この仕事の報酬は基本的な契約より約30%高い。", false],
		[12, "", "この仕事を掲示するのは反乱軍のステーションだけで、ストーリー完了後は掲示されなくなる。", false],
	],
	"contract/7": [
		[1, "", "敵艦が妨害してくる中で、周辺の生物のうち特定の種を決められた数だけ倒す。ハープーンで捕らえた獲物は数に入らず、倒さなければならない。漁業用レーダーがあれば目当ての種をすぐに見つけられる。この仕事の報酬は基本的な契約より約20%高い。", false],
	],
	"contract/8": [
		[1, "", "乗客を別のステーションへ運ぶ。乗客の中にはS.T.R.E.A.M.の移動回数に上限を設ける者もおり、許される回数が少ないほど報酬は高い。その上限を超えると契約は失効する。到達範囲が長いほど移動回数が減るため、良いエンジンが役立つ。", false],
	],
	"contract/9": [
		[1, "", "ステーションから200〜600 mの地点にある15〜30個の残骸の散乱域を、約2分30秒以内に一掃する。軽武装の敵艦がいることもある。報酬は他の契約より約30%低いが、仕事はすぐに終わる。ブースターと速射型の機銃があれば、貴重な数秒を節約できる。", false],
	],
	"equipment/0": [
		[1, "", "入門用の機銃。0.56秒ごとに1発3ダメージ、射程228 m。威力はごくわずかだが、約5,700 crと最も安い武器で、ショップでも最もよく見かけるもののひとつである。複数装着でき、機銃はすべて一斉に発射されるため、2〜3門並べれば、より重い武器が買えるようになるまでの序盤の砲列として使える。", false],
		[3, "", "[[chapter/3]]では、[[station/0]]を出発する前にこれを1門装着しなければならない。", false],
	],
	"equipment/1": [
		[1, "", "中位のレールガンは、[[equipment/0]]の2倍となる1発6ダメージで、発射間隔も少し短い0.48秒、射程は260 m。価格はおよそ2倍だが、持続ダメージは2倍以上になる。核融合砲が店頭に並ぶ前の序盤の章では、2門目の機銃として手堅い選択である。", false],
	],
	"equipment/10": [
		[1, "", "このマスドライバーは射程280 mで0.40秒ごとに20ダメージを与え、一般に販売されている機銃の中で最高の持続ダメージを誇る。射程もどの核融合砲より長い。価格は42,000〜51,000 crを見込んでおくこと。空きスロットのある戦闘向けの船体には、最良の機銃の選択肢のひとつである。", false],
	],
	"equipment/11": [
		[1, "", "最も重いマスドライバーは射程375 mで1発25ダメージを与え、速射型の機銃の中で最長の射程を持つ。発射間隔は0.51秒で、持続ダメージは[[equipment/10]]とほぼ同等である。加わるのは射程だ。ショップで最も希少かつ高価な機銃で、54,000〜60,000 crする。", false],
	],
	"equipment/12": [
		[1, "", "基本の誘導魚雷は20ダメージを与え、射程215 mまで自ら標的に向かって進む。再装填は4.3秒ごとにしかできない。魚雷発射管は種類を問わず1つしか装着できない。照準に捉え続けるのが難しい機敏な標的には有効だが、射程は短い。", false],
	],
	"equipment/13": [
		[1, "", "中位の魚雷は30ダメージを与え、再装填は4.0秒、射程は360 mで、あらゆる面で[[equipment/12]]を上回る。魚雷発射管は1つしか装着できないため、安いモデルに追加するのではなく置き換えることになる。37,000〜39,000 crで、汎用のとどめの一撃として優秀である。", false],
	],
	"equipment/14": [
		[1, "", "最上位の魚雷は50ダメージの弾頭を816 mまで運び、販売されている武器の中で単発の威力が最も大きい。再装填には6.8秒かかる。艦船の唯一の魚雷枠として、速射型の機銃と相性が良い。戦闘の開始時に遠距離から一撃を与え、残りは機銃で仕留めるのだ。希少で、価格は62,500 cr以上する。", false],
	],
	"equipment/15": [
		[1, "", "初期装備のハープーンは射程240 mで、捕獲許容距離24 mと3種の中で最も広く、狙いが甘くても許容してくれる。かかった獲物を減速させる効果はないため、速い生物は強く引っ張り、疲れるまでに時間がかかる。藻類や動きの遅い動物には十分で、買い替えも安い。", false],
	],
	"equipment/16": [
		[1, "", "このハープーンは射程400 mで、かかった生物を40%減速させるため、[[species/7]]のような速い獲物を視界に捉え続けるのがずっと楽になる。捕獲許容距離は18 mに狭まるので、狙いがより重要になる。定期的に漁をするパイロットにとっては、大きな貨物室に次いで最も重要な強化である。", false],
	],
	"equipment/17": [
		[1, "", "最高のハープーンは射程560 mで、かかった獲物を70%減速させるため、速い生物でもほとんど追いかけずに弱らせられる。捕獲許容距離は14 mと最も狭いので、丁寧な狙いが報われる。希少で69,000〜83,000 crと高価であり、ハープーンは1つしか装着できない。", false],
	],
	"equipment/18": [
		[1, "", "基本のシールドは、装甲に及ぶ前に100ポイントのダメージを吸収する。また艦船の浅深度限界を20,000 mに設定する。現場では一切回復せず、艦船がステーションを出発したときにだけ回復する。序盤の戦闘には十分だが、大半のパイロットはできるだけ早く買い替える。", false],
	],
	"equipment/19": [
		[1, "", "このシールドは[[equipment/18]]より4分の3多い175ポイントを吸収し、艦船は18,400 mまで浮上できる。基本モデルと同じく現場では回復しない。15,750〜18,000 crと、価値のあるシールド強化の中で最も安く、より浅いステーションのいくつかへの道を開く。", false],
	],
	"equipment/2": [
		[1, "", "最も重いレールガンは射程322 mで1発9ダメージを与えるが、発射間隔は[[equipment/1]]よりやや長い0.62秒である。そのため持続ダメージの向上はささやかだ。16,000〜20,000 crで射程の割にはお買い得だが、少し多く払えば[[equipment/6]]が明らかに多くのダメージを与える。", false],
	],
	"equipment/20": [
		[1, "", "このシールドは220ポイントを吸収し、現場で回復する最初のシールドである。艦船が深度帯の範囲内にいる間、1.15秒ごとに1ポイント回復する。浅深度限界は16,800 mに上がる。56,000 cr以上と[[equipment/19]]よりはるかに高価だが、回復によって長期戦がずっと安全になる。", false],
	],
	"equipment/21": [
		[1, "", "最高のシールドは310ポイントを吸収し、0.65秒ごとに1ポイント回復する。[[equipment/20]]のほぼ2倍の速さである。浅深度限界15,000 mはどのシールドよりも浅く、最も浅いステーションへの道を開く。希少で93,750 cr以上する、キャンペーン終盤向けの投資である。", false],
	],
	"equipment/22": [
		[1, "", "基本の装甲は100ポイントの防御を追加する。シールドが尽きた後、船体が被弾する前に削られる部分である。また深深度限界を25,000 mに設定する。装甲は現場では再生しない。この装甲板は安く序盤には十分だが、より深いステーションの多くには届かない。", false],
	],
	"equipment/23": [
		[1, "", "この装甲は155ポイントを追加し、深深度限界を26,800 mまで下げる。価格は対になるシールド[[equipment/19]]とほぼ同じで、両方を装着すれば艦船の深度帯が上下両方向に広がる。より深いステーションに到達したいパイロットにとって、序盤の良い強化である。", false],
	],
	"equipment/24": [
		[1, "", "この装甲は195ポイントを追加し、28,400 mまでの潜航を可能にする。[[equipment/23]]よりかなり高価な56,000〜72,000 crで、防御の向上は小さい。多くの深いステーションに手が届くようになるため、購入の理由としては深度の拡大のほうが大きいことが多い。", false],
	],
	"equipment/25": [
		[1, "", "最高の装甲は270ポイントを追加し、入手できる中で最も深い30,000 mまでの潜航を可能にする。希少で、93,750 cr以上する。[[equipment/21]]と組み合わせれば、艦船はステーションの深度範囲のほぼ全域で活動できる。", false],
	],
	"equipment/26": [
		[1, "", "最小の貨物モジュールは、船体の基本積載量を30%増やす。モジュールは複数装着でき、ボーナスは合算される。ボーナスは基本積載量に対する割合なので、[[ship/0]]では7 tだが、[[ship/6]]では54 tになる。大型の船体で貨物室を広げる最も安い方法である。", false],
	],
	"equipment/27": [
		[1, "", "このモジュールは船体の基本積載量を50%増やし、他のモジュールと重ねて装着できる。費用対効果は[[equipment/26]]よりやや劣るが、スロットを節約できる。スロットに余裕の少ない船体ではそのほうが重要である。[[ship/4]]ではモジュール1つで35 t増え、交易の航海ならスロットを割く価値が十分にある。", false],
	],
	"equipment/28": [
		[1, "", "最大のモジュールは基本積載量を80%増やし、スロットあたりの増加量は貨物モジュールの中で最大である。[[ship/6]]では144 t増える。複数装着できる。希少で45,000 cr以上するため、主に交易専用の大容量の船体向けに購入する価値がある。", false],
	],
	"equipment/29": [
		[1, "", "基本のエンジンは、海図上の艦船のS.T.R.E.A.M.到達範囲を30%広げ、1回の移動でより多くのステーションに到達できるようにする。エンジンは1つしか装着できない。安価で最初から役に立つ。移動回数が減れば、交易や乗客輸送の航海が速くなるからだ。", false],
	],
	"equipment/3": [
		[1, "", "最初のコイルガンは射程重視のビーム兵器である。射程はレールガンのほぼ4倍の875 mで、1発15ダメージを与えるが、発射間隔は2.5秒必要だ。持続ダメージは[[equipment/0]]とほぼ同じ。接近してくる艦船に、相手が反撃できる前から射撃を始めたいときに装着する価値がある。", false],
	],
	"equipment/30": [
		[1, "", "このエンジンはS.T.R.E.A.M.到達範囲を60%広げる。[[equipment/29]]の2倍のボーナスで、価格はおよそ3倍である。積荷の移動距離に応じて価格が上がるため、遠く離れた市場間で定期的に商品を運ぶ交易商に向いている。キャンペーン中盤のショップでも見つけやすい。", false],
	],
	"equipment/31": [
		[1, "", "最高のエンジンはS.T.R.E.A.M.到達範囲を130%広げ、基本範囲の2倍以上にする。希少で、90,000 cr以上する。長い交易路や遠方の契約先で、移動を1回減らすたびに効果が大きいときに装着する価値がある。", false],
	],
	"equipment/32": [
		[1, "", "このスラスターは船体の操舵性の値を0.15上げる。上昇量は固定なので、最も効果があるのは遅い船体である。[[ship/6]]では操舵性が0.67から0.82に上がる。操舵モジュールは1つしか装着できない。鈍重な貨物船を手軽に改善できる。", false],
	],
	"equipment/33": [
		[1, "", "このスラスターは操舵性の値を0.26上げる。[[equipment/32]]のほぼ2倍の上昇量で、価格はおよそ3倍である。中量級の船体で頻繁に戦い、海賊の攻撃の内側に回り込む必要があるパイロットに向いている。[[ship/4]]では操舵性が0.91から1.17に上がり、[[ship/7]]の値に近づく。", false],
	],
	"equipment/34": [
		[1, "", "最高のスラスターは操舵性の値を0.56上げる。これで[[ship/6]]が[[ship/0]]より良く旋回できるようになり、[[ship/5]]には比類のない機動性が加わる。希少で87,000 cr以上する、戦闘専門のパイロット向けの贅沢品である。すでに操縦性の良い船体なら、安いスラスターのほうが賢い金の使い方かもしれない。", false],
	],
	"equipment/35": [
		[1, "", "基本のレーダーは、艦船やその他の反応をレーダー画面に表示し、視界の端に印を付けるので、パイロットは標的を見つけられる。レーダーがないと、画面には航行情報しか表示されない。敵艦の名前を表示することも生物を表示することもないが、安価で欠かせない。", false],
	],
	"equipment/36": [
		[1, "", "この戦闘レーダーは識別機能を追加する。照準に入った敵艦に、船体の種類と積んでいる積荷のラベルが付く。生物は表示しないので、戦闘用の道具である。18,500〜23,000 crと[[equipment/37]]とほぼ同じ価格なので、どちらを選ぶかはパイロットが主に戦うか漁をするかによる。", false],
	],
	"equipment/37": [
		[1, "", "この漁業用レーダーは、艦船と並べて生物もレーダー画面に表示するため、価値の高い獲物がずっと見つけやすくなる。[[equipment/36]]のように敵艦にラベルを付けることはない。漁を中心とするパイロットにとっては、[[equipment/38]]を除けば最も役立つレーダーである。", false],
	],
	"equipment/38": [
		[1, "", "最上位のレーダーは両方の特化機能を兼ね備え、敵艦にラベルを付け、生物をレーダー画面に表示する。価格はどちらの特化型レーダーのおよそ2倍で、ショップでは希少である。レーダーは1つしか装着できないため、漁と戦闘のどちらかを選ぶ必要がなくなる。", false],
	],
	"equipment/39": [
		[1, "", "基本のブースターは艦船の速度を3秒間2倍にし、その後20秒のチャージが必要になる。ブースターは1つしか装着できない。標的への接近、危険からの離脱、S.T.R.E.A.M.ゲートへの素早い移動に役立ち、よく見かけて安価である。", false],
	],
	"equipment/4": [
		[1, "", "このコイルガンは1発のダメージを22に上げる一方、発射間隔が3.4秒に延びるため、持続的な出力は[[equipment/3]]からほとんど向上しない。射程も884 mとほぼ変わらない。安いモデルが売られていないときには妥当な選択だが、価格差から期待されるほどの強化ではない。", false],
	],
	"equipment/40": [
		[1, "", "このブースターは約4秒間速度を2.5倍にし、約16秒でチャージが完了する。すべての数値が[[equipment/39]]を上回り、価格はおよそ2倍である。戦闘パイロットにとってキャンペーン中盤の良い選択で、長旅ではS.T.R.E.A.M.ゲートまでの移動も短縮できる。", false],
	],
	"equipment/41": [
		[1, "", "最高のブースターは約5秒間速度を3倍にし、14.5秒でチャージが完了するため、他のどのブースターよりも頻繁に使え、効果も長く続く。希少だが、約42,000 crと最上位の装備の大半より安い。", false],
	],
	"equipment/42": [
		[1, "", "通常の店頭には決して並ばず、定価もない重量級のステーション用砲。射程240 mで0.93秒ごとに1発40ダメージを与える。持続ダメージは最高のマスドライバーに迫り、しかも1発ごとの威力は中位の魚雷に匹敵する。", false],
		[33, "", "[[chapter/33]]以降、キャンペーンはこの砲の1門を探し求める展開となる。", false],
		[42, "", "[[chapter/42]]では、パイロットは出発前にこれを装着し、海賊を相手に試験しなければならない。", false],
	],
	"equipment/43": [
		[1, "", "この修理ドロイドは、船体が損傷している間、0.6秒ごとに船体を1ポイント回復する。1分間で約100ポイントである。シールドや装甲には作用しない。長いミッションや、流れ弾1発も許されない船体値の低い艦船に役立つ。1つしか装着できず、機銃を積めるはずのスロットをひとつ占める。", false],
	],
	"equipment/5": [
		[1, "", "最上位のコイルガンは狙撃用の武器である。ビーム1発ごとに最大1,380 mの距離で35ダメージを与え、射程は全武器中最長だが、次弾の準備には5.6秒かかる。ショップでは最も希少な品のひとつである。短射程の機銃と並べて装着すれば、他の砲が届くずっと前から標的を弱らせられる。", false],
	],
	"equipment/6": [
		[1, "", "最初の核融合砲は短射程の格闘向けの武器である。0.51秒ごとに10ダメージを与えるが、射程はわずか160 mで、全機銃中最短である。ダメージ効率はどのレールガンよりもはるかに高い。素早く距離を詰められる機敏な船体に向いており、接近戦ではレールガンを過去のものにする。", false],
	],
	"equipment/7": [
		[1, "", "この強化版は0.37秒ごとに14ダメージを与え、発射速度は全機銃中最速、射程も216 mに延びる。持続ダメージは[[equipment/6]]のほぼ2倍で、価格差は数千クレジットにすぎない。費用対効果では、ゲーム中でも最強クラスの機銃である。", false],
	],
	"equipment/8": [
		[1, "", "最も重い核融合砲は、射程220 mで0.40秒ごとに18ダメージを与える。[[equipment/7]]からの確かな強化だが、その差は最初の2モデル間の差より小さい。ショップでは希少である。見つけたら、近距離の砲列には迷わず買う価値がある。", false],
	],
	"equipment/9": [
		[1, "", "最初のマスドライバーは1発16ダメージと強力だが、発射間隔は0.6秒で、射程は195 m。38,000 cr以上するにもかかわらず、毎秒のダメージはより安い[[equipment/7]]を下回る。主に後のマスドライバーへのつなぎである。", false],
	],
	"faction/colonists": [
		[1, "", "入植者とは、物語の開始時点でこの海洋惑星を治めている移住者と行政官の集団である。200のステーションすべてを保有し、漁獲の価格を決め、誰に仕事を与えるかを決める。彼らの植民地は、海の資源を採取して惑星の外へ送り出すために築かれている。場所としての植民地については[[world/colony]]を参照。", false],
		[1, "歴史", "入植者はよそからこの惑星に移り住み、深い海の底にステーションを築いた。パイロットが到着する頃には植民地はすっかり根を下ろしており、どのステーションにも役人がいて、どのゲートにも巡視艦がいて、輸出品が途切れることなく流れている。", false],
		[21, "", "反乱軍の説明では、植民地化は急速で、その結果を顧みないものだった。海は回復が追いつかない速さで生命を奪われており、他の惑星もすでに同じようにして枯渇したと彼らは警告する。", false],
		[1, "組織", "各ステーションは植民地の役人が運営しており、交易を扱い、契約を出し、地元の巡視隊を指揮している。その上には輸出を監督する交易当局があり、損失が出ればステーションに責任を負わせる。ステーションの警備部門と植民地自身のパイロットが海賊などの脅威に対処し、しばしばフリーランスを雇う。", false],
		[10, "", "商品は輸送カプセルで惑星を離れる。カプセルはステーションから軌道へ打ち上げられ、そこで貨物船に回収される。", false],
		[1, "目的と手段", "植民地の目的は、その支配者たちの利益である。漁獲や商品を低い固定価格で買い取り、ステーションに自由な交易を許さない。邪魔になる動物は駆除され、出荷を脅かす者は追い払われる。", false],
		[23, "", "反乱に直面した入植者は、行政から武力へと転じる。補給路に機雷を敷設し、待ち伏せを仕掛け、反乱軍のステーションを攻撃する。", false],
		[28, "", "忠誠を金で買うこともいとわない。賞金ひとつで、反乱軍のパイロットを自らの指導者に背かせるのに十分なのだ。", false],
		[2, "主な人物", "[[character/9]]は、パイロットが最もよく知る入植者だ。[[station/0]]の傲慢な役人で、パイロットを見下し、漁獲を固定価格で買い取る。", false],
		[9, "", "下級の役人たちは名もなき[[character/6|入植者]]として登場する。たとえば[[station/1]]の役人は、オウムガイの駆除に安い報酬しか払わず、その後パイロットに掲示板の仕事をさせる。", false],
		[23, "", "ジャックは物語の中で、どうやら良い人脈のおかげで相当な権力を手にし、反乱軍の最も執拗な敵となる。", false],
		[28, "", "反乱軍のパイロット[[character/3]]は、ひそかに植民地の金を受け取り、仲間を裏切る。", false],
		[3, "ストーリーでの役割", "最初、入植者は単にパイロットの雇い主である。ジャックは漁獲を買い取り、銃を買って海賊を狩るようパイロットに勧める。", false],
		[7, "", "次に彼は[[station/1]]での[[species/0|オウムガイ]]の駆除を命じ、捕獲されようが殺されようがほとんど気にかけない。", false],
		[10, "", "契約をいくつかこなすと、植民地はパイロットに、[[station/2]]でのカプセル打ち上げをアクアリアンから守る任務を任せる。", false],
		[12, "", "ジャックはその戦いで損傷したカプセルをパイロットのせいにして、一切の支払いを拒む。植民地の扱いにうんざりしたパイロットは、レジスタンスを探しに行く。", false],
		[18, "", "反乱軍が説得によってステーションを次々と獲得するにつれ、植民地は一発の銃弾も撃たれないまま勢力を失っていく。", false],
		[23, "", "ジャックは[[station/9]]と[[station/37]]を結ぶ反乱軍の補給路に機雷を敷設する。", false],
		[25, "", "続いて彼は、[[station/10]]での交渉に向かう反乱軍の指導者[[character/2]]を待ち伏せする。", false],
		[28, "", "ジャックの賞金によって、レイモンドは反乱軍に背く。レイモンドはアユミを拉致し、パイロットが彼女を救い出す。", false],
		[31, "", "入植者は[[world/abel|アベル教授]]の試作機[[world/biotek]]を盗んだ。反乱軍はChoの近くで、それを運ぶ輸送船団を迎え撃つ。", false],
		[37, "", "ジャックは[[world/eclipse|Eclipse]]ステーション砲を闇市場で売るが、それが自分に向けられることになるとは夢にも思わない。", false],
		[44, "", "入植者は反乱の中枢である[[station/14]]に奇襲をかけるが、アクアリアンが反乱軍の救援に駆けつけると敗走する。ジャックは戦場から逃げ出す。", false],
		[46, "", "反乱軍の最初の攻勢で、[[station/18]]が入植者から奪取される。", false],
		[47, "", "二つ目の攻勢で[[station/109]]が奪取され、南部における入植者の支配は崩壊する。", false],
		[48, "", "植民地の最後の拠点[[station/0]]が最後の戦いで陥落する。ジャックは救命カプセルで脱出し、海における植民地の支配は終わる。", false],
		[1, "ゲーム内", "入植者のステーションは[[chart]]上で青く表示される。市場も工場もなく、ドッキングすると貨物室の中身をすべて最低価格で引き取る。そのため、価値の高い積荷を持って到着するには不向きな場所である。ショップと造船所は営業しているが、造船所が売るのは標準の船体だけだ。[[guide/allegiance]]を参照。", false],
		[1, "", "掲示板には[[contract/0]]、[[contract/1]]、[[contract/2]]、[[contract/3]]、[[contract/4]]、[[contract/5]]、[[contract/7]]、[[contract/8]]、[[contract/9]]、[[contract/10]]、[[contract/11]]の契約が並ぶが、納品や魚の保護の契約は出ない。入植者のための輸送船団の仕事では、敵の艦船は反乱軍である。", false],
		[1, "", "一方で、入植者のステーションは海賊に対して反乱軍の2倍の賞金を支払う。その航海で撃破した数の2乗に100クレジットを掛けた額である。入植者のステーション周辺の巡視艦は植民地のために戦い、海賊との戦いに手を貸してくれる。", false],
		[12, "", "ステーションが植民地を離れるのはストーリーの進行によってのみで、フリープレイ中の行動によることはなく、一度離れたステーションが戻ることもない。パイロットが反乱軍の側につくと、入植者の艦船がストーリーミッションの主な敵となる。", false],
	],
	"faction/pirates": [
		[1, "", "海賊は、海のいたるところで船舶を襲う無法者である。植民地にも反乱軍にも仕えず、単独の艦船、輸送船団、その他手頃な獲物に見える相手なら誰でも襲う。初めて武装して出撃したときから物語の結末、そしてその後まで、パイロットが最も頻繁に戦う相手である。", false],
		[1, "歴史", "パイロットが到着した時点で、海賊行為はすでに日常の一部となっている。ステーションは海賊船を撃破した者に賞金を払い、海賊狩りは武装したパイロットの間でありふれた稼業である。", false],
		[21, "", "入植者と反乱軍の対立は、海賊にとって願ってもない贈り物だ。両陣営の注意がそれている間に、彼らはより多くの、より手頃な獲物を見つけ、反乱軍の指導部はもはや彼らを無視できないと判断する。", false],
		[1, "組織", "海賊は単一の組織ではなく、ゆるやかな集団で活動しており、物語の中で名前が明かされる者は一人もいない。海賊団は外洋の隠れ家に集まり、奪った艦船を護衛し、機雷原や残骸の散乱域を守る。単独の海賊がステーションの近くで通りかかる艦船を待ち伏せすることもある。", false],
		[1, "目的と手段", "海賊が求めるのは略奪品である。積荷を狙って艦船を襲い、騒ぎのある所ならどこにでも集まって、弱った艦船を仕留める機会をうかがう。", false],
		[23, "", "彼らは[[station/9]]近くの植民地の機雷原の周りをうろつき、機雷にかかった艦船を仕留めようと狙っている。", false],
		[35, "", "雇われの用心棒も同じ世界に生きている。賞金稼ぎの[[character/11]]は武装した護衛を連れて行動し、賞金の計算上、彼の艦船は海賊として数えられる。", false],
		[5, "主な人物", "物語に登場する海賊は名もなき[[character/10|海賊]]のパイロットたちだけで、首領や名の知れた船長はいない。", false],
		[5, "ストーリーでの役割", "海賊はパイロットの新しいレールガンの最初の標的である。[[character/1]]の勧めで、パイロットは[[station/1]]の近くで海賊を一隻仕留める。", false],
		[21, "", "アユミは運動を守るだけでなく、海賊に打って出ることを決める。彼女はパイロットと[[character/3]]を[[station/8]]近くの海賊団の討伐に送り出す。", false],
		[25, "", "[[station/10]]への道中では海賊が予想されていたが、そこでの本当の脅威は植民地だったことが判明する。", false],
		[26, "", "より優れた戦士になるよう命じられたパイロットは、撃破数を増やすため海賊狩りに乗り出す。", false],
		[42, "", "[[station/17]]近くの海賊の隠れ家が、新たに装着した[[world/eclipse|Eclipse]]の試験場となる。", false],
		[43, "", "そこにいた海賊たちはすぐに増援を呼ぶ。", false],
		[47, "", "最後の攻勢の最中でさえ、海賊は[[station/0]]へ向かう[[character/5]]の足を止める。", false],
		[1, "ゲーム内", "海賊は外洋での標準的な敵である。パイロットのランクが上がり、ストーリーが進むにつれ、船体は頑丈に、武器は強力になる。[[contract/0]]、[[contract/1]]、[[contract/2]]、[[contract/3]]の契約に登場し、機雷原や残骸の散乱域を守っている。[[guide/combat]]を参照。", false],
		[1, "", "[[chapter/12|第12章]]以降は、パイロットが到着したときにステーションの近くで最大3隻の海賊が待ち構えていることがあり、その確率は章を追うごとに高まる。[[chapter/16|第16章]]からは、海賊などの敵対的な艦船も急加速を使うようになる。", false],
		[1, "", "1回の航海で海賊を撃破するたびに、次のステーションで支払われる賞金が上がる。撃破数の2乗に、入植者のステーションでは100クレジット、反乱軍のステーションでは50クレジットを掛けた額である。そのため長い狩りは短い狩りよりはるかに稼げる。残骸はゆっくり沈むので、深く沈みすぎる前にハープーンで積荷を回収できる。", false],
		[1, "", "海賊は自分たちのステーションを持たず、海賊の側につくステーションもない。", false],
	],
	"faction/rebels": [
		[1, "", "反乱軍は、ステーションを支配しうる勢力のひとつである。その性格と目的は、物語が進むにつれて明らかになる。[[guide/allegiance]]を参照。", false],
		[12, "", "反乱軍は、この海洋惑星の植民地支配に対して立ち上がったレジスタンス運動である。[[station/3]]を拠点とする秘密のネットワークとして始まり、ステーションからステーションへと広がっていく。彼らが望むのは自由貿易と、略奪されるのではなく大切に利用される海だ。", false],
		[12, "歴史", "パイロットが初めて運動の存在を知ったとき、運動はすでに活動していた。きっかけは、M.A.I.がTalonから傍受した無線通信である。", false],
		[13, "", "反乱軍は、その放送のわずか数日後に通信の暗号化を始めた。メンバーは計画を内に秘め、新参者を信用する前に試す。", false],
		[18, "", "長い間、運動は説得によって拡大していく。工作員がステーションについての情報を集めて指導者たちを味方につけ、まもなくニュースは運動を革命と呼ぶようになる。ピエールは、平和的な段階は長く続かないと見ている。", false],
		[26, "", "[[station/10]]での待ち伏せは、外交だけでは闘争に勝てないことを示し、運動は戦いへの備えを始める。", false],
		[31, "", "入植者の数の優位を覆すため、反乱軍の指導部は[[world/abel|アベル教授]]とそのチームを[[station/14]]に呼び寄せ、そこが運動の作戦拠点となる。", false],
		[13, "組織", "運動は小規模で、緊密に組織されている。新入りは到着時に審査され、知る必要のあることだけを知らされる。任務は、信頼された少数の工作員を通じて伝えられる。", false],
		[18, "", "運動の指導者は新たに獲得したステーションのひとつから運動の歩みを指揮しているが、そのステーションがどこなのかは、メンバーでさえはっきりとは知らない。", false],
		[19, "", "指導者は自ら交渉するためにステーション間を移動する。その下で現場の工作員、パイロット、技術者が働いている。", false],
		[45, "", "戦争の終わりには、運動は戦闘艦の部隊を丸ごといくつも送り出せるようになっている。", false],
		[13, "目的と手段", "反乱軍は惑星とその住民への搾取を非難し、自由貿易を掲げている。", false],
		[15, "", "その経済は植民地とは正反対である。海が差し出せる分だけを漁獲・採取し、自分たちの工場で漁獲を商品に加工して公正な市場価格で取引し、生物多様性の保全に気を配っている。", false],
		[16, "", "彼らは人々と戦うより味方に引き入れることを好む。工作員はステーションを偵察し、住民を味方につけるために利用できる弱点を探る。", false],
		[21, "", "指導者は、植民地の搾取が他の惑星と同じようにこの惑星を枯渇させると警告する。運動は、そうなる前に影響力のある人々を説得して仲間に加えようとしている。また、混乱から利益を得る海賊にも戦いを挑む。", false],
		[31, "", "武力が避けられなくなると、反乱軍は艦船の数で植民地と張り合うのではなく、決定的な兵器を作ることにする。", false],
		[12, "主なメンバー", "[[character/4]]は[[station/3]]で新参者を審査する。反乱軍の無線士、警備兵、輸送船団の乗組員は[[character/7]]として登場する。", false],
		[13, "", "[[character/5]]は、パイロットに運動の生き方を教える現場の工作員である。", false],
		[33, "", "ピエールは後に[[station/14]]の格納庫を取り仕切り、運動の艦船をいつでも出撃できる状態に保つ。", false],
		[19, "", "[[character/2]]は運動を率いる年配の女性である。パイロットは指導者を男性だと思い込んでいた。", false],
		[21, "", "[[character/3]]はアユミ配下で最も優れたパイロットのひとりで、腕は立つが傲慢だ。", false],
		[28, "", "レイモンドは植民地の賞金のために裏切り、アユミを拉致する。", false],
		[31, "", "[[world/abel|アベル教授]]は、[[world/biotek]]を手がける科学チームを率いている。", false],
		[45, "", "[[character/12]]は、[[station/18]]への攻撃でパイロットに加わる戦闘部隊を率いている。", false],
		[12, "ストーリーでの役割", "植民地と決裂したパイロットは、Talonで運動を探し求める。", false],
		[13, "", "ピエールはパイロットを見習いとして受け入れる。最初の任務は、レアを[[station/4]]から[[station/5]]へ連れて行くことだ。", false],
		[16, "", "その後も任務が続く。反乱軍のステーションでの商品の生産と、運動のためのステーションの偵察である。", false],
		[19, "", "パイロットはついにアユミと出会い、[[station/7]]の近くでイカの群れを入植者の狩人から守る。", false],
		[22, "", "パイロットはレイモンドと共に、[[station/8]]近くの海賊団を壊滅させる。", false],
		[24, "", "続いてパイロットは、[[station/9]]近くの植民地の機雷原を除去する。", false],
		[26, "", "Sulaで指導部が待ち伏せを受ける。レイモンドの銃は肝心なときに故障し、レアは破壊工作を疑う。", false],
		[28, "", "レイモンドはアユミを人質にしてパイロットを罠におびき寄せるが、パイロットは彼の艦船を撃破し、彼女を生きたまま救い出す。", false],
		[31, "", "運動は三段階の計画を始動させる。まずは盗まれた[[world/biotek]]の奪還からだ。", false],
		[33, "", "第二段階は[[world/eclipse|Eclipse]]砲の入手で、パイロットは闇商人を通じてそれを購入する。", false],
		[39, "", "第三段階は、ジェネレーターを完成させるインキュベーターを[[station/16]]で作ることだ。", false],
		[44, "", "兵器は入植者がFiirを攻撃する直前に完成する。パイロットのEclipseと、[[world/aquarians|アクアリアン]]の突然の援護がステーションを救う。", false],
		[45, "", "アクアリアンは支援を誓い、運動は彼らを味方として最後の攻勢を計画する。", false],
		[47, "", "二つの攻勢が続く。レアが[[station/109]]を、パイロットが[[station/18]]を奪取する。", false],
		[48, "", "戦争は[[station/0]]の陥落で終わり、運動は惑星のすべてのステーションを手にする。", false],
		[1, "ゲーム内", "反乱軍のステーションは[[chart]]上でオレンジ色に表示される。自由市場と工場を運営しているため、商品を買い、売り、作ることができる。[[guide/trading]]を参照。造船所では、すべての船体が強化版で売られている。反乱軍のステーション周辺の巡視艦は反乱軍のために戦う。", false],
		[1, "", "掲示板には[[contract/0]]、[[contract/1]]、[[contract/2]]、[[contract/3]]、[[contract/6]]、[[contract/8]]、[[contract/9]]、[[contract/10]]、[[contract/13]]、[[contract/14]]の契約が並ぶ。護衛、輸送船団の襲撃、魚の狩猟、カプセルの仕事は掲示されず、魚の保護もストーリー完了後は掲示されなくなる。反乱軍の契約で他の艦船と戦う場合、相手は入植者か海賊である。", false],
		[1, "", "反乱軍のステーションは、海賊に対して入植者の半額の賞金を支払う。その航海で撃破した数の2乗に50クレジットを掛けた額である。", false],
		[12, "", "ステーションはストーリーの進行に伴って反乱軍に加わる。最初は数個ずつ、やがて何十も一度に加わる。加わったステーションが植民地に戻ることはない。このページには、到達済みの各章で加わるステーションが載っている。", false],
	],
	"goods/18": [
		[1, "", "ハープーンで捕らえずに倒した生物の残り。死骸は浮かび上がり、ハープーンで引き寄せると元の動物の3分の1の質量の肉が得られる。価格は12〜31 crで、主に[[species/14]]と共に[[goods/19]]の材料として使われる。原産ステーションは[[station/68]]である。", false],
	],
	"goods/19": [
		[1, "", "[[goods/18]]と[[species/14]]を1つずつ使って1個作る基本的な製品。どの工場でも作れる。価格は[[station/78]]での135 crから[[station/27]]での360 crまでで、[[goods/30]]と[[goods/36]]の材料になる。", false],
	],
	"goods/20": [
		[1, "", "[[species/3]]の皮を[[goods/33]]でなめしたもの。原産ステーションは[[station/164]]で、最も高く売れるのは[[station/172]]で、最大1,062 crになる。[[goods/29]]のレシピの半分でもあるため、マンタの漁獲を最も高価な消費財のひとつに変えることができる。", false],
	],
	"goods/21": [
		[1, "", "生の魚と海藻の料理で、[[species/4]]と[[species/17]]から作る。どちらの材料もありふれた安い獲物なので、寿司は最初の製品として手軽である。価格は[[station/76]]での420 crから[[station/179]]での996 crまで。", false],
	],
	"goods/22": [
