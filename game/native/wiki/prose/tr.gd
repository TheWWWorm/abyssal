	"chapter/32": [
		[32, "Özet", "Pilot, kurtarılan kargoyla [[station/14]] istasyonuna döner.", false],
		[33, "Sonuç", "Profesör Abel ganimeti laboratuvarına götürür. [[character/2]], [[character/5]] adlı pilotu [[station/14]] istasyonunun dışında devriyeye, [[character/4]] adlı direnişçiyi ise hangara gönderir ve pilota ikinci adımı verir. Jeneratörün gücüne layık bir silah gerekmektedir: [[equipment/42]]. Bu istasyon savunma topu o kadar çok enerji tüketir ki hiçbir gemiye takılmamıştır. En yakın fabrika olan [[station/188]] kolonistlerin elindedir, bu yüzden pilot [[station/15]] istasyonunda şansını denemelidir. Top satılık değildir; Ayumi rüşvet için büyük bir meblağ verir.", false],
	],
	"chapter/33": [
		[33, "Özet", "[[character/2]] adlı liderin planının ikinci adımı başlar. Pilot bir [[equipment/42]] edinmek için asi istasyonu [[station/15]] yolunu tutar. Top normalde kolonist istasyonu [[station/188]] bünyesinde üretilir ve hiçbir yerde açıkça satılmaz. Pilot, Ayumi'den aldığı büyük bir rüşvet fonunu taşımaktadır, ama gerçek bir planı yoktur ve varınca bir fırsat çıkmasını umar.", false],
		[34, "Sonuç", "Pilot [[station/15]] istasyonuna varır. Ne bağlantısı ne de planı olduğu için tek seçenek istasyonda dolaşıp neyin çıkacağını görmektir.", false],
	],
	"chapter/34": [
		[34, "Özet", "[[station/15]] istasyonunda iz, yerel tüccarın stokuyla başlar. Hedef, bu istasyonda yasa dışı bir mal olan [[goods/37]] kargosu edinmektir; bu da doğru türden ilgiyi çeker.", false],
		[35, "Sonuç", "[[character/8]] adlı bir karaborsa satıcısı yaklaşır ve neredeyse her şeyi temin edebileceğini söyler. Pilot bir [[equipment/42]] isteyince şaşırır, ama bir iyilik karşılığında denemeyi kabul eder: [[character/11]] adlı ödül avcısı ortadan kaldırılmalıdır. Bu adam, Fenko'dan kurtulmak için güvenlik yetkililerinden para almaktadır ve istasyon yakınında devriye gezmektedir.", false],
	],
	"chapter/35": [
		[35, "Özet", "Pilot, [[station/15]] istasyonu yakınında [[character/8]] adlı satıcının ortadan kaldırılmasını istediği ödül avcısı [[character/11]] peşine düşer. Raoul yalnız değildir: yanında eskortlar getirmiştir ve pilotu sıradan bir balıkçı diye savuşturmaya çalışır. Pilot aranan gemiyi yok etmelidir. Bkz. [[contract/0]].", false],
		[36, "Sonuç", "Raoul'un gemisi, son bir kez dil dökerek kurtulma girişiminin ardından yok edilir; eskortları ise kaçırılır ya da batırılır. Pilot, [[character/8]] adlı satıcının sözünü tutup tutmayacağını görmek için geri döner.", false],
	],
	"chapter/36": [
		[36, "Özet", "Pilot, [[character/8]] adlı satıcının vaadini tahsil etmek için [[station/15]] istasyonuna yanaşır. Bir karaborsacının sözünü tutacağına güvenilip güvenilemeyeceğinden emin değildir.", false],
		[37, "Sonuç", "Fenko bir [[equipment/42]] bulmuştur ve onu, ödediği rüşvetler yüzünden şişmiş bir fiyata satacaktır. Pilot nereden geldiğini sorunca Fenko satıcının adını verir: [[character/9]]. [[character/1]], Jack'in açgözlülüğünün kendi düşmanlarını silahlandırmasındaki ironiden keyif alır. Pilot, bir şey değişmeden topu satın alıp ayrılmaya karar verir.", false],
	],
	"chapter/37": [
		[37, "Özet", "[[character/8]], [[station/15]] istasyonunda artık [[goods/38|Eclipse topunu]] satışa sunmaktadır. Pilot onu ticaret ekranından satın alıp gemiye yüklemelidir. Fiyat yüksektir, ama Ayumi'nin rüşvet fonu tam da bunun içindir; ambarda bu büyük top için yer olmalıdır. Bkz. [[guide/trading]].", false],
		[38, "Sonuç", "Top ambardadır ve [[character/1]] buna pek inanamaz. İkinci adım tamamlanmıştır. Pilot, prototip jeneratörün ne durumda olduğunu görmek için [[station/14]] istasyonuna geri döner.", false],
	],
	"chapter/38": [
		[38, "Özet", "Pilot, ambarında [[equipment/42]] ile [[station/14]] istasyonuna döner. Profesör Abel'ın prototipte ne kadar ilerlediğini görmeye heveslidir.", false],
		[39, "Sonuç", "[[character/2]], topun nasıl elde edildiğini bilmemeyi tercih eder. Prototip neredeyse bitmiştir, ama bir parça [[station/14]] istasyonunda yapılamaz: jeneratörün güç tepkimesini başlatmak için alg parçacıklarının DNA'sını çoğaltan bir cihaz, yani bir [[goods/36]]. Onu yapacak donanım yalnızca [[station/16]] istasyonunda vardır, bu yüzden üçüncü adım pilotu oraya gönderir. [[character/1]], pilotun isyanı neredeyse tek başına yürüttüğünü söyler.", false],
	],
	"chapter/39": [
		[39, "Özet", "Üçüncü adım başlar. Pilot, Biotek jeneratörünün ihtiyaç duyduğu [[goods/36]] ürününü yapacak donanıma sahip tek istasyon olan [[station/16]] yolunu tutar. [[station/16]] çoğu istasyondan daha derindedir, bu yüzden gemi istasyona güvenle ulaşmadan önce daha güçlü zırha ihtiyaç duyabilir. Bkz. [[guide/depth]].", false],
		[40, "Sonuç", "Pilot [[station/16]] istasyonuna yanaşır ve inkübatörün neler gerektirdiğini çözmeye başlar; işin hiç de basit olmayacağını tahmin etmektedir.", false],
	],
	"chapter/4": [
		[4, "Özet", "İstasyondan ayrılmayı anlatan bir eğitim bölümü. Pilot korsan aramak için [[station/0]] istasyonundan ayrılır, ancak yakın sular sakindir. M.A.I. bu yüzden başka bir istasyona geçmeyi önerir.", false],
		[5, "Sonuç", "M.A.I., uzun yolculuklarda kullanılan akıntı ağı S.T.R.E.A.M.'i açıklar: gemi bir sektörden her zaman bir akıntı çıkışından ayrılır ve sonrakine bir akıntı girişinden varır. Yolculuğu otopilot üstlenebilir. Bkz. [[guide/navigation]].", false],
	],
	"chapter/40": [
		[40, "Özet", "Pilot, [[station/16]] istasyonunun fabrikasında bir [[goods/36]] üretmelidir. İnkübatör gelişmiş bir üründür ve tarifi, önce başka yerlerde avlanması, satın alınması ya da üretilmesi gerekebilecek birkaç malzeme ister. [[character/1]] bunun karmaşık olacağını düşünür, pilot da öyle. Bkz. [[guide/trading]].", false],
		[41, "Sonuç", "İnkübatör tamamlanır. M.A.I., pilotun bunu başarabileceğinden şüphe ettiğini itiraf eder. Tüm bunların doğru olup olmadığı konusunda hâlâ huzursuz olan pilot, rotayı [[station/14]] istasyonuna çevirir.", false],
	],
	"chapter/41": [
		[41, "Özet", "Pilot, [[goods/36]] ürününü, prototip jeneratörü tamamlamak için Profesör Abel'ın beklediği [[station/14]] istasyonuna güvenle ulaştırmalıdır. Bu, [[character/2]] adlı liderin üç adımlı planının eksik kalan son parçasıdır.", false],
		[42, "Sonuç", "İnkübatörü [[character/5]] teslim alır. Profesör Abel her şeyi hazırlamıştır ve [[equipment/42]] yakında hangarda bulunabilecektir. Ayumi topun hemen korsanlara karşı denenmesini ister; Leah koordinatları iletir ve jeneratörün yalnızca bir prototip olduğu konusunda uyarır. Güya kapatılmış olan [[character/1]], her kelimeyi duyduğunu açıkça belli eder.", false],
	],
	"chapter/42": [
		[42, "Özet", "[[station/14]] istasyonunun hangarında [[equipment/42]] takıldıktan sonra pilot, topu savaşta denemek için [[station/17]] istasyonu yakınındaki bir korsan sığınağına yönelir. Jeneratör yalnızca bir prototiptir, bu yüzden deneme aynı zamanda yük altında dayanıp dayanmadığının da sınavıdır. Korsanlar neyle karşı karşıya olduklarını görünce takviye çağırır ve çatışmanın ortasında yeni gemiler gelir.", false],
		[43, "Sonuç", "Çatışma sona ererken [[character/1]], [[station/14]] istasyonundan şifresiz bir kanaldan açıkça gönderilen bir imdat çağrısı yakalar. Pilot hemen geri döner.", false],
	],
	"chapter/43": [
		[43, "Özet", "Kolonist kuvvetleri [[station/14]] istasyonuna ani bir saldırı başlatmıştır. Pek çok rıhtım hasar görmüştür ve asiler yeterince gemiyi denize indirememektedir. Saldırıyı [[character/9]] yönetir ve pilotla alay eder, ta ki [[equipment/42]] silahının ateşe hazır olduğunu duyana dek. Pilot istasyonu ve dost gemilerini savunmalıdır.", false],
		[44, "Sonuç", "Savaşın ortasında Aquarianlar gelir ve kolonistlere saldırarak asilerin yanında savaşır. Saldırı çökünce Jack kaçar. [[character/2]] kurtuluşu bir mucize olarak niteler ve özel bir misafirden söz ederek pilottan yanaşmasını ister.", false],
	],
	"chapter/44": [
		[44, "Özet", "Pilot, savaşın ardından [[station/14]] istasyonuna yanaşır.", false],
		[45, "Sonuç", "Özel misafir bir Aquarian temsilcisidir. Aquarianlar, herkesin denizle uyum içinde yaşayabilmesi için kolonist yönetimini sona erdirmeye yardım edecektir. [[character/2]], kalan istasyonları almak için iki büyük taarruz planlar. [[station/188]] artık asilerin elinde olduğundan olabildiğince çok gemi [[equipment/42]] ile donatılmaktadır. Pilot, yeni birlikler ve Aquarian desteğiyle [[station/18]] saldırısına önderlik edecek, [[character/5]] ise [[station/109]] taarruzunu yönetecektir.", false],
	],
	"chapter/45": [
		[45, "Özet", "Pilot, [[station/18]] istasyonunda Atmos birliğinin lideri [[character/12]] ile buluşur; birliğin gemileri saldırı emrini beklemektedir. Aquarianlar katılmak için derinliklerden yükselir. İstasyon alınmadan önce, yük gemileri de dahil olmak üzere her kolonist gemisi yok edilmelidir. Bu sırada [[character/5]], [[station/109]] istasyonuna paralel bir saldırı yönetmektedir.", false],
		[46, "Sonuç", "Kolonist savunucular ve yük gemileri yok edilir; birleşik asi ve Aquarian gücü istasyon çevresindeki suları tutar. Pilot, Colin'in birliğinin yarısını istasyon çevresinde devriyeye gönderir ve geri kalanıyla yanaşmaya gider.", false],
	],
	"chapter/46": [
		[46, "Özet", "Pilot, ele geçirilen istasyonu güvenceye almak için [[character/12]] adlı liderin birliğinin bir kısmıyla [[station/18]] istasyonuna yanaşır; geri kalanlar dışarıda devriye gezer.", false],
		[47, "Sonuç", "[[character/5]], [[station/109]] saldırısının da başarılı olduğunu ve güneydeki istasyonların artık asilerin denetiminde bulunduğunu bildirir. Ayumi pilota son görev olabilecek işi vermiştir: kolonistlerin son büyük kalesi ve pilotun hikâyesinin başladığı istasyon olan [[station/0]]. İstasyon güçlü biçimde tahkim edilmiştir ve [[character/2]] çoktan yola çıkmıştır. Leah da onu izler, ama korsanlar yolunu kesmektedir.", false],
	],
	"chapter/47": [
		[47, "Özet", "Pilot, son savaş için [[station/0]] istasyonunda [[character/2]] ve [[character/5]] ile buluşur. İstasyon alınmadan önce savunmadaki her gemi yok edilmelidir. Savunucuların arasında [[character/9]] bulunmaktadır. Pilot, [[character/3]] adlı hainin akıbetini hatırlatınca Jack, pilotun babası ve Raymond'ın da pilotun kardeşi olduğuna dair saçma bir hikâyeyle pilotu sarsmaya çalışır. Pilot bunu hemen görür.", false],
		[48, "Sonuç", "Kolonist filosu, geriye yalnızca Jack kalana dek erir. Jack hızlı ve tehlikeli olduğunu gösterir, ama sonunda pilot gemisini etkisiz bırakır. Jack, tüm istasyonu da beraberinde götürüyormuş gibi görünen bir kurtarma kapsülüyle yukarı kaçar ve giderken gezegeni küçümser. Savaş sona ermiştir.", false],
	],
	"chapter/48": [
		[48, "Özet", "Savaş kazanılmıştır. Kolonist filosu yenilmiş, [[character/9]] gezegenden kaçmış, [[station/0]] ve son direnen istasyonlar da asilerin davasına katılmıştır. Artık her istasyon hareketin yanındadır.", false],
		[48, "", "Galipler durum değerlendirmesi yapar. [[character/2]], pilota ve [[character/5]] adlı pilota teşekkür eder; gezegenin yaralarının iyileşmesinin uzun süreceğini kabul eder, ama bunu da başarabileceklerine inanır. Leah, pilotu [[goods/21]] eşliğinde kutlamaya davet eder ve pilot kabul eder. Pilot karaya döndüğünde kendisine bellek yükseltmesi sözü verilen [[character/1]], böyle bir şeye ihtiyacı olmadığında ısrar eder ve sonuna dek çiftle dalga geçmeyi sürdürür.", false],
		[48, "", "Sefer tamamlanmıştır. Pilot, artık asilerle barış içindeki bir dünyada keşfetmeye, ticaret yapmaya ve sözleşme almaya devam edebilir.", false],
	],
	"chapter/5": [
		[5, "Özet", "Pilotun ilk çatışması [[station/1]] istasyonu yakınlarında geçer. M.A.I. silahlarla zıpkın arasında nasıl geçiş yapılacağını, otomatik ateşin nasıl yardım ettiğini ve radarın nasıl okunacağını anlatır: kırmızı işaretler düşman, yeşil işaretler dost, sarı işaretler ise yol noktasıdır. Kısa süre sonra ekranda tek bir [[faction/pirates|korsan]] belirir. Bkz. [[guide/combat]].", false],
		[6, "Sonuç", "Korsan yok edilir. M.A.I., enkazların geride kargo sandıkları bıraktığını ve bunların erişilemeyecek derinliğe batmadan önce zıpkınla toplanabileceğini belirtir, ardından rotayı yeniden [[station/0]] istasyonuna çevirir.", false],
	],
	"chapter/6": [
		[6, "Özet", "İlk başarılı çatışmanın ardından pilot, çalışan bir silahla ve belki satılacak biraz kurtarılmış kargoyla [[station/0]] istasyonuna döner. Bu, akıntı ağı üzerinden kısa bir dönüş yolculuğudur.", false],
		[7, "Sonuç", "[[character/9]] yeni silahı fark eder ve \"gerçek iş\" dediği bir teklifte bulunur. [[species/0|Nautiluslar]], [[station/1]] istasyonu çevresindeki konvoy rotalarını doldurmuştur ve istasyon güvenliği onlardan kurtulmak ister. Pilot, bu canlıların yalnızca istasyon gövdelerindeki birikintilerle beslendiğini ve ambarın hepsini taşımaya yetmeyeceğini söyler. Jack iki itirazı da geçiştirir: hayvanlar, yöntemi ne olursa olsun, ortadan kalkmalıdır.", false],
	],
	"chapter/7": [
		[7, "Özet", "Pilot, [[station/1]] istasyonu yakınında [[species/0|nautilusları]] temizlemelidir. Onları öldürmek de yakalamak da sayılır. Canlılar hem az hem de zararsız olduğundan ne pilot ne de [[character/1]] bu işten hoşnuttur, ama işi bitirmeye karar verirler.", false],
		[8, "Sonuç", "Bu iş pilotu sarsar. Pilot gezegene balık tutmaya gelmiştir, koloninin rahatı için hayvan katletmeye değil. M.A.I. ücretin hiç değilse bunu telafi etmesini umar ve parayı almak için [[station/1]] istasyonuna yanaşmayı önerir.", false],
	],
	"chapter/8": [
		[8, "Özet", "Pilot, nautilus avı hakkında rapor vermek için [[station/1]] istasyonuna yanaşır.", false],
		[9, "Sonuç", "Bir kolonist yetkili pilotu pek gizlenmeyen bir küçümsemeyle karşılar, işi haşere kontrolü gibi görür ve canlılar hep geri geldiği için muhtemelen anlamsız olduğunu kabul eder. Önerilen ücret düşüktür ve pazarlığa kapalıdır. Yetkili, yeni iş vermeden önce yetenek kanıtı ister: istasyon iş panolarından tamamlanmış üç iş. [[character/1]] sözleşmelerin nasıl bulunacağını açıklar, bazı iş yerlerinin geminin derinlik sınırlarının ötesinde kalabileceği konusunda uyarır ve istasyon haritasından rota planlamayı gösterir.", false],
	],
	"chapter/9": [
		[9, "Özet", "Serbest çalışma üzerine bir bölüm. Pilot, herhangi bir istasyonun iş panosundan üç sözleşme tamamlamalıdır. Sözleşmeler eskortluk ve kurtarmadan av siparişlerine kadar çeşitlidir; birkaç istasyona bakmak kazançlı olur. Bkz. [[guide/contracts]].", false],
		[10, "Sonuç", "Memnun kalan kolonist yetkili özel bir görev önerir. Kolonistlerin Aquarian dediği, yarı insan yarı balık garip varlıklar, koloninin mallarını toplanmak üzere yörüngeye taşıyan nakliye kapsüllerine saldırmaktadır. Hasarlı ya da kayıp kapsüller, istasyonun ticaret yetkilileri gözündeki itibarını zedeler. Sonraki fırlatma [[station/2]] istasyonundadır ve operasyonu [[character/9]] yönetecektir. Pilot Aquarianları uzaklaştıracak ve ona rapor verecektir.", false],
	],
	"character/0": [
		[1, "", "Pilot, oyuncunun karakteridir: koloni kurulmuş bir okyanus dünyasına yeni gelmiş, küçük bir denizaltı kullanan ve geçimini balıkçılıkla sağlayan biri. Pilotun adını oyuncu seçer; günlükteki kısa bölüm özetleri de pilotun kendi notları olarak yazılmıştır. Pilot denizde asla yalnız değildir, çünkü gemi bilgisayarı [[character/1]] neredeyse her hamleye yorum yapar. Hikâye, pilotun avını koloniye sattığı [[station/0]] istasyonunda başlar.", false],
		[1, "Geçmiş", "Pilotun seferden önceki hayatı hakkında pek bir şey anlatılmaz. Pilot gezegene balık tutmak için gelmiştir ve daha ilk görevden itibaren bu taşınmadan pişmandır; bir gemi bilgisayarından emir almak zorunda kalmaktan da yakınır. Geri kalan her şey, pilotun söylediklerinden ve yaptıklarından çıkarılmalıdır.", false],
		[7, "", "Pilot denizi ve canlılarını iyi tanır. Koloni, konvoy rotalarını dolduran [[species/0|nautiluslardan]] yakınınca pilot, bu hayvanların istasyon gövdelerini kaplayan algler ve diğer birikintilerle beslendiğini, dolayısıyla orada bulunmalarının hiç de şaşırtıcı olmadığını belirtir.", false],
		[12, "", "Başta pilotun hedefleri mütevazıdır. Pilot gezegenden ayrılacak bir bilete yetecek kadar para kazanmak ister, ama av için ödenen sabit fiyatlar bu hedefi ulaşılmaz kılar. Daha sonra direnişe katılmak istediğinde pilot, memleketi olarak [[station/0]] istasyonunu gösterir.", false],
		[1, "Koloni için balıkçı", "Hikâye, pilotun kargo ambarını doldurup [[station/0]] istasyonuna rota çizmesiyle açılır ([[chapter/1]], [[chapter/2]]).", false],
		[3, "", "Orada [[character/9]] av için sabit bir ücret öder, küçük ambarla alay eder ve pilota bunun yerine [[faction/pirates|korsan]] avlamayı denemesini önerir.", false],
		[6, "", "Pilot bir [[equipment/0]] takar ve [[station/1]] istasyonu yakınında ilk korsanını düşürür ([[chapter/3]] ile [[chapter/5]] arası).", false],
		[7, "", "Ardından [[character/9]] daha tatsız bir iş verir: [[station/1]] istasyonu çevresindeki rotaları [[species/0|nautiluslardan]] temizlemek ([[chapter/7]]).", false],
		[8, "", "Bu itlaf pilotun midesini bulandırır. Pilot balık tutmaya gelmiştir, zararsız hayvanları katletmeye değil.", false],
		[10, "", "[[station/1]] istasyonundaki koloni yetkilisi az öder, güvenilirlik kanıtı olarak üç sözleşme ister ([[chapter/9]]) ve ardından pilotu [[station/2]] istasyonunda nakliye kapsüllerini [[world/aquarians|Aquarianlara]] karşı savunmaya gönderir ([[chapter/10]]).", false],
		[12, "", "Pilot çatışmayı kazanır, ama [[world/aquarians|Aquarianların]] neden saldırdığını merak etmeye başlar. [[character/9]] hasarlı kapsüller için pilotu suçlayıp ödülü vermeyince [[character/1]], [[station/3]] istasyonundaki bir direniş hareketinin konuşmalarına kulak misafiri olduğunu açıklar ve pilot onu bulmaya karar verir ([[chapter/12]]).", false],
		[12, "Direnişe katılmak", "[[station/3]] istasyonunda asi muhafızlar ateş açmakla tehdit eder; pilot yanaşma izni almadan önce kekeleyerek bir ad ve katılma isteğini dile getirmek zorunda kalır.", false],
		[13, "", "[[character/4]], esas olarak hareketin her yardımcıya ihtiyacı olduğu için pilotu deneme süresiyle kabul eder ve pilotu [[station/4]] istasyonundan bir irtibat kişisini almaya gönderir ([[chapter/13]]).", false],
		[14, "", "İrtibat kişisi [[character/5]] çıkar ve pilot onu [[station/5]] istasyonuna götürürken gözle görülür biçimde büyülenir ([[chapter/14]]).", false],
		[16, "", "[[character/5]], pilota asilerin denizden geçinme biçimini gösterir ([[chapter/15]]), ardından hareket için yeni istasyonları keşfetmesini ister ([[chapter/16]]). Pilot devrim sözcüğünü ilk kez o zaman duyar.", false],
		[18, "", "[[station/3]] istasyonuna dönüldüğünde [[character/4]] hareketin diplomatik kazanımlarını bildirir ve pilotu neredeyse hiçbir ipucu olmadan hareketin liderini bulmaya gönderir ([[chapter/18]]).", false],
		[19, "Liderin hizmetinde", "Lider, pilotla [[station/6]] istasyonunda buluşan [[character/2]] çıkar; pilot bir erkek beklemiştir. Liderin ilk emri, bir [[species/10|renk değiştiren kalamar]] sürüsünü kolonist avcılardan korumaktır ([[chapter/19]]).", false],
		[21, "", "Lider sonunda hareketin amaçlarını açıklayınca pilot davaya bağlanır. Lider, pilotu en iyi savaşçısı [[character/3]] ile birlikte bir korsan çetesinin üzerine gönderir ([[chapter/21]]).", false],
		[23, "", "[[character/3]] pilota baş belası gibi davranır. [[station/9]] istasyonunda pilot, [[character/9]] adlı yetkilinin artık hareketin düşmanı olduğunu öğrenir ve onun bir asi ikmal yolu boyunca döşettiği mayın tarlasını hevesle temizler ([[chapter/23]]).", false],
		[25, "", "[[character/5]] ile yeniden buluşan pilot, [[character/2]] ve [[character/3]] adlı ikiliye [[station/10]] istasyonundaki görüşmelere kadar eskortluk etmekle görevlendirilir ([[chapter/25]]).", false],
		[26, "", "[[character/9]] adlı yetkilinin kuvvetleri pusudadır. [[character/3]] silahlarının arızalandığını iddia ederek kaçar; pilot ile [[character/5]], [[character/2]] adlı lideri tek başlarına korur. [[character/2]] ardından saklanır ve pilota çok daha iyi bir savaşçı olmasını söyler ([[chapter/26]]).", false],
		[27, "İhanet ve kurtarma", "[[character/3]] daha sonra acil bilgi teklifiyle arar. Pilot bir tuzaktan şüphelenir, ama [[station/11]] istasyonu yakınında onunla buluşmayı kabul eder ([[chapter/27]]).", false],
		[28, "", "Bu bir tuzaktır: [[character/3]], [[character/2]] adlı lideri esir tutmakta ve teslim olunmasını istemektedir. [[character/1]] adlı bilgisayarın planına uyan pilot, bilgisayar hainin gemisini tararken onu konuşturur ve ona bu kavganın paraya değil inanca dayandığını söyler. Ardından pilot gemisini yok eder ve zırhlı kargo bölmesini, içinde canlı [[character/2]] ile birlikte, fazla derine batmadan kurtarır ([[chapter/28]]).", false],
		[31, "Üç adımlı plan", "Bir bilim insanı konvoyunu koruduktan sonra ([[chapter/29]]) pilot, [[character/2]] adlı liderin [[world/abel]] ile bir silah yapma planını öğrenir. Pilot, [[character/4]] ve [[character/5]] ile birlikte [[world/biotek|Biotek jeneratörünü]] bir kolonist konvoyundan ele geçirir ([[chapter/31]]).", false],
		[33, "", "Sırada, satılık olmayan bir [[equipment/42]] topunu yalnızca bir rüşvet fonuyla edinmek vardır. Pilot görevin ardında ne kadar az plan olduğunu fark eder, ama memnuniyetle kabul eder ([[chapter/33]]).", false],
		[37, "", "[[station/15]] istasyonunda karaborsacı [[character/8]], pilot ödül avcısı [[character/11]] adlı adamı öldürürse bir top bulmayı kabul eder ([[chapter/35]]). Pilot bunu yapar ve [[character/8]] adlı satıcının [[character/9]] adlı yetkiliden edindiği topu satın alır ([[chapter/37]]).", false],
		[39, "", "[[character/2]], topun nasıl bulunduğunu bilmemeyi tercih eder; pilot da yalnızca hiçbir masum insanın ölmediğini söyler. Pilot planın gezegeni yönetmek için kullanılabileceği şakasını yapınca lider bu fikri kesinlikle reddeder ([[chapter/39]]).", false],
		[42, "", "Pilot ardından [[station/16]] istasyonunda [[goods/36]] üretir ve onu [[station/14]] istasyonuna getirerek silahı tamamlar ([[chapter/41]]).", false],
		[43, "Zafere giden yol", "Bitmiş silahı [[station/17]] istasyonu yakınında korsanlar üzerinde denerken pilot, [[station/14]] istasyonundan bir imdat çağrısı duyar ve geri döndüğünde ani bir saldırıyı yöneten [[character/9]] adlı yetkiliyle karşılaşır ([[chapter/43]]).", false],
		[44, "", "[[world/aquarians|Aquarianların]] yardımıyla saldırı kırılır ve [[character/9]] kaçar.", false],
		[46, "", "[[character/2]], [[station/18]] saldırısının komutasını pilota verir ([[chapter/45]]). Pilotun ilk kaygısı ikinci bir saldırıyı yöneten [[character/5]] içindir, ama pilot istasyonu [[character/12]] adlı liderin birliği ve [[world/aquarians|Aquarian]] desteğiyle ele geçirir.", false],
		[47, "", "Son savaş, hikâyenin başladığı yer olan [[station/0]] istasyonunda geçer ([[chapter/47]]). [[character/9]], pilotun babası olduğunu ve [[character/3]] adlı hainin de pilotun kardeşi olduğunu iddia ederek pilotu sarsmaya çalışır, ama pilot bu yalanı hemen geri çevirir.", false],
		[48, "", "[[character/9]] kovulur ve koloninin son kalesi düşer. Pilot övgüyü birlikte savaştığı dostlara verir ve [[character/5]] adlı direnişçinin kutlama davetini kabul eder.", false],
		[1, "Kişilik", "Pilot pratik ve hazırcevaptır; itaat etmektense karşılık vermeye daha yatkındır. Pilotun [[character/1]] ile atışmaları bütün sefer boyunca sürer.", false],
		[8, "", "Şakaların altında pilotun bir vicdanı vardır. Pilot kâr için hayvan öldürmekten hoşlanmaz ve nautilus itlafından sonra kendini kötü hisseder.", false],
		[14, "", "[[character/5]] yanındayken pilotun dili tutulur ve sakarlaşır; bunu hem o hem de [[character/1]] fark eder.", false],
		[28, "", "Pilotun güdüleri sefer boyunca değişir. [[character/3]] ile yüzleşme zamanı geldiğinde pilot, mücadelenin ideallerle ilgili olduğunu ve açgözlülüğün hainin gözünü kör ettiğini savunur.", false],
		[1, "İlişkiler", "[[character/1]], pilotun en yakın yol arkadaşıdır. İkisi sürekli atışır, ama pilot bilgisayarın öğütlerine, sonraları da kurnazlığına güvenir.", false],
		[3, "", "[[character/9]], pilotun ilk işvereni ve kalıcı rakibidir.", false],
		[14, "", "Pilot ilk karşılaşmalarından itibaren [[character/5]] adlı direnişçiye ilgi duyar ve bu duygu karşılıklı gibi görünür.", false],
		[19, "", "[[character/2]], hareketin en hassas işleri için giderek pilota güvenir. Pilota sıcaklıkla ve şakacı, neredeyse ebeveynce bir otoriteyle davranır.", false],
		[1, "Oyuncu karakteri olarak", "Oyunda pilot, oyuncu onu ne yaparsa odur. Bölüm hedefleri arasında pilot balık tutmakta, ticaret yapmakta, sözleşme almakta, savaşmakta ve gemiyi yeniden donatmakta özgürdür; hikâye ancak bir bölüm hedefine ulaşıldığında ilerler. Temel bilgiler [[guide/basics]] sayfasında anlatılır.", false],
	],
	"character/1": [
		[1, "", "[[character/1]], pilotun denizaltısının gemi bilgisayarı ve sefer boyunca pilotun yol arkadaşıdır. Geminin sistemlerini yönetir, balık tutmayı, yolculuk yapmayı ve savaşmayı açıklar, sürekli öğüt ve yorum yağdırır. Mizahı kuru ve çoğu zaman pilotun aleyhinedir, ama konuşan bir kullanım kılavuzundan çok daha fazlası olduğunu kanıtlar.", false],
		[1, "Yol arkadaşı olarak", "Uygulamada [[character/1]] oyunun rehberidir. Her yeni mekanik onun aracılığıyla tanıtılır: zıpkınla avlanma, otopilot ve istasyonlardaki yardım ekranları. Görevler sırasında telsizden konuşur, hedefleri gösterir ve tehlikelere karşı uyarır.", false],
		[5, "", "Ayrıca [[world/stream]] üzerinden uzun mesafe yolculuğunu ve düşmanların ile dostların renkli noktalar olarak göründüğü, yol noktalarının rotayı işaretlediği radarın nasıl okunacağını açıklar. Bir çatışmadan sonra pilota, yenilen gemilerin geride bıraktığı yükü kurtarmayı hatırlatır.", false],
		[12, "", "Rolü eğitmenlikle sınırlı değildir. Telsiz kanallarını tarar, istasyonları haritada işaretler ve mesajları iletir.", false],
		[28, "", "Yakın mesafeden başka gemileri de tarayabilir; bu beceri [[character/3]] ile yüzleşmede belirleyici olur.", false],
		[1, "Hikâyedeki rolü", "Sefer, [[character/1]] adlı bilgisayarın pilota işinin yakınmak değil balık tutmak olduğunu hatırlatmasıyla açılır.", false],
		[3, "", "[[character/9]] hakkındaki düşük fikrini hiç gizlemez ve pilotu satışta olan [[equipment/0]] silahını almaya yönlendirir.", false],
		[4, "", "Silah takılınca korsanlara karşı bir deneme yapılmasında ısrar eder ve onları arama işini yönetir.", false],
		[7, "", "[[species/0|Nautilus]] itlafından hoşnut değildir ve bu kadar az sayıdaki hayvanların neden ölmesi gerektiğini sorar.", false],
		[8, "", "Avdan sonra pilotun ne kadar sarsıldığını fark eder; ama her zamanki gibi aklına ilk gelen, işin hiç değilse para getirip getirmediğidir.", false],
		[11, "", "[[world/aquarians|Aquarianlar]] [[station/2]] istasyonunda kapsüllere saldırdığında, bu varlıkların kolonistlerin sandığından çok daha akıllı olabileceğini ilk öne süren odur.", false],
		[12, "Dönüm noktası", "Ana hikâyeyi [[character/1]] başlatır. [[character/9]] pilotu bir kez daha kandırınca, pilotun az karşılık için çok çalıştığını ve av üzerinde hiçbir söz hakkı olmadığını savunur. [[station/3]] istasyonunda örgütlenen bir direnişin sinyallerine kulak misafiri olduğunu açıklar, istasyonu haritada işaretler ve kararı pilota bırakır ([[chapter/12]]).", false],
		[12, "", "Varışta sessiz bir yaklaşma önerir, ama asi muhafızlar gemiyi hemen durdurunca bu fikirden vazgeçer.", false],
		[14, "Asilerin arasında", "Pilot ile [[character/5]] arasındaki yakınlıktan anında hoşlanmaz. Pilot onu kıskançlıkla takılınca, [[character/5]] adlı direnişçinin en sevdiği sözü alaycı biçimde yineleyerek karşılık verir. İkili hakkındaki iğneleyici yorumları seferin sonuna dek sürer.", false],
		[17, "", "Hareketin mesajlarını iletir; [[character/4]] adlı direnişçinin uzun mektuplarından birini tek cümlede özetler.", false],
		[18, "", "Pilot neredeyse hiçbir ipucu olmadan liderlerini bulmaya gönderilince asilerin iyi örgütlenmiş olduğundan şüphe eder.", false],
		[19, "", "[[character/2]] söz konusu olduğunda paraya düşkün yanını gösterir ve pilotun neden ücret konuşmadan çalıştığını sorar. Pilot [[character/2]] adlı lideri savununca, en azından kendisinin hiç yemek yemeye ihtiyacı olmadığını manidar biçimde belirtir.", false],
		[22, "", "[[character/3]] adlı pilotun becerisine hayrandır, ama pilota onun öfkesinden uzak durmasını öğütler.", false],
		[27, "Rehine", "[[character/3]] buluşma teklifiyle arayınca [[character/1]] bunun bir tuzak olduğunu ilan eder.", false],
		[28, "", "Buluşmada gerçek değerini gösterir. Kendini güvende hisseden bir adamın güdüleriyle övüneceğini bildiğinden pilottan [[character/3]] adlı haini konuşturmasını ister. Bu arada gemisini tarar, tek kişilik olduğunu çözer ve [[character/2]] adlı liderin zırhlı kargo bölmesinde olması gerektiği sonucuna varır. Bu sezgi, pilotun gemiyi yok edip yine de [[character/2]] adlı lideri kurtarmasını sağlar ([[chapter/27]]).", false],
		[33, "Savaş", "[[world/biotek]] ve [[world/eclipse|Eclipse]] görevleri boyunca düşük ücretten yakınmayı sürdürür.", false],
		[37, "", "Topun, açgözlülüğü kendi düşmanlarını silahlandıran [[character/9]] adlı yetkiliden geldiği ortaya çıkınca bu ironiden keyif alır.", false],
		[39, "", "Pilotun isyanı tek başına yürütüyor gibi göründüğünden yakınır.", false],
		[41, "", "Daha sonra pilotun bu yakınmaya verdiği yanıtı pilotun kendisine geri çevirir.", false],
		[42, "", "[[character/5]], [[station/14]] istasyonunda pilotu sıcak bir şekilde karşılayınca kendini kapattığını duyurur, ama aslında yalnızca bekleme modunda olduğu anlaşılır.", false],
		[43, "", "Topun saha denemesi sırasında [[station/14]] istasyonundan açık ve şifresiz bir imdat çağrısı yakalar ve bir şeylerin çok kötü gittiğini hemen anlar.", false],
		[44, "", "Ardından gelen savaşta [[world/aquarians|Aquarianların]] asilerin yanında savaşmak üzere geldiğini ilk bildiren odur.", false],
		[48, "", "Savaşın sonunda pilot ona bir bellek yükseltmesi sözü verir; bilgisayar bu teklifi biraz aşağılayıcı bulur. Sefer hakkındaki son sözü, pilot ve [[character/5]] üzerine yaptığı bir başka kuru yorumdur.", false],
		[1, "Kişilik", "[[character/1]] zeki, dobra ve kendini beğenmiş herkese karşı sabırsızdır. Kötü pazarlıkları belirtmeyi sever ve takılma fırsatını nadiren kaçırır.", false],
		[8, "", "Ayrıca kabul ettiğinden daha şefkatlidir. Gereksiz öldürmeden hoşlanmaz ve pilotun ruh hâlini gözetir.", false],
		[28, "", "Pilot çaresiz kaldığında, baskı altındaki soğukkanlı düşünüşü günü kurtarır.", false],
		[1, "İlişkiler", "Pilotla sürekli tartışır, ama birbirlerine tamamen güvenirler.", false],
		[3, "", "[[character/9]] adlı yetkiliden ilk görüşte hoşlanmaz.", false],
		[14, "", "[[character/5]] adlı direnişçiyi kıskanması süregelen bir şakadır.", false],
		[19, "", "[[character/2]] adlı lidere saygı duyar, ama ne kadar az ödediğinden yakınır.", false],
		[22, "", "[[character/3]] hakkında çabucak hüküm verir ve haklı çıkar.", false],
	],
	"character/10": [
		[5, "", "[[character/10]], görevler sırasında konuşan [[faction/pirates]] grubunun kanun kaçağı pilotları için kullanılan addır. Okyanus genelinde gemileri avlarlar ve gemi bir silah taşımaya başlar başlamaz pilotun ilk hedefleri olurlar.", false],
		[6, "Kimler konuşur", "Pilotun karşılaştığı ilk düşman, [[station/1]] istasyonu yakınındaki bir korsandır ve bir öfke çığlığıyla batar ([[chapter/5]]).", false],
		[21, "", "Kolonistlerle asiler arasındaki çatışma büyüdükçe korsanlar kargaşadan yararlanıp kolay av peşine düşer; [[character/2]] de asilerin karşılık vermesi gerektiğine karar verir ([[chapter/21]]).", false],
		[43, "", "[[station/17]] istasyonu yakınında bir korsan çetesi [[world/eclipse|Eclipse]] topunun ilk hedefi olur. Korsanlardan biri pilotun ateş gücü karşısında paniğe kapılıp yardım çağırır ve savaşa daha fazla korsan katılır ([[chapter/42]]). Onlarla savaşmak [[guide/combat]] sayfasında anlatılır.", false],
	],
	"character/11": [
		[35, "", "[[character/11]], [[station/15]] istasyonunun güvenlik yönetimince karaborsacı [[character/8]] adlı satıcıdan kurtulmak için tutulmuş bir ödül avcısıdır. [[character/8]], bir [[world/eclipse|Eclipse]] karşılığında onun ölümünü ister.", false],
		[35, "Geçmiş", "[[character/8]] adlı satıcıya göre [[character/11]], [[station/15]] istasyonu yakınındaki sularda devriye gezer. İstasyon yetkilileri için çalışan bir tür kanun adamıdır ve hedefi bir suçludur. Bu da pilotun görevini ahlaken tedirgin edici kılar: asilerin ihtiyaç duyduğu silahı edinmek için pilot, yasa dışı mal satan biri adına bir adamı öldürmelidir.", false],
		[36, "Hikâyedeki rolü", "Pilot onu bulduğunda [[character/11]] yalnız değildir; birkaç eskortla yol alır. Pilota yoldan çekilmesini emreder, ona balıkçı der ve yapacak bir işi olduğunda ısrar eder. Çatışma aleyhine dönünce, meseleyi yine de barışçıl yoldan çözüp çözemeyeceklerini sorar. Gemisi yok edilir ([[chapter/35]]).", false],
		[37, "", "Ölümü pilota [[character/8]] adlı satıcının yardımını kazandırır ve satıcı çok geçmeden topu satışa sunar.", false],
		[39, "", "Daha sonra pilot [[character/2]] adlı lidere yalnızca topun edinilmesi sırasında hiçbir masum insanın ölmediğini söyler.", false],
		[36, "Kişilik", "[[character/11]], kaybetmeye başlayana dek kendinden emin ve küçümseyicidir, sonra hemen bir çıkış yolu arar. Pilotu küçük bir engel, yoluna çıkmış sıradan bir balıkçı olarak görür ve pilotu fena hâlde hafife alır.", false],
	],
	"character/12": [
		[45, "", "[[character/12]], son taarruzlar sırasında pilotun [[station/18]] saldırısına katılan bir [[faction/rebels|asi]] birliği olan Atmos birliğinin lideridir.", false],
		[45, "Hikâyedeki rolü", "[[character/2]], pilot [[station/18]] istasyonuna giderken pilot için birlikler toplayacağına söz verir. [[character/12]] adlı liderin birliği de bunlardan biridir. Pilot vardığında lider, gemilerinin mevzide olduğunu ve saldırı emrini beklediğini bildirir. Aynı anda bir grup [[world/aquarians|Aquarian]] derinliklerden gelir ve savaş pilotun emriyle başlar ([[chapter/45]]).", false],
		[46, "", "Birlikte yük gemileri dahil her kolonist gemisini yok ederler.", false],
		[46, "", "Savaştan sonra pilot, [[character/12]] adlı lidere gemilerinin yarısını istasyon çevresinde devriyeye göndermesini, geri kalanının ise denetimi ele almak için pilotla birlikte yanaşmasını emreder. Lider bunu sorgusuz onaylar.", false],
		[47, "", "Bu savaş, asi gemilerinin ve [[world/aquarians|Aquarianların]] pilotun komutası altında omuz omuza savaştığı ilk savaştır; başarısı da koloniye yönelik son saldırının yolunu açar.", false],
		[45, "Kişilik", "[[character/12]] kısa konuşur ve emirleri hemen yerine getirir. Pilotun komutası altında görev yapan ilk asi subayıdır; bu da pilotun koloni için balık tuttuğu günlerden bu yana ne kadar yükseldiğinin bir göstergesidir. Telsizdeki kısa ve iş odaklı üslubu, pilotun diğer yol arkadaşlarının şakalaşmalarıyla tezat oluşturur.", false],
	],
	"character/2": [
		[18, "", "[[character/2]], pilotun [[station/6]] istasyonunda tanıştığı bir [[faction/rebels|direniş]] üyesidir.", false],
		[19, "", "Hareketin lideridir; ilk karşılaşmalarından itibaren pilotun görevlerini üstlenen yaşlıca bir kadındır. Sakin, sıcak ve kararlıdır; hareketin koloni yönetimine karşı mücadelesini yönetir.", false],
		[21, "Geçmiş", "[[character/2]] adlı liderin yönettiği hareket, kendini gezegenin yıkımına karşı çıkan insanların birliği olarak görür. Ona göre kolonileşmenin hızı ve denizin acımasızca hasat edilmesi, bitkilerine ve hayvanlarına kendini yenileyecek zaman bırakmaz; başka dünyalar da aynı şekilde tükenmiştir. Stratejisi savaşmak değil, istasyonları yönetenleri kendi tarafına çekmektir.", false],
		[23, "", "[[character/9]] adlı yetkiliyi eskiden tanır. Onunla ilk tanıştığında önemsiz biriydi ve lidere göre yükselişini herhangi bir yeteneğe değil doğru bağlantılara borçludur.", false],
		[31, "", "İstasyonlar arasında bir muhbir ağı ve bilim insanlarını, parayı ve gemileri asi bölgesinde dilediği gibi hareket ettirecek yetkisi vardır.", false],
		[19, "Hikâyedeki rolü", "[[character/2]] adlı liderin ilk emri bir eskort görevidir: pilot bir [[species/10|renk değiştiren kalamar]] sürüsünü kolonist avcılardan korumalıdır ([[chapter/19]]). Lider ne ücretten ne de hareketin planlarından pek söz eder; belli ki yeni gelene güvenilip güvenilemeyeceğini sınamaktadır. Pilot bir erkek beklediğini itiraf eder; lider bunun üzerinde durmaz.", false],
		[20, "", "İşi mütevazı biçimde ödüllendirir ve pilotu yeni işler için hemen geri çağırır.", false],
		[21, "", "Pilot yanıt isteyince hareketin amaçlarını açıklar. Ayrıca çatışmadan faydalanan korsanlara bir ders verilmesi gerektiğine karar verir ve pilotu en iyi savaşçısı [[character/3]] ile birlikte [[station/8]] istasyonu yakınındaki bir çetenin üzerine gönderir ([[chapter/21]]).", false],
		[22, "", "Ödülü iki pilot arasında eşit böler; bu da [[character/3]] adlı pilotu kızdırır. Ardından [[station/9]] istasyonundaki görüşmelere geçer.", false],
		[23, "", "Orada pilotu, [[character/9]] adlı yetkilinin [[station/37]] istasyonuna giden ikmal yolu boyunca döşettiği mayın tarlasını temizlemeye gönderir; korsanlara ve ancak tetiklendikten sonra yok edilebilen mayınlara karşı uyarır ([[chapter/23]]).", false],
		[25, "Pusu", "[[character/2]] adlı liderin sonraki hedefi, yeni görüşmelerin asilere daha fazla istasyon kazandırabileceği [[station/10]] istasyonudur. Eskort olarak [[character/3]], [[character/5]] ve pilotu yanına alır; pilotun [[character/3]] hakkındaki kuşkularını, onu inatçı ama iyi bir pilot diye niteleyerek bir kenara iter ([[chapter/25]]).", false],
		[25, "", "Varışta [[character/9]] adlı yetkiliyi kuvvetleriyle beklerken bulurlar. [[character/2]], planlarının önceden bilinmesine şaşırır.", false],
		[26, "", "[[character/3]] çatışmadan kaçar ve [[character/2]] ile kolonistler arasında yalnızca pilot ile [[character/5]] kalır. Lider sonrasında yüksek sesle bir sabotaj olasılığını düşünür, ama [[character/5]] adlı direnişçinin [[character/3]] adlı pilotun hain olduğu yönündeki suçlamasına inanmayı reddeder. Saklanır, [[station/9]] istasyonunda yönetimi [[character/5]] adlı direnişçiye bırakır ve pilotu, savaşın yalnızca diplomasiyle kazanılamayabileceği konusunda uyarır ([[chapter/26]]).", false],
		[28, "Esaret", "[[character/3]] adlı pilota duyduğu güven yersiz çıkar: hain onu yakalayıp [[character/9]] adlı yetkiliye sunar. [[station/11]] istasyonu yakınındaki yüzleşmede pilota kendi güvenliğini umursamamasını söyler. Pilot onu [[character/3]] adlı hainin batmış gemisinin kargo bölmesinden kurtarır ve lider, sarsılmış ama yarasız biçimde [[station/12]] istasyonuna ulaşır ([[chapter/28]]).", false],
		[29, "", "O zaman bile önce hareketi düşünür. Yakalanmadan önce bir grup bilim insanının [[station/14]] istasyonuna nakledilmesini ayarlamıştır ve [[character/3]] adlı hainin onları da ele vermiş olmasından korkarak pilotu hemen konvoylarını korumaya gönderir ([[chapter/29]]).", false],
		[31, "Üç adımlı plan", "[[station/14]] istasyonunda [[character/2]] planını açıklar. Asiler, sayıca hâlâ üstün olan bir koloni filosuyla giderek daha sık çatışmaktadır; bu yüzden lider, bir silah yapmaları için [[world/abel|Profesör Abel'ı]] ve ekibini getirmiştir. İş üç adımdan oluşur; ilki, kolonistlerin profesörden çaldığı bir güç kaynağı olan [[world/biotek]]. [[character/5]] baskını organize ederken lider profesörle buluşmaya gider ([[chapter/31]]).", false],
		[33, "", "İkinci adım için normalde istasyonları savunmakta kullanılan bir top olan [[world/eclipse|Eclipse]] ister. En yakın üretici olan [[station/188]] kolonistlerin elindedir ve silah satılık değildir; bu yüzden pilota büyük bir rüşvet fonu verir ve planının bundan öteye gitmediğini kabul eder ([[chapter/33]]).", false],
		[39, "", "Top geldiğinde nasıl elde edildiğini bilmemeyi tercih eder ve kan dökülmemiş olmasını umar. Pilot planın gezegeni yönetmek için kullanılabileceği şakasını yapınca kırılır. Son adım için profesörün inkübatör açıklamasını aktarır, anlamadığını açıkça kabul eder ve pilotu [[station/16]] istasyonuna gönderir ([[chapter/39]]).", false],
		[43, "Son taarruzlar", "Kolonistler [[station/14]] istasyonuna ani bir saldırı başlatınca [[character/2]] önce her şeyin kaybedildiğine inanır ([[chapter/43]]).", false],
		[44, "", "Hayatta kalır ve istasyonun kurtarılmasını pilota ve [[world/aquarians|Aquarianlara]] borçlu olduğunu söyler.", false],
		[45, "", "Halkının koloniye karşı savaşmaya yardım edeceği haberini getiren bir [[world/aquarians|Aquarian]] elçiyi ağırlar. [[station/188]] artık asilerin elinde olduğundan olabildiğince çok gemiyi [[equipment/42]] ile donatmayı planlar ve aynı anda iki taarruz başlatır: pilot [[station/18]] istasyonunu alacak, [[character/5]] ise [[station/109]] üzerine saldıracaktır ([[chapter/45]]). Pilotun [[character/5]] için endişelenmesine takılır.", false],
		[47, "", "[[station/0]] üzerine son saldırıda savaşa bizzat katılır ([[chapter/47]]).", false],
		[48, "", "Zaferden sonra pilota ve [[character/5]] adlı direnişçiye teşekkür eder ve gezegenin iyileşmesinin uzun süreceğini kabul eder.", false],
		[19, "Kişilik", "[[character/2]] sıcak ve sakindir; genç ajanlarına sanki kendi çocuklarıymış gibi hitap eder. Çok şey bekler ve az öder.", false],
		[26, "", "Adamlarına aşırı derecede sadıktır. Başkaları çoktan şüphelenmişken [[character/3]] adlı pilotu savunmayı sürdürür.", false],
		[28, "", "[[character/3]] onu bu iş için fazla yaşlı bir hayalperest olarak niteler; hikâyenin geri kalanı bu yargıyı doğrulamaz.", false],
		[33, "", "Planları ayrıntılı olmaktan çok cesurdur ve ajanlarının doğaçlamasına dayanır. Diplomasiyi tercih eder ve kan dökülmesinden kaçınmayı umar, ama hareketin savaşması gerektiğini kabul eder.", false],
		[19, "İlişkiler", "Pilota neredeyse herkesten çok güvenmeye başlar; pilot da bu güvenin karşılığını verir.", false],
		[21, "", "[[character/3]] adlı pilotu en iyi pilotu olarak görür.", false],
		[23, "", "[[character/9]] adlı yetkiliye karşı küçümsemeden başka bir şey hissetmez.", false],
		[25, "", "[[character/5]] adlı direnişçiye güvenilir bir yardımcı gibi davranır ve yokluğunda yönetimi ona bırakır.", false],
		[31, "", "[[character/4]] onun emrinde teknik uzman olarak çalışır; [[world/abel]] ise silahını yapar.", false],
	],
	"character/3": [
		[21, "", "[[character/3]], [[character/2]] adlı liderin en iyi pilotlarından biridir: liderin [[station/8]] istasyonu yakınındaki bir korsan çetesine baskın için pilotla eşleştirdiği yetenekli ve kibirli bir savaşçı.", false],
		[21, "Kişilik", "[[character/3]] sabırsız ve övüngendir. Geç kaldığı için pilotu azarlar, işi tek başına bitirebileceğini iddia eder ve pilota arkasında kalıp öğrenmesini söyler. [[character/1]], tavırlarından olmasa da şöhretinden etkilenir.", false],
		[22, "", "Yeni gelenlere hiç saygı duymaz ve pilotla balıkçı çocuğu diye alay eder.", false],
		[28, "", "Özünde paralı askerdir. Sadakati parayla ölçer ve hareketi ileri taşıyan ideallere hiç sabrı yoktur.", false],
		[21, "Hikâyedeki rolü", "[[character/2]], [[character/3]] adlı pilotu en iyi pilotlarından biri olarak tanıtır ve pilotu onunla birlikte korsanlara karşı gönderir ([[chapter/21]]). Pilot hedefte onu çoktan beklerken, gecikmeden rahatsız olmuş hâlde bulur.", false],
		[22, "", "[[character/3]] yetenekli bir pilottur ve savaştan sonra pilota hakarete sarılmış isteksiz bir iltifatta bulunur. [[character/2]] ödülü eşit bölünce öfkelenir, pilotun pek bir katkısı olmadığında ısrar eder ve liderin parayı acemilere harcadığından yakınır.", false],
		[25, "", "[[character/2]], [[station/10]] istasyonuna giderken onu eskortu için seçer. Pilot bundan memnun değildir, ama lider ona dik kafalı ama yetenekli diyerek kefil olur ([[chapter/25]]).", false],
		[26, "Pusu", "[[character/9]] adlı yetkilinin kuvvetleri [[station/10]] istasyonunda pusu kurduğunda [[character/3]] tek el ateş etmez. Silahlarının arızalandığını iddia eder, özür diler ve kaçar. [[character/5]] onun kendilerine ihanet ettiğine emindir; [[character/2]] ise bir sabotajdan şüphelense de onu savunmayı sürdürür.", false],
		[27, "İhanet", "Bir süre sonra pilotu arar, [[character/2]] ve [[character/5]] hakkında endişeyle soru sorar ve önemli haberleri olduğunu iddia eder. [[station/11]] istasyonu yakınında bir buluşma ister. [[character/1]] bunun bir tuzak olduğundan emindir ([[chapter/27]]).", false],
		[28, "", "Öyledir. [[character/3]], [[character/2]] adlı lideri yakalamıştır ve pilot teslim olmazsa onu öldürmekle tehdit eder. Gerekçelerini açıkça anlatır: [[character/2]] adlı lideri liderlik için fazla yaşlı bir hayalperest olarak görür, [[character/9]] ise hem lider hem de pilot için büyük bir ödül koymuştur. [[character/9]] adlı yetkilinin pilottan neden korktuğunu bilmediğini ve umursamadığını kabul eder. Söylediğine göre [[character/2]] az ödüyordu, o da işvereni değiştirmiştir; pilotun ideal sözlerini de bir kenara iter.", false],
		[28, "", "O konuşurken [[character/1]] tek kişilik gemisini tarar ve [[character/2]] adlı liderin nerede olması gerektiğini çözer. Ardından pilot saldırır. [[character/3]] sonuna dek hızlı ve kendinden emindir, ama gemisi yok edilir. Pilot zırhlı kargo bölmesini, içinde canlı [[character/2]] ile birlikte kurtarır; [[character/3]] ise [[station/11]] istasyonu yakınında gemisiyle birlikte batar.", false],
		[28, "", "Geriye bakınca [[station/10]] istasyonundaki silah arızası kurgulanmış görünür. Hikâyede özrünün içten olduğunu düşündüren hiçbir şey yoktur.", false],
		[29, "", "İhaneti uzun bir gölge düşürür. [[character/2]], onun ölmeden önce bilim insanı konvoyunun haberini sızdırmış olmasından korkar ([[chapter/29]]).", false],
		[47, "", "Son savaşta [[character/9]], pilotun [[character/3]] adlı hainin son sözleri olarak tanıdığı bir tehdit savurur. Pilotun onu öldürdüğünü öğrenen [[character/9]], [[character/3]] adlı hainin pilotun kardeşi olduğunu iddia eder. Yalan hemen boşa çıkar.", false],
		[21, "İlişkiler", "[[character/2]] ona tamamen güvenir ve becerisini diğer pilotlarınınkinden üstün tutar.", false],
		[22, "", "Pilota başından beri küçümsemeyle davranır.", false],
		[26, "", "[[character/5]] ona güvenmez ve onu hain diye ilk niteleyen odur.", false],
		[28, "", "Sonunda kendini, yoldaşlarının savaştığı adama, [[character/9]] adlı yetkiliye satar.", false],
	],
	"character/4": [
		[12, "", "[[character/4]], [[station/3]] istasyonunda üslenmiş bir [[faction/rebels|direniş]] üyesidir.", false],
		[13, "", "Pilotun yüz yüze tanıştığı ilk asidir. Yeni üyeleri sınar ve ilk görevlerini verir.", false],
		[13, "Pilotun sınanması", "Pilot [[station/3]] istasyonuna vardığında [[character/4]], yeni gelenin ne bildiğine ve bunu nasıl öğrendiğine dair bir dizi karmaşık soruyla söze başlar. Pilot, serbest ticareti savunan bir direnişin söylentisi dışında hiçbir şey bilmediğini itiraf eder. [[character/4]] kuşkuludur, ama hareketin telsiz trafiğini şifrelemeye ancak iki gün önce başladığını belirtir; bu da hikâyeyi inandırıcı kılar ([[chapter/12]]).", false],
		[13, "", "Zamanı ve adamı az olan [[character/4]], pilotu deneme süresiyle kabul eder. Asilerin kolonist istasyonlarına sızıp yöneticilerini kendi taraflarına çekmeyi planladığını, çünkü gezegenin sömürülmesinin durması gerektiğini açıklar. Bir yabancıya daha fazlasını söylemeyi reddeder ve pilota ilk görevini verir: sempatizanları [[station/4]] istasyonundan [[station/5]] istasyonuna götürmek ([[chapter/13]]).", false],
		[17, "Devrimi yaymak", "Daha sonra [[character/4]], pilotu öyle uzun bir mesajla [[station/3]] istasyonuna geri çağırır ki [[character/1]] yalnızca ana fikrini yüksek sesle okur ([[chapter/17]]).", false],
		[18, "", "Yüz yüze görüştüklerinde diplomasinin pek çok istasyonu asilerin tarafına geçirdiğini, bu yüzden pilotun artık daha geniş bir bölgede ticaret yapabileceğini bildirir. Basın şimdiden bir devrimden söz etmektedir ve [[character/4]] bu sözcüğe katılır. Şimdiye dek kan dökülmemiştir, ama bunun değişeceğini düşünür. Pilota hareketin liderinin yeni kazanılan istasyonlardan birinde olduğunu ve iletişime geçeceğini söyler; bazı istasyonlara ancak daha iyi zırh ya da kalkanla ulaşılabileceği konusunda da uyarır; bkz. [[guide/depth]] ([[chapter/18]]).", false],
		[31, "Konvoy baskını", "Pilot bilim insanlarına eskortluk ettikten sonra vardığında [[character/4]] da [[station/14]] istasyonundadır. Bir teşekkür konuşması hazırlamıştır, ama onu yapmaya hiç fırsat bulamaz; sonra pilot gemilere koştururken sözü bir kez daha yarıda kesilir. [[world/biotek|Biotek jeneratörünü]] taşıyan kolonist konvoyuna karşı pilot ve [[character/5]] ile birlikte savaşır ([[chapter/31]]).", false],
		[32, "", "Konvoy mürettebatı yalnızca yiyecek ve ilaç taşıdıklarını söyleyerek yalvarınca [[character/4]] telsizden asilerin tam da buna ihtiyacı olduğu karşılığını verir. [[character/5]] onun epey şakacı olabildiğini söyler.", false],
		[33, "", "Sonrasında [[character/2]] onu yapılacak çok iş olan hangarın başına getirir. Ayrıca bir gemiye [[world/eclipse|Eclipse]] takmanın teknik yönü için başvurulacak kişi olarak da onu gösterir ([[chapter/33]]).", false],
		[13, "Kişilik", "[[character/4]] temkinli, resmî ve ketumdur. Açıklamadan önce emir verir ve hareketin planlarını yalnızca bunu hak etmiş olanlarla paylaşır.", false],
		[18, "", "Aynı zamanda lafı uzatmayı sever; [[character/1]] onunla her konuştuğunda bununla alay eder.", false],
		[32, "", "Katı tavrının ardında kuru bir mizah anlayışı ve yaklaşan savaşa dair gerçekçi bir bakış yatar.", false],
		[13, "İlişkiler", "[[character/4]], pilotun hareketteki ilk irtibat kişisidir. Pilot güvenilir olduğunu kanıtladıkça güveni artar.", false],
		[19, "", "Emirlerini ilettiği [[character/2]] adlı liderin emrinde çalışır.", false],
		[32, "", "Şakaları yüzünden ona takılan [[character/5]] ile omuz omuza savaşır.", false],
	],
	"character/5": [
		[13, "", "[[character/5]], pilotun [[station/4]] istasyonundan almaya gönderildiği bir [[faction/rebels|direniş]] üyesidir.", false],
		[14, "", "Neşeli, sıcakkanlı ve güler yüzlüdür; pilotun en yakın müttefiklerinden biri olur. Pilot ondan ilk andan itibaren etkilenir ve bu, [[character/1]] adlı bilgisayarı sürekli rahatsız eder.", false],
		[14, "İlk karşılaşma", "[[character/5]], pilotu [[station/4]] istasyonunda sıcak bir şekilde karşılar ve ayrılmak için acele eder. Pilot hareketi sorunca, yeni üyelerin hem kendi hem de hareketin güvenliği için karanlıkta tutulduğunu açıklar. Varış noktasını gemi bilgisayarına gönderir ve yolculuğun hızlı olması gerektiğini vurgular ([[chapter/13]]).", false],
		[15, "", "[[station/5]] istasyonunda bazı işlerini halletmek için gizlenir. Ayrılmadan önce asilerin kolonistlerden nasıl ayrıldığını açıklar: denizi sömürüp tüketmek yerine onun sunduklarıyla geçinir, avlarını mala dönüştürür ve aşırı avlanmamaya özen gösterirler. Pilottan beş ton mal üreterek bu yaşam biçimini denemesini ister ve kalamar ile [[goods/35]] malzemesinin [[goods/22]] ürününe dönüştürülebildiği [[station/90]] istasyonunu önerir ([[chapter/14]]).", false],
		[16, "", "Mallar üretilince yeni bir görevle yeniden arar. Hareketin, koloninin zayıf noktalarını bulmak için her istasyondan taze bilgiye ihtiyacı vardır, çünkü onun deyişiyle yalnızca silahlarla kazanılamaz. Asilerin bir devrim planlayıp planlamadığı sorulunca daha fazlasını söylemez ([[chapter/15]]).", false],
		[25, "Yeniden buluşma ve pusu", "Pilot [[character/5]] ile [[station/9]] istasyonunda yeniden buluşur; ikisi beceriksizce iltifatlaşır. [[character/2]] bu buluşmayı kısa keser ve ikisini de kendisine ve [[character/3]] adlı pilota [[station/10]] istasyonuna kadar eskortluk etmekle görevlendirir ([[chapter/24]]).", false],
		[25, "", "Vardıklarında bir şeylerin ters gittiğini ilk sezen [[character/5]] olur.", false],
		[26, "", "Pusu sırasında [[character/3]] adlı pilotun savaşmadığını görür ve kaçarken arkasından seslenir. Sonrasında onu açıkça ihanetle suçlar ve pilottan destek ister. [[character/2]], kendisi yokken [[station/9]] istasyonundaki yönetimi ona bırakır ([[chapter/25]]).", false],
		[31, "Üç adımlı plan", "[[station/14]] istasyonunda [[character/5]], [[character/2]] adlı liderin kurtarılış hikâyesini zaten bilmektedir. Pilota planın ilk adımını anlatır: bir muhbire göre [[world/biotek]], sıradan yüklerin arasına gizlenmiş olarak Maarth'a taşınmaktadır. Hangi geminin onu taşıdığını kimse bilmediğinden [[station/2]] istasyonu yakınında tüm konvoya saldırılmasını emreder ([[chapter/30]]).", false],
		[32, "", "Konvoyun yolunu kesme operasyonunu yönetir ve her konteynerin kurtarılmasını sağlar ([[chapter/31]]).", false],
		[33, "", "Ardından [[character/2]] ona ani saldırılara karşı [[station/14]] istasyonunun dışında devriye gezme görevini verir.", false],
		[42, "", "Pilot [[goods/36]] ile döndüğünde [[character/5]] çok sevinir. [[world/abel]] adlı bilim insanının her şeyi hazırladığını bildirir, [[character/2]] adlı liderin topu korsanlara karşı deneme emrini iletir ve pilota jeneratörün yalnızca bir prototip olduğunu hatırlatır ([[chapter/41]]).", false],
		[45, "Taarruzlar", "Son taarruzlarda pilot [[station/18]] üzerine saldırırken [[character/5]], [[station/109]] saldırısını yönetir. [[character/2]], onun ne yaptığını bilen yetenekli bir pilot olduğunu söyleyerek pilotu rahatlatır ([[chapter/44]]).", false],
		[47, "", "Saldırısı başarılı olur. Haberi ve [[character/2]] adlı liderin [[station/0]] istasyonundaki son bir savaş için verdiği emirleri iletmek üzere pilotu arar, ardından kendisi de yola çıkar ve yolda korsanlarla savaşarak ilerler ([[chapter/46]]).", false],
		[48, "", "[[station/0]] istasyonunda [[character/2]] ve pilotun yanında savaşır. Zaferden sonra pilotu [[goods/21]] eşliğinde kutlamaya davet eder ve pilot kabul eder ([[chapter/47]]).", false],
		[14, "Kişilik", "[[character/5]] dost canlısı ve iyimserdir; her fırsatta kullandığı kısa bir onay sözünü çok sever. Aynı zamanda ketum ve kendini davaya adamıştır; hareketin neyi savunduğunu açıkça görür.", false],
		[15, "", "Denize zarar vermeden ondan geçinmeye inanır ve bu fikri basitçe anlatmayı bilir.", false],
		[26, "", "İnsanlar hakkında çabucak hüküm verir ve [[character/3]] söz konusu olduğunda haklı çıkar.", false],
		[14, "İlişkiler", "Pilot ondan başından beri hoşlanır ve sefer boyunca bu duygu açıkça karşılıklı hâle gelir. [[character/1]] bu konuda söylenmeyi hiç bırakmaz.", false],
		[25, "", "[[character/2]] ona komuta emanet eder ve hem ona hem de pilota sevecen bir eğlenceyle yaklaşır.", false],
		[26, "", "[[character/3]] adlı pilota hiç güvenmez.", false],
		[32, "", "[[character/4]] ile yakın çalışır ve onun mizahından keyif alır.", false],
	],
	"character/6": [
		[8, "", "[[character/6]], [[faction/colonists]] tarafındaki pek çok küçük konuşmacı için kullanılan addır: koloni [[world/colony|yönetiminin]] yetkilileri, idarecileri ve nakliye mürettebatı. Hiçbirinin adı yoktur; birlikte, koloninin kendisi için çalışan yabancılara nasıl davrandığını gösterirler.", false],
		[9, "Kimler konuşur", "İlki, [[species/0|nautilus]] itlafından sonra pilotu karşılayan [[station/1]] istasyonundaki yetkilidir ([[chapter/8]]). Yetkili kirli işler için kibar sözcükleri tercih eder, küçük bir sabit ücret öder ve pazarlık etmeyi reddeder. Daha iyi bir iş önerilmeden önce pilot üç sözleşme tamamlamalıdır.", false],
		[10, "", "Aynı ses ardından [[station/2]] istasyonundaki kapsül savunmasını verir. Koloni ihraç mallarını kapsüllerle yörüngeye fırlatır ve [[world/aquarians|Aquarianlar]] bunlara durmadan saldırır; bu da ticaret yönetimini kaygılandırır ([[chapter/9]]).", false],
		[32, "", "Çok sonra, [[station/2]] istasyonu yakınındaki bir kolonist konvoyunun mürettebatı, yalnızca yiyecek ve ilaç taşıdıklarını söyleyerek asilere ateş etmemeleri için yalvarır ([[chapter/31]]).", false],
	],
	"character/7": [
		[12, "", "[[character/7]], pilotla konuşan adsız [[faction/rebels]] üyeleri için kullanılan addır: istasyon trafik kontrolörleri, muhafızlar ve konvoy mürettebatı. Sesleri, pilotun hareketle ve onun gündelik yaşamıyla ilk temasını gösterir.", false],
		[12, "Kimler konuşur", "Pilotun duyduğu ilk asi, [[station/3]] istasyonundaki bir muhafızdır; geminin tarafsız sulara girdiğini bildirir ve kimliğini açıklamazsa ateş açmakla tehdit eder. Uzun bir sessizliğin ardından pilotun yanaşmasına izin verilir ([[chapter/12]]).", false],
		[17, "", "Pilot kabul edilmiş bir üye olarak döndüğünde istasyon pilotu adıyla karşılar ve bir yanaşma yeri ayırır ([[chapter/17]]).", false],
		[29, "", "Daha sonra [[station/13]] istasyonu yakınındaki bilim insanı konvoyunun mürettebatı çaresizce yardım ister ([[chapter/29]]).", false],
		[30, "", "Ardından pilota teşekkür eder ve yalnız başlarına hayatta kalamayacaklarını söylerler.", false],
	],
	"character/8": [
		[34, "", "[[character/8]], pilotun bir [[world/eclipse|Eclipse]] edinmenin yolunu ararken [[station/15]] istasyonunda tanıştığı bir tüccardır.", false],
		[35, "", "Kendinden hep üçüncü şahıs olarak söz eden ve parası olan bir müşteriye neredeyse her şeyi temin edebileceğini iddia eden bir karaborsacıdır.", false],
		[35, "Geçmiş", "[[character/8]], uyuşturucu ticaretinin yasak olduğu [[station/15]] istasyonunda iş yapar. Faaliyetleri onu hedef hâline getirmiştir: istasyonun güvenlik yönetimi, ondan kurtulmak için ödül avcısı [[character/11]] adlı adamı tutmuştur. Pek çok yerde bağlantıları vardır ve müşterinin istediğini elde etmek için rüşvet vermeye hazırdır.", false],
		[35, "Top pazarlığı", "Pilot yerel pazara göz atıp görünüşte [[goods/37]] satın alırken [[character/8]] pilotu bir kenara çeker ve burada bu tür ticaretin yasa dışı olduğu konusunda uyarır. Hizmetlerini sunup pilot bir [[equipment/42]] isteyince şaşırır ve pilotun bir savaş başlatmak isteyip istemediğini sorar. Pilot bunun kişisel kullanım için olduğunu söyler. [[character/8]] bir tane aramayı tek bir koşulla kabul eder: pilot, istasyon yakınında devriye gezen [[character/11]] adlı avcıyı bulup öldürmelidir ([[chapter/34]]).", false],
		[37, "", "[[character/11]] adlı avcının ölümünden sonra [[character/8]] pilotu tebrik eder ve sözünü tutar. Bağlantıları ve bolca rüşvet sayesinde bir [[equipment/42]] bulmuştur; onu, yine de kelepir dediği yüksek bir fiyata sunar. Satıcının Dawn adında bir adam olduğunu açıklar; mal sağlam olduğu sürece isimler umurunda değildir ([[chapter/36]]).", false],
		[37, "", "Satıcı [[character/9]] adlı yetkilidir. [[character/1]] ironiye dikkat çeker: [[character/9]] adlı yetkilinin açgözlülüğü, asilerin en önemli silahını düşmanlarının eline vermiştir. Pilot topu satın alır ve onunla [[station/14]] istasyonuna döner ([[chapter/37]]).", false],
		[35, "Kişilik", "[[character/8]] kurnaz, dikkatli ve vicdansızdır. Yasa dışı mallarla iş yapar ve bir adamın ölümünü bir ödeme ister gibi rahatça ister. Dinlenmekten çekinir; herhangi bir işi konuşmadan önce pilotu bir kenara çeker ve susturur. Parasını ödeyen bir müşteriyle bile riski tartar: başta böyle bir silahı bir yabancıya satması gerekip gerekmediğinden emin değildir.", false],
		[37, "", "Yine de kendine göre güvenilirdir: bedeli ödenince pazarlığına sadık kalır ve pilota tam olarak istenen şeyi bulur. Kendinden adıyla söz etme alışkanlığı ve doğru yerlerde doğru insanları tanımaktan duyduğu gurur, onu seferin en renkli figürlerinden biri yapar.", false],
		[35, "İlişkiler", "[[character/11]] onun avcısı ve pilot aracılığıyla da kurbanıdır.", false],
		[37, "", "Hangi tarafta olduklarını hiç umursamadan hem [[character/9]] hem de pilotla iş yapar.", false],
	],
	"character/9": [
		[2, "", "Soyadı Dawn olan [[character/9]], pilotun günün avını sattığı [[station/0]] istasyonunda bir kolonist yetkilidir.", false],
		[3, "", "Kibirli ve hırslıdır; koloni için çalışan insanlara açık bir küçümsemeyle davranır. Pilotun ilk işvereni ve kalıcı rakibidir.", false],
		[12, "Geçmiş", "[[character/9]], kendini istasyonlardaki görevinden çok daha büyük işler için yaratılmış sayar.", false],
		[23, "", "[[character/2]] onu önemsiz biri olduğu zamanlardan tanır. Lidere göre liyakatle değil iyi bağlantılarla yükselmiştir ve isyan başladığında [[faction/colonists|koloni]] kuvvetlerinde gerçek bir güce sahiptir.", false],
		[3, "İlk karşılaşmalar", "[[character/9]], pilotun ilk avını sabit fiyata satın alır ve küçük kargo ambarıyla alay eder. Pilotun [[faction/pirates|korsan]] avlasa daha iyi edeceğini ekler, ama bunu da beceremeyeceğinden şüphelenir ([[chapter/2]]).", false],
		[7, "", "Pilot silahlı döndüğünde övgüyü kendine mal eder ve bir iş teklif eder: [[station/1]] istasyonu çevresindeki rotaları [[species/0|nautiluslardan]] temizlemek. Pilotun itirazlarını bir kenara iter ve canlıların nasıl ortadan kaldırılacağını umursamaz ([[chapter/6]]).", false],
		[10, "", "[[station/2]] istasyonundaki kapsül fırlatmasını yönetir ve pilotu, beşten fazla kapsül kaybederse işinden olacağı konusunda uyarır ([[chapter/10]]).", false],
		[12, "", "Sonrasında hasarlı kapsüller için pilotu suçlar ve ödülü vermez. Bu küçümseme, pilotu direnişe iten bardağı taşıran son damladır ([[chapter/11]]).", false],
		[23, "İsyana karşı", "[[character/9]], asiler büyüdükçe onlara karşı cephe alır. [[station/9]] ile [[station/37]] arasındaki ikmal yolu boyunca bir mayın tarlası döşetir ([[chapter/22]]).", false],
		[25, "", "[[character/2]], [[station/10]] istasyonuna görüşmeler için vardığında kuvvetleriyle beklemektedir ve hemen saldırı emri verir ([[chapter/25]]).", false],
		[28, "", "[[character/3]] adlı hainin ihanetinin ardındaki finansör odur. Pilotu bir tehdit olarak gördüğü anlaşılan yetkili, [[character/2]] ve pilot için büyük bir ödül koymuştur ([[chapter/27]]).", false],
		[37, "", "Açgözlülüğü sonunu getirir. Bir [[world/eclipse|Eclipse]] topunu karaborsacı [[character/8]] adlı satıcıya satar; satıcı da onu pilota satar ([[chapter/36]]).", false],
		[43, "Yenilgi", "[[character/9]], [[station/14]] istasyonuna yapılan ani kolonist saldırısını yönetir. Pilotla asilerin balıkçısı diye alay eder ve pilotun bir [[equipment/42]] taşıdığını öğrenince donup kalır ([[chapter/43]]).", false],
		[44, "", "[[world/aquarians|Aquarianlar]] gemilerine karşı savaşa katılınca saldırıyı bırakır ve kaçar.", false],
		[47, "", "[[character/9]], son direnişini koloninin son kalesi olan [[station/0]] istasyonunda gösterir. Pilotun [[character/3]] adlı haini öldürdüğünü duyunca [[character/3]] adlı hainin pilotun kardeşi, kendisinin de pilotun babası olduğunu iddia eder. Pilot yalanı hemen görür ve [[character/9]] bunun neredeyse işe yaradığını kabul eder ([[chapter/47]]).", false],
		[48, "", "Ardından gelen savaşta [[character/9]] geride kalan son kolonisttir. Bir kurtarma kapsülüyle kaçar, görünüşe göre bütün istasyonu da beraberinde götürür ve balıklarla ve kalanlarla son bir kez alay ederek okyanusu ardında bırakır.", false],
		[3, "Kişilik", "[[character/9]] kaba, kendini beğenmiş ve kendinden aşağıda gördüğü herkesi küçümseyen biridir.", false],
		[12, "", "Suçu başkalarına yükler, işler iyi gidince de övgüyü üstlenir.", false],
		[37, "", "Açgözlülüğü kendi tarafına olan sadakatinden ağır basar.", false],
		[47, "", "Cesaret yerine yalan ve rüşvete başvuran bir manipülatördür ve savaş aleyhine döndüğü her seferde kaçar.", false],
		[3, "İlişkiler", "Pilotu küçümsemesi ilk karşılaşmalarında başlar ve sefer boyunca açık bir düşmanlığa dönüşür.", false],
		[23, "", "[[character/2]] onu uzun zamandır hor görür.", false],
		[28, "", "[[character/3]] adlı pilotun sadakatini bir ödülle satın alır.", false],
		[37, "", "Malların nereye gideceğini bilmeden [[character/8]] ile iş yapar.", false],
	],
	"chart": [
		[1, "", "Harita, iki yüz istasyonun hepsini okyanus haritasındaki konumlarında noktalar olarak gösterir. Ulaştığınız bölüme göre mavi noktalar [[faction/colonists]], turuncu noktalar ise [[faction/rebels]] tarafının elindedir. Her istasyon mavi başlar; istasyonlar hikâye ilerledikçe turuncuya döner ve asla geri dönmez.", false],
		[1, "", "Bir istasyon ya da bölüm sayfasında ilgili istasyon daha büyük ve etiketli çizilir; o bölümde asilere katılan istasyonların çevresi çizilir. Haritanın altında her istasyon, sayfasına bağlantıyla listelenir. İstasyonlar arasındaki mesafeler harita birimleriyle ölçülür; bkz. [[guide/navigation]].", false],
	],
	"contract/0": [
		[1, "", "İstasyondan 400 ile 1.200 m uzakta bekleyen tek bir aranan gemiyi bulun ve yok edin. Hedef sıradan bir korsandan çok daha dayanıklıdır ve gücü pilotun rütbesiyle artar. Uzun menzilli silahlar ve bir torpido, hedef yaklaşmadan onu yıpratmaya yardım eder. Ödül bir istasyona dönüşte ödenir.", false],
	],
	"contract/1": [
		[1, "", "Üç ile altı gemiden oluşan bir çete dolambaçlı bir rota boyunca bekler. Hedef, son yol noktasındaki en sondaki gemidir. Doğrudan yok edilemez: onu etkisiz bırakın, sonra kaçmadan önce zıpkınla çekin. Çekme işinin kesilmemesi için önce eskortu temizleyin.", false],
	],
	"contract/10": [
		[1, "", "İki ile altı yüz metre açıkta, tek bir geminin koruduğu 15 ile 25 mayınlık bir alandaki her mayını yok edin. Mayınlar yalnızca yakın mesafeden vurulabilir; bu yüzden her birine dikkatle yaklaşın. Güçlü kalkanlar ve zırh patlamaları emmeye yardım eder.", false],
	],
	"contract/11": [
		[1, "", "İkmal kapsülleri saldırı altındadır. Sözleşmenin asgarisini karşılayacak kadar kapsül hayatta kalırken saldırganları yok edin. Kapsül sayısını izleyin ve önce kapsüllere yaklaşan saldırganlarla çatışın. Bu işler temel bir sözleşmeden yaklaşık %30 fazla öder.", false],
		[10, "", "Saldırganlar, kolonistlerin nakliye kapsüllerini hedef alan yarı insan deniz sakinleri Aquarianlardır.", false],
	],
	"contract/12": [
		[1, "", "Müttefik kuvvetler yanınızda savaşırken silahlı gemilerin koruduğu belirli sayıda ikmal kapsülünü yok edin. Uygulamada hiçbir istasyon bu işi panosunda vermez, bu yüzden alınamaz. Ansiklopedide yalnızca diğer sözleşme türleriyle birlikte tanımlandığı için yer alır.", false],
	],
	"contract/13": [
		[1, "", "Belirli miktarda bir ürün üretin ve işi veren istasyona teslim edin. Ücret, ürünün değerine ve istenen miktara bağlıdır. Ödül çoğu zaman çok cömerttir ve olağan depozitonun yalnızca yarısı gerekir. Kabul etmeden önce tarifi kontrol edin ve malzemeleri toplayın. Bu işler yalnızca haritadaki ilk yirmi istasyonun ötesindeki istasyonlarda çıkar.", false],
		[12, "", "Bu işi yalnızca asi istasyonları verir.", false],
	],
	"contract/14": [
		[1, "", "Belirtilen bir canlı ya da algden tam bir miktarı işi veren istasyona teslim edin. Miktar 3 ile 24 birim arasındadır ve depozito olağanın yarısıdır. Yaygın türler nadir olanlardan daha sık istenir. Bir av radarı ve büyük bir ambar bu işleri kolaylaştırır. Yalnızca ilk yirmi istasyonun ötesindeki istasyonlarda çıkarlar.", false],
		[12, "", "Bu işi yalnızca asi istasyonları verir.", false],
	],
	"contract/2": [
		[1, "", "Bir adam kaçıranın gemisi bir rehine tutmaktadır. Bir kurtarma işinde olduğu gibi hedef, dolambaçlı bir rota boyunca bir çeteyle seyreder; etkisiz bırakılmalı, sonra zıpkınla çekilmelidir. Hedef kaçarsa iş başarısız olur. İyi menzilli bir zıpkın takın ve adam kaçırana yönelmeden önce eskortları öldürün.", false],
	],
	"contract/3": [
		[1, "", "Dolambaçlı bir rotanın yol noktalarına dağılmış üç ile altı gemilik bir çetedeki her korsanı avlayın. Hiçbiri kalmayınca iş tamamlanır. Silahlı bir gemi için basit bir sözleşmedir ve çetenin büyüklüğü işin zorluğuyla artar.", false],
	],
	"contract/4": [
		[1, "", "Beş yük gemisi belirli bir rotada seyreder ve yol boyunca akıncılar pusuda bekler. Tüm saldırganlar yok edildiğinde iş başarılı olur. Her yük gemisi kaybedilirse başarısız olur. Eskortluk, düz bir korsan avından yaklaşık %30 fazla öder. Konvoya yakın durun ve akıncılarla konvoya ulaşmadan çatışın.", false],
	],
	"contract/5": [
		[1, "", "Bir yol noktasında iki ya da üç yük gemisinden oluşan bir konvoya saldırın ve silahlı muhafızlarına rağmen onları yok edin. Yalnızca yük gemilerinin yok edilmesi gerekir; bu yüzden ateşi onlara yoğunlaştırmak işi erken bitirebilir. Bir torpido ya da uzun menzilli bir silah, muhafızlar yaklaşırken onları tek tek vurmaya yardım eder.", false],
	],
	"contract/6": [
		[1, "", "15 ile 24 canlıdan oluşan bir sürü belirli bir rotada yüzer ve avcılar yol boyunca ona saldırır. Kayıplar kararlaştırılan sınırı aşmadan avcıları yok edin. Sürünün yakınında asla ateş etmeyin: başıboş bir atış kayıp sayılır. Bu işler temel bir sözleşmeden yaklaşık %30 fazla öder.", false],
		[12, "", "Bu işi yalnızca asi istasyonları verir ve hikâye tamamlanınca vermeyi bırakırlar.", false],
	],
	"contract/7": [
		[1, "", "Düşman gemileri araya girmeye çalışırken yerel yaban hayatı arasından tek bir türden belirli sayıda canlı öldürün. Zıpkınla yakalanan avlar sayılmaz; canlılar öldürülmelidir. Bir av radarı doğru türü hızla bulmaya yardım eder. Bu işler temel bir sözleşmeden yaklaşık %20 fazla öder.", false],
	],
	"contract/8": [
		[1, "", "Bir yolcuyu başka bir istasyona taşıyın. Bazı yolcular en fazla S.T.R.E.A.M. atlama sayısı belirler; izin verilen sayı azaldıkça ücret artar. Bu sınır aşılırsa sözleşmenin süresi dolar. Burada iyi bir motor yardımcı olur, çünkü daha uzun menzil daha az atlama demektir.", false],
	],
	"contract/9": [
		[1, "", "İstasyondan iki ile altı yüz metre uzaktaki 15 ile 30 parçalık bir enkaz alanını yaklaşık iki buçuk dakika içinde temizleyin. Hafif düşman gemileri bulunabilir. Ücret diğer sözleşmelerden yaklaşık %30 düşüktür, ama iş çabuk biter. Bir turbo ve hızlı ateş eden silahlar değerli saniyeler kazandırır.", false],
	],
	"equipment/0": [
		[1, "", "Giriş seviyesi silah: 228 m menzille her 0,56 sn'de atış başına 3 hasar. Bu çok az bir vuruş gücüdür, ama yaklaşık 5.700 cr ile en ucuz silahtır ve dükkânlarda en sık görülenlerden biridir. Birden fazla takılabilir ve tüm silahlar birlikte ateş eder; bu yüzden ikisi ya da üçü, daha ağır bir silah alınabilene dek kullanılabilir bir erken batarya oluşturur.", false],
		[3, "", "[[chapter/3]] içinde pilot, [[station/0]] istasyonundan ayrılmadan önce bir tane takmalıdır.", false],
	],
	"equipment/1": [
		[1, "", "Orta raylı top, [[equipment/0]] silahının hasarını atış başına 6'ya iki katına çıkarır ve biraz daha hızlı, her 0,48 sn'de, 260 m'ye kadar ateş eder. Yaklaşık iki katı fiyata sürekli hasarı iki katından fazla artırır. Füzyon topları raflarda görünmeden önceki erken bölümlerde mantıklı bir ikinci silahtır.", false],
	],
	"equipment/10": [
		[1, "", "Bu kütle sürücüsü 280 m menzille her 0,40 sn'de 20 vurur ve açık satıştaki tüm silahların en yüksek sürekli hasarını verir. Menzilde tüm füzyon toplarını da geçer. 42.000 ile 51.000 cr ödemeyi bekleyin. Boş yuvaları olan bir savaş gövdesi için en iyi silah seçeneklerinden biridir.", false],
	],
	"equipment/11": [
		[1, "", "En ağır kütle sürücüsü, tüm seri atışlı silahların en uzun menzili olan 375 m'de atış başına 25 hasar verir. 0,51 sn aralıkla sürekli hasarı kabaca [[equipment/10]] düzeyindedir. Kattığı şey menzildir. 54.000 ile 60.000 cr ile dükkânlardaki en nadir ve en pahalı silahtır.", false],
	],
	"equipment/12": [
		[1, "", "Temel güdümlü torpido 20 hasar verir ve 215 m'ye kadar kendini hedefe yönlendirir. Ancak her 4,3 sn'de bir yeniden dolar. Herhangi bir türden yalnızca bir torpido rampası takılabilir. Nişangâhta tutulması zor çevik hedeflere karşı yararlıdır, ama menzili kısadır.", false],
	],
	"equipment/13": [
		[1, "", "Orta torpido 30 vurur, 4,0 sn'de dolar ve 360 m'ye ulaşır; her açıdan [[equipment/12]] torpidosundan iyidir. Yalnızca bir torpido rampası takılabildiğinden ucuz modeli tamamlamaz, onun yerini alır. 37.000 ile 39.000 cr arasında iyi bir çok amaçlı bitirici silahtır.", false],
	],
	"equipment/14": [
		[1, "", "En iyi torpido, satıştaki tüm silahların en ağır tekil vuruşu olan 50 hasarlık bir savaş başlığını 816 m'ye kadar taşır. Yeniden dolması için 6,8 sn gerekir. Geminin tek torpido yuvası olarak hızlı silahlarla iyi eşleşir: çatışmanın başında uzun menzilli bir vuruş, ardından silahlar işi bitirir. Nadirdir ve 62.500 cr ya da daha fazlasına mal olur.", false],
	],
	"equipment/15": [
		[1, "", "Başlangıç zıpkını 240 m'ye ulaşır ve üçü arasında en geniş olan 24 m'lik yakalama toleransıyla kötü nişanı affeder. Kancadaki avı yavaşlatmak için hiçbir şey yapmaz; bu yüzden hızlı canlılar sert çeker ve geç yorulur. Algler ve yavaş hayvanlar için yeterlidir ve değiştirmesi ucuzdur.", false],
	],
	"equipment/16": [
		[1, "", "Bu zıpkın 400 m'ye ulaşır ve kancadaki canlıyı %40 yavaşlatır; bu da [[species/7]] gibi hızlı avları görüşte tutmayı çok kolaylaştırır. Yakalama toleransı 18 m'ye daralır, bu yüzden nişan daha önemlidir. Düzenli avlanan bir pilot için daha büyük bir ambardan sonraki en önemli yükseltmedir.", false],
	],
	"equipment/17": [
		[1, "", "En iyi zıpkın 560 m'ye ulaşır ve kancadaki avı %70 yavaşlatır; bu yüzden hızlı canlılar bile az kovalamayla etkisiz kalır. 14 m'lik yakalama toleransı en dar olanıdır, bu yüzden dikkatli nişanı ödüllendirir. 69.000 ile 83.000 cr ile nadir ve pahalıdır; yalnızca bir zıpkın takılabilir.", false],
	],
	"equipment/18": [
		[1, "", "Temel kalkan, zırha dokunulmadan önce 100 puan hasar emer. Ayrıca geminin sığ sınırını 20.000 m'ye ayarlar. Sahada asla dolmaz; yalnızca gemi bir istasyondan ayrıldığında yenilenir. Erken çatışmalar için yeterlidir, ama çoğu pilot onu ilk fırsatta değiştirir.", false],
	],
	"equipment/19": [
		[1, "", "Bu kalkan, [[equipment/18]] kalkanından dörtte üç fazla, 175 puan emer ve geminin 18.400 m'ye çıkmasını sağlar. Temel model gibi sahada dolmaz. 15.750 ile 18.000 cr ile değerli en ucuz kalkan yükseltmesidir ve daha sığdaki birkaç istasyonu erişilebilir kılar.", false],
	],
	"equipment/2": [
		[1, "", "En ağır raylı top, 322 m menzilde atış başına 9 vurur, ama [[equipment/1]] silahından biraz daha yavaş, 0,62 sn'de bir döngü yapar. Bu yüzden sürekli hasarı yalnızca mütevazı bir artıştır. 16.000 ile 20.000 cr arasında menzil açısından iyi bir değerdir, ama [[equipment/6]] biraz daha fazla paraya belirgin biçimde daha fazla hasar verir.", false],
	],
	"equipment/20": [
		[1, "", "Bu kalkan 220 puan emer ve sahada dolan ilk kalkandır: gemi derinlik aralığında kaldıkça her 1,15 sn'de bir puan geri kazanır. Sığ sınırı 16.800 m'ye yükseltir. 56.000 cr'nin üzerindeki fiyatıyla [[equipment/19]] kalkanından çok daha pahalıdır, ama dolma özelliği uzun çatışmaları çok daha güvenli kılar.", false],
	],
	"equipment/21": [
		[1, "", "En iyi kalkan 310 puan emer ve her 0,65 sn'de bir puan geri kazanır; bu, [[equipment/20]] kalkanının neredeyse iki katı hızdır. 15.000 m olan sığ sınırı diğer tüm kalkanlardan yükseğe ulaşır ve en sığ istasyonları erişilebilir kılar. Nadirdir ve 93.750 cr ya da daha fazlasına mal olur; seferin sonlarına yönelik bir yatırımdır.", false],
	],
	"equipment/22": [
		[1, "", "Temel zırh, kalkan tükendikten sonra ve gövde vurulmadan önce devreye giren 100 puan koruma ekler. Ayrıca derin sınırı 25.000 m'ye ayarlar. Zırh sahada yenilenmez. Bu plaka ucuzdur ve başlarda yeterlidir, ama pek çok derin istasyon erişiminin ötesindedir.", false],
	],
	"equipment/23": [
		[1, "", "Bu zırh 155 puan ekler ve derin sınırı 26.800 m'ye indirir. Kalkan dengi olan [[equipment/19]] ile hemen hemen aynı fiyattadır; ikisi birlikte geminin derinlik aralığını iki yönde de genişletir. Daha derin istasyonlara ulaşmak isteyen bir pilot için iyi bir erken yükseltmedir.", false],
	],
	"equipment/24": [
		[1, "", "Bu zırh 195 puan ekler ve 28.400 m'ye kadar dalışa izin verir. 56.000 ile 72.000 cr ile [[equipment/23]] zırhından epey pahalıdır, korumadaki kazanç ise daha küçüktür. Pek çok derin istasyonu erişilebilir kıldığından, fazladan derinlik onu almak için çoğu zaman daha güçlü bir nedendir.", false],
	],
	"equipment/25": [
		[1, "", "En iyi zırh 270 puan ekler ve mevcut en derin sınır olan 30.000 m'ye kadar dalışa izin verir. Nadirdir ve 93.750 cr ya da daha fazlasına mal olur. [[equipment/21]] ile birleştiğinde gemi, istasyon derinliklerinin neredeyse tamamında çalışabilir.", false],
	],
	"equipment/26": [
		[1, "", "En küçük kargo modülü, gövdenin temel kapasitesine %30 ekler. Birden fazla modül takılabilir ve katkıları toplanır. Katkı temel kapasitenin bir payı olduğundan [[ship/0]] gemisinde 7 t, [[ship/6]] gemisinde ise 54 t verir. Büyük bir gövdede ambar alanı kazanmanın en ucuz yoludur.", false],
	],
	"equipment/27": [
		[1, "", "Bu modül gövdenin temel kapasitesine %50 ekler ve diğerleriyle birlikte takılabilir. Kredi başına [[equipment/26]] modülünden biraz daha az verimlidir, ama yuva tasarrufu sağlar; bu da az boş yuvası olan gövdelerde daha önemlidir. [[ship/4]] gemisinde tek bir modül 35 t ekler; bu, bir ticaret seferinde yuvayı haklı çıkarmaya yeter.", false],
	],
	"equipment/28": [
		[1, "", "En büyük modül temel kapasiteye %80 ekler; bu, kargo modülleri arasında yuva başına en yüksek katkıdır. [[ship/6]] gemisinde 144 t ekler. Birden fazla takılabilir. Nadirdir ve 45.000 cr ya da daha fazlasına mal olur; bu yüzden esasen ticarete ayrılmış büyük ambarlı bir gövde için almaya değer.", false],
	],
	"equipment/29": [
		[1, "", "Temel motor, geminin haritadaki S.T.R.E.A.M. menzilini %30 uzatır; böylece tek atlamada daha çok istasyona ulaşılabilir. Yalnızca bir motor takılabilir. Ucuzdur ve baştan beri yararlıdır, çünkü daha az atlama daha hızlı ticaret seferleri ve yolcu yolculukları demektir.", false],
	],
	"equipment/3": [
		[1, "", "İlk bobinli top, menzil için yapılmış bir ışın silahıdır. Raylı topların neredeyse dört katı uzağa, 875 m'ye ulaşır ve 15 vurur, ama atışlar arasında 2,5 sn gerekir. Sürekli hasarı [[equipment/0]] silahınınkiyle hemen hemen aynıdır. Yaklaşan gemilere onlar karşılık veremeden ateş açmak için takmaya değer.", false],
	],
	"equipment/30": [
		[1, "", "Bu motor S.T.R.E.A.M. menzilini %60 uzatır; bu, [[equipment/29]] motorunun iki katı katkıdır ve fiyatı kabaca üç katıdır. Bir kargonun kat ettiği mesafeyle fiyatlar arttığından, malları düzenli olarak uzak pazarlar arasında taşıyan bir tüccara uyar. Seferin ortalarındaki dükkânlarda bulunacak kadar da yaygındır.", false],
	],
	"equipment/31": [
		[1, "", "En iyi motor S.T.R.E.A.M. menzilini %130 uzatır ve temel menzili iki katından fazlasına çıkarır. Nadirdir ve 90.000 cr ya da daha fazlasına mal olur. Uzun ticaret rotaları ya da uzak sözleşme hedefleri her kazanılan atlamayı değerli kıldığında takmaya değer.", false],
	],
	"equipment/32": [
		[1, "", "Bu itici, gövdenin manevra değerine 0,15 ekler. Kazanç sabittir; bu yüzden en çok yavaş gövdelerde önemlidir: [[ship/6]] gemisinde manevrayı 0,67'den 0,82'ye çıkarır. Yalnızca bir manevra modülü takılabilir. Hantal bir yük gemisi için ucuz bir çözümdür.", false],
	],
	"equipment/33": [
		[1, "", "Bu itici manevra değerine 0,26 ekler; bu, kabaca üç katı fiyata [[equipment/32]] iticisinin neredeyse iki katı kazançtır. Orta ağırlıkta bir gövdeyle sık savaşan ve korsan saldırılarının içine dönebilmesi gereken bir pilota uyar. [[ship/4]] gemisinde manevrayı 0,91'den 1,17'ye çıkarır; bu, [[ship/7]] gemisinin değerine yakındır.", false],
	],
	"equipment/34": [
		[1, "", "En iyi itici manevra değerine 0,56 ekler. Bu, [[ship/6]] gemisini [[ship/0]] gemisinden daha iyi döndürmeye ya da [[ship/5]] gemisine eşsiz bir çeviklik vermeye yeter. Nadirdir ve 87.000 cr ya da daha fazlasına mal olur; adanmış savaşçılar için bir lükstür. Zaten iyi kullanılan bir gövdede ucuz iticiler parayı daha iyi değerlendirebilir.", false],
	],
	"equipment/35": [
		[1, "", "Temel radar, gemileri ve diğer temasları radar ekranında gösterir ve görüş alanının kenarında işaretler; böylece pilot hedefleri bulabilir. Hiç radar olmadan ekran yalnızca seyrüsefer bilgisi gösterir. Düşman gemilerinin adını vermez ve canlıları göstermez, ama ucuz ve vazgeçilmezdir.", false],
	],
	"equipment/36": [
		[1, "", "Bu savaş radarı tanımlama ekler: nişangâhtaki düşman gemisi, gövde tipi ve taşıdığı kargoyla etiketlenir. Canlıları göstermez; bu yüzden bir savaşçı aracıdır. 18.500 ile 23.000 cr ile [[equipment/37]] ile hemen hemen aynı fiyattadır; seçim pilotun çoğunlukla savaşmasına ya da avlanmasına bağlıdır.", false],
	],
	"equipment/37": [
		[1, "", "Bu av radarı, canlıları radar ekranında gemilerle birlikte gösterir; bu da değerli avları bulmayı çok kolaylaştırır. Düşman gemilerini [[equipment/36]] radarının yaptığı gibi etiketlemez. Avcılığa odaklanan bir pilot için [[equipment/38]] dışındaki en yararlı radardır.", false],
	],
	"equipment/38": [
		[1, "", "En iyi radar iki uzmanlığı birleştirir: düşman gemilerini etiketler ve canlıları radar ekranında gösterir. Uzmanlaşmış radarların her birinin kabaca iki katı fiyattadır ve dükkânlarda nadirdir. Yalnızca bir radar takılabildiğinden, avcılık ile savaş arasında seçim yapma zorunluluğunu ortadan kaldırır.", false],
	],
	"equipment/39": [
		[1, "", "Temel turbo, geminin hızını 3 sn boyunca iki katına çıkarır, sonra dolması için 20 sn gerekir. Yalnızca bir turbo takılabilir. Bir hedefe yaklaşmak, tehlikeden kaçmak ya da S.T.R.E.A.M. kapısına daha hızlı ulaşmak için yararlıdır; yaygın ve ucuzdur.", false],
	],
	"equipment/4": [
		[1, "", "Bu bobinli top atış başına hasarı 22'ye çıkarır, ama aralığı 3,4 sn'ye uzatır; bu yüzden sürekli çıktısı [[equipment/3]] silahına göre pek gelişmez. Menzil 884 m ile neredeyse değişmez. Ucuz model satışta değilken makul bir seçimdir, ama fiyat farkının düşündürdüğü kadar büyük bir yükseltme değildir.", false],
	],
	"equipment/40": [
		[1, "", "Bu turbo hızı yaklaşık 4 sn boyunca 2,5 katına çıkarır ve yaklaşık 16 sn'de dolar. Her değeri [[equipment/39]] turbosundan iyidir; fiyatı kabaca iki katıdır. Savaş pilotları için iyi bir sefer ortası seçimidir ve uzun yolculuklarda S.T.R.E.A.M. kapısına giden yolu da kısaltır.", false],
	],
	"equipment/41": [
		[1, "", "En iyi turbo hızı yaklaşık 5 sn boyunca üç katına çıkarır ve 14,5 sn'de dolar; bu yüzden diğer tüm turbolardan daha sık hazır olur ve daha uzun sürer. Nadirdir, ama yaklaşık 42.000 cr ile çoğu üst düzey donanımdan ucuzdur.", false],
	],
	"equipment/42": [
		[1, "", "Sıradan raflarda asla görünmeyen ve liste fiyatı olmayan ağır bir istasyon topu. 240 m menzille her 0,93 sn'de atış başına 40 hasar verir; bu da ona en iyi kütle sürücülerine yakın bir sürekli hasar kazandırırken her vuruşu orta sınıf bir torpido kadar sert yapar.", false],
		[33, "", "Sefer, [[chapter/33]] sonrasında bu toplardan birinin aranması etrafında döner.", false],
		[42, "", "[[chapter/42]] içinde pilot, yola çıkmadan önce bir tane takmalı ve onu korsanlar üzerinde denemelidir.", false],
	],
	"equipment/43": [
		[1, "", "Bu onarım droidi, gövde hasarlıyken her 0,6 sn'de bir gövde puanı, yani dakikada yaklaşık 100 puan yeniler. Kalkana ya da zırha dokunmaz. Uzun görevler ve başıboş bir isabeti kaldıramayacak düşük gövdeli gemiler için yararlıdır. Yalnızca bir tane takılabilir ve bir silah alabilecek bir yuvayı kaplar.", false],
	],
	"equipment/5": [
		[1, "", "En iyi bobinli top bir keskin nişancı silahıdır. Her ışın, tüm silahların en uzun menzili olan 1.380 m'ye kadar 35 vurur, ama atış ancak her 5,6 sn'de bir hazır olur. Dükkânlardaki en nadir parçalardan biridir. Kısa menzilli silahların yanına takıldığında, bataryanın geri kalanı onlara ulaşmadan çok önce hedefleri yıpratır.", false],
	],
	"equipment/6": [
		[1, "", "İlk füzyon topu kısa menzilli bir kavgacıdır: her 0,51 sn'de 10 hasar, ama yalnızca 160 m'ye kadar; bu, tüm silahların en kısa menzilidir. Hasar hızı tüm raylı toplarınkinin epey üstündedir. Hızla yaklaşabilen çevik gövdelere uyar ve yakın dövüşte raylı topları geçersiz kılar.", false],
	],
	"equipment/7": [
		[1, "", "Bu yükseltme, tüm silahların en yüksek atış hızı olan her 0,37 sn'de 14 vurur ve menzili 216 m'ye uzatır. Sürekli hasarı, yalnızca birkaç bin kredi fazlasına [[equipment/6]] silahınınkinin neredeyse iki katıdır. Harcanan kredi başına oyundaki en güçlü silahlardan biridir.", false],
	],
	"equipment/8": [
		[1, "", "En ağır füzyon topu, 220 m'de her 0,40 sn'de 18 hasar verir. [[equipment/7]] silahına göre sağlam bir gelişmedir, ama aradaki fark ilk iki model arasındakinden küçüktür. Dükkânlarda nadirdir. Bir tane çıktığında, her yakın menzil bataryası için güçlü bir alımdır.", false],
	],
	"equipment/9": [
		[1, "", "İlk kütle sürücüsü atış başına 16 hasarla sert vurur, ama yalnızca her 0,6 sn'de bir ateş eder ve 195 m'ye ulaşır. 38.000 cr ya da daha fazlasına, daha ucuz [[equipment/7]] silahından daha az saniye başı hasar verir. Esasen sonraki kütle sürücülerine bir basamaktır.", false],
	],
	"faction/colonists": [
		[1, "", "Kolonistler, hikâyenin başında okyanus gezegenini yöneten yerleşimciler ve idarecilerdir. Gezegenin iki yüz istasyonunun hepsini ellerinde tutar, av fiyatlarını belirler ve kimin iş alacağına karar verirler. Kolonileri, denizin kaynaklarını çıkarıp gezegenden dışarı göndermek için kurulmuştur. Bir yer olarak koloni için bkz. [[world/colony]].", false],
		[1, "Tarihçe", "Kolonistler gezegene başka yerlerden yerleşmiş ve istasyonlarını denizin derinliklerine kurmuştur. Pilot geldiğinde koloni çoktan yerleşiktir: her istasyonda yetkililer, her kapıda devriye gemileri ve düzenli bir ihracat akışı vardır.", false],
		[21, "", "Asilerin anlatımına göre kolonileşme hızlı ve sonuçlarını umursamayan bir şekilde ilerlemiştir. Okyanusun yaşamının kendini yenileyebileceğinden daha hızlı tüketildiği ve başka gezegenlerin de aynı şekilde tükendiği uyarısında bulunurlar.", false],
		[1, "Örgütlenme", "Her istasyon, ticareti yürüten, sözleşme dağıtan ve yerel devriyelere komuta eden koloni yetkililerince yönetilir. Onların üstünde ihracatı denetleyen ve istasyonları her türlü kayıptan sorumlu tutan bir ticaret yönetimi vardır. İstasyon güvenliği ve koloninin kendi pilotları korsanlarla ve diğer tehditlerle, çoğu zaman serbest çalışanlar tutarak ilgilenir.", false],
		[10, "", "Mallar gezegeni nakliye kapsülleriyle terk eder; kapsüller istasyonlardan yörüngeye fırlatılır ve orada kargo gemilerince toplanır.", false],
		[1, "Amaçlar ve yöntemler", "Koloninin amacı efendileri için kârdır. Avı ve malları düşük sabit fiyatlarla satın alır ve istasyonlarının serbestçe ticaret yapmasına izin vermez. Yoluna çıkan hayvanlar itlaf edilir, sevkiyatları tehdit eden herkes püskürtülür.", false],
		[23, "", "İsyanla karşılaşan kolonistler yönetimden zora geçer. İkmal yollarını mayınlar, pusular kurar ve asi istasyonlarına saldırırlar.", false],
		[28, "", "Sadakat satın almaya da hazırdırlar. Bir asi pilotu kendi liderine karşı çevirmek için bir ödül yeterlidir.", false],
		[2, "Önemli üyeler", "[[character/9]], pilotun en iyi tanıdığı kolonisttir: [[station/0]] istasyonunda pilotu küçümseyen ve avı sabit fiyatlarla satın alan kibirli bir yetkili.", false],
		[9, "", "Daha alt düzey yetkililer adsız [[character/6|kolonistler]] olarak görünür; örneğin [[station/1]] istasyonunda nautilus itlafı için az ödeyip pilotu iş panosunda çalışmaya yönlendiren yetkili.", false],
		[23, "", "Jack hikâye boyunca, görünüşe göre iyi bağlantıları sayesinde, epey güç kazanır ve asilerin en kararlı düşmanı olur.", false],
		[28, "", "Bir asi pilot olan [[character/3]], gizlice koloninin parasını alır ve yoldaşlarına ihanet eder.", false],
		[3, "Hikâyedeki rolü", "Başta kolonistler yalnızca pilotun işverenleridir. Jack avı satın alır ve pilota bir silah alıp korsan avlamasını önerir.", false],
		[7, "", "Ardından, yakalanıp yakalanmamalarını pek umursamadan [[station/1]] istasyonundaki [[species/0|nautilusların]] itlafını emreder.", false],
		[10, "", "Birkaç sözleşmeden sonra koloni, [[station/2]] istasyonundaki bir kapsül fırlatmasının Aquarianlara karşı savunmasını pilota emanet eder.", false],
		[12, "", "Jack o çatışmada hasar gören kapsüller için pilotu suçlar ve hiçbir ödeme yapmaz. Koloninin davranışından bıkan pilot, direnişi aramaya koyulur.", false],
		[18, "", "Asiler istasyonları birer birer iknayla kazandıkça koloni, tek kurşun atılmadan toprak kaybeder.", false],
		[23, "", "Jack, [[station/9]] ile [[station/37]] arasındaki asi ikmal yolunu mayınlar.", false],
		[25, "", "Ardından [[station/10]] istasyonundaki görüşmelere giden asi lider [[character/2]] adlı kadına pusu kurar.", false],
		[28, "", "Jack'in koyduğu ödül, Raymond'ı asilere karşı çevirir. Raymond Ayumi'yi kaçırır ve pilot onu kurtarır.", false],
		[31, "", "Kolonistler [[world/abel|Profesör Abel'ın]] prototip [[world/biotek|Biotek jeneratörünü]] çalmıştır. Asiler onu taşıyan konvoyun yolunu Cho yakınında keser.", false],
		[37, "", "Jack, karaborsada bir [[world/eclipse|Eclipse]] istasyon topu satar ve onun kendisine karşı kullanılacağından hiç şüphelenmez.", false],
		[44, "", "Kolonistler isyanın kalbi olan [[station/14]] istasyonuna ani bir saldırı başlatır, ama Aquarianlar asilerin yardımına gelince bozguna uğrarlar. Jack savaştan kaçar.", false],
		[46, "", "İlk asi taarruzu [[station/18]] istasyonunu kolonistlerden alır.", false],
		[47, "", "İkincisi [[station/109]] istasyonunu alır ve kolonistlerin güneydeki hâkimiyeti çöker.", false],
		[48, "", "Koloninin son kalesi [[station/0]] son savaşta düşer. Jack bir kurtarma kapsülüyle kaçar ve koloninin okyanus üzerindeki yönetimi sona erer.", false],
		[1, "Oyunda", "Kolonist istasyonları [[chart]] üzerinde mavi görünür. Pazarları ve fabrikaları yoktur: yanaşıldığında ambarın tamamını taban fiyatından alırlar. Bu yüzden değerli kargoyla varılacak yerler değildir. Dükkânları ve tersaneleri açıktır, ama tersaneleri yalnızca standart gövdeler satar. Bkz. [[guide/allegiance]].", false],
		[1, "", "İş panoları [[contract/0]], [[contract/1]], [[contract/2]], [[contract/3]], [[contract/4]], [[contract/5]], [[contract/7]], [[contract/8]], [[contract/9]], [[contract/10]] ve [[contract/11]] sözleşmeleri sunar, ama asla teslimat ya da balık koruma sunmaz. Kolonistler için yapılan konvoy işlerinde karşı taraftaki gemiler asilerdir.", false],
		[1, "", "Öte yandan bir kolonist istasyonu korsanlar için asi istasyonunun iki katını öder: sefer boyunca yok edilenlerin sayısının karesi çarpı 100 kredi. Kolonist istasyonlarının çevresindeki devriye gemileri koloni için savaşır ve korsanlara karşı yardım eder.", false],
		[12, "", "İstasyonlar hikâye ilerledikçe koloniden ayrılır; bu asla serbest oyunda yapılan bir şeyle olmaz ve hiçbiri geri dönmez. Pilot asilerin tarafını tutunca kolonist gemileri hikâye görevlerinin ana düşmanı olur.", false],
	],
	"faction/pirates": [
		[1, "", "Korsanlar, okyanusun her yanında gemilere saldıran kanun kaçaklarıdır. Ne koloniye ne de asilere hizmet ederler; yalnız gemilere, konvoylara ve kolay av gibi görünen herkese saldırırlar. İlk silahlı çıkıştan hikâyenin sonuna ve ötesine kadar pilotun en sık karşılaştığı rakiplerdir.", false],
		[1, "Tarihçe", "Pilot geldiğinde korsanlık zaten hayatın bir gerçeğidir. İstasyonlar bir korsan gemisini yok eden herkese ödül öder ve korsan avcılığı silahlı pilotlar arasında yaygın bir meslektir.", false],
		[21, "", "Kolonistlerle asiler arasındaki çatışma korsanlar için bir armağandır. İki tarafın da dikkati dağılmışken daha çok ve daha kolay kurban bulurlar; asi liderliği de onları artık görmezden gelemeyeceğine karar verir.", false],
		[1, "Örgütlenme", "Korsanlar tek bir örgüt olarak değil gevşek çeteler hâlinde hareket eder ve hiçbirinin adı hikâyede geçmez. Çeteler açık sudaki sığınaklarda toplanır, çalıntı gemilere eskortluk eder, mayın tarlalarını ve enkaz alanlarını korur. Tek başına hareket eden korsanlar da gelip geçen gemileri istasyonların yakınında pusuda bekler.", false],
		[1, "Amaçlar ve yöntemler", "Korsanlar yağma ister. Gemilere kargoları için saldırır, nerede bela varsa orada toplanır ve avlamak için zayıflamış gemileri beklerler.", false],
		[23, "", "[[station/9]] istasyonu yakınındaki koloni mayın tarlasının çevresinde, içine düşen gemileri avlamayı umarak dolaşırlar.", false],
		[35, "", "Kiralık silahşorlar da aynı çevrelerde dolaşır. Ödül avcısı [[character/11]] silahlı bir eskortla yol alır ve ödül hesabında gemisi korsan sayılır.", false],
		[5, "Önemli üyeler", "Korsanlar hikâyede yalnızca adsız [[character/10|korsan]] pilotlar olarak görünür; ne bir liderleri ne de ünlü bir kaptanları vardır.", false],
		[5, "Hikâyedeki rolü", "Korsanlar, pilotun yeni raylı topunun ilk hedefleridir. [[character/1]] adlı bilgisayarın önerisiyle pilot, [[station/1]] istasyonu yakınında bir korsanın peşine düşer.", false],
		[21, "", "Ayumi hareketi yalnızca savunmayı bırakıp korsanlara saldırmaya karar verir. Pilotu ve [[character/3]] adlı pilotu [[station/8]] istasyonu yakınındaki bir çetenin peşine gönderir.", false],
		[25, "", "[[station/10]] yolunda korsanlar beklenir, ama oradaki asıl tehdidin koloniden geldiği anlaşılır.", false],
		[26, "", "Daha iyi bir savaşçı olması emredilen pilot, öldürme sayısını artırmak için korsan avına yönelir.", false],
		[42, "", "[[station/17]] istasyonu yakınındaki bir korsan sığınağı, yeni takılan [[world/eclipse|Eclipse]] için deneme alanı olur.", false],
		[43, "", "Oradaki korsanlar çok geçmeden takviye çağırır.", false],
		[47, "", "Son taarruzlar sırasında bile korsanlar, [[station/0]] yolundaki [[character/5]] adlı direnişçiyi oyalar.", false],
		[1, "Oyunda", "Korsanlar açık suların standart düşmanıdır. Pilotun rütbesi yükseldikçe ve hikâye ilerledikçe gövdeleri dayanıklılaşır, silahları güçlenir. [[contract/0]], [[contract/1]], [[contract/2]] ve [[contract/3]] sözleşmelerinde görünür, mayın tarlalarını ve enkaz alanlarını korurlar. Bkz. [[guide/combat]].", false],
		[1, "", "[[chapter/12|12. bölümden]] itibaren pilot vardığında bir istasyonun yakınında üç korsana kadar bekliyor olabilir ve bu olasılık her bölümle artar. [[chapter/16|16. bölümden]] itibaren korsanlar ve diğer düşman gemiler ani hız patlamaları da kullanır.", false],
		[1, "", "Bir sefer boyunca yok edilen her korsan, bir sonraki istasyonda ödenen ödülü artırır: yok edilenlerin sayısının karesi çarpı kolonist istasyonunda 100, asi istasyonunda 50 kredi. Bu yüzden uzun avlar kısa olanlardan çok daha fazla kazandırır. Enkazları yavaşça batar ve fazla derine inmeden önce kargo için zıpkınlanabilir.", false],
		[1, "", "Korsanların kendilerine ait istasyonları yoktur ve hiçbir istasyon onların tarafına geçmez.", false],
	],
	"faction/rebels": [
		[1, "", "Asiler, bir istasyonu elinde tutabilen güçlerden biridir. Doğaları ve amaçları hikâye ilerledikçe netleşir. Bkz. [[guide/allegiance]].", false],
		[12, "", "Asiler, okyanus gezegenindeki koloni yönetimine karşı ayaklanan bir direniş hareketidir. [[station/3]] istasyonunda üslenmiş gizli bir ağ olarak başlar ve istasyon istasyon yayılırlar. Serbest ticaret ve yağmalanmak yerine özenle kullanılan bir deniz isterler.", false],
		[12, "Tarihçe", "Pilot hareketi ilk kez M.A.I.'nin Talon'dan yakaladığı telsiz trafiği sayesinde duyduğunda hareket zaten etkindir.", false],
		[13, "", "Asiler kanallarını bu yayından ancak birkaç gün sonra şifrelemeye başlamıştır. Üyeleri planlarını kendilerine saklar ve yeni gelenleri güvenmeden önce sınar.", false],
		[18, "", "Hareket uzun süre iknayla büyür. Ajanları istasyonlar hakkında bilgi toplar ve yöneticilerini kendi taraflarına çeker; haberler de çok geçmeden hareketi bir devrim olarak adlandırır. Pierre barışçıl dönemin sürmeyeceğini düşünür.", false],
		[26, "", "[[station/10]] istasyonundaki pusu, mücadelenin yalnızca diplomasiyle kazanılamayacağını gösterir ve hareket savaşmaya hazırlanır.", false],
		[31, "", "Asi liderliği, kolonistlerin sayı üstünlüğünü aşmak için [[world/abel|Profesör Abel'ı]] ve ekibini hareketin operasyon üssü hâline gelen [[station/14]] istasyonuna getirir.", false],
		[13, "Örgütlenme", "Hareket küçük ve sıkı örgütlüdür. Yeni üyeler varışta sınanır ve onlara yalnızca bilmeleri gereken kadarı söylenir. Görevler birkaç güvenilir ajan aracılığıyla aşağıya iletilir.", false],
		[18, "", "Hareketin lideri gelişmeleri yeni kazanılan istasyonlardan birinden yönetir ve kendi üyeleri bile tam olarak nerede olduğunu bilmez.", false],
		[19, "", "Lider bizzat müzakere etmek için istasyonlar arasında dolaşır. Emrinde saha ajanları, pilotlar ve mühendisler görev yapar.", false],
		[45, "", "Savaşın sonunda hareket, savaş gemilerinden oluşan koca birlikler sahaya sürer.", false],
		[13, "Amaçlar ve yöntemler", "Asiler gezegenin ve sakinlerinin sömürülmesini kınar ve serbest ticareti savunur.", false],
		[15, "", "Ekonomileri koloninin tam tersidir. Yalnızca denizin verebileceği kadarını avlayıp toplar, avlarını kendi fabrikalarında mala dönüştürür ve adil piyasa fiyatlarıyla satarlar; bunu yaparken biyolojik çeşitliliği korumaya özen gösterirler.", false],
		[16, "", "İnsanlarla savaşmaktansa onları kazanmayı tercih ederler. Ajanlar, istasyonların halkını kendi taraflarına çekmekte kullanılabilecek zayıf noktaları bulmak için istasyonları keşfeder.", false],
		[21, "", "Liderleri, koloninin sömürüsünün başka gezegenlerde olduğu gibi bu gezegeni de tüketeceği uyarısında bulunur. Hareket, bu olmadan önce nüfuzlu insanları kendine katılmaya ikna etmeyi amaçlar. Ayrıca kargaşadan kâr sağlayan korsanlara karşı da savaşı başlatır.", false],
		[31, "", "Güç kullanmak kaçınılmaz hâle gelince asiler, koloniyle gemi gemi boy ölçüşmek yerine belirleyici bir silah yapmaya koyulur.", false],
		[12, "Önemli üyeler", "[[character/4]], [[station/3]] istasyonunda yeni gelenleri sınar. Asilerin telsiz operatörleri, muhafızları ve konvoy mürettebatı [[character/7]] olarak görünür.", false],
		[13, "", "[[character/5]], pilotu hareketin yaşam biçimiyle tanıştıran bir saha ajanıdır.", false],
		[33, "", "Pierre daha sonra [[station/14]] istasyonundaki hangarı yönetir ve hareketin gemilerini hazır tutar.", false],
		[19, "", "Hareketi [[character/2]] yönetir. Pilot liderin bir erkek olduğunu sanmış olsa da o yaşlıca bir kadındır.", false],
		[21, "", "[[character/3]], Ayumi'nin en iyi pilotlarından biridir; yetenekli ama kibirlidir.", false],
		[28, "", "Raymond bir koloni ödülü uğruna hain olur ve Ayumi'yi kaçırır.", false],
		[31, "", "[[world/abel|Profesör Abel]], [[world/biotek|Biotek jeneratörünün]] ardındaki bilim ekibinin başındadır.", false],
		[45, "", "[[character/12]], [[station/18]] saldırısı için pilota katılan bir savaş birliğine liderlik eder.", false],
		[12, "Hikâyedeki rolü", "Koloniyle arası bozulan pilot, hareketi Talon'da arar.", false],
		[13, "", "Pierre pilotu deneme süresiyle kabul eder. İlk görev, Leah'yı [[station/4]] istasyonundan [[station/5]] istasyonuna götürmektir.", false],
		[16, "", "Başka görevler de gelir: asi istasyonlarında mal üretmek ve hareket için istasyonları keşfetmek.", false],
		[19, "", "Pilot sonunda Ayumi ile tanışır ve [[station/7]] istasyonu yakınında bir kalamar sürüsünü kolonist avcılardan korur.", false],
		[22, "", "Pilot, Raymond ile birlikte [[station/8]] istasyonu yakınında bir korsan çetesini yok eder.", false],
		[24, "", "Pilot ardından [[station/9]] istasyonu yakınındaki bir koloni mayın tarlasını temizler.", false],
		[26, "", "Sula'da liderlik pusuya düşürülür. Raymond'ın silahları kritik anda arızalanır ve Leah sabotajdan şüphelenir.", false],
		[28, "", "Raymond, Ayumi'yi rehin alarak pilotu bir tuzağa çeker, ama pilot gemisini yok eder ve onu canlı kurtarır.", false],
		[31, "", "Hareket, çalınan [[world/biotek|Biotek jeneratörünün]] geri alınmasıyla başlayan üç adımlı bir plan başlatır.", false],
		[33, "", "İkinci adım, pilotun bir karaborsacı aracılığıyla satın aldığı bir [[world/eclipse|Eclipse]] topunu edinmektir.", false],
		[39, "", "Üçüncüsü, jeneratörü tamamlayan inkübatörü [[station/16]] istasyonunda üretmektir.", false],
		[44, "", "Silah, kolonistler Fiir'e saldırmadan hemen önce tamamlanır. İstasyonu pilotun Eclipse topu ve [[world/aquarians|Aquarianların]] beklenmedik yardımı kurtarır.", false],
		[45, "", "Aquarianlar desteklerini sözler ve hareket son taarruzlarını onları müttefik olarak yanına alarak planlar.", false],
		[47, "", "İki taarruz izler. Leah [[station/109]] istasyonunu, pilot ise [[station/18]] istasyonunu alır.", false],
		[48, "", "Savaş [[station/0]] istasyonunun düşmesiyle sona erer ve hareket gezegendeki her istasyonu elinde tutar.", false],
		[1, "Oyunda", "Asi istasyonları [[chart]] üzerinde turuncu görünür. Serbest pazarlar ve fabrikalar işletirler; bu yüzden orada mal alınabilir, satılabilir ve üretilebilir; bkz. [[guide/trading]]. Tersaneleri her gövdeyi yükseltilmiş sürümüyle satar. Asi istasyonlarının çevresindeki devriyeler asiler için savaşır.", false],
		[1, "", "İş panoları [[contract/0]], [[contract/1]], [[contract/2]], [[contract/3]], [[contract/6]], [[contract/8]], [[contract/9]], [[contract/10]], [[contract/13]] ve [[contract/14]] sözleşmeleri sunar. Asla eskortluk, konvoy baskını, balık avı ya da kapsül işi yayımlamaz ve hikâye tamamlanınca balık koruma yayımlamayı bırakırlar. Asi sözleşmeleri başka gemilerle savaşmayı içerdiğinde rakipler kolonistler ya da korsanlardır.", false],
		[1, "", "Bir asi istasyonu korsanlar için kolonist istasyonunun yarısını öder: sefer boyunca yok edilenlerin sayısının karesi çarpı 50 kredi.", false],
		[12, "", "İstasyonlar hikâye ilerledikçe asilere katılır; önce birkaçar birkaçar, sonra onlarcası birden. Katılan bir istasyon asla koloniye geri dönmez. Bu sayfa, ulaştığınız her bölümde katılan istasyonları listeler.", false],
	],
	"goods/18": [
		[1, "", "Zıpkınlanmak yerine öldürülen bir canlıdan geriye kalan. Leş yukarı süzülür ve zıpkınla çekilerek hayvanın kütlesinin üçte biri kadar et verir. 12 ile 31 cr'ye satılır ve esasen [[species/14]] ile birlikte [[goods/19]] yapımında kullanılır. Ana istasyonu [[station/68]] istasyonudur.", false],
	],
	"goods/19": [
		[1, "", "Birim başına birer [[goods/18]] ve [[species/14]] ile yapılan temel bir ürün. Her fabrika yapabilir. [[station/78]] istasyonunda 135 cr'den [[station/27]] istasyonunda 360 cr'ye kadar satılır; [[goods/30]] ve [[goods/36]] ürünlerinin malzemesidir.", false],
	],
	"goods/20": [
		[1, "", "[[goods/33]] ile işlenmiş, [[species/3]] canlısından elde edilen tabaklanmış deri. Ana istasyonu [[station/164]] istasyonudur; en yüksek fiyatı, 1.062 cr'ye kadar, [[station/172]] istasyonunda bulur. Ayrıca [[goods/29]] tarifinin yarısıdır; böylece bir manta avı en pahalı tüketim mallarından birine dönüştürülebilir.", false],
	],
	"goods/21": [
		[1, "", "[[species/4]] ve [[species/17]] ile yapılan, çiğ balık ve deniz yosunundan oluşan bir yemek. İki malzeme de yaygın ve ucuz avlardır; bu da suşiyi kolay bir ilk ürün yapar. [[station/76]] istasyonunda 420 cr'den [[station/179]] istasyonunda 996 cr'ye kadar satılır.", false],
	],
	"goods/22": [
		[1, "", "[[species/10]] ve [[goods/35]] ile yapılan suya dayanıklı bir boya. [[station/54]] istasyonunda 750 cr'den [[station/27]] istasyonunda 1.872 cr'ye kadar satılır. Ayrıca [[goods/29]] ürününün iki malzemesinden biridir.", false],
	],
	"goods/23": [
		[1, "", "[[goods/33]] ile korunmuş [[species/7]] dilimleri. Marlin zor yakalandığından biftek birinci sınıf bir üründür: [[station/109]] istasyonunda 456 cr'den [[station/19]] istasyonunda 1.260 cr'ye kadar satılır.", false],
	],
	"goods/24": [
		[1, "", "[[species/5]] ve [[species/1]] canlılarından [[goods/35]] ile özütlenen ışıldayan bir bileşik. [[station/83]] istasyonunda 850 cr'den [[station/179]] istasyonunda 2.500 cr'ye kadar satılır. [[goods/32]], [[goods/41]] ve [[goods/36]] için temel bir girdidir.", false],
	],
	"goods/25": [
		[1, "", "[[species/6]] ve [[species/8]] canlılarından özütlenen, [[goods/33]] ile işlenen bir protein. [[station/23]] istasyonunda 900 cr'den [[station/27]] istasyonunda 2.600 cr'ye kadar satılır ve [[goods/31]] ürününün temelidir.", false],
	],
	"goods/26": [
		[1, "", "[[species/8]], [[species/4]] ve [[species/2]] ile yapılan karışık bir balık yemeği. Tüm yiyecekler arasında en yüksek taban fiyata sahiptir: [[station/196]] istasyonunda 1.916 cr'den [[station/179]] istasyonunda 3.030 cr'ye kadar. Ancak üç farklı av gerektirir.", false],
	],
	"goods/27": [
		[1, "", "[[species/1]], [[species/13]], [[species/16]] ve [[goods/33]] ile yapılan ilaçlar. [[station/151]] istasyonunda 930 cr'den [[station/179]] istasyonunda 2.316 cr'ye kadar satılır ve [[goods/41]] malzemelerinden biridir. Pazarlar onu nadiren stoklar.", false],
	],
	"goods/28": [
		[1, "", "Beş algin her birinden birer tane gerektiren işlenmiş bir biyokütle: [[species/13]], [[species/14]], [[species/15]], [[species/16]] ve [[species/17]]. [[station/74]] istasyonunda 550 cr'den [[station/19]] istasyonunda 2.700 cr'ye kadar satılır; bu, temel ürünler arasındaki en geniş aralıktır. [[goods/36]] yapımında kullanılır.", false],
	],
	"goods/29": [
		[1, "", "[[goods/20]] ve [[goods/22]] ile yapılan giysiler; dolayısıyla zincir [[species/3]] ve [[species/10]] canlılarına dayanır. [[station/175]] istasyonunda 1.626 cr'den [[station/172]] istasyonunda 3.420 cr'ye kadar satılır. Pazarlar onu nadiren stoklar.", false],
	],
	"goods/30": [
		[1, "", "[[goods/34]] ve [[goods/19]] ile birleştirilen taşınabilir bir güç kaynağı. [[station/78]] istasyonunda 1.150 cr'den [[station/27]] istasyonunda 1.900 cr'ye kadar satılır. Pazarlarda nadiren bulunur; bu yüzden onu edinmenin tek yolu genellikle üretmektir.", false],
	],
	"goods/31": [
		[1, "", "[[goods/25]] ve [[goods/35]] ile yapılan güzellik ürünleri. [[station/23]] istasyonunda 1.536 cr'den [[station/27]] istasyonunda 3.840 cr'ye kadar satılır. Pazarlar onları nadiren stoklar; bu yüzden kolajen yapan bir pilot bir adım daha ileri gidip çok daha fazla kazanabilir.", false],
	],
	"goods/32": [
		[1, "", "[[goods/34]] ve [[goods/24]] ile yapılan, doğal gün ışığını taklit eden bir lamba. [[station/83]] istasyonunda 2.490 cr'den [[station/179]] istasyonunda 5.622 cr'ye kadar satılır; bu da onu herhangi bir fabrikanın avlardan ve ithal mallardan yapabileceği en değerli ürün yapar.", false],
	],
	"goods/33": [
		[1, "", "Tuzdan arındırmanın bir yan ürünü; ucuzdur ve 20 ile 36 cr arasında yaygın olarak stoklanır. Avlardan yapılmaz, ama [[goods/20]], [[goods/23]], [[goods/25]] ve [[goods/27]] için gereklidir. Teslimat sözleşmeleri onu asla istemez.", false],
		[12, "", "İthal bir mal olduğundan asi pazarları onu ziyaretler arasında yeniden stoklar.", false],
	],
	"goods/34": [
		[1, "", "193 ile 297 cr arasında yaygın olarak stoklanan ithal parçalar. Yerel olarak yapılmazlar, ama [[goods/30]], [[goods/32]], [[goods/41]] ve [[goods/36]] için gereklidirler. Teslimat sözleşmeleri onları asla istemez.", false],
		[12, "", "İthal oldukları için asi pazarları elektroniği ziyaretler arasında yeniden stoklar.", false],
	],
	"goods/35": [
		[1, "", "55 ile 123 cr arasında yaygın olarak stoklanan ithal bir kimyasal. [[goods/22]], [[goods/24]] ve [[goods/31]] için gereklidir. Teslimat sözleşmeleri onu asla istemez.", false],
		[12, "", "İthal bir mal olduğundan asi pazarları onu ziyaretler arasında yeniden stoklar.", false],
	],
	"goods/36": [
		[1, "", "Genetik malzemeyi çoğaltmaya yarayan bir laboratuvar aygıtı. [[goods/19]], [[goods/34]], [[goods/28]] ve [[goods/24]] gerektirir ve yalnızca teknoloji seviyesi 11 olan bir fabrika onu birleştirebilir. Pazarlar onu asla stoklamaz.", false],
		[39, "", "Sefer, [[chapter/39]] sonrasında pilotun bir tane edinmesini gerektirir.", false],
	],
	"goods/37": [
		[1, "", "Giderek büyüyen bir toplumsal sorun olarak görülen ithal bir uyuşturucu. Avlardan yapılmaz ve pazarlar onu asla stoklamaz.", false],
		[34, "", "[[chapter/34]] içinde pilot, bir anlaşmanın parçası olarak bir irtibat kişisine bir parti teslim etmelidir.", false],
	],
	"goods/38": [
		[1, "", "89.000 cr değerinde, sandıklanmış ağır bir istasyon topu. Pazarlardan satın alınamaz. Teslim edilip takıldığında [[equipment/42]] silahına dönüşür.", false],
		[37, "", "[[chapter/33]] sonrasında pilotun aradığı nesnedir; pilot [[chapter/37]] içinde bir tane taşır.", false],
	],
	"goods/39": [
		[1, "", "İthal bir katlanır kürek. Fiyatı, ne kadar uzağa taşındığına bağlı olarak 9 cr ile 999 cr arasında dalgalanır; bu da onu spekülatif bir kargo yapar. Hiçbir fabrika onu yapmaz ve teslimat sözleşmeleri onu asla istemez. Ana istasyonu [[station/89]] istasyonudur.", false],
	],
	"goods/40": [
		[1, "", "Koleksiyonculara satılan, ünlü bir kahramanın figürü. Fiyatı [[station/90]] istasyonundan [[station/19]] istasyonuna doğru 999 cr'den 9.999 cr'ye kadar çıkar; bu, tüm ticaret malları arasındaki en dik artıştır. Pazarlarda pek bulunmaz ve teslimat sözleşmeleri onu asla istemez.", false],
	],
	"goods/41": [
		[1, "", "[[goods/27]], [[goods/24]] ve [[goods/34]] ile yapılan mikroskobik tıbbi robotlar. En değerli mallar arasındadırlar: [[station/76]] istasyonunda 4.315 cr'den [[station/179]] istasyonunda 11.972 cr'ye kadar satılırlar ve pazarlar onları neredeyse hiç stoklamaz.", false],
	],
	"guide/allegiance": [
		[1, "İki tür istasyon", "Her istasyon iki taraftan birinin elindedir; bu, [[chart]] üzerindeki rengiyle gösterilir: [[faction/colonists]] için mavi, [[faction/rebels]] için turuncu. Hikâyenin başında her istasyon kolonisttir.", false],
		[1, "", "Bir istasyonun tarafı, sunduklarını değiştirir:", false],
		[1, "", "Ticaret: kolonist istasyonlarında pazar ve atölye yoktur. Varışta ambarın tamamını taban fiyattan satın alırlar. Asi istasyonları serbestçe ticaret ve üretim yapar; bkz. [[guide/trading]].", true],
		[1, "", "Sözleşmeler: her taraf kendi sözleşme türü seçkisini verir; bkz. [[guide/contracts]].", true],
		[1, "", "Ödüller: korsan ödülü kolonist istasyonunda asi istasyonundakinin iki katıdır.", true],
		[1, "", "Gemiler: asi tersaneleri her gövdeyi yükseltilmiş sürümüyle satar.", true],
		[1, "", "Devriyeler: bir istasyonun çevresinde dolaşan gemiler o istasyonun tarafı için savaşır.", true],
		[1, "", "Yanaşma, ekipman dükkânı, gemi satıcısı ve iş panosu her iki tür istasyonda da pilota açıktır.", false],
		[1, "Bağlılık nasıl değişir", "İstasyonlar yalnızca hikâye ilerledikçe taraf değiştirir; pilotun serbest oyunda yaptıkları bunu asla etkilemez. Asilere katılan bir istasyon onlarla kalır. [[faction/rebels]] sayfası, ulaştığınız her bölümde katılan istasyonları listeler.", false],
		[12, "", "İlk asi istasyonu, pilot onu ilk kez duyduğunda zaten direnişle olan [[station/3]] istasyonudur. [[station/4]] istasyonu da [[chapter/12|12. bölümde]] katılır.", false],
		[14, "", "Sonraki bölümler boyunca istasyonlar birer ya da birkaçar taraf değiştirir.", false],
		[22, "", "[[chapter/22|22. bölümden]] itibaren hareket çok daha hızlı büyür; bir seferde sekiz ya da daha fazla istasyon katılır.", false],
		[46, "", "Son bölümlere gelindiğinde haritanın büyük çoğunluğu turuncudur.", false],
		[12, "Pilot için anlamı", "Daha fazla istasyon taraf değiştirdikçe haritanın her yanında pazarlar ve atölyeler açılır, avcılık geçimin tek yolu olmaktan çıkar. Kolonist istasyonları değerli bir ambarla uzak durulacak yerler olur, ama korsan ödülü toplamak için iyi yerlerdir.", false],
	],
	"guide/basics": [
		[1, "İlk geminiz", "Pilot [[station/0]] istasyonunda 15.000 kredi ve küçük bir balıkçı denizaltısı olan [[ship/0]] ile başlar. Gemide bir [[equipment/15]] zıpkın, bir [[equipment/18]], [[equipment/22]] ve bir [[equipment/35]] takılıdır. Hiç silahı yoktur.", false],
		[1, "", "İlk bölümler rehberli bir giriştir. Gemi bilgisayarı [[character/1]], her yeni görevi sırası geldikçe açıklar: balık yakalamak, yanaşmak, ekipman takmak ve yolculuk etmek. Güncel hedef her zaman görev günlüğündedir.", false],
		[1, "Seyir", "Denizaltıyı klavye ve fare, oyun kumandası ya da dokunmatik kontrollerle kullanabilirsiniz; her tuş Ayarlar'dan yeniden atanabilir. Gaz çeyrek adımlarla değişir, Durdur gemiyi durdurur. Yanal iticiler denizaltıyı dururken bile yana kaydırır. Turbo yalnızca bir turbo takılıyken çalışır. Kamera dört görünüm arasında geçiş yapar.", false],
		[1, "", "Otopilot bir hedef listesi açar: güncel hedef, yerel rıhtım, yerel S.T.R.E.A.M. kapısı ya da haritadaki herhangi bir istasyon. Dümen, gaz ya da silah kullanımı kontrolü size geri verir. Bkz. [[guide/navigation]].", false],
		[1, "Yanaşma", "Yanaşmak için istasyonun yanaşma alanına girip Yanaş komutunu kullanın ya da rıhtımı otopilot listesinden seçin. Bölgedeki bir görev karşılaşması bitmemişse yanaşma kilitlidir. Bir istasyondan ayrılmak gövdeyi, kalkanı ve zırhı her zaman ücretsiz olarak tam doldurur.", false],
		[1, "İstasyon menüleri", "Yanaşılan bir istasyon altı hizmet sunar:", false],
		[1, "", "Hangar: ekipman dükkânı, gemi satıcısı, mal üretimi için atölye ve geminizin görünümü.", true],
		[1, "", "Görevler: güncel hedeflerin günlüğü ve istasyonun iş panosu.", true],
		[1, "", "Harita: rota planlamak ve türlerin nerede yaşadığını bulmak için istasyon haritası.", true],
		[1, "", "Ticaret: kargo alıp satmak için pazar.", true],
		[1, "", "Durum: geminiz, kargonuz, pilot rütbeniz, madalyalarınız ve istatistikleriniz.", true],
		[1, "", "Sistem: kayıt, ayarlar, yardım ve bu ansiklopedi.", true],
		[1, "", "Bazı hizmetler hikâyenin ilerleyen kısımlarında açılır. İstasyon haritası [[chapter/7|7. bölümde]], iş panosu ise [[chapter/9|9. bölümde]] açılır. [[faction/colonists]] grubunun elindeki istasyonlar asla ticaret yapmaz; bkz. [[guide/trading]].", false],
		[1, "Kayıt", "Yalnızca yanaşıkken kayıt yapabilirsiniz. Bir istasyona her varışta otomatik bir kontrol noktası yazılır; Sistem menüsü ayrıca üç kayıt yuvası daha sunar. Bir istasyondan ana menüye dönmek önce kayıt yapar. Gövde yok olursa oyun son istasyon kaydından devam eder; bu yüzden uzun yolculuklarda düzenli olarak yanaşın.", false],
		[1, "", "Yine Sistem menüsündeki Kaydı aktar, son istasyon kaydınızı bir dosyaya aktarır ve onu başka bir cihazda içe aktarmanızı sağlar.", false],
		[1, "Yardım", "Sistem menüsündeki Yardım her istasyon ekranını açıklar. Denizdeyken duraklatma menüsünde harita, görev günlüğü, gemi durumu, madalyalar ve ayarlar bulunur. M.A.I. her yeni durumda bir kez yorum yapar; örneğin ilk kapıda ya da güvenli derinlik aralığının dışına ilk dalışta. Bu ipuçları oynanış ayarlarından kapatılabilir.", false],
		[1, "", "Ardından, uzağa gitmeden önce [[guide/depth]] sayfasını, ilk geliriniz için de [[guide/fishing]] sayfasını okuyun.", false],
	],
	"guide/combat": [
		[1, "Silahlar", "Silahlar iki aileye ayrılır. [[equipment/0]], [[equipment/6]] ve [[equipment/9]] gibi mermili silahlar art arda atış yapar. [[equipment/3]] ve üstündeki bobinli toplar olan ışın silahları uzak menzilde sert vurur, ama yavaş dolar. Birden fazla silah takılabilir; hepsi baş tarafa dağılmış yuvalardan birlikte ateş eder.", false],
		[1, "", "[[equipment/12]] ile [[equipment/14]] arasındaki güdümlü torpidolar bir buçuk saniye düz gider, sonra yaklaşık 150 m içindeki en yakın canlı hedefe döner. Yalnızca bir torpido rampası takılabilir. Her silah sayfası hasarı, menzili ve atış aralığını verir.", false],
		[1, "Ateş etme", "Silahlar ve torpidolar bir grubu, zıpkın ise diğerini oluşturur. Ateş seçili grubu kullanır, Grup ise ikisi arasında geçiş yapar. Farede sol düğme silahları, sağ düğme zıpkını ateşler; oyun kumandasında sağ tetik silahları, sol tetik zıpkını ateşler.", false],
		[1, "", "Otomatik ateş, siz kapatana dek seçili grubun ateş etmesini sürdürür. Otopilotu da sonlandırır.", false],
		[1, "Koruma", "Gelen ateş önce kalkanı, sonra zırhı, sonra gövdeyi tüketir. Gövde sıfıra inince gemi kaybedilir ve oyun son istasyon kaydından devam eder.", false],
		[1, "", "Pasif şarjlı kalkanlar denizde yenilenir. Zırh yenilenmez; gövde de yalnızca bir [[equipment/43]] ile onarılır. Bir istasyondan ayrılmak üçünü de yeniler. [[equipment/39]] gibi bir turbo, yaklaşmak ya da uzaklaşmak için kısa bir hız patlaması sağlar, ardından dolması için zaman gerekir.", false],
		[1, "Düşmanlar", "Olağan düşman [[faction/pirates]] grubudur. Pilot rütbeniz ve hikâye ilerledikçe gövdeleri dayanıklılaşır, silahları güçlenir. [[chapter/12|12. bölümden]] itibaren bir istasyonun yakınında en fazla üç korsan bekliyor olabilir.", false],
		[1, "", "Görev karşılaşmaları kendi rakiplerini getirir: aranan gemiler, etkisiz bir gemiyi koruyan çeteler, konvoy muhafızları ve mayın tarlaları. Bkz. [[guide/contracts]].", false],
		[10, "", "Aquarianlar kolonist nakliye kapsüllerine saldırır. Kendilerine ait silahlarla savaşırlar ve yok edildiklerinde enkaz bırakmazlar.", false],
		[1, "Ödüller ve ganimet", "Bir yolculukta yok edilen her korsan, bir sonraki yanaşmanızda ödenen ödülü artırır. Ödül, korsan sayısının karesinin kolonist istasyonunda 100, asi istasyonunda 50 krediyle çarpımıdır. Tek yolculukta dört korsan, kolonist istasyonunda 1.600 kredi getirir.", false],
		[1, "", "Yok edilen gemiler, zıpkınla kurtarılabilecek kargo içeren bir enkaz bırakır. Öldürülen düşmanlar [[medal/4]], korsanlar [[medal/14]], tek yolculuktaki çok sayıda öldürme de [[medal/9]] için sayılır.", false],
		[1, "", "Yakalamak istediğiniz balıkları silahlarınızdan uzak tutun: yaralı bir canlı kaçar, zıpkındaki bir av da vurulursa kaybedilir.", false],
	],
	"guide/contracts": [
		[1, "İş panosu", "[[chapter/9|9. bölümden]] itibaren her istasyonun Görevler hizmetinde bir ile sekiz sözleşme içeren bir iş panosu bulunur. Her sözleşme, sponsorunu, kabulde ödenen depozitoyu ve başarıda ödenen ücreti gösterir. Hikâye hedefinin yanında aynı anda bir sözleşme tutabilirsiniz. Depozito iade edilmez; bu yüzden bir sözleşmeden vazgeçmek ya da onda başarısız olmak depozitoya mal olur.", false],
		[1, "Sözleşme türleri", "On beş tür sözleşme vardır:", false],
		[1, "", "[[contract/0]]: hedef istasyonun yakınında bekleyen tek bir dayanıklı gemiyi yok edin.", true],
		[1, "", "[[contract/1]] ve [[contract/2]]: bir korsan çetesiyle seyreden bir gemiyi etkisiz bırakın, sonra kaçmadan önce zıpkınlayın.", true],
		[1, "", "[[contract/3]]: bir korsan çetesinin tüm üyelerini yok edin.", true],
		[1, "", "[[contract/4]]: bir yük gemisi konvoyunu akıncılardan koruyun; konvoyun tamamını kaybetmek işi başarısız kılar.", true],
		[1, "", "[[contract/5]]: korunan bir konvoyun yük gemilerini yok edin.", true],
		[1, "", "[[contract/6]]: bir canlı sürüsünü avcılardan koruyun; çok fazla kayıp işi başarısız kılar.", true],
		[1, "", "[[contract/7]]: tek bir türden belirli sayıda canlı yakalayın ya da öldürün.", true],
		[1, "", "[[contract/8]]: bir yolcuyu başka bir istasyona taşıyın; bazen yol üzerindeki duraklar sınırlıdır.", true],
		[1, "", "[[contract/9]]: yüzen enkazı yaklaşık iki buçuk dakika içinde yok edin.", true],
		[1, "", "[[contract/10]]: korunan bir mayın tarlasını yok edin.", true],
		[1, "", "[[contract/11]]: bir fırlatma sırasında nakliye kapsüllerini savunun.", true],
		[1, "", "[[contract/12]]: nakliye kapsüllerini yok edin. Yalnızca hikâyede çıkar, iş panosunda asla yer almaz.", true],
		[1, "", "[[contract/13]] ve [[contract/14]]: işi veren istasyona belirli miktarda bir ürün ya da tek bir türden canlı teslim edin.", true],
		[1, "Kim neyi verir", "[[faction/colonists|Kolonist]] istasyonları asla [[contract/6]], [[contract/12]], [[contract/13]] ya da [[contract/14]] sözleşmesi vermez. [[faction/rebels|Asi]] istasyonları asla [[contract/4]], [[contract/5]], [[contract/7]], [[contract/11]] ya da [[contract/12]] sözleşmesi vermez ve hikâye tamamlanınca [[contract/6]] vermeyi bırakır. Teslimat sözleşmeleri, oyunun istasyon tablosunu açan yirmi bir istasyonda, yani [[station/0]] ile [[station/20]] arasında asla verilmez.", false],
		[1, "Hedefler ve ücret", "Çoğu sözleşme başka bir istasyona götürür; bu genellikle derinlik aralığınızda ve hikâye ilerledikçe artan bir mesafe içinde olan bir istasyondur. Ücret 3.500 krediden başlar ve zorluk ve mesafeyle artar. [[contract/9]] daha az öder; eskortluk, balık koruma ve kapsül savunması daha fazla öder. Daha az durağa izin veren bir yolcu fazladan öder. Teslimat sözleşmeleri olağan depozitonun yarısını ister.", false],
		[1, "", "Zorluk pilot rütbenizle birlikte artar. Rütbe; canlı yakaladıkça, düşman yok ettikçe, mal ürettikçe ve sözleşme tamamladıkça yükselir. Bu yüzden daha iyi ücretli işler daha zorlu rakipler de getirir.", false],
		[1, "Sözleşmeyi yürütmek", "Hedef bölgeye varınca karşılaşma başlar. Otopilottaki hedef seçeneği yol noktalarına götürür. Karşılaşma çözülene dek yanaşma ve kapı kilitli kalır; başarısızlık sözleşmeyi sonlandırır. Teslimatlar, mallarla yanaştığınızda sonuçlanır.", false],
		[1, "", "Tamamlanan her sözleşme [[medal/12]] için sayılır.", false],
	],
	"guide/depth": [
		[1, "DEEP'te derinlik", "Her istasyon sabit bir derinliktedir; bu derinlik, teknoloji seviyesiyle birlikte istasyonun sayfasında gösterilir. Çoğu 15.000 ile 30.000 m arasındadır. En yüksekteki 13.500 m ile [[station/28]], en derindeki ise 32.250 m ile [[station/81]] istasyonudur. Okyanusun dalışı durduracak bir tabanı yoktur: denizaltı, gövdesi dayandığı sürece batabilir.", false],
		[1, "Güvenli aralık", "Gemi yalnızca iki ekipmanın belirlediği bir derinlik aralığında güvendedir. Kalkan sığ sınırı, yani geminin çıkabileceği en yüksek noktayı belirler. Zırh derin sınırı, yani batabileceği en alt noktayı belirler. İkisi de takılı değilse aralık yalnızca 22.000 ile 23.000 m arasıdır.", false],
		[1, "", "[[ship/0]], 20.000 m için derecelendirilmiş bir [[equipment/18]] ve 25.000 m için derecelendirilmiş [[equipment/22]] ile başlar; bu yüzden aralığı 20.000 ile 25.000 m arasıdır. Daha iyi kalkanlar geminin daha yükseğe çıkmasını, daha iyi zırh ise daha derine dalmasını sağlar. Her ekipman sayfası kendi derecesini, her istasyon sayfası da oraya hangi derecenin ulaştığını gösterir. Yalnızca bir kalkan ve bir zırh takılabilir.", false],
		[1, "Aralığın dışında", "Bir sınırı aşmak bir uyarı başlatır. Aralığın dışında beş saniye geçtikten sonra gemi saniyede birkaç kez hasar alır. Çok derindeyken basınç kalkanı, çok yüksekteyken zırhı tüketir. O katman boşalınca hasar doğrudan gövdeye gider.", false],
		[1, "", "Her darbe başta küçüktür. 30.000 m'nin altında ya da 15.000 m'nin üstünde her 2.000 m için bir puan artar; bu yüzden aşırı derinlikler gemiyi hızla yıpratır.", false],
		[1, "", "Beş saniyelik ek süre, örneğin bir avı kovalamak ya da bir istasyonun yanından geçmek için kısa çıkışlara izin verir. Gemi aralığının dışındayken zaman hızlandırma 2× ile sınırlıdır.", false],
		[1, "Toparlanma", "Pasif şarjlı kalkanlar yalnızca gemi kendi sığ sınırlarının altındayken yenilenir. Zırh denizde toparlanmaz; gövde ise yalnızca bir [[equipment/43]] ile onarılır. Gemi bir istasyondan ayrıldığında üçü de yenilenir.", false],
		[1, "Yolculuk planlama", "Otopilot ve S.T.R.E.A.M., bir uyarının ardından sizi aralığınızın dışındaki bir istasyona yine de götürür, ama varış korumanızdan yer. İş panosu sözleşmeleri genellikle aralığınızdaki istasyonları gösterir, ama her zaman değil. Bir işi kabul etmeden önce hedefin derinliğini kontrol edin ve gerekirse donanımınızı değiştirin; bkz. [[guide/fitting]].", false],
		[1, "Derinlik rekorları", "Ulaştığınız en yüksek ve en alçak noktalar kaydedilir. [[medal/21]], 15.000, 12.000 ve 10.000 m'nin üstüne çıkmayı ödüllendirir; başka bir madalya da 30.000, 32.000 ve 35.000 m'nin altına dalışları ödüllendirir. Bkz. [[guide/medals]].", false],
	],
	"guide/fishing": [
		[1, "Zıpkın", "Avcılıkta, silahlardan ayrı kendi silah grubunu oluşturan zıpkın kullanılır. Her pilot bir [[equipment/15]] ile başlar; [[equipment/16]] ve [[equipment/17]] daha iyidir. Bir zıpkının üç değeri vardır: menzil, yakalama toleransı (atışın hedefi kancalamak için ne kadar yakından geçmesi gerektiği) ve yavaşlatma (avı ne kadar felç ettiği). Yalnızca bir zıpkın takılabilir.", false],
		[1, "", "Zıpkını kendi kontrolüyle atın: farenin sağ düğmesi ya da sol tetik. Zıpkın grubunu Grup ile seçip Ateş komutunu da kullanabilirsiniz.", false],
		[1, "Avı yakalamak", "İsabet, canlıyı kancalar; canlı kaçar ve çırpınır. Canlı yorulana dek onu geminin önünde tutun. Her canlı en az 2,1 saniye direnir, daha dayanıklı türler daha uzun direnir; her tür sayfası mücadele süresini verir. Yavaşlatması daha yüksek bir zıpkın, kaçan avın uzağa gitmesini önler.", false],
		[1, "", "Av, örneğin kendi silahlarınızla yaralanırsa ya da pes etmeden önce görüş alanınızdan çıkarsa kaçar. Zıpkın kontrolüne yeniden basmak kancadaki avı serbest bırakır.", false],
		[1, "", "Etkisiz kalan canlı çekilip gemiye alınır. Ambarda ton cinsinden kütlesi kadar yer kaplar; tek bir birey, türünün değerinden dörtte bir kadar ağır ya da hafif olabilir. Ambar fazla doluysa canlı suda kalır.", false],
		[1, "Algler", "[[species/17]] ile [[species/13]] arasındaki beş alg türü deniz tabanında hareketsiz durur. Neredeyse hemen pes ederler; bu da onları en kolay av yapar.", false],
		[1, "Leşler ve enkazlar", "Silahla öldürülen bir canlı yukarı doğru süzülen bir leş bırakır. Zıpkınlandığında, hayvanın yaklaşık üçte biri ağırlığında [[goods/18]] verir.", false],
		[1, "", "Yok edilen gemiler, bir kargodan bir ile yedi birim arası içeren bir enkaz bırakır. Kargoyu gemiye almak için enkazı zıpkınlayın. Kurtarılan her enkaz [[medal/18]] için sayılır.", false],
		[1, "Avı satmak", "Bir [[faction/colonists|kolonist]] istasyonunda ambarın tamamı varışta taban fiyattan satın alınır. Bir [[faction/rebels|asi]] istasyonunda ise balık ve algler pazar fiyatından satılabilir ya da atölyede malzeme olarak kullanılabilir. Bkz. [[guide/trading]].", false],
		[1, "", "Kargo modülleri ambarın kapasitesini artırır; bkz. [[guide/fitting]]. [[contract/14]] sözleşmeleri belirli sayıda tek bir türün teslimi için ödeme yapar; [[contract/7]] sözleşmeleri ise belirli sayıda yakalama ya da öldürme ister.", false],
		[1, "", "Her av [[medal/5]] için, tek yolculuktaki çok sayıda av da [[medal/10]] için sayılır. Her balık türünü yakalamak [[medal/3]], her alg türünü yakalamak da [[medal/2]] kazandırır.", false],
	],
	"guide/fitting": [
		[1, "Yuvalar", "Her gövdenin sabit sayıda ekipman yuvası vardır: [[ship/0]] gemisinde altı, en büyük gövdelerde on. Her parça bir yuva kaplar. Silahlar ve kargo modülleri birden fazla kez takılabilir. Torpido rampaları da dahil diğer her tür, gemi başına bir taneyle sınırlıdır.", false],
		[1, "Ekipman türleri", "Silahlar ve torpidolar: bkz. [[guide/combat]].", true],
		[1, "", "Zıpkınlar: canlıları yakalar ve enkazları kurtarır; bkz. [[guide/fishing]].", true],
		[1, "", "Kalkanlar: hasarı ilk olarak emer ve sığ derinlik sınırını belirler. Bazıları denizde dolar.", true],
		[1, "", "Zırh: hasarı kalkandan sonra emer ve derin derinlik sınırını belirler; bkz. [[guide/depth]].", true],
		[1, "", "Kargo modülleri: gövdenin temel kargo kapasitesine bir yüzde ekler. Etkileri toplanır.", true],
		[1, "", "Motorlar: S.T.R.E.A.M. menzilini kendi yüzdeleri kadar artırır.", true],
		[1, "", "Manevra birimleri: geminin daha hızlı dönmesini sağlar.", true],
		[1, "", "Radar birimleri: geminin algılayıcıları.", true],
		[1, "", "Turbolar: birkaç saniyelik ek hız, ardından yeniden dolma.", true],
		[1, "", "Onarım sistemi: [[equipment/43]], denizde gövdeyi yavaşça onarır.", true],
		[1, "Alım ve satım", "Bir istasyonun dükkânı, nadirliğe göre seçilen iki ile beş parça sunar; hikâye ilerledikçe nadir parçalar daha sık çıkar. Fiyatlar teknoloji seviyesiyle düşer: teknoloji seviyesi 10 olan bir istasyon bir parçayı fiyat aralığının en altından, teknoloji seviyesi 1 olan bir istasyon ise en üstüne yakın bir fiyattan satar.", false],
		[1, "", "Ekipman, istasyonun dükkân fiyatından beşte bir eksiğine geri satılır. Daha önce sahip olunmuş parçalar da beşte bir daha ucuza satılır. Ambar içeriğini artık alamayacaksa bir kargo modülü satılamaz.", false],
		[1, "", "İki istasyon özeldir. [[station/28]] her ekipmanı, [[station/81]] ise her gövdeyi satar; ama hiçbir kalkan ya da zırh bu iki derinliğe de güvenle ulaşmaz.", false],
		[1, "Onarım", "Onarım faturası yoktur. Gemi bir istasyondan her ayrıldığında gövde, kalkan ve zırh tamamen yenilenir.", false],
		[1, "Gemi satın almak", "Gemi satıcısı en fazla üç gövde sunar; daha büyük gövdeler ancak hikâye ilerledikçe çıkar. Bir istasyonun teknoloji seviyesi, gövdenin fiyatından o kadar yüzde düşer. Mevcut geminiz liste fiyatının beşte dördü karşılığında takasa verilir.", false],
		[1, "", "Tüm ekipman ve kargo yeni gövdeye geçer; bu yüzden yeni gövdede onlar için yeterli yuva ve ambar alanı olmalıdır. Asi tersaneleri her gövdeyi yükseltilmiş sürümüyle satar. [[ship/10]] gemisinin liste fiyatı çok yüksektir, ama tüm madalyalar kazanıldığında 50.000 krediye satılır; bkz. [[guide/medals]].", false],
	],
	"guide/help": [
		[1, "", "Denizaltı klavye ve fareyle, bir kumandayla ya da dokunmatik ekranla yönetilebilir ve bu üç yöntem bir arada kullanılabilir. Aşağıdaki tuşlar varsayılanlardır; her seyir tuşu Ayarlar › Kontroller › Tuş atamaları altından değiştirilebilir, Ayarlar › Kontroller › Kontrol başvurusu ise geçerli düzeni her an gösterir.", false],
		[1, "Klavye ve fare", "Fareyi hareket ettirmek gemiyi döndürür ve burnunu yukarı aşağı eğer; kamera da onu izler. W ve S gazı her basışta dörtte bir artırır ve azaltır; A ve D gemiyi yana kaydırır (ya da manevra ayarı öyle belirlenmişse döndürür), ok tuşları ise burnu yukarı ve aşağı eğer. Rotayı değiştirmeden fareyle etrafa bakmak için Alt ya da Ctrl tuşunu basılı tutun.", false],
		[1, "", "Sol fare tuşu: silahlarla ateş.", true],
		[1, "", "Sağ fare tuşu: zıpkın atışı.", true],
		[1, "", "Space: seçili silah grubuyla ateş; Tab savaş ve balıkçılık grupları arasında geçiş yapar.", true],
		[1, "", "Q: otomatik ateşi açar ya da kapatır.", true],
		[1, "", "Shift: takılı bir turbo varsa turbo.", true],
		[1, "", "E: öndeki istasyona yanaşma ya da bir kapıda [[world/stream|S.T.R.E.A.M.]]'e giriş.", true],
		[1, "", "R: kısa basış otopilot menüsünü açar, basılı tutmak ise doğrudan güncel hedefe yöneltir.", true],
		[1, "", "T: zamanı hızlandırır; otopilot gemiyi yönetirken ve yakında tehlike yokken daha hızlı kademeler sunulur.", true],
		[1, "", "M: harita. C: kamera değiştirme. L: farlar (Gelişmiş aydınlatma ayarıyla).", true],
		[1, "", "Esc: duraklatır ya da herhangi bir menüden geri döner. F5 yanaşmışken kaydeder; F11 tam ekranı açıp kapatır.", true],
		[1, "", "Ayarlar › Kontroller › Manevra altında fare tekerleği gazı kademe kademe değiştirecek şekilde ayarlanabilir; bu durumda S gemiyi anında durdurur.", false],
		[1, "Kumanda", "Varsayılan olarak iki çubuk da yön verir: sol çubuk gemiyi yana kaydırır ya da döndürür ve burnunu eğer, sağ çubuk döndürür ve burnu eğer. Her çubuk eksenine gaz ya da kamera dahil başka bir görev Ayarlar › Kontroller › Kumanda altından verilebilir; yunuslamayı ters çevirme, titreşim ve ölü bölge de orada ayarlanır.", false],
		[1, "", "D-pad yukarı ve aşağı: gaz. A: seçili silah grubuyla ateş. RT: silahlar. LT: zıpkın. Sol çubuğa basma: turbo.", true],
		[1, "", "X: silah grubunu değiştirme. Y: yanaşma ya da S.T.R.E.A.M.'e giriş. LB: otopilot menüsü. RB: zamanı hızlandırma.", true],
		[1, "", "View: harita. D-pad sol: kısa basış kamerayı değiştirir, basılı tutunca sağ çubukla etrafa bakılır. D-pad sağ: farlar.", true],
		[1, "", "Start ya da B: duraklatma. Menülerde A seçer, B geri döner.", true],
		[1, "Dokunmatik", "Dokunmatik kontroller ekrana dokunulunca kendiliğinden açılır; Ayarlar › Kontroller › Dokunmatik kontroller altından açılıp kapatılabilir de. Sol başparmağın altında bir yönlendirme çubuğu belirir; ekranın başka herhangi bir yerinde sürüklemek etrafa bakmayı sağlar. Büyük SILAHLAR düğmesi basılı tutulduğu sürece ateş eder ve kenarında gaz yayı bulunur: hızı ayarlamak için parmağınızı yay boyunca kaydırın. Ayarlar › Kontroller › Dokunmatik kontroller › Gaz ile bunun yerine düğmenin üstünde ayrı dikey bir kaydırıcı kullanılabilir. KANCA zıpkın atar, TURBO turboyu çalıştırır, yanaşmak mümkün olduğunda da YANAŞ düğmesi yanıp söner. Otomatik ateş için SILAHLAR ya da KANCA düğmesine çift dokunun, durdurmak için yeniden dokunun.", false],
		[1, "", "ZAMAN, ROTA (otopilot), HARITA ve DURAKLAT düğmeleri ekranın kenarlarında yer alır; kamera ve tam ekran duraklatma menüsündedir. Her düğme Kontrol yerleşimini ayarla seçeneğiyle taşınıp yeniden boyutlandırılabilir; gemi cihazı eğerek de yönlendirilebilir.", false],
		[1, "İstasyon ekranları", "Yanaşmak oyunu otomatik olarak kaydeder ve istasyonun ana ekranını açar; bu ekran istasyonun kolonistlere mi asilere mi ait olduğunu, teknoloji seviyesini ve pilotun kredisini gösterir. Ok tuşları ya da D-pad düğmeler arasında gezinir, Enter ya da A seçileni açar, Esc ya da B geri döner. AYRIL gemiyi yeniden suya çıkarır.", false],
		[1, "", "Hangar: ekipman dükkânı (satın alıp takma ya da takılı olanı satma), her gövdenin döndürülebilir modelini ve mevcut geminin takas fiyatını gösteren gemi satıcısı, asi istasyonlarında mal üretmek için atölye ve geminin ve kargosunun genel görünümü. Bkz. [[guide/fitting]].", true],
		[1, "", "Görevler: güncel hedefler ve günlük, açıldıktan sonra da sözleşmelerin yer aldığı iş panosu. Bir sözleşme depozito gerektirir; sözleşmeden vazgeçilirse depozito kaybedilir. Bkz. [[guide/contracts]].", true],
		[1, "", "Harita: arama, yandan derinlik görünümü ve otopilotu ayarlamaya ya da bir S.T.R.E.A.M. aktarımı planlamaya yarayan düğmelerle istasyon haritası. Bkz. [[guide/navigation]].", true],
		[1, "", "Ticaret: mal alıp satma; yalnızca asi istasyonları ticaret yapar. Bkz. [[guide/trading]].", true],
		[1, "", "Durum: gemi, pilotun istatistikleri ve madalyalar. Bkz. [[guide/medals]].", true],
		[1, "", "Sistem: üç kayıt yuvası, ayarlar, yardım, bu başvuru kaynağı, kayıt aktarımı, istasyon kontrol noktasını yükleme ve ana menü.", true],
	],
	"guide/medals": [
		[1, "Madalya kazanmak", "Madalyalar pilotun başarılarını kaydeder. Çoğu bronz, gümüş ve altın derecelerinde verilir; geri kalanlar tek seferlik ödüllerdir. İlerleme gemi her yanaştığında denetlenir ve yeni madalyalar istasyonda duyurulur. Kazanılan bir madalya asla kaybedilmez; daha iyi bir derece daha düşük olanın yerini alır. Durum altındaki profiliniz şimdiye kadar kazanılan madalyaları gösterir.", false],
		[1, "Kariyer madalyaları", "Bunlar tüm kariyer boyunca sayılır (bronz, gümüş, altın):", false],
		[1, "", "[[medal/4]]: yok edilen düşmanlar; 50, 200 ve 400.", true],
		[1, "", "[[medal/5]]: yakalanan canlılar; 50, 150 ve 300.", true],
		[1, "", "[[medal/6]]: yanaşılan istasyonlar; 50, 100 ve 200.", true],
		[1, "", "[[medal/8]]: üretilen mallar; 50, 250 ve 500.", true],
		[1, "", "[[medal/12]]: tamamlanan sözleşmeler; 10, 25 ve 50.", true],
		[1, "", "[[medal/13]]: yeni bir istasyon bölgesine varışlar; 50, 150 ve 300.", true],
		[1, "", "[[medal/14]]: yok edilen korsanlar; 25, 150 ve 350.", true],
		[1, "", "[[medal/18]]: kurtarılan enkazlar; 25, 150 ve 350.", true],
		[1, "", "[[medal/19]]: aynı anda sahip olunan kredi; 125.000, 500.000 ve 1.000.000.", true],
		[1, "", "[[medal/20]]: satın alınan yeni ekipman parçaları; 5, 10 ve 20.", true],
		[1, "", "[[medal/11]]: oynanan saat; 5, 7 ve 10.", true],
		[1, "", "[[medal/21]]: ulaşılan en yüksek nokta; 15.000, 12.000 ve 10.000 m.", true],
		[1, "Tek yolculuk madalyaları", "Bunlar bir istasyondan ayrılıştan sonrakine yanaşmaya kadar tek bir yolculuğu değerlendirir:", false],
		[1, "", "[[medal/9]]: tek yolculukta öldürmeler; 5, 10 ve 15.", true],
		[1, "", "[[medal/10]]: tek yolculukta avlar; 5, 10 ve 15.", true],
		[1, "", "[[medal/1]]: gövde %30, %15 ve %5'in altındayken yanaşmak.", true],
		[1, "", "[[medal/16]]: yanaşırken takılı silahlar; 3, 5 ve 8.", true],
		[1, "", "[[medal/15]]: hiç silah takılı değilken yanaşmak. Açılış bölümleri sayılmaz.", true],
		[1, "Ödüller", "[[medal/0]] koloniye varışta verilir.", true],
		[1, "", "[[medal/3]] ve [[medal/2]]: her balık türünü ve her alg türünü en az bir kez yakalayın.", true],
		[1, "", "[[medal/7]]: her ürünü en az bir kez yapın.", true],
		[1, "", "[[medal/17]]: hikâyeyi tamamlayın.", true],
		[1, "", "İki madalya daha vardır. Biri 30.000, 32.000 ve 35.000 m'nin altına dalışları ödüllendirir. Diğeri diğer tüm madalyalara sahip olmak için verilir; bu tam set [[ship/10]] gemisinin fiyatını da 50.000 krediye düşürür. Bkz. [[guide/depth]] ve [[guide/fitting]].", false],
	],
	"guide/navigation": [
		[1, "Harita", "İki yüz istasyon kare bir harita üzerinde yer alır. Bu ansiklopedideki [[chart]] her istasyonu sahibinin renginde gösterir. Oyunda istasyonun Harita hizmeti ve denizdeki harita aynı haritayı; son rotanızı, görev hedeflerini ve S.T.R.E.A.M. menzilindeki istasyonları da ekleyerek gösterir. Her istasyon sayfası en yakın komşularını harita mesafeleri ve derinlikleriyle listeler.", false],
		[1, "Otopilot", "Otopilot gemiyi sizin yerinize yönetir. Listesinde güncel hedef, yerel istasyona yanaşma, yerel S.T.R.E.A.M. kapısı ya da haritada seçilen herhangi bir istasyon bulunur. Uzun mesafelerde açık sularda seyreder, yolundaki istasyonların çevresinden dolaşır ve bir istasyonun bölgesinden sonrakine geçer.", false],
		[1, "", "Herhangi bir dümen, gaz, turbo ya da silah girdisi, tıpkı otopilot listesindeki Otopilotu kapat seçeneği gibi, kontrolü size geri verir. Otomatik ateşi açmak da otopilotu sonlandırır.", false],
		[1, "", "Zaman hızlandırma elle kontrolde 1× ya da 2×, otopilotta ise 16× değerine kadar çalışır. Tehlike onu 2× değerine düşürür: yaklaşık 550 m içinde bir düşman gemisi, zıpkındaki bir av ya da güvenli derinlik aralığından çıkmak. Yeni bir istasyonun bölgesine girildiğinde de 1× değerine döner.", false],
		[1, "S.T.R.E.A.M. kapıları", "Her istasyonun biraz uzağında bir S.T.R.E.A.M. kapısı vardır. Kapının etkinleştirme alanına girin ve menzildeki tüm istasyonları listeleyen kapı haritasını açmak için Yanaş komutunu kullanın. Birini seçip geçişi başlatın. Kapı açılır ve gemi, hasarı değişmeden hedef istasyonun kapısından çıkar.", false],
		[1, "", "Bir kapı, bulunduğunuz istasyondan haritanın genişliğinin yaklaşık altıda biri kadar uzağa ulaşır. Motor bu mesafeyi kendi derecesi kadar artırır: +%30 dereceli bir motor %30 daha uzağa ulaşır. Menzil dışındaki istasyonlara birkaç atlamayla ya da otopilotla uzun bir seyirle gidilir.", false],
		[1, "", "Bölgedeki bir görev karşılaşması bitmemişken ne kapı ne de istasyonun rıhtımı kullanılabilir.", false],
		[1, "Varış", "Bir istasyonun bölgesine girmek, orada bekleyen görev karşılaşmasını başlatır. Otopilottaki hedef seçeneği karşılaşmanın yol noktalarına götürür; karşılaşma çözülünce yanaşma kilidi açılır. Bkz. [[guide/contracts]].", false],
		[1, "", "Bunun dışında bir istasyonun çevresindeki sularda yerel yaban hayatı ve devriye gemileri bulunur. [[chapter/12|12. bölümden]] itibaren birkaç korsan pusuda bekliyor olabilir; hikâye ilerledikçe bu daha sık olur. Bkz. [[guide/combat]].", false],
		[1, "", "Yeni bir istasyonun bölgesine her varış [[medal/13]] için, ilk kez yanaşılan her istasyon da [[medal/6]] için sayılır.", false],
	],
	"guide/tips": [
		[1, "", "Seyir, savaş ve kazanç için bu başvuru kaynağında toplanmış kısa öneriler.", false],
		[1, "Yolda", "Otopilot tuşunu (R) basılı tutmak gemiyi doğrudan güncel hedefe götürür; kısa basış ise en yakın S.T.R.E.A.M. kapısı ya da haritada seçilen bir istasyon gibi başka varış noktaları sunar.", true],
		[1, "", "Yakında düşman olmadığı sürece, otopilot gemiyi yönetirken zaman elle kontrole göre çok daha fazla hızlandırılabilir.", true],
		[1, "", "Herhangi bir yönlendirme, gaz ya da silah girdisi kontrolü otopilottan geri alır.", true],
		[1, "", "Turbo yalnızca takılı bir turboyla çalışır ve her kullanımdan sonra yeniden dolması için zaman gerekir.", true],
		[1, "", "Harita, gövdenin derinlik sınırları dışındaki istasyonları işaretler; daha güçlü bir gövde ya da kalkan bu istasyonlara erişimi açar. Bkz. [[guide/depth]].", true],
		[1, "", "Serbest bakış (fareyle birlikte Alt ya da Ctrl veya D-pad solu basılı tutmak) rotayı değiştirmeden geminin arkasına bakmayı sağlar.", true],
		[1, "Savaş ve balıkçılık", "Silahlar ve zıpkın ayrı düğmelerle ateşlenir; böylece çatışmanın ortasında bir balık zıpkınlanabilir.", true],
		[1, "", "Otomatik ateş, iki el de yönlendirmeyle meşgulken seçili silahların ateşini sürdürür; bir menü açılınca durur.", true],
		[1, "", "Duraklatma menüsündeki Aksiyonu dondur seçeneği sahneyi durdurur, böylece kamera sahnenin çevresinde serbestçe gezdirilebilir.", true],
		[1, "Ticaret ve para", "Pazar ya da atölye yalnızca asi istasyonlarında bulunur; kolonist istasyonları yine de ekipman satar.", true],
		[1, "", "Atölye kargoyu ürüne dönüştürür; bütün bir ambar dolusu üretmeden önce tarifin fiyat aralığını pazarla karşılaştırın.", true],
		[1, "", "Yeni bir gemi göründüğünden ucuzdur: mevcut gemi takasa alınır.", true],
		[1, "", "Sözleşmeden vazgeçilirse depozito kaybedilir; bu yüzden önce derinliğini ve mesafesini kontrol edin.", true],
		[1, "Kayıt", "Yanaşmak oyunu otomatik olarak kaydeder, Sistem ekranında ise üç yuva daha vardır. F5 yanaşmışken kaydeder.", true],
		[1, "", "Bir dalış kötü giderse İstasyon kontrol noktasını yükle seçeneği son yanaşmaya geri döndürür.", true],
		[1, "", "Farlar için Gelişmiş aydınlatma ayarı gerekir; bu ayar açıkken L farları açıp kapatır.", true],
	],
	"guide/trading": [
		[1, "Ticaret nerede yapılır", "Yalnızca [[faction/rebels|asi]] istasyonlarında pazar ve atölye bulunur. [[faction/colonists|Kolonist]] istasyonları varışta ambarın tamamını, her kalemi taban fiyatından satın alır ve hiçbir şey satmaz. Hikâyenin başında her istasyon kolonisttir; bu yüzden pazarlar açılana dek tek gelir sabit fiyatlı avcılıktır. Bkz. [[guide/allegiance]].", false],
		[1, "Fiyatlar", "Her malın bir fiyat aralığı, bir ana istasyonu ve bir en iyi pazarı vardır; hepsi malın sayfasında gösterilir. Mal, ana istasyonunda taban fiyatından satılır. Bir istasyon haritada ana istasyondan ne kadar uzaksa fiyat o kadar yüksektir; en iyi pazarın uzaklığında ve ötesinde tavan fiyata ulaşır.", false],
		[1, "", "Üç ithal mal tersine çalışır: [[goods/33]], [[goods/34]] ve [[goods/35]] en iyi pazarlarında en ucuzdur ve uzaklaştıkça pahalanır. Asi pazarları bunları ziyaretler arasında yeniden stoklar.", false],
		[1, "", "Bir pazar, birer birim olmak üzere, aynı fiyattan alır ve satar. Kâr, tezgâhtan değil, malları istasyonlar arasında taşımaktan gelir.", false],
		[1, "Pazarlar neleri stoklar", "Bir pazar en fazla dört ürün stoklar. Her biri istasyonun teknoloji seviyesi içinde olmalıdır; ürünler ana istasyonlarına yakın yerlerde daha kolay çıkar. Raflar ziyaretler arasında biraz azalır. En son ziyaret edilen üç istasyon stoklarını korur; diğerlerinde döndüğünüzde raflar yeniden belirlenir.", false],
		[1, "Üretim", "Hangardaki atölye ambardaki malzemeleri ürünlere dönüştürür. Bir istasyon kendi teknoloji seviyesine kadar her ürünü yapabilir. Tarif listesi, ambarın her üründen kaç tane yapabileceğini gösterir; her ürün sayfası da malzemelerini listeler. Örneğin bir [[goods/21]] için bir [[species/4]] ve bir [[species/17]] gerekir.", false],
		[1, "", "Mal üretmek [[medal/8]] için sayılır; her ürünü en az bir kez yapmak da [[medal/7]] kazandırır.", false],
		[1, "Kâr etmek", "Para kazanmanın bazı yolları:", false],
		[1, "", "Ürünleri ana istasyonlarında ya da yakınında satın alıp en iyi pazarlarına doğru taşıyın.", true],
		[1, "", "Balık ve alglerin tek maliyeti zamandır. Onları ürüne dönüştürmek, ham satmaktan daha kârlı olabilir.", true],
		[1, "", "Değerli bir ambarla kolonist istasyonuna yanaşmayın: gemideki her şey taban fiyattan alınır.", true],
		[1, "", "Yok edilen gemilerin bıraktığı kargoyu kurtarıp satın.", true],
		[1, "", "[[contract/13]] ve [[contract/14]] sözleşmeleri, bir ürünü ya da avı sözleşmeyi veren istasyona teslim etmek için ödeme yapar.", true],
		[1, "", "Bir istasyonun teknoloji seviyesi, ekipman ve gemi fiyatlarını da düşürür; bkz. [[guide/fitting]].", false],
	],
	"home": [
		[1, "", "Kolonileştirilmiş bir okyanus dünyasında geçen denizaltı macerası DEEP'in ansiklopedisine hoş geldiniz. Burada iki yüz derin deniz istasyonunu, satın alabileceğiniz gemileri ve ekipmanı, sudaki canlıları, pazarlar arasında alınıp satılan malları, sunulan sözleşmeleri ve kazanılabilecek madalyaları bulabilirsiniz.", false],
		[1, "", "Hikâye sayfaları siz oynadıkça açılır. Bölümler, karakterler ve sonraki olaylar kaydınız onlara ulaşana dek gizli kalır; böylece sürpriz bozmadan göz atabilirsiniz. Adlar ve değerler oyunun kendi kopyanızdan gelir; genel bakışlar ve kılavuzlar bu ansiklopedi için yazılmıştır.", false],
		[1, "", "Yeni pilotlar [[world/ocean]] ve [[guide/basics]] ile başlamalıdır. [[chart]] her istasyonu ve onu kimin elinde tuttuğunu gösterir. Kılavuzların her biri, [[guide/depth]] ve [[guide/navigation]] konularından [[guide/trading]] ve [[guide/combat]] konularına kadar, yüzeyin altındaki yaşamın bir yönünü açıklar.", false],
	],
	"intro/characters": [
		[1, "", "Bu sayfalar hikâyenin insanlarını anlatır: pilotu, gemi bilgisayarını, yol boyunca karşılaşılan müttefikleri ve düşmanları ve telsizde duyulan sesleri. Her biyografi seferi sırasıyla izler ve siz oynadıkça büyür; yalnızca pilotunuzun öğrenmiş olduklarını gösterir.", false],
		[1, "", "Bazı konuşmacıların kendi adları yoktur. [[character/6]], [[character/7]] ve [[character/10]] gibi rol adları her grubun pek çok küçük sesini temsil eder; sayfaları bu adlar altında kimlerin konuştuğunu açıklar. Hikâyenin bütünü için bkz. [[world/history]].", false],
	],
	"intro/contracts": [
		[1, "", "Bir istasyonun sunabileceği on beş iş türü. Her sayfa hedefi, hangi tarafın verdiğini, varsa kısıtlamaları ve aynı tür görev üzerine kurulu hikâye bölümlerini belirtir. Depozitolar, ücret ve zorluğun rütbenizle nasıl arttığı için bkz. [[guide/contracts]]. Sözleşmeler [[chapter/9|9. bölümden]] itibaren iş panosunda yer alır.", false],
	],
	"intro/equipment": [
		[1, "", "Bir gemiye takılabilen tüm ekipman: silahlar, torpidolar, zıpkınlar, kalkanlar, zırh, kargo modülleri, motorlar, manevra, radar, turbolar ve onarım sistemleri. Her sayfa parçanın değerlerini, dükkânlarda ne kadar nadir olduğunu, birden fazla takılıp takılamayacağını ve her teknoloji seviyesindeki fiyatını verir. Bkz. [[guide/fitting]] ve [[guide/combat]].", false],
	],
	"intro/factions": [
		[1, "", "Okyanusun güçleri: [[faction/colonists]], [[faction/rebels]] ve [[faction/pirates]]. Her sayfa, grubun ticaret, sözleşmeler ve ödüller gibi oynanışı nasıl etkilediğini açıklar ve güncel bölümünüze kadar istasyonlarını ve hikâyedeki görünümlerini listeler. İstasyonların nasıl taraf değiştirdiği için bkz. [[guide/allegiance]].", false],
	],
	"intro/goods": [
		[1, "", "Bir ambarda taşınabilen her şey: avlar, ürünler, ithal mallar ve kurtarılan kargo. Her sayfa malın teknoloji seviyesini, ana istasyonunu, en iyi pazarını ve fiyat aralığını, tarifini ya da nerede kullanıldığını ve varsa özel kurallarını gösterir. Fiyatların nasıl işlediği ve nasıl kâr edileceği için bkz. [[guide/trading]].", false],
	],
	"intro/guide": [
		[1, "", "DEEP oynamak için pratik kılavuzlar. [[guide/basics]] ile başlayın, ardından şu konuları okuyun: [[guide/depth]], [[guide/navigation]], [[guide/fishing]], [[guide/trading]], [[guide/combat]], [[guide/fitting]], [[guide/contracts]], [[guide/allegiance]] ve [[guide/medals]]. Her kılavuz yüzeyin altındaki yaşamın bir yönünü, oyunun kendi kullandığı değerlerle sade bir dille açıklar ve andığı istasyonlara, ekipmana ve madalyalara bağlantı verir. Hikâye ayrıntıları kaydınız onlara ulaşana dek gizli kalır.", false],
	],
	"intro/medals": [
		[1, "", "Bir pilotun kazanabileceği madalyalar. Her sayfa madalyanın neyi ödüllendirdiğini ve dereceli madalyalarda bronz, gümüş ve altın için neyin gerektiğini anlatır. Madalyaların ne zaman denetlendiği ve hangilerinin tek bir yolculuğu değerlendirdiği için bkz. [[guide/medals]]. Madalyalar her yanaştığınızda denetlenir ve tam set kendine özgü bir ödül getirir.", false],
	],
	"intro/ships": [
		[1, "", "Başlangıçtaki [[ship/0]] gemisinden [[ship/10]] gemisine kadar oyundaki tüm denizaltı gövdeleri. Her sayfa gövde dayanıklılığını, kargo kapasitesini, ekipman yuvalarını, manevrayı ve liste fiyatını, tersanelerin onu ne zaman sunmaya başladığını ve tüm gövdelerin karşılaştırma tablosunu listeler. Gemi satın almak ve eskisini takasa vermek için bkz. [[guide/fitting]].", false],
	],
	"intro/species": [
		[1, "", "Okyanusun canlıları ve algleri. Her sayfa türün kütlesini, dayanıklılığını, zıpkında ne kadar direndiğini, fiyat aralığını ve yaşadığı istasyonları; ayrıca onu kullanan ürünleri ve sözleşmeleri verir. Onları nasıl yakalayacağınız için bkz. [[guide/fishing]].", false],
	],
	"intro/stations": [
		[1, "", "Okyanusun iki yüz istasyonu, alfabetik sırayla. Her sayfa istasyonun teknoloji seviyesini, derinliğini ve haritadaki konumunu, hangi tarafın elinde olduğunu, ona ulaşmak için gereken derinlik ekipmanını, yakında bulunan türleri, ana istasyonu ya da en iyi pazarı olduğu malları, hikâyedeki rolünü ve en yakın komşularını verir. [[chart]] hepsini bir arada gösterir.", false],
	],
	"intro/story": [
		[1, "", "Seferin hikâyesi, pilotun ilk avından itibaren 48 bölüm sürer. Olay örgüsünün perdelere ayrılmış kesintisiz bir anlatımı için [[world/history]] sayfasını okuyun. Bu sayfa siz oynadıkça büyür ve kaydınızın ulaştığı bölümün ötesine asla geçmez.", false],
		[1, "", "Her bölümün ayrıca, görevin özetini ve siz ilerledikten sonra sonucunu veren kendi sayfası vardır. Bir bölümün sonu ancak bir sonraki bölüme ulaştığınızda görünür; bu yüzden bu sayfalar asla oynadığınızdan fazlasını açığa vurmaz.", false],
	],
	"intro/world": [
		[1, "", "DEEP dünyası hakkında arka plan bilgileri. [[world/ocean]] ortamın kendisini anlatır: derinliklerini ve basıncını, ışığını ve yaban hayatını. [[world/colony]], istasyonların nasıl yönetildiğini, ticaretin ve sözleşmelerin nasıl işlediğini ve düzeni kimin sağladığını açıklar. [[world/stream]] istasyonları birbirine bağlayan kapı ağını ele alır; [[world/history]] ise hikâyeyi oynadığınız yere kadar anlatır.", false],
		[1, "", "Bu sayfalar kaydınız ilerledikçe büyür. Sonraki olaylar, yeni karakterler ve derinliklerin sırları ancak onlara ulaştığınızda görünür; hikâye konularını açığa çıkardıkça yeni makaleler de açılır.", false],
	],
	"medal/0": [
		[1, "", "Her pilot bu madalyayı gezegene varışta alır. Hiçbir çaba gerektirmez ve yalnızca kariyerin başlangıcını işaretler.", false],
	],
	"medal/1": [
		[1, "", "Gövdeden çok az şey kalmışken yanaşmak için verilir. Bronz için gövde %30'un, gümüş için %15'in, altın için %5'in altında olmalıdır. Gövde, yanaşma anındaki değeriyle sayılır.", false],
	],
	"medal/10": [
		[1, "", "Ayrılış ile yanaşma arasındaki tek bir çıkışta çok sayıda av yakalamak için verilir. Bronz için 5'ten, gümüş için 10'dan, altın için 15'ten fazlası gerekir. Büyük bir ambar yardımcı olur.", false],
	],
	"medal/11": [
		[1, "", "Mevcut kariyerde oynanan toplam süreyi ödüllendirir. Bronz beş saati, gümüş yedi saati, altın on saati aşınca gelir.", false],
	],
	"medal/12": [
		[1, "", "Pilotun tamamladığı istasyon iş panosu sözleşmelerini sayar. Bronz için 10'dan, gümüş için 25'ten, altın için 50'den fazlası gerekir.", false],
	],
	"medal/13": [
		[1, "", "İstasyonlar arasında S.T.R.E.A.M. ağı üzerinden yapılan yolculukları sayar. Bronz için 50'den, gümüş için 150'den, altın için 300'den fazlası gerekir.", false],
	],
	"medal/14": [
		[1, "", "Kariyer boyunca yok edilen korsanları sayar. Bronz için 25'ten, gümüş için 150'den, altın için 350'den fazlası gerekir.", false],
	],
	"medal/15": [
		[1, "", "Hiç silah ya da torpido takılı değilken bir çıkışı tamamlamak için verilir. Zıpkınlar silah sayılmaz. Eğitim bölümleri geçerli değildir.", false],
	],
	"medal/16": [
		[1, "", "Aynı anda çok sayıda silah ve torpido takılıyken yanaşmak için verilir. Bronz için en az 3, gümüş için en az 5, altın için en az 8 gerekir; bu da bol yuvalı bir gövde ister.", false],
	],
	"medal/17": [
		[1, "", "Ana hikâyeyi tamamlamak için verilir. Başka bir yolla kazanılamaz; bu yüzden genellikle bir pilotun topladığı son madalyalardan biridir.", false],
	],
	"medal/18": [
		[1, "", "Yok edilen gemilerden zıpkınla kurtarılan kargo sandıklarını sayar. Bronz için 25'ten, gümüş için 150'den, altın için 350'den fazlası gerekir.", false],
	],
	"medal/19": [
		[1, "", "Ulaşılan en büyük kredi bakiyesini ödüllendirir. Bronz için 125.000'den, gümüş için 500.000'den, altın için 1.000.000'dan fazlası gerekir.", false],
	],
	"medal/2": [
		[1, "", "Beş alg türünün her birinden en az birini yakalamak için verilir. Algler deniz tabanında hareketsiz durduğundan bu daha kolay ödüllerden biridir.", false],
	],
	"medal/20": [
		[1, "", "Dükkânlardan satın alınan yeni ekipman parçalarını sayar. Bronz için 5'ten, gümüş için 10'dan, altın için 20'den fazlası gerekir.", false],
	],
	"medal/21": [
		[1, "", "Ulaşılan en sığ derinliği ödüllendirir. Bronz için 15.000 m'nin, gümüş için 12.000 m'nin, altın için 10.000 m'nin üstüne çıkmak gerekir. Üst iki derece, tüm kalkanların derecelendirilmiş sınırının ötesindedir.", false],
	],
	"medal/22": [
		[1, "", "En derin dalışı ödüllendirir. Bronz için 30.000 m, gümüş için 32.000 m, altın için 35.000 m gerekir. Üst iki derece, tüm zırhların derecelendirilmiş sınırının ötesindedir.", false],
	],
	"medal/23": [
		[1, "", "Diğer tüm madalyalar herhangi bir derecede kazanıldığında verilir. Bu madalyaya sahip olmak, pilotun [[ship/10]] gemisini liste fiyatının küçük bir kısmına satın almasını sağlar.", false],
	],
	"medal/3": [
		[1, "", "Yüzen her canlı türünden en az birini yakalamak için verilir. Her istasyonun sularında farklı bir tür karışımı vardır; bu yüzden pek çok yerde avlanmak gerekir.", false],
	],
	"medal/4": [
		[1, "", "Kariyer boyunca yok edilen tüm düşmanları sayar. Bronz için 50'den, gümüş için 200'den, altın için 400'den fazlası gerekir.", false],
	],
	"medal/5": [
		[1, "", "Kariyer boyunca zıpkınlanan her canlıyı ya da algi sayar. Bronz için 50'den, gümüş için 150'den, altın için 300'den fazla av gerekir.", false],
	],
	"medal/6": [
		[1, "", "Pek çok farklı istasyona yanaşmak için verilir. Bronz için 50'den, gümüş için 100'den, altın için 200'den fazlası gerekir; bu da pratikte haritadaki her istasyon demektir.", false],
	],
	"medal/7": [
		[1, "", "Pilot her ürünü en az bir kez ürettiğinde verilir. Bazı tarifler ithal mallar ya da başka ürünler gerektirir; bu yüzden tam set planlama ister.", false],
	],
	"medal/8": [
		[1, "", "İstasyon fabrikalarında üretilen tüm malları sayar. Bronz için 50'den, gümüş için 250'den, altın için 500'den fazla birim gerekir.", false],
	],
	"medal/9": [
		[1, "", "Bir istasyondan ayrılıştan sonrakine yanaşmaya kadarki tek bir çıkışta çok sayıda düşman yok etmek için verilir. Bronz için 5'ten, gümüş için 10'dan, altın için 15'ten fazlası gerekir.", false],
	],
	"ship/0": [
		[1, "Genel bakış", "[[ship/0]], her pilotun başladığı gövdedir ve 45.000 cr ile listenin en ucuzudur. Neredeyse her açıdan da en zayıfıdır: 75 gövde puanı, 25 t'luk ambar ve altı ekipman yuvası. 1,10 olan manevra değeri ortalamadır; çok daha büyük olan [[ship/8]] ile aynıdır.", false],
		[1, "", "Gemide [[equipment/15]], [[equipment/18]], [[equipment/22]] ve [[equipment/35]] takılı gelir. Bu da altı yuvadan yalnızca ikisini silahlara ya da bir kargo modülüne bırakır.", false],
		[1, "Kullanımda", "Asıl sınır küçük ambardır. Birkaç orta boy av onu doldurur; ortalama bir [[species/12]] ise taşıyabileceğinden ağırdır. 30.000 cr fazlasına [[ship/1]], aynı yuva sayısıyla 40 gövde puanı fazlası, neredeyse iki katı kargo ve çok daha keskin manevra sunar; bu yüzden çoğu pilot birikimi yeter yetmez başlangıç teknesini değiştirir. O zamana dek bu bir eğitim gövdesidir: ilk av gezileri ve yakın sulardaki hafif korsan çatışmaları için yeterlidir, ama uzun ticaret seferleri ya da ağır çatışmalar için değil.", false],
	],
	"ship/1": [
		[1, "Genel bakış", "[[ship/1]], sağlam ve uygun fiyatlı bir balıkçı teknesidir. [[ship/0]] ile karşılaştırıldığında 40 gövde puanı, 20 t kargo ve çok daha çevik bir kullanım kazanır: 1,61 olan manevra değeri yalnızca [[ship/5]] gemisinin ardından gelir. Ancak aynı altı yuvayı korur ve gövdeyi tanımlayan da bu tavandır. Zıpkın, kalkan, zırh ve radar, yalnızca iki silah ya da kargo modülüne yer bırakır.", false],
		[1, "Kullanımda", "Sıradan tersaneler onu ilk bölümden itibaren 75.000 cr'ye satar; bu da onu çoğunlukla avlanan ve kısa işler yapan bir pilot için doğal ilk yükseltme yapar. Gövde, kargo ve manevrada daha pahalı olan [[ship/2]] gemisini bile geride bırakır, yalnızca bir yuva eksiği vardır. Görevler daha fazla ateş gücü ya da daha büyük bir ambar gerektirdiğinde sonraki gövdelerin yedinci ve sekizinci yuvaları ham dayanıklılıktan daha önemli hâle gelir ve Okeanos genellikle takasa verilir.", false],
	],
	"ship/10": [
		[1, "Genel bakış", "[[ship/10]], lüks amiral gemisi ve en iyi çok yönlü gövdedir. 200 gövde puanı, 100 t'luk ambar, on yuva ve 1,50 manevrayı bir araya getirir. Gövde ya da kargoda onu yalnızca [[ship/6]] geçer; yalnızca [[ship/5]], [[ship/1]] ve [[ship/3]] daha hızlı döner. 5.000.000 cr olan liste fiyatı, [[ship/9]] gemisininkinin on dört katından fazladır.", false],
		[1, "Kullanımda", "Sıradan tersaneler onu [[chapter/40]] sonrasında sunar. Liste fiyatını ödeyebilecek pilot azdır. Tüm madalyalara sahip olan ve böylece [[medal/23]] madalyasını tamamlayan bir pilot ise onu, istasyonun teknoloji seviyesine göre yapılan olağan indirimden önce, 50.000 cr'ye satın alabilir. Bu da Aquarius'u pratik bir alımdan çok madalya koleksiyonunu tamamlamanın ödülü yapar. Gemi satışa çıktığında seferin büyük kısmı çoktan geride kalmıştır.", false],
	],
	"ship/2": [
		[1, "Genel bakış", "[[ship/2]], 100.000 cr ile yedi ekipman yuvalı en ucuz gövdedir. Gövde ve kargo değerleri (100 puan ve 40 t) aslında [[ship/1]] gemisininkinden düşüktür; 1,40 olan manevrası da üstün değil, iyidir. Fazladan verilen para yedinci yuvayı satın alır; bu yuvaya ikinci bir silah ya da bir kargo modülü takılabilir.", false],
		[1, "Kullanımda", "İlk bölümden itibaren satıştadır; bu yüzden erken birikim yapan bir pilot, daha iyisi çıkmadan çok önce yedi yuvaya geçebilir. Ancak [[chapter/5]] sonrasında [[ship/3]], yalnızca 5.000 cr fazlasına aynı gövde ve yuva sayısını, 6 t fazla kargo ve daha iyi manevrayla sunar. O noktadan sonra Triops, ancak yakınlarda satışta olup alternatifi olmadığında almaya değer. Boş yuva ikinci bir silah alabildiğinden korsanlarla erken savaşmak isteyen bir pilota uyar.", false],
	],
	"ship/3": [
		[1, "Genel bakış", "[[ship/3]], [[ship/2]] gemisinin yedi yuvalı düzenini geliştirir. Yalnızca 5.000 cr fazlasına 6 t ambar alanı ekler ve manevrayı 1,40'tan 1,57'ye çıkarır; bu da onu oyundaki en çevik gövdelerden biri yapar. 100 gövde puanı sıradandır, bu yüzden korumanın çoğunu kalkan ve zırh üstlenir.", false],
		[1, "Kullanımda", "Sıradan tersaneler onu [[chapter/5]] sonrasında stoklamaya başlar. Büyük bir harcama yapmadan aynı tekneyle hem savaşmak hem avlanmak isteyen bir pilota uyar ve sekiz yuvalı gövdeler gelene dek mantıklı bir seçim olarak kalır. Sonra çıkan gövde [[ship/4]] ile karşılaştırıldığında, çok daha hızlı dönüşler ve 25.000 cr daha düşük fiyat karşılığında 75 gövde puanı ve 24 t kargodan vazgeçer.", false],
	],
	"ship/4": [
		[1, "Genel bakış", "[[ship/4]], minyatür bir ağır yük gemisidir. 130.000 cr'ye 175 gövde puanı, 70 t'luk ambar ve sekiz yuva getirir; bu da onu en ucuz sekiz yuvalı gövde yapar. Bedeli kullanımdır: 0,91 olan manevra değeri önceki tüm gemilerinkinden düşüktür ve yalnızca [[ship/6]] daha yavaş döner.", false],
		[1, "Kullanımda", "Sıradan tersanelerde [[chapter/10]] sonrasında görünür. En çok tüccarlar ve balıkçılar kazanır. Büyük temel ambarı kargo modüllerini de daha etkili kılar, çünkü modüllerin katkısı temel kapasitenin bir yüzdesidir. Bir manevra modülü hantallığın bir kısmını giderir. Çoğunlukla savaşan pilotlar, 20.000 cr daha pahalı olan, tam iki kat hızlı dönen ama gövde dayanıklılığı ancak yarısı kadar olan [[ship/5]] gemisini tercih edebilir.", false],
	],
	"ship/5": [
		[1, "Genel bakış", "[[ship/5]] bir it dalaşı gemisidir. 1,82 olan manevra değeri tüm gövdeler arasında en iyisidir; bu da rakibin arkasında kalıp hedefi nişangâhta tutmayı sağlar. Ancak koruması zayıftır: 90 puanlık gövdesi [[ship/1]] gemisininkinden zayıftır ve 40 t'luk ambarı mütevazıdır. Sekiz yuva silahlara bolca yer bırakır.", false],
		[1, "Kullanımda", "Sıradan tersaneler onu [[chapter/15]] sonrasında 150.000 cr'ye stoklar. İsabet almaktan kaçınabilen, ideal olarak güçlü bir kalkan ve zırhla desteklenen pilotları ödüllendirir; mal taşımak için ise kötü bir seçimdir. Takılı tüm silahlar birlikte ateş ettiğinden boş yuvalar doğrudan ateş gücüne dönüşür. Daha sağlam bir sekiz yuvalı gövde isteyen bir pilot onu [[ship/4]] ile karşılaştırmalı ya da [[ship/6]] gemisini beklemelidir.", false],
	],
	"ship/6": [
		[1, "Genel bakış", "[[ship/6]], büyük dökme yük gemisidir. 180 t'luk ambarı diğer tüm gövdelerin çok ötesindedir, [[ship/10]] gemisininkinin neredeyse iki katıdır; 220 gövde puanı da oyundaki en yüksek değerdir. 170.000 cr ile [[ship/7]] ve sonraki tüm gövdelerden de ucuzdur. Dezavantajı kullanımdır: 0,67 manevra değeriyle diğer tüm gemilerden daha yavaş döner.", false],
		[1, "Kullanımda", "Sıradan tersanelere [[chapter/20]] sonrasında girer. Ticaret ve büyük av gezileri için rakipsizdir. Kargo modülleri temel kapasite üzerinden çalışır; bu yüzden tek bir +%80 modül 144 t ekler. Savaşta hasardan kaçınmaktan çok hasarı emmeye dayanır ve çevik korsanlara karşı bir manevra modülü neredeyse zorunludur. Yalnızca sekiz yuvası olduğundan, ardından gelen gövdelere göre silahlara daha az yer ayırır.", false],
	],
	"ship/7": [
		[1, "Genel bakış", "[[ship/7]], dokuz yuvalı ilk gövdedir. Diğer değerleri ortalamadır: 135 gövde puanı, 50 t'luk ambar ve 1,23 manevra; bu değer [[ship/0]] gemisini geçer ama [[ship/5]] gemisinin çok gerisinde kalır. 215.000 cr ile [[ship/6]] gemisinden epey pahalıdır; fiyatın çoğu fazladan yuvanın karşılığıdır.", false],
		[1, "Kullanımda", "Sıradan tersanelerde [[chapter/25]] sonrasında görünür. Sekiz yuvalı bir gövdenin izin verdiğinden bir silah ya da modül fazlası isteyen, ama ardından gelen on yuvalı gemilere para vermek istemeyen bir pilota uyar. Çok yönlü bir gemi olarak sağlamdır, ama hiçbir alanda öne çıkmaz. Beş bölüm sonra gelen [[ship/8]], 85.000 cr fazlasına onuncu bir yuva, 15 gövde puanı ve 16 t kargo ekler.", false],
	],
	"ship/8": [
		[1, "Genel bakış", "[[ship/8]], on yuvalı ilk gövdedir. 150 gövde puanı ve 66 t'luk ambar taşır; 1,10 değeriyle [[ship/0]] gibi manevra yapar. 300.000 cr ile [[ship/7]] gemisinden 85.000 cr pahalıdır; karşılığında bir yuva fazlası ve gövde ile kargoda mütevazı kazanımlar sunar.", false],
		[1, "Kullanımda", "Sıradan tersaneler onu [[chapter/30]] sonrasında listeler. On yuvayla bir pilot tam bir savunma takımı, bir zıpkın ve bir radar takıp yine de birkaç silah ya da bir kargo modülü ekleyebilir. Kullanımı yalnızca ortalamadır; bu yüzden yakın çatışmalarda bir manevra modülü yardımcı olur. Beş bölüm sonra gelen [[ship/9]], 15 gövde puanı fazlası ve daha iyi manevra karşılığında 6 t ambardan vazgeçer. Pontos ikisinin daha ucuzu olarak kalır ve kargonun önemli olduğu durumlarda daha iyi bir seçimdir.", false],
	],
	"ship/9": [
		[1, "Genel bakış", "[[ship/9]], üst sınıf bir on yuvalı gövdedir. [[ship/8]] ile karşılaştırıldığında 15 gövde puanı ve belirgin biçimde daha keskin manevra (1,10'a karşı 1,36) ekler, ama 6 t kargo kaybeder. 350.000 cr ile 50.000 cr daha pahalıdır.", false],
		[1, "Kullanımda", "Sıradan tersaneler onu [[chapter/35]] sonrasında stoklar. En çok, seferin sonlarında on yuva ve iyi kullanımdan ambar alanından daha çok yarar sağlayan, savaş odaklı bir pilota uyar. Dökme ticaret için [[ship/6]], yarı fiyatına üç kat fazla taşır. Lir'i çoğu açıdan geride bırakan tek gövde, liste fiyatı bambaşka bir düzeyde olan [[ship/10]] gemisidir.", false],
	],
	"species/0": [
		[1, "Genel bakış", "[[species/0]], tropikal Hint-Pasifik'in kabuklu kafadanbacaklıları olan nautiluslardan esinlenmiştir. Nautilus, sarmal bir kabuğun dış odasında yaşar ve iç odalardaki gaz ile sıvıyı ayarlayarak yüzerliğini denetler. Jet itkisiyle yüzer ve vantuzsuz onlarca dokunaçla besin yakalar. Nautiluslar genellikle birkaç yüz metre derinlikte kalır; yaklaşık 800 m'nin çok altına inerlerse kabukları içe çökebilir.", false],
		[1, "Oyunda", "Oyunda yaklaşık 8 t ağırlığındadır ve zıpkında neredeyse hiç direnmez: halatın onu etkisiz bırakması yalnızca 2,1 sn sürer. Bu da onu en kolay avlardan biri yapar, ama ton başına 44 ile 156 cr arasındaki fiyatı düşüktür. 67 istasyonun sularında yaşar.", false],
		[7, "", "[[chapter/7]] içinde pilot, bu hayvanları yakalayarak ya da öldürerek [[station/1]] istasyonu çevresindeki sulardan temizlemelidir.", false],
	],
	"species/1": [
		[1, "Genel bakış", "[[species/1]], adını yaklaşık 500 ile 3.000 m arasında bulunan bir derin deniz balığı olan Eurypharynx pelecanoides'ten alır. Gevşek eklemli ağzı, ince ve kamçı benzeri gövdesine göre devasadır ve beklenenden çok daha büyük avları yutacak kadar açılabilir. Kuyruğu küçük bir ışık organıyla biter. Yetişkinler genellikle bir metrenin epey altındadır.", false],
		[1, "Oyunda", "Oyunda hızlı bir yüzücüdür ve zıpkına yaklaşık 4 sn direnir; bu, aynı 8 t kütledeki bir [[species/0]] canlısının iki katıdır. Emek karşılığını verir: ton başına 70 ile 255 cr ile daha iyi fiyatlı avlardan biridir. Fabrikalar onu, ikisi de değerli ürünler olan [[goods/24]] ve [[goods/27]] için kullanır. Güçlü yavaşlatmalı bir zıpkın onu yakalamayı çok kolaylaştırır.", false],
	],
	"species/10": [
		[1, "Genel bakış", "[[species/10]], saniyenin bir kesrinde renk değiştirmeleriyle ünlü kafadanbacaklılar olan kalamar ve ahtapotlardan esinlenir. Derilerinde, her biri minik kaslarla açılıp kapanan, kromatofor adlı binlerce pigment hücresi ve parıltı katan yansıtıcı hücreler bulunur. Pek çoğunda mürekkep kesesi de vardır; bir zamanlar mürekkep balığının mürekkebi, kahverengi sepya pigmentinin kaynağıydı.", false],
		[1, "Oyunda", "Oyunda yaklaşık 14 t ağırlığındadır, dayanıklılığı 28'dir ve halatta yaklaşık 3,4 sn çırpınır. Ham fiyatlar ton başına 59 ile 164 cr arasındadır. Çözücüyle birleştirildiğinde, [[goods/29]] için gereken [[goods/22]] ürününü verir.", false],
		[19, "", "[[chapter/19]] içinde pilot, [[station/7]] yakınında bu canlılardan oluşan bir sürüyü saldıran gemilerden korumalıdır.", false],
	],
	"species/11": [
		[1, "Genel bakış", "\"Zırhlı\", koruyucu plakalarla kaplı anlamına gelir; [[species/11]] ise deniz kaplumbağalarını anımsatır. Bugün yedi tür yaşar. Kabukları, omurgaya ve kaburgalara kaynaşmış kemik plakalardan oluşur. En büyüğü, kabuğu yaklaşık 2 m'ye varan deri sırtlı kaplumbağadır; denizanası aramak için 1.000 m'nin altına dalabilir. Dişiler yumurtlamak için kumsallara döner.", false],
		[1, "Oyunda", "Oyunda yaklaşık 8 t ağırlığındadır ve zıpkında yaklaşık 2,7 sn sonra pes eder. Fiyatı alışılmadık ölçüde değişkendir, ton başına 40 ile 244 cr arası; bu yüzden talebin yüksek olduğu yerde satmak kazançlıdır. Hiçbir fabrika tarifi onu kullanmaz.", false],
	],
	"species/12": [
		[1, "Genel bakış", "[[species/12]], ispermeçet balinaları, yunuslar ve mutur balıklarını içeren dişli balinalara dayanır. Avlarını ekolokasyonla bulurlar: tıklama sesleri gönderip yankılarını dinlerler. İspermeçet balinası, Dünya'daki en büyük dişli yırtıcıdır. Kalamar avlamak için 1.000 m ya da daha derine dalar ve bir saatten uzun süre su altında kalabilir.", false],
		[1, "Oyunda", "Oyunda yaklaşık 30 t ile en ağır canlıdır ve dayanıklılığı 60'tır. Tek bir av küçük bir ambarı doldurabilir; ortalama bir örnek [[ship/0]] gemisinin 25 t'luk ambarına sığmaz. Yalnızca yaklaşık 2,9 sn direnir. Fiyatlar ton başına 22 ile 200 cr arasında geniş bir aralıktadır ve hiçbir tarif onu kullanmaz.", false],
	],
	"species/13": [
		[1, "Genel bakış", "[[species/13]], altın algleri (Chrysophyceae) ve ilgili altın-kahverengi grupları anımsatır. Renklerini, klorofillerini örten fukoksantin pigmentinden alırlar. Çoğu mikroskobiktir ve tatlı suda yaşar; bazıları aşırı çoğalma oluşturur. Bir tür olan Prymnesium parvum, balıkları öldürebilen toksinler salar.", false],
		[1, "Oyunda", "Oyunda, her alg gibi, deniz tabanına kök salmıştır, sabit 2 t ağırlığındadır ve 2,1 sn içinde etkisiz kalır. Beş algin en değerlisidir; ton başına 27 ile 65 cr'ye satılır. [[goods/27]] ve [[goods/28]] yapımında kullanılır.", false],
	],
	"species/14": [
		[1, "Genel bakış", "[[species/14]], mavi-yeşil algleri, yani siyanobakterileri anımsatır. Aslında alg değil, fotosentez yapan bakterilerdir. Bilinen en eski yaşam biçimleri arasındadırlar ve Dünya atmosferini oksijenle doldurmaya yardım etmişlerdir. Bazıları havadaki azotu bağlar, bazıları da hidrojen salabilir; araştırmacıların onları temiz yakıt kaynağı olarak incelemesinin nedeni budur.", false],
		[1, "Oyunda", "Oyunda deniz tabanında yetişir, 2 t ağırlığındadır ve pek az direnir. Ton başına 21 ile 47 cr'ye satılır. Yerinde bir seçimle, [[goods/19]] yapmak için [[goods/18]] ile birleştirilir; ayrıca [[goods/28]] için gereken beş algden biridir.", false],
	],
	"species/15": [
		[1, "Genel bakış", "[[species/15]], kelpleri de içeren kahverengi algleri (Phaeophyceae) temsil eder. Dev kelp onlarca metre boyuna ulaşabilir ve pek çok başka türü barındıran su altı ormanları oluşturur. Kahverengi algler, gıdaları koyulaştırmada ve tıpta kullanılan aljinatların ticari kaynağıdır.", false],
		[1, "Oyunda", "Oyunda ton başına 14 ile 47 cr ile tüm avların en ucuzudur. Diğer algler gibi deniz tabanında hareketsiz durur, 2 t ağırlığındadır ve 2,1 sn içinde etkisiz kalır. Tek kullanımı, beş algin hepsini gerektiren [[goods/28]] yapımındadır.", false],
	],
	"species/16": [
		[1, "Genel bakış", "[[species/16]], kırmızı algleri (Rhodophyta) anlatır. Fikoeritrin adlı kırmızı bir pigment, denize en derin işleyen mavi ışığı soğurmalarını sağlar; bu yüzden diğer tüm deniz yosunlarından daha derinde yetişirler. Agar ve karragenan kırmızı alglerden elde edilir; suşiyi sarmakta kullanılan nori de bir kırmızı algdir.", false],
		[1, "Oyunda", "Oyunda ton başına 27 ile 62 cr değeriyle ikinci en değerli algdir. Deniz tabanında durur, 2 t ağırlığındadır ve kolayca zıpkınlanır. [[species/13]] ile birlikte [[goods/27]] yapımına girer, ayrıca [[goods/28]] için de gereklidir.", false],
	],
	"species/17": [
		[1, "Genel bakış", "[[species/17]], kara bitkilerinin en yakın akrabaları olan yeşil algleri temsil eder. Deniz marulu (Ulva) kıyılarda bilinen bir örnektir. Bazı yeşil deniz yosunları yenir; Japonya'da aonori adlı kurutulmuş pullar yemeklerin üzerine serpilir. Yeşil algler bol ışığa ihtiyaç duyar, bu yüzden çoğu sığ sularda yetişir.", false],
		[1, "Oyunda", "Oyunda ton başına 20 ile 44 cr ile düşük değerli bir avdır. Diğer algler gibi dibe kök salmıştır, 2 t ağırlığındadır ve 2,1 sn içinde etkisiz kalır. Fabrikalar onu [[species/4]] ile birleştirerek [[goods/21]] yapar; ayrıca [[goods/28]] içindeki beş algden biridir.", false],
	],
	"species/2": [
		[1, "Genel bakış", "[[species/2]], pek çok knidlinin serbest yüzen evresi olan medüzleri temsil eder. Denizanasının beyni, kemiği ya da kanı yoktur; çanı büyük ölçüde sudan oluşur. Çanını kasıp gevşeterek hareket eder, akıntıyla sürüklenir ve yakıcı hücrelerle donanmış dokunaçlarla küçük avlar yakalar. Bazı türler ışık saçar; birkaç derin deniz türü de kırmızı ya da mordur.", false],
		[1, "Oyunda", "Yaklaşık 2 t ile oyundaki en hafif canlılardan biridir; 4 olan dayanıklılığı tek bir başıboş atışın onu öldürebileceği anlamına gelir. Zıpkında yaklaşık 2,5 sn sonra pes eder. Fiyatlar ton başına 40 ile 133 cr arasındadır. Üretimdeki tek kullanımı, [[goods/26]] ürününün üç malzemesinden biri olmaktır.", false],
	],
	"species/3": [
		[1, "Genel bakış", "[[species/3]], dünyanın en büyük vatozları olan manta vatozlarına dayanır. Büyük okyanus türlerinin kanat uçları arası yaklaşık 7 m'ye ulaşabilir. Mantalar uysal süzücü beslenicilerdir: ağızları açık yüzer ve ağzın önündeki iki etli lobla planktonu içeri yönlendirirler. Vücut büyüklüğüne oranla tüm balıklar arasında en büyük beyinlerden birine sahiptirler.", false],
		[1, "Oyunda", "Oyunda yaklaşık 16 t ağırlığındadır ve dayanıklılığı 32'dir; bu yüzden sıyırıp geçen ateşe küçük hayvanlardan daha iyi dayanır. Halatta yaklaşık 3,6 sn çırpınır. Ton başına 65 ile 182 cr arasındaki ham fiyatları orta düzeydedir, ama [[goods/20]] için gereken canlıdır; o da [[goods/29]] yapımında kullanılır.", false],
	],
	"species/4": [
		[1, "Genel bakış", "[[species/4]], sardalya, hamsi ve ringa gibi küçük balıkların oluşturduğu yoğun sürüleri temsil eder. Sürü hâlinde yüzmek, tek bir hedef seçmekte zorlanan yırtıcıların kafasını karıştırır; balıklar birbirlerinin dümen suyunda yüzdüğü için enerji tasarrufu da sağlayabilir. Bu sürüler pek çok deniz besin zincirinin ve dünyanın en büyük balıkçılık alanlarının temelidir.", false],
		[1, "Oyunda", "Oyunda bir sürü, tek bir 4 t'luk yük olarak yakalanır. Zahmetsiz bir avdır: zıpkın onu yaklaşık 2,5 sn içinde etkisiz bırakır ve dayanıklılığı yalnızca 8'dir. Fiyatlar ton başına 53 ile 138 cr arasındadır. [[goods/21]] ve [[goods/26]] ürünlerinin malzemesidir; bu yüzden ayrıca [[species/17]] ya da [[species/2]] yakalayan bir pilotun hazır bir tedarik zinciri olur.", false],
	],
	"species/5": [
		[1, "Genel bakış", "[[species/5]], fener balıklarını, özellikle de derin deniz türlerini anlatır. Başlarındaki değişime uğramış bir diken, ucunda yem bulunan bir olta oluşturur. Pek çok derin deniz türünde yem, ortak yaşayan bakterilerin ürettiği ışıkla parlar ve avı geniş bir ağza doğru çeker. Bazı türlerde minik erkekler, çok daha büyük dişilere kalıcı olarak kaynaşır.", false],
		[1, "Oyunda", "Oyunda yaklaşık 10 t ağırlığındadır ve zıpkında yaklaşık 2,5 sn sonra pes eder; bu yüzden oldukça hızlı bir avdır. Ton başına 53 ile 216 cr arasındaki fiyat aralığı geniştir. [[species/1]] ve çözücüyle birlikte, birkaç yüksek değerli ürün için temel girdi olan [[goods/24]] yapımında gereklidir.", false],
	],
	"species/6": [
		[1, "Genel bakış", "\"Şeytan balığı\" eski bir denizci adıdır. Yüzyıllar boyunca Mobula cinsinin şeytan vatozlarına, büyük ahtapotlara ve hatta gri balinaya verilmiştir. Oyun, [[species/6]] canlısını bu hayvanların herhangi birine bağlamaz. Ortak yanları, büyüklükleri ve gerçek davranışlarıyla nadiren örtüşen korkutucu ünleridir.", false],
		[1, "Oyunda", "Oyunda yaklaşık 20 t ile ağır bir avdır ve dayanıklılığı 40'tır. Zıpkına yaklaşık 4,2 sn direnir; bu, tüm canlılar arasında en uzunlardan biridir. Ton başına 364 cr'ye varan fiyatıyla tüm canlıların en yüksek tavan fiyatına da sahiptir. Fabrikalar onu [[species/8]] ve tuzla birleştirerek [[goods/25]] yapar.", false],
	],
	"species/7": [
		[1, "Genel bakış", "[[species/7]], sıcak açık okyanusların büyük kılıç gagalı balıkları olan marlinlere dayanır. Marlin, mızrak benzeri gagasıyla av sürülerini yarar ve denizdeki en hızlı balıklardandır. En büyük mavi marlinler 4 m uzunluğu ve birkaç yüz kilogramı aşar. Marlinler, uzun ve akrobatik mücadeleleri nedeniyle olta balıkçılarının gözdesidir.", false],
		[1, "Oyunda", "Oyunda yaklaşık 8 t ile hafiftir ama yakalanması zordur: hızlı yüzer ve zıpkına yaklaşık 4,2 sn direnir. Uzun menzilli ve güçlü yavaşlatmalı bir zıpkın işi kolaylaştırır. Karşılığında değerini iyi korur; ton başına 104 ile 283 cr'ye satılır ve bu, tüm canlılar arasındaki en yüksek taban fiyattır. [[goods/23]] ürününün ana malzemesidir.", false],
	],
	"species/8": [
		[1, "Genel bakış", "\"Kemik köpekbalığı\", balina köpekbalığından sonra yaşayan en büyük ikinci balık olan büyük camgözün eski bir adıdır. Büyük camgözler yaklaşık 8 m ya da daha uzun olabilir. Büyüklüklerine karşın zararsız süzücü beslenicilerdir; planktonu süzmek için devasa ağızları açık hâlde yüzeye yakın yavaşça yüzerler. Uzun mesafeler göç ederler ve kışı çoğu zaman daha derin sularda geçirirler.", false],
		[1, "Oyunda", "Oyunda [[species/8]] yaklaşık 18 t ağırlığındadır ve dayanıklılığı 36'dır. Zıpkına yaklaşık 3,8 sn direnir. Fiyatlar ton başına 78 ile 208 cr arasındadır. Hem [[goods/25]] hem de [[goods/26]] yapımında kullanıldığı için üretimde daha yararlı avlardan biridir.", false],
	],
	"species/9": [
		[1, "Genel bakış", "Gerçekte dev karides adlı bir hayvan yoktur, ama gerçek devler vardır. Kaplan karidesi yaklaşık 30 cm'ye kadar büyüyebilir; bazı derin deniz kabukluları da sığ sulardaki akrabalarından büyüktür. Bu örüntüye derin deniz devliği denir. Pek çok derin deniz karidesi kırmızıdır; bu da onları kırmızı ışığın ulaşmadığı sularda neredeyse görünmez kılar.", false],
		[1, "Oyunda", "Oyunda [[species/9]], dayanıklılığı 4 olan, yaklaşık 2,3 sn içinde hızla etkisiz kalan küçük, 2 t'luk bir avdır. Fiyatlar ton başına 39 ile 122 cr arasındadır. Hiçbir fabrika tarifi onu kullanmaz; yalnızca satmak için avlanır. Av sözleşmeleri onu [[species/0]] gibi daha nadir canlılardan daha sık ister.", false],
	],
	"world/abel": [
		[31, "", "[[world/abel]], [[faction/rebels|direnişle]] birlikte çalışan bir bilim insanıdır. Ekranda hiç görünmez, ama araştırmaları [[character/2]] adlı liderin, savaşı koloninin aleyhine çevirebilecek bir silah yapma planının özünü oluşturur.", false],
		[31, "Geçmiş", "Profesör uzun yıllarını, şimdiye dek kimsenin yapamadığı bir güç kaynağı olan [[world/biotek]] üzerine araştırma yaparak geçirmiştir. Çalışan bir prototipi bitirmek üzereyken kolonistler onu çalmıştır ve şimdi kendileri tamamlamaya çalışmaktadır.", false],
		[31, "Hikâyedeki rolü", "[[character/2]], asilerin yeni silahını yapmaları için profesörü ve ekibini [[station/14]] istasyonuna getirir. Pilotun oraya giderken konvoyunu koruduğu bilim insanlarının onlar olduğu anlaşılır ([[chapter/29]]). Pilot ve diğerleri jeneratörü geri almaya çalışırken [[character/2]] onunla buluşmak için hemen yola çıkar ([[chapter/30]]).", false],
		[33, "", "Baskının ardından profesör, prototip üzerindeki çalışmasını sürdürmek için kurtarılan konteynerleri laboratuvarına götürür ([[chapter/32]]).", false],
		[39, "", "Çalışmaları hızla ilerler. Kısa süre sonra prototip neredeyse tamamlanır ve yalnızca bir parça eksik kalır: alg parçacıklarının DNA'sını çoğaltarak güç üreten zincirleme tepkimeyi başlatan bir [[goods/36]]. [[character/2]] onun açıklamasını aktarırken tam olarak anlamadığını da kabul eder. Cihaz yalnızca [[station/16]] istasyonunda yapılabilir ([[chapter/38]]).", false],
		[42, "", "İnkübatör [[station/14]] istasyonuna ulaştığında profesör onu takmak için her şeyi hazırlamıştır ve bitmiş silahın kısa süre içinde hangarda olması beklenir. Jeneratör hâlâ bir prototip olduğundan pilot, ona dikkatli davranması konusunda uyarılır ([[chapter/41]]).", false],
		[44, "", "Kolonistler [[station/14]] istasyonuna saldırdığında, profesörün jeneratörüyle çalışan [[world/eclipse|Eclipse]] belirleyici olur.", false],
		[31, "Karakter", "Onun hakkında bilinen her şey [[character/2]] ve [[character/5]] aracılığıyla öğrenilir. Kendini işine adamış bir araştırmacı olarak anlatılır.", false],
		[39, "", "Açıklamaları o kadar tekniktir ki [[character/2]] bile onları tekrarlamakta zorlanır.", false],
	],
	"world/aquarians": [
		[10, "", "Aquarianlar, yarı insan yarı balık oldukları söylenen derin okyanus varlıklarıdır. Aquarian adını onlara kolonistler vermiştir ve koloni onları bir baş belası olarak görür. En çok, koloninin ihraç mallarını yörüngeye taşıyan nakliye kapsüllerine saldırmalarıyla bilinirler. Kim oldukları ve ne istedikleri, hikâyenin yavaş yavaş yanıtladığı sorulardan biridir.", false],
		[10, "Doğaları", "Başta Aquarianlar hakkında pek az şey bilinir. Açık sularda yaşarlar ve makineler gibi değil deniz hayvanları gibi hareket ederler, ama kendilerine ait silahlarla savaşırlar. Kolonistler onlara tehlikeli hayvanlar gibi davranır ve neden saldırdıklarını hiç sormaz.", false],
		[11, "", "Pilotun onlarla ilk çatışmasından sonra [[character/1]], onların herkesin sandığından çok daha zeki olup olmadığını merak eder. Pilot da kapsülleri neden hedef aldıklarını sorgulamaya başlar.", false],
		[19, "", "Sonraki karşılaşmalar, okyanusun yaban hayatını önemsediklerini düşündürür. Kolonistlerin yakalamaya çalıştığı bir [[species/10|renk değiştiren kalamar]] sürüsünün yanında, sanki onu koruyormuş gibi yüzerken görülürler.", false],
		[45, "", "Zekidirler ve diplomasiye yatkındırlar. Bir Aquarian elçi [[station/14]] istasyonuna gelir ve insan konuşmasının bir kısmını anlıyor gibi görünür.", false],
		[10, "Koloniyle ilişkileri", "Kapsül fırlatmaları koloninin daha geniş ekonomiyle bağlantısıdır ve Aquarianlar bunlara tekrar tekrar saldırır. Hasar gören ya da kaybolan her kapsül istasyonu ticaret yönetiminin gözünde kötü gösterir; bu yüzden kolonistler saldırganları püskürtmek için silahlı pilotlar tutar. Kapsül savunması aynı zamanda olağan bir kolonist sözleşmesidir; bkz. [[contract/11]].", false],
		[10, "", "[[chapter/10]] bölümünde pilot, bir kapsül fırlatmasını savunmak üzere [[station/2]] istasyonuna gönderilir; [[character/9]] adlı yetkilinin emri, birkaç kayıptan fazlasına göz yumulmamasıdır.", false],
		[11, "", "Koloninin Aquarianlarla hiç konuşmaya çalıştığına dair bir işaret yoktur. Yalnızca onları püskürtmesi ya da öldürmesi için para öder.", false],
		[13, "Asilerle ilişkileri", "[[faction/rebels]] koloninin sömürüsünü kınarken gezegenin kaynaklarından olduğu kadar sakinlerinden de söz eder. Belki Aquarianlar da kastedilenler arasındadır, ama uzun süre iki taraf arasında hiçbir temas olmaz.", false],
		[19, "", "Asiler ile Aquarianlar, okyanusun hayvanlarını koruma konusunda ortak bir çıkara sahiptir. Pilot [[station/7]] istasyonu yakınında kalamarları korurken [[character/1]], Aquarianların müttefik olabileceğini öne sürer.", false],
		[44, "", "Dönüm noktası, [[chapter/43]] bölümünde kolonistlerin [[station/14]] istasyonuna saldırısı sırasında gelir. İstasyonun rıhtımları vurulmuş ve savunucular sayıca geride kalmışken bir grup Aquarian gelir ve kolonistlere saldırarak savaşın gidişatını değiştirir. [[character/9]] ve kuvvetleri bozguna uğrar.", false],
		[45, "", "Savaştan sonra Fiir'deki elçi, Aquarianların kolonist yönetimine karşı savaşmaya hazır olduğunu açıklar. [[character/2]], koloni yenildiğinde insanlarla Aquarianların okyanusla uyum içinde yaşayabileceğini umar. Asiler onların yardımıyla iki son taarruz planlar.", false],
		[45, "", "[[chapter/45]] bölümünde bir grup Aquarian, [[station/18]] saldırısında pilota ve [[character/12]] adlı liderin birliğine katılmak için derinliklerden yükselir.", false],
		[47, "", "İki taarruz da başarılı olur ve asi komutanlar zaferin büyük bölümünü Aquarianlara borçlu olduklarını söyler.", false],
		[48, "", "Koloni ortadan kalkınca hikâyenin sonunda asiler ile Aquarianlar arasındaki ittifak, okyanusun iyileşmesine fırsat verme sözüyle birlikte ayakta kalır.", false],
		[45, "Yanıtsız sorular", "Aquarianlar hakkında pek çok şey hiç açıklanmaz. Hikâye onların nerede yaşadığını, kaç kişi olduklarını, silahlarını nasıl yapıp kullandıklarını ya da insan konuşmasını nasıl anlamaya başladıklarını söylemez. Neden özellikle koloninin kapsüllerini hedef aldıklarını da açık bırakır; ancak asilerle sonraki ittifakları, ihraç mallarını okyanuslarının yağmalanmasının bir parçası olarak gördüklerini düşündürür.", false],
		[10, "Oyunda", "Savaşta Aquarianlar enerji atışları yapan balık benzeri savaşçılar olarak görünür. Denizaltılardan daha yavaş döner ve asla ani hız patlamaları kullanmazlar. Yok edilen bir Aquarian bir deniz canlısı gibi, tek bir patlamayla ölür; geride kurtarılacak bir enkaz ya da yakalanacak bir şey bırakmaz.", false],
		[10, "", "Koloni tarafında Aquarianlar kapsül savunma görevlerinin düşmanıdır. Doğruca kapsüllere yönelirler, bu yüzden savunucu onları hızla avlamalıdır. Çok fazla kapsül kaybedilirse görev başarısız olur. Aquarianları yok etmek bir öldürme sayılır, ama korsan ödülüne sayılmaz.", false],
		[44, "", "Son bölümlerde pilotun yanında müttefik olarak savaşırlar. Radarda dost temaslar olarak görünür ve kolonist gemilerine saldırırlar.", false],
	],
	"world/biotek": [
		[31, "", "Biotek jeneratörü, [[world/abel|Profesör Abel]] tarafından geliştirilen deneysel bir güç kaynağıdır. Asilerin kolonistlere ateş gücüyle üstün gelme planının anahtarıdır. Asiler onu, sıradan bir denizaltı için fazla enerji tüketen bir silahı beslemek için kullanmayı amaçlar; jeneratörü geri almak da bu planın üç adımının ilkidir. Jeneratörün kendisi hiçbir zaman ekipman olarak satılmaz ya da takılmaz; oyunda pilot onun ihtiyaç duyduğu parçalarla uğraşır.", false],
		[31, "Araştırma ve hırsızlık", "Jeneratörün ardındaki teknoloji yıllardır incelenmektedir, ama kimse çalışan bir prototip ortaya koyamamıştır. Profesör Abel bir prototipi bitirmek üzereyken kolonistler onu çalmıştır. Şimdi onu kendileri tamamlamaya çalışmaktadırlar; asiler ise bunu engellemeye kararlıdır.", false],
		[31, "", "[[character/2]], planı açıklamadan kısa süre önce yüksek nitelikli bir bilim insanı grubunun [[station/14]] istasyonuna gitmesini ayarlamıştır. [[chapter/29]] bölümünde pilot, onların konvoyuna [[station/13]] istasyonu yakınındaki sınır bölgesinden güvenle geçene dek eskortluk etmiştir.", false],
		[31, "", "Fiir'de Ayumi bilim insanlarının amacını açıklar: onlar Abel'ın ekibidir. Birlikte jeneratörü yeni bir silahın kalbine dönüştüreceklerdir.", false],
		[31, "Üç adımlı plan", "Ayumi planı üç adımda ortaya koyar. Önce asiler jeneratörü geri almalıdır. İkinci olarak, böyle bir jeneratöre layık güçte bir silaha ihtiyaçları vardır. Üçüncü adımı henüz açıklamaz.", false],
		[31, "", "Ayumi'nin muhbirlerinden birine göre çalınan jeneratör, sıradan bir kolonist konvoyuyla Maarth adlı bir yere taşınmaktadır. Hangi geminin onu taşıdığını kimse bilmediğinden pilot, [[character/5]] ve [[character/4]], [[station/2]] istasyonu yakınında bütün konvoyu durdurup her konteyneri kurtarmalıdır.", false],
		[32, "", "Kolonist mürettebat yalnızca yiyecek ve ilaç taşıdıklarını söyleyerek itiraz etse de baskın başarılı olur ve her konteyner kurtarılır.", false],
		[33, "", "Fiir'e dönüldüğünde Abel, prototipi bitirmek için ele geçirilen kargoyu laboratuvarına götürür. Bu arada pilot ikinci adımın silahını, [[world/eclipse|Eclipse]] topunu bulmak için yola çıkar.", false],
		[39, "Nasıl çalışır", "Jeneratör gücünü canlı maddeden alır. Bir polimeraz inkübatörü alg parçacıklarının DNA'sını kopyalar ve bu kopyalama, enerji açığa çıkaran bir zincirleme tepkimeyi başlatır. Prototipin çalışabilmesi için hâlâ bu inkübatöre, yani [[goods/36]] ürününe ihtiyacı vardır.", false],
		[39, "", "Onu yapacak donanım yalnızca tek bir istasyonda vardır: okyanusun en ileri istasyonu [[station/16]]. Pilotun üçüncü adımı oraya gidip inkübatörü üretmektir.", false],
		[42, "", "İnkübatör Fiir'e teslim edilince Abel kurulumu tamamlar ve jeneratör pilotun kendi gemisindeki Eclipse'i besler. Asiler onun hâlâ bir prototip olduğu konusunda uyarır.", false],
		[44, "", "Savaşta dayanır. Kolonistler Fiir'e saldırdığında, jeneratörün beslediği Eclipse savaşın gidişatını değiştirmeye yardım eder. [[character/9]], topu bir denizaltıda gördüğünde gözle görülür biçimde sarsılır.", false],
		[45, "", "[[station/188]] asilerin eline geçince asiler, olabildiğince çok birliği aynı top ve güç kaynağı eşleşmesiyle donatmaya koyulur.", false],
		[39, "Oyunda", "Üçüncü adım üç bölüm sürer: [[chapter/39]] bölümünde Wagoll'a yolculuk, [[chapter/40]] bölümünde orada inkübatörün üretimi ve [[chapter/41]] bölümünde Fiir'e teslimat. Mal sayfasında bir fiyat aralığı verilir, ama hiçbir pazar onu stoklamaz; bu yüzden edinmenin tek yolu onu üretmektir.", false],
		[39, "", "İnkübatör, teknoloji seviyesi 11 olan bir istasyonun fabrikasında yapılır; bu da pratikte Wagoll demektir. Tarifi [[goods/19]], [[goods/34]], [[goods/28]] ve [[goods/24]] mallarından birer tane gerektirir. Bunlar da sırasıyla ölü balık ve alglerden, ithal mallardan, beş alg türünün hepsinden ve [[species/5]] ile [[species/1]] canlılarıyla birlikte [[goods/35]] malzemesinden elde edilir. Bunları toplamak kendi başına küçük bir üretim zinciridir.", false],
		[39, "", "Wagoll, çoğu zırhın inebileceğinden daha derinde, 29.850 m'dedir; bu yüzden pilotun oraya güvenle ulaşmak için [[equipment/25]] gibi ağır bir zırha ihtiyacı vardır. İnkübatör hiçbir pazarın stoklamadığı bir hikâye eşyasıdır. Üretildikten sonra Fiir'e teslim edilene dek gemide kalır.", false],
	],
	"world/colony": [
		[1, "", "Koloni, okyanus gezegenindeki insan yerleşimidir: bir koloni yönetimince işletilen iki yüz derin deniz istasyonu ile bunlarda yaşayıp çalışan yerleşimciler, balıkçılar ve tüccarlar. Hikâyenin başında her istasyon [[faction/colonists]] tarafına aittir ve koloninin amacı açıktır: okyanusun kaynaklarını alıp başka yerlere göndermek için vardır. Bu makale koloninin nasıl örgütlendiğini, ekonomisinin nasıl işlediğini ve hikâye ilerledikçe ikisinin nasıl değiştiğini anlatır.", false],
		[1, "Kolonileşme", "Yerleşimciler gezegene başka yerlerden gelmiş ve evlerini yüzeyin altına kurmuştur; istasyonlar bugün yaklaşık 13.500 ile 32.250 m arasındaki derinliklerde durur. İstasyonlar birbirinden çok farklıdır. Her birinin, fabrikasının ne üretebileceğini ve dükkânlarının ne kadar fiyat istediğini belirleyen 1 ile 11 arasında bir teknoloji seviyesi vardır; her birinin kendi suları, yaban hayatı ve komşuları bulunur. Bazıları [[station/0]] gibi büyük merkezlerdir; diğerleri tek bir ürünüyle tanınan küçük karakollardır.", false],
		[1, "", "Yeni gelenlerden üzerlerine düşeni yapmaları beklenir. Pilot gezegene küçük bir tekne ve az parayla balık tutmaya gelir ve işin zor ve kötü ücretli olduğunu çabucak anlar.", false],
		[10, "", "Koloni bir ihracat ekonomisidir. İstasyonları mallarını nakliye kapsüllerine yükleyip yörüngeye fırlatır; kapsüller orada kargo gemilerince toplanır. Yerel yetkililerin üstünde, istasyonları bu sevkiyatların ne kadar düzenli ulaştığına göre değerlendiren bir ticaret yönetimi vardır.", false],
		[12, "", "Pilotun kendi planı ise yalnızca gezegenden ayrılacak bir bilete yetecek parayı kazanmaktır.", false],
		[21, "", "Asiler kolonileşmeyi hızlı ve acımasız olarak niteler. Onlara göre okyanusu doğanın kendini yenileyebileceğinden daha hızlı tüketmektedir; başka gezegenlerde de daha önce böyle olmuştur.", false],
		[1, "Yönetim ve istasyonlar", "Her istasyon, kendi yetkilileri ve hizmetleri olan küçük bir kasabadır. Yanaşan bir pilot ekipman takmak için hangarı, donanım ve gövde satın almak için dükkânı ve tersaneyi ve haritayı ziyaret edebilir. Çoğu istasyonda bir iş panosu, bazılarında da bir pazar ve fabrika bulunur. Devriye gemileri her istasyonun çevresinde S.T.R.E.A.M. kapıları arasında dolaşır ve istasyonu hangi taraf elinde tutuyorsa onun için savaşır.", false],
		[2, "", "Gündelik işlerde koloni adına koloni yetkilileri konuşur. [[station/0]] istasyonunda [[character/9]], pilotun avını satın alır ve kimsenin istemediği öğütler dağıtır.", false],
		[7, "", "Yerel tehditlerle istasyon güvenliği ilgilenir ve yetkililer bu tür işleri serbest çalışanlara verir. Nautiluslar [[station/1]] istasyonunun çevresinde toplanınca istasyonun güvenlik ekibi onlardan kurtulmak ister ve Jack bu işi halletmesi için pilotu gönderir.", false],
		[9, "", "Yetkililer, yeni gelenlerin önemli işler almadan önce güven kazanmasını bekler. Koloni daha büyük bir şey önermeden önce pilot iş panosundan sözleşmeler tamamlamalıdır. Pilotun karşılaştığı adsız [[character/6]] yetkilileri genellikle soğuk davranır ve olabildiğince az öder.", false],
		[1, "Sabit fiyatlar", "Kolonist istasyonları ticaret yapmaz. Pazar da fabrika da yoktur: bir gemi yanaştığında istasyon ambarındaki her şeyi alır ve her kalem için taban fiyatı, yani o malın getirebileceği en düşük fiyatı öder. İstasyonun kendi sipariş ettiği bir teslimat önce hesaplanır; geri kalan her şey sabit fiyattan gider. Satacak başka yeri olmayan bir balıkçı için bütün ekonomi budur.", false],
		[1, "", "Bu, koloninin balıkçılarını yoksul tutar. Taban fiyat çoğu zaman aynı avın başka yerde getirebileceğinin yarısından azdır ve başka alıcı yoktur.", false],
		[1, "Pazarlar ve fiyatlar", "Serbest pazarlar yalnızca koloni denetimi dışındaki istasyonlarda bulunur. Orada bir malın fiyatı mesafeye bağlıdır. Her malın taban fiyatından satıldığı bir ana istasyonu ve tavan fiyata ulaştığı bir en iyi pazarı vardır. Arada fiyat, ana istasyondan olan harita mesafesiyle birlikte yükselir. Üç ithal mal, [[goods/33]], [[goods/34]] ve [[goods/35]], ters yönde işler ve en iyi pazarlarında en ucuzdur. Bir pazar aynı fiyattan alır ve satar; bu yüzden kâr pazarlıktan değil, mal taşımaktan gelir. Bkz. [[guide/trading]].", false],
		[1, "", "Bir istasyonun teknoloji seviyesi dükkânlarını da etkiler. Gemiler ve ekipman ileri istasyonlarda daha ucuzdur: her teknoloji seviyesi bir gövdenin fiyatından yüzde bir düşer, ekipman da biraz daha ucuza gelir. Hikâye ilerledikçe daha nadir ekipmanlar daha sık ortaya çıkar.", false],
		[1, "Fabrikalar ve tarifler", "Fabrikalar ham avı ve ithal malları ürünlere dönüştürür. Her ürünün sabit bir tarifi ve asgari bir teknoloji seviyesi vardır. [[goods/21]] bir [[species/4]] ve [[species/17|yeşil alg]] gerektirir; [[goods/22]] bir [[species/10]] ve [[goods/35]] gerektirir; [[goods/29]] ise [[goods/20]] ile boyayı birleştirir. [[goods/41]] gibi ileri ürünler malzeme olarak başka ürünlere ihtiyaç duyar; böylece bir üretim zinciri ucuz balığı değerli mallara dönüştürebilir.", false],
		[1, "", "Bir fabrika, istasyonunun teknoloji seviyesine kadar her şeyi yapabilir. Ürünlerin çoğu yalnızca 1. seviye gerektirir, ama en az bir ürün yalnızca en ileri istasyonda yapılabilir. Her ürün sayfası tarifini listeler.", false],
		[1, "İş panosu", "Sözleşmeli iş, koloninin serbest çalışan tutma yoludur. Bir iş panosu, her birinin bir işvereni, kabulde ödenen bir depozitosu ve başarıda ödenen bir ücreti olan bir ile sekiz arasında teklif listeler. Ücret zorluk ve mesafeyle, zorluk da pilotun rütbesiyle artar. İşlerin çoğu pilotu başka bir istasyona, genellikle geminin derinlik aralığındaki bir istasyona gönderir. Bkz. [[guide/contracts]].", false],
		[1, "", "Bir panonun neler sunduğu istasyonu kimin elinde tuttuğuna bağlıdır. Kolonistler konvoy eskortları, konvoy akıncıları, avcılar ve kapsül fırlatmaları için muhafızlar tutar. Serbest istasyonlar teslimat ve av siparişleri yayımlar ve hayvan sürülerini korumak için ödeme yapar. İki taraf da ödül avları, kurtarmalar, korsan avları, yolcu taşımaları ve temizlik işleri yayımlar.", false],
		[9, "", "İş panosu pilota ancak koloni için yapılan ilk işlerden sonra, [[chapter/9]] bölümünde açılır. İstasyon haritası biraz daha erken kullanılabilir hâle gelir.", false],
		[1, "Yasa ve düzen", "Koloni suda kendi yasasını uygular. İstasyonlar bir sefer boyunca yok edilen her korsan için yanaşmada tahsil edilen bir ödül öder. Tutar, korsan sayısının karesinin kolonist istasyonunda 100, serbest istasyonda 50 krediyle çarpımıdır; bu yüzden uzun bir av, birkaç kısa avdan çok daha fazla kazandırır.", false],
		[12, "", "Bütün sular koloniye ait değildir. Direnişin elindeki istasyonlar çevrelerindeki suları tarafsız bölge sayar ve bilinmeyen gemileri yanaşmalarına izin vermeden önce durdurur.", false],
		[35, "", "Bazı ticaretler yasa dışıdır. Uyuşturucu maddeler en azından bazı istasyonlarda yasaktır; bu da [[character/8]] gibi karaborsacılara yer açar. Güvenlik makamları bu tür insanlardan kurtulmak için [[character/11]] gibi ödül avcıları tutar.", false],
		[12, "Hikâyede koloni", "Pilot için koloni önce bir işveren, sonra bir rakiptir. Jack sabit fiyat öder, [[station/1]] istasyonundaki nautilus itlafı az kazandırır ve [[station/2]] istasyonundaki kapsül savunması Jack'in hiçbir ödül vermeyi reddetmesiyle biter. Bıkan pilot, M.A.I.'nin öğüdüne uyar ve direnişi bulmak için [[station/3]] istasyonuna gider.", false],
		[13, "", "Direniş, koloninin ticaret üzerindeki denetimine ve gezegeni sömürmesine karşı çıkar. Üyeleri serbest ticaret, adil fiyatlar ve özenle avlanılan bir deniz ister.", false],
		[18, "", "Asiler istasyonları önce diplomasiyle, yöneticilerini taraf değiştirmeye ikna ederek kazanır. Katılan her istasyon pilota bir pazar ve fabrika açar; böylece koloninin ekonomisi istasyon istasyon değişir. Bir devrim söylentisi yayılır.", false],
		[23, "", "Koloni istasyonlarını sessizce bırakmaz. Artık epey nüfuz sahibi olan Jack, [[station/9]] istasyonu yakınında bir asi ikmal yolunu kesmek için bir mayın tarlası döşetir.", false],
		[25, "", "Ardından Jack, [[station/10]] istasyonundaki görüşmelere giden asi liderine pusu kurar.", false],
		[28, "", "Koloni hain de satın alır. Jack asi lideri ve pilot için bir ödül koyar ve asi pilot [[character/3]] parayı alır.", false],
		[31, "", "Koloni teknoloji alanında da asilerle yarışmaktadır. Adamları [[world/abel|Profesör Abel'ın]] prototip [[world/biotek|Biotek jeneratörünü]] çalmıştır ve onu kendileri tamamlamaya çalışmaktadır.", false],
		[37, "", "Açgözlülük koloniyi içeriden zayıflatır. Jack bizzat bir istasyon topunu, [[world/eclipse|Eclipse]] topunu, bir karaborsacıya satar; o da onu pilota satar.", false],
		[44, "", "Kolonistler son bir güç gösterisiyle asi bölgesinin derinliklerine saldırır ve [[station/14]] istasyonunu hedef alır, ama Aquarianlar onlara karşı savaşa katılınca püskürtülür.", false],
		[45, "", "Bu yenilginin ardından asiler, her yarımkürede birer tane olmak üzere iki büyük taarruzla koloniye son vermek için harekete geçer.", false],
		[47, "", "Güneydeki istasyonlar düşer ve kolonistlere son büyük kale olarak güçlü biçimde tahkim edilmiş [[station/0]] kalır.", false],
		[48, "", "Gosu son savaşta düşer. Jack bir kurtarma kapsülüyle kaçar ve her istasyon asilerin eline geçerken okyanus üzerindeki koloni yönetimi sona erer.", false],
	],
	"world/eclipse": [
		[33, "", "Eclipse, istasyonların savunması için yapılmış ağır bir toptur. O kadar çok enerji tüketir ki asla bir denizaltıya takılmak için tasarlanmamıştır. Asilerin planının ikinci adımında pilot, onu bir gemiden ateşleyecek kadar enerji sağlayabilen [[world/biotek]] ile eşleştirilebilmesi için bir tane edinmelidir. Silah, ekipman listesindeki [[equipment/42]] silahıdır; hikâyede ticareti yapılan sandıklı top ise [[goods/38]] malıdır.", false],
		[33, "Kökeni", "Eclipse, sabit savunmalar için tasarlanmış bir istasyon topu sınıfına aittir. İstasyonlarda kalmasının nedeni enerji ihtiyacıdır: hiçbir denizaltının güç ünitesi onu ateşlemeye yetmez. Pilot onu zaten sabit bir silah olarak bilmektedir; asilerin onu bir gemide taşıma planının kulağa bu kadar olanaksız gelmesinin nedeni de budur.", false],
		[33, "", "Eclipse topları, plan başladığında kolonistlerin elinde olan [[station/188]] istasyonunda üretilir. Asilerin denetimindeki en yakın uygun istasyon [[station/15]] istasyonudur. Silah açık piyasada hiç satılmaz.", false],
		[33, "", "Asilerin ona ihtiyacı vardır, çünkü sayıca azdırlar. Kolonistlerle gemi gemi boy ölçüşmek yerine, bir denizaltının taşıdığı bu güçte bir silahın dengeyi değiştirebileceğini umarlar.", false],
		[33, "Topun edinilmesi", "[[character/2]] adlı liderin bir top edinmek için net bir planı yoktur. Gerekecek rüşvetler için pilota 100.000 kredi verir ve etrafa bakması için Choral'a gönderir.", false],
		[35, "", "Choral'da pilota, bedeli karşılığında neredeyse her şeyi bulabileceğini iddia eden karaborsacı [[character/8]] yaklaşır. Bir Eclipse bulmaya çalışacaktır, ama ancak pilot önce ondan kurtulmak için tutulmuş ödül avcısı [[character/11]] adlı adamı öldürürse.", false],
		[37, "", "Raoul ölünce Fenko yüksek bir fiyata bir Eclipse ortaya çıkarır. Onu, görünüşe göre topun düşmanlarının eline geçeceğini bilmeden kâr için satan [[character/9]] adlı yetkiliden almıştır.", false],
		[38, "", "Pilot silahı satın alır ve [[station/14]] istasyonuna geri taşır.", false],
		[39, "", "[[character/2]], topun nasıl elde edildiğini sormamayı seçer. Onun için hiçbir masum insanın ölmediğini duyunca rahatlar. Pilot planın bütün gezegeni boyunduruk altına almak anlamına geldiği şakasını yapınca lider bu fikri kesinlikle reddeder.", false],
		[42, "Eclipse görevde", "[[goods/36]] Fiir'e ulaştıktan sonra [[world/abel|Profesör Abel]] topu prototip jeneratöre bağlar ve Eclipse pilotun kendi denizaltısına takılmaya hazır olur. Asiler güç kaynağının hâlâ yalnızca bir prototip olduğu konusunda uyarır. Pilotun emri, silahı [[station/17]] istasyonu yakınındaki bir korsan çetesi üzerinde denemektir.", false],
		[43, "", "Deneme o kadar iyi geçer ki korsanlar takviye çağırır. Hemen ardından top gerçek sınavıyla karşılaşır: kolonistler Fiir'e saldırır; Jack, pilotun bir Eclipse taşıdığına neredeyse inanamaz.", false],
		[45, "", "Fiir'in savunmasından sonra asiler [[station/188]] istasyonunu alır ve son taarruzlardan önce kendi gemilerinden olabildiğince çoğunu Eclipse ile donatmaya başlar.", false],
		[47, "", "[[station/18]] ve [[station/109]] savaşlarında top yıkıcı olduğunu kanıtlar ve [[character/5]] onu övgüye boğar.", false],
		[37, "Oyunda", "[[chapter/37]] bölümü civarındaki bölümlerde sandıklı Eclipse, Choral'da bir hikâye malı olarak satışa çıkar. Herhangi bir sıradan ticaret malından çok daha pahalıdır ve başka hiçbir yerde stoklanmaz.", false],
		[42, "", "[[chapter/42]] bölümünde [[equipment/42]], [[station/14]] istasyonundaki ekipman dükkânında belirir ve takılması hiçbir şeye mal olmaz. Takılana dek iş panosu ve harita kapalıdır ve gemi ayrılamaz. Bir gemiye yalnızca bir Eclipse takılabilir ve savaş kazanılana dek satılamaz.", false],
		[42, "", "Silah olarak satıştaki her şeyden üstündür. Her atışı oyundaki diğer tüm silahlardan daha sert vurur, menzili yaklaşık 240 m'dir ve saniyede yaklaşık bir kez ateş eder. Silah grubunun geri kalanıyla birlikte ateşlenir, bu yüzden takılı diğer silahlarla birlikte kullanılır.", false],
	],
	"world/history": [
		[1, "", "Sefer, uzak bir okyanus gezegenine insan [[world/colony|kolonisi]] için balıkçılık yapmaya gelen genç bir denizaltı pilotunu izler. Kolonistler [[world/ocean|okyanusun]] derinliklerine dağılmış istasyonlarda yaşar ve koloni, pilotlarının yakaladığı, sattığı ve istasyonlar arasında taşıdığı mallara bağımlıdır. Pilotun küçük, mütevazı donanımlı bir denizaltısı vardır; onu, asla öğüt ve fikir sıkıntısı çekmeyen gemi bilgisayarı [[character/1]] ile paylaşır. Pilotun adını oyuncu seçer; bu başvuru kaynağı kahramana yalnızca pilot der.", false],
		[1, "", "Hikâye 48 bölümde anlatılır. Çalışan bir balıkçının gündelik işleriyle başlar: deniz canlılarını yakalamak, avı satmak ve geçinmek için ufak tefek işler almak. Ardından gezegenin denizine ve canlılarına nasıl davranılması gerektiği ve buna kimin karar vereceği üzerine bir çatışmaya dönüşür. Yol boyunca pilot istasyon yetkilileri, tüccarlar, [[faction/pirates]] ve derinliklerin daha tuhaf sakinleriyle karşılaşır; tek bir balıkçının seçimleri de kimsenin beklemediği kadar önem kazanır.", false],
		[1, "I. Perde: Koloni için balıkçı", "Hikâye [[chapter/1]] bölümünde açık denizde başlar. Pilot gezegene taşındığına şimdiden pişmandır, ama [[character/1]] buraya balık tutmak için geldiklerini hatırlatır; ilk iş, bir canlıyı zıpkınlayıp ambara almaktır. Açılış sahneleri aynı zamanda deniz canlılarını yakalamaya giriş niteliğindedir.", false],
		[2, "", "İlk canlı yakalanınca [[character/1]], otopilotun dümeni nasıl devralabildiğini gösterir; [[chapter/2]] bölümünde pilot, avın satıldığı kolonist istasyonu [[station/0]] yolunu tutar.", false],
		[3, "", "Pilot, [[station/0]] istasyonunda avı satın alan koloni yetkilisi [[character/9]] ile muhatap olur. [[character/9]] her zamanki sabit fiyatı öder, küçük kargo ambarıyla alay eder ve yeni gelene herkesin koloni için üzerine düşeni yapması gerektiğine dair nutuk atar. Gerçek bir silahı olan bir pilotun [[faction/pirates]] avlayarak daha çok kazanabileceğini de küçümseyerek söyler. O gidince [[character/1]] ona ahmak der, ama imayı da değerlendirir ve [[equipment/0]] silahının hangarda satışta olduğunu belirtir. [[chapter/3]] bölümünde pilot silahı satın alıp takar.", false],
		[4, "", "İlk kez silahlanan pilot, [[chapter/4]] bölümünde yeni silahı denemek için istasyondan ayrılır; [[character/1]] zararsız balıklara ateş etmemesi konusunda uyarır. Yakın sularda hiç korsan olmadığı anlaşılır, bu yüzden av başka yere taşınmak zorundadır.", false],
		[5, "", "[[character/1]] uzun yolculukların nasıl işlediğini açıklar: gemiler büyük mesafeleri [[world/stream|S.T.R.E.A.M. ağı]] üzerinden aşar; bir bölgeden her zaman çıkış noktasından ayrılır, sonrakine giriş noktasından varırlar. [[chapter/5]] bölümünde [[station/1]] istasyonu yakınında tek bir korsan belirir. Silahlar arasında geçiş, otomatik ateş ve radarın okunması üzerine kısa bir dersin ardından pilot ilk kez savaşır.", false],
		[6, "", "Korsan yok edilir; [[character/1]], enkazların geride bıraktığı kargo sandıklarının erişilemeyecek derinliğe batmadan önce nasıl zıpkınlanacağını gösterir. Çalışan bir silah ve biraz kurtarılmış yükle pilot, [[chapter/6]] bölümünde [[station/0]] istasyonuna döner.", false],
		[7, "", "İstasyona dönüldüğünde [[character/9]] öğüdüne uyulmasından memnundur ve \"gerçek iş\" dediği bir teklifte bulunur. [[species/0|Nautiluslar]], [[station/1]] istasyonu çevresindeki konvoy rotalarını doldurmuştur ve istasyon güvenliği onlardan kurtulmak ister. Pilot, hayvanların yalnızca istasyon gövdelerini kaplayan birikintilerle beslendiğini ve hiçbir küçük ambarın hepsini taşıyamayacağını söyleyerek itiraz eder, ama [[character/9]] onların nasıl ortadan kalkacağıyla ilgilenmez. [[chapter/7]] bölümünde pilot onları zıpkınla ya da silahla temizler. Canlılar hem az hem de zararsız olduğundan ne pilot ne de [[character/1]] bu işten hoşnuttur.", false],
		[8, "", "Bu itlaf pilotu sarsar. Pilot gezegene balık tutmaya gelmiştir, bir istasyonun rahatı için hayvan öldürmeye değil; [[character/1]] ise ancak ücretin bunu telafi etmesini umabilir. İkili, [[chapter/8]] bölümünde parayı almak için [[station/1]] istasyonuna yanaşır.", false],
		[9, "", "Oradaki kolonist yetkili ([[character/6]]) pilota kiralık bir haşere temizleyicisi gibi davranır ve nautiluslar hep geri geldiği için işin muhtemelen anlamsız olduğunu kabul eder. Ödeme sabit 1.000 $'dır ve pazarlığa kapalıdır. Yeni işler yetenek kanıtına bağlıdır: istasyon iş panolarından tamamlanmış üç sözleşme. [[chapter/9]] bölümü pilotu serbest çalışan olarak yola çıkarır; pilot ulaşabildiği eskortluk, kurtarma ve av siparişlerini alır.", false],
		[10, "", "Üç iş, yetkilinin isteksiz onayını ve özel bir görevi getirir. Kolonistlerin [[world/aquarians|Aquarian]] dediği, yarı insan yarı balık garip varlıklar, koloninin mallarını yörüngeye fırlatan nakliye kapsüllerine saldırmaktadır; kapsüller orada kargo gemilerince toplanır. Kaybolan ya da hasar gören kapsüller istasyonu [[world/colony|ticaret yönetiminin]] gözünde kötü gösterdiğinden pilot, saldırganları püskürtmek için [[station/2]] istasyonuna gönderilir. Sonraki fırlatmayı [[character/9]] yönetecektir.", false],
		[10, "", "[[chapter/10]] bölümünde pilot vardığında fırlatma çoktan başlamıştır ve Aquarianlar gerçekten de kapsüllere saldırmaktadır. [[character/9]] telsizden açık bir uyarı yapar: pilotun işi, beşten fazla kapsül kaybetmemesine bağlıdır.", false],
		[11, "", "Saldırı püskürtülür, ama geride sorular bırakır. Pilot Aquarianların kapsülleri neden hedef aldığını merak eder; [[character/1]] ise onların kolonistlerin sandığından çok daha zeki olabileceğini öne sürer. Bu tür işlerden giderek huzursuzlanan pilot, [[chapter/11]] bölümünde rapor vermek için [[station/2]] istasyonuna yanaşır.", false],
		[12, "II. Perde: Direniş", "Pilotun koloniye karşı sabrı, [[character/9]] adlı yetkilinin karşılamasıyla tükenir. Yetkili, hasarlı kapsüller için pilotu suçlar, ödülü iptal eder ve daha büyük işler için yaratıldığını söylenerek öfkeyle çekip gider. Ardından [[character/1]] ikisinin de hissettiğini dile getirir: pilot bütün gün koloni için çalışır, çok az kazanır ve sabit fiyata alınıp götürülen av üzerinde hiçbir söz hakkı yoktur. Pilot yalnızca gezegenden ayrılacak bir bilet parası biriktirmek ister, ama [[character/1]] başka bir fikre sahiptir.", false],
		[12, "", "Telsiz bantlarını tararken [[character/1]], [[station/3]] istasyonundan yayın yapan bir direniş hareketinin izlerini yakalamıştır. Seçim pilota bırakılır; pilot bunun ciddi bela anlamına gelebileceğini bilir ve yine de gider. Bundan sonra [[character/1]] hareketin istasyonlarını haritada yeşille işaretler (bkz. [[faction/rebels]]).", false],
		[12, "", "[[chapter/12]] bölümünde [[station/3]] istasyonuna sessizce yaklaşma girişimi hemen başarısız olur. İstasyonun muhafızları gemiyi durdurup ateş açmakla tehdit eder; pilot kekeleyerek bir ad verir, yolculuğun [[station/0]] istasyonunda başladığını söyler ve katılmak istediğini belirtir. Uzun bir sessizliğin ardından gemiye yanaşma izni verilir.", false],
		[13, "", "İçeride [[character/4]] yeni geleni bir dizi karmaşık soruyla sorgular. Pilot, hareketin serbest ticareti desteklediği dışında neredeyse hiçbir şey bilmediğini itiraf eder. Bu da [[character/4]] adlı direnişçinin, asilerin telsiz trafiğini daha birkaç gün önce şifrelemeye başladığı yönündeki itirafıyla örtüşür. Yardımcı sıkıntısı çeken [[character/4]], pilotu deneme süresiyle kabul eder. Hareket, kolonist istasyonlarına sızmayı, yöneticilerini taraf değiştirmeye ikna etmeyi ve gezegenle sakinlerinin sömürülmesine son vermeyi amaçlamaktadır.", false],
		[13, "", "[[character/4]] planlarını bir yabancıyla paylaşmaz, bu yüzden pilot önce işe yaradığını kanıtlamalıdır. [[chapter/13]] bölümünde görev, [[station/4]] istasyonundaki sempatizanları alıp [[station/5]] istasyonuna götürmektir. Yolda pilot, [[character/1]] karşısında bütün işin bir muamma olduğunu itiraf eder, ama bunun [[character/9]] adlı yetkiliden emir almaktan iyi olduğunda hemfikirdir.", false],
		[14, "", "[[station/4]] istasyonundaki irtibat kişisi tek bir yolcudur: [[character/5]]. Sıcakkanlı ve hazırcevaptır, pilotla tanıştığına açıkça memnundur; pilot da ondan en az o kadar açıkça etkilenir. Hareketin planlarını açıklamaz, hareketin bu kadar uzun süre ayakta kalmasının nedeninin gizlilik olduğunu söyler ve yolculuğun koordinatlarını gönderir. [[character/1]] ikisini açık bir rahatsızlıkla izler, pilot da bunu kıskançlık diye takılır. [[chapter/14]] bölümünde pilot, [[character/5]] adlı yolcuyu olabildiğince hızlı ve güvenli biçimde [[station/5]] istasyonuna götürür.", false],
		[15, "", "[[station/5]] istasyonunda [[character/5]], bazı işlerini halletmek için gizlenir; ama önce asilerin kolonistlerle neden arasına mesafe koyduğunu açıklar. Asiler denizin kaynaklarını sömürüp tüketmez. Denizin verebileceği kadarını alır, avı mala dönüştürür ve aşırı avlanmamaya özen gösterirler; böylece denizdeki yaşam çeşitliliği korunur. Bunun nasıl işlediğini göstermek için pilottan bir direniş istasyonunun fabrikasında beş ton mal üretmesini ister ([[chapter/15]]). Bunun için [[station/90]] istasyonunu önerir: orada kalamar avlanabilir ve [[goods/22]] yapmak için [[goods/35]] satın alınabilir.", false],
		[16, "", "Pilot bu ikinci kazanç yolunu öğrenince [[character/5]] yeni bir görevle arar. Hareketin, zayıf noktaları bulmak ve halkı kendi tarafına çekmek için her istasyondan güncel raporlara ihtiyacı vardır, çünkü ikna da ateş gücü kadar önemli olacaktır. Pilot bunun bir devrim anlamına gelip gelmediğini sorunca daha fazlasını söylemeyi reddeder. [[chapter/16]] bölümünde pilot daha önce görmediği istasyonları dolaşır ve bu arada gemi yükseltmeleri için para kazanır.", false],
		[17, "", "[[character/4]] adlı direnişçiden gelen ve [[character/1]] tarafından tek satırda özetlenen uzun bir mesaj, [[chapter/17]] bölümünde pilotu [[station/3]] istasyonuna geri çağırır. Bu arada asi bölgesi büyümektedir: [[station/6]], [[station/12]], [[station/106]] ve [[station/180]] harekete katılmıştır.", false],
		[18, "III. Perde: Lider", "[[character/4]], diplomasinin asi bölgesini sessizce genişlettiğini, bu yüzden pilotun artık çok daha fazla istasyonda ticaret yapabileceğini açıklar. Haber kanalları şimdiden bir devrimden söz etmektedir. Pek çok karar verici tek kurşun atılmadan katılmıştır, ama [[character/4]] er geç kan döküleceğini düşünür. Sonraki adımları hareketin lideri, yeni kazanılan istasyonlardan birinden yönetmektedir; pilot bu lideri bulmalı, daha doğrusu onun tarafından bulunmalıdır. [[character/4]] aday istasyonları işaretler ve bazılarına daha iyi zırh ya da kalkan olmadan ulaşılamayabileceği konusunda uyarır.", false],
		[18, "", "[[character/1]] hareketin örgütlenmesinden pek etkilenmez; [[chapter/18]] bölümü de elde şanstan başka pek bir şey olmadan yürütülen bir aramaya dönüşür.", false],
		[19, "", "İz [[station/6]] istasyonunda son bulur. Pilot orada hareketi yöneten ve bundan sonra emirleri verecek olan yaşlıca bir kadınla, [[character/2]] ile tanışır. Pilot liderin bir erkek olduğunu sanmıştır; lider bu yanılgıyı önemsemez. İlk görevi bir eskortluktur. Bir [[species/10]] sürüsü, kolonistler hayvanları yakalamadan ya da öldürmeden önce [[station/7]] istasyonu yakınındaki güvenli sulara yönlendirilmelidir ve bir çatışma olasıdır. [[character/1]] kimsenin ücretten söz etmediğine söylenir; pilot ise [[character/2]] adlı liderin önce yeni gelene güvenilip güvenilemeyeceğini öğrenmek istediğini düşünür.", false],
		[19, "", "[[chapter/19]] bölümünde pilot, sürünün yanında yüzen Aquarianlarla karşılaşır; [[character/1]] onların denizin canlılarını koruyup korumadığını merak eder. Çok geçmeden kolonist gemileri yaklaşır ve pilot onları hayvanları vurmadan durdurmak zorundadır.", false],
		[20, "", "Sürü hayatta kalır. [[character/2]] mütevazı bir 2.000 $ öder ve pilotu hemen geri çağırır; [[character/1]] ise hayvanları satmanın çok daha kârlı olacağından yakınır. [[chapter/20]] bölümünde pilot [[station/6]] istasyonuna döner.", false],
		[21, "", "Bu kez pilot hareketin neyi amaçladığını açıkça sorar. [[character/2]], gezegenin ve sakinlerinin yıkımına karşı birleşmiş bir topluluğu anlatır. Kolonileşme öyle hızlı ilerlemekte ve doğa öyle acımasızca sömürülmektedir ki denizin bitkileri ve hayvanları yakında kendini yenileyemez hâle gelecektir. Hiçbir şey değişmezse gezegen, kendinden önceki pek çok dünya gibi tükenecektir. Hareket bunu önemli karar vericileri kendi yanına çekerek önlemeyi amaçlar; pilot da yardım edeceğine söz verir.", false],
		[21, "", "[[character/2]] adlı liderin acil kaygısı, çatışmayı kolay hedefleri avlamak için kullanan [[faction/pirates]] grubudur. Hareket şimdiye dek yalnızca kendini savunmuştur; şimdi bir korsan filosuna doğrudan saldıracaktır. Lider, gergin pilotu yatıştırmak için en iyi pilotlarından birini, [[character/3]] adlı pilotu eskort olarak ekler; ama [[character/1]], aslında eskortluğu pilotun yapacağından şüphelenir. [[chapter/21]] bölümünde ikili [[station/8]] istasyonu yakınında buluşur. [[character/3]], geç kalan yeni geleni sabırsızlık ve küçümsemeyle karşılar ve pilota arkasında kalıp öğrenmesini söyler.", false],
		[22, "", "Çete yok edilir. [[character/3]] isteksizce övgüde bulunur, ama [[character/2]] ikisini de 5.000 $ ile ödüllendirince paranın eşit bölünmesine öfkelenir ve pilota, yeni gelenin hiçbir katkısı olmadığını söyler. Pilot ile [[character/1]], öfkesi daha da kabarmadan oradan ayrılır. [[chapter/22]] bölümünde, oradaki görüşmeleri başarıya ulaşan [[character/2]] ile buluşmak için [[station/9]] istasyonuna giderler: istasyon; [[station/5]], [[station/37]] ve birkaç başka istasyonla birlikte harekete katılmıştır.", false],
		[23, "", "[[character/2]] yoluna devam etmeden önce [[station/37]] istasyonuna giden ikmal yolunun güvenceye alınması gerekir. [[character/9]], yolu kesmek için istasyonun hemen dışına bir mayın tarlası döşetmiştir. [[character/2]] onu tanır: bir zamanlar önemsiz biriyken iyi yerlerdeki dostları sayesinde hızla yükselmiştir. Onun planlarını bozmaya hevesli pilot, [[chapter/23]] bölümünde mayın tarlasını temizlemeye koyulur. [[character/2]], yakınlarda korsanların dolaşacağı ve her mayının ancak pilot, hareket sensörünü tetikleyecek kadar yaklaştıktan sonra yok edilebileceği konusunda uyarır.", false],
		[24, "", "Mayın tarlası temizlenir, yol yeniden güvenli olur ve [[character/2]] bu iş için 4.000 $ öder. [[chapter/24]] bölümünde [[station/9]] istasyonuna dönen pilot, asi bölgesini çok daha geniş bulur. Okyanusun dört bir yanından bir istasyon dalgası artık hareketin yanındadır; aralarında [[station/14]], [[station/22]] ve [[station/25]] de vardır.", false],
		[25, "", "İstasyonda pilot, [[character/5]] ile yeniden buluşur; konuşmaları sıcak ama biraz beceriksizdir ve [[character/1]] istenmeyen tavsiyeler verir. [[character/2]] bu buluşmayı kısa keser. [[station/10]] istasyonundaki bir görüşme turu başka istasyonları da kazandırabilir; pilot ile [[character/5]], lidere ve [[character/3]] adlı pilota oraya kadar eskortluk edecektir. Pilot, [[character/3]] ile yola çıkmaya pek hevesli değildir, ama [[character/2]] onun becerisine kefil olur ve korsanlardan daha kötü bir şey beklemez.", false],
		[25, "", "[[chapter/25]] bölümünde grup [[station/10]] istasyonuna varır ve bir şeylerin ters gittiğini hemen sezer. [[character/9]] kolonist kuvvetleriyle beklemektedir ve saldırı emri verir; [[character/2]] ise onların geleceğini nasıl bildiğini anlayamaz.", false],
		[26, "IV. Perde: İhanet", "Çatışma sırasında [[character/3]] ateş etmez, silahlarının arızalandığını iddia eder ve özür dileyerek kaçar. Grubun geri kalanı hayatta kalır. [[character/2]] bir sabotajdan şüphelenir, [[character/5]] ise [[character/3]] adlı pilotu açıkça ihanetle suçlar; [[character/2]] onu savunur ve kendisine her zaman sadık kaldığını söyler. Pilot olayın şüpheli göründüğünü kabul eder, ama [[character/9]] daha fazla gemi getirmeden herkesin oradan ayrılmasını ister.", false],
		[26, "", "Grup dağılır. [[character/2]] saklanır, [[character/5]] ise hareketin işlerini [[station/9]] istasyonunda yürütmeye devam eder. Pilota, yeniden buluşmadan önce çok daha iyi bir savaşçı olması söylenir, çünkü mücadelenin yalnızca diplomasiyle kazanılamayabileceği artık açıktır. [[chapter/26]] bölümünde pilot, öldürme sayısını artırmak için korsanları ve diğer düşmanları avlar.", false],
		[27, "", "Pilot daha tehlikeli bir hâle geldiğinde [[character/3]] habersizce arar. [[character/2]] ve [[character/5]] hakkında soru sorar, uzaktayken hayati bilgiler topladığını iddia eder ve [[station/11]] istasyonu yakınında bir buluşma ister. [[character/1]] bunun bir tuzak olduğundan emindir; pilot da aynı fikirdedir, ama yine de gider ([[chapter/27]]).", false],
		[28, "", "Tuzak gerçektir. [[character/3]], [[character/2]] adlı lideri esir tutmakta ve pilotun teslim olmasını istemektedir; [[character/2]] ise pilota kendisini umursamamasını söyler. [[character/1]] adlı bilgisayarın tavsiyesiyle pilot, bilgisayar gemiyi tararken [[character/3]] adlı haini konuşturmayı sürdürür. [[character/3]], para için taraf değiştirdiğini açıkça itiraf eder: [[character/2]] az ödüyordu, [[character/9]] ise hem lider hem de pilot için büyük bir ödül koymuştur. Pilot hareketin ideallerine seslenince [[character/3]], ideallerin sofraya ekmek getirmediği karşılığını verir.", false],
		[28, "", "Tarama gemide tek kişilik yer olduğunu gösterir; demek ki [[character/2]] ağır zırhlı kargo bölmesine kilitlenmiş olmalıdır. Pilot ateş açar. [[character/3]] hızlı ve tehlikeli olduğunu gösterir, ama gemisi yok edilir; pilot da kargo konteynerini fazla derine batmadan zıpkınlar. [[chapter/28]] bölümünde pilot konteyneri en yakın güvenli istasyon olan [[station/12]] istasyonuna taşır ve [[character/1]] adlı bilgisayarın içeriği doğru tahmin etmiş olmasını umar.", false],
		[29, "", "[[character/1]] haklı çıkar. [[character/2]] sarsılmış ama yarasız çıkar ve hayatını kurtardığı için pilota teşekkür eder. Dinlenmeye vakit yoktur: kaçırılmadan önce yüksek nitelikli bir bilim insanı ekibinin [[station/14]] istasyonuna nakledilmesini organize etmekteydi ve [[character/3]] ayrıntıları çoktan aktarmış olabilir. Bilim insanlarının neden önemli olduğunu henüz açıklamaz ve pilotu, konvoylarının sınır bölgesini güvenle geçmesini sağlamaya gönderir ([[chapter/29]]). Pilot, [[station/13]] istasyonu yakınında konvoyu çoktan ağır saldırı altında ve yardım çağırırken bulur.", false],
		[30, "", "Konvoy geçer; mürettebatı hayatta kalmalarını pilota borçlu olduklarını söyler. [[character/2]] 5.000 $ öder ve sonraki adımı açıklamaya söz verdiği [[station/14]] istasyonunda bir toplantı ister ([[chapter/30]]).", false],
		[31, "V. Perde: Üç adım", "[[station/14]] istasyonunda [[character/5]], [[character/4]] ve [[character/2]] beklemektedir; [[character/2]] sonunda pilotu planına ortak eder. Kolonistlerle çatışmalar sıklaşmaktadır ve asiler hâlâ sayıca azdır; bu yüzden lider, dengeyi değiştirebilecek bir silah yapmaları için [[world/abel|Profesör Abel'ı]] ve ekibini istasyona getirmiştir. Proje üç adımdan oluşur. İlki bir güç kaynağıdır: yıllardır incelenen ama hiçbir zaman çalışan bir prototip ortaya çıkaramayan bir teknoloji olan [[world/biotek|Biotek jeneratörü]]. Abel bir prototipi bitirmek üzereyken kolonistler onu çalmıştır ve şimdi kendileri tamamlamaya çalışmaktadır.", false],
		[31, "", "[[character/2]], Abel ile buluşmak için ayrılır ve brifingi [[character/5]] devralır. Bir muhbire göre jeneratör, dikkat çekmemek için sıradan kargo gemileriyle Maarth yönüne taşınmaktadır; bu da asilere [[station/2]] istasyonu yakınında saldırma fırsatı verir. Hangi geminin onu taşıdığını kimse bilmediğinden, ister istemez tüm konvoy durdurulmalı ve her konteyner kurtarılmalıdır. [[chapter/31]] bölümünde pilot, [[character/5]] ve [[character/4]] konvoyun yolunu keser. Mürettebat yalnızca yiyecek ve ilaç taşıdıklarını söyleyerek yalvarır; [[character/4]] ise asilerin tam da bu ikisine fena hâlde ihtiyacı olduğu karşılığını verir.", false],
		[32, "", "Her konteyner kurtarılır ve [[chapter/32]] bölümünde ekip ganimeti [[station/14]] istasyonuna geri getirir.", false],
		[33, "", "Abel, prototip üzerinde çalışmak için kargoyu laboratuvarına götürür ve [[character/2]] yeni görevler dağıtır. [[character/5]] ani saldırılara karşı istasyonun dışında devriye gezecek, [[character/4]] hangarda gerekecek, pilot ise ikinci adımı üstlenecektir. Jeneratörün gücüne layık bir silah gerekir ve [[character/2]], devasa enerji ihtiyacı yüzünden şimdiye dek hiçbir gemiye takılmamış bir [[world/eclipse|sabit savunma topu]] olan [[equipment/42]] silahını seçmiştir.", false],
		[33, "", "Bu topları üreten en yakın istasyon olan [[station/188]] kolonistlerin elindedir; bu yüzden [[character/2]] pilotu bunun yerine asilerin elindeki [[station/15]] istasyonuna gönderir. Silah hiçbir yerde satılmaz ve liderin planı da burada biter. Gerekebilecek rüşvetler için pilota 100.000 $ vermekle yetinir. Pilot bunu duyduğu en belirsiz plan diye niteler ve memnuniyetle kabul eder; [[chapter/33]] bölümü de pilotu etrafa bakmak üzere istasyona götürür.", false],
		[34, "", "Ne bağlantısı ne de gerçek bir planı olan pilot, işe yerel tüccarın mallarına göz atarak başlar. [[chapter/34]] bölümünde iz, istasyonda yasa dışı bir uyuşturucu olan [[goods/37]] kargosuna çıkar.", false],
		[35, "", "Bu alışveriş, kendinden üçüncü şahıs olarak söz eden ve neredeyse her şeyi temin edebileceğini iddia eden karaborsacı [[character/8]] adlı satıcının ilgisini çeker. Ondan [[equipment/42]] istenince şaşırır ve pilotun bir savaş başlatmak isteyip istemediğini merak eder. Yine de bir iyilik karşılığında denemeyi kabul eder: güvenlik yönetiminin [[character/8]] adlı satıcıdan kurtulmak için tuttuğu ödül avcısı [[character/11]] ölmelidir. [[chapter/35]] bölümünde pilot, [[character/11]] adlı avcıyı kendi eskortlarıyla istasyon yakınında devriye gezerken bulur. Avcı pilotu sıradan bir balıkçı diye savuşturur.", false],
		[36, "", "Çatışma aleyhine dönünce [[character/11]] dil dökerek kurtulmaya çalışır, ama gemisi yok edilir. Pilot, [[chapter/36]] bölümünde satıcının sözünü tutacağını umarak [[station/15]] istasyonuna döner.", false],
		[37, "", "[[character/8]] sözünü tutar. Bir [[equipment/42]] bulmuştur ve onu, ödediğini iddia ettiği rüşvetler yüzünden şişmiş bir fiyata satacaktır. Böyle bir topu nasıl ele geçirdiği sorulunca satıcının adını verir: [[character/9]]. [[character/1]], [[character/9]] adlı yetkilinin açgözlülüğünün en büyük düşmanlarını silahlandırmasındaki ironiden keyif alır. [[chapter/37]] bölümünde pilot topu satın alıp gemiye yükler.", false],
		[38, "", "Top ambardayken ikinci adım tamamlanmıştır; [[chapter/38]] bölümünde pilot, prototipin ne durumda olduğunu görmek için [[station/14]] istasyonuna döner.", false],
		[39, "", "[[character/2]], topun nasıl elde edildiğini bilmemeyi tercih eder ve yalnızca kan dökülmemiş olmasını umar; pilotun temkinli yanıtı, hiçbir masum insanın ölmediğidir. Prototip neredeyse bitmiştir, ama istasyonda yapılamayan küçük bir cihaz eksiktir: alg parçacıklarının genetik malzemesini kopyalayarak jeneratörü besleyen tepkimeyi başlatan bir [[goods/36]]. [[character/2]], yalnızca Abel'ın açıklamasını tekrarladığını kabul eder. Pilot cihazı alaycı bir dille bütün gezegeni boyunduruk altına almaya giden üçüncü adım diye niteleyince lider bu fikri sertçe reddeder.", false],
		[39, "", "İnkübatörü yapacak donanım yalnızca [[station/16]] istasyonunda vardır; bu yüzden [[chapter/39]] bölümü üçüncü adım için pilotu oraya gönderir. [[character/1]], pilotun bütün isyanı tek başına yürütüyor gibi göründüğünden yakınır.", false],
		[40, "", "İstasyonda inkübatörü yapmanın hiç de basit olmayacağı anlaşılır ve [[chapter/40]] bölümü zahmetli bir üretim işine dönüşür.", false],
		[41, "", "İnkübatör tamamlanır; [[character/1]] şaşkınlığını gizlemez. Tüm bunların doğru olup olmadığından hâlâ emin olmayan pilot, [[chapter/41]] bölümünde onu [[station/14]] istasyonuna taşır.", false],
		[42, "", "[[character/5]] pilotu ve inkübatörü sevinçle karşılar; [[character/1]] ise dinlemek yerine kendini kapattığını duyurur. Abel her şeyi hazırlamıştır ve [[equipment/42]] yakında hangarda bulunabilecektir. [[character/2]] topun hemen korsanlara karşı denenmesini ister; [[character/5]] koordinatları iletir ve jeneratörün hâlâ yalnızca bir prototip olduğu konusunda uyarır. Güya bekleme modunda olan [[character/1]], her kelimeyi duyduğunu açıkça belli eder.", false],
		[42, "", "[[chapter/42]] bölümünde pilot topu takar ve [[station/17]] istasyonu yakınındaki bir korsan sığınağına saldırır. Korsanlar neyle karşı karşıya olduklarını çabucak anlar ve takviye çağırır.", false],
		[43, "VI. Perde: Okyanus için savaş", "Deneme, [[station/14]] istasyonundan şifresiz bir kanalda açıkça yayınlanan bir imdat çağrısıyla yarıda kalır. [[chapter/43]] bölümünde hızla geri dönen pilot, istasyonu ani bir kolonist saldırısı altında bulur. Pek çok rıhtım vurulmuştur, çok az asi gemisi denize açılabilmektedir ve [[character/2]] sonun geldiğine inanır. Saldırıyı [[character/9]] yönetir ve asiler adına balık tuttuğu için pilotla alay eder, ta ki [[equipment/42]] silahının ateşlenmek üzere olduğunu öğrenene dek.", false],
		[44, "", "Savaşın ortasında [[world/aquarians|Aquarianlar]] gelir ve kolonistlerin üzerine çullanarak asilerin yanında savaşır. Saldırı çöker ve [[character/9]], kaybedildiğini görünce savaşı terk eder. [[character/2]] kurtuluşu bir mucize olarak niteler ve özel bir misafir vaat ederek pilottan yanaşmasını ister ([[chapter/44]]).", false],
		[45, "", "[[character/2]], kimse kolonistlerin asi sularının bu kadar derinine saldırmasını beklemediği için baskının asileri hazırlıksız yakaladığını ve savunmanın yalnızca onların başarısı olmadığını kabul eder. Misafir, insan dilini biraz anlayan bir Aquarian temsilcisidir. Onun aracılığıyla Aquarianlar, kolonistlerin egemenliğine son vermeye yardım etmeyi önerir. Her istasyon alınıp kolonist filosu yenildiğinde herkes doğayla uyum içinde yaşayacaktır.", false],
		[45, "", "Aquarianların yardımıyla [[character/2]], kuzey ve güney yarımkürelerde kalan istasyonları almak için iki büyük taarruz planlar. [[station/188]] düşmüştür ve asiler olabildiğince çok gemiye [[equipment/42]] takmaktadır. Sürpriz etkisinden yararlanmak için lider, [[station/18]] saldırısının komutasını pilota verir ve [[character/5]] adlı direnişçiyi [[station/109]] üzerine gönderir. Pilot [[character/5]] için endişelenince [[character/2]], pilotun belli olan sevgisine takılır ve [[character/5]] adlı direnişçinin de yetenekli bir pilot olduğunu hatırlatır.", false],
		[45, "", "[[chapter/45]] bölümünde pilot vardığında Atmos birliğinin lideri [[character/12]], saldırı emrini beklemektedir; bu sırada bir grup Aquarian derinliklerden yükselir. Yük gemileri dahil her kolonist gemisi yok edilmelidir.", false],
		[46, "", "Savunucular yok edilir. Pilot, [[character/12]] adlı liderin birliğinin yarısını istasyon çevresinde devriyeye gönderir ve [[chapter/46]] bölümünde geri kalanıyla yanaşır. Aynı anda devasa bir istasyon dalgası taraf değiştirir: [[station/1]] ve [[station/2]] istasyonlarından [[station/11]], [[station/18]] ve [[station/109]] istasyonlarına kadar.", false],
		[47, "", "[[character/5]] arayıp kendi saldırısının da başarılı olduğunu ve [[equipment/42]] silahının yıkıcı olduğunu bildirir; pilot, Aquarianlara da aynı ölçüde pay verir. Güneydeki tüm istasyonlar artık asilerin elindedir. [[character/2]], son görev olabilecek işi bildirmiştir: kolonistlerin son büyük kalesi ve pilotun hikâyesinin başladığı istasyon olan [[station/0]]. İstasyon güçlü biçimde tahkim edilmiştir ve [[character/2]] saldırıyı bizzat yönetmek için çoktan yola çıkmıştır. [[character/5]] de onu izler ama yolda korsanlar yüzünden gecikir; [[chapter/47]] bölümünde pilot son savaş için onlara katılır.", false],
		[47, "", "Savunmayı [[character/9]] yönetir ve pilotun gemisini yok etmekten zevk alacağıyla övünür; pilot bu sözlerde [[character/3]] adlı hainin son sözlerinin yankısını tanır. [[character/3]] adlı haini kimin öldürdüğünü öğrenen [[character/9]], pilotun babası olduğunu ve [[character/3]] adlı hainin de pilotun kardeşi olduğunu iddia ederek pilotu sarsmaya çalışır. Hiç kardeşi olmayan ve babasının yüzünü çok iyi hatırlayan pilot, bu yalanı hemen geri çevirir.", false],
		[48, "", "Kolonist filosu gemi gemi erir, ta ki geriye yalnızca [[character/9]] kalana dek. Hızlıdır ve vurulması zordur, ama [[character/1]] adlı bilgisayarın tavsiyesiyle pilot saldırılarından kaçar ve arkadan vurur. [[character/9]] bir kurtarma kapsülüyle kaçar ve [[character/5]] adlı direnişçinin inanamayan bakışları altında bütün istasyonu da beraberinde götürüyormuş gibi görünür. Gitmeden önce derinliklerde sahip olmaya değer hiçbir şey olmadığını ve zaten balığı hiç sevmediğini söyleyerek küçümser.", false],
		[48, "", "[[character/9]] gidince savaş sona erer ve [[chapter/48]] bölümünde [[station/0]] ile son direnen istasyonlar harekete katılır. Pilot zaferin herkese ait olduğunda ısrar eder. [[character/1]] övgüden payını ister ve pilot karaya döndüğünde bir bellek yükseltmesi sözü alır; bilgisayar buna ihtiyacı olmadığını öfkeyle bildirir. [[character/2]] hepsine teşekkür eder ve gezegenin yaralarının iyileşmesinin uzun süreceğini kabul eder, ama bunu da başarabileceklerinden emindir. [[character/5]], pilotu [[goods/21]] eşliğinde kutlamaya davet eder ve pilot memnuniyetle kabul eder.", false],
		[48, "Temalar", "Ana çatışma denizin nasıl kullanılması gerektiğiyle ilgilidir. Koloni denizi hasat edilip yörüngeye gönderilecek bir kaynak olarak görür: avı sabit fiyatlarla satın alır ve yoluna çıkan yaban hayatını itlaf eder. Hareket ise yalnızca denizin verebileceğini almayı, yaşam çeşitliliğini korumayı ve serbestçe ticaret yapmayı savunur. Pilotun ilk işleri, yani nautilus itlafı ve kapsül savunması, koloninin iş görme biçimini içeriden gösterir. Pilotun bu işlerden giderek artan rahatsızlığı da direnişe yönelişini inandırıcı kılar.", false],
		[48, "", "Aquarianlar da aynı yolu izler. Önce koloninin kapsüllerine saldıran zararlılar olarak görünürler ve pilot onları püskürtmesi için para alır. Sonra deniz canlılarını kollarken görülürler ve [[station/14]] istasyonunda kaybedilmiş bir savaşı tersine çevirirler. Geriye bakınca ilk baskınları, okyanusun yağmalanmasına karşı kendi direnişleri gibi görünür; ancak oyun güdülerini büyük ölçüde okurun çıkarımına bırakır.", false],
		[48, "", "Para ve sadakat hikâyenin her yanına işlemiştir. [[character/3]] bir ödül için hareketi satar; [[character/9]] ise daha sonra [[station/14]] saldırısını kıracak olan topu bizzat satar. Pilot yalnızca eve dönüş bileti parası isteyerek başlar ve hareketin komutanlarından biri olarak bitirir; [[character/1]] adlı bilgisayarın düşük ücret yakınmaları ise bir güdü olmaktan çıkıp süregelen bir şakaya dönüşür.", false],
		[48, "", "Hareket ilk kazanımlarının çoğunu iknayla elde eder; [[station/10]] istasyonundaki pusu, iknanın artık yetmediği noktayı işaret eder. Sefer ardından çemberi [[station/0]] istasyonunda kapatır: bir zamanlar [[character/9]] adlı yetkilinin av için pilota sabit fiyat ödediği istasyonda. Son bölümden sonra pilot, artık asilerin yanında duran bir okyanusta balık tutmakta, ticaret yapmakta ve sözleşme almakta özgürdür.", false],
	],
	"world/ocean": [
		[1, "", "Okyanus, DEEP'in geçtiği yerdir: yaşanabilir dünyası dalgaların çok altında kalan bir gezegen. Yerleşimciler binlerce metre derinlikteki basınçlı istasyonlarda yaşar ve istasyonlar arasında gidip gelmenin tek yolu denizaltılardır. Koloninin yediği, sattığı ve ürettiği her şey, balıktan algden onlardan yapılan mallara kadar, sudan çıkar. Bu makale okyanusu bir yer olarak anlatır: derinliklerini, ışığını, yaban hayatını ve bu yaşamın onu avlayan insanlara verdiği tepkiyi.", false],
		[1, "", "Pilot buraya küçük bir balıkçı denizaltısı ve gemi bilgisayarı [[character/1]] ile yeni biri olarak gelir ve çok geçmeden hiç gelmemiş olmayı diler. İstasyonları yönetenler için bkz. [[world/colony]]; istasyonlar arası yolculuk için bkz. [[world/stream]].", false],
		[1, "Derinlik ve basınç", "Okyanusun belirleyici özelliği derinliktir. Dalışı durduracak bir deniz tabanı yoktur: bir denizaltı, su onu ezene dek batmayı sürdürebilir. Bir gemiyi hayatta tutan, ekipmanının belirlediği güvenli bir derinlik aralığıdır. Kalkan geminin ne kadar yükselebileceğini, zırh ise ne kadar derine inebileceğini belirler. İkisi de olmayan bir gövde yalnızca yaklaşık 22.000 ile 23.000 m arasındaki dar bir su diliminde güvendedir.", false],
		[1, "", "Aralığının dışında bir gemi basınç altında ezilir. Birkaç saniyelik bir aradan sonra su korumasını aşındırmaya başlar, önce bir katmanı, sonra gövdenin kendisini; gemi 15.000 m'nin üstüne ya da 30.000 m'nin altına ne kadar uzaklaşırsa hasar o kadar büyür. Kısa sapmalar atlatılabilir, uzun olanlar atlatılamaz. Her ekipmanın değerleri kendi sayfasındadır; kuralların tamamını [[guide/depth]] açıklar.", false],
		[1, "İstasyonların konumu", "[[chart]] üzerindeki iki yüz istasyon sabit derinliklere demirlenmiştir ve neredeyse hepsi 15.000 ile 30.000 m arasındadır. Yarıdan fazlası, toplam 109 istasyon, başlangıç gemisi [[ship/0]] için erişilebilir olan 20.000 ile 25.000 m aralığında yer alır. Yaklaşık elli istasyon daha sığda, yaklaşık kırk beşi ise daha derindedir. Uç örnekler, 13.500 m ile en yüksekteki [[station/28]] ve 32.250 m ile en derindeki [[station/81]] istasyonlarıdır.", false],
		[1, "", "Derinlik coğrafyayı izlemez. Sığ ve derin istasyonlar haritanın her yerinde yan yanadır; bu yüzden haritada komşu olan istasyonlar arasında binlerce metrelik dikey fark olabilir. Haritanın ortasına yakın [[station/14]] istasyonundan hem 17.700 m'deki [[station/25]] hem de çok aşağıdaki [[station/81]] kolayca erişilebilir. Rota planlayan bir pilot yalnızca mesafeyi değil, her istasyonun derinliğini de okumalıdır. Pilotun kariyerinin başladığı [[station/0]], kuzeybatıda 22.500 m'dedir.", false],
		[1, "Işık ve su", "İstasyonlara gün ışığı ulaşmaz. Projektörlerle aydınlatılan gövdelerinin dışında su karanlıktır ve bir denizaltı, suyun birkaç düzine metre içinde yuttuğu kendi farlarının ışık konisiyle yol alır. Işık huzmelerinde ince parçacıklar asılı durur ve sürüklenir; yer yer ışıldayan plankton kümeleri karanlıkta soluk soluk parlar. Uzaktaki yüzeye doğru 15.000 m'nin üstüne çıkmak, başlı başına bir başarı olarak kaydedilir: [[medal/21]].", false],
		[1, "", "Suyun rengi her yerde aynı değildir. Her bölge, orada gelişen plankton ve alglerden hafif bir renk alır; bu renk, o alglerin en rahat ettiği istasyonların yakınında en belirgindir. Yavaş akıntılar asılı parçacıkları hareket ettirir, ama bunlar yalnızca manzaranın parçasıdır: bir denizaltıyı asla rotasından saptırmaz ya da bir avı alıp götürmezler.", false],
		[1, "Deniz yaşamı", "Okyanus on üç hayvan ve beş alg türüne ev sahipliği yapar. Bunlar [[species/2|denizanaları]], [[species/0|nautiluslar]] ve [[species/4|balık sürüleri]] gibi küçük ve kolay avlardan, [[species/7]] ve [[species/8]] gibi güçlü yüzücülere kadar uzanır. Daha derin denizlerin tuhaf canlıları arasında [[species/5]], [[species/1]], [[species/6]], [[species/9]] ve zırhlı [[species/11]] vardır. [[species/3]] ile renk değiştiren [[species/10]], deri ve boya için değerlidir.", false],
		[1, "", "En büyük hayvan, yaklaşık 30 t ağırlığa ulaşabilen ve küçük bir denizaltının bütün ambarından ağır gelen [[species/12]] canlısıdır. Daha ağır ve dayanıklı hayvanlar zıpkında daha uzun direnir ve genellikle daha çok para getirir, ama hiçbir türün değeri her yerde aynı değildir. Her tür sayfası, türün sularında yaşadığı istasyonları ve ondan yapılan malları listeler.", false],
		[1, "", "Her istasyonun genellikle beş ya da altı türden oluşan kendine özgü bir yaban hayatı karışımı vardır. Bir istasyonun sularında herhangi bir anda, bu yerel karışımdan seçilmiş yaklaşık yirmi hayvan yüzer. Bir balıkçı hangi av için hangi istasyonlara gideceğini çabucak öğrenir; harita da daha önce yakalanmış her türün nerede bulunduğunu gösterebilir. Bkz. [[guide/fishing]].", false],
		[1, "Deniz tabanı ve algler", "Beş alg, yani [[species/17|yeşil]], [[species/16|kırmızı]], [[species/15|kahverengi]], [[species/14|mavi]] ve değerli [[species/13|altın]], okyanusun bitkileridir. Yüzmek yerine yerlerine kök salmış olarak büyür, her biri sabit 2 t ağırlığındadır ve zıpkında neredeyse anında pes eder. Değerleri dönüştükleri şeydedir: [[goods/21]] yeşil alg, [[goods/27]] altın ve kırmızı alg, [[goods/28]] ise beşinden de biraz gerektirir.", false],
		[7, "", "Algler, başka küçük organizmalarla birlikte istasyonların dış yüzeylerinde de büyür. Bunlar nautilusların en sevdiği besindir; bu hayvanların istasyonların çevresinde kalabalık hâlde toplanmasının nedeni de budur.", false],
		[1, "Canlı dünyanın tepkisi", "Hayvanlar öylece yakalanmayı beklemez. Silahla ya da yanlışlıkla yaralanan bir canlı fırlayıp kaçar, zıpkınlanan bir canlı da yorulana dek çırpınır. Doğrudan öldürülen bir hayvan av olarak kaybedilir: leşi yukarı doğru yüzer ve ancak canlı hayvanın değerinin küçük bir kısmını eden [[goods/18]] olarak toplanabilir. Temiz bir av isteyen pilotlar silahlarını balıklardan uzak tutar.", false],
		[1, "", "Oyunda sular asla tükenmez. Pilot başka yere gidince geride kalan yaban hayatının yerini yenisi alır, böylece iyi bir av sahası iyi kalır. Denizin canlıları üzerindeki çekişme bunun yerine iş panosunda görünür: bazı işverenler bir türün avlanması için, bazıları ise bir hayvan sürüsünün avcılardan korunması için ödeme yapar. Bkz. [[contract/7]] ve [[contract/6]].", false],
		[4, "", "Pilotun bir silahı olduğu andan itibaren [[character/1]], tam da yakalamaya geldikleri balıklara ateş etmemesi konusunda uyarır.", false],
		[7, "", "Koloni, yoluna çıkan yaban hayatını ortadan kaldırılması gereken bir baş belası olarak görür. [[chapter/7]] bölümünde pilot, konvoy rotalarını tıkadıkları söylenen nautilusları [[station/1]] istasyonunun sularından temizlemeye gönderilir.", false],
		[9, "", "İtlaf pek bir işe yaramaz. Parasını ödeyen yetkili, ne kadar çok hayvan temizlenirse temizlensin hep geri geldiklerini kabul eder.", false],
		[15, "", "[[faction/rebels]] denize farklı bakar. Okyanustaki yaşam çeşitliliğini korumak için yalnızca denizin verebileceği kadarını toplar, avlarını mala dönüştürür ve aşırı avlanmamaya özen gösterirler.", false],
		[19, "", "[[chapter/19]] bölümünde pilot, [[station/7]] istasyonu yakınında bir [[species/10|renk değiştiren kalamar]] sürüsünü kolonist avcılara karşı korur. Aquarianlar hayvanların yanında yüzer ve görünüşe göre onları kollar; bkz. [[world/aquarians]].", false],
		[21, "", "Asi lider [[character/2]] adlı kadına göre hızlı kolonileşme, okyanusu bitkilerinin ve hayvanlarının kendini yenileyebileceğinden daha hızlı tüketmektedir. Lider, bu böyle sürerse gezegenin kendinden önceki başka dünyalar gibi tükeneceği uyarısında bulunur.", false],
		[48, "", "Savaşın sonunda koloni yönetimi ortadan kalkınca asiler okyanusun iyileşmesinin uzun süreceğini düşünür, ama bu işi sonuna dek götürmeye kararlıdır.", false],
		[1, "Derinliklerin tehlikeleri", "Okyanus, basıncın yanı sıra insan kaynaklı tehlikeler de barındırır. [[faction/pirates]] açık sularda yalnız gemileri avlar ve sonraki bölümlerde bazıları istasyonların yakınında pusuya yatar. Mayın tarlaları, sürüklenen enkaz ve silahlı konvoylar sözleşmelerde ve hikâyede karşınıza çıkar. Okyanusun hangi bölümünü kimin denetlediği için bkz. [[world/colony]] ve [[guide/allegiance]].", false],
	],
	"world/stream": [
		[1, "", "S.T.R.E.A.M. ağı, koloninin istasyonlarını birbirine bağlayan geçiş kapıları sistemidir. Her istasyonun biraz dışında bir kapı vardır ve bir kapıya giren denizaltı neredeyse anında başka bir istasyonun kapısından çıkar. Ağ olmasaydı [[chart]] üzerinde bir uçtan öbürüne geçmek, karanlık açık sularda uzun yolculuklar demek olurdu. Ağ sayesinde tek bir pilot bütün okyanusta çalışabilir. Ağ, dünyanın kalıcı bir unsuru olduğu kadar oynanışın da merkezî bir parçasıdır; kontroller için bkz. [[guide/navigation]].", false],
		[1, "Kapılar", "Her istasyonun kapısı rıhtımlardan uzakta, açık sudadır. Gemiler bir istasyonun bölgesinden onun kapısıyla ayrılır ve varış noktalarının kapısına ulaşır; oradan yanaşmak için içeri seyreder. Bir kapı yakın mesafeden açılır: pilot etkinleştirme alanına girer ve erişilebilen her istasyonu listeleyen kapı haritasını açar.", false],
		[1, "", "Yolculuğun kendisi neredeyse anlıktır. Gemi karşı kapıdan hasarı değişmeden çıkar; yani hırpalanmış bir denizaltı vardığında da hırpalanmıştır. Varış noktasının yerel yaban hayatı, devriyeleri ve bekleyen herhangi bir karşılaşma zaten sudadır.", false],
		[1, "Menzil ve motorlar", "Bir kapı bütün okyanusa ulaşmaz. Herhangi bir istasyondan haritanın genişliğinin yaklaşık altıda birini kapsar. Daha iyi bir motor menzili değeriyle orantılı olarak artırır; yani +%30 değerli bir motor yaklaşık yüzde otuz daha uzağa ulaşır. Menzil dışındaki istasyonlar birkaç atlama ya da otopilotla uzun bir seyir gerektirir; seyir, zaman hızlandırmayla bile çok daha yavaştır.", false],
		[1, "", "Açık suda seyir kısa yolculuklar için yararlı olmayı sürdürür. Otopilot bir istasyonun bölgesinden sonrakine seyreder ve bu sırada zaman hızlandırma normal hızın on altı katına kadar çıkabilir; tehlike belirince yeniden yavaşlar.", false],
		[1, "", "Ağ derinliği hesaba katmaz. Bir kapı, bir uyarıdan sonra gemiyi güvenli derinlik aralığının dışındaki bir istasyona da seve seve götürür ve basınç, gemi varır varmaz korumasını aşındırmaya başlar. Yola çıkmadan önce varış noktasının derinliğini istasyon sayfasından kontrol edin. Bkz. [[guide/depth]].", false],
		[1, "Kapılar ve karşılaşmalar", "Bir çatışma sürerken kapılar kapalıdır. Bir istasyonun sularında etkin bir görev karşılaşması varsa, o çözülene dek ne kapı ne de rıhtım kullanılabilir. Bir pilot bir pusudan ağ üzerinden öylece kaçamaz; her sözleşme sonuna dek savaşılarak tamamlanmalı ya da başarısız olmalıdır.", false],
		[1, "", "Bir kapıdan varmak, belanın da başladığı andır. Bir istasyonun bölgesine girmek, aranan bir suçludan korunması gereken bir konvoya kadar orada bekleyen her karşılaşmayı tetikler. Devriye gemileri turlarını kapıların önünden geçerek atar ve sonraki bölümlerde korsanlar istasyonun yakınında bekliyor olabilir.", false],
		[1, "Ad", "Ağın adı her zaman kısaltma olarak, S.T.R.E.A.M. diye yazılır, ama oyun harflerin neyin kısaltması olduğunu hiç söylemez. Pilot ve [[character/1]], kapılara tıpkı yollar ya da demiryolları gibi gündelik hayatın sıradan bir parçası olarak bakar.", false],
		[1, "Kolonideki rolü", "Koloniyi bir arada tutan bu ağdır. Dağınık iki yüz istasyonu tek bir işleyen ekonomiye dönüştürür: bir av, yakalandığı yerden çok uzakta satılabilir, bir sözleşme haritanın bir ucundan öbür ucuna götürebilir. Yeni bir istasyona her varış [[medal/13]] için, her istasyona ilk yanaşma da [[medal/6]] için sayılır.", false],
		[5, "Hikâyede", "Pilot kapılarla erkenden, ilk korsan avı onu [[station/0]] istasyonunun ötesine götürdüğünde tanışır. O andan itibaren hikâyedeki neredeyse her yolculuk kapılardan geçer ve otopilot istenirse gemiyi yerel kapıya götürebilir.", false],
		[12, "", "Kapılar siyasi sınırları tanımaz. Pilot ilk kez [[station/3]] istasyonundaki direnişe gittiğinde gemi, asilerin tarafsız dediği sulara varır ve istasyonun muhafızlarınca hemen durdurulur.", false],
		[21, "", "Asi operasyonları kapılardan yararlanır. [[station/8]] istasyonu yakınındaki korsan çetesine karşı görevde [[character/3]], saldırıya önderlik etmeden önce pilotu istasyonun kapısının yakınında bekler.", false],
		[45, "", "[[station/18]] saldırısında [[character/12]] adlı liderin birliği kapının yakınında mevzide bekler, böylece saldırı pilot varır varmaz başlayabilir.", false],
	],
}
