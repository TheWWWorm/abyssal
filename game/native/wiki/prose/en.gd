	"guide/basics": {"title": "Getting started", "subtitle": "Guide", "category": "guide", "from": 1},
	"guide/combat": {"title": "Combat", "subtitle": "Guide", "category": "guide", "from": 1},
	"guide/contracts": {"title": "Contracts", "subtitle": "Guide", "category": "guide", "from": 1},
	"guide/depth": {"title": "Depth and pressure", "subtitle": "Guide", "category": "guide", "from": 1},
	"guide/fishing": {"title": "Fishing and harvesting", "subtitle": "Guide", "category": "guide", "from": 1},
	"guide/fitting": {"title": "Ships and equipment", "subtitle": "Guide", "category": "guide", "from": 1},
	"guide/medals": {"title": "Medals", "subtitle": "Guide", "category": "guide", "from": 1},
	"guide/navigation": {"title": "Travel and S.T.R.E.A.M.s", "subtitle": "Guide", "category": "guide", "from": 1},
	"guide/trading": {"title": "Trade", "subtitle": "Guide", "category": "guide", "from": 1},
	"world/abel": {"title": "Professor Abel", "subtitle": "Character", "category": "characters", "from": 31},
	"world/aquarians": {"title": "The Aquarians", "subtitle": "Setting", "category": "world", "from": 10},
	"world/biotek": {"title": "The Biotek generator", "subtitle": "Setting", "category": "world", "from": 31},
	"world/colony": {"title": "The colony", "subtitle": "Setting", "category": "world", "from": 1},
	"world/eclipse": {"title": "The Eclipse", "subtitle": "Setting", "category": "world", "from": 33},
	"world/history": {"title": "The story", "subtitle": "Plot summary", "category": "story", "from": 1},
	"world/ocean": {"title": "The ocean", "subtitle": "Setting", "category": "world", "from": 1},
	"world/stream": {"title": "The S.T.R.E.A.M. network", "subtitle": "Setting", "category": "world", "from": 1},
